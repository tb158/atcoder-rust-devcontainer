# Whitelist: ignore everything at the top level, then re-admit only what is
# meant to be public (environment reference + src/lib). Anything new at the
# top level stays private until it is explicitly listed here.
# NOTE: gitignore has no trailing comments -- keep comments on their own line.
/*

# --- repository meta and licensing (REUSE layout) ---
!/.gitignore
!/LICENSE-MIT
!/LICENSES/
!/REUSE.toml
!/.editorconfig

# --- devcontainer: image, entrypoint, helper scripts ---
# Secrets and junk inside it are re-excluded by .devcontainer/.gitignore.
!/.devcontainer/

# --- editor settings and generated snippets ---
!/.vscode/
# KIMI_CODE_HOME points here: Kimi Code CLI sessions / credentials.
/.vscode/kimi-code/
# Debug configs for the cargo-compete fork (not part of this repo).
/.vscode/launch.json

# --- cargo / cargo-compete configuration ---
!/.cargo/
!/Cargo.toml
!/compete.toml

# --- helper scripts: environment ones only ---
!/scripts/
/scripts/*
!/scripts/cargo_compete_new_spaced.sh

# --- sources: the library only, never contest solutions ---
# Sharing solutions during a contest violates AtCoder's rules.
!/src/
/src/*
!/src/lib/
# Stale: src/lib is a member of the root workspace, so this lock is unused.
/src/lib/Cargo.lock
!/src/contest/
/src/contest/*
!/src/contest/.gitkeep

# --- junk at any depth ---
.DS_Store
target/
debug/
**/*.rs.bk
*.pdb
__pycache__/
