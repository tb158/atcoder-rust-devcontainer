      "            }",
      "        }",
      "        dq.push_back(hp);",
      "    }",
      "    while dq.len() > 2 && dq[0].外(dq[dq.len() - 1].交点(&dq[dq.len() - 2])) {",
      "        dq.pop_back();",
      "    }",
      "    while dq.len() > 2 && dq[dq.len() - 1].外(dq[0].交点(&dq[1])) {",
