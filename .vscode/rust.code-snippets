  "累乗_mod": {
    "scope": "rust",
    "prefix": "累乗_mod",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}"
    ]
  },
  "累乗_和": {
    "scope": "rust",
    "prefix": "累乗_和",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 素数 `法` を法とする `a` の逆元（フェルマーの小定理 `a^(法-2)`）。`O(log 法)`。",
      "/// `法` が素数で `a % 法 != 0` であることが前提。合成数を法とする場合や `a` が",
      "/// `法` の倍数の場合は正しい値を返さない（拡張ユークリッドを使うこと）。",
      "fn 逆元(a: u64, 法: u64) -> u64 {",
      "    累乗_mod(a, 法 - 2, 法)",
      "}",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// `0..=上限` の階乗・逆階乗を素数 `法` 上で返す内部関数（二項係数用）。",
      "fn 階乗表(上限: usize, 法: u64) -> (Vec<u64>, Vec<u64>) {",
      "    let mut 階乗 = vec![1u64; 上限 + 1];",
      "    for i in 1..=上限 {",
      "        階乗[i] = 階乗[i - 1] * i as u64 % 法;",
      "    }",
      "    let mut 逆階乗 = vec![1u64; 上限 + 1];",
      "    逆階乗[上限] = 逆元(階乗[上限], 法);",
      "    for i in (0..上限).rev() {",
      "        逆階乗[i] = 逆階乗[i + 1] * (i as u64 + 1) % 法;",
      "    }",
      "    (階乗, 逆階乗)",
      "}",
      "/// ベルヌーイ数 `B_0, B_1, …, B_k` を素数 `法` 上で返す（`B_1 = -1/2` の規約）。`O(k^2)`。",
      "/// 累乗和（Faulhaber 公式）の係数として使う。",
      "fn ベルヌーイ数(k: usize, 法: impl TryInto<u64>) -> Vec<usize> {",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ベルヌーイ数: 引数が u64 に収まりません\");",
      "    let (階乗, 逆階乗) = 階乗表(k + 1, 法);",
      "    let 二項 = |n: usize, r: usize| -> u64 {",
      "        if r > n {",
      "            0",
      "        } else {",
      "            階乗[n] * 逆階乗[r] % 法 * 逆階乗[n - r] % 法",
      "        }",
      "    };",
      "    let mut b = vec![0u64; k + 1];",
      "    b[0] = 1 % 法;",
      "    for m in 1..=k {",
      "        let mut s = 0u64;",
      "        for (j, &bj) in b.iter().enumerate().take(m) {",
      "            s = (s + 二項(m + 1, j) * bj) % 法;",
      "        }",
      "        let 逆 = 逆元((m as u64 + 1) % 法, 法);",
      "        b[m] = (法 - s) % 法 * 逆 % 法;",
      "    }",
      "    b.into_iter().map(|x| x as usize).collect()",
      "}",
      "/// 累乗和 `Σ_{i=1}^{n} i^k mod 法`（`法` は素数）を Faulhaber の公式で `O(k^2)` で返す。`n` は最大 `u64`。",
      "/// 1 個の巨大な `n` と固定の `k` に対し、`n` をいくら大きくしても次数 `k` だけに依存して計算できる。",
      "/// ラグランジュ補間（[`lagrange_interpolation`](crate::lagrange_interpolation)）とは別手法。",
      "fn 累乗和(n: impl TryInto<u64>, k: usize, 法: impl TryInto<u64>) -> usize {",
      "    let n: u64 = n",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"累乗和: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"累乗和: 引数が u64 に収まりません\");",
      "    if k == 0 {",
      "        return (n % 法) as usize;",
      "    }",
      "    let b = ベルヌーイ数(k, 法);",
      "    let (階乗, 逆階乗) = 階乗表(k + 1, 法);",
      "    let 二項 = |n: usize, r: usize| -> u64 {",
      "        if r > n {",
      "            0",
      "        } else {",
      "            階乗[n] * 逆階乗[r] % 法 * 逆階乗[n - r] % 法",
      "        }",
      "    };",
      "    let m = (n % 法 + 1) % 法;",
      "    let mut s = 0u64;",
      "    for (j, &bj) in b.iter().enumerate() {",
      "        let 項 = 二項(k + 1, j) * bj as u64 % 法 * 累乗_mod(m, (k + 1 - j) as u64, 法) % 法;",
      "        s = (s + 項) % 法;",
      "    }",
      "    (s * 逆元((k as u64 + 1) % 法, 法) % 法) as usize",
      "}"
    ]
  },
  "組合せ_ModInt_comb_factorial": {
    "scope": "rust",
    "prefix": "組合せ_ModInt_comb_factorial",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use ac_library::modint::ModIntBase;",
      "/// `M` は `ModInt998244353` / `ModInt1000000007` / `ModInt`（DynamicModInt。先に",
      "/// `Mint::set_modulus(m)`）のいずれか。",
      "struct Comb<M> {",
      "    max: usize,",
      "    fac: Vec<M>,",
      "    fac_inv: Vec<M>,",
      "}",
      "impl<M: ModIntBase> Comb<M> {",
      "    fn new(max_n: usize) -> Self {",
      "        let mut fac = vec![M::new(1); max_n + 1];",
      "        for i in 1..=max_n {",
      "            fac[i] = fac[i - 1] * M::new(i);",
      "        }",
      "        let mut fac_inv = vec![M::new(1); max_n + 1];",
      "        fac_inv[max_n] = fac[max_n].inv();",
      "        for i in (0..max_n).rev() {",
      "            fac_inv[i] = fac_inv[i + 1] * M::new(i + 1);",
      "        }",
      "        Self {",
      "            max: max_n,",
      "            fac,",
      "            fac_inv,",
      "        }",
      "    }",
      "    fn 階乗(&self, n: impl TryInto<i64>) -> M {",
      "        let n = to_i64(n);",
      "        if n < 0 {",
      "            return M::raw(0);",
      "        }",
      "        let n = n as usize;",
      "        assert!(",
      "            n <= self.max,",
      "            \"階乗: n={n} exceeds precomputed max={}\",",
      "            self.max",
      "        );",
      "        self.fac[n]",
      "    }",
      "    fn 二項係数(&self, n: impl TryInto<i64>, k: impl TryInto<i64>) -> M {",
      "        let (n, k) = (to_i64(n), to_i64(k));",
      "        if k < 0 || n < k {",
      "            return M::raw(0);",
      "        }",
      "        if k == 0 {",
      "            return M::new(1);",
      "        }",
      "        if n <= self.max as i64 {",
      "            let n = n as usize;",
      "            let k = k as usize;",
      "            return self.fac[n] * self.fac_inv[k] * self.fac_inv[n - k];",
      "        }",
      "        assert!(",
      "            k <= self.max as i64,",
      "            \"二項係数: k={k} exceeds precomputed max={}\",",
      "            self.max",
      "        );",
      "        let mut res = M::new(1);",
      "        for i in 0..k {",
      "            res *= M::new(n - i);",
      "        }",
      "        res * self.fac_inv[k as usize]",
      "    }",
      "    fn 多項係数<K: Copy + TryInto<i64>>(&self, n: impl TryInto<i64>, ks: &[K]) -> M {",
      "        let n = to_i64(n);",
      "        let ks: Vec<i64> = ks.iter().map(|&k| to_i64(k)).collect();",
      "        if ks.iter().any(|&k| k < 0) {",
      "            return M::raw(0);",
      "        }",
      "        let sum: i64 = ks.iter().sum();",
      "        if sum != n || n < 0 {",
      "            return M::raw(0);",
      "        }",
      "        let n = n as usize;",
      "        assert!(",
      "            n <= self.max,",
      "            \"多項係数: n={n} exceeds precomputed max={}\",",
      "            self.max",
      "        );",
      "        let mut res = self.fac[n];",
      "        for &k in &ks {",
      "            res *= self.fac_inv[k as usize];",
      "        }",
      "        res",
      "    }",
      "    /// 重複組合せ `nHk = C(n + k - 1, k)`（n 種類から k 個選ぶ、同じ種類の重複可）。",
      "    fn 重複組合せ(&self, n: impl TryInto<i64>, k: impl TryInto<i64>) -> M {",
      "        let (n, k) = (to_i64(n), to_i64(k));",
      "        if n < 0 || k < 0 {",
      "            return M::raw(0);",
      "        }",
      "        if k == 0 {",
      "            return M::new(1);",
      "        }",
      "        self.二項係数(n + k - 1, k)",
      "    }",
      "    /// カタラン数 `C(n) = 二項係数(2n, n) − 二項係数(2n, n+1)`（= 正しく対応した括弧列・二分木・",
      "    /// 三角形分割・単調格子路の個数）を返す。`n < 0` は 0。前計算済みの階乗・逆階乗を使うので",
      "    /// `2n ≤ max_n` が必要。",
      "    fn カタラン数(&self, n: impl TryInto<i64>) -> M {",
      "        let n = to_i64(n);",
      "        if n < 0 {",
      "            return M::raw(0);",
      "        }",
      "        self.二項係数(2 * n, n) - self.二項係数(2 * n, n + 1)",
      "    }",
      "}"
    ]
