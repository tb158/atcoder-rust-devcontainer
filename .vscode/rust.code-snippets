  "xor_畳み込み": {
    "scope": "rust",
    "prefix": "xor_畳み込み",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 高速ウォルシュ–アダマール変換（in-place）。長さ `2^k` の配列を `O(n log n)` で変換する。",
      "/// 2 回適用すると各要素が `n` 倍になる（自己逆変換）。XOR 畳み込みの土台。",
      "/// 変換途中で負の値が出るため、符号なし整数は不可（i64 / f64 / ModInt などを使う）。",
      "fn アダマール変換<T>(a: &mut [T])",
      "where",
      "    T: Copy + std::ops::Add<Output = T> + std::ops::Sub<Output = T>,",
      "{",
      "    let n = a.len();",
      "    let mut 幅 = 1;",
      "    while 幅 < n {",
      "        let mut i = 0;",
      "        while i < n {",
      "            for j in i..i + 幅 {",
      "                let x = a[j];",
      "                let y = a[j + 幅];",
      "                a[j] = x + y;",
      "                a[j + 幅] = x - y;",
      "            }",
      "            i += 幅 << 1;",
      "        }",
      "        幅 <<= 1;",
      "    }",
      "}",
      "/// XOR 畳み込み。`h[k] = Σ_{i ^ j = k} f[i]·g[j]` を `O(n log n)` で返す（配列長は `2^k`）。",
      "/// ビット XOR をキーにした数え上げ・確率分布の合成に使う。",
      "/// 下位/上位集合ゼータ（[`zeta_mobius`](crate::zeta_mobius)）が AND/OR 畳み込みなのに対し、こちらは XOR。",
      "/// 要素型は i64 / f64 / ModInt など（符号なし整数は不可。ModInt は mod が奇素数なら `n` で割れる）。",
      "fn xor畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy",
      "        + std::ops::Add<Output = T>",
      "        + std::ops::Sub<Output = T>",
      "        + std::ops::MulAssign",
      "        + std::ops::DivAssign",
      "        + From<u32>,",
      "{",
      "    assert_eq!(f.len(), g.len(), \"f と g は同じ長さ\");",
      "    assert!(f.len().is_power_of_two(), \"長さは 2 のべき乗\");",
      "    let n = f.len();",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut a = f.to_vec();",
      "    let mut b = g.to_vec();",
      "    アダマール変換(&mut a);",
      "    アダマール変換(&mut b);",
      "    a.iter_mut().zip(&b).for_each(|(x, y)| *x *= *y);",
      "    アダマール変換(&mut a);",
      "    let 除数 = T::from(n as u32);",
      "    a.iter_mut().for_each(|x| *x /= 除数);",
      "    a",
      "}"
    ]
  },
  "いもす": {
    "scope": "rust",
    "prefix": "いもす",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// いもす法(1次元)。「区間への一括加算」を O(1) で記録し、最後に O(N) で各点の値へ展開する。",
      "/// 区間加算クエリが大量にあり、最終的な各点の値だけが欲しいときに使う。",
      "/// （累積和が「点の配列 → 区間和」なのに対し、いもす法は「区間加算 → 点の値」。）",
      "/// 値の型 `T` は加減算できる符号付きの型（`i64`・`f64`・ModInt など）で、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "/// `usize` / `u64` などの符号なし整数は使えない（差分配列が途中で負の値を持つため）。",
      "/// 符号なしで扱いたい場合は `std::num::Wrapping<u64>` を使う（最終値が `u64` に収まるなら正しい）。",
      "struct いもす法<T> {",
      "    差分: Vec<T>,",
      "}",
      "impl<T> いもす法<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::SubAssign + std::ops::Neg,",
      "{",
      "    /// 長さ `長さ` の配列に対するいもす法を、全要素 0（`T::default()`）で初期化する。",
      "    fn new(長さ: usize) -> Self {",
      "        Self {",
      "            差分: vec![T::default(); 長さ + 1],",
      "        }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に `値` を加算する（記録のみ。展開は `展開()`）。",
      "    fn 区間加算(&mut self, 範囲: impl std::ops::RangeBounds<usize>, 値: T) {",
      "        let (l, r) = 半開(範囲, self.差分.len() - 1);",
      "        self.差分[l] += 値;",
      "        self.差分[r] -= 値;",
      "    }",
      "    /// 記録した加算をすべて反映した、各点の最終的な値を返す。",
      "    fn 展開(&self) -> Vec<T> {",
      "        let mut 累積 = T::default();",
      "        self.差分[..self.差分.len() - 1]",
      "            .iter()",
      "            .map(|&d| {",
      "                累積 += d;",
      "                累積",
      "            })",
      "            .collect()",
      "    }",
      "}"
    ]
  },
