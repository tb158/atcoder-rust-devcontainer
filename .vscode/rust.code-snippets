    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 重み付き区間スケジューリング。区間 `(開始, 終了, 重み)` から、互いに重ならないように選んだときの",
      "/// 重み和の最大値と、選んだ区間の元の添字を返す。端点の接触（`終了 == 次の開始`）は許す。O(N log N)。",
      "/// 重みなし（個数最大化）なら [`区間スケジューリング`]。重みが付くと貪欲は最適でないので DP になる。",
      "fn 重み付き区間スケジューリング(区間: &[(i64, i64, i64)]) -> (i64, Vec<usize>) {",
      "    let n = 区間.len();",
      "    if n == 0 {",
      "        return (0, Vec::new());",
      "    }",
      "    let mut 並び: Vec<(i64, i64, i64, usize)> = 区間",
      "        .iter()",
      "        .enumerate()",
      "        .map(|(i, &(s, e, w))| (e, s, w, i))",
      "        .collect();",
      "    並び.sort_by_key(|&(e, _, _, _)| e);",
      "    let 終了: Vec<i64> = 並び.iter().map(|&(e, _, _, _)| e).collect();",
      "    let mut dp = vec![0i64; n + 1];",
      "    let mut 取る = vec![false; n + 1];",
      "    let mut 戻り = vec![0usize; n + 1];",
      "    for i in 1..=n {",
      "        let (_, s, w, _) = 並び[i - 1];",
      "        let p = 終了[..i - 1].partition_point(|&e| e <= s);",
      "        let 取った値 = dp[p] + w;",
      "        if 取った値 >= dp[i - 1] {",
      "            dp[i] = 取った値;",
      "            取る[i] = true;",
      "            戻り[i] = p;",
      "        } else {",
      "            dp[i] = dp[i - 1];",
      "        }",
      "    }",
      "    let mut 採用 = Vec::new();",
      "    let mut i = n;",
      "    while i > 0 {",
      "        if 取る[i] {",
      "            採用.push(並び[i - 1].3);",
      "            i = 戻り[i];",
      "        } else {",
      "            i -= 1;",
      "        }",
      "    }",
      "    採用.sort_unstable();",
      "    (dp[n], 採用)",
      "}"
    ]
  },
