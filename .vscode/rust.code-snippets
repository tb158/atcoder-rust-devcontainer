  "二点_連結_成分_分解": {
    "scope": "rust",
    "prefix": "二点_連結_成分_分解",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重頂点連結成分（BCC, block）分解と block-cut 木。`lowlink`（橋・関節点の列挙のみ）とは別で、",
      "/// 辺をブロックに分割し、関節点とブロックを頂点とする木（非連結なら森）を構成する。",
      "/// - `成分[i]`: i 番目の BCC に属する元グラフ頂点の一覧（関節点は複数の BCC に現れる）。",
      "/// - `木`: block-cut 木の隣接リスト（木頂点空間）。前半 `成分数` 個が BCC、後半が関節点。",
      "/// - `関節点番号[v]`: 元頂点 `v` が関節点なら対応する木頂点番号（`>= 成分数`）、そうでなければ `None`。",
      "/// - `所属[v]`: 元頂点 `v` が属する BCC 番号の一覧。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "struct ブロックカット木 {",
      "    /// 各 BCC の頂点集合。",
      "    成分: Vec<Vec<usize>>,",
      "    /// BCC の個数。",
      "    成分数: usize,",
      "    /// block-cut 木の隣接リスト（木頂点番号空間、頂点数 = `木頂点数`）。",
      "    木: Vec<Vec<usize>>,",
      "    /// block-cut 木の頂点数（= `成分数` + 関節点数）。",
      "    木頂点数: usize,",
      "    /// 元頂点 → 関節点に対応する木頂点番号（非関節点は `None`）。",
      "    関節点番号: Vec<Option<usize>>,",
      "    /// 元頂点 → 属する BCC 番号の一覧。",
      "    所属: Vec<Vec<usize>>,",
      "}",
      "impl ブロックカット木 {",
      "    /// 関節点（複数の BCC に属する頂点）の一覧を昇順で返す。",
      "    fn 関節点一覧(&self) -> Vec<usize> {",
      "        (0..self.関節点番号.len())",
      "            .filter(|&v| self.関節点番号[v].is_some())",
      "            .collect()",
      "    }",
      "}",
      "/// 無向グラフを二重頂点連結成分に分解し block-cut 木を構成する。`辺` は多重辺・自己ループを含んでよい",
      "/// （自己ループは無視、多重辺は同じ 2 頂点の BCC を成す）。計算量 `O(n + 辺数)`。",
      "fn ブロックカット木分解(n: usize, 辺: &[(usize, usize)]) -> ブロックカット木 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut ord = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 時刻 = 0i64;",
      "    let mut 辺スタック: Vec<(usize, usize)> = Vec::new();",
      "    let mut 成分: Vec<Vec<usize>> = Vec::new();",
      "    for s in 0..n {",
      "        if ord[s] != -1 {",
      "            continue;",
      "        }",
      "        if グラフ[s].is_empty() {",
      "            成分.push(vec![s]);",
      "            ord[s] = 時刻;",
      "            時刻 += 1;",
      "            continue;",
      "        }",
      "        ord[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if ord[next] == -1 {",
      "                    ord[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    辺スタック.push((now, next));",
      "                    探索.push((next, eid as i64, 0));",
      "                } else if ord[next] < ord[now] {",
      "                    辺スタック.push((now, next));",
      "                    low[now] = low[now].min(ord[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] >= ord[prev] {",
      "                        let mut 頂点 = Vec::new();",
      "                        loop {",
      "                            let (x, y) = 辺スタック.pop().unwrap();",
      "                            頂点.push(x);",
      "                            頂点.push(y);",
      "                            if (x, y) == (prev, now) {",
      "                                break;",
      "                            }",
      "                        }",
      "                        頂点.sort_unstable();",
      "                        頂点.dedup();",
      "                        成分.push(頂点);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 成分数 = 成分.len();",
      "    let mut 所属: Vec<Vec<usize>> = vec![Vec::new(); n];",
      "    for (i, c) in 成分.iter().enumerate() {",
      "        for &v in c {",
      "            所属[v].push(i);",
      "        }",
      "    }",
      "    let mut 関節点番号 = vec![None; n];",
      "    let mut 木頂点数 = 成分数;",
      "    for (v, 番号) in 関節点番号.iter_mut().enumerate() {",
      "        if 所属[v].len() >= 2 {",
      "            *番号 = Some(木頂点数);",
      "            木頂点数 += 1;",
      "        }",
      "    }",
      "    let mut 木: Vec<Vec<usize>> = vec![Vec::new(); 木頂点数];",
      "    for (i, c) in 成分.iter().enumerate() {",
      "        for &v in c {",
      "            if let Some(a) = 関節点番号[v] {",
      "                木[i].push(a);",
      "                木[a].push(i);",
      "            }",
      "        }",
      "    }",
      "    ブロックカット木 {",
      "        成分,",
      "        成分数,",
      "        木,",
      "        木頂点数,",
      "        関節点番号,",
      "        所属,",
      "    }",
      "}"
    ]
  },
  "二辺_連結_成分_分解": {
    "scope": "rust",
    "prefix": "二辺_連結_成分_分解",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重辺連結成分分解の結果。`成分[v]` は頂点 `v` の属する二重辺連結成分の番号、`成分数` はその個数。",
      "/// `橋` は橋（取り除くと連結成分が増える辺）の一覧、`木` は成分を頂点とする**橋森**（橋でつないだ森）。",
      "struct 二重辺連結成分 {",
      "    /// 頂点 → 成分番号。",
      "    成分: Vec<usize>,",
      "    /// 成分の個数。",
      "    成分数: usize,",
      "    /// 橋の一覧（`(u, v)`、`u` は DFS 木で親側）。",
      "    橋: Vec<(usize, usize)>,",
      "    /// 橋森。`木[c]` は成分 `c` と橋で隣接する成分の一覧。",
      "    木: Vec<Vec<usize>>,",
      "}",
      "/// 無向グラフを二重辺連結成分（どの 1 辺を取り除いても連結が保たれる極大頂点集合）に分解し、",
      "/// 橋を縮約した**橋森**を返す。`lowlink`（橋・関節点の列挙）とは別で、成分分解と縮約木まで構成する。",
      "/// `辺` は多重辺・自己ループを含んでよい（並行辺は橋にならない／自己ループは無視）。計算量 `O(n + 辺数)`。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "fn 二重辺連結成分分解(n: usize, 辺: &[(usize, usize)]) -> 二重辺連結成分 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut 番号 = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 橋辺 = vec![false; 辺.len()];",
      "    let mut 橋 = Vec::new();",
      "    let mut 時刻 = 0i64;",
      "    for s in 0..n {",
      "        if 番号[s] != -1 {",
      "            continue;",
      "        }",
      "        番号[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if 番号[next] == -1 {",
      "                    番号[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    探索.push((next, eid as i64, 0));",
      "                } else {",
      "                    low[now] = low[now].min(番号[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] > 番号[prev] {",
      "                        橋辺[親辺 as usize] = true;",
      "                        橋.push((prev, now));",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 成分 = vec![!0; n];",
      "    let mut 成分数 = 0;",
      "    for s in 0..n {",
      "        if 成分[s] != !0 {",
      "            continue;",
      "        }",
      "        成分[s] = 成分数;",
      "        let mut 探索 = vec![s];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, eid) in &グラフ[now] {",
      "                if !橋辺[eid] && 成分[next] == !0 {",
      "                    成分[next] = 成分数;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        成分数 += 1;",
      "    }",
      "    let mut 木 = vec![Vec::new(); 成分数];",
      "    for &(a, b) in &橋 {",
      "        let (x, y) = (成分[a], 成分[b]);",
      "        木[x].push(y);",
      "        木[y].push(x);",
      "    }",
      "    二重辺連結成分 {",
      "        成分,",
      "        成分数,",
      "        橋,",
      "        木,",
      "    }",
      "}"
    ]
  },
  "二進_トライ": {
    "scope": "rust",
    "prefix": "二進_トライ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// 二進トライ（binary trie）。非負整数の多重集合を二進表現の木で管理し、挿入・削除・",
      "/// 「指定値 `x` との XOR の最大／最小」「k 番目に小さい値」「`x` 以下の個数」などを各 `O(ビット数)` で行う。",
      "/// `xor_basis`（線形基底）は「部分集合の XOR で作れる最大値」を扱うのに対し、こちらは",
      "/// **格納済み要素そのもの**との XOR 最適化や順位クエリを行う別物。",
      "/// `挿入` した値の上位 `ビット数` ビットのみを見るので、扱う値域に合わせて `ビット数` を決める。",
      "/// XOR を使わず k 番目・順位だけが目的なら [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合)",
      "/// を使う（負の値や整数以外も載り、メモリも軽く速い）。",
      "struct 二進トライ {",
      "    ビット数: usize,",
      "    子: Vec<[Option<usize>; 2]>,",
      "    通過数: Vec<usize>,",
      "}",
      "impl 二進トライ {",
      "    /// `ビット数` ビット幅（`0..2^ビット数` の値）の空トライを作る。",
      "    fn new(ビット数: usize) -> Self {",
      "        Self {",
      "            ビット数,",
      "            子: vec![[None, None]],",
      "            通過数: vec![0],",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個追加する。",
      "    fn 挿入(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] += 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = match self.子[v][ビット] {",
      "                Some(次) => 次,",
      "                None => {",
      "                    let 新 = self.子.len();",
      "                    self.子.push([None, None]);",
      "                    self.通過数.push(0);",
      "                    self.子[v][ビット] = Some(新);",
      "                    新",
      "                }",
      "            };",
      "            self.通過数[v] += 1;",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個削除する（存在する前提）。木構造は保持し、通過数のみ減らす。",
      "    fn 削除(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] -= 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = self.子[v][ビット].unwrap();",
      "            self.通過数[v] -= 1;",
      "        }",
      "    }",
      "    /// 格納されている要素の総数。",
      "    fn 個数(&self) -> usize {",
      "        self.通過数[0]",
      "    }",
      "    /// 値 `x` が格納されている個数。",
      "    fn 含む個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 0,",
      "            }",
      "        }",
      "        self.通過数[v]",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最大化する `x ^ y` を返す（空でないこと）。",
      "    fn 最大xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            let 望み = ビット ^ 1;",
      "            match self.子[v][望み] {",
      "                Some(c) if self.通過数[c] > 0 => {",
      "                    結果 |= 1 << b;",
      "                    v = c;",
      "                }",
      "                _ => v = self.子[v][ビット].unwrap(),",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最小化する `x ^ y` を返す（空でないこと）。",
      "    fn 最小xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => {",
      "                    結果 |= 1 << b;",
      "                    v = self.子[v][ビット ^ 1].unwrap();",
      "                }",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 0 始まりで `k` 番目に小さい値を返す（多重度込み、`0 <= k < 個数`）。",
      "    fn k番目(&self, mut k: usize) -> usize {",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let c0 = self.子[v][0];",
      "            let 左 = c0.map_or(0, |c| self.通過数[c]);",
      "            if k < 左 {",
      "                v = c0.unwrap();",
      "            } else {",
      "                k -= 左;",
      "                結果 |= 1 << b;",
      "                v = self.子[v][1].unwrap();",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// `x` 以下の格納要素の個数（多重度込み）。",
      "    fn 以下の個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 個数 = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            if ビット == 1 {",
      "                if let Some(c0) = self.子[v][0] {",
      "                    個数 += self.通過数[c0];",
      "                }",
      "            }",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 個数,",
      "            }",
      "        }",
      "        個数 + self.通過数[v]",
      "    }",
      "}"
    ]
  },
  "二部_グラフ_マッチング": {
    "scope": "rust",
    "prefix": "二部_グラフ_マッチング",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::VecDeque;",
      "/// Hopcroft-Karp 法による二部グラフの最大マッチング。O(E√V)。",
      "/// `ac_library::MaxFlow` でも最大二部マッチングは解けるが、こちらは二部マッチング専用で",
      "/// E√V と高速。`pathfinding::kuhn_munkres` は重み付き割当専用なので、",
      "/// 単純な最大本数マッチングにはこちらを使う。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に対応も保持）。",
      "/// - [`Self::マッチング`] : マッチした `(左, 右)` の組を返す。",
      "struct ホップクロフトカープ {",
      "    左数: usize,",
      "    グラフ: Vec<Vec<usize>>,",
      "    左相手: Vec<i64>,",
      "    右相手: Vec<i64>,",
      "    距離: Vec<i64>,",
      "}",
      "impl ホップクロフトカープ {",
      "    /// 左頂点 `左数` 個・右頂点 `右数` 個の二部グラフを作る。",
      "    fn new(左数: usize, 右数: usize) -> Self {",
      "        Self {",
      "            左数,",
      "            グラフ: vec![Vec::new(); 左数],",
      "            左相手: vec![-1; 左数],",
      "            右相手: vec![-1; 右数],",
      "            距離: vec![-1; 左数],",
      "        }",
      "    }",
      "    /// 左頂点 `u` と右頂点 `v` を結ぶ辺を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.グラフ[u].push(v);",
      "    }",
      "    /// 未マッチ左頂点から BFS して層（距離）を作る。増加道が存在すれば true。",
      "    fn bfs(&mut self) -> bool {",
      "        let mut 探索 = VecDeque::new();",
      "        for u in 0..self.左数 {",
      "            if self.左相手[u] < 0 {",
      "                self.距離[u] = 0;",
      "                探索.push_back(u);",
      "            } else {",
      "                self.距離[u] = -1;",
      "            }",
      "        }",
      "        let mut 増加道あり = false;",
      "        while let Some(u) = 探索.pop_front() {",
      "            for i in 0..self.グラフ[u].len() {",
      "                let v = self.グラフ[u][i];",
      "                let w = self.右相手[v];",
      "                if w < 0 {",
      "                    増加道あり = true;",
      "                } else {",
      "                    let w = w as usize;",
      "                    if self.距離[w] < 0 {",
      "                        self.距離[w] = self.距離[u] + 1;",
      "                        探索.push_back(w);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        増加道あり",
      "    }",
      "    /// 層に沿って `u` から増加道を探し、見つかれば反転して true。",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn dfs(&mut self, u: usize) -> bool {",
      "        for i in 0..self.グラフ[u].len() {",
      "            let v = self.グラフ[u][i];",
      "            let w = self.右相手[v];",
      "            let 進める =",
      "                w < 0 || (self.距離[w as usize] == self.距離[u] + 1 && self.dfs(w as usize));",
      "            if 進める {",
      "                self.左相手[u] = v as i64;",
      "                self.右相手[v] = u as i64;",
      "                return true;",
      "            }",
      "        }",
      "        self.距離[u] = -1;",
      "        false",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut 本数 = 0;",
      "        while self.bfs() {",
      "            for u in 0..self.左数 {",
      "                if self.左相手[u] < 0 && self.dfs(u) {",
      "                    本数 += 1;",
      "                }",
      "            }",
      "        }",
      "        本数",
      "    }",
      "    /// マッチした `(左, 右)` の組を返す。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn マッチング(&self) -> Vec<(usize, usize)> {",
      "        (0..self.左数)",
      "            .filter(|&u| self.左相手[u] >= 0)",
      "            .map(|u| (u, self.左相手[u] as usize))",
      "            .collect()",
      "    }",
      "}"
    ]
  },
  "二部_グラフ_判定": {
    "scope": "rust",
    "prefix": "二部_グラフ_判定",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向グラフを2色に塗り分ける（二部グラフ判定）。O(V+E)。",
      "/// `グラフ[u]` は隣接頂点の列。塗り分けられたら各頂点の色（`false` / `true`）を返し、",
      "/// 奇閉路（自己ループを含む）があれば `None`。非連結でもよく、連結成分ごとに",
      "/// 「その成分の最小番号の頂点を `false`」として独立に塗る。",
      "/// `petgraph::algo::is_bipartite_undirected` は「始点の連結成分が二部か」の `bool` だけで、",
      "/// 塗り分けそのものは得られない。「白側の頂点を列挙」「白と黒の個数を比べる」型の問題には",
      "/// こちらが要る。辺が後から増えていくオンライン形なら",
      "/// [`crate::weighted_union_find`] を mod 2 のポテンシャルで使う方が向く。",
      "fn 二部彩色(グラフ: &[Vec<usize>]) -> Option<Vec<bool>> {",
      "    use std::collections::VecDeque;",
      "    let n = グラフ.len();",
      "    let mut 色: Vec<Option<bool>> = vec![None; n];",
      "    let mut 探索 = VecDeque::new();",
      "    for 始点 in 0..n {",
      "        if 色[始点].is_some() {",
      "            continue;",
      "        }",
      "        色[始点] = Some(false);",
      "        探索.push_back(始点);",
      "        while let Some(now) = 探索.pop_front() {",
      "            let c = 色[now].unwrap();",
      "            for &next in &グラフ[now] {",
      "                match 色[next] {",
      "                    None => {",
      "                        色[next] = Some(!c);",
      "                        探索.push_back(next);",
      "                    }",
      "                    Some(隣) if 隣 == c => return None,",
      "                    Some(_) => {}",
      "                }",
      "            }",
      "        }",
      "    }",
      "    Some(色.into_iter().map(|c| c.unwrap()).collect())",
      "}"
    ]
  },
