  "PolygonCentroid": {
    "scope": "rust",
    "prefix": "PolygonCentroid",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 単純多角形（頂点を順に並べた列）の**重心**（面積の中心）を返す。面積 0 の退化形は `None`。`O(N)`。",
      "/// 頂点の単純平均ではない点に注意。[`重心`](crate::triangle_centers::重心) は三角形 3 点専用。",
      "fn 多角形の重心(多角形: &[点]) -> Option<点> {",
      "    let n = 多角形.len();",
      "    if n < 3 {",
      "        return None;",
      "    }",
      "    let mut 面積2 = 0.0f64;",
      "    let mut cx = 0.0f64;",
      "    let mut cy = 0.0f64;",
      "    for i in 0..n {",
      "        let (x0, y0) = 多角形[i];",
      "        let (x1, y1) = 多角形[(i + 1) % n];",
      "        let cross = x0 * y1 - x1 * y0;",
      "        面積2 += cross;",
      "        cx += (x0 + x1) * cross;",
      "        cy += (y0 + y1) * cross;",
      "    }",
      "    if 面積2.abs() < 1e-12 {",
      "        return None;",
      "    }",
      "    Some((cx / (3.0 * 面積2), cy / (3.0 * 面積2)))",
      "}"
    ]
  },
  "PrimitiveRoot": {
    "scope": "rust",
    "prefix": "PrimitiveRoot",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// `n` の相異なる素因数を昇順で返す（試し割り）。`n` の最大素因数が ~10^7 程度までなら高速。",
      "fn 素因数集合(mut n: u64) -> Vec<u64> {",
      "    let mut v = Vec::new();",
      "    let mut d = 2u64;",
      "    while d * d <= n {",
      "        if n % d == 0 {",
      "            v.push(d);",
      "            while n % d == 0 {",
      "                n /= d;",
      "            }",
      "        }",
      "        d += 1;",
      "    }",
      "    if n > 1 {",
      "        v.push(n);",
      "    }",
      "    v",
      "}",
      "/// 素数 `p` の最小の原始根を返す。`p == 2` なら 1。",
      "/// 原始根 `g` は位数が `p-1`、すなわち `g^1, g^2, ..., g^{p-1}` が `1..p` を一巡する数。NTT の回転因子や",
      "/// 離散対数の底に使う。",
      "/// `p` は素数であること（`p-1` の素因数分解に試し割りを使うので `p-1` の最大素因数が大きすぎないこと）。",
      "fn 原始根(p: impl TryInto<u64>) -> usize {",
      "    let p: u64 = p",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"原始根: 引数が u64 に収まりません\");",
      "    if p == 2 {",
      "        return 1;",
      "    }",
      "    let 素因数 = 素因数集合(p - 1);",
      "    let mut g = 2u64;",
      "    loop {",
      "        if 素因数.iter().all(|&q| 累乗_mod(g, (p - 1) / q, p) != 1) {",
      "            return g as usize;",
      "        }",
      "        g += 1;",
      "    }",
      "}",
      "/// 素数 `p` を法とする `a`（`a % p != 0`）の乗法的位数（`a^k ≡ 1 mod p` となる最小の正の `k`）。",
      "/// 位数は `p-1` の約数。`p` は素数であること。",
      "fn 位数(a: impl TryInto<u64>, p: impl TryInto<u64>) -> usize {",
      "    let a: u64 = a.try_into().ok().expect(\"位数: 引数が u64 に収まりません\");",
      "    let p: u64 = p.try_into().ok().expect(\"位数: 引数が u64 に収まりません\");",
      "    assert!(a % p != 0, \"a must not be a multiple of p\");",
      "    let mut k = p - 1;",
      "    for q in 素因数集合(p - 1) {",
      "        while k % q == 0 && 累乗_mod(a, k / q, p) == 1 {",
      "            k /= q;",
      "        }",
      "    }",
      "    k as usize",
      "}"
    ]
  },
  "ProjectSelection": {
    "scope": "rust",
    "prefix": "ProjectSelection",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最大重み閉包問題（Project Selection／いわゆる「燃やす埋める」）。",
      "/// 各要素に整数重み `w_i`（負も可）があり、「要素 `i` を選ぶなら `j` も必ず選ぶ」という依存",
      "/// （有向辺 `i→j`）が課されている。依存を満たす部分集合 `S`（`i∈S ⇒ j∈S`）のうち重み総和",
      "/// `Σ_{i∈S} w_i` を最大にするものを求める。空集合も選択可能なので答えは常に `0` 以上。",
      "/// 内部で最小カット（[`ac_library::MfGraph`] の Dinic）へ帰着する。",
      "struct 最大重み閉包 {",
      "    重み: Vec<i64>,",
      "    依存: Vec<(usize, usize)>,",
      "}",
      "impl 最大重み閉包 {",
      "    /// 各要素の重み（負も可）を与えて初期化する。",
      "    fn new(重み: Vec<i64>) -> Self {",
      "        最大重み閉包 {",
      "            重み,",
      "            依存: Vec::new(),",
      "        }",
      "    }",
      "    /// 依存「要素 `i` を選ぶなら `j` も選ぶ」を追加する。",
      "    fn 依存追加(&mut self, i: usize, j: usize) {",
      "        assert!(i < self.重み.len() && j < self.重み.len());",
      "        self.依存.push((i, j));",
      "    }",
      "    /// 最大重みと、それを達成する選択集合 `選択[i]` を返す。`O(最大流)`。",
      "    fn 解く(&self) -> (i64, Vec<bool>) {",
      "        use ac_library::MfGraph;",
      "        const INF: i64 = 1 << 60;",
      "        let n = self.重み.len();",
      "        let (源, 匯) = (n, n + 1);",
      "        let mut g = MfGraph::<i64>::new(n + 2);",
      "        let mut 正の和 = 0i64;",
      "        for (i, &w) in self.重み.iter().enumerate() {",
      "            if w > 0 {",
      "                g.add_edge(源, i, w);",
      "                正の和 += w;",
      "            } else if w < 0 {",
      "                g.add_edge(i, 匯, -w);",
      "            }",
      "        }",
      "        for &(i, j) in &self.依存 {",
      "            g.add_edge(i, j, INF);",
      "        }",
      "        let カット = g.flow(源, 匯);",
      "        let 到達 = g.min_cut(源);",
      "        let 選択 = (0..n).map(|i| 到達[i]).collect();",
      "        (正の和 - カット, 選択)",
      "    }",
      "}"
    ]
  },
