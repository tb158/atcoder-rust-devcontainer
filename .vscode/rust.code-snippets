  "きたまさ_法": {
    "scope": "rust",
    "prefix": "きたまさ_法",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// Berlekamp-Massey 法。数列 `数列`（素数 `法` 上）を生成する最短の線形漸化式の係数を返す。",
      "/// O(N·L)（L は漸化式の次数）。",
      "/// 返り値 `c`（長さ L）は `S[i] = Σ_{j=0}^{L-1} c[j]·S[i-1-j]`（`i ≥ L`）を満たす。",
      "/// 数列は少なくとも `2L` 項あると安全。第 N 項を求めるには [`線形漸化式の第n項`] に渡す。",
      "fn ベルレカンプマッシー(数列: &[u64], 法: u64) -> Vec<u64> {",
      "    let p = 法 as i128;",
      "    let n = 数列.len();",
      "    let s: Vec<i128> = 数列.iter().map(|&x| (x as i128) % p).collect();",
      "    let mut c = vec![0i128; n + 1];",
      "    let mut b = vec![0i128; n + 1];",
      "    c[0] = 1 % p;",
      "    b[0] = 1 % p;",
      "    let mut l = 0usize;",
      "    let mut m = 0usize;",
      "    let mut bb = 1i128 % p;",
      "    for i in 0..n {",
      "        m += 1;",
      "        let mut d = s[i] % p;",
      "        for j in 1..=l {",
      "            d = (d + c[j] * s[i - j]) % p;",
      "        }",
      "        if d == 0 {",
      "            continue;",
      "        }",
      "        let t = c.clone();",
      "        let coef = d * 累乗_mod((bb % p) as u64, 法 - 2, 法) as i128 % p;",
      "        for j in m..=n {",
      "            c[j] = ((c[j] - coef * b[j - m]) % p + p) % p;",
      "        }",
      "        if 2 * l > i {",
      "            continue;",
      "        }",
      "        l = i + 1 - l;",
      "        b = t;",
      "        bb = d;",
      "        m = 0;",
      "    }",
      "    c.truncate(l + 1);",
      "    c.drain(0..1);",
      "    c.iter().map(|&x| (((p - x) % p + p) % p) as u64).collect()",
      "}",
      "/// 多項式の積を `x^k = Σ 係数[j]·x^{k-1-j}` で次数 `k` 未満に縮約する内部関数。",
      "fn 多項式乗算縮約(a: &[u64], b: &[u64], 係数: &[u64], 法: u64) -> Vec<u64> {",
      "    let k = 係数.len();",
      "    let m = 法 as u128;",
      "    let mut res = vec![0u128; (a.len() + b.len()).saturating_sub(1).max(k)];",
      "    for (i, &ai) in a.iter().enumerate() {",
      "        if ai == 0 {",
      "            continue;",
      "        }",
      "        for (j, &bj) in b.iter().enumerate() {",
      "            res[i + j] = (res[i + j] + ai as u128 * bj as u128) % m;",
      "        }",
      "    }",
      "    for d in (k..res.len()).rev() {",
      "        let v = res[d];",
      "        if v != 0 {",
      "            res[d] = 0;",
      "            for (j, &係) in 係数.iter().enumerate() {",
      "                let deg = d - 1 - j;",
      "                res[deg] = (res[deg] + v * 係 as u128) % m;",
      "            }",
      "        }",
      "    }",
      "    res.truncate(k);",
      "    res.resize(k, 0);",
      "    res.iter().map(|&x| x as u64).collect()",
      "}",
      "/// きたまさ法。線形漸化式 `S[i] = Σ_{j} 係数[j]·S[i-1-j]` と初項 `初項`（長さ ≥ 次数）から、",
      "/// 第 `n` 項を素数 `法` で O(k^2 log n) で求める（k は次数）。",
      "fn 線形漸化式の第n項(初項: &[u64], 係数: &[u64], n: usize, 法: u64) -> u64 {",
      "    let k = 係数.len();",
      "    if k == 0 {",
      "        return 0;",
      "    }",
      "    if n < k {",
      "        return 初項[n] % 法;",
      "    }",
      "    let mut 結果 = vec![0u64; k];",
      "    結果[0] = 1 % 法;",
      "    let mut 底 = if k >= 2 {",
      "        let mut v = vec![0u64; k];",
      "        v[1] = 1 % 法;",
      "        v",
      "    } else {",
      "        vec![係数[0] % 法]",
      "    };",
      "    let mut e = n;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            結果 = 多項式乗算縮約(&結果, &底, 係数, 法);",
      "        }",
      "        底 = 多項式乗算縮約(&底, &底, 係数, 法);",
      "        e >>= 1;",
      "    }",
      "    let m = 法 as u128;",
      "    let mut ans = 0u128;",
      "    for (i, &係) in 結果.iter().enumerate() {",
      "        ans = (ans + 係 as u128 * (初項[i] % 法) as u128) % m;",
      "    }",
      "    ans as u64",
      "}",
      "/// 数列の先頭を渡すと、Berlekamp-Massey で漸化式を推定し、きたまさ法で第 `n` 項を返す。",
      "/// 数列は最短漸化式の次数の 2 倍以上の項を含むこと（足りないと誤った外挿になる）。",
      "fn 数列の第n項(数列: &[u64], n: usize, 法: u64) -> u64 {",
      "    let 係数 = ベルレカンプマッシー(数列, 法);",
      "    線形漸化式の第n項(数列, &係数, n, 法)",
      "}"
    ]
  },
  "べき乗_和": {
    "scope": "rust",
    "prefix": "べき乗_和",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 素数 `法` を法とする `a` の逆元（フェルマーの小定理 `a^(法-2)`）。`O(log 法)`。",
      "/// `法` が素数で `a % 法 != 0` であることが前提。合成数を法とする場合や `a` が",
      "/// `法` の倍数の場合は正しい値を返さない（拡張ユークリッドを使うこと）。",
      "fn 逆元(a: u64, 法: u64) -> u64 {",
      "    累乗_mod(a, 法 - 2, 法)",
      "}",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// `0..=上限` の階乗・逆階乗を素数 `法` 上で返す内部関数（二項係数用）。",
      "fn 階乗表(上限: usize, 法: u64) -> (Vec<u64>, Vec<u64>) {",
      "    let mut 階乗 = vec![1u64; 上限 + 1];",
      "    for i in 1..=上限 {",
      "        階乗[i] = 階乗[i - 1] * i as u64 % 法;",
      "    }",
      "    let mut 逆階乗 = vec![1u64; 上限 + 1];",
      "    逆階乗[上限] = 逆元(階乗[上限], 法);",
      "    for i in (0..上限).rev() {",
      "        逆階乗[i] = 逆階乗[i + 1] * (i as u64 + 1) % 法;",
      "    }",
      "    (階乗, 逆階乗)",
      "}",
      "/// ベルヌーイ数 `B_0, B_1, …, B_k` を素数 `法` 上で返す（`B_1 = -1/2` の規約）。`O(k^2)`。",
      "/// 累乗和（Faulhaber 公式）の係数として使う。",
      "fn ベルヌーイ数(k: usize, 法: impl TryInto<u64>) -> Vec<usize> {",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ベルヌーイ数: 引数が u64 に収まりません\");",
      "    let (階乗, 逆階乗) = 階乗表(k + 1, 法);",
      "    let 二項 = |n: usize, r: usize| -> u64 {",
      "        if r > n {",
      "            0",
      "        } else {",
      "            階乗[n] * 逆階乗[r] % 法 * 逆階乗[n - r] % 法",
      "        }",
      "    };",
      "    let mut b = vec![0u64; k + 1];",
      "    b[0] = 1 % 法;",
      "    for m in 1..=k {",
      "        let mut s = 0u64;",
      "        for (j, &bj) in b.iter().enumerate().take(m) {",
      "            s = (s + 二項(m + 1, j) * bj) % 法;",
      "        }",
      "        let 逆 = 逆元((m as u64 + 1) % 法, 法);",
      "        b[m] = (法 - s) % 法 * 逆 % 法;",
      "    }",
      "    b.into_iter().map(|x| x as usize).collect()",
      "}",
      "/// 累乗和 `Σ_{i=1}^{n} i^k mod 法`（`法` は素数）を Faulhaber の公式で `O(k^2)` で返す。`n` は最大 `u64`。",
      "/// 1 個の巨大な `n` と固定の `k` に対し、`n` をいくら大きくしても次数 `k` だけに依存して計算できる。",
      "/// ラグランジュ補間（[`lagrange_interpolation`](crate::lagrange_interpolation)）とは別手法。",
      "fn 累乗和(n: impl TryInto<u64>, k: usize, 法: impl TryInto<u64>) -> usize {",
      "    let n: u64 = n",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"累乗和: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"累乗和: 引数が u64 に収まりません\");",
      "    if k == 0 {",
      "        return (n % 法) as usize;",
      "    }",
      "    let b = ベルヌーイ数(k, 法);",
      "    let (階乗, 逆階乗) = 階乗表(k + 1, 法);",
      "    let 二項 = |n: usize, r: usize| -> u64 {",
      "        if r > n {",
      "            0",
      "        } else {",
      "            階乗[n] * 逆階乗[r] % 法 * 逆階乗[n - r] % 法",
      "        }",
      "    };",
      "    let m = (n % 法 + 1) % 法;",
      "    let mut s = 0u64;",
      "    for (j, &bj) in b.iter().enumerate() {",
      "        let 項 = 二項(k + 1, j) * bj as u64 % 法 * 累乗_mod(m, (k + 1 - j) as u64, 法) % 法;",
      "        s = (s + 項) % 法;",
      "    }",
      "    (s * 逆元((k as u64 + 1) % 法, 法) % 法) as usize",
      "}"
    ]
  },
  "アダマール_変換": {
    "scope": "rust",
    "prefix": "アダマール_変換",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 高速ウォルシュ–アダマール変換（in-place）。長さ `2^k` の配列を `O(n log n)` で変換する。",
      "/// 2 回適用すると各要素が `n` 倍になる（自己逆変換）。XOR 畳み込みの土台。",
      "/// 変換途中で負の値が出るため、符号なし整数は不可（i64 / f64 / ModInt などを使う）。",
      "fn アダマール変換<T>(a: &mut [T])",
      "where",
      "    T: Copy + std::ops::Add<Output = T> + std::ops::Sub<Output = T>,",
      "{",
      "    let n = a.len();",
      "    let mut 幅 = 1;",
      "    while 幅 < n {",
      "        let mut i = 0;",
      "        while i < n {",
      "            for j in i..i + 幅 {",
      "                let x = a[j];",
      "                let y = a[j + 幅];",
      "                a[j] = x + y;",
      "                a[j + 幅] = x - y;",
      "            }",
      "            i += 幅 << 1;",
      "        }",
      "        幅 <<= 1;",
      "    }",
      "}",
      "/// XOR 畳み込み。`h[k] = Σ_{i ^ j = k} f[i]·g[j]` を `O(n log n)` で返す（配列長は `2^k`）。",
      "/// ビット XOR をキーにした数え上げ・確率分布の合成に使う。",
      "/// 下位/上位集合ゼータ（[`zeta_mobius`](crate::zeta_mobius)）が AND/OR 畳み込みなのに対し、こちらは XOR。",
      "/// 要素型は i64 / f64 / ModInt など（符号なし整数は不可。ModInt は mod が奇素数なら `n` で割れる）。",
      "fn xor畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy",
      "        + std::ops::Add<Output = T>",
      "        + std::ops::Sub<Output = T>",
      "        + std::ops::MulAssign",
      "        + std::ops::DivAssign",
      "        + From<u32>,",
      "{",
      "    assert_eq!(f.len(), g.len(), \"f と g は同じ長さ\");",
      "    assert!(f.len().is_power_of_two(), \"長さは 2 のべき乗\");",
      "    let n = f.len();",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut a = f.to_vec();",
      "    let mut b = g.to_vec();",
      "    アダマール変換(&mut a);",
      "    アダマール変換(&mut b);",
      "    a.iter_mut().zip(&b).for_each(|(x, y)| *x *= *y);",
      "    アダマール変換(&mut a);",
      "    let 除数 = T::from(n as u32);",
      "    a.iter_mut().for_each(|x| *x /= 除数);",
      "    a",
      "}"
    ]
  },
  "ウェーブレット_行列": {
    "scope": "rust",
    "prefix": "ウェーブレット_行列",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// rank 補助付きビットベクトル（ウェーブレット行列の各層）。64 ビットブロック + 累積 popcount。",
      "struct ビットベクトル {",
      "    bits: Vec<u64>,",
      "    累積: Vec<u32>,",
      "}",
      "impl ビットベクトル {",
      "    fn new(n: usize) -> Self {",
      "        let ブロック数 = n / 64 + 1;",
      "        Self {",
      "            bits: vec![0; ブロック数],",
      "            累積: vec![0; ブロック数 + 1],",
      "        }",
      "    }",
      "    fn 立てる(&mut self, i: usize) {",
      "        self.bits[i / 64] |= 1 << (i % 64);",
      "    }",
      "    fn 構築(&mut self) {",
      "        for i in 0..self.bits.len() {",
      "            self.累積[i + 1] = self.累積[i] + self.bits[i].count_ones();",
      "        }",
      "    }",
      "    /// `[0, i)` に含まれる 1 の個数。",
      "    fn rank1(&self, i: usize) -> usize {",
      "        let ブロック = i / 64;",
      "        let 余り = i % 64;",
      "        let マスク = if 余り == 0 {",
      "            0",
      "        } else {",
      "            self.bits[ブロック] & ((1u64 << 余り) - 1)",
      "        };",
      "        self.累積[ブロック] as usize + マスク.count_ones() as usize",
      "    }",
      "    /// `[0, i)` に含まれる 0 の個数。",
      "    fn rank0(&self, i: usize) -> usize {",
      "        i - self.rank1(i)",
      "    }",
      "}",
      "/// ウェーブレット行列。非負整数列に対し「位置区間 `[l, r)` の第 k 小」「位置区間 × 値域の個数」を",
      "/// それぞれ O(ビット長) で答える静的構造。構築 O(N·ビット長)。",
      "/// 位置・値域はいずれも `a..b` / `a..=b` / `..b` / `a..` / `..` を受け取れる（`RangeBounds`）。",
      "/// 値域が広くても座標圧縮なしに `u64` のまま扱える（ビット長は最大値で決まる）。",
      "/// 同種の用途（区間第 k 小・順位）を提供するクレートは AtCoder 標準セットにないため自作する。",
      "struct ウェーブレット行列 {",
      "    n: usize,",
      "    ビット数: usize,",
      "    層: Vec<ビットベクトル>,",
      "    ゼロ数: Vec<usize>,",
      "}",
      "impl ウェーブレット行列 {",
      "    /// 非負整数列から構築する。",
      "    fn new(配列: &[impl TryInto<u64> + Copy]) -> Self {",
      "        let 配列: Vec<u64> = 配列",
      "            .iter()",
      "            .map(|&x| {",
      "                x.try_into()",
      "                    .ok()",
      "                    .expect(\"WaveletMatrix: 引数が u64 に収まりません\")",
      "            })",
      "            .collect();",
      "        let n = 配列.len();",
      "        let 最大 = 配列.iter().copied().max().unwrap_or(0);",
      "        let ビット数 = (64 - 最大.leading_zeros() as usize).max(1);",
      "        let mut 現在 = 配列.to_vec();",
      "        let mut 層 = Vec::with_capacity(ビット数);",
      "        let mut ゼロ数 = Vec::with_capacity(ビット数);",
      "        for b in (0..ビット数).rev() {",
      "            let mut bv = ビットベクトル::new(n);",
      "            for (i, &x) in 現在.iter().enumerate() {",
      "                if x >> b & 1 == 1 {",
      "                    bv.立てる(i);",
      "                }",
      "            }",
      "            bv.構築();",
      "            let mut ゼロ群 = Vec::with_capacity(n);",
      "            let mut 一群 = Vec::new();",
      "            for &x in &現在 {",
      "                if x >> b & 1 == 1 {",
      "                    一群.push(x);",
      "                } else {",
      "                    ゼロ群.push(x);",
      "                }",
      "            }",
      "            ゼロ数.push(ゼロ群.len());",
      "            ゼロ群.extend(一群);",
      "            現在 = ゼロ群;",
      "            層.push(bv);",
      "        }",
      "        Self {",
      "            n,",
      "            ビット数,",
      "            層,",
      "            ゼロ数,",
      "        }",
      "    }",
      "    /// 位置範囲 `位置`（`a..b` / `a..=b` / `..` など）で `k` 番目（0-indexed、昇順）に",
      "    /// 小さい値。`k < 範囲の長さ` であること。",
      "    fn 区間k番目(&self, 位置: impl std::ops::RangeBounds<usize>, mut k: usize) -> usize {",
      "        let (mut l, mut r) = 半開(位置, self.n);",
      "        assert!(l <= r && r <= self.n && k < r - l, \"区間k番目: 範囲外\");",
      "        let mut 結果 = 0u64;",
      "        for d in 0..self.ビット数 {",
      "            let bv = &self.層[d];",
      "            let l0 = bv.rank0(l);",
      "            let r0 = bv.rank0(r);",
      "            let ゼロ個 = r0 - l0;",
      "            if k < ゼロ個 {",
      "                l = l0;",
      "                r = r0;",
      "            } else {",
      "                結果 |= 1 << (self.ビット数 - 1 - d);",
      "                k -= ゼロ個;",
      "                let z = self.ゼロ数[d];",
      "                l = z + (l - l0);",
      "                r = z + (r - r0);",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 位置 `[l, r)` の中で値が `x` 未満である要素の個数（内部プリミティブ）。",
      "    fn 未満数(&self, mut l: usize, mut r: usize, x: u64) -> usize {",
      "        if x >> self.ビット数 != 0 {",
      "            return r - l;",
      "        }",
      "        let mut 個数 = 0usize;",
      "        for d in 0..self.ビット数 {",
      "            let bv = &self.層[d];",
      "            let l0 = bv.rank0(l);",
      "            let r0 = bv.rank0(r);",
      "            if x >> (self.ビット数 - 1 - d) & 1 == 1 {",
      "                個数 += r0 - l0;",
      "                let z = self.ゼロ数[d];",
      "                l = z + (l - l0);",
      "                r = z + (r - r0);",
      "            } else {",
      "                l = l0;",
      "                r = r0;",
      "            }",
      "        }",
      "        個数",
      "    }",
      "    /// 位置範囲 `位置` にある要素のうち、値が `値域` に入るものの個数。",
      "    /// 位置は `a..b` / `a..=b` / `..` など、値域は `a..b` / `a..=b` / `..b`（＝旧「未満の個数」）/",
      "    /// `a..` / `..` などを受け取れる。値域の端点は `i64`・`usize` など `u64` へ変換できる整数型で",
      "    /// よい（負や超過は panic）。",
      "    fn 区間内個数<T: Copy + TryInto<u64>>(",
      "        &self,",
      "        位置: impl std::ops::RangeBounds<usize>,",
      "        値域: impl std::ops::RangeBounds<T>,",
      "    ) -> usize {",
      "        use std::ops::Bound::{Excluded, Included, Unbounded};",
      "        let (l, r) = 半開(位置, self.n);",
      "        assert!(l <= r && r <= self.n, \"区間内個数: 範囲外\");",
      "        let 上限個数 = match 値域.end_bound() {",
      "            Included(&x) => self.未満数(l, r, to_u64(x).saturating_add(1)),",
      "            Excluded(&x) => self.未満数(l, r, to_u64(x)),",
      "            Unbounded => r - l,",
      "        };",
      "        let 下限個数 = match 値域.start_bound() {",
      "            Included(&x) => self.未満数(l, r, to_u64(x)),",
      "            Excluded(&x) => self.未満数(l, r, to_u64(x).saturating_add(1)),",
      "            Unbounded => 0,",
      "        };",
      "        上限個数.saturating_sub(下限個数)",
      "    }",
      "}"
    ]
  },
  "ウォルシュ_アダマール": {
    "scope": "rust",
    "prefix": "ウォルシュ_アダマール",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 高速ウォルシュ–アダマール変換（in-place）。長さ `2^k` の配列を `O(n log n)` で変換する。",
      "/// 2 回適用すると各要素が `n` 倍になる（自己逆変換）。XOR 畳み込みの土台。",
      "/// 変換途中で負の値が出るため、符号なし整数は不可（i64 / f64 / ModInt などを使う）。",
      "fn アダマール変換<T>(a: &mut [T])",
      "where",
      "    T: Copy + std::ops::Add<Output = T> + std::ops::Sub<Output = T>,",
      "{",
      "    let n = a.len();",
      "    let mut 幅 = 1;",
      "    while 幅 < n {",
      "        let mut i = 0;",
      "        while i < n {",
      "            for j in i..i + 幅 {",
      "                let x = a[j];",
      "                let y = a[j + 幅];",
      "                a[j] = x + y;",
      "                a[j + 幅] = x - y;",
      "            }",
      "            i += 幅 << 1;",
      "        }",
      "        幅 <<= 1;",
      "    }",
      "}",
      "/// XOR 畳み込み。`h[k] = Σ_{i ^ j = k} f[i]·g[j]` を `O(n log n)` で返す（配列長は `2^k`）。",
      "/// ビット XOR をキーにした数え上げ・確率分布の合成に使う。",
      "/// 下位/上位集合ゼータ（[`zeta_mobius`](crate::zeta_mobius)）が AND/OR 畳み込みなのに対し、こちらは XOR。",
      "/// 要素型は i64 / f64 / ModInt など（符号なし整数は不可。ModInt は mod が奇素数なら `n` で割れる）。",
      "fn xor畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy",
      "        + std::ops::Add<Output = T>",
      "        + std::ops::Sub<Output = T>",
      "        + std::ops::MulAssign",
      "        + std::ops::DivAssign",
      "        + From<u32>,",
      "{",
      "    assert_eq!(f.len(), g.len(), \"f と g は同じ長さ\");",
      "    assert!(f.len().is_power_of_two(), \"長さは 2 のべき乗\");",
      "    let n = f.len();",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut a = f.to_vec();",
      "    let mut b = g.to_vec();",
      "    アダマール変換(&mut a);",
      "    アダマール変換(&mut b);",
      "    a.iter_mut().zip(&b).for_each(|(x, y)| *x *= *y);",
      "    アダマール変換(&mut a);",
      "    let 除数 = T::from(n as u32);",
      "    a.iter_mut().for_each(|x| *x /= 除数);",
      "    a",
      "}"
    ]
  },
  "エイホ_コラシック": {
    "scope": "rust",
    "prefix": "エイホ_コラシック",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::{HashMap, VecDeque};",
      "/// Aho-Corasick 法による複数パターン同時照合。バイト列（`&[u8]`）を対象とする。",
      "/// トライ + fail リンクを構築し、テキストを 1 度走査して各パターンの**出現回数**を",
      "/// まとめて数える。重なる出現も全て数える。",
      "struct エイホコラシック {",
      "    遷移: Vec<HashMap<u8, usize>>,",
      "    fail: Vec<usize>,",
      "    bfs順: Vec<usize>,",
      "    パターン終端: Vec<usize>,",
      "}",
      "impl エイホコラシック {",
      "    /// パターン群から構築する。O(Σパターン長)。空パターンは終端＝根として扱う。",
      "    fn new(パターン群: &[&[u8]]) -> Self {",
      "        let mut 遷移: Vec<HashMap<u8, usize>> = vec![HashMap::new()];",
      "        let mut パターン終端 = vec![0usize; パターン群.len()];",
      "        for (pi, pat) in パターン群.iter().enumerate() {",
      "            let mut cur = 0usize;",
      "            for &c in *pat {",
      "                if let Some(&nx) = 遷移[cur].get(&c) {",
      "                    cur = nx;",
      "                } else {",
      "                    let 新 = 遷移.len();",
      "                    遷移.push(HashMap::new());",
      "                    遷移[cur].insert(c, 新);",
      "                    cur = 新;",
      "                }",
      "            }",
      "            パターン終端[pi] = cur;",
      "        }",
      "        let mut fail = vec![0usize; 遷移.len()];",
      "        let mut bfs順 = Vec::new();",
      "        let mut 探索 = VecDeque::new();",
      "        let 直下: Vec<usize> = 遷移[0].values().copied().collect();",
      "        for next in 直下 {",
      "            fail[next] = 0;",
      "            bfs順.push(next);",
      "            探索.push_back(next);",
      "        }",
      "        while let Some(now) = 探索.pop_front() {",
      "            let 子: Vec<(u8, usize)> = 遷移[now].iter().map(|(&c, &next)| (c, next)).collect();",
      "            for (c, next) in 子 {",
      "                let mut f = fail[now];",
      "                let nf = loop {",
      "                    if let Some(&nx) = 遷移[f].get(&c) {",
      "                        break nx;",
      "                    }",
      "                    if f == 0 {",
      "                        break 0;",
      "                    }",
      "                    f = fail[f];",
      "                };",
      "                fail[next] = nf;",
      "                bfs順.push(next);",
      "                探索.push_back(next);",
      "            }",
      "        }",
      "        Self {",
      "            遷移,",
      "            fail,",
      "            bfs順,",
      "            パターン終端,",
      "        }",
      "    }",
      "    /// 文字 `c` での遷移（fail リンクを辿るオートマトン遷移）。",
      "    fn 進む(&self, mut v: usize, c: u8) -> usize {",
      "        loop {",
      "            if let Some(&nx) = self.遷移[v].get(&c) {",
      "                return nx;",
      "            }",
      "            if v == 0 {",
      "                return 0;",
      "            }",
      "            v = self.fail[v];",
      "        }",
      "    }",
      "    /// `テキスト` 中での各パターンの出現回数を、`new` に渡した順で返す。",
      "    /// O(テキスト長 + マッチ数)。",
      "    fn 出現回数(&self, テキスト: &[u8]) -> Vec<usize> {",
      "        let mut 訪問 = vec![0usize; self.遷移.len()];",
      "        let mut v = 0usize;",
      "        for &c in テキスト {",
      "            v = self.進む(v, c);",
      "            訪問[v] += 1;",
      "        }",
      "        for &node in self.bfs順.iter().rev() {",
      "            訪問[self.fail[node]] += 訪問[node];",
      "        }",
      "        self.パターン終端.iter().map(|&node| 訪問[node]).collect()",
      "    }",
      "}"
    ]
  },
