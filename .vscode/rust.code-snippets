      "/// O(V^3)。",
      "/// `辺` は有向辺 `(u, v)`（`u → v`、`0..頂点数`、多重辺可・自己ループは無視）。",
      "/// 無向版 [`全域木数_mod`] と違って辺の向きを区別する。",
      "/// 「根に向かう（in-arborescence）」全域木を数えたいときは全辺を逆向きにして渡す。",
      "fn 有向全域木数_mod(頂点数: usize, 辺: &[(usize, usize)], 根: usize, 法: u64) -> u64 {",
      "    if 頂点数 == 0 {",
      "        return 0;",
      "    }",
      "    if 頂点数 == 1 {",
      "        return 1 % 法;",
      "    }",
      "    let n = 頂点数;",
      "    let mut l = vec![vec![0u64; n]; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            continue;",
      "        }",
      "        l[v][v] = (l[v][v] + 1) % 法;",
      "        l[u][v] = (l[u][v] + 法 - 1) % 法;",
      "    }",
      "    let 残: Vec<usize> = (0..n).filter(|&i| i != 根).collect();",
      "    let 小行列: Vec<Vec<u64>> = 残",
      "        .iter()",
      "        .map(|&i| 残.iter().map(|&j| l[i][j]).collect())",
      "        .collect();",
      "    行列式_mod(小行列, 法)",
      "}"
    ]
  },
  "有向_最小_全域木": {
    "scope": "rust",
    "prefix": "有向_最小_全域木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最小有向全域木（最小全域内向木 / arborescence）の総コストを Chu-Liu/Edmonds 法で求める。",
      "/// 根から全頂点へ到達する有向木のうちコスト最小のもの。O(V·E)。",
      "/// `辺` は `(始点, 終点, コスト)`。根から到達できない頂点があれば `None`。",
      "/// petgraph の `min_spanning_tree` は無向専用なので、有向版が要るときはこれを使う。",
      "fn 最小有向全域木(頂点数: usize, 根: usize, 辺: &[(usize, usize, i64)]) -> Option<i64> {",
      "    const 無限: i64 = i64::MAX;",
      "    let mut n = 頂点数;",
      "    let mut 根 = 根;",
      "    let mut 辺: Vec<(usize, usize, i64)> = 辺.to_vec();",
      "    let mut 合計 = 0i64;",
      "    loop {",
      "        let mut 入コスト = vec![無限; n];",
      "        let mut 入元 = vec![!0; n];",
      "        for &(u, v, w) in &辺 {",
      "            if u != v && w < 入コスト[v] {",
      "                入コスト[v] = w;",
      "                入元[v] = u;",
      "            }",
      "        }",
      "        for (v, &c) in 入コスト.iter().enumerate() {",
      "            if v != 根 && c == 無限 {",
      "                return None;",
      "            }",
      "        }",
      "        let mut id = vec![!0; n];",
      "        let mut 到達済 = vec![!0; n];",
      "        let mut 閉路数 = 0usize;",
      "        #[allow(clippy::needless_range_loop)]",
      "        for v in 0..n {",
      "            if v == 根 {",
      "                continue;",
      "            }",
      "            合計 += 入コスト[v];",
      "            let mut u = v;",
      "            while 到達済[u] != v && id[u] == !0 && u != 根 {",
      "                到達済[u] = v;",
      "                u = 入元[u];",
      "            }",
      "            if u != 根 && id[u] == !0 {",
      "                let mut x = 入元[u];",
      "                while x != u {",
      "                    id[x] = 閉路数;",
      "                    x = 入元[x];",
      "                }",
      "                id[u] = 閉路数;",
      "                閉路数 += 1;",
      "            }",
      "        }",
      "        if 閉路数 == 0 {",
      "            return Some(合計);",
      "        }",
      "        for x in id.iter_mut() {",
      "            if *x == !0 {",
      "                *x = 閉路数;",
      "                閉路数 += 1;",
      "            }",
      "        }",
      "        let mut 新辺 = Vec::new();",
      "        for &(u, v, w) in &辺 {",
      "            if id[u] != id[v] {",
      "                新辺.push((id[u], id[v], w - 入コスト[v]));",
      "            }",
      "        }",
      "        辺 = 新辺;",
      "        n = 閉路数;",
      "        根 = id[根];",
      "    }",
      "}"
    ]
  },
  "有理数_近似": {
    "scope": "rust",
    "prefix": "有理数_近似",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::cmp::Ordering;",
      "/// 非負の有理数 `分子 / 分母`（`分母 > 0`）の正則連分数展開 `[a0; a1, a2, …]` を返す。",
      "/// ユークリッドの互除法そのもの。`O(log 分母)`。",
      "fn 連分数展開(分子: impl TryInto<i64>, 分母: impl TryInto<i64>) -> Vec<i64> {",
      "    let mut 分子 = 分子",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連分数展開: 引数が i64 に収まりません\");",
      "    let mut 分母 = 分母",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連分数展開: 引数が i64 に収まりません\");",
      "    assert!(分母 > 0 && 分子 >= 0, \"分子 >= 0, 分母 > 0\");",
      "    let mut 係数 = Vec::new();",
      "    while 分母 != 0 {",
      "        係数.push(分子 / 分母);",
      "        let r = 分子 % 分母;",
      "        分子 = 分母;",
      "        分母 = r;",
      "    }",
      "    係数",
      "}",
      "/// 連分数係数列から収束分数（convergent）`(分子, 分母)` の列を返す。",
      "/// `h_i = a_i·h_{i-1} + h_{i-2}`, `k_i = a_i·k_{i-1} + k_{i-2}`。各収束分数は既約。",
      "fn 収束分数(係数: &[i64]) -> Vec<(i64, i64)> {",
      "    let mut 列 = Vec::with_capacity(係数.len());",
      "    let (mut h2, mut h1) = (0i64, 1i64);",
      "    let (mut k2, mut k1) = (1i64, 0i64);",
      "    for &a in 係数 {",
      "        let h = a * h1 + h2;",
      "        let k = a * k1 + k2;",
      "        列.push((h, k));",
      "        h2 = h1;",
      "        h1 = h;",
      "        k2 = k1;",
      "        k1 = k;",
      "    }",
      "    列",
      "}",
      "/// `分子/分母` への近さ `|分子/分母 - a/b|` を厳密に比較する内部関数（小さいほど近い）。",
      "fn 距離cmp(分子: i64, 分母: i64, x: (i64, i64), y: (i64, i64)) -> Ordering {",
      "    let (p, q) = (分子 as i128, 分母 as i128);",
      "    let dx = (p * x.1 as i128 - x.0 as i128 * q).abs() * y.1 as i128;",
      "    let dy = (p * y.1 as i128 - y.0 as i128 * q).abs() * x.1 as i128;",
      "    dx.cmp(&dy)",
      "}",
      "/// `x = 分子/分母` に最も近い有理数 `a/b`（`1 <= b <= 分母上限`）を `O(log 分母)` で求める。",
      "/// 連分数の収束分数と半収束分数（semiconvergent）のうち、分母が上限以下で最も近いものを返す。",
      "/// 距離が等しいときは分母が小さい方。`x` が `分母上限` 以下の分母で厳密表現できればそれを返す。",
      "/// Stern–Brocot 木上の最良近似。",
      "fn 最良有理近似(",
      "    分子: impl TryInto<i64>,",
      "    分母: impl TryInto<i64>,",
      "    分母上限: impl TryInto<i64>,",
      ") -> (i64, i64) {",
      "    let 分子 = 分子",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    let 分母 = 分母",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    let 分母上限 = 分母上限",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    assert!(分母 > 0 && 分子 >= 0 && 分母上限 >= 1);",
      "    let (mut a, mut b) = (分子, 分母);",
      "    let (mut h2, mut h1) = (0i64, 1i64);",
      "    let (mut k2, mut k1) = (1i64, 0i64);",
      "    loop {",
      "        if b == 0 {",
      "            return (h1, k1);",
      "        }",
      "        let ai = a / b;",
      "        let r = a % b;",
      "        let k = ai * k1 + k2;",
      "        if k > 分母上限 {",
      "            let ap = (分母上限 - k2) / k1;",
      "            let 半 = (ap * h1 + h2, ap * k1 + k2);",
      "            let 前 = (h1, k1);",
      "            return match 距離cmp(分子, 分母, 半, 前) {",
      "                Ordering::Less => 半,",
      "                Ordering::Greater => 前,",
      "                Ordering::Equal => {",
      "                    if 半.1 <= 前.1 {",
      "                        半",
      "                    } else {",
      "                        前",
      "                    }",
      "                }",
      "            };",
      "        }",
      "        let h = ai * h1 + h2;",
      "        h2 = h1;",
      "        h1 = h;",
      "        k2 = k1;",
      "        k1 = k;",
      "        a = b;",
      "        b = r;",
      "    }",
      "}"
    ]
  },
  "木_LCA": {
    "scope": "rust",
    "prefix": "木_LCA",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木の LCA（ダブリング / 二分上昇）。前処理 `O(N log N)`、クエリ `O(log N)`。",
      "/// 入力は AtCoder の辺入力をそのまま 0-indexed にした `辺: &[(usize, usize)]`。連結な木を前提とする。",
      "/// - [`Self::lca`] : 最近共通祖先。",
      "/// - [`Self::距離`] : 2 頂点間の距離（辺の本数）。",
      "/// - [`Self::パス頂点列`] : `u` から `v` へ向かうパス上の頂点列。",
      "/// - [`Self::祖先`] : `k` 個上の祖先（level ancestor）。",
      "/// 構築は反復 DFS なので、`N = 2 * 10^5` の一直線の木でもスタックが溢れない。",
      "struct 木Lca {",
      "    log: usize,",
      "    /// `上[k][v]`: `v` の `2^k` 個上の祖先。根より上は根自身（自己ループ）で埋める。",
      "    上: Vec<Vec<usize>>,",
      "    深さ: Vec<usize>,",
      "    根: usize,",
      "}",
      "impl 木Lca {",
      "    /// 頂点数 `n`・辺リスト `辺` の木を、頂点 0 を根として前処理する。",
      "    fn new(n: usize, 辺: &[(usize, usize)]) -> Self {",
      "        Self::根付き(n, 辺, 0)",
      "    }",
      "    /// 根を明示して前処理する。",
      "    fn 根付き(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let log = ((usize::BITS - n.leading_zeros()) as usize).max(1);",
      "        let mut 上 = vec![vec![根; n]; log];",
      "        let mut 深さ = vec![0usize; n];",
      "        if n == 0 {",
      "            return Self {",
      "                log, 上, 深さ, 根",
      "            };",
      "        }",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut 探索 = vec![(根, 根)];",
      "        while let Some((now, prev)) = 探索.pop() {",
      "            上[0][now] = prev;",
      "            for &next in &グラフ[now] {",
      "                if next != prev {",
      "                    深さ[next] = 深さ[now] + 1;",
      "                    探索.push((next, now));",
      "                }",
      "            }",
      "        }",
      "        for k in 1..log {",
      "            let (下位, 上位) = 上.split_at_mut(k);",
      "            let 一段下 = &下位[k - 1];",
      "            for now in 0..n {",
      "                上位[0][now] = 一段下[一段下[now]];",
      "            }",
      "        }",
      "        Self {",
      "            log, 上, 深さ, 根",
      "        }",
      "    }",
      "    /// 根。",
      "    fn 根(&self) -> usize {",
      "        self.根",
      "    }",
      "    /// 根から `v` までの辺数。",
      "    fn 深さ(&self, v: usize) -> usize {",
      "        self.深さ[v]",
      "    }",
      "    /// `v` の親。根の親は根自身。",
      "    fn 親(&self, v: usize) -> usize {",
      "        self.上[0][v]",
      "    }",
      "    /// `v` の `k` 個上の祖先。根を通り越す場合（`k > 深さ(v)`）は `None`。",
      "    fn 祖先(&self, mut v: usize, k: usize) -> Option<usize> {",
      "        if k > self.深さ[v] {",
      "            return None;",
      "        }",
      "        for i in 0..self.log {",
      "            if k >> i & 1 == 1 {",
      "                v = self.上[i][v];",
      "            }",
      "        }",
      "        Some(v)",
      "    }",
      "    /// 最近共通祖先。",
      "    fn lca(&self, mut u: usize, mut v: usize) -> usize {",
      "        if self.深さ[u] < self.深さ[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = self.深さ[u] - self.深さ[v];",
      "        for k in 0..self.log {",
      "            if 差 >> k & 1 == 1 {",
      "                u = self.上[k][u];",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for k in (0..self.log).rev() {",
      "            if self.上[k][u] != self.上[k][v] {",
      "                u = self.上[k][u];",
      "                v = self.上[k][v];",
      "            }",
      "        }",
      "        self.上[0][u]",
      "    }",
      "    /// `u`-`v` 間の距離（辺の本数）。",
      "    fn 距離(&self, u: usize, v: usize) -> usize {",
      "        self.深さ[u] + self.深さ[v] - 2 * self.深さ[self.lca(u, v)]",
      "    }",
      "    /// `u` から `v` へ向かうパス上の頂点列（`u` が先頭、`v` が末尾、両端を含む）。",
      "    /// 長さは `距離(u, v) + 1`。パスの長さに比例した時間がかかる。",
      "    fn パス頂点列(&self, u: usize, v: usize) -> Vec<usize> {",
      "        let w = self.lca(u, v);",
      "        let mut 列 = Vec::new();",
      "        let mut x = u;",
      "        while x != w {",
      "            列.push(x);",
      "            x = self.上[0][x];",
      "        }",
      "        列.push(w);",
      "        let mut 後半 = Vec::new();",
      "        let mut y = v;",
      "        while y != w {",
      "            後半.push(y);",
      "            y = self.上[0][y];",
      "        }",
      "        後半.reverse();",
      "        列.extend(後半);",
      "        列",
      "    }",
      "}"
    ]
  },
  "木_パス_クエリ": {
    "scope": "rust",
    "prefix": "木_パス_クエリ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// HL 分解（Heavy-Light Decomposition）。根付き木のパス/部分木を `pos` 上の連続区間に",
      "/// 落とし込み、`ac_library::Segtree` 等の区間データ構造と組み合わせて使う。構築 O(N)。",
      "/// - [`Self::パス区間`] : `u`-`v` パス（頂点モデル、LCA を含む）を半開区間 `[l, r)` の列に分解。",
      "/// - [`Self::部分木区間`] : `v` の部分木を 1 つの半開区間に。",
      "/// - [`Self::lca`] : 最近共通祖先 O(log N)。",
      "/// `pos[v]` は heavy path が連続するよう振った Euler 順位置。区間データ構造には",
      "/// `pos` 順で値を載せる。辺に値を持たせたい場合は「子頂点に辺の値を載せ、パス分解時に",
      "/// LCA を 1 つ除く」運用にする。",
      "struct 重軽分解 {",
      "    prev: Vec<usize>,",
      "    深さ: Vec<usize>,",
      "    sz: Vec<usize>,",
      "    /// `head[v]`: `v` を含む heavy path の先頭（最も浅い）頂点",
      "    head: Vec<usize>,",
      "    /// `pos[v]`: 区間データ構造上での `v` の位置",
      "    pos: Vec<usize>,",
      "}",
      "impl 重軽分解 {",
      "    /// 頂点数 `n`・辺リスト `辺`（AtCoder の入力そのまま）と根から構築する。O(N)。",
      "    fn new(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut prev = vec![!0; n];",
      "        let mut 深さ = vec![0usize; n];",
      "        let mut sz = vec![1usize; n];",
      "        let mut heavy = vec![!0; n];",
      "        let mut 順 = Vec::with_capacity(n);",
      "        let mut 探索 = vec![根];",
      "        while let Some(now) = 探索.pop() {",
      "            順.push(now);",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] {",
      "                    prev[next] = now;",
      "                    深さ[next] = 深さ[now] + 1;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        for &now in 順.iter().rev() {",
      "            let mut 最大 = 0;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] {",
      "                    sz[now] += sz[next];",
      "                    if sz[next] > 最大 {",
      "                        最大 = sz[next];",
      "                        heavy[now] = next;",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        let mut head = vec![0usize; n];",
      "        let mut pos = vec![0usize; n];",
      "        let mut 次位置 = 0usize;",
      "        let mut 探索 = vec![(根, 根)];",
      "        while let Some((now, h)) = 探索.pop() {",
      "            head[now] = h;",
      "            pos[now] = 次位置;",
      "            次位置 += 1;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] && next != heavy[now] {",
      "                    探索.push((next, next));",
      "                }",
      "            }",
      "            if heavy[now] != !0 {",
      "                探索.push((heavy[now], h));",
      "            }",
      "        }",
