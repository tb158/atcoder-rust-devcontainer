  "円の_共通_接線": {
    "scope": "rust",
    "prefix": "円の_共通_接線",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円の共通接線の本数を返す。同心で半径が等しい場合のみ無数（`!0`）。`O(1)`。",
      "/// 中心間距離 `d` と半径から分類する：`d>r1+r2`→4、`=r1+r2`→3、`|r1-r2|<d<r1+r2`→2、",
      "/// `d=|r1-r2|`→1、`d<|r1-r2|`→0（一方が他方の内部）。半径 0（点）も同じ枠組みで扱える。",
      "fn 共通接線本数(c1: 点, r1: f64, c2: 点, r2: f64) -> usize {",
      "    const EPS: f64 = 1e-9;",
      "    let d = (c1.0 - c2.0).hypot(c1.1 - c2.1);",
      "    let 和 = r1 + r2;",
      "    let 差 = (r1 - r2).abs();",
      "    if d < EPS && 差 < EPS {",
      "        return !0;",
      "    }",
      "    if d > 和 + EPS {",
      "        4",
      "    } else if (d - 和).abs() <= EPS {",
      "        3",
      "    } else if d > 差 + EPS {",
      "        2",
      "    } else if (d - 差).abs() <= EPS {",
      "        1",
      "    } else {",
      "        0",
      "    }",
      "}"
    ]
  },
  "凸_判定": {
    "scope": "rust",
    "prefix": "凸_判定",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 頂点列が凸多角形をなすか（同一向きに曲がり続けるか）を判定する。O(N)。",
      "/// 共線な 3 点は許容する。`n < 3` は `false`。",
      "fn 凸多角形か(多角形: &[(i64, i64)]) -> bool {",
      "    let n = 多角形.len();",
      "    if n < 3 {",
      "        return false;",
      "    }",
      "    let mut 符号 = 0i64;",
      "    for i in 0..n {",
      "        let (ax, ay) = 多角形[i];",
      "        let (bx, by) = 多角形[(i + 1) % n];",
      "        let (cx, cy) = 多角形[(i + 2) % n];",
      "        let 外積 = (bx - ax) * (cy - by) - (by - ay) * (cx - bx);",
      "        if 外積 != 0 {",
      "            let s = 外積.signum();",
      "            if 符号 == 0 {",
      "                符号 = s;",
      "            } else if 符号 != s {",
      "                return false;",
      "            }",
      "        }",
      "    }",
      "    true",
      "}"
    ]
  },
  "凸_多角形_内包": {
    "scope": "rust",
    "prefix": "凸_多角形_内包",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (i64, i64);",
      "/// 反時計回りの凸多角形 `多角形` に点 `q` が含まれるかを `O(log N)` で判定する。",
      "/// `2` = 内部、`1` = 辺・頂点上、`0` = 外部。座標は整数のまま厳密判定。",
      "/// 多角形は**狭義凸**（連続 3 頂点が共線でない）かつ反時計回りであることを前提とする。",
      "/// [`点の内外`](crate::polygon::点の内外) は任意の単純多角形を `O(N)` で判定する別物。",
      "fn 凸多角形内包(多角形: &[点], q: 点) -> i32 {",
      "    let p = 多角形;",
      "    let n = p.len();",
      "    let 外積 = |o: 点, a: 点, b: 点| -> i128 {",
      "        (a.0 - o.0) as i128 * (b.1 - o.1) as i128 - (a.1 - o.1) as i128 * (b.0 - o.0) as i128",
      "    };",
      "    let 線分上 = |a: 点, b: 点| (q.0 - a.0) * (q.0 - b.0) <= 0 && (q.1 - a.1) * (q.1 - b.1) <= 0;",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    if n == 1 {",
      "        return if q == p[0] { 1 } else { 0 };",
      "    }",
      "    if n == 2 {",
      "        return if 外積(p[0], p[1], q) == 0 && 線分上(p[0], p[1]) {",
      "            1",
      "        } else {",
      "            0",
      "        };",
      "    }",
      "    let d1 = 外積(p[0], p[1], q);",
      "    let d2 = 外積(p[0], p[n - 1], q);",
      "    if d1 < 0 || d2 > 0 {",
      "        return 0;",
      "    }",
      "    let mut lo = 1usize;",
      "    let mut hi = n - 1;",
      "    while hi - lo > 1 {",
      "        let mid = (lo + hi) / 2;",
      "        if 外積(p[0], p[mid], q) >= 0 {",
      "            lo = mid;",
      "        } else {",
      "            hi = mid;",
      "        }",
      "    }",
      "    let c = 外積(p[lo], p[hi], q);",
      "    if c < 0 {",
      "        return 0;",
      "    }",
      "    if c == 0 {",
      "        return if 線分上(p[lo], p[hi]) { 1 } else { 0 };",
      "    }",
      "    if d1 == 0 {",
      "        return if 線分上(p[0], p[1]) { 1 } else { 0 };",
      "    }",
      "    if d2 == 0 {",
      "        return if 線分上(p[0], p[n - 1]) { 1 } else { 0 };",
      "    }",
      "    2",
      "}"
    ]
  },
  "凸_多角形_切断": {
    "scope": "rust",
    "prefix": "凸_多角形_切断",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 凸多角形 `多角形`（反時計回り）を有向直線 `a → b` で切り、その**左側**に残る部分を返す。`O(N)`。",
      "/// Sutherland–Hodgman の片側クリップ。左側が空なら空の頂点列を返す。",
      "/// [`half_plane_intersection`](crate::half_plane_intersection) は多数の半平面の共通部分を求める別物。",
      "fn 凸多角形切断(多角形: &[点], a: 点, b: 点) -> Vec<点> {",
      "    let n = 多角形.len();",
      "    let 符号 = |p: 点| (b.0 - a.0) * (p.1 - a.1) - (b.1 - a.1) * (p.0 - a.0);",
      "    let mut 結果 = Vec::with_capacity(n + 1);",
      "    for i in 0..n {",
      "        let c = 多角形[i];",
      "        let d = 多角形[(i + 1) % n];",
      "        let fc = 符号(c);",
      "        let fd = 符号(d);",
      "        if fc >= 0.0 {",
      "            結果.push(c);",
      "        }",
      "        if fc * fd < 0.0 {",
      "            let t = fc / (fc - fd);",
      "            結果.push((c.0 + t * (d.0 - c.0), c.1 + t * (d.1 - c.1)));",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
