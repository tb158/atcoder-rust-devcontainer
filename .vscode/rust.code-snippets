      "fn 個数制限付きナップサック(品物: &[(usize, i64, usize)], 容量: usize) -> i64 {",
      "    use std::collections::VecDeque;",
      "    let mut dp = vec![0i64; 容量 + 1];",
      "    for &(w, v, c) in 品物 {",
      "        if c == 0 {",
      "            continue;",
      "        }",
      "        if w == 0 {",
      "            if v > 0 {",
      "                let 加算 = v * c as i64;",
      "                for x in dp.iter_mut() {",
      "                    *x += 加算;",
      "                }",
      "            }",
      "            continue;",
      "        }",
      "        let 旧 = dp.clone();",
      "        for r in 0..w {",
      "            if r > 容量 {",
      "                break;",
