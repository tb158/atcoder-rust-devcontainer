      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Link-Cut Tree。森に対する辺の追加・削除（[`Self::辺を張る`] / [`Self::辺を切る`]）、",
      "/// 連結判定、2 頂点間パスの頂点値の総和を、すべてならし O(log N) で処理する。",
      "/// 頂点番号は 0-indexed。",
      "/// - [`Self::辺を張る`] : 別の木に属する 2 頂点を結ぶ（同一木の頂点に呼んではならない）。",
      "/// - [`Self::辺を切る`] : 既存の辺を取り除く（隣接していない 2 頂点に呼んではならない）。",
      "/// - [`Self::連結`] : 2 頂点が同じ木か。",
      "/// - [`Self::パス和`] : 2 頂点間パス上の頂点値の総和。",
      "/// - [`Self::値設定`] : 1 頂点の値を更新。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "struct リンクカット木<T> {",
      "    親: Vec<usize>,",
      "    子: Vec<[usize; 2]>,",
      "    値: Vec<T>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "}",
      "impl<T> リンクカット木<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    /// 各頂点の初期値から構築する。",
      "    fn new(初期値: &[T]) -> Self {",
      "        let n = 初期値.len();",
      "        let mut s = Self {",
      "            親: vec![0; n + 1],",
      "            子: vec![[0, 0]; n + 1],",
      "            値: vec![T::default(); n + 1],",
      "            和: vec![T::default(); n + 1],",
      "            反転: vec![false; n + 1],",
      "        };",
      "        for (i, &v) in 初期値.iter().enumerate() {",
      "            s.値[i + 1] = v;",
      "            s.和[i + 1] = v;",
      "        }",
      "        s",
      "    }",
      "    /// `x` がスプレー木の根（パス親へのリンクしか持たない）か。",
      "    fn is_root(&self, x: usize) -> bool {",
      "        let p = self.親[x];",
      "        p == 0 || (self.子[p][0] != x && self.子[p][1] != x)",
      "    }",
      "    fn 更新(&mut self, x: usize) {",
      "        if x == 0 {",
      "            return;",
      "        }",
      "        self.和[x] = self.和[self.子[x][0]] + self.値[x] + self.和[self.子[x][1]];",
      "    }",
      "    fn 伝播(&mut self, x: usize) {",
      "        if x != 0 && self.反転[x] {",
      "            let l = self.子[x][0];",
      "            let r = self.子[x][1];",
      "            self.子[x][0] = r;",
      "            self.子[x][1] = l;",
      "            if l != 0 {",
      "                self.反転[l] ^= true;",
      "            }",
      "            if r != 0 {",
      "                self.反転[r] ^= true;",
      "            }",
      "            self.反転[x] = false;",
      "        }",
      "    }",
      "    fn 回転(&mut self, x: usize) {",
      "        let p = self.親[x];",
      "        let g = self.親[p];",
      "        let pがルート = self.is_root(p);",
      "        let d = if self.子[p][1] == x { 1 } else { 0 };",
      "        let b = self.子[x][d ^ 1];",
      "        self.子[p][d] = b;",
      "        if b != 0 {",
      "            self.親[b] = p;",
      "        }",
      "        self.子[x][d ^ 1] = p;",
      "        self.親[p] = x;",
      "        self.親[x] = g;",
      "        if !pがルート {",
      "            if self.子[g][0] == p {",
      "                self.子[g][0] = x;",
      "            } else if self.子[g][1] == p {",
      "                self.子[g][1] = x;",
      "            }",
      "        }",
      "        self.更新(p);",
      "        self.更新(x);",
      "    }",
      "    fn splay(&mut self, x: usize) {",
      "        let mut スタック = vec![x];",
      "        let mut y = x;",
      "        while !self.is_root(y) {",
      "            y = self.親[y];",
      "            スタック.push(y);",
      "        }",
      "        while let Some(v) = スタック.pop() {",
      "            self.伝播(v);",
      "        }",
      "        while !self.is_root(x) {",
      "            let p = self.親[x];",
      "            if self.is_root(p) {",
      "                self.回転(x);",
      "            } else {",
      "                let g = self.親[p];",
      "                let 同方向 = (self.子[g][1] == p) == (self.子[p][1] == x);",
      "                if 同方向 {",
      "                    self.回転(p);",
      "                } else {",
      "                    self.回転(x);",
      "                }",
      "                self.回転(x);",
      "            }",
      "        }",
      "    }",
      "    fn access(&mut self, x: usize) -> usize {",
      "        let mut last = 0;",
      "        let mut cur = x;",
      "        while cur != 0 {",
      "            self.splay(cur);",
      "            self.子[cur][1] = last;",
      "            self.更新(cur);",
      "            last = cur;",
      "            cur = self.親[cur];",
      "        }",
      "        self.splay(x);",
      "        last",
      "    }",
      "    fn make_root(&mut self, x: usize) {",
      "        self.access(x);",
      "        self.反転[x] ^= true;",
      "        self.伝播(x);",
      "    }",
      "    fn find_root(&mut self, x: usize) -> usize {",
      "        self.access(x);",
      "        let mut r = x;",
      "        self.伝播(r);",
      "        while self.子[r][0] != 0 {",
      "            r = self.子[r][0];",
      "            self.伝播(r);",
      "        }",
      "        self.splay(r);",
      "        r",
      "    }",
      "    /// 別の木に属する頂点 `u`・`v` を結ぶ辺を張る。同じ木の 2 頂点に呼んではならない。",
      "    fn 辺を張る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.親[a] = b;",
      "    }",
      "    /// 既存の辺 `u - v` を取り除く。隣接していない 2 頂点に呼んではならない。",
      "    fn 辺を切る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.子[b][0] = 0;",
      "        self.親[a] = 0;",
      "        self.更新(b);",
      "    }",
      "    /// 頂点 `u`・`v` が同じ木に属するか。",
      "    fn 連結(&mut self, u: usize, v: usize) -> bool {",
      "        if u == v {",
      "            return true;",
      "        }",
      "        self.find_root(u + 1) == self.find_root(v + 1)",
      "    }",
      "    /// 任意頂点 `u` をその木の根にする。",
      "    fn 根を変更(&mut self, u: usize) {",
      "        self.make_root(u + 1);",
      "    }",
      "    /// 頂点 `u`・`v` 間のパス上にある頂点値の総和。同じ木に属することが前提。",
      "    fn パス和(&mut self, u: usize, v: usize) -> T {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.和[b]",
      "    }",
      "    /// 頂点 `u` の値を `新値` に設定する。",
      "    fn 値設定(&mut self, u: usize, 新値: T) {",
      "        let a = u + 1;",
      "        self.access(a);",
      "        self.値[a] = 新値;",
      "        self.更新(a);",
      "    }",
      "    /// 頂点 `u` の現在の値。",
      "    fn 頂点値(&self, u: usize) -> T {",
      "        self.値[u + 1]",
      "    }",
      "}"
    ]
  },
  "動的_連結性": {
    "scope": "rust",
    "prefix": "動的_連結性",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// オフライン動的連結性で使う巻き戻し（Undo）可能 Union-Find。経路圧縮せずユニオン by サイズで結合し、",
      "/// 各結合をスタックに積んで任意時点へ復元する。`連結成分数` も追跡する。",
      "struct 巻き戻しDSU {",
      "    親orサイズ: Vec<i64>,",
      "    履歴: Vec<(usize, i64)>,",
      "    成分数: usize,",
      "}",
      "impl 巻き戻しDSU {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親orサイズ: vec![-1; n],",
      "            履歴: Vec::new(),",
      "            成分数: n,",
      "        }",
      "    }",
      "    /// `x` の根（経路圧縮なし）。",
      "    fn 根(&self, mut x: usize) -> usize {",
      "        while self.親orサイズ[x] >= 0 {",
      "            x = self.親orサイズ[x] as usize;",
      "        }",
      "        x",
      "    }",
      "    /// `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "    /// `x` の属する集合の要素数。",
      "    fn サイズ(&self, x: usize) -> usize {",
      "        let r = self.根(x);",
      "        (-self.親orサイズ[r]) as usize",
      "    }",
      "    /// 現在の連結成分数。",
      "    fn 連結成分数(&self) -> usize {",
      "        self.成分数",
      "    }",
      "    /// `x` と `y` を結合する。既に同じ集合なら `false`。",
      "    fn 統合(&mut self, x: usize, y: usize) -> bool {",
      "        let mut a = self.根(x);",
      "        let mut b = self.根(y);",
      "        if a == b {",
      "            return false;",
      "        }",
      "        if self.親orサイズ[a] > self.親orサイズ[b] {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        self.履歴.push((a, self.親orサイズ[a]));",
      "        self.履歴.push((b, self.親orサイズ[b]));",
      "        self.親orサイズ[a] += self.親orサイズ[b];",
      "        self.親orサイズ[b] = a as i64;",
      "        self.成分数 -= 1;",
      "        true",
      "    }",
      "    /// 現在のスナップショット（履歴長）。",
      "    fn 現在時点(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    /// `時点` まで状態を巻き戻す（履歴は 1 結合につき 2 件）。成分数も復元する。",
      "    fn ロールバック(&mut self, 時点: usize) {",
      "        let 結合数 = (self.履歴.len() - 時点) / 2;",
      "        while self.履歴.len() > 時点 {",
      "            let (i, v) = self.履歴.pop().unwrap();",
      "            self.親orサイズ[i] = v;",
      "        }",
      "        self.成分数 += 結合数;",
      "    }",
      "}",
      "/// オフライン動的連結性。辺の追加・削除がある時系列（時刻 `0..T`）に対し、各時刻での連結性を一括で求める。",
      "/// 「各辺が存在する時刻区間 `[開始, 終了)`」を時間方向のセグメント木に載せて分割統治する。",
      "/// 全体 `O((辺 + T) log T α)`。クエリを先読みできる（オフライン）ことが前提。",
      "/// - [`Self::辺追加`] : 辺 `(u, v)` が存在する時刻区間を登録。",
      "/// - [`Self::解く`] : 各時刻 `t` でコールバックに DSU を渡す。",
      "struct オフライン動的連結性 {",
      "    時刻数: usize,",
      "    頂点数: usize,",
      "    辺: Vec<Vec<(usize, usize)>>,",
      "}",
      "impl オフライン動的連結性 {",
      "    /// 頂点数 `頂点数`、時刻数 `時刻数`（時刻は `0..時刻数`）で初期化する。",
      "    fn new(頂点数: usize, 時刻数: usize) -> Self {",
      "        Self {",
      "            時刻数,",
      "            頂点数,",
      "            辺: vec![Vec::new(); 4 * 時刻数.max(1)],",
      "        }",
      "    }",
      "    /// 辺 `(u, v)` が時刻区間 `[開始, 終了)` に存在することを登録する。",
      "    fn 辺追加(&mut self, u: usize, v: usize, 開始: usize, 終了: usize) {",
      "        if 開始 < 終了 {",
      "            self.区間に追加(1, 0, self.時刻数, 開始, 終了, (u, v));",
      "        }",
      "    }",
      "    fn 区間に追加(",
      "        &mut self,",
      "        節点: usize,",
      "        nl: usize,",
      "        nr: usize,",
      "        l: usize,",
      "        r: usize,",
      "        辺: (usize, usize),",
      "    ) {",
      "        if r <= nl || nr <= l {",
      "            return;",
      "        }",
      "        if l <= nl && nr <= r {",
      "            self.辺[節点].push(辺);",
      "            return;",
      "        }",
      "        let 中 = (nl + nr) / 2;",
      "        self.区間に追加(2 * 節点, nl, 中, l, r, 辺);",
      "        self.区間に追加(2 * 節点 + 1, 中, nr, l, r, 辺);",
      "    }",
      "    /// セグメント木を DFS し、各時刻 `t`（`0..時刻数`）でその時点の DSU をコールバックに渡す。",
      "    fn 解く<F: FnMut(usize, &巻き戻しDSU)>(&self, mut 処理: F) {",
      "        if self.時刻数 == 0 {",
      "            return;",
      "        }",
      "        let mut dsu = 巻き戻しDSU::new(self.頂点数);",
      "        self.探索(1, 0, self.時刻数, &mut dsu, &mut 処理);",
      "    }",
      "    fn 探索<F: FnMut(usize, &巻き戻しDSU)>(",
      "        &self,",
      "        節点: usize,",
      "        nl: usize,",
      "        nr: usize,",
      "        dsu: &mut 巻き戻しDSU,",
      "        処理: &mut F,",
      "    ) {",
      "        let スナップ = dsu.現在時点();",
      "        for &(u, v) in &self.辺[節点] {",
      "            dsu.統合(u, v);",
      "        }",
      "        if nr - nl == 1 {",
      "            処理(nl, dsu);",
      "        } else {",
      "            let 中 = (nl + nr) / 2;",
      "            self.探索(2 * 節点, nl, 中, dsu, 処理);",
      "            self.探索(2 * 節点 + 1, 中, nr, dsu, 処理);",
      "        }",
      "        dsu.ロールバック(スナップ);",
      "    }",
      "}"
    ]
  },
  "区間_DP_最適化": {
    "scope": "rust",
    "prefix": "区間_DP_最適化",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// クヌース（Knuth–Yao）最適化。区間 DP `dp[i][j] = 区間コスト(i, j) + min_{i<=k<j} (dp[i][k] + dp[k+1][j])`",
      "/// を、最適分割点の単調性 `opt[i][j-1] <= opt[i][j] <= opt[i+1][j]` を用いて `O(n^2)` で解く。",
      "/// `区間コスト(i, j)` が四角不等式（QI）と区間単調性を満たすとき正しい（石の合体・最適二分探索木など、",
      "/// 区間長に関する凸なコスト）。素朴な区間 DP は `O(n^3)`。`n` 要素を 1 つに併合する総コストを返す。",
      "/// [`crate::divide_and_conquer_dp`]（層状の遷移）とは別物。",
      "fn クヌース最適化<F: Fn(usize, usize) -> i64>(n: usize, 区間コスト: F) -> i64 {",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let mut dp = vec![vec![0i64; n]; n];",
      "    let mut opt = vec![vec![0usize; n]; n];",
      "    for (i, 行) in opt.iter_mut().enumerate() {",
      "        行[i] = i;",
      "    }",
      "    for 長 in 1..n {",
      "        for i in 0..n - 長 {",
      "            let j = i + 長;",
      "            let 下 = opt[i][j - 1];",
      "            let 上 = opt[i + 1][j].min(j - 1);",
      "            let mut 最良 = i64::MAX;",
      "            let mut 最良k = 下;",
      "            for k in 下..=上 {",
      "                let v = dp[i][k] + dp[k + 1][j];",
      "                if v < 最良 {",
      "                    最良 = v;",
      "                    最良k = k;",
      "                }",
      "            }",
      "            dp[i][j] = 最良 + 区間コスト(i, j);",
      "            opt[i][j] = 最良k;",
      "        }",
      "    }",
      "    dp[0][n - 1]",
      "}"
    ]
  },
  "区間_chmax": {
    "scope": "rust",
    "prefix": "区間_chmax",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Segment Tree Beats の 1 ノード。最大側（最大値・厳密な 2 番目・最大値の個数）と",
      "/// 最小側（最小値・厳密な 2 番目・最小値の個数）、区間和、要素数を持つ。",
      "#[derive(Clone)]",
      "struct 節点 {",
      "    最大1: i64,",
      "    最大2: i64,",
      "    最大個数: i64,",
      "    最小1: i64,",
      "    最小2: i64,",
      "    最小個数: i64,",
      "    和: i64,",
      "    要素数: i64,",
      "}",
      "const 無限大: i64 = 1 << 60;",
      "impl 節点 {",
      "    fn 葉(v: i64) -> Self {",
      "        Self {",
      "            最大1: v,",
      "            最大2: -無限大,",
      "            最大個数: 1,",
      "            最小1: v,",
      "            最小2: 無限大,",
      "            最小個数: 1,",
      "            和: v,",
      "            要素数: 1,",
      "        }",
      "    }",
      "    fn 空() -> Self {",
      "        Self {",
      "            最大1: -無限大,",
      "            最大2: -無限大,",
      "            最大個数: 0,",
      "            最小1: 無限大,",
      "            最小2: 無限大,",
      "            最小個数: 0,",
      "            和: 0,",
      "            要素数: 0,",
      "        }",
      "    }",
      "}",
      "/// 2 つの子ノードを統合する。",
      "fn 合成(l: &節点, r: &節点) -> 節点 {",
      "    let mut p = 節点::空();",
      "    p.和 = l.和 + r.和;",
      "    p.要素数 = l.要素数 + r.要素数;",
      "    if l.最大1 == r.最大1 {",
      "        p.最大1 = l.最大1;",
      "        p.最大個数 = l.最大個数 + r.最大個数;",
      "        p.最大2 = l.最大2.max(r.最大2);",
      "    } else if l.最大1 > r.最大1 {",
      "        p.最大1 = l.最大1;",
      "        p.最大個数 = l.最大個数;",
      "        p.最大2 = l.最大2.max(r.最大1);",
      "    } else {",
      "        p.最大1 = r.最大1;",
      "        p.最大個数 = r.最大個数;",
      "        p.最大2 = r.最大2.max(l.最大1);",
      "    }",
      "    if l.最小1 == r.最小1 {",
      "        p.最小1 = l.最小1;",
      "        p.最小個数 = l.最小個数 + r.最小個数;",
      "        p.最小2 = l.最小2.min(r.最小2);",
      "    } else if l.最小1 < r.最小1 {",
      "        p.最小1 = l.最小1;",
      "        p.最小個数 = l.最小個数;",
      "        p.最小2 = l.最小2.min(r.最小1);",
      "    } else {",
