  "RollbackMo": {
    "scope": "rust",
    "prefix": "RollbackMo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 「追加は容易だが削除が難しい」区間クエリを扱うロールバック Mo の状態インタフェース。",
      "/// 削除の代わりに、チェックポイント [`保存`](ロールバックMo::保存) と",
      "/// [`巻き戻し`](ロールバックMo::巻き戻し) で状態を巻き戻す。区間の左側の一時追加を",
      "/// 巻き戻すことで、各左ブロック内で右ポインタを単調増加に保ったまま処理できる。",
      "/// 素の [`Mo`](crate::mo)・[更新あり Mo](crate::mo_with_updates) とは別アルゴリズム。",
      "/// 連結性（rollback 可能 union-find）や max・mode 系で使う。",
      "trait ロールバックMo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 位置 `位置` の要素を現在の集合に加える（削除は無い）。",
      "    fn 追加(&mut self, 位置: usize);",
      "    /// 現在の状態をチェックポイントとして積む。",
      "    fn 保存(&mut self);",
      "    /// 直近のチェックポイントまで状態を巻き戻す（その時点以降の追加を取り消す）。",
      "    fn 巻き戻し(&mut self);",
      "    /// 状態を空に戻す（各左ブロックの処理開始時に呼ばれる）。",
      "    fn 全消去(&mut self);",
      "    /// 現在の集合に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// ロールバック Mo 本体。`n` は要素数、`クエリ` は半開区間 `[l, r)`（`l < r`）の列。",
      "/// 全体 `O((N + Q)√N · 追加コスト)`。`状態` は空の初期状態で渡すこと。",
      "fn ロールバックmo実行<S: ロールバックMo>(",
      "    状態: &mut S,",
      "    n: usize,",
      "    クエリ: &[(usize, usize)],",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    if q == 0 {",
      "        return Vec::new();",
      "    }",
      "    let b = ((n as f64).sqrt() as usize).max(1);",
      "    let mut 順: Vec<usize> = (0..q).collect();",
      "    順.sort_by(|&x, &y| {",
      "        let (lx, rx) = クエリ[x];",
      "        let (ly, ry) = クエリ[y];",
      "        let (bx, by) = (lx / b, ly / b);",
      "        if bx != by {",
      "            bx.cmp(&by)",
      "        } else {",
      "            rx.cmp(&ry)",
      "        }",
      "    });",
      "    let mut 答え: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let mut idx = 0;",
      "    while idx < 順.len() {",
      "        let ブロック = クエリ[順[idx]].0 / b;",
      "        let r0 = ((ブロック + 1) * b).min(n);",
      "        状態.全消去();",
      "        let mut 右 = r0;",
      "        while idx < 順.len() && クエリ[順[idx]].0 / b == ブロック {",
      "            let i = 順[idx];",
      "            let (l, r) = クエリ[i];",
      "            if r <= r0 {",
      "                状態.保存();",
      "                for p in l..r {",
      "                    状態.追加(p);",
      "                }",
      "                答え[i] = Some(状態.答え());",
      "                状態.巻き戻し();",
      "                idx += 1;",
      "                continue;",
      "            }",
      "            while 右 < r {",
      "                状態.追加(右);",
      "                右 += 1;",
      "            }",
      "            状態.保存();",
      "            for p in (l..r0).rev() {",
      "                状態.追加(p);",
      "            }",
      "            答え[i] = Some(状態.答え());",
      "            状態.巻き戻し();",
      "            idx += 1;",
      "        }",
      "    }",
      "    答え.into_iter().map(|o| o.unwrap()).collect()",
      "}"
    ]
  },
  "RollbackUnionFind": {
    "scope": "rust",
    "prefix": "RollbackUnionFind",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巻き戻し（Undo）可能な Union-Find。経路圧縮を行わずユニオン by サイズのみで結合し、",
      "/// 各結合の変更を履歴に積むことで任意時点へ `O(操作数)` で復元できる。",
      "/// `ac_library::Dsu` は経路圧縮するため undo できない。オフライン動的連結性",
      "/// （時間方向のセグメント木上の分割統治）などで「結合 → 探索 → 巻き戻し」を繰り返す用途に使う。",
      "/// `根`・`同じ`・`サイズ` は経路圧縮なしの O(log N)。",
      "struct ロールバック可能UnionFind {",
      "    /// 根なら `-(サイズ)`、非根なら親の添字。",
      "    親orサイズ: Vec<i64>,",
      "    /// `(書き換えた添字, 直前の値)` の履歴。1 回の結合で 2 件積む。",
      "    履歴: Vec<(usize, i64)>,",
      "}",
      "impl ロールバック可能UnionFind {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親orサイズ: vec![-1; n],",
      "            履歴: Vec::new(),",
      "        }",
      "    }",
      "    /// `x` の根（経路圧縮なし）。",
      "    fn 根(&self, mut x: usize) -> usize {",
      "        while self.親orサイズ[x] >= 0 {",
      "            x = self.親orサイズ[x] as usize;",
      "        }",
      "        x",
      "    }",
      "    /// `x` と `y` を結合する。既に同じ集合なら `false`（履歴は積まない）。",
      "    fn 統合(&mut self, x: usize, y: usize) -> bool {",
      "        let mut a = self.根(x);",
      "        let mut b = self.根(y);",
      "        if a == b {",
      "            return false;",
      "        }",
      "        if self.親orサイズ[a] > self.親orサイズ[b] {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        self.履歴.push((a, self.親orサイズ[a]));",
      "        self.履歴.push((b, self.親orサイズ[b]));",
      "        self.親orサイズ[a] += self.親orサイズ[b];",
      "        self.親orサイズ[b] = a as i64;",
      "        true",
      "    }",
      "    /// `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "    /// `x` の属する集合の要素数。",
      "    fn サイズ(&self, x: usize) -> usize {",
      "        let r = self.根(x);",
      "        (-self.親orサイズ[r]) as usize",
      "    }",
      "    /// 現在のスナップショット（履歴の長さ）。[`Self::ロールバック`] に渡す。",
      "    fn 現在時点(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    /// 直近の `統合` 1 回ぶんを取り消す（履歴 2 件を巻き戻す）。",
      "    fn 巻き戻し(&mut self) {",
      "        for _ in 0..2 {",
      "            if let Some((i, v)) = self.履歴.pop() {",
      "                self.親orサイズ[i] = v;",
      "            }",
      "        }",
      "    }",
      "    /// [`Self::現在時点`] で得た時点まで状態を巻き戻す。",
      "    fn ロールバック(&mut self, 時点: usize) {",
      "        while self.履歴.len() > 時点 {",
      "            let (i, v) = self.履歴.pop().unwrap();",
      "            self.親orサイズ[i] = v;",
      "        }",
      "    }",
      "}"
    ]
  },
  "RotatingCalipers": {
    "scope": "rust",
    "prefix": "RotatingCalipers",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗を `i128` で返す。",
      "/// 平方根を取らないので誤差なしで距離を比較できる。差を取ってから `i128` に広げるため、",
      "/// 座標が `±10^18` でも桁あふれしない。実距離が要るときは `(d as f64).sqrt()`。",
      "fn 距離2乗(a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let dx = (a.0 - b.0) as i128;",
      "    let dy = (a.1 - b.1) as i128;",
      "    dx * dx + dy * dy",
      "}",
      "/// 凸包（Andrew's monotone chain）。与えた点集合をすべて含む最小の凸多角形の",
      "/// 頂点を、反時計回りの順で返す。O(N log N)。",
      "/// 一直線上に並ぶ中間点（凸包の辺上の点）は頂点に含めない。",
      "/// 点が2個以下のときは重複を除いた入力をそのまま返す。",
      "fn 凸包(点群: &[(i64, i64)]) -> Vec<(i64, i64)> {",
      "    let mut 点 = 点群.to_vec();",
      "    点.sort();",
      "    点.dedup();",
      "    let n = 点.len();",
      "    if n <= 2 {",
      "        return 点;",
      "    }",
      "    let mut 下側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in &点 {",
      "        while 下側.len() >= 2 && 外積3点(下側[下側.len() - 2], 下側[下側.len() - 1], p) <= 0",
      "        {",
      "            下側.pop();",
      "        }",
      "        下側.push(p);",
      "    }",
      "    let mut 上側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in 点.iter().rev() {",
      "        while 上側.len() >= 2 && 外積3点(上側[上側.len() - 2], 上側[上側.len() - 1], p) <= 0",
      "        {",
      "            上側.pop();",
      "        }",
      "        上側.push(p);",
      "    }",
      "    下側.pop();",
      "    上側.pop();",
      "    下側.extend(上側);",
      "    下側",
      "}",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "/// 点群の最遠点対の距離の 2 乗を回転キャリパスで求める。凸包構築 O(N log N) ＋ 走査 O(N)。",
      "/// 点が 1 個以下なら 0。",
      "fn 最遠点対の距離2乗(点群: &[(i64, i64)]) -> i128 {",
      "    let 包 = 凸包(点群);",
      "    let m = 包.len();",
      "    if m <= 1 {",
      "        return 0;",
      "    }",
      "    if m == 2 {",
      "        return 距離2乗(包[0], 包[1]);",
      "    }",
      "    let mut 最良 = 0i128;",
      "    let mut j = 1usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for i in 0..m {",
      "        let ni = (i + 1) % m;",
      "        while 外積3点(包[i], 包[ni], 包[(j + 1) % m]) > 外積3点(包[i], 包[ni], 包[j]) {",
      "            j = (j + 1) % m;",
      "        }",
      "        最良 = 最良.max(距離2乗(包[i], 包[j])).max(距離2乗(包[ni], 包[j]));",
      "    }",
      "    最良",
      "}"
    ]
  },
  "SAM": {
    "scope": "rust",
    "prefix": "SAM",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 接尾辞オートマトンの 1 状態。`len` は同値類の最長文字列長、`link` は suffix link",
      "/// （根は -1）、`next` は文字ごとの遷移先。",
      "struct 状態 {",
      "    len: usize,",
      "    link: i64,",
      "    next: HashMap<u8, usize>,",
      "}",
      "/// 接尾辞オートマトン（SAM）。文字列の全部分文字列を O(N) 状態で表す。構築 O(N)。",
      "/// - [`Self::相異なる部分文字列数`] : 相異なる（空でない）部分文字列の個数。",
      "/// - [`Self::含む`] : ある文字列が部分文字列として現れるか。",
      "struct 接尾辞オートマトン {",
      "    states: Vec<状態>,",
      "    last: usize,",
      "}",
      "impl 接尾辞オートマトン {",
      "    fn new() -> Self {",
      "        Self {",
      "            states: vec![状態 {",
      "                len: 0,",
      "                link: -1,",
      "                next: HashMap::new(),",
      "            }],",
      "            last: 0,",
      "        }",
      "    }",
      "    /// バイト列から構築する。",
      "    fn 構築(s: &[u8]) -> Self {",
      "        let mut sam = Self::new();",
      "        for &c in s {",
      "            sam.追加(c);",
      "        }",
      "        sam",
      "    }",
      "    /// 末尾に 1 文字追加する（オンライン構築）。",
      "    fn 追加(&mut self, c: u8) {",
      "        let cur = self.states.len();",
      "        self.states.push(状態 {",
      "            len: self.states[self.last].len + 1,",
      "            link: -1,",
      "            next: HashMap::new(),",
      "        });",
      "        let mut p = self.last as i64;",
      "        while p != -1 && !self.states[p as usize].next.contains_key(&c) {",
      "            self.states[p as usize].next.insert(c, cur);",
      "            p = self.states[p as usize].link;",
      "        }",
      "        if p == -1 {",
      "            self.states[cur].link = 0;",
      "        } else {",
      "            let q = self.states[p as usize].next[&c];",
      "            if self.states[p as usize].len + 1 == self.states[q].len {",
      "                self.states[cur].link = q as i64;",
      "            } else {",
      "                let clone = self.states.len();",
      "                self.states.push(状態 {",
      "                    len: self.states[p as usize].len + 1,",
      "                    link: self.states[q].link,",
      "                    next: self.states[q].next.clone(),",
      "                });",
      "                while p != -1 && self.states[p as usize].next.get(&c) == Some(&q) {",
      "                    self.states[p as usize].next.insert(c, clone);",
      "                    p = self.states[p as usize].link;",
      "                }",
      "                self.states[q].link = clone as i64;",
      "                self.states[cur].link = clone as i64;",
      "            }",
      "        }",
      "        self.last = cur;",
      "    }",
      "    /// 相異なる（空でない）部分文字列の個数。O(状態数)。",
      "    fn 相異なる部分文字列数(&self) -> usize {",
      "        let mut 合計 = 0usize;",
      "        for v in 1..self.states.len() {",
      "            let link = self.states[v].link;",
      "            let 親len = if link < 0 {",
      "                0",
      "            } else {",
      "                self.states[link as usize].len",
      "            };",
      "            合計 += self.states[v].len - 親len;",
      "        }",
      "        合計",
      "    }",
      "    /// `t` が部分文字列として現れるか。O(|t|)。",
      "    fn 含む(&self, t: &[u8]) -> bool {",
      "        let mut v = 0usize;",
      "        for &c in t {",
      "            match self.states[v].next.get(&c) {",
      "                Some(&nx) => v = nx,",
      "                None => return false,",
      "            }",
      "        }",
      "        true",
      "    }",
      "}",
      "impl Default for 接尾辞オートマトン {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "SMAWK": {
    "scope": "rust",
    "prefix": "SMAWK",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// REDUCE 操作: どの行の最小にもなり得ない列を取り除き、残す列数を行数以下にする内部関数。",
      "fn 列削減<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行: &[usize],",
      "    列: &[usize],",
      "    コスト: &F,",
      ") -> Vec<usize> {",
      "    let mut 残す: Vec<usize> = Vec::new();",
      "    for &c in 列 {",
      "        while let Some(&上) = 残す.last() {",
      "            let k = 残す.len() - 1;",
      "            if k < 行.len() && コスト(行[k], 上) > コスト(行[k], c) {",
      "                残す.pop();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        if 残す.len() < 行.len() {",
      "            残す.push(c);",
      "        }",
      "    }",
      "    残す",
      "}",
      "/// SMAWK 本体（再帰）。偶数位置の行は奇数位置の行の答えで挟み込んで線形に解く。",
      "fn 解く<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行: &[usize],",
      "    列: &[usize],",
      "    コスト: &F,",
      "    答え: &mut [usize],",
      ") {",
      "    if 行.is_empty() {",
      "        return;",
      "    }",
      "    let 列 = 列削減(行, 列, コスト);",
      "    let 奇: Vec<usize> = 行.iter().skip(1).step_by(2).copied().collect();",
      "    解く(&奇, &列, コスト, 答え);",
      "    let mut j = 0;",
      "    let mut pos = 0;",
      "    while pos < 行.len() {",
      "        let r = 行[pos];",
      "        let 終列 = if pos + 1 < 行.len() {",
      "            答え[行[pos + 1]]",
      "        } else {",
      "            *列.last().unwrap()",
      "        };",
      "        let mut 最良 = 列[j];",
      "        while 列[j] != 終列 {",
      "            j += 1;",
      "            if コスト(r, 列[j]) < コスト(r, 最良) {",
      "                最良 = 列[j];",
      "            }",
      "        }",
      "        答え[r] = 最良;",
      "        pos += 2;",
      "    }",
      "}",
      "/// SMAWK 法。完全単調（totally monotone, Monge を含む）な `行数 × 列数` 行列について、",
      "/// 各行の最小値をとる列番号を `O(行数 + 列数)` で求める。`コスト(i, j)` で要素を遅延参照する。",
      "/// 行列が完全単調（任意の `i<i'`, `j<j'` で `A[i][j]>A[i][j']` ⇒ `A[i'][j]>A[i'][j']`）であることが前提。",
      "/// 分割統治の単調最小値（[`divide_and_conquer_dp`](crate::divide_and_conquer_dp)、`O(n log n)`）より",
      "/// 高速。最近点・DP 高速化などで使う。",
      "/// 返り値 `argmin[i]` は行 `i` の最小値をとる列（同点は最左）。`列数 == 0` のときは空でない行に `0` が入る。",
      "/// コストの型は比較できれば何でもよい（i64 / f64 など）。",
      "fn 行ごとの最小列<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行数: usize,",
      "    列数: usize,",
      "    コスト: F,",
      ") -> Vec<usize> {",
      "    let mut 答え = vec![0usize; 行数];",
      "    if 行数 == 0 || 列数 == 0 {",
      "        return 答え;",
      "    }",
      "    let 行: Vec<usize> = (0..行数).collect();",
      "    let 列: Vec<usize> = (0..列数).collect();",
      "    解く(&行, &列, &コスト, &mut 答え);",
      "    答え",
      "}"
    ]
  },
  "SOSDP": {
    "scope": "rust",
    "prefix": "SOSDP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 下位集合に対する高速ゼータ変換（SOS DP, sum over subsets）。",
      "/// `f[S]` を `g[S] = Σ_{T ⊆ S} f[T]` へ in-place に書き換える。O(N · 2^N)。",
      "/// `f.len()` は 2 のべき乗（= 2^N）であること。逆変換は [`下位集合メビウス変換`]。",
      "/// 要素型は加算できれば何でもよい（i64 / usize / f64 / ModInt など）。",
      "fn 下位集合ゼータ変換<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    let mut bit = 1;",
      "    while bit < n {",
      "        for s in 0..n {",
      "            if s & bit != 0 {",
      "                f[s] += f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}",
      "/// 上位集合に対する高速ゼータ変換。`f[S]` を `g[S] = Σ_{T ⊇ S} f[T]` へ in-place に書き換える。",
      "/// O(N · 2^N)。逆変換は [`上位集合メビウス変換`]。要素型は加算できれば何でもよい。",
      "fn 上位集合ゼータ変換<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    let mut bit = 1;",
      "    while bit < n {",
      "        for s in 0..n {",
      "            if s & bit == 0 {",
      "                f[s] += f[s | bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}"
    ]
  },
  "SegmentIntersection": {
    "scope": "rust",
    "prefix": "SegmentIntersection",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "type 点 = (i64, i64);",
      "/// 点 `p` が線分 `[a, b]`（端点を含む）の上にあるかを整数演算で厳密に判定する。",
      "/// `a == b`（点）にも対応。",
      "fn 点は線分上(p: 点, a: 点, b: 点) -> bool {",
      "    外積3点(a, b, p) == 0",
      "        && p.0 >= a.0.min(b.0)",
      "        && p.0 <= a.0.max(b.0)",
      "        && p.1 >= a.1.min(b.1)",
      "        && p.1 <= a.1.max(b.1)",
      "}",
      "/// 線分 `[a, b]` と `[c, d]` が交わる（端点接触・共線重なりを含む）かを整数演算で厳密に判定する。`O(1)`。",
      "/// 退化した線分（点）にも正しく対応。",
      "fn 線分交差(a: 点, b: 点, c: 点, d: 点) -> bool {",
      "    let d1 = 外積3点(c, d, a).signum();",
      "    let d2 = 外積3点(c, d, b).signum();",
      "    let d3 = 外積3点(a, b, c).signum();",
      "    let d4 = 外積3点(a, b, d).signum();",
      "    if d1 != d2 && d3 != d4 {",
      "        return true;",
      "    }",
      "    点は線分上(a, c, d) || 点は線分上(b, c, d) || 点は線分上(c, a, b) || 点は線分上(d, a, b)",
      "}",
      "/// 2 直線（`a` と `b` を通る直線、`c` と `d` を通る直線）の交点を `f64` で返す。平行なら `None`。",
      "/// 線分ではなく直線として扱う。厳密な交差「有無」は [`線分交差`]、座標が必要なときに本関数。",
      "fn 直線交点(a: 点, b: 点, c: 点, d: 点) -> Option<(f64, f64)> {",
      "    let r = (b.0 - a.0, b.1 - a.1);",
      "    let s = (d.0 - c.0, d.1 - c.1);",
      "    let rxs = r.0 as i128 * s.1 as i128 - r.1 as i128 * s.0 as i128;",
      "    if rxs == 0 {",
      "        return None;",
      "    }",
      "    let qp = (c.0 - a.0, c.1 - a.1);",
      "    let t = (qp.0 as f64 * s.1 as f64 - qp.1 as f64 * s.0 as f64) / rxs as f64;",
      "    Some((a.0 as f64 + t * r.0 as f64, a.1 as f64 + t * r.1 as f64))",
      "}"
    ]
  },
  "SegmentTreeBeats": {
    "scope": "rust",
    "prefix": "SegmentTreeBeats",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Segment Tree Beats の 1 ノード。最大側（最大値・厳密な 2 番目・最大値の個数）と",
      "/// 最小側（最小値・厳密な 2 番目・最小値の個数）、区間和、要素数を持つ。",
      "#[derive(Clone)]",
      "struct 節点 {",
      "    最大1: i64,",
      "    最大2: i64,",
      "    最大個数: i64,",
      "    最小1: i64,",
      "    最小2: i64,",
      "    最小個数: i64,",
      "    和: i64,",
      "    要素数: i64,",
      "}",
      "const 無限大: i64 = 1 << 60;",
      "impl 節点 {",
      "    fn 葉(v: i64) -> Self {",
      "        Self {",
      "            最大1: v,",
      "            最大2: -無限大,",
      "            最大個数: 1,",
      "            最小1: v,",
      "            最小2: 無限大,",
      "            最小個数: 1,",
      "            和: v,",
      "            要素数: 1,",
      "        }",
      "    }",
      "    fn 空() -> Self {",
      "        Self {",
      "            最大1: -無限大,",
      "            最大2: -無限大,",
      "            最大個数: 0,",
      "            最小1: 無限大,",
      "            最小2: 無限大,",
      "            最小個数: 0,",
      "            和: 0,",
      "            要素数: 0,",
      "        }",
      "    }",
      "}",
      "/// 2 つの子ノードを統合する。",
      "fn 合成(l: &節点, r: &節点) -> 節点 {",
      "    let mut p = 節点::空();",
      "    p.和 = l.和 + r.和;",
      "    p.要素数 = l.要素数 + r.要素数;",
      "    if l.最大1 == r.最大1 {",
      "        p.最大1 = l.最大1;",
      "        p.最大個数 = l.最大個数 + r.最大個数;",
      "        p.最大2 = l.最大2.max(r.最大2);",
      "    } else if l.最大1 > r.最大1 {",
      "        p.最大1 = l.最大1;",
      "        p.最大個数 = l.最大個数;",
      "        p.最大2 = l.最大2.max(r.最大1);",
      "    } else {",
      "        p.最大1 = r.最大1;",
      "        p.最大個数 = r.最大個数;",
      "        p.最大2 = r.最大2.max(l.最大1);",
      "    }",
      "    if l.最小1 == r.最小1 {",
      "        p.最小1 = l.最小1;",
      "        p.最小個数 = l.最小個数 + r.最小個数;",
      "        p.最小2 = l.最小2.min(r.最小2);",
      "    } else if l.最小1 < r.最小1 {",
      "        p.最小1 = l.最小1;",
      "        p.最小個数 = l.最小個数;",
      "        p.最小2 = l.最小2.min(r.最小1);",
      "    } else {",
      "        p.最小1 = r.最小1;",
      "        p.最小個数 = r.最小個数;",
      "        p.最小2 = r.最小2.min(l.最小1);",
      "    }",
      "    p",
      "}",
      "/// Segment Tree Beats。区間 chmin（`a[i] = min(a[i], x)`）・区間 chmax・区間和・区間最大・区間最小を",
      "/// ならし O(log^2 N) で処理する。`ac_library::LazySegtree` では chmin/chmax は扱えない。",
      "/// - [`Self::区間chmin`] / [`Self::区間chmax`] : 半開区間 `[l, r)` への min/max 更新。",
      "/// - [`Self::区間和`] / [`Self::区間最大`] / [`Self::区間最小`] : 半開区間 `[l, r)` の集計。",
      "struct セグ木ビーツ {",
      "    n: usize,",
      "    木: Vec<節点>,",
      "}",
      "impl セグ木ビーツ {",
      "    /// 初期配列から構築する。",
      "    fn new(配列: &[i64]) -> Self {",
      "        let n = 配列.len();",
      "        let mut t = Self {",
      "            n,",
      "            木: vec![節点::空(); 4 * n.max(1)],",
      "        };",
      "        if n > 0 {",
      "            t.構築(1, 0, n, 配列);",
      "        }",
      "        t",
      "    }",
      "    fn 構築(&mut self, 節: usize, lo: usize, hi: usize, 配列: &[i64]) {",
      "        if hi - lo == 1 {",
      "            self.木[節] = 節点::葉(配列[lo]);",
      "            return;",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        self.構築(2 * 節, lo, m, 配列);",
      "        self.構築(2 * 節 + 1, m, hi, 配列);",
      "        self.統合(節);",
      "    }",
      "    fn 統合(&mut self, 節: usize) {",
      "        self.木[節] = 合成(&self.木[2 * 節].clone(), &self.木[2 * 節 + 1].clone());",
      "    }",
      "    /// 節点 `節` の最大値を `x` 以下に抑える（`x > 最大2` が前提）。",
      "    fn chmin適用(&mut self, 節: usize, x: i64) {",
      "        let nd = &mut self.木[節];",
      "        if x >= nd.最大1 {",
      "            return;",
      "        }",
      "        nd.和 -= (nd.最大1 - x) * nd.最大個数;",
      "        if nd.最小1 == nd.最大1 {",
      "            nd.最小1 = x;",
      "        } else if nd.最小2 == nd.最大1 {",
      "            nd.最小2 = x;",
      "        }",
      "        nd.最大1 = x;",
      "    }",
      "    /// 節点 `節` の最小値を `x` 以上に持ち上げる（`x < 最小2` が前提）。",
      "    fn chmax適用(&mut self, 節: usize, x: i64) {",
      "        let nd = &mut self.木[節];",
      "        if x <= nd.最小1 {",
      "            return;",
      "        }",
      "        nd.和 += (x - nd.最小1) * nd.最小個数;",
      "        if nd.最大1 == nd.最小1 {",
      "            nd.最大1 = x;",
      "        } else if nd.最大2 == nd.最小1 {",
      "            nd.最大2 = x;",
      "        }",
      "        nd.最小1 = x;",
      "    }",
      "    /// 親の cap（最大1）・floor（最小1）を子へ伝播する。",
      "    fn 伝播(&mut self, 節: usize) {",
      "        let cap = self.木[節].最大1;",
      "        let floor = self.木[節].最小1;",
      "        for 子 in [2 * 節, 2 * 節 + 1] {",
      "            self.chmin適用(子, cap);",
      "            self.chmax適用(子, floor);",
      "        }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対し `a[i] = min(a[i], x)`。ならし `O(log² N)`。",
      "    fn 区間chmin(&mut self, 範囲: impl std::ops::RangeBounds<usize>, x: impl TryInto<i64>) {",
      "        let x = to_i64(x);",
      "        let (l, r) = 半開(範囲, self.n);",
      "        if l < r {",
      "            self.chmin内部(1, 0, self.n, l, r, x);",
      "        }",
      "    }",
      "    fn chmin内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize, x: i64) {",
      "        if r <= lo || hi <= l || self.木[節].最大1 <= x {",
      "            return;",
      "        }",
      "        if l <= lo && hi <= r && self.木[節].最大2 < x {",
      "            self.chmin適用(節, x);",
      "            return;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.chmin内部(2 * 節, lo, m, l, r, x);",
      "        self.chmin内部(2 * 節 + 1, m, hi, l, r, x);",
      "        self.統合(節);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対し `a[i] = max(a[i], x)`。ならし `O(log² N)`。",
      "    fn 区間chmax(&mut self, 範囲: impl std::ops::RangeBounds<usize>, x: impl TryInto<i64>) {",
      "        let x = to_i64(x);",
      "        let (l, r) = 半開(範囲, self.n);",
      "        if l < r {",
      "            self.chmax内部(1, 0, self.n, l, r, x);",
      "        }",
      "    }",
      "    fn chmax内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize, x: i64) {",
      "        if r <= lo || hi <= l || self.木[節].最小1 >= x {",
      "            return;",
      "        }",
      "        if l <= lo && hi <= r && self.木[節].最小2 > x {",
      "            self.chmax適用(節, x);",
      "            return;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.chmax内部(2 * 節, lo, m, l, r, x);",
      "        self.chmax内部(2 * 節 + 1, m, hi, l, r, x);",
      "        self.統合(節);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の総和。ならし `O(log N)`。",
      "    fn 区間和(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.和内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 和内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return 0;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].和;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.和内部(2 * 節, lo, m, l, r) + self.和内部(2 * 節 + 1, m, hi, l, r)",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の最大値。ならし `O(log N)`。",
      "    fn 区間最大(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.最大内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 最大内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return -無限大;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].最大1;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.最大内部(2 * 節, lo, m, l, r)",
      "            .max(self.最大内部(2 * 節 + 1, m, hi, l, r))",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の最小値。ならし `O(log N)`。",
      "    fn 区間最小(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.最小内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 最小内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return 無限大;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].最小1;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.最小内部(2 * 節, lo, m, l, r)",
      "            .min(self.最小内部(2 * 節 + 1, m, hi, l, r))",
      "    }",
      "}"
    ]
  },
  "SegmentedSieve": {
    "scope": "rust",
    "prefix": "SegmentedSieve",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 区間（`l..r`=半開 / `l..=r`=閉。`..=r` のように下端省略も可）に含まれる素数をすべて昇順で返す",
      "/// **区間篩**。`r` が `10¹²` 程度でも、区間幅 `r−l` が小さければ高速に列挙できる。計算量",
      "/// `O((√r) + (r−l) loglog r)`、追加メモリ `O(√r + 区間幅)`。上端は必須（土台の長さが無いので",
      "/// `..` や `l..` は解決できず panic）。",
      "/// 同じファイルの [`素因数分解器`] は上限 `5·10⁷` までの線形篩なので `r` が大きいと使えない。",
      "/// 区間篩は「`10¹²` 近辺の素数」のように上限だけ大きく幅が狭い場合に使う。",
      "fn 区間篩<T: Copy + TryInto<u64>>(範囲: impl std::ops::RangeBounds<T>) -> Vec<usize> {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let 変換 = |x: T| -> u64 {",
      "        x.try_into()",
      "            .ok()",
      "            .expect(\"区間篩: 引数が u64 に収まりません\")",
      "    };",
      "    let l: u64 = match 範囲.start_bound() {",
      "        Included(&x) => 変換(x),",
      "        Excluded(&x) => 変換(x).saturating_add(1),",
      "        Unbounded => 0,",
      "    };",
      "    let r: u64 = match 範囲.end_bound() {",
      "        Included(&x) => 変換(x),",
      "        Excluded(&x) => 変換(x).saturating_sub(1),",
      "        Unbounded => panic!(\"区間篩: 上端は必須（.. や l.. は不可。l..r か l..=r を使う）\"),",
      "    };",
      "    if r < 2 || l > r {",
      "        return Vec::new();",
      "    }",
      "    let l = l.max(2);",
      "    let lim = (r as f64).sqrt() as u64 + 2;",
      "    let mut 合成基底 = vec![false; (lim + 1) as usize];",
      "    let mut 基底素数 = Vec::new();",
      "    for i in 2..=lim {",
      "        if !合成基底[i as usize] {",
      "            基底素数.push(i);",
      "            let mut j = i * i;",
      "            while j <= lim {",
      "                合成基底[j as usize] = true;",
      "                j += i;",
      "            }",
      "        }",
      "    }",
      "    let 幅 = (r - l + 1) as usize;",
      "    let mut 合成 = vec![false; 幅];",
      "    for &p in &基底素数 {",
      "        let mut 始 = l.div_ceil(p) * p;",
      "        始 = 始.max(p * p);",
      "        let mut j = 始;",
      "        while j <= r {",
      "            合成[(j - l) as usize] = true;",
      "            j += p;",
      "        }",
      "    }",
      "    (l..=r)",
      "        .filter(|&x| !合成[(x - l) as usize])",
      "        .map(|x| x as usize)",
      "        .collect()",
      "}"
    ]
  },
  "SkewHeap": {
    "scope": "rust",
    "prefix": "SkewHeap",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// スキューヒープの節点（最小ヒープ）。値と左右の子を持つ自己平衡しない二分ヒープ。",
      "struct 節点<T> {",
      "    値: T,",
      "    左: Option<Box<節点<T>>>,",
      "    右: Option<Box<節点<T>>>,",
      "}",
      "/// 2 つの部分木を併合する内部関数。",
      "fn 併合節点<T: Ord>(",
      "    a: Option<Box<節点<T>>>,",
      "    b: Option<Box<節点<T>>>,",
      ") -> Option<Box<節点<T>>> {",
      "    match (a, b) {",
      "        (None, x) | (x, None) => x,",
      "        (Some(mut na), Some(mut nb)) => {",
      "            if na.値 > nb.値 {",
      "                std::mem::swap(&mut na, &mut nb);",
      "            }",
      "            let 右 = na.右.take();",
      "            na.右 = 併合節点(右, Some(nb));",
      "            std::mem::swap(&mut na.左, &mut na.右);",
      "            Some(na)",
      "        }",
      "    }",
      "}",
      "/// 2 つのヒープを `O(log n)` で併合（meld）できる最小ヒープ（スキューヒープ）。",
      "/// 標準の `BinaryHeap` は 2 つのヒープの併合に `O(n)` かかるが、本実装は併合・挿入・",
      "/// 最小取り出しすべて償却 `O(log n)`。最小有向全域木や Dijkstra 風のヒープ統合で使う。",
      "#[derive(Default)]",
      "struct スキューヒープ<T: Ord> {",
      "    根: Option<Box<節点<T>>>,",
      "    個数: usize,",
      "}",
      "impl<T: Ord> スキューヒープ<T> {",
      "    /// 空のヒープを作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            根: None, 個数: 0",
      "        }",
      "    }",
      "    /// 要素数を返す。",
      "    fn 個数(&self) -> usize {",
      "        self.個数",
      "    }",
      "    /// 空かどうかを返す。",
      "    fn 空か(&self) -> bool {",
      "        self.個数 == 0",
      "    }",
      "    /// 値 `v` を挿入する。償却 `O(log n)`。",
      "    fn 挿入(&mut self, v: T) {",
      "        let 節 = Some(Box::new(節点 {",
      "            値: v,",
      "            左: None,",
      "            右: None,",
      "        }));",
      "        self.根 = 併合節点(self.根.take(), 節);",
      "        self.個数 += 1;",
      "    }",
      "    /// 最小値への参照を返す（空なら `None`）。`O(1)`。",
      "    fn 最小参照(&self) -> Option<&T> {",
      "        self.根.as_ref().map(|n| &n.値)",
      "    }",
      "    /// 最小値を取り出して返す（空なら `None`）。償却 `O(log n)`。",
      "    fn 最小取り出し(&mut self) -> Option<T> {",
      "        let 根 = self.根.take()?;",
      "        self.個数 -= 1;",
      "        self.根 = 併合節点(根.左, 根.右);",
      "        Some(根.値)",
      "    }",
      "    /// 別のヒープ `other` を自分に併合する。`other` は空になる。償却 `O(log n)`。",
      "    fn 併合(&mut self, other: &mut Self) {",
      "        self.根 = 併合節点(self.根.take(), other.根.take());",
      "        self.個数 += other.個数;",
      "        other.個数 = 0;",
      "    }",
      "}"
    ]
  },
  "SlopeTrick": {
    "scope": "rust",
    "prefix": "SlopeTrick",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::cmp::Reverse;",
      "use std::collections::BinaryHeap;",
      "/// スロープトリック。区分線形な凸関数 `f(x)` を、傾きが変化する点（折れ点）の多重集合として管理する。",
      "/// 各操作 `O(log N)`。DP の遷移が「`f += max(0, x-a)`」「`f += |x-a|`」",
      "/// 「累積 min（スライド最小値）」などで書けるとき計算量を落とせる。",
      "/// - [`Self::絶対値加算`] : `f(x) += |x - a|`。",
      "/// - [`Self::右側を平坦化`] / [`Self::左側を平坦化`] : 累積 min。",
      "/// - [`Self::最小値`] / [`Self::評価`] : 値の取得。",
      "struct スロープトリック {",
      "    最小値: i64,",
      "    左: BinaryHeap<i64>,",
      "    右: BinaryHeap<Reverse<i64>>,",
      "    加算左: i64,",
      "    加算右: i64,",
      "}",
      "impl スロープトリック {",
      "    /// 恒等的に 0 の関数 `f(x) = 0` を作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            最小値: 0,",
      "            左: BinaryHeap::new(),",
      "            右: BinaryHeap::new(),",
      "            加算左: 0,",
      "            加算右: 0,",
      "        }",
      "    }",
      "    fn 左頂点(&self) -> Option<i64> {",
      "        self.左.peek().map(|&v| v + self.加算左)",
      "    }",
      "    fn 右頂点(&self) -> Option<i64> {",
      "        self.右.peek().map(|&Reverse(v)| v + self.加算右)",
      "    }",
      "    fn 左へ(&mut self, a: i64) {",
      "        self.左.push(a - self.加算左);",
      "    }",
      "    fn 右へ(&mut self, a: i64) {",
      "        self.右.push(Reverse(a - self.加算右));",
      "    }",
      "    /// 現在の最小値 `min_x f(x)`。",
      "    fn 最小値(&self) -> i64 {",
      "        self.最小値",
      "    }",
      "    /// `f(x) += c`（定数加算）。引数は任意の整数型でよい（他のメソッドも同様）。",
      "    fn 定数加算(&mut self, c: impl TryInto<i64>) {",
      "        self.最小値 += to_i64(c);",
      "    }",
      "    /// `f(x) += max(0, x - a)`（右上がりの折れを追加）。",
      "    fn 右傾き加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        if let Some(l) = self.左頂点()",
      "            && l > a",
      "        {",
      "            self.最小値 += l - a;",
      "        }",
      "        self.左へ(a);",
      "        let v = self.左.pop().unwrap() + self.加算左;",
      "        self.右へ(v);",
      "    }",
      "    /// `f(x) += max(0, a - x)`（左上がりの折れを追加）。",
      "    fn 左傾き加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        if let Some(r) = self.右頂点()",
      "            && r < a",
      "        {",
      "            self.最小値 += a - r;",
      "        }",
      "        self.右へ(a);",
      "        let Reverse(v) = self.右.pop().unwrap();",
      "        let v = v + self.加算右;",
      "        self.左へ(v);",
      "    }",
      "    /// `f(x) += |x - a|`。",
      "    fn 絶対値加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        self.右傾き加算(a);",
      "        self.左傾き加算(a);",
      "    }",
      "    /// 累積 min: `f(x) := min_{y <= x} f(y)`（右側の上がりを消し、右へ平坦化）。",
      "    fn 右側を平坦化(&mut self) {",
      "        self.右.clear();",
      "    }",
      "    /// 累積 min: `f(x) := min_{y >= x} f(y)`（左側の上がりを消し、左へ平坦化）。",
      "    fn 左側を平坦化(&mut self) {",
      "        self.左.clear();",
      "    }",
      "    /// 平行移動: `f(x) := f(x - a)`（全折れ点を `a` ずらす）。",
      "    fn 平行移動(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        self.加算左 += a;",
      "        self.加算右 += a;",
      "    }",
      "    /// スライド最小値: `f(x) := min_{a <= d <= b} f(x - d)`（`a <= b`）。",
      "    fn 窓最小(&mut self, a: impl TryInto<i64>, b: impl TryInto<i64>) {",
      "        let (a, b) = (to_i64(a), to_i64(b));",
      "        assert!(a <= b);",
      "        self.加算左 += a;",
      "        self.加算右 += b;",
      "    }",
      "    /// `f(x)` の値を O(N) で評価する。",
      "    fn 評価(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        let mut v = self.最小値;",
      "        for &l in self.左.iter() {",
      "            let l = l + self.加算左;",
      "            if l > x {",
      "                v += l - x;",
      "            }",
      "        }",
      "        for &Reverse(r) in self.右.iter() {",
      "            let r = r + self.加算右;",
      "            if r < x {",
      "                v += x - r;",
      "            }",
      "        }",
      "        v",
      "    }",
      "}",
      "impl Default for スロープトリック {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "SortedMultiset": {
    "scope": "rust",
    "prefix": "SortedMultiset",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ソート済み多重集合（平方分割）。常に昇順に並んだ多重集合で、挿入・1 個削除・k 番目・",
      "/// 順位（`x` 未満／以下の個数）・`x` 以上の最小／`x` 以下の最大をまとめて扱う。",
      "/// 値を事前に知らなくてよい（オンライン）ので、二分探索をその場で書かずにここへ押し付けられる。",
      "/// 内部は長さ 1024 以下の昇順 `Vec` を並べたバケット列。各バケット末尾への二分探索で対象バケットを",
      "/// 決め、バケット内も二分探索する。1024 を超えたバケットは半分に割り、空になったバケットは除去する。",
      "/// バケット数を `B`（≤ 挿入回数 / 512 + 1。`N = 2·10^5` なら約 400）として",
      "/// - [`Self::挿入`] / [`Self::削除`] : 二分探索 + バケット内の `Vec` 途中挿入・削除で `O(log N + 1024 + B)`",
      "/// - [`Self::以上の最小`] / [`Self::以下の最大`] / [`Self::最小`] / [`Self::最大`] : `O(log N)`",
      "/// - [`Self::k番目`] / [`Self::未満の個数`] / [`Self::以下の個数`] : バケット長の線形走査で `O(B + log N)`",
      "/// - [`Self::含む個数`] : `O(log N + x がまたがるバケット数)`",
      "/// `BTreeSet` / `BTreeMap` は k 番目・順位を取れない。[`二進トライ`](crate::binary_trie::二進トライ) は",
      "/// 非負整数専用でメモリも重く、BIT＋座標圧縮は値を先読みできるとき限定、",
      "/// [`陰的Treap`](crate::treap::陰的Treap) は位置で管理する列なので、値の大小で並べたいならこちらを使う。",
      "/// 値の型は `Ord + Copy` なら何でもよい（整数・`(i64, usize)` などのタプル・`char`）。",
      "/// 引数も返り値も値渡しにして呼び出し側の `&` / `*` を省くため `Copy` を要求する。",
      "#[derive(Clone, Debug)]",
      "struct ソート済み多重集合<T> {",
      "    バケット: Vec<Vec<T>>,",
      "    長さ: usize,",
      "}",
      "impl<T: Ord + Copy> ソート済み多重集合<T> {",
      "    /// バケットを半分に割る長さ。小さいと k 番目・順位の線形走査が、大きいと `Vec` の途中挿入が重い。",
      "    /// `N = 2·10^5`・値 `[0, 10^9)` の乱数で挿入／k 番目／順位を各 `N` 回した合計（1.89.0 release）:",
      "    /// 256 → 109ms, 512 → 66ms, 1024 → 54ms, 2048 → 57ms, 4096 → 74ms。",
      "    const 分割閾値: usize = 1024;",
      "    /// 空の多重集合を作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            バケット: Vec::new(),",
      "            長さ: 0,",
      "        }",
      "    }",
      "    /// 要素数（重複込み）。",
      "    fn 長さ(&self) -> usize {",
      "        self.長さ",
      "    }",
      "    /// 空かどうか。",
      "    fn 空か(&self) -> bool {",
      "        self.長さ == 0",
      "    }",
      "    /// 昇順に見て true が続きある所から false になる述語 `前か` が、初めて false になる要素の位置",
      "    /// `(バケット番号, バケット内位置)`。全要素で true なら `(バケット数, 0)`。",
      "    fn 境界(&self, 前か: impl Fn(T) -> bool) -> (usize, usize) {",
      "        let i = self.バケット.partition_point(|b| 前か(b[b.len() - 1]));",
      "        let j = self",
      "            .バケット",
      "            .get(i)",
      "            .map_or(0, |b| b.partition_point(|&y| 前か(y)));",
      "        (i, j)",
      "    }",
      "    /// 値 `x` を 1 個追加する。",
      "    fn 挿入(&mut self, x: T) {",
      "        self.長さ += 1;",
      "        if self.バケット.is_empty() {",
      "            self.バケット.push(vec![x]);",
      "            return;",
      "        }",
      "        let (mut i, mut j) = self.境界(|y| y < x);",
      "        if i == self.バケット.len() {",
      "            i -= 1;",
      "            j = self.バケット[i].len();",
      "        }",
      "        let b = &mut self.バケット[i];",
      "        b.insert(j, x);",
      "        if b.len() > Self::分割閾値 {",
      "            let 後半 = b.split_off(b.len() / 2);",
      "            self.バケット.insert(i + 1, 後半);",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個だけ削除し、削除できたら `true`（無ければ何もせず `false`）。",
      "    fn 削除(&mut self, x: T) -> bool {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        match self.バケット.get_mut(i) {",
      "            Some(b) if b[j] == x => {",
      "                b.remove(j);",
      "                if b.is_empty() {",
      "                    self.バケット.remove(i);",
      "                }",
      "                self.長さ -= 1;",
      "                true",
      "            }",
      "            _ => false,",
      "        }",
      "    }",
      "    /// 0 始まりで `k` 番目に小さい値（重複込み）。`k >= 長さ` なら panic。",
      "    fn k番目(&self, k: usize) -> T {",
      "        let mut 残り = k;",
      "        for b in &self.バケット {",
      "            if 残り < b.len() {",
      "                return b[残り];",
      "            }",
      "            残り -= b.len();",
      "        }",
      "        panic!(\"ソート済み多重集合: k = {k} が範囲外（長さ {}）\", self.長さ)",
      "    }",
      "    /// `x` 未満の要素数（`x` の順位。`k番目(未満の個数(x))` が `x` 以上の最小）。",
      "    fn 未満の個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        self.バケット[..i].iter().map(Vec::len).sum::<usize>() + j",
      "    }",
      "    /// `x` 以下の要素数。",
      "    fn 以下の個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y <= x);",
      "        self.バケット[..i].iter().map(Vec::len).sum::<usize>() + j",
      "    }",
      "    /// 値 `x` の個数。",
      "    fn 含む個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        let (i2, j2) = self.境界(|y| y <= x);",
      "        self.バケット[i..i2].iter().map(Vec::len).sum::<usize>() + j2 - j",
      "    }",
      "    /// `x` 以上の最小値（無ければ `None`）。",
      "    fn 以上の最小(&self, x: T) -> Option<T> {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        self.バケット.get(i).map(|b| b[j])",
      "    }",
      "    /// `x` 以下の最大値（無ければ `None`）。",
      "    fn 以下の最大(&self, x: T) -> Option<T> {",
      "        let (i, j) = self.境界(|y| y <= x);",
      "        if j > 0 {",
      "            Some(self.バケット[i][j - 1])",
      "        } else {",
      "            self.バケット[..i].last().map(|b| b[b.len() - 1])",
      "        }",
      "    }",
      "    /// 最小値（空なら `None`）。",
      "    fn 最小(&self) -> Option<T> {",
      "        self.バケット.first().map(|b| b[0])",
      "    }",
      "    /// 最大値（空なら `None`）。",
      "    fn 最大(&self) -> Option<T> {",
      "        self.バケット.last().map(|b| b[b.len() - 1])",
      "    }",
      "    /// 全要素を昇順に列挙する（重複込み）。",
      "    fn 昇順(&self) -> impl Iterator<Item = T> {",
      "        self.バケット.iter().flatten().copied()",
      "    }",
      "}",
      "impl<T: Ord + Copy> Default for ソート済み多重集合<T> {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "SparseTable": {
    "scope": "rust",
    "prefix": "SparseTable",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// スパーステーブル。静的（更新なし）な配列に対し、区間 min / max / gcd など",
      "/// 「冪等な二項演算」の区間クエリを前処理 O(N log N)・各クエリ O(1) で答える。",
      "/// `merge` は結合的かつ冪等（`merge(x, x) == x`）な演算であること（min, max, gcd, &, | など）。",
      "/// 和のような非冪等な演算には使えない（その用途は累積和やセグメント木を使う）。",
      "struct スパーステーブル<T, F> {",
      "    table: Vec<Vec<T>>,",
      "    merge: F,",
      "}",
      "impl<T: Copy, F: Fn(T, T) -> T> スパーステーブル<T, F> {",
      "    /// 配列と冪等な二項演算 `merge` からスパーステーブルを構築する。",
      "    /// # 例",
      "    /// ```ignore",
      "    /// let st = スパーステーブル::new(&a, |x, y| x.min(y)); // 区間 min",
      "    /// ```",
      "    fn new(配列: &[T], merge: F) -> Self {",
      "        let n = 配列.len();",
      "        let mut table = vec![配列.to_vec()];",
      "        let mut 幅 = 1;",
      "        while 幅 * 2 <= n {",
      "            let 前 = table.last().unwrap();",
      "            let 行: Vec<T> = (0..=n - 幅 * 2).map(|i| merge(前[i], 前[i + 幅])).collect();",
      "            table.push(行);",
      "            幅 *= 2;",
      "        }",
      "        Self { table, merge }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対する `merge` の畳み込み結果を O(1) で返す。",
      "    /// 空区間は問い合わせ不可。",
      "    fn 区間(&self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.table[0].len());",
      "        debug_assert!(l < r, \"スパーステーブル: 空区間は問い合わせ不可\");",
      "        let j = (usize::BITS - 1 - (r - l).leading_zeros()) as usize;",
      "        (self.merge)(self.table[j][l], self.table[j][r - (1 << j)])",
      "    }",
      "}"
    ]
  },
  "SteinerTree": {
    "scope": "rust",
    "prefix": "SteinerTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::cmp::Reverse;",
      "use std::collections::BinaryHeap;",
      "const 無限大シュタイナー: i64 = 1 << 60;",
      "/// 最小シュタイナー木。重み付き無向グラフで、指定した「端子（terminal）」をすべて連結する最小重み部分木の",
      "/// 重みを求める。端子数 `k` に対し O(3^k V + 2^k (V + E) log V) の集合 DP。辺重みは非負（内部で Dijkstra を使う）。",
      "/// 全域木（最小全域木）とは異なり、端子以外の頂点（Steiner 点）を経由してよい点が特徴。",
      "/// 端子が 0/1 個なら 0、連結できないときは [`Self::到達不可`] を返す。",
      "/// - [`Self::解く`] : 端子集合を連結する最小重み。",
      "struct 最小シュタイナー木 {",
      "    n: usize,",
      "    グラフ: Vec<Vec<(usize, i64)>>,",
      "}",
      "impl 最小シュタイナー木 {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            グラフ: vec![Vec::new(); n],",
      "        }",
      "    }",
      "    /// 重み `w`（非負）の無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize, w: impl TryInto<i64>) {",
      "        let w = to_i64(w);",
      "        self.グラフ[u].push((v, w));",
      "        self.グラフ[v].push((u, w));",
      "    }",
      "    /// 連結できないことを表す番兵値。",
      "    fn 到達不可() -> i64 {",
      "        無限大シュタイナー",
      "    }",
      "    /// 端子集合をすべて連結する最小重み部分木の総重みを返す。",
      "    fn 解く(&self, 端子: &[usize]) -> i64 {",
      "        let k = 端子.len();",
      "        if k <= 1 {",
      "            return 0;",
      "        }",
      "        let 全 = 1usize << k;",
      "        let mut dp = vec![vec![無限大シュタイナー; self.n]; 全];",
      "        for (i, &t) in 端子.iter().enumerate() {",
      "            dp[1 << i][t] = 0;",
      "        }",
      "        for mask in 1..全 {",
      "            let mut sub = (mask - 1) & mask;",
      "            while sub > 0 {",
      "                let 他 = mask ^ sub;",
      "                for v in 0..self.n {",
      "                    let 候補 = dp[sub][v].saturating_add(dp[他][v]);",
      "                    if 候補 < dp[mask][v] {",
      "                        dp[mask][v] = 候補;",
      "                    }",
      "                }",
      "                sub = (sub - 1) & mask;",
      "            }",
      "            let mut ヒープ = BinaryHeap::new();",
      "            for (v, &d) in dp[mask].iter().enumerate() {",
      "                if d < 無限大シュタイナー {",
      "                    ヒープ.push((Reverse(d), v));",
      "                }",
      "            }",
      "            while let Some((Reverse(d), now)) = ヒープ.pop() {",
      "                if d > dp[mask][now] {",
      "                    continue;",
      "                }",
      "                for &(next, w) in &self.グラフ[now] {",
      "                    if dp[mask][now] + w < dp[mask][next] {",
      "                        dp[mask][next] = dp[mask][now] + w;",
      "                        ヒープ.push((Reverse(dp[mask][next]), next));",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        dp[全 - 1].iter().copied().min().unwrap()",
      "    }",
      "}"
    ]
  },
  "SternBrocot": {
    "scope": "rust",
    "prefix": "SternBrocot",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::cmp::Ordering;",
      "/// 非負の有理数 `分子 / 分母`（`分母 > 0`）の正則連分数展開 `[a0; a1, a2, …]` を返す。",
      "/// ユークリッドの互除法そのもの。`O(log 分母)`。",
      "fn 連分数展開(分子: impl TryInto<i64>, 分母: impl TryInto<i64>) -> Vec<i64> {",
      "    let mut 分子 = 分子",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連分数展開: 引数が i64 に収まりません\");",
      "    let mut 分母 = 分母",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連分数展開: 引数が i64 に収まりません\");",
      "    assert!(分母 > 0 && 分子 >= 0, \"分子 >= 0, 分母 > 0\");",
      "    let mut 係数 = Vec::new();",
      "    while 分母 != 0 {",
      "        係数.push(分子 / 分母);",
      "        let r = 分子 % 分母;",
      "        分子 = 分母;",
      "        分母 = r;",
      "    }",
      "    係数",
      "}",
      "/// 連分数係数列から収束分数（convergent）`(分子, 分母)` の列を返す。",
      "/// `h_i = a_i·h_{i-1} + h_{i-2}`, `k_i = a_i·k_{i-1} + k_{i-2}`。各収束分数は既約。",
      "fn 収束分数(係数: &[i64]) -> Vec<(i64, i64)> {",
      "    let mut 列 = Vec::with_capacity(係数.len());",
      "    let (mut h2, mut h1) = (0i64, 1i64);",
      "    let (mut k2, mut k1) = (1i64, 0i64);",
      "    for &a in 係数 {",
      "        let h = a * h1 + h2;",
      "        let k = a * k1 + k2;",
      "        列.push((h, k));",
      "        h2 = h1;",
      "        h1 = h;",
      "        k2 = k1;",
      "        k1 = k;",
      "    }",
      "    列",
      "}",
      "/// `分子/分母` への近さ `|分子/分母 - a/b|` を厳密に比較する内部関数（小さいほど近い）。",
      "fn 距離cmp(分子: i64, 分母: i64, x: (i64, i64), y: (i64, i64)) -> Ordering {",
      "    let (p, q) = (分子 as i128, 分母 as i128);",
      "    let dx = (p * x.1 as i128 - x.0 as i128 * q).abs() * y.1 as i128;",
      "    let dy = (p * y.1 as i128 - y.0 as i128 * q).abs() * x.1 as i128;",
      "    dx.cmp(&dy)",
      "}",
      "/// `x = 分子/分母` に最も近い有理数 `a/b`（`1 <= b <= 分母上限`）を `O(log 分母)` で求める。",
      "/// 連分数の収束分数と半収束分数（semiconvergent）のうち、分母が上限以下で最も近いものを返す。",
      "/// 距離が等しいときは分母が小さい方。`x` が `分母上限` 以下の分母で厳密表現できればそれを返す。",
      "/// Stern–Brocot 木上の最良近似。",
      "fn 最良有理近似(",
      "    分子: impl TryInto<i64>,",
      "    分母: impl TryInto<i64>,",
      "    分母上限: impl TryInto<i64>,",
      ") -> (i64, i64) {",
      "    let 分子 = 分子",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    let 分母 = 分母",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    let 分母上限 = 分母上限",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    assert!(分母 > 0 && 分子 >= 0 && 分母上限 >= 1);",
      "    let (mut a, mut b) = (分子, 分母);",
      "    let (mut h2, mut h1) = (0i64, 1i64);",
      "    let (mut k2, mut k1) = (1i64, 0i64);",
      "    loop {",
      "        if b == 0 {",
      "            return (h1, k1);",
      "        }",
      "        let ai = a / b;",
      "        let r = a % b;",
      "        let k = ai * k1 + k2;",
      "        if k > 分母上限 {",
      "            let ap = (分母上限 - k2) / k1;",
      "            let 半 = (ap * h1 + h2, ap * k1 + k2);",
      "            let 前 = (h1, k1);",
      "            return match 距離cmp(分子, 分母, 半, 前) {",
      "                Ordering::Less => 半,",
      "                Ordering::Greater => 前,",
      "                Ordering::Equal => {",
      "                    if 半.1 <= 前.1 {",
      "                        半",
      "                    } else {",
      "                        前",
      "                    }",
      "                }",
      "            };",
      "        }",
      "        let h = ai * h1 + h2;",
      "        h2 = h1;",
      "        h1 = h;",
      "        k2 = k1;",
      "        k1 = k;",
      "        a = b;",
      "        b = r;",
      "    }",
      "}"
    ]
  },
  "StirlingFirst": {
    "scope": "rust",
    "prefix": "StirlingFirst",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::ModInt as Mint;",
      "/// 符号なし第一種スターリング数 `c(n, k)` の表（`0..=n` 行・`0..=n` 列）を前計算して返す。O(n^2)。",
      "/// mod は `Mint`（ac_library::ModInt）のグローバル modulus。Comb は不要。",
      "/// `c(n, k)` は `n` 要素の順列のうち巡回置換（サイクル）がちょうど `k` 個のものの数。",
      "/// 第二種スターリング数（集合の分割）とは別物（こちらはサイクル数の分布）。u64 なら n ≥ 22 で溢れる。",
      "fn 第一種スターリング数表(n: usize) -> Vec<Vec<Mint>> {",
      "    let mut c = vec![vec![Mint::new(0); n + 1]; n + 1];",
      "    c[0][0] = Mint::new(1);",
      "    for i in 1..=n {",
      "        for k in 1..=i {",
      "            c[i][k] = c[i - 1][k - 1] + Mint::new(i - 1) * c[i - 1][k];",
      "        }",
      "    }",
      "    c",
      "}"
    ]
  },
  "StoerWagner": {
    "scope": "rust",
    "prefix": "StoerWagner",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向重み付きグラフの**全域最小カット**（global minimum cut）を Stoer–Wagner 法で求める。",
      "/// 始点・終点を指定せず「頂点集合を空でない 2 つに分ける切断のうち、またぐ辺の重み和が最小のもの」を返す。",
      "/// `n` 頂点、`辺` は `(u, v, 重み)` の無向辺（重み非負、多重辺は加算、自己ループは無視）。計算量 `O(n^3)`。",
      "/// `ac_library` の `maxflow` は s–t 間の最小カット専用で、全ペアを試さずに大域最小カットを出すのはこちら。",
      "/// `n <= 1` のときは `0` を返す。",
      "fn 全域最小カット(n: usize, 辺: &[(usize, usize, i64)]) -> i64 {",
      "    if n <= 1 {",
      "        return 0;",
      "    }",
      "    let mut グラフ = vec![vec![0i64; n]; n];",
      "    for &(u, v, w) in 辺 {",
      "        if u != v {",
      "            グラフ[u][v] += w;",
      "            グラフ[v][u] += w;",
      "        }",
      "    }",
      "    let mut 最良 = i64::MAX;",
      "    let mut 頂点: Vec<usize> = (0..n).collect();",
      "    while 頂点.len() > 1 {",
      "        let m = 頂点.len();",
      "        let mut 接続重み = vec![0i64; n];",
      "        let mut 取込済 = vec![false; n];",
      "        let mut 順序 = Vec::with_capacity(m);",
      "        for _ in 0..m {",
      "            let mut 選 = !0;",
      "            for &v in &頂点 {",
      "                if !取込済[v] && (選 == !0 || 接続重み[v] > 接続重み[選]) {",
      "                    選 = v;",
      "                }",
      "            }",
      "            取込済[選] = true;",
      "            順序.push(選);",
      "            for &v in &頂点 {",
      "                if !取込済[v] {",
      "                    接続重み[v] += グラフ[選][v];",
      "                }",
      "            }",
      "        }",
      "        let t = 順序[m - 1];",
      "        let s = 順序[m - 2];",
      "        最良 = 最良.min(接続重み[t]);",
      "        for &v in &頂点 {",
      "            グラフ[s][v] += グラフ[t][v];",
      "            グラフ[v][s] += グラフ[v][t];",
      "        }",
      "        頂点.retain(|&x| x != t);",
      "    }",
      "    最良",
      "}"
    ]
  },
  "SubsetConvolution": {
    "scope": "rust",
    "prefix": "SubsetConvolution",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 下位集合方向のゼータ変換（SOS）。`f[S]` を `Σ_{T ⊆ S} f[T]` へ in-place 変換する。`O(n · 2^n)`。",
      "/// 部分集合畳み込み内部で各ランク層に適用する補助関数。",
      "fn 部分集合ゼータ<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let m = f.len();",
      "    let mut bit = 1;",
      "    while bit < m {",
      "        for s in 0..m {",
      "            if s & bit != 0 {",
      "                f[s] += f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}",
      "/// [`部分集合ゼータ`] の逆（メビウス）。`Σ_{T ⊆ S} f[T]` から `f` を復元する。`O(n · 2^n)`。",
      "fn 部分集合メビウス<T: Copy + std::ops::SubAssign>(f: &mut [T]) {",
      "    let m = f.len();",
      "    let mut bit = 1;",
      "    while bit < m {",
      "        for s in 0..m {",
      "            if s & bit != 0 {",
      "                f[s] -= f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}",
      "/// 部分集合畳み込み（subset sum convolution）。`h[S] = Σ_{T ⊆ S} f[T]·g[S∖T]` を",
      "/// `O(n^2 · 2^n)` で求める（`n` はビット数、配列長は `2^n`）。`T` と `S∖T` が**素**（重なり無し）な",
      "/// 分割だけを足し合わせる点が、単なる下位集合ゼータ（[`zeta_mobius`](crate::zeta_mobius)）の積とは異なる。",
      "/// 連結部分グラフ数え上げ・集合被覆 DP・独立集合の合成などに使う。",
      "/// 要素型は加減乗できれば何でもよい（i64 / f64 / ModInt など）。i64 は乗算の重なりで",
      "/// オーバーフローし得るので、MOD 付き数え上げでは ModInt をそのまま渡す。",
      "fn 部分集合畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::SubAssign + std::ops::Mul<Output = T>,",
      "{",
      "    let m = f.len();",
      "    assert_eq!(m, g.len(), \"f と g は同じ長さ\");",
      "    assert!(m.is_power_of_two(), \"長さは 2 のべき乗\");",
      "    let n = m.trailing_zeros() as usize;",
      "    let mut fh = vec![vec![T::default(); m]; n + 1];",
      "    let mut gh = vec![vec![T::default(); m]; n + 1];",
      "    for (s, (&fv, &gv)) in f.iter().zip(g).enumerate() {",
      "        let k = (s as u32).count_ones() as usize;",
      "        fh[k][s] = fv;",
      "        gh[k][s] = gv;",
      "    }",
      "    for k in 0..=n {",
      "        部分集合ゼータ(&mut fh[k]);",
      "        部分集合ゼータ(&mut gh[k]);",
      "    }",
      "    let mut hh = vec![vec![T::default(); m]; n + 1];",
      "    for i in 0..=n {",
      "        for j in 0..=(n - i) {",
      "            for s in 0..m {",
      "                hh[i + j][s] += fh[i][s] * gh[j][s];",
      "            }",
      "        }",
      "    }",
      "    for 層 in hh.iter_mut() {",
      "        部分集合メビウス(層);",
      "    }",
      "    let mut h = vec![T::default(); m];",
      "    for (s, hs) in h.iter_mut().enumerate() {",
      "        let k = (s as u32).count_ones() as usize;",
      "        *hs = hh[k][s];",
      "    }",
      "    h",
      "}"
    ]
  },
  "SuffixAutomaton": {
    "scope": "rust",
    "prefix": "SuffixAutomaton",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 接尾辞オートマトンの 1 状態。`len` は同値類の最長文字列長、`link` は suffix link",
      "/// （根は -1）、`next` は文字ごとの遷移先。",
      "struct 状態 {",
      "    len: usize,",
      "    link: i64,",
      "    next: HashMap<u8, usize>,",
      "}",
      "/// 接尾辞オートマトン（SAM）。文字列の全部分文字列を O(N) 状態で表す。構築 O(N)。",
      "/// - [`Self::相異なる部分文字列数`] : 相異なる（空でない）部分文字列の個数。",
      "/// - [`Self::含む`] : ある文字列が部分文字列として現れるか。",
      "struct 接尾辞オートマトン {",
      "    states: Vec<状態>,",
      "    last: usize,",
      "}",
      "impl 接尾辞オートマトン {",
      "    fn new() -> Self {",
      "        Self {",
      "            states: vec![状態 {",
      "                len: 0,",
      "                link: -1,",
      "                next: HashMap::new(),",
      "            }],",
      "            last: 0,",
      "        }",
      "    }",
      "    /// バイト列から構築する。",
      "    fn 構築(s: &[u8]) -> Self {",
      "        let mut sam = Self::new();",
      "        for &c in s {",
      "            sam.追加(c);",
      "        }",
      "        sam",
      "    }",
      "    /// 末尾に 1 文字追加する（オンライン構築）。",
      "    fn 追加(&mut self, c: u8) {",
      "        let cur = self.states.len();",
      "        self.states.push(状態 {",
      "            len: self.states[self.last].len + 1,",
      "            link: -1,",
      "            next: HashMap::new(),",
      "        });",
      "        let mut p = self.last as i64;",
      "        while p != -1 && !self.states[p as usize].next.contains_key(&c) {",
      "            self.states[p as usize].next.insert(c, cur);",
      "            p = self.states[p as usize].link;",
      "        }",
      "        if p == -1 {",
      "            self.states[cur].link = 0;",
      "        } else {",
      "            let q = self.states[p as usize].next[&c];",
      "            if self.states[p as usize].len + 1 == self.states[q].len {",
      "                self.states[cur].link = q as i64;",
      "            } else {",
      "                let clone = self.states.len();",
      "                self.states.push(状態 {",
      "                    len: self.states[p as usize].len + 1,",
      "                    link: self.states[q].link,",
      "                    next: self.states[q].next.clone(),",
      "                });",
      "                while p != -1 && self.states[p as usize].next.get(&c) == Some(&q) {",
      "                    self.states[p as usize].next.insert(c, clone);",
      "                    p = self.states[p as usize].link;",
      "                }",
      "                self.states[q].link = clone as i64;",
      "                self.states[cur].link = clone as i64;",
      "            }",
      "        }",
      "        self.last = cur;",
      "    }",
      "    /// 相異なる（空でない）部分文字列の個数。O(状態数)。",
      "    fn 相異なる部分文字列数(&self) -> usize {",
      "        let mut 合計 = 0usize;",
      "        for v in 1..self.states.len() {",
      "            let link = self.states[v].link;",
      "            let 親len = if link < 0 {",
      "                0",
      "            } else {",
      "                self.states[link as usize].len",
      "            };",
      "            合計 += self.states[v].len - 親len;",
      "        }",
      "        合計",
      "    }",
      "    /// `t` が部分文字列として現れるか。O(|t|)。",
      "    fn 含む(&self, t: &[u8]) -> bool {",
      "        let mut v = 0usize;",
      "        for &c in t {",
      "            match self.states[v].next.get(&c) {",
      "                Some(&nx) => v = nx,",
      "                None => return false,",
      "            }",
      "        }",
      "        true",
      "    }",
      "}",
      "impl Default for 接尾辞オートマトン {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "TSP": {
    "scope": "rust",
    "prefix": "TSP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巡回セールスマン問題（TSP）をビット DP で解く。O(2^N · N^2)。N は 18 程度まで。",
      "/// `距離[i][j]` は i→j のコスト（有向。到達不可は十分大きい値を入れる）。",
      "/// 頂点 0 を始点に全頂点をちょうど 1 回ずつ訪れて 0 に戻る最小コストを返す。",
      "/// 巡回が作れない場合は `None`。",
      "/// 「戻らない最短ハミルトンパス」が欲しい場合は最後の `+ 距離[v][0]` を外し、",
      "/// `dp[全集合][v]` の最小をそのまま使う。",
      "#[allow(clippy::needless_range_loop)]",
      "fn 巡回セールスマン(距離: &[Vec<i64>]) -> Option<i64> {",
      "    let n = 距離.len();",
      "    if n == 0 {",
      "        return Some(0);",
      "    }",
      "    const INF: i64 = i64::MAX / 4;",
      "    let mut dp = vec![vec![INF; n]; 1 << n];",
      "    dp[1][0] = 0;",
      "    for s in 1..(1usize << n) {",
      "        for v in 0..n {",
      "            if dp[s][v] >= INF || s & (1 << v) == 0 {",
      "                continue;",
      "            }",
      "            for u in 0..n {",
      "                if s & (1 << u) != 0 {",
      "                    continue;",
      "                }",
      "                let 次 = s | (1 << u);",
      "                let コスト = dp[s][v] + 距離[v][u];",
      "                if コスト < dp[次][u] {",
      "                    dp[次][u] = コスト;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 全集合 = (1usize << n) - 1;",
      "    let 答え = (0..n)",
      "        .filter(|&v| dp[全集合][v] < INF)",
      "        .map(|v| dp[全集合][v] + 距離[v][0])",
      "        .min()",
      "        .unwrap_or(INF);",
      "    if 答え >= INF {",
      "        None",
      "    } else {",
      "        Some(答え)",
      "    }",
      "}"
    ]
  },
  "TonelliShanks": {
    "scope": "rust",
    "prefix": "TonelliShanks",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `p` を法とする平方根：`x^2 ≡ a (mod p)` を満たす `x` を 1 つ返す（無ければ `None`）。",
      "/// Tonelli-Shanks 法。期待 O(log^2 p)。",
      "/// `p` は**素数**であること。`a` は `mod p` 前で渡してよい。返り値 `x` に対し `p - x` も解。",
      "/// `a ≡ 0` のときは `Some(0)`。平方非剰余なら `None`。`p < 2^31` 程度を想定。",
      "fn modの平方根(a: u64, p: u64) -> Option<u64> {",
      "    let a = a % p;",
      "    if a == 0 {",
      "        return Some(0);",
      "    }",
      "    if p == 2 {",
      "        return Some(a & 1);",
      "    }",
      "    if 累乗_mod(a, (p - 1) / 2, p) != 1 {",
      "        return None;",
      "    }",
      "    if p % 4 == 3 {",
      "        return Some(累乗_mod(a, (p + 1) / 4, p));",
      "    }",
      "    let mut q = p - 1;",
      "    let mut s = 0u32;",
      "    while q % 2 == 0 {",
      "        q /= 2;",
      "        s += 1;",
      "    }",
      "    let mut z = 2u64;",
      "    while 累乗_mod(z, (p - 1) / 2, p) != p - 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = 累乗_mod(z, q, p);",
      "    let mut t = 累乗_mod(a, q, p);",
      "    let mut r = 累乗_mod(a, q.div_ceil(2), p);",
      "    loop {",
      "        if t == 1 {",
      "            return Some(r);",
      "        }",
      "        let mut i = 0u32;",
      "        let mut 暫定 = t;",
      "        while 暫定 != 1 {",
      "            暫定 = 暫定 * 暫定 % p;",
      "            i += 1;",
      "        }",
      "        let b = 累乗_mod(c, 1u64 << (m - i - 1), p);",
      "        m = i;",
      "        c = b * b % p;",
      "        t = t * c % p;",
      "        r = r * b % p;",
      "    }",
      "}"
    ]
  },
  "Treap": {
    "scope": "rust",
    "prefix": "Treap",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 陰的 Treap（implicit treap）。配列を平衡二分木で表し、任意位置への挿入・削除、",
      "/// 区間反転、区間和、一点取得を全て O(log N) で行える。添字をキーに持たず部分木サイズで",
      "/// 位置を決める「陰的キー」方式。",
      "/// - [`Self::挿入`] / [`Self::削除`] : 位置指定の挿入・削除。",
      "/// - [`Self::反転`] : 半開区間 `[l, r)` を反転。",
      "/// - [`Self::区間和`] : 半開区間 `[l, r)` の和。",
      "/// - [`Self::取得`] : 1 要素の値。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "/// 位置ではなく値の大小で並べた集合（k 番目・順位）が欲しいなら",
      "/// [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合) を使う。",
      "struct 陰的Treap<T> {",
      "    値: Vec<T>,",
      "    優先度: Vec<u64>,",
      "    サイズ: Vec<usize>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "    左: Vec<usize>,",
      "    右: Vec<usize>,",
      "    rng: u64,",
      "    根: usize,",
      "}",
      "impl<T> 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn new() -> Self {",
      "        Self {",
      "            値: vec![T::default()],",
      "            優先度: vec![0],",
      "            サイズ: vec![0],",
      "            和: vec![T::default()],",
      "            反転: vec![false],",
      "            左: vec![0],",
      "            右: vec![0],",
      "            rng: 0x9e37_79b9_7f4a_7c15,",
      "            根: 0,",
      "        }",
      "    }",
      "    fn 乱数(&mut self) -> u64 {",
      "        let mut x = self.rng;",
      "        x ^= x << 13;",
      "        x ^= x >> 7;",
      "        x ^= x << 17;",
      "        self.rng = x;",
      "        x",
      "    }",
      "    fn 新規ノード(&mut self, 値: T) -> usize {",
      "        let p = self.乱数();",
      "        self.値.push(値);",
      "        self.優先度.push(p);",
      "        self.サイズ.push(1);",
      "        self.和.push(値);",
      "        self.反転.push(false);",
      "        self.左.push(0);",
      "        self.右.push(0);",
      "        self.値.len() - 1",
      "    }",
      "    /// 子の情報から `t` のサイズと和を再計算する。反転フラグはサイズ・和に影響しない。",
      "    fn 更新(&mut self, t: usize) {",
      "        if t == 0 {",
      "            return;",
      "        }",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.サイズ[t] = 1 + self.サイズ[l] + self.サイズ[r];",
      "        self.和[t] = self.値[t] + self.和[l] + self.和[r];",
      "    }",
      "    /// `t` に溜まった反転遅延を子へ押し下げる。",
      "    fn 伝播(&mut self, t: usize) {",
      "        if t == 0 || !self.反転[t] {",
      "            return;",
      "        }",
      "        self.反転[t] = false;",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.左[t] = r;",
      "        self.右[t] = l;",
      "        if l != 0 {",
      "            self.反転[l] ^= true;",
      "        }",
      "        if r != 0 {",
      "            self.反転[r] ^= true;",
      "        }",
      "    }",
      "    /// `t` を「左 k 要素」と「残り」に分割し、`(左根, 右根)` を返す。",
      "    fn split(&mut self, t: usize, k: usize) -> (usize, usize) {",
      "        if t == 0 {",
      "            return (0, 0);",
      "        }",
      "        self.伝播(t);",
      "        let 左サイズ = self.サイズ[self.左[t]];",
      "        if k <= 左サイズ {",
      "            let (l, r) = self.split(self.左[t], k);",
      "            self.左[t] = r;",
      "            self.更新(t);",
      "            (l, t)",
      "        } else {",
      "            let (l, r) = self.split(self.右[t], k - 左サイズ - 1);",
      "            self.右[t] = l;",
      "            self.更新(t);",
      "            (t, r)",
      "        }",
      "    }",
      "    /// 2 つの木を連結する。`l` の全要素が `r` の前に来る。",
      "    fn merge(&mut self, l: usize, r: usize) -> usize {",
      "        if l == 0 {",
      "            return r;",
      "        }",
      "        if r == 0 {",
      "            return l;",
      "        }",
      "        if self.優先度[l] > self.優先度[r] {",
      "            self.伝播(l);",
      "            let 新右 = self.merge(self.右[l], r);",
      "            self.右[l] = 新右;",
      "            self.更新(l);",
      "            l",
      "        } else {",
      "            self.伝播(r);",
      "            let 新左 = self.merge(l, self.左[r]);",
      "            self.左[r] = 新左;",
      "            self.更新(r);",
      "            r",
      "        }",
      "    }",
      "    /// 末尾に値を追加する。",
      "    fn 末尾追加(&mut self, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        self.根 = self.merge(根, 新);",
      "    }",
      "    /// 位置 `pos`（0-indexed、`pos == 長さ` で末尾）に `値` を挿入する。",
      "    fn 挿入(&mut self, pos: usize, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let 左 = self.merge(l, 新);",
      "        self.根 = self.merge(左, r);",
      "    }",
      "    /// 位置 `pos`（0-indexed）の要素を削除する。",
      "    fn 削除(&mut self, pos: usize) {",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let (_削除, r2) = self.split(r, 1);",
      "        self.根 = self.merge(l, r2);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）を反転する。",
      "    fn 反転(&mut self, 範囲: impl std::ops::RangeBounds<usize>) {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        if b != 0 {",
      "            self.反転[b] ^= true;",
      "        }",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の和。",
      "    fn 区間和(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return T::default();",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        let 結果 = self.和[b];",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "        結果",
      "    }",
      "    /// 位置 `pos`（0-indexed）の値。",
      "    fn 取得(&mut self, pos: usize) -> T {",
      "        self.区間和(pos..pos + 1)",
      "    }",
      "    /// 要素数。",
      "    fn 長さ(&self) -> usize {",
      "        self.サイズ[self.根]",
      "    }",
      "}",
      "impl<T> Default for 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "TreeIsomorphism": {
    "scope": "rust",
    "prefix": "TreeIsomorphism",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "use std::collections::HashMap;",
      "/// 木の同型判定（AHU アルゴリズムによる正準ラベル付け）。子の正準ラベルを整列して",
      "/// 共有辞書で番号付けすることで、衝突のない正準ラベルを与える。構築は木 1 本あたり O(N log N)。",
      "/// 木は `(頂点数, 辺リスト)` で渡す。`辺` は AtCoder の入力そのまま（0-indexed の頂点対）。",
      "/// 同じ [`木の正準化`] インスタンスへ複数の木を渡し、返り値のラベルが等しいかで同型を判定する。",
      "/// ハッシュではなく辞書による完全一致なので誤判定しない。",
      "/// - [`Self::根付きラベル`] : 根を固定した木の正準ラベル。",
      "/// - [`Self::無向ラベル`] : 根を持たない木の正準ラベル（重心で根付ける）。",
      "struct 木の正準化 {",
      "    辞書: HashMap<Vec<u64>, u64>,",
      "    次の番号: u64,",
      "}",
      "impl 木の正準化 {",
      "    fn new() -> Self {",
      "        Self {",
      "            辞書: HashMap::new(),",
      "            次の番号: 0,",
      "        }",
      "    }",
      "    /// 子ラベル列に対応する番号を引く（無ければ採番）。",
      "    fn 登録(&mut self, mut 子ラベル: Vec<u64>) -> u64 {",
      "        子ラベル.sort_unstable();",
      "        if let Some(&id) = self.辞書.get(&子ラベル) {",
      "            return id;",
      "        }",
      "        let id = self.次の番号;",
      "        self.次の番号 += 1;",
      "        self.辞書.insert(子ラベル, id);",
      "        id",
      "    }",
      "    fn 探索(&mut self, グラフ: &[Vec<usize>], now: usize, prev: usize) -> u64 {",
      "        let mut 子ラベル = Vec::new();",
      "        for &next in &グラフ[now] {",
      "            if next != prev {",
      "                子ラベル.push(self.探索(グラフ, next, now));",
      "            }",
      "        }",
      "        self.登録(子ラベル)",
      "    }",
      "    /// 根 `根` を固定した木の正準ラベルを返す。",
      "    fn 根付きラベル(&mut self, n: usize, 辺: &[(usize, usize)], 根: usize) -> u64 {",
      "        self.探索(&無向グラフ(n, 辺), 根, !0)",
      "    }",
      "    /// 根を持たない木の正準ラベル。重心（1 個または 2 個）で根付けたラベルを束ねる。",
      "    fn 無向ラベル(&mut self, n: usize, 辺: &[(usize, usize)]) -> u64 {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let 重心 = 重心列(&グラフ);",
      "        let ラベル: Vec<u64> = 重心.iter().map(|&c| self.探索(&グラフ, c, !0)).collect();",
      "        self.登録(ラベル)",
      "    }",
      "    /// 2 つの根付き木が同型か。",
      "    fn 根付き同型(",
      "        &mut self,",
      "        na: usize,",
      "        辺a: &[(usize, usize)],",
      "        根a: usize,",
      "        nb: usize,",
      "        辺b: &[(usize, usize)],",
      "        根b: usize,",
      "    ) -> bool {",
      "        self.根付きラベル(na, 辺a, 根a) == self.根付きラベル(nb, 辺b, 根b)",
      "    }",
      "    /// 2 つの無向木が同型か。",
      "    fn 無向同型(",
      "        &mut self,",
      "        na: usize,",
      "        辺a: &[(usize, usize)],",
      "        nb: usize,",
      "        辺b: &[(usize, usize)],",
      "    ) -> bool {",
      "        na == nb && self.無向ラベル(na, 辺a) == self.無向ラベル(nb, 辺b)",
      "    }",
      "}",
      "impl Default for 木の正準化 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "/// 木の重心（最大部分木が N/2 以下になる頂点）を求める。1 個または 2 個。",
      "fn 重心列(グラフ: &[Vec<usize>]) -> Vec<usize> {",
      "    let n = グラフ.len();",
      "    let mut sz = vec![0usize; n];",
      "    let mut 重心 = Vec::new();",
      "    fn dfs(",
      "        now: usize,",
      "        prev: usize,",
      "        n: usize,",
      "        グラフ: &[Vec<usize>],",
      "        sz: &mut [usize],",
      "        重心: &mut Vec<usize>,",
      "    ) {",
      "        sz[now] = 1;",
      "        let mut 最大 = 0;",
      "        for &next in &グラフ[now] {",
      "            if next == prev {",
      "                continue;",
      "            }",
      "            dfs(next, now, n, グラフ, sz, 重心);",
      "            sz[now] += sz[next];",
      "            最大 = 最大.max(sz[next]);",
      "        }",
      "        最大 = 最大.max(n - sz[now]);",
      "        if 最大 * 2 <= n {",
      "            重心.push(now);",
      "        }",
      "    }",
      "    dfs(0, !0, n, グラフ, &mut sz, &mut 重心);",
      "    重心",
      "}"
    ]
  },
  "TreeMWIS": {
    "scope": "rust",
    "prefix": "TreeMWIS",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木（または森）の**最大重み独立集合**を求める。隣接する 2 頂点を同時に選べない条件の下で、",
      "/// 選んだ頂点の重み和を最大化する。最大重みと、各頂点を選んだか否かの `Vec<bool>` を返す。`O(N)`。",
      "/// 重みが負の頂点は選ばない方が得になり、空集合（重み 0）も許す。連結でなくてもよい",
      "/// （各連結成分を独立に処理）。再帰しないので深い木でもスタック安全。",
      "/// 一般グラフの最大独立集合は NP 困難（[`max_clique`](crate::max_clique) の補グラフ版）で別物。",
      "/// 木に限れば本関数が線形時間で厳密解を与える。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対）で、頂点数は `重み.len()` から決まる。",
      "/// 重みの型 `T` は順序比較・加算でき、`T::default()` が空集合の重み 0（加法単位元）に",
      "/// なる型なら何でもよい（`i64`・`f64` など）。",
      "fn 木の最大重み独立集合<T>(辺: &[(usize, usize)], 重み: &[T]) -> (T, Vec<bool>)",
      "where",
      "    T: Copy + Ord + Default + std::ops::Add<Output = T> + std::ops::AddAssign,",
      "{",
      "    let n = 重み.len();",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut prev = vec![!0; n];",
      "    let mut 順 = Vec::with_capacity(n);",
      "    let mut 到達済 = vec![false; n];",
      "    for s in 0..n {",
      "        if 到達済[s] {",
      "            continue;",
      "        }",
      "        到達済[s] = true;",
      "        let mut 探索 = std::collections::VecDeque::new();",
      "        探索.push_back(s);",
      "        while let Some(now) = 探索.pop_front() {",
      "            順.push(now);",
      "            for &next in &グラフ[now] {",
      "                if !到達済[next] {",
      "                    到達済[next] = true;",
      "                    prev[next] = now;",
      "                    探索.push_back(next);",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 選ぶ = 重み.to_vec();",
      "    let mut 選ばない = vec![T::default(); n];",
      "    for &v in 順.iter().rev() {",
      "        let p = prev[v];",
      "        if p != !0 {",
      "            選ぶ[p] += 選ばない[v];",
      "            let 子寄与 = 選ぶ[v].max(選ばない[v]);",
      "            選ばない[p] += 子寄与;",
      "        }",
      "    }",
      "    let mut 採用 = vec![false; n];",
      "    let mut 親が採用 = vec![false; n];",
      "    for &v in &順 {",
      "        if 親が採用[v] {",
      "            採用[v] = false;",
      "        } else {",
      "            採用[v] = 選ぶ[v] >= 選ばない[v];",
      "        }",
      "        if 採用[v] {",
      "            for &next in &グラフ[v] {",
      "                if prev[next] == v {",
      "                    親が採用[next] = true;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 合計: T = 採用",
      "        .iter()",
      "        .enumerate()",
      "        .filter(|&(_, &b)| b)",
      "        .fold(T::default(), |acc, (i, _)| acc + 重み[i]);",
      "    (合計, 採用)",
      "}"
    ]
  },
  "TreeMo": {
    "scope": "rust",
    "prefix": "TreeMo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木のパスクエリ（頂点 `u`-`v` 間の単純パス上の集計）を扱う Mo の状態インタフェース。",
      "/// オイラーツアー上の位置を出入りさせると、ある頂点はパス上にあるとき区間内にちょうど 1 回現れる。",
      "/// ランナーがその「出現回数の偶奇」を管理し、パスに入る頂点で [`追加`](木Mo::追加)、",
      "/// 出る頂点で [`削除`](木Mo::削除) を呼ぶ。状態は集合への頂点の出入りだけ実装すればよい。",
      "/// 列に対する素の [`Mo`](crate::mo) とは別技法。",
      "trait 木Mo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 頂点 `頂点` を現在の集合に加える。",
      "    fn 追加(&mut self, 頂点: usize);",
      "    /// 頂点 `頂点` を現在の集合から取り除く。",
      "    fn 削除(&mut self, 頂点: usize);",
      "    /// 現在の集合に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// 木上の Mo 本体。`n` は頂点数、`辺` は AtCoder の入力そのまま（0-indexed の頂点対）、",
      "/// `根` は根、`クエリ` は `(u, v)`（u-v パス）の列。",
      "/// 全体 `O((N + Q)√N · 更新コスト)`。`状態` は空集合の初期状態で渡すこと。",
      "fn 木上mo実行<S: 木Mo>(",
      "    n: usize,",
      "    辺: &[(usize, usize)],",
      "    根: usize,",
      "    クエリ: &[(usize, usize)],",
      "    状態: &mut S,",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    if q == 0 {",
      "        return Vec::new();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut st = vec![0usize; n];",
      "    let mut en = vec![0usize; n];",
      "    let mut 順 = Vec::with_capacity(2 * n);",
      "    let mut depth = vec![0usize; n];",
      "    let mut prev = vec![!0; n];",
      "    let mut 時刻 = 0usize;",
      "    let mut 探索 = vec![根];",
      "    while let Some(now) = 探索.pop() {",
      "        if now >= n {",
      "            let now = !now;",
      "            en[now] = 時刻;",
      "            順.push(now);",
      "            時刻 += 1;",
      "            continue;",
      "        }",
      "        depth[now] = if prev[now] == !0 {",
      "            0",
      "        } else {",
      "            depth[prev[now]] + 1",
      "        };",
      "        st[now] = 時刻;",
      "        順.push(now);",
      "        時刻 += 1;",
      "        探索.push(!now);",
      "        for &next in &グラフ[now] {",
      "            if next != prev[now] {",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let log = (usize::BITS - n.leading_zeros()).max(1) as usize;",
      "    let mut up = vec![vec![!0; n]; log];",
      "    up[0].copy_from_slice(&prev);",
      "    for k in 1..log {",
      "        for v in 0..n {",
      "            let m = up[k - 1][v];",
      "            up[k][v] = if m == !0 { !0 } else { up[k - 1][m] };",
      "        }",
      "    }",
      "    let lca = |mut u: usize, mut v: usize| -> usize {",
      "        if depth[u] < depth[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = depth[u] - depth[v];",
      "        for (k, 上) in up.iter().enumerate() {",
      "            if 差 >> k & 1 == 1 {",
      "                u = 上[u];",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for 上 in up.iter().rev() {",
      "            if 上[u] != 上[v] {",
      "                u = 上[u];",
      "                v = 上[v];",
      "            }",
      "        }",
      "        prev[u]",
      "    };",
      "    let mut 区間: Vec<(usize, usize, Option<usize>, usize)> = Vec::with_capacity(q);",
      "    for (qi, &(mut u, mut v)) in クエリ.iter().enumerate() {",
      "        if st[u] > st[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let l = lca(u, v);",
      "        if l == u {",
      "            区間.push((st[u], st[v] + 1, None, qi));",
      "        } else {",
      "            区間.push((en[u], st[v] + 1, Some(l), qi));",
      "        }",
      "    }",
      "    let b = ((2 * n) as f64).sqrt() as usize + 1;",
      "    区間.sort_by(|x, y| {",
      "        let (bx, by) = (x.0 / b, y.0 / b);",
      "        if bx != by {",
      "            bx.cmp(&by)",
      "        } else if bx % 2 == 0 {",
      "            x.1.cmp(&y.1)",
      "        } else {",
      "            y.1.cmp(&x.1)",
      "        }",
      "    });",
      "    let mut 使用中 = vec![false; n];",
      "    let mut 出力: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let (mut cl, mut cr) = (0usize, 0usize);",
      "    for &(l, r, extra, qi) in &区間 {",
      "        while cr < r {",
      "            let v = 順[cr];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            let v = 順[cl];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            let v = 順[cr];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "        }",
      "        while cl < l {",
      "            let v = 順[cl];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "            cl += 1;",
      "        }",
      "        出力[qi] = Some(match extra {",
      "            Some(w) => {",
      "                状態.追加(w);",
      "                let a = 状態.答え();",
      "                状態.削除(w);",
      "                a",
      "            }",
      "            None => 状態.答え(),",
      "        });",
      "    }",
      "    出力.into_iter().map(|o| o.unwrap()).collect()",
      "}"
    ]
  },
  "TriangleCenters": {
    "scope": "rust",
    "prefix": "TriangleCenters",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 三角形 `a, b, c` の外接円 `(中心, 半径)` を返す。3 点が共線なら `None`。`O(1)`。",
      "/// [`min_enclosing_circle`](crate::min_enclosing_circle) は点群の最小包含円で、外接円とは別。",
      "fn 外接円(a: 点, b: 点, c: 点) -> Option<(点, f64)> {",
      "    let d = 2.0 * (a.0 * (b.1 - c.1) + b.0 * (c.1 - a.1) + c.0 * (a.1 - b.1));",
      "    if d.abs() < 1e-12 {",
      "        return None;",
      "    }",
      "    let a2 = a.0 * a.0 + a.1 * a.1;",
      "    let b2 = b.0 * b.0 + b.1 * b.1;",
      "    let c2 = c.0 * c.0 + c.1 * c.1;",
      "    let ux = (a2 * (b.1 - c.1) + b2 * (c.1 - a.1) + c2 * (a.1 - b.1)) / d;",
      "    let uy = (a2 * (c.0 - b.0) + b2 * (a.0 - c.0) + c2 * (b.0 - a.0)) / d;",
      "    let 中心 = (ux, uy);",
      "    let r = (中心.0 - a.0).hypot(中心.1 - a.1);",
      "    Some((中心, r))",
      "}",
      "/// 三角形 `a, b, c` の内接円 `(中心, 半径)` を返す。退化（周長 0）なら `None`。`O(1)`。",
      "fn 内接円(a: 点, b: 点, c: 点) -> Option<(点, f64)> {",
      "    let la = (b.0 - c.0).hypot(b.1 - c.1);",
      "    let lb = (c.0 - a.0).hypot(c.1 - a.1);",
      "    let lc = (a.0 - b.0).hypot(a.1 - b.1);",
      "    let 周 = la + lb + lc;",
      "    if 周 < 1e-12 {",
      "        return None;",
      "    }",
      "    let cx = (la * a.0 + lb * b.0 + lc * c.0) / 周;",
      "    let cy = (la * a.1 + lb * b.1 + lc * c.1) / 周;",
      "    let 面積 = ((b.0 - a.0) * (c.1 - a.1) - (b.1 - a.1) * (c.0 - a.0)).abs() / 2.0;",
      "    let r = 2.0 * 面積 / 周;",
      "    Some(((cx, cy), r))",
      "}",
      "/// 三角形（任意の 3 点）の重心 `(a + b + c) / 3` を返す。`O(1)`。",
      "fn 重心(a: 点, b: 点, c: 点) -> 点 {",
      "    ((a.0 + b.0 + c.0) / 3.0, (a.1 + b.1 + c.1) / 3.0)",
      "}",
      "/// 三角形 `a, b, c` の垂心（各頂点から対辺への垂線の交点）を返す。共線なら `None`。`O(1)`。",
      "fn 垂心(a: 点, b: 点, c: 点) -> Option<点> {",
      "    let (o, _) = 外接円(a, b, c)?;",
      "    Some((a.0 + b.0 + c.0 - 2.0 * o.0, a.1 + b.1 + c.1 - 2.0 * o.1))",
      "}"
    ]
  },
  "Trie": {
    "scope": "rust",
    "prefix": "Trie",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 英小文字（a–z）用のトライ木。文字列集合への挿入・完全一致検索・",
      "/// 接頭辞を共有する単語数の取得ができる。",
      "/// 各操作の計算量は文字列長に比例。文字種を増やすときは配列幅 26 を変更する。",
      "struct トライ木 {",
      "    /// 各ノードの子（`子[ノード][c]` = 文字 c の子ノード番号）",
      "    子: Vec<[Option<usize>; 26]>,",
      "    /// そのノードを通過する単語数（= そのノードが表す接頭辞を持つ単語数）",
      "    通過数: Vec<usize>,",
      "    /// そのノードで終わる単語数",
      "    終端数: Vec<usize>,",
      "}",
      "impl Default for トライ木 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "impl トライ木 {",
      "    /// 空のトライ木を作る（根ノードのみ）。",
      "    fn new() -> Self {",
      "        Self {",
      "            子: vec![[None; 26]],",
      "            通過数: vec![0],",
      "            終端数: vec![0],",
      "        }",
      "    }",
      "    /// 単語を挿入する。同じ単語の重複挿入も数えられる。",
      "    fn 挿入(&mut self, 単語: &str) {",
      "        let mut 現在 = 0;",
      "        for c in 単語.bytes() {",
      "            let idx = (c - b'a') as usize;",
      "            現在 = match self.子[現在][idx] {",
      "                Some(次) => 次,",
      "                None => {",
      "                    let 新 = self.子.len();",
      "                    self.子.push([None; 26]);",
      "                    self.通過数.push(0);",
      "                    self.終端数.push(0);",
      "                    self.子[現在][idx] = Some(新);",
      "                    新",
      "                }",
      "            };",
      "            self.通過数[現在] += 1;",
      "        }",
      "        self.終端数[現在] += 1;",
      "    }",
      "    /// `単語` がちょうど登録されているか（完全一致）。",
      "    fn 含む(&self, 単語: &str) -> bool {",
      "        matches ! (self . 末尾ノード (単語 ) , Some (n ) if self . 終端数 [n ] > 0 )",
      "    }",
      "    /// `接頭辞` を接頭辞に持つ登録単語の個数（空文字列を渡したときは 0）。",
      "    fn 接頭辞数(&self, 接頭辞: &str) -> usize {",
      "        match self.末尾ノード(接頭辞) {",
      "            Some(n) if n != 0 => self.通過数[n],",
      "            _ => 0,",
      "        }",
      "    }",
      "    /// 文字列 `s` を根からたどった末尾ノード番号。途中で枝が無ければ `None`。",
      "    fn 末尾ノード(&self, s: &str) -> Option<usize> {",
      "        let mut 現在 = 0;",
      "        for c in s.bytes() {",
      "            let idx = (c - b'a') as usize;",
      "            現在 = self.子[現在][idx]?;",
      "        }",
      "        Some(現在)",
      "    }",
      "}"
    ]
  },
  "TwoEdgeConnected": {
    "scope": "rust",
    "prefix": "TwoEdgeConnected",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重辺連結成分分解の結果。`成分[v]` は頂点 `v` の属する二重辺連結成分の番号、`成分数` はその個数。",
      "/// `橋` は橋（取り除くと連結成分が増える辺）の一覧、`木` は成分を頂点とする**橋森**（橋でつないだ森）。",
      "struct 二重辺連結成分 {",
      "    /// 頂点 → 成分番号。",
      "    成分: Vec<usize>,",
      "    /// 成分の個数。",
      "    成分数: usize,",
      "    /// 橋の一覧（`(u, v)`、`u` は DFS 木で親側）。",
      "    橋: Vec<(usize, usize)>,",
      "    /// 橋森。`木[c]` は成分 `c` と橋で隣接する成分の一覧。",
      "    木: Vec<Vec<usize>>,",
      "}",
      "/// 無向グラフを二重辺連結成分（どの 1 辺を取り除いても連結が保たれる極大頂点集合）に分解し、",
      "/// 橋を縮約した**橋森**を返す。`lowlink`（橋・関節点の列挙）とは別で、成分分解と縮約木まで構成する。",
      "/// `辺` は多重辺・自己ループを含んでよい（並行辺は橋にならない／自己ループは無視）。計算量 `O(n + 辺数)`。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "fn 二重辺連結成分分解(n: usize, 辺: &[(usize, usize)]) -> 二重辺連結成分 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut 番号 = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 橋辺 = vec![false; 辺.len()];",
      "    let mut 橋 = Vec::new();",
      "    let mut 時刻 = 0i64;",
      "    for s in 0..n {",
      "        if 番号[s] != -1 {",
      "            continue;",
      "        }",
      "        番号[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if 番号[next] == -1 {",
      "                    番号[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    探索.push((next, eid as i64, 0));",
      "                } else {",
      "                    low[now] = low[now].min(番号[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] > 番号[prev] {",
      "                        橋辺[親辺 as usize] = true;",
      "                        橋.push((prev, now));",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 成分 = vec![!0; n];",
      "    let mut 成分数 = 0;",
      "    for s in 0..n {",
      "        if 成分[s] != !0 {",
      "            continue;",
      "        }",
      "        成分[s] = 成分数;",
      "        let mut 探索 = vec![s];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, eid) in &グラフ[now] {",
      "                if !橋辺[eid] && 成分[next] == !0 {",
      "                    成分[next] = 成分数;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        成分数 += 1;",
      "    }",
      "    let mut 木 = vec![Vec::new(); 成分数];",
      "    for &(a, b) in &橋 {",
      "        let (x, y) = (成分[a], 成分[b]);",
      "        木[x].push(y);",
      "        木[y].push(x);",
      "    }",
      "    二重辺連結成分 {",
      "        成分,",
      "        成分数,",
      "        橋,",
      "        木,",
      "    }",
      "}"
    ]
  },
  "Undo_可能_UnionFind": {
    "scope": "rust",
    "prefix": "Undo_可能_UnionFind",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巻き戻し（Undo）可能な Union-Find。経路圧縮を行わずユニオン by サイズのみで結合し、",
      "/// 各結合の変更を履歴に積むことで任意時点へ `O(操作数)` で復元できる。",
      "/// `ac_library::Dsu` は経路圧縮するため undo できない。オフライン動的連結性",
      "/// （時間方向のセグメント木上の分割統治）などで「結合 → 探索 → 巻き戻し」を繰り返す用途に使う。",
      "/// `根`・`同じ`・`サイズ` は経路圧縮なしの O(log N)。",
      "struct ロールバック可能UnionFind {",
      "    /// 根なら `-(サイズ)`、非根なら親の添字。",
      "    親orサイズ: Vec<i64>,",
      "    /// `(書き換えた添字, 直前の値)` の履歴。1 回の結合で 2 件積む。",
      "    履歴: Vec<(usize, i64)>,",
      "}",
      "impl ロールバック可能UnionFind {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親orサイズ: vec![-1; n],",
      "            履歴: Vec::new(),",
      "        }",
      "    }",
      "    /// `x` の根（経路圧縮なし）。",
      "    fn 根(&self, mut x: usize) -> usize {",
      "        while self.親orサイズ[x] >= 0 {",
      "            x = self.親orサイズ[x] as usize;",
      "        }",
      "        x",
      "    }",
      "    /// `x` と `y` を結合する。既に同じ集合なら `false`（履歴は積まない）。",
      "    fn 統合(&mut self, x: usize, y: usize) -> bool {",
      "        let mut a = self.根(x);",
      "        let mut b = self.根(y);",
      "        if a == b {",
      "            return false;",
      "        }",
      "        if self.親orサイズ[a] > self.親orサイズ[b] {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        self.履歴.push((a, self.親orサイズ[a]));",
      "        self.履歴.push((b, self.親orサイズ[b]));",
      "        self.親orサイズ[a] += self.親orサイズ[b];",
      "        self.親orサイズ[b] = a as i64;",
      "        true",
      "    }",
      "    /// `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "    /// `x` の属する集合の要素数。",
      "    fn サイズ(&self, x: usize) -> usize {",
      "        let r = self.根(x);",
      "        (-self.親orサイズ[r]) as usize",
      "    }",
      "    /// 現在のスナップショット（履歴の長さ）。[`Self::ロールバック`] に渡す。",
      "    fn 現在時点(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    /// 直近の `統合` 1 回ぶんを取り消す（履歴 2 件を巻き戻す）。",
      "    fn 巻き戻し(&mut self) {",
      "        for _ in 0..2 {",
      "            if let Some((i, v)) = self.履歴.pop() {",
      "                self.親orサイズ[i] = v;",
      "            }",
      "        }",
      "    }",
      "    /// [`Self::現在時点`] で得た時点まで状態を巻き戻す。",
      "    fn ロールバック(&mut self, 時点: usize) {",
      "        while self.履歴.len() > 時点 {",
      "            let (i, v) = self.履歴.pop().unwrap();",
      "            self.親orサイズ[i] = v;",
      "        }",
      "    }",
      "}"
    ]
  },
  "VirtualTree": {
    "scope": "rust",
    "prefix": "VirtualTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 仮想木（Auxiliary Tree）。根付き木と頂点集合 `S` が与えられたとき、`S` と「`S` 内 2 頂点の LCA」だけを",
      "/// 残して縮約した木を作る。頂点数 `|S|` に対し O(|S| log |S|) で構築でき、クエリごとの木 DP を高速化する。",
      "/// 二分上昇 LCA を内包する自己完結版。",
      "/// - [`Self::lca`] : 最近共通祖先。",
      "/// - [`Self::構築`] : 頂点集合から仮想木の `(頂点リスト, 辺(親, 子))` を返す。",
      "struct 仮想木 {",
      "    上: Vec<Vec<i64>>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    log: usize,",
      "}",
      "impl 仮想木 {",
      "    /// 頂点数 `n`・辺リスト `辺`（AtCoder の入力そのまま）と根から前計算する。",
      "    fn new(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut log = 1;",
      "        while (1usize << log) < n.max(2) {",
      "            log += 1;",
      "        }",
      "        let mut 上 = vec![vec![-1i64; n]; log];",
      "        let 深さ = vec![0usize; n];",
      "        let 入時刻 = vec![0usize; n];",
      "        let 出時刻 = vec![0usize; n];",
      "        let mut d = 構築データ {",
      "            prev: std::mem::take(&mut 上[0]),",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            時刻: 0,",
      "        };",
      "        探索(根, -1, &グラフ, &mut d);",
      "        上[0] = d.prev;",
      "        let 深さ = d.深さ;",
      "        let 入時刻 = d.入時刻;",
      "        let 出時刻 = d.出時刻;",
      "        for k in 1..log {",
      "            for v in 0..n {",
      "                let 中 = 上[k - 1][v];",
      "                上[k][v] = if 中 < 0 {",
      "                    -1",
      "                } else {",
      "                    上[k - 1][中 as usize]",
      "                };",
      "            }",
      "        }",
      "        Self {",
      "            上,",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            log,",
      "        }",
      "    }",
      "    /// `a` が `b` の祖先か（自身も祖先とみなす）。",
      "    fn 祖先か(&self, a: usize, b: usize) -> bool {",
      "        self.入時刻[a] <= self.入時刻[b] && self.出時刻[b] <= self.出時刻[a]",
      "    }",
      "    /// 最近共通祖先。",
      "    fn lca(&self, mut u: usize, mut v: usize) -> usize {",
      "        if self.深さ[u] < self.深さ[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = self.深さ[u] - self.深さ[v];",
      "        for k in 0..self.log {",
      "            if (差 >> k) & 1 == 1 {",
      "                u = self.上[k][u] as usize;",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for k in (0..self.log).rev() {",
      "            if self.上[k][u] != self.上[k][v] {",
      "                u = self.上[k][u] as usize;",
      "                v = self.上[k][v] as usize;",
      "            }",
      "        }",
      "        self.上[0][u] as usize",
      "    }",
      "    /// 頂点集合から仮想木を構築し、`(頂点リスト, 辺(親, 子))` を返す。",
      "    /// 頂点リストは入時刻順。辺は親が子の祖先になる向き。",
      "    fn 構築(&self, 頂点集合: &[usize]) -> (Vec<usize>, Vec<(usize, usize)>) {",
      "        if 頂点集合.is_empty() {",
      "            return (Vec::new(), Vec::new());",
      "        }",
      "        let mut s = 頂点集合.to_vec();",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 追加 = Vec::new();",
      "        for w in s.windows(2) {",
      "            追加.push(self.lca(w[0], w[1]));",
      "        }",
      "        s.extend(追加);",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 辺 = Vec::new();",
      "        let mut スタック: Vec<usize> = Vec::new();",
      "        for &v in &s {",
      "            while let Some(&天辺) = スタック.last() {",
      "                if self.祖先か(天辺, v) {",
      "                    break;",
      "                }",
      "                スタック.pop();",
      "            }",
      "            if let Some(&天辺) = スタック.last() {",
      "                辺.push((天辺, v));",
      "            }",
      "            スタック.push(v);",
      "        }",
      "        (s, 辺)",
      "    }",
      "}",
      "/// DFS 中に埋める配列をまとめた作業領域（引数を 1 つに減らすため）。",
      "struct 構築データ {",
      "    prev: Vec<i64>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    時刻: usize,",
      "}",
      "/// 入時刻・出時刻・深さ・直接の親を埋める DFS。",
      "fn 探索(now: usize, prev: i64, グラフ: &[Vec<usize>], d: &mut 構築データ) {",
      "    d.prev[now] = prev;",
      "    d.入時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "    for &next in &グラフ[now] {",
      "        if next as i64 != prev {",
      "            d.深さ[next] = d.深さ[now] + 1;",
      "            探索(next, now as i64, グラフ, d);",
      "        }",
      "    }",
      "    d.出時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "}"
    ]
  },
  "WalshHadamard": {
    "scope": "rust",
    "prefix": "WalshHadamard",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 高速ウォルシュ–アダマール変換（in-place）。長さ `2^k` の配列を `O(n log n)` で変換する。",
      "/// 2 回適用すると各要素が `n` 倍になる（自己逆変換）。XOR 畳み込みの土台。",
      "/// 変換途中で負の値が出るため、符号なし整数は不可（i64 / f64 / ModInt などを使う）。",
      "fn アダマール変換<T>(a: &mut [T])",
      "where",
      "    T: Copy + std::ops::Add<Output = T> + std::ops::Sub<Output = T>,",
      "{",
      "    let n = a.len();",
      "    let mut 幅 = 1;",
      "    while 幅 < n {",
      "        let mut i = 0;",
      "        while i < n {",
      "            for j in i..i + 幅 {",
      "                let x = a[j];",
      "                let y = a[j + 幅];",
      "                a[j] = x + y;",
      "                a[j + 幅] = x - y;",
      "            }",
      "            i += 幅 << 1;",
      "        }",
      "        幅 <<= 1;",
      "    }",
      "}",
      "/// XOR 畳み込み。`h[k] = Σ_{i ^ j = k} f[i]·g[j]` を `O(n log n)` で返す（配列長は `2^k`）。",
      "/// ビット XOR をキーにした数え上げ・確率分布の合成に使う。",
      "/// 下位/上位集合ゼータ（[`zeta_mobius`](crate::zeta_mobius)）が AND/OR 畳み込みなのに対し、こちらは XOR。",
      "/// 要素型は i64 / f64 / ModInt など（符号なし整数は不可。ModInt は mod が奇素数なら `n` で割れる）。",
      "fn xor畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy",
      "        + std::ops::Add<Output = T>",
      "        + std::ops::Sub<Output = T>",
      "        + std::ops::MulAssign",
      "        + std::ops::DivAssign",
      "        + From<u32>,",
      "{",
      "    assert_eq!(f.len(), g.len(), \"f と g は同じ長さ\");",
      "    assert!(f.len().is_power_of_two(), \"長さは 2 のべき乗\");",
      "    let n = f.len();",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut a = f.to_vec();",
      "    let mut b = g.to_vec();",
      "    アダマール変換(&mut a);",
      "    アダマール変換(&mut b);",
      "    a.iter_mut().zip(&b).for_each(|(x, y)| *x *= *y);",
      "    アダマール変換(&mut a);",
      "    let 除数 = T::from(n as u32);",
      "    a.iter_mut().for_each(|x| *x /= 除数);",
      "    a",
      "}"
    ]
  },
  "WaveletMatrix": {
    "scope": "rust",
    "prefix": "WaveletMatrix",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// rank 補助付きビットベクトル（ウェーブレット行列の各層）。64 ビットブロック + 累積 popcount。",
      "struct ビットベクトル {",
      "    bits: Vec<u64>,",
      "    累積: Vec<u32>,",
      "}",
      "impl ビットベクトル {",
      "    fn new(n: usize) -> Self {",
      "        let ブロック数 = n / 64 + 1;",
      "        Self {",
      "            bits: vec![0; ブロック数],",
      "            累積: vec![0; ブロック数 + 1],",
      "        }",
      "    }",
      "    fn 立てる(&mut self, i: usize) {",
      "        self.bits[i / 64] |= 1 << (i % 64);",
      "    }",
      "    fn 構築(&mut self) {",
      "        for i in 0..self.bits.len() {",
      "            self.累積[i + 1] = self.累積[i] + self.bits[i].count_ones();",
      "        }",
      "    }",
      "    /// `[0, i)` に含まれる 1 の個数。",
      "    fn rank1(&self, i: usize) -> usize {",
      "        let ブロック = i / 64;",
      "        let 余り = i % 64;",
      "        let マスク = if 余り == 0 {",
      "            0",
      "        } else {",
      "            self.bits[ブロック] & ((1u64 << 余り) - 1)",
      "        };",
      "        self.累積[ブロック] as usize + マスク.count_ones() as usize",
      "    }",
      "    /// `[0, i)` に含まれる 0 の個数。",
      "    fn rank0(&self, i: usize) -> usize {",
      "        i - self.rank1(i)",
      "    }",
      "}",
      "/// ウェーブレット行列。非負整数列に対し「位置区間 `[l, r)` の第 k 小」「位置区間 × 値域の個数」を",
      "/// それぞれ O(ビット長) で答える静的構造。構築 O(N·ビット長)。",
      "/// 位置・値域はいずれも `a..b` / `a..=b` / `..b` / `a..` / `..` を受け取れる（`RangeBounds`）。",
      "/// 値域が広くても座標圧縮なしに `u64` のまま扱える（ビット長は最大値で決まる）。",
      "/// 同種の用途（区間第 k 小・順位）を提供するクレートは AtCoder 標準セットにないため自作する。",
      "struct ウェーブレット行列 {",
      "    n: usize,",
      "    ビット数: usize,",
      "    層: Vec<ビットベクトル>,",
      "    ゼロ数: Vec<usize>,",
      "}",
      "impl ウェーブレット行列 {",
      "    /// 非負整数列から構築する。",
      "    fn new(配列: &[impl TryInto<u64> + Copy]) -> Self {",
      "        let 配列: Vec<u64> = 配列",
      "            .iter()",
      "            .map(|&x| {",
      "                x.try_into()",
      "                    .ok()",
      "                    .expect(\"WaveletMatrix: 引数が u64 に収まりません\")",
      "            })",
      "            .collect();",
      "        let n = 配列.len();",
      "        let 最大 = 配列.iter().copied().max().unwrap_or(0);",
      "        let ビット数 = (64 - 最大.leading_zeros() as usize).max(1);",
      "        let mut 現在 = 配列.to_vec();",
      "        let mut 層 = Vec::with_capacity(ビット数);",
      "        let mut ゼロ数 = Vec::with_capacity(ビット数);",
      "        for b in (0..ビット数).rev() {",
      "            let mut bv = ビットベクトル::new(n);",
      "            for (i, &x) in 現在.iter().enumerate() {",
      "                if x >> b & 1 == 1 {",
      "                    bv.立てる(i);",
      "                }",
      "            }",
      "            bv.構築();",
      "            let mut ゼロ群 = Vec::with_capacity(n);",
      "            let mut 一群 = Vec::new();",
      "            for &x in &現在 {",
      "                if x >> b & 1 == 1 {",
      "                    一群.push(x);",
      "                } else {",
      "                    ゼロ群.push(x);",
      "                }",
      "            }",
      "            ゼロ数.push(ゼロ群.len());",
      "            ゼロ群.extend(一群);",
      "            現在 = ゼロ群;",
      "            層.push(bv);",
      "        }",
      "        Self {",
      "            n,",
      "            ビット数,",
      "            層,",
      "            ゼロ数,",
      "        }",
      "    }",
      "    /// 位置範囲 `位置`（`a..b` / `a..=b` / `..` など）で `k` 番目（0-indexed、昇順）に",
      "    /// 小さい値。`k < 範囲の長さ` であること。",
      "    fn 区間k番目(&self, 位置: impl std::ops::RangeBounds<usize>, mut k: usize) -> usize {",
      "        let (mut l, mut r) = 半開(位置, self.n);",
      "        assert!(l <= r && r <= self.n && k < r - l, \"区間k番目: 範囲外\");",
      "        let mut 結果 = 0u64;",
      "        for d in 0..self.ビット数 {",
      "            let bv = &self.層[d];",
      "            let l0 = bv.rank0(l);",
      "            let r0 = bv.rank0(r);",
      "            let ゼロ個 = r0 - l0;",
      "            if k < ゼロ個 {",
      "                l = l0;",
      "                r = r0;",
      "            } else {",
      "                結果 |= 1 << (self.ビット数 - 1 - d);",
      "                k -= ゼロ個;",
      "                let z = self.ゼロ数[d];",
      "                l = z + (l - l0);",
      "                r = z + (r - r0);",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 位置 `[l, r)` の中で値が `x` 未満である要素の個数（内部プリミティブ）。",
      "    fn 未満数(&self, mut l: usize, mut r: usize, x: u64) -> usize {",
      "        if x >> self.ビット数 != 0 {",
      "            return r - l;",
      "        }",
      "        let mut 個数 = 0usize;",
      "        for d in 0..self.ビット数 {",
      "            let bv = &self.層[d];",
      "            let l0 = bv.rank0(l);",
      "            let r0 = bv.rank0(r);",
      "            if x >> (self.ビット数 - 1 - d) & 1 == 1 {",
      "                個数 += r0 - l0;",
      "                let z = self.ゼロ数[d];",
      "                l = z + (l - l0);",
      "                r = z + (r - r0);",
      "            } else {",
      "                l = l0;",
      "                r = r0;",
      "            }",
      "        }",
      "        個数",
      "    }",
      "    /// 位置範囲 `位置` にある要素のうち、値が `値域` に入るものの個数。",
      "    /// 位置は `a..b` / `a..=b` / `..` など、値域は `a..b` / `a..=b` / `..b`（＝旧「未満の個数」）/",
      "    /// `a..` / `..` などを受け取れる。値域の端点は `i64`・`usize` など `u64` へ変換できる整数型で",
      "    /// よい（負や超過は panic）。",
      "    fn 区間内個数<T: Copy + TryInto<u64>>(",
      "        &self,",
      "        位置: impl std::ops::RangeBounds<usize>,",
      "        値域: impl std::ops::RangeBounds<T>,",
      "    ) -> usize {",
      "        use std::ops::Bound::{Excluded, Included, Unbounded};",
      "        let (l, r) = 半開(位置, self.n);",
      "        assert!(l <= r && r <= self.n, \"区間内個数: 範囲外\");",
      "        let 上限個数 = match 値域.end_bound() {",
      "            Included(&x) => self.未満数(l, r, to_u64(x).saturating_add(1)),",
      "            Excluded(&x) => self.未満数(l, r, to_u64(x)),",
      "            Unbounded => r - l,",
      "        };",
      "        let 下限個数 = match 値域.start_bound() {",
      "            Included(&x) => self.未満数(l, r, to_u64(x)),",
      "            Excluded(&x) => self.未満数(l, r, to_u64(x).saturating_add(1)),",
      "            Unbounded => 0,",
      "        };",
      "        上限個数.saturating_sub(下限個数)",
      "    }",
      "}"
    ]
  },
  "WeightedIntervalScheduling": {
    "scope": "rust",
    "prefix": "WeightedIntervalScheduling",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 重み付き区間スケジューリング。区間 `(開始, 終了, 重み)` から、互いに重ならないように選んだときの",
      "/// 重み和の最大値と、選んだ区間の元の添字を返す。端点の接触（`終了 == 次の開始`）は許す。O(N log N)。",
      "/// 重みなし（個数最大化）なら [`区間スケジューリング`]。重みが付くと貪欲は最適でないので DP になる。",
      "fn 重み付き区間スケジューリング(区間: &[(i64, i64, i64)]) -> (i64, Vec<usize>) {",
      "    let n = 区間.len();",
      "    if n == 0 {",
      "        return (0, Vec::new());",
      "    }",
      "    let mut 並び: Vec<(i64, i64, i64, usize)> = 区間",
      "        .iter()",
      "        .enumerate()",
      "        .map(|(i, &(s, e, w))| (e, s, w, i))",
      "        .collect();",
      "    並び.sort_by_key(|&(e, _, _, _)| e);",
      "    let 終了: Vec<i64> = 並び.iter().map(|&(e, _, _, _)| e).collect();",
      "    let mut dp = vec![0i64; n + 1];",
      "    let mut 取る = vec![false; n + 1];",
      "    let mut 戻り = vec![0usize; n + 1];",
      "    for i in 1..=n {",
      "        let (_, s, w, _) = 並び[i - 1];",
      "        let p = 終了[..i - 1].partition_point(|&e| e <= s);",
      "        let 取った値 = dp[p] + w;",
      "        if 取った値 >= dp[i - 1] {",
      "            dp[i] = 取った値;",
      "            取る[i] = true;",
      "            戻り[i] = p;",
      "        } else {",
      "            dp[i] = dp[i - 1];",
      "        }",
      "    }",
      "    let mut 採用 = Vec::new();",
      "    let mut i = n;",
      "    while i > 0 {",
      "        if 取る[i] {",
      "            採用.push(並び[i - 1].3);",
      "            i = 戻り[i];",
      "        } else {",
      "            i -= 1;",
      "        }",
      "    }",
      "    採用.sort_unstable();",
      "    (dp[n], 採用)",
      "}"
    ]
  },
  "WeightedUnionFind": {
    "scope": "rust",
    "prefix": "WeightedUnionFind",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 重み付き Union-Find（ポテンシャル付き DSU）。",
      "/// 各要素に「根に対する相対的な値（ポテンシャル）」を持たせ、",
      "/// 同じ連結成分に属する2要素 `x`, `y` の差 `weight(y) - weight(x)` を問い合わせできる。",
      "/// 「A は B より d 大きい」といった差分制約の整合性判定・差の計算に使う。",
      "/// 重みの型 `T` は可換群（加法・減算ができ、`T::default()` が単位元 0）であれば",
      "/// 何でもよい（`i64` のほか、`mod` 付き整数の newtype などにも使える）。",
      "struct 重み付きUnionFind<T> {",
      "    親: Vec<usize>,",
      "    rank: Vec<usize>,",
      "    /// 親に対する相対重み",
      "    重み: Vec<T>,",
      "}",
      "impl<T> 重み付きUnionFind<T>",
      "where",
      "    T: Copy",
      "        + Default",
      "        + PartialEq",
      "        + std::ops::AddAssign",
      "        + std::ops::Add<Output = T>",
      "        + std::ops::Sub<Output = T>,",
      "{",
      "    /// `n` 要素（各自が独立、重み 0 = `T::default()`）で初期化する。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親: (0..n).collect(),",
      "            rank: vec![0; n],",
      "            重み: vec![T::default(); n],",
      "        }",
      "    }",
      "    /// `x` の根を返す（経路圧縮しつつ、`重み` を根からの相対値へ更新する）。",
      "    fn 根(&mut self, x: usize) -> usize {",
      "        if self.親[x] == x {",
      "            return x;",
      "        }",
      "        let p = self.親[x];",
      "        let r = self.根(p);",
      "        let p重み = self.重み[p];",
      "        self.重み[x] += p重み;",
      "        self.親[x] = r;",
      "        r",
      "    }",
      "    /// `x` の、自身が属する根に対する相対重み（ポテンシャル）。",
      "    fn ポテンシャル(&mut self, x: usize) -> T {",
      "        self.根(x);",
      "        self.重み[x]",
      "    }",
      "    /// `weight(y) - weight(x) == 差` となるよう `x` と `y` を併合する。",
      "    /// 戻り値:",
      "    /// - 既に別集合 → 併合して `true`",
      "    /// - 既に同集合で、その差が `差` と一致 → 何もせず `true`（無矛盾）",
      "    /// - 既に同集合だが差が矛盾 → 何もせず `false`",
      "    fn 併合(&mut self, x: usize, y: usize, 差: T) -> bool {",
      "        let wx = self.ポテンシャル(x);",
      "        let wy = self.ポテンシャル(y);",
      "        let rx = self.根(x);",
      "        let ry = self.根(y);",
      "        if rx == ry {",
      "            return wy - wx == 差;",
      "        }",
      "        if self.rank[rx] >= self.rank[ry] {",
      "            self.重み[ry] = 差 + wx - wy;",
      "            self.親[ry] = rx;",
      "            if self.rank[rx] == self.rank[ry] {",
      "                self.rank[rx] += 1;",
      "            }",
      "        } else {",
      "            self.重み[rx] = wy - wx - 差;",
      "            self.親[rx] = ry;",
      "        }",
      "        true",
      "    }",
      "    /// `weight(y) - weight(x)` を返す。`x` と `y` が同じ集合でなければ `None`。",
      "    fn 差(&mut self, x: usize, y: usize) -> Option<T> {",
      "        if self.根(x) != self.根(y) {",
      "            None",
      "        } else {",
      "            Some(self.ポテンシャル(y) - self.ポテンシャル(x))",
      "        }",
      "    }",
      "    /// `x` と `y` が同じ連結成分にあるか。",
      "    fn 同じ集合(&mut self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "}"
    ]
  },
  "Welzl": {
    "scope": "rust",
    "prefix": "Welzl",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗（浮動小数）。整数座標版は `geometry` の `距離2乗`。",
      "fn 距離2乗f64(a: (f64, f64), b: (f64, f64)) -> f64 {",
      "    let dx = a.0 - b.0;",
      "    let dy = a.1 - b.1;",
      "    dx * dx + dy * dy",
      "}",
      "/// 2 点の中点。",
      "fn 中点(a: (f64, f64), b: (f64, f64)) -> (f64, f64) {",
      "    ((a.0 + b.0) / 2.0, (a.1 + b.1) / 2.0)",
      "}",
      "/// 3 点を通る円の中心（外心）。3 点が一直線上だと数値的に破綻するので注意。",
      "fn 外心(a: (f64, f64), b: (f64, f64), c: (f64, f64)) -> (f64, f64) {",
      "    let (ax, ay) = a;",
      "    let (bx, by) = b;",
      "    let (cx, cy) = c;",
      "    let d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));",
      "    let a2 = ax * ax + ay * ay;",
      "    let b2 = bx * bx + by * by;",
      "    let c2 = cx * cx + cy * cy;",
      "    let ux = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / d;",
      "    let uy = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / d;",
      "    (ux, uy)",
      "}",
      "/// すべての点を含む最小の円 `(中心x, 中心y, 半径)` を求める（Welzl の漸増法）。期待 O(N)。",
      "/// 点が空なら `None`。",
      "fn 最小包含円(点群: &[(f64, f64)]) -> Option<(f64, f64, f64)> {",
      "    const イプシロン: f64 = 1e-12;",
      "    if 点群.is_empty() {",
      "        return None;",
      "    }",
      "    let mut p = 点群.to_vec();",
      "    let mut seed = 0x1234_5678u64;",
      "    let mut 乱数 = || {",
      "        seed = seed",
      "            .wrapping_mul(6364136223846793005)",
      "            .wrapping_add(1442695040888963407);",
      "        seed >> 33",
      "    };",
      "    for i in (1..p.len()).rev() {",
      "        let j = (乱数() as usize) % (i + 1);",
      "        p.swap(i, j);",
      "    }",
      "    let mut 中心 = p[0];",
      "    let mut 半径2 = 0.0f64;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for i in 1..p.len() {",
      "        if 距離2乗f64(中心, p[i]) <= 半径2 + イプシロン {",
      "            continue;",
      "        }",
      "        中心 = p[i];",
      "        半径2 = 0.0;",
      "        for j in 0..i {",
      "            if 距離2乗f64(中心, p[j]) <= 半径2 + イプシロン {",
      "                continue;",
      "            }",
      "            中心 = 中点(p[i], p[j]);",
      "            半径2 = 距離2乗f64(中心, p[i]);",
      "            for k in 0..j {",
      "                if 距離2乗f64(中心, p[k]) <= 半径2 + イプシロン {",
      "                    continue;",
      "                }",
      "                中心 = 外心(p[i], p[j], p[k]);",
      "                半径2 = 距離2乗f64(中心, p[i]);",
      "            }",
      "        }",
      "    }",
      "    Some((中心.0, 中心.1, 半径2.sqrt()))",
      "}"
    ]
  },
  "XOR_トライ": {
    "scope": "rust",
    "prefix": "XOR_トライ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// 二進トライ（binary trie）。非負整数の多重集合を二進表現の木で管理し、挿入・削除・",
      "/// 「指定値 `x` との XOR の最大／最小」「k 番目に小さい値」「`x` 以下の個数」などを各 `O(ビット数)` で行う。",
      "/// `xor_basis`（線形基底）は「部分集合の XOR で作れる最大値」を扱うのに対し、こちらは",
      "/// **格納済み要素そのもの**との XOR 最適化や順位クエリを行う別物。",
      "/// `挿入` した値の上位 `ビット数` ビットのみを見るので、扱う値域に合わせて `ビット数` を決める。",
      "/// XOR を使わず k 番目・順位だけが目的なら [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合)",
      "/// を使う（負の値や整数以外も載り、メモリも軽く速い）。",
      "struct 二進トライ {",
      "    ビット数: usize,",
      "    子: Vec<[Option<usize>; 2]>,",
      "    通過数: Vec<usize>,",
      "}",
      "impl 二進トライ {",
      "    /// `ビット数` ビット幅（`0..2^ビット数` の値）の空トライを作る。",
      "    fn new(ビット数: usize) -> Self {",
      "        Self {",
      "            ビット数,",
      "            子: vec![[None, None]],",
      "            通過数: vec![0],",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個追加する。",
      "    fn 挿入(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] += 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = match self.子[v][ビット] {",
      "                Some(次) => 次,",
      "                None => {",
      "                    let 新 = self.子.len();",
      "                    self.子.push([None, None]);",
      "                    self.通過数.push(0);",
      "                    self.子[v][ビット] = Some(新);",
      "                    新",
      "                }",
      "            };",
      "            self.通過数[v] += 1;",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個削除する（存在する前提）。木構造は保持し、通過数のみ減らす。",
      "    fn 削除(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] -= 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = self.子[v][ビット].unwrap();",
      "            self.通過数[v] -= 1;",
      "        }",
      "    }",
      "    /// 格納されている要素の総数。",
      "    fn 個数(&self) -> usize {",
      "        self.通過数[0]",
      "    }",
      "    /// 値 `x` が格納されている個数。",
      "    fn 含む個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 0,",
      "            }",
      "        }",
      "        self.通過数[v]",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最大化する `x ^ y` を返す（空でないこと）。",
      "    fn 最大xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            let 望み = ビット ^ 1;",
      "            match self.子[v][望み] {",
      "                Some(c) if self.通過数[c] > 0 => {",
      "                    結果 |= 1 << b;",
      "                    v = c;",
      "                }",
      "                _ => v = self.子[v][ビット].unwrap(),",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最小化する `x ^ y` を返す（空でないこと）。",
      "    fn 最小xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => {",
      "                    結果 |= 1 << b;",
      "                    v = self.子[v][ビット ^ 1].unwrap();",
      "                }",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 0 始まりで `k` 番目に小さい値を返す（多重度込み、`0 <= k < 個数`）。",
      "    fn k番目(&self, mut k: usize) -> usize {",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let c0 = self.子[v][0];",
      "            let 左 = c0.map_or(0, |c| self.通過数[c]);",
      "            if k < 左 {",
      "                v = c0.unwrap();",
      "            } else {",
      "                k -= 左;",
      "                結果 |= 1 << b;",
      "                v = self.子[v][1].unwrap();",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// `x` 以下の格納要素の個数（多重度込み）。",
      "    fn 以下の個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 個数 = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            if ビット == 1 {",
      "                if let Some(c0) = self.子[v][0] {",
      "                    個数 += self.通過数[c0];",
      "                }",
      "            }",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 個数,",
      "            }",
      "        }",
      "        個数 + self.通過数[v]",
      "    }",
      "}"
    ]
  },
  "XOR_基底": {
    "scope": "rust",
    "prefix": "XOR_基底",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// XOR の線形基底。非負整数の集合に対し、その部分集合の XOR で作れる値全体を",
      "/// 少数の基底ベクトルで表す。最大 XOR・ある値が作れるかの判定・作れる値の個数に使える。",
      "/// 追加・判定は基底の次元（最大 60 程度）に比例。",
      "struct 線形基底 {",
      "    基底: Vec<u64>,",
      "}",
      "impl Default for 線形基底 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "impl 線形基底 {",
      "    /// 空の基底を作る。",
      "    fn new() -> Self {",
      "        Self { 基底: Vec::new() }",
      "    }",
      "    /// 値 `x` を追加する。基底の次元が増えたら `true`、既存基底で表現可能なら `false`。",
      "    fn 追加(&mut self, x: impl TryInto<u64>) -> bool {",
      "        let mut x = to_u64(x);",
      "        for &b in &self.基底 {",
      "            let t = x ^ b;",
      "            if t < x {",
      "                x = t;",
      "            }",
      "        }",
      "        if x == 0 {",
      "            return false;",
      "        }",
      "        self.基底.push(x);",
      "        let mut i = self.基底.len() - 1;",
      "        while i > 0 && self.基底[i] > self.基底[i - 1] {",
      "            self.基底.swap(i, i - 1);",
      "            i -= 1;",
      "        }",
      "        true",
      "    }",
      "    /// 部分集合 XOR で作れる最大値。",
      "    fn 最大値(&self) -> usize {",
      "        let mut res = 0u64;",
      "        for &b in &self.基底 {",
      "            res = res.max(res ^ b);",
      "        }",
      "        res as usize",
      "    }",
      "    /// `x` が部分集合 XOR で作れるか。",
      "    fn 表現可能(&self, x: impl TryInto<u64>) -> bool {",
      "        let mut x = to_u64(x);",
      "        for &b in &self.基底 {",
      "            let t = x ^ b;",
      "            if t < x {",
      "                x = t;",
      "            }",
      "        }",
      "        x == 0",
      "    }",
      "    /// 基底の次元。作れる相異なる値は `2^次元` 通り。",
      "    fn 次元(&self) -> usize {",
      "        self.基底.len()",
      "    }",
      "}"
    ]
  },
  "XOR_連立_方程式": {
    "scope": "rust",
    "prefix": "XOR_連立_方程式",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// GF(2) 上の連立一次方程式 `A x = b` を掃き出し（ガウス消去）で解く。O(式数 · 変数数)。",
      "/// 変数は `0..変数数`（`変数数 <= 63`）。各式は `(係数ビット集合, 右辺)` で表し、",
      "/// 係数ビット集合の `k` ビット目が立っていれば変数 `x_k` を含む。右辺は 0/1。",
      "/// 解が無ければ `None`。`Some(解)` は解の一つ（自由変数は 0 とおく）。",
      "/// 実数の連立方程式は `nalgebra` を使うこと。これは XOR（mod 2）専用。",
      "fn xor連立方程式(変数数: usize, 式: &[(u64, u8)]) -> Option<Vec<u8>> {",
      "    let 右辺ビット = 1u64 << 変数数;",
      "    let mut 行: Vec<u64> = 式",
      "        .iter()",
      "        .map(|&(係数, b)| 係数 | ((b as u64 & 1) << 変数数))",
      "        .collect();",
      "    let mut ピボット行 = vec![!0; 変数数];",
      "    let mut 行位置 = 0usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for 列 in 0..変数数 {",
      "        let Some(選択) = (行位置..行.len()).find(|&r| 行[r] >> 列 & 1 == 1) else {",
      "            continue;",
      "        };",
      "        行.swap(行位置, 選択);",
      "        let 基準 = 行[行位置];",
      "        for (r, row) in 行.iter_mut().enumerate() {",
      "            if r != 行位置 && *row >> 列 & 1 == 1 {",
      "                *row ^= 基準;",
      "            }",
      "        }",
      "        ピボット行[列] = 行位置;",
      "        行位置 += 1;",
      "    }",
      "    if 行[行位置..].contains(&右辺ビット) {",
      "        return None;",
      "    }",
      "    let mut 解 = vec![0u8; 変数数];",
      "    for (列, &pr) in ピボット行.iter().enumerate() {",
      "        if pr != !0 {",
      "            解[列] = ((行[pr] >> 変数数) & 1) as u8;",
      "        }",
      "    }",
      "    Some(解)",
      "}"
    ]
  },
  "XorConvolution": {
    "scope": "rust",
    "prefix": "XorConvolution",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 高速ウォルシュ–アダマール変換（in-place）。長さ `2^k` の配列を `O(n log n)` で変換する。",
      "/// 2 回適用すると各要素が `n` 倍になる（自己逆変換）。XOR 畳み込みの土台。",
      "/// 変換途中で負の値が出るため、符号なし整数は不可（i64 / f64 / ModInt などを使う）。",
      "fn アダマール変換<T>(a: &mut [T])",
      "where",
      "    T: Copy + std::ops::Add<Output = T> + std::ops::Sub<Output = T>,",
      "{",
      "    let n = a.len();",
      "    let mut 幅 = 1;",
      "    while 幅 < n {",
      "        let mut i = 0;",
      "        while i < n {",
      "            for j in i..i + 幅 {",
      "                let x = a[j];",
      "                let y = a[j + 幅];",
      "                a[j] = x + y;",
      "                a[j + 幅] = x - y;",
      "            }",
      "            i += 幅 << 1;",
      "        }",
      "        幅 <<= 1;",
      "    }",
      "}",
      "/// XOR 畳み込み。`h[k] = Σ_{i ^ j = k} f[i]·g[j]` を `O(n log n)` で返す（配列長は `2^k`）。",
      "/// ビット XOR をキーにした数え上げ・確率分布の合成に使う。",
      "/// 下位/上位集合ゼータ（[`zeta_mobius`](crate::zeta_mobius)）が AND/OR 畳み込みなのに対し、こちらは XOR。",
      "/// 要素型は i64 / f64 / ModInt など（符号なし整数は不可。ModInt は mod が奇素数なら `n` で割れる）。",
      "fn xor畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy",
      "        + std::ops::Add<Output = T>",
      "        + std::ops::Sub<Output = T>",
      "        + std::ops::MulAssign",
      "        + std::ops::DivAssign",
      "        + From<u32>,",
      "{",
      "    assert_eq!(f.len(), g.len(), \"f と g は同じ長さ\");",
      "    assert!(f.len().is_power_of_two(), \"長さは 2 のべき乗\");",
      "    let n = f.len();",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut a = f.to_vec();",
      "    let mut b = g.to_vec();",
      "    アダマール変換(&mut a);",
      "    アダマール変換(&mut b);",
      "    a.iter_mut().zip(&b).for_each(|(x, y)| *x *= *y);",
      "    アダマール変換(&mut a);",
      "    let 除数 = T::from(n as u32);",
      "    a.iter_mut().for_each(|x| *x /= 除数);",
      "    a",
      "}"
    ]
  },
  "binary_search": {
    "scope": "rust",
    "prefix": "binary_search",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "trait RangeSearch<T> {",
      "    /// 述語が最初に false になる要素の、範囲の先頭からの添字を返す（`slice::partition_point` と同じ）。",
      "    /// 全 true なら範囲の長さ、全 false と空範囲なら 0。",
      "    fn partition_point(&self, pred: impl FnMut(T) -> bool) -> usize;",
      "    /// `cmp` が `Less→Equal→Greater` の順に並ぶ前提で `Equal` の半開区間を、範囲の先頭からの添字で返す。",
      "    /// 例: `(0..n).equal_range(|i| a[i].cmp(&target))`",
      "    fn equal_range(&self, cmp: impl FnMut(T) -> std::cmp::Ordering) -> std::ops::Range<usize>;",
      "}",
      "impl<T> RangeSearch<T> for std::ops::Range<T>",
      "where",
      "    T: Copy",
      "        + Ord",
      "        + std::ops::Add<Output = T>",
      "        + std::ops::Sub<Output = T>",
      "        + std::ops::Shr<u32, Output = T>",
      "        + TryInto<usize>,",
      "{",
      "    fn partition_point(&self, mut pred: impl FnMut(T) -> bool) -> usize {",
      "        let start = self.start;",
      "        let end = self.end.max(start);",
      "        if start == end || !pred(start) {",
      "            return 0;",
      "        }",
      "        let (mut left, mut right) = (start, end);",
      "        loop {",
      "            let mid = left + ((right - left) >> 1);",
      "            if mid == left {",
      "                break;",
      "            }",
      "            if pred(mid) {",
      "                left = mid;",
      "            } else {",
      "                right = mid;",
      "            }",
      "        }",
      "        (right - start)",
      "            .try_into()",
      "            .ok()",
      "            .expect(\"partition_point: 範囲の長さが usize に収まりません\")",
      "    }",
      "    fn equal_range(&self, mut cmp: impl FnMut(T) -> std::cmp::Ordering) -> std::ops::Range<usize> {",
      "        use std::cmp::Ordering::{Greater, Less};",
      "        let lower = self.partition_point(|x| cmp(x) == Less);",
      "        let upper = self.partition_point(|x| cmp(x) != Greater);",
      "        lower..upper",
      "    }",
      "}"
    ]
  },
  "bipartite": {
    "scope": "rust",
    "prefix": "bipartite",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向グラフを2色に塗り分ける（二部グラフ判定）。O(V+E)。",
      "/// `グラフ[u]` は隣接頂点の列。塗り分けられたら各頂点の色（`false` / `true`）を返し、",
      "/// 奇閉路（自己ループを含む）があれば `None`。非連結でもよく、連結成分ごとに",
      "/// 「その成分の最小番号の頂点を `false`」として独立に塗る。",
      "/// `petgraph::algo::is_bipartite_undirected` は「始点の連結成分が二部か」の `bool` だけで、",
      "/// 塗り分けそのものは得られない。「白側の頂点を列挙」「白と黒の個数を比べる」型の問題には",
      "/// こちらが要る。辺が後から増えていくオンライン形なら",
      "/// [`crate::weighted_union_find`] を mod 2 のポテンシャルで使う方が向く。",
      "fn 二部彩色(グラフ: &[Vec<usize>]) -> Option<Vec<bool>> {",
      "    use std::collections::VecDeque;",
      "    let n = グラフ.len();",
      "    let mut 色: Vec<Option<bool>> = vec![None; n];",
      "    let mut 探索 = VecDeque::new();",
      "    for 始点 in 0..n {",
      "        if 色[始点].is_some() {",
      "            continue;",
      "        }",
      "        色[始点] = Some(false);",
      "        探索.push_back(始点);",
      "        while let Some(now) = 探索.pop_front() {",
      "            let c = 色[now].unwrap();",
      "            for &next in &グラフ[now] {",
      "                match 色[next] {",
      "                    None => {",
      "                        色[next] = Some(!c);",
      "                        探索.push_back(next);",
      "                    }",
      "                    Some(隣) if 隣 == c => return None,",
      "                    Some(_) => {}",
      "                }",
      "            }",
      "        }",
      "    }",
      "    Some(色.into_iter().map(|c| c.unwrap()).collect())",
      "}"
    ]
  },
  "bitDP": {
    "scope": "rust",
    "prefix": "bitDP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巡回セールスマン問題（TSP）をビット DP で解く。O(2^N · N^2)。N は 18 程度まで。",
      "/// `距離[i][j]` は i→j のコスト（有向。到達不可は十分大きい値を入れる）。",
      "/// 頂点 0 を始点に全頂点をちょうど 1 回ずつ訪れて 0 に戻る最小コストを返す。",
      "/// 巡回が作れない場合は `None`。",
      "/// 「戻らない最短ハミルトンパス」が欲しい場合は最後の `+ 距離[v][0]` を外し、",
      "/// `dp[全集合][v]` の最小をそのまま使う。",
      "#[allow(clippy::needless_range_loop)]",
      "fn 巡回セールスマン(距離: &[Vec<i64>]) -> Option<i64> {",
      "    let n = 距離.len();",
      "    if n == 0 {",
      "        return Some(0);",
      "    }",
      "    const INF: i64 = i64::MAX / 4;",
      "    let mut dp = vec![vec![INF; n]; 1 << n];",
      "    dp[1][0] = 0;",
      "    for s in 1..(1usize << n) {",
      "        for v in 0..n {",
      "            if dp[s][v] >= INF || s & (1 << v) == 0 {",
      "                continue;",
      "            }",
      "            for u in 0..n {",
      "                if s & (1 << u) != 0 {",
      "                    continue;",
      "                }",
      "                let 次 = s | (1 << u);",
      "                let コスト = dp[s][v] + 距離[v][u];",
      "                if コスト < dp[次][u] {",
      "                    dp[次][u] = コスト;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 全集合 = (1usize << n) - 1;",
      "    let 答え = (0..n)",
      "        .filter(|&v| dp[全集合][v] < INF)",
      "        .map(|v| dp[全集合][v] + 距離[v][0])",
      "        .min()",
      "        .unwrap_or(INF);",
      "    if 答え >= INF {",
      "        None",
      "    } else {",
      "        Some(答え)",
      "    }",
      "}"
    ]
  },
  "ccw": {
    "scope": "rust",
    "prefix": "ccw",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}"
    ]
  },
  "centroid": {
    "scope": "rust",
    "prefix": "centroid",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木の重心を求める（再帰なし）。重心とは、その頂点を取り除いたとき残る",
      "/// 各連結成分の最大サイズが `n/2` 以下になる頂点。木の重心は 1 個か 2 個ある。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対）。戻り値は重心の頂点番号（昇順、長さ 1 か 2）。",
      "/// 重心を分割の基準に使うと、各部分木サイズが半分以下に抑えられる（重心分解の核）。",
      "/// 離心数最小の「中心」は別物で [`木の中心`](crate::tree_diameter::木の中心) を使う。",
      "fn 木の重心(n: usize, 辺: &[(usize, usize)]) -> Vec<usize> {",
      "    if n <= 1 {",
      "        return (0..n).collect();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut prev = vec![!0; n];",
      "    let mut 順 = Vec::with_capacity(n);",
      "    let mut 到達済 = vec![false; n];",
      "    let mut 探索 = vec![0usize];",
      "    到達済[0] = true;",
      "    while let Some(now) = 探索.pop() {",
      "        順.push(now);",
      "        for &next in &グラフ[now] {",
      "            if !到達済[next] {",
      "                到達済[next] = true;",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let mut sz = vec![1usize; n];",
      "    for &now in 順.iter().rev() {",
      "        if prev[now] != !0 {",
      "            sz[prev[now]] += sz[now];",
      "        }",
      "    }",
      "    let mut 重心 = Vec::new();",
      "    for now in 0..n {",
      "        let mut 最大成分 = n - sz[now];",
      "        for &next in &グラフ[now] {",
      "            if prev[next] == now {",
      "                最大成分 = 最大成分.max(sz[next]);",
      "            }",
      "        }",
      "        if 最大成分 <= n / 2 {",
      "            重心.push(now);",
      "        }",
      "    }",
      "    重心",
      "}"
    ]
  },
  "convex_hull": {
    "scope": "rust",
    "prefix": "convex_hull",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "/// 凸包（Andrew's monotone chain）。与えた点集合をすべて含む最小の凸多角形の",
      "/// 頂点を、反時計回りの順で返す。O(N log N)。",
      "/// 一直線上に並ぶ中間点（凸包の辺上の点）は頂点に含めない。",
      "/// 点が2個以下のときは重複を除いた入力をそのまま返す。",
      "fn 凸包(点群: &[(i64, i64)]) -> Vec<(i64, i64)> {",
      "    let mut 点 = 点群.to_vec();",
      "    点.sort();",
      "    点.dedup();",
      "    let n = 点.len();",
      "    if n <= 2 {",
      "        return 点;",
      "    }",
      "    let mut 下側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in &点 {",
      "        while 下側.len() >= 2 && 外積3点(下側[下側.len() - 2], 下側[下側.len() - 1], p) <= 0",
      "        {",
      "            下側.pop();",
      "        }",
      "        下側.push(p);",
      "    }",
      "    let mut 上側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in 点.iter().rev() {",
      "        while 上側.len() >= 2 && 外積3点(上側[上側.len() - 2], 上側[上側.len() - 1], p) <= 0",
      "        {",
      "            上側.pop();",
      "        }",
      "        上側.push(p);",
      "    }",
      "    下側.pop();",
      "    上側.pop();",
      "    下側.extend(上側);",
      "    下側",
      "}"
    ]
  },
  "dfs": {
    "scope": "rust",
    "prefix": "dfs",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn dfs(グラフ: &[Vec<usize>], 到達済: &mut [bool], now: usize) {",
      "    到達済[now] = true;",
      "    for &next in &グラフ[now] {",
      "        if 到達済[next] {",
      "            continue;",
