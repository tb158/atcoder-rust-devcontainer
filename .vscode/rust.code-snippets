  "完全_単調": {
    "scope": "rust",
    "prefix": "完全_単調",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// REDUCE 操作: どの行の最小にもなり得ない列を取り除き、残す列数を行数以下にする内部関数。",
      "fn 列削減<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行: &[usize],",
      "    列: &[usize],",
      "    コスト: &F,",
      ") -> Vec<usize> {",
      "    let mut 残す: Vec<usize> = Vec::new();",
      "    for &c in 列 {",
      "        while let Some(&上) = 残す.last() {",
      "            let k = 残す.len() - 1;",
      "            if k < 行.len() && コスト(行[k], 上) > コスト(行[k], c) {",
      "                残す.pop();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        if 残す.len() < 行.len() {",
      "            残す.push(c);",
      "        }",
      "    }",
      "    残す",
      "}",
      "/// SMAWK 本体（再帰）。偶数位置の行は奇数位置の行の答えで挟み込んで線形に解く。",
      "fn 解く<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行: &[usize],",
      "    列: &[usize],",
      "    コスト: &F,",
      "    答え: &mut [usize],",
      ") {",
      "    if 行.is_empty() {",
      "        return;",
      "    }",
      "    let 列 = 列削減(行, 列, コスト);",
      "    let 奇: Vec<usize> = 行.iter().skip(1).step_by(2).copied().collect();",
      "    解く(&奇, &列, コスト, 答え);",
      "    let mut j = 0;",
      "    let mut pos = 0;",
      "    while pos < 行.len() {",
      "        let r = 行[pos];",
      "        let 終列 = if pos + 1 < 行.len() {",
      "            答え[行[pos + 1]]",
      "        } else {",
      "            *列.last().unwrap()",
      "        };",
      "        let mut 最良 = 列[j];",
      "        while 列[j] != 終列 {",
      "            j += 1;",
      "            if コスト(r, 列[j]) < コスト(r, 最良) {",
      "                最良 = 列[j];",
      "            }",
      "        }",
      "        答え[r] = 最良;",
      "        pos += 2;",
      "    }",
      "}",
      "/// SMAWK 法。完全単調（totally monotone, Monge を含む）な `行数 × 列数` 行列について、",
      "/// 各行の最小値をとる列番号を `O(行数 + 列数)` で求める。`コスト(i, j)` で要素を遅延参照する。",
      "/// 行列が完全単調（任意の `i<i'`, `j<j'` で `A[i][j]>A[i][j']` ⇒ `A[i'][j]>A[i'][j']`）であることが前提。",
      "/// 分割統治の単調最小値（[`divide_and_conquer_dp`](crate::divide_and_conquer_dp)、`O(n log n)`）より",
      "/// 高速。最近点・DP 高速化などで使う。",
      "/// 返り値 `argmin[i]` は行 `i` の最小値をとる列（同点は最左）。`列数 == 0` のときは空でない行に `0` が入る。",
      "/// コストの型は比較できれば何でもよい（i64 / f64 など）。",
      "fn 行ごとの最小列<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行数: usize,",
      "    列数: usize,",
      "    コスト: F,",
      ") -> Vec<usize> {",
      "    let mut 答え = vec![0usize; 行数];",
      "    if 行数 == 0 || 列数 == 0 {",
      "        return 答え;",
      "    }",
      "    let 行: Vec<usize> = (0..行数).collect();",
      "    let 列: Vec<usize> = (0..列数).collect();",
      "    解く(&行, &列, &コスト, &mut 答え);",
      "    答え",
      "}"
    ]
  },
  "完全_永続_UnionFind": {
    "scope": "rust",
    "prefix": "完全_永続_UnionFind",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 永続配列のノード。`子` は左右の子ノード添字（葉では未使用）、`値` は葉のときの格納値。",
      "struct ノード {",
      "    子: [usize; 2],",
      "    値: i64,",
      "}",
      "/// 完全永続 Union-Find。任意の過去バージョンを起点に結合でき、各バージョンの連結状態を保持・参照できる。",
      "/// 1 回の結合・1 回の根探索は O(log^2 N)。",
      "/// [`crate::rollback_union_find`] は最新版を巻き戻すだけだが、こちらは任意バージョンへ分岐できる。",
      "/// - [`Self::統合`] : 指定バージョンに辺を足した**新バージョン番号**を返す。",
      "/// - [`Self::同じ`] : 指定バージョンでの連結判定。",
      "struct 永続UnionFind {",
      "    n: usize,",
      "    ノード列: Vec<ノード>,",
      "    版: Vec<usize>,",
      "}",
      "impl 永続UnionFind {",
      "    /// 要素数 `n` で初期化する。全要素が孤立したバージョン 0 が作られる。",
      "    fn new(n: usize) -> Self {",
      "        let mut s = Self {",
      "            n,",
      "            ノード列: Vec::new(),",
      "            版: Vec::new(),",
      "        };",
      "        let 根 = s.構築(0, n.max(1));",
      "        s.版.push(根);",
      "        s",
      "    }",
      "    /// 区間 `[l, r)` の永続配列を全値 `-1`（サイズ 1 の根）で構築し、根ノード添字を返す。",
      "    fn 構築(&mut self, l: usize, r: usize) -> usize {",
      "        if r - l == 1 {",
      "            return self.葉(-1);",
      "        }",
      "        let m = (l + r) / 2;",
      "        let c0 = self.構築(l, m);",
      "        let c1 = self.構築(m, r);",
      "        self.内部(c0, c1)",
      "    }",
      "    fn 葉(&mut self, v: i64) -> usize {",
      "        let id = self.ノード列.len();",
      "        self.ノード列.push(ノード {",
      "            子: [!0; 2], 値: v",
      "        });",
      "        id",
      "    }",
      "    fn 内部(&mut self, c0: usize, c1: usize) -> usize {",
      "        let id = self.ノード列.len();",
      "        self.ノード列.push(ノード {",
      "            子: [c0, c1],",
      "            値: 0,",
      "        });",
      "        id",
      "    }",
      "    /// バージョン根 `根` の永続配列で添字 `i` の値を読む。",
      "    fn 取得(&self, 根: usize, mut l: usize, mut r: usize, i: usize) -> i64 {",
      "        let mut node = 根;",
      "        while r - l > 1 {",
      "            let m = (l + r) / 2;",
      "            if i < m {",
      "                node = self.ノード列[node].子[0];",
      "                r = m;",
      "            } else {",
      "                node = self.ノード列[node].子[1];",
      "                l = m;",
      "            }",
      "        }",
      "        self.ノード列[node].値",
      "    }",
      "    /// 永続的に添字 `i` を値 `v` に書き換え、新しい根ノード添字を返す。",
      "    fn 書込(&mut self, 根: usize, l: usize, r: usize, i: usize, v: i64) -> usize {",
      "        if r - l == 1 {",
      "            return self.葉(v);",
      "        }",
      "        let m = (l + r) / 2;",
      "        let c0 = self.ノード列[根].子[0];",
      "        let c1 = self.ノード列[根].子[1];",
      "        if i < m {",
      "            let 新 = self.書込(c0, l, m, i, v);",
      "            self.内部(新, c1)",
      "        } else {",
      "            let 新 = self.書込(c1, m, r, i, v);",
      "            self.内部(c0, 新)",
      "        }",
      "    }",
      "    /// バージョン `版番号` での `x` の根。",
      "    fn 根(&self, 版番号: usize, x: usize) -> usize {",
      "        let 根 = self.版[版番号];",
      "        let mut x = x;",
      "        loop {",
      "            let v = self.取得(根, 0, self.n.max(1), x);",
      "            if v < 0 {",
      "                return x;",
      "            }",
      "            x = v as usize;",
      "        }",
      "    }",
      "    /// バージョン `版番号` での `x` の属する集合のサイズ。",
      "    fn サイズ(&self, 版番号: usize, x: usize) -> usize {",
      "        let r = self.根(版番号, x);",
      "        let 根 = self.版[版番号];",
      "        (-self.取得(根, 0, self.n.max(1), r)) as usize",
      "    }",
      "    /// バージョン `版番号` で `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, 版番号: usize, x: usize, y: usize) -> bool {",
      "        self.根(版番号, x) == self.根(版番号, y)",
      "    }",
      "    /// バージョン `版番号` に辺 `x - y` を足し、結果の新しいバージョン番号を返す。",
      "    /// 既に同じ集合でも新バージョン（同一内容）を作る。",
      "    fn 統合(&mut self, 版番号: usize, x: usize, y: usize) -> usize {",
      "        let mut a = self.根(版番号, x);",
      "        let mut b = self.根(版番号, y);",
      "        let 根 = self.版[版番号];",
      "        if a == b {",
      "            self.版.push(根);",
      "            return self.版.len() - 1;",
      "        }",
      "        let n = self.n.max(1);",
      "        let sa = -self.取得(根, 0, n, a);",
      "        let sb = -self.取得(根, 0, n, b);",
      "        if sa < sb {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        let 合計 = sa + sb;",
      "        let r1 = self.書込(根, 0, n, b, a as i64);",
      "        let r2 = self.書込(r1, 0, n, a, -合計);",
      "        self.版.push(r2);",
      "        self.版.len() - 1",
      "    }",
      "    /// 現在のバージョン数。",
      "    fn 版数(&self) -> usize {",
      "        self.版.len()",
      "    }",
      "}"
    ]
  },
