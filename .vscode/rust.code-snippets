  "二円の_交差_面積": {
    "scope": "rust",
    "prefix": "二円の_交差_面積",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円（中心 `c1` 半径 `r1`、中心 `c2` 半径 `r2`）が重なる部分の面積を返す。`O(1)`。",
      "/// 離れていれば `0`、一方が他方を含めば小さい円の面積。",
      "/// [`円と円の交点`](crate::circle_intersection::円と円の交点) は交点座標で、こちらは面積。",
      "fn 二円の交差面積(c1: 点, r1: f64, c2: 点, r2: f64) -> f64 {",
      "    let d = (c1.0 - c2.0).hypot(c1.1 - c2.1);",
      "    if d >= r1 + r2 {",
      "        return 0.0;",
      "    }",
      "    if d <= (r1 - r2).abs() {",
      "        let r = r1.min(r2);",
      "        return std::f64::consts::PI * r * r;",
      "    }",
      "    let a1 = ((d * d + r1 * r1 - r2 * r2) / (2.0 * d * r1))",
      "        .clamp(-1.0, 1.0)",
      "        .acos();",
      "    let a2 = ((d * d + r2 * r2 - r1 * r1) / (2.0 * d * r2))",
      "        .clamp(-1.0, 1.0)",
      "        .acos();",
      "    let 三角 = 0.5",
      "        * ((-d + r1 + r2) * (d + r1 - r2) * (d - r1 + r2) * (d + r1 + r2))",
      "            .max(0.0)",
      "            .sqrt();",
      "    r1 * r1 * a1 + r2 * r2 * a2 - 三角",
      "}"
    ]
  },
  "二次元_BIT": {
    "scope": "rust",
    "prefix": "二次元_BIT",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 二次元 BIT（Binary Indexed Tree / Fenwick 木）。",
      "/// 1点加算と「矩形領域の和」を、どちらも O(log H · log W) で行える。",
      "/// 静的な二次元累積和と違い、値の更新が混ざるクエリに使える。",
      "/// 要素型 `T` は加減算できる型なら何でもよく（`i64`・`u64`・`f64` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "struct 二次元BIT<T> {",
      "    高さ: usize,",
      "    幅: usize,",
      "    data: Vec<Vec<T>>,",
      "}",
      "impl<T> 二次元BIT<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::Add<Output = T> + std::ops::Sub<Output = T>,",
      "{",
      "    /// `高さ × 幅` の全要素 0（`T::default()`）で初期化する。",
      "    fn new(高さ: usize, 幅: usize) -> Self {",
      "        Self {",
      "            高さ,",
      "            幅,",
      "            data: vec![vec![T::default(); 幅 + 1]; 高さ + 1],",
      "        }",
      "    }",
      "    /// マス `(r, c)`（0-indexed）に `値` を加算する。",
      "    fn 加算(&mut self, r: usize, c: usize, 値: T) {",
      "        let mut i = r + 1;",
      "        while i <= self.高さ {",
      "            let mut j = c + 1;",
      "            while j <= self.幅 {",
      "                self.data[i][j] += 値;",
      "                j += j & j.wrapping_neg();",
      "            }",
      "            i += i & i.wrapping_neg();",
      "        }",
      "    }",
      "    /// 左上から `[0, r) × [0, c)` の矩形和。",
      "    fn 接頭和(&self, r: usize, c: usize) -> T {",
      "        let mut 和 = T::default();",
      "        let mut i = r;",
      "        while i > 0 {",
      "            let mut j = c;",
      "            while j > 0 {",
      "                和 += self.data[i][j];",
      "                j -= j & j.wrapping_neg();",
      "            }",
      "            i -= i & i.wrapping_neg();",
      "        }",
      "        和",
      "    }",
      "    /// 行範囲 × 列範囲（各 `a..b` / `a..=b` / `..` など）の矩形領域の和。",
      "    fn 区間和(",
      "        &self,",
      "        行範囲: impl std::ops::RangeBounds<usize>,",
      "        列範囲: impl std::ops::RangeBounds<usize>,",
      "    ) -> T {",
      "        let (r1, r2) = 半開(行範囲, self.高さ);",
      "        let (c1, c2) = 半開(列範囲, self.幅);",
      "        self.接頭和(r2, c2) + self.接頭和(r1, c1) - self.接頭和(r1, c2) - self.接頭和(r2, c1)",
      "    }",
      "}"
    ]
