  "永続_DSU": {
    "scope": "rust",
    "prefix": "永続_DSU",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 永続配列のノード。`子` は左右の子ノード添字（葉では未使用）、`値` は葉のときの格納値。",
      "struct ノード {",
      "    子: [usize; 2],",
      "    値: i64,",
      "}",
      "/// 完全永続 Union-Find。任意の過去バージョンを起点に結合でき、各バージョンの連結状態を保持・参照できる。",
      "/// 1 回の結合・1 回の根探索は O(log^2 N)。",
      "/// [`crate::rollback_union_find`] は最新版を巻き戻すだけだが、こちらは任意バージョンへ分岐できる。",
      "/// - [`Self::統合`] : 指定バージョンに辺を足した**新バージョン番号**を返す。",
      "/// - [`Self::同じ`] : 指定バージョンでの連結判定。",
      "struct 永続UnionFind {",
      "    n: usize,",
      "    ノード列: Vec<ノード>,",
      "    版: Vec<usize>,",
      "}",
      "impl 永続UnionFind {",
      "    /// 要素数 `n` で初期化する。全要素が孤立したバージョン 0 が作られる。",
      "    fn new(n: usize) -> Self {",
      "        let mut s = Self {",
      "            n,",
      "            ノード列: Vec::new(),",
      "            版: Vec::new(),",
      "        };",
      "        let 根 = s.構築(0, n.max(1));",
      "        s.版.push(根);",
      "        s",
      "    }",
      "    /// 区間 `[l, r)` の永続配列を全値 `-1`（サイズ 1 の根）で構築し、根ノード添字を返す。",
      "    fn 構築(&mut self, l: usize, r: usize) -> usize {",
      "        if r - l == 1 {",
      "            return self.葉(-1);",
      "        }",
      "        let m = (l + r) / 2;",
      "        let c0 = self.構築(l, m);",
      "        let c1 = self.構築(m, r);",
      "        self.内部(c0, c1)",
      "    }",
      "    fn 葉(&mut self, v: i64) -> usize {",
      "        let id = self.ノード列.len();",
      "        self.ノード列.push(ノード {",
      "            子: [!0; 2], 値: v",
      "        });",
      "        id",
      "    }",
      "    fn 内部(&mut self, c0: usize, c1: usize) -> usize {",
      "        let id = self.ノード列.len();",
      "        self.ノード列.push(ノード {",
      "            子: [c0, c1],",
      "            値: 0,",
      "        });",
      "        id",
      "    }",
      "    /// バージョン根 `根` の永続配列で添字 `i` の値を読む。",
      "    fn 取得(&self, 根: usize, mut l: usize, mut r: usize, i: usize) -> i64 {",
      "        let mut node = 根;",
      "        while r - l > 1 {",
      "            let m = (l + r) / 2;",
      "            if i < m {",
      "                node = self.ノード列[node].子[0];",
      "                r = m;",
      "            } else {",
      "                node = self.ノード列[node].子[1];",
      "                l = m;",
      "            }",
      "        }",
      "        self.ノード列[node].値",
      "    }",
      "    /// 永続的に添字 `i` を値 `v` に書き換え、新しい根ノード添字を返す。",
      "    fn 書込(&mut self, 根: usize, l: usize, r: usize, i: usize, v: i64) -> usize {",
      "        if r - l == 1 {",
      "            return self.葉(v);",
      "        }",
      "        let m = (l + r) / 2;",
      "        let c0 = self.ノード列[根].子[0];",
      "        let c1 = self.ノード列[根].子[1];",
      "        if i < m {",
      "            let 新 = self.書込(c0, l, m, i, v);",
      "            self.内部(新, c1)",
      "        } else {",
      "            let 新 = self.書込(c1, m, r, i, v);",
      "            self.内部(c0, 新)",
      "        }",
      "    }",
      "    /// バージョン `版番号` での `x` の根。",
      "    fn 根(&self, 版番号: usize, x: usize) -> usize {",
      "        let 根 = self.版[版番号];",
      "        let mut x = x;",
      "        loop {",
      "            let v = self.取得(根, 0, self.n.max(1), x);",
      "            if v < 0 {",
      "                return x;",
      "            }",
      "            x = v as usize;",
      "        }",
      "    }",
      "    /// バージョン `版番号` での `x` の属する集合のサイズ。",
      "    fn サイズ(&self, 版番号: usize, x: usize) -> usize {",
      "        let r = self.根(版番号, x);",
      "        let 根 = self.版[版番号];",
      "        (-self.取得(根, 0, self.n.max(1), r)) as usize",
      "    }",
      "    /// バージョン `版番号` で `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, 版番号: usize, x: usize, y: usize) -> bool {",
      "        self.根(版番号, x) == self.根(版番号, y)",
      "    }",
      "    /// バージョン `版番号` に辺 `x - y` を足し、結果の新しいバージョン番号を返す。",
      "    /// 既に同じ集合でも新バージョン（同一内容）を作る。",
      "    fn 統合(&mut self, 版番号: usize, x: usize, y: usize) -> usize {",
      "        let mut a = self.根(版番号, x);",
      "        let mut b = self.根(版番号, y);",
      "        let 根 = self.版[版番号];",
      "        if a == b {",
      "            self.版.push(根);",
      "            return self.版.len() - 1;",
      "        }",
      "        let n = self.n.max(1);",
      "        let sa = -self.取得(根, 0, n, a);",
      "        let sb = -self.取得(根, 0, n, b);",
      "        if sa < sb {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        let 合計 = sa + sb;",
      "        let r1 = self.書込(根, 0, n, b, a as i64);",
      "        let r2 = self.書込(r1, 0, n, a, -合計);",
      "        self.版.push(r2);",
      "        self.版.len() - 1",
      "    }",
      "    /// 現在のバージョン数。",
      "    fn 版数(&self) -> usize {",
      "        self.版.len()",
      "    }",
      "}"
    ]
  },
  "永続_UnionFind": {
    "scope": "rust",
    "prefix": "永続_UnionFind",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 永続配列のノード。`子` は左右の子ノード添字（葉では未使用）、`値` は葉のときの格納値。",
      "struct ノード {",
      "    子: [usize; 2],",
      "    値: i64,",
      "}",
      "/// 完全永続 Union-Find。任意の過去バージョンを起点に結合でき、各バージョンの連結状態を保持・参照できる。",
      "/// 1 回の結合・1 回の根探索は O(log^2 N)。",
      "/// [`crate::rollback_union_find`] は最新版を巻き戻すだけだが、こちらは任意バージョンへ分岐できる。",
      "/// - [`Self::統合`] : 指定バージョンに辺を足した**新バージョン番号**を返す。",
      "/// - [`Self::同じ`] : 指定バージョンでの連結判定。",
      "struct 永続UnionFind {",
      "    n: usize,",
      "    ノード列: Vec<ノード>,",
      "    版: Vec<usize>,",
      "}",
      "impl 永続UnionFind {",
      "    /// 要素数 `n` で初期化する。全要素が孤立したバージョン 0 が作られる。",
      "    fn new(n: usize) -> Self {",
      "        let mut s = Self {",
      "            n,",
      "            ノード列: Vec::new(),",
      "            版: Vec::new(),",
      "        };",
      "        let 根 = s.構築(0, n.max(1));",
      "        s.版.push(根);",
      "        s",
      "    }",
      "    /// 区間 `[l, r)` の永続配列を全値 `-1`（サイズ 1 の根）で構築し、根ノード添字を返す。",
      "    fn 構築(&mut self, l: usize, r: usize) -> usize {",
      "        if r - l == 1 {",
      "            return self.葉(-1);",
      "        }",
      "        let m = (l + r) / 2;",
      "        let c0 = self.構築(l, m);",
      "        let c1 = self.構築(m, r);",
      "        self.内部(c0, c1)",
      "    }",
      "    fn 葉(&mut self, v: i64) -> usize {",
      "        let id = self.ノード列.len();",
      "        self.ノード列.push(ノード {",
      "            子: [!0; 2], 値: v",
      "        });",
      "        id",
      "    }",
      "    fn 内部(&mut self, c0: usize, c1: usize) -> usize {",
      "        let id = self.ノード列.len();",
      "        self.ノード列.push(ノード {",
      "            子: [c0, c1],",
      "            値: 0,",
      "        });",
      "        id",
      "    }",
      "    /// バージョン根 `根` の永続配列で添字 `i` の値を読む。",
      "    fn 取得(&self, 根: usize, mut l: usize, mut r: usize, i: usize) -> i64 {",
      "        let mut node = 根;",
      "        while r - l > 1 {",
      "            let m = (l + r) / 2;",
      "            if i < m {",
      "                node = self.ノード列[node].子[0];",
      "                r = m;",
      "            } else {",
      "                node = self.ノード列[node].子[1];",
      "                l = m;",
      "            }",
      "        }",
      "        self.ノード列[node].値",
      "    }",
      "    /// 永続的に添字 `i` を値 `v` に書き換え、新しい根ノード添字を返す。",
      "    fn 書込(&mut self, 根: usize, l: usize, r: usize, i: usize, v: i64) -> usize {",
      "        if r - l == 1 {",
      "            return self.葉(v);",
      "        }",
      "        let m = (l + r) / 2;",
      "        let c0 = self.ノード列[根].子[0];",
      "        let c1 = self.ノード列[根].子[1];",
      "        if i < m {",
      "            let 新 = self.書込(c0, l, m, i, v);",
      "            self.内部(新, c1)",
      "        } else {",
      "            let 新 = self.書込(c1, m, r, i, v);",
      "            self.内部(c0, 新)",
      "        }",
      "    }",
      "    /// バージョン `版番号` での `x` の根。",
      "    fn 根(&self, 版番号: usize, x: usize) -> usize {",
      "        let 根 = self.版[版番号];",
      "        let mut x = x;",
      "        loop {",
      "            let v = self.取得(根, 0, self.n.max(1), x);",
      "            if v < 0 {",
      "                return x;",
      "            }",
      "            x = v as usize;",
      "        }",
      "    }",
      "    /// バージョン `版番号` での `x` の属する集合のサイズ。",
      "    fn サイズ(&self, 版番号: usize, x: usize) -> usize {",
      "        let r = self.根(版番号, x);",
      "        let 根 = self.版[版番号];",
      "        (-self.取得(根, 0, self.n.max(1), r)) as usize",
      "    }",
      "    /// バージョン `版番号` で `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, 版番号: usize, x: usize, y: usize) -> bool {",
      "        self.根(版番号, x) == self.根(版番号, y)",
      "    }",
      "    /// バージョン `版番号` に辺 `x - y` を足し、結果の新しいバージョン番号を返す。",
      "    /// 既に同じ集合でも新バージョン（同一内容）を作る。",
      "    fn 統合(&mut self, 版番号: usize, x: usize, y: usize) -> usize {",
      "        let mut a = self.根(版番号, x);",
      "        let mut b = self.根(版番号, y);",
      "        let 根 = self.版[版番号];",
      "        if a == b {",
      "            self.版.push(根);",
      "            return self.版.len() - 1;",
      "        }",
      "        let n = self.n.max(1);",
      "        let sa = -self.取得(根, 0, n, a);",
      "        let sb = -self.取得(根, 0, n, b);",
      "        if sa < sb {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        let 合計 = sa + sb;",
      "        let r1 = self.書込(根, 0, n, b, a as i64);",
      "        let r2 = self.書込(r1, 0, n, a, -合計);",
      "        self.版.push(r2);",
      "        self.版.len() - 1",
      "    }",
      "    /// 現在のバージョン数。",
      "    fn 版数(&self) -> usize {",
      "        self.版.len()",
      "    }",
      "}"
    ]
  },
  "永続_セグメント_木": {
    "scope": "rust",
    "prefix": "永続_セグメント_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 永続セグメント木（区間和・一点加算）。各更新は元の版を壊さず新しい根を返すため、",
      "/// 任意の過去の版に対してクエリできる。更新・クエリともに O(log N)、版ごとに O(log N) のノード。",
      "/// 配列を 1 要素ずつ更新した版列を作れば「区間第 k 小」等の典型に使える",
      "/// （単純な静的列の区間第 k 小なら [`crate::wavelet_matrix`] が手軽）。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "struct 永続セグ木<T> {",
      "    n: usize,",
      "    和: Vec<T>,",
      "    左: Vec<usize>,",
      "    右: Vec<usize>,",
      "}",
      "impl<T> 永続セグ木<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    /// サイズ `n` の全 0 の木を作り、`(構造体, 初期版の根)` を返す。",
      "    fn new(n: usize) -> (Self, usize) {",
      "        let mut t = Self {",
      "            n,",
      "            和: vec![T::default()],",
      "            左: vec![0],",
      "            右: vec![0],",
      "        };",
      "        let 根 = t.構築(0, n.max(1));",
      "        (t, 根)",
      "    }",
      "    fn 節点追加(&mut self, 和: T, 左: usize, 右: usize) -> usize {",
      "        let id = self.和.len();",
      "        self.和.push(和);",
      "        self.左.push(左);",
      "        self.右.push(右);",
      "        id",
      "    }",
      "    fn 構築(&mut self, lo: usize, hi: usize) -> usize {",
      "        if hi - lo <= 1 {",
      "            return self.節点追加(T::default(), 0, 0);",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        let l = self.構築(lo, m);",
      "        let r = self.構築(m, hi);",
      "        self.節点追加(T::default(), l, r)",
      "    }",
      "    /// 版 `根` の位置 `pos` に `値` を加え、新しい版の根を返す。元の版は不変。",
      "    fn 一点加算(&mut self, 根: usize, pos: usize, 値: T) -> usize {",
      "        let n = self.n.max(1);",
      "        self.更新(根, 0, n, pos, 値)",
      "    }",
      "    fn 更新(&mut self, 節: usize, lo: usize, hi: usize, pos: usize, 値: T) -> usize {",
      "        if hi - lo <= 1 {",
      "            return self.節点追加(self.和[節] + 値, 0, 0);",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        if pos < m {",
      "            let nl = self.更新(self.左[節], lo, m, pos, 値);",
      "            self.節点追加(self.和[節] + 値, nl, self.右[節])",
      "        } else {",
      "            let nr = self.更新(self.右[節], m, hi, pos, 値);",
      "            self.節点追加(self.和[節] + 値, self.左[節], nr)",
      "        }",
      "    }",
      "    /// 版 `根` における区間（`a..b` / `a..=b` / `..` など）の和。",
      "    fn 区間和(&self, 根: usize, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.和取得(根, 0, self.n.max(1), l, r)",
      "    }",
      "    fn 和取得(&self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> T {",
      "        if r <= lo || hi <= l {",
      "            return T::default();",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.和[節];",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        self.和取得(self.左[節], lo, m, l, r) + self.和取得(self.右[節], m, hi, l, r)",
      "    }",
      "}"
    ]
  },
