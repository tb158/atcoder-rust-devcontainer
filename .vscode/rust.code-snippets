    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// 二進トライ（binary trie）。非負整数の多重集合を二進表現の木で管理し、挿入・削除・",
      "/// 「指定値 `x` との XOR の最大／最小」「k 番目に小さい値」「`x` 以下の個数」などを各 `O(ビット数)` で行う。",
      "/// `xor_basis`（線形基底）は「部分集合の XOR で作れる最大値」を扱うのに対し、こちらは",
      "/// **格納済み要素そのもの**との XOR 最適化や順位クエリを行う別物。",
      "/// `挿入` した値の上位 `ビット数` ビットのみを見るので、扱う値域に合わせて `ビット数` を決める。",
      "/// XOR を使わず k 番目・順位だけが目的なら [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合)",
      "/// を使う（負の値や整数以外も載り、メモリも軽く速い）。",
      "struct 二進トライ {",
      "    ビット数: usize,",
      "    子: Vec<[Option<usize>; 2]>,",
      "    通過数: Vec<usize>,",
      "}",
      "impl 二進トライ {",
      "    /// `ビット数` ビット幅（`0..2^ビット数` の値）の空トライを作る。",
      "    fn new(ビット数: usize) -> Self {",
      "        Self {",
      "            ビット数,",
      "            子: vec![[None, None]],",
      "            通過数: vec![0],",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個追加する。",
      "    fn 挿入(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] += 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = match self.子[v][ビット] {",
      "                Some(次) => 次,",
      "                None => {",
      "                    let 新 = self.子.len();",
      "                    self.子.push([None, None]);",
      "                    self.通過数.push(0);",
      "                    self.子[v][ビット] = Some(新);",
      "                    新",
      "                }",
      "            };",
      "            self.通過数[v] += 1;",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個削除する（存在する前提）。木構造は保持し、通過数のみ減らす。",
      "    fn 削除(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] -= 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = self.子[v][ビット].unwrap();",
      "            self.通過数[v] -= 1;",
      "        }",
      "    }",
      "    /// 格納されている要素の総数。",
      "    fn 個数(&self) -> usize {",
      "        self.通過数[0]",
      "    }",
      "    /// 値 `x` が格納されている個数。",
      "    fn 含む個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 0,",
      "            }",
      "        }",
      "        self.通過数[v]",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最大化する `x ^ y` を返す（空でないこと）。",
      "    fn 最大xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            let 望み = ビット ^ 1;",
      "            match self.子[v][望み] {",
      "                Some(c) if self.通過数[c] > 0 => {",
      "                    結果 |= 1 << b;",
      "                    v = c;",
      "                }",
      "                _ => v = self.子[v][ビット].unwrap(),",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最小化する `x ^ y` を返す（空でないこと）。",
      "    fn 最小xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => {",
      "                    結果 |= 1 << b;",
      "                    v = self.子[v][ビット ^ 1].unwrap();",
      "                }",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 0 始まりで `k` 番目に小さい値を返す（多重度込み、`0 <= k < 個数`）。",
      "    fn k番目(&self, mut k: usize) -> usize {",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let c0 = self.子[v][0];",
      "            let 左 = c0.map_or(0, |c| self.通過数[c]);",
      "            if k < 左 {",
      "                v = c0.unwrap();",
      "            } else {",
      "                k -= 左;",
      "                結果 |= 1 << b;",
      "                v = self.子[v][1].unwrap();",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// `x` 以下の格納要素の個数（多重度込み）。",
      "    fn 以下の個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 個数 = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            if ビット == 1 {",
      "                if let Some(c0) = self.子[v][0] {",
      "                    個数 += self.通過数[c0];",
      "                }",
      "            }",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 個数,",
      "            }",
      "        }",
      "        個数 + self.通過数[v]",
      "    }",
      "}"
    ]
  },
  "最大_クリーク": {
    "scope": "rust",
    "prefix": "最大_クリーク",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最大クリーク（完全部分グラフ）を Bron–Kerbosch 法（ピボット付き）で求める。頂点数 `n <= 64`。",
      "/// ビットマスクで近傍を持ち、実用的には数十頂点まで高速（最悪 O(3^{n/3})）。",
      "/// [`Self::最大独立集合`] は補グラフの最大クリークとして同じ実装で求まる。",
      "struct 最大クリーク探索 {",
      "    n: usize,",
      "    グラフ: Vec<u64>,",
      "}",
      "impl 最大クリーク探索 {",
      "    /// 頂点数 `n`（`<= 64`）の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        assert!(n <= 64, \"n must be <= 64\");",
      "        Self {",
      "            n,",
      "            グラフ: vec![0u64; n],",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        if u != v {",
      "            self.グラフ[u] |= 1 << v;",
      "            self.グラフ[v] |= 1 << u;",
      "        }",
      "    }",
      "    /// 最大クリークの頂点集合を返す。",
      "    fn 最大クリーク(&self) -> Vec<usize> {",
      "        let 全 = if self.n == 64 {",
      "            u64::MAX",
      "        } else {",
      "            (1u64 << self.n) - 1",
      "        };",
      "        let mut 最良 = 0u64;",
      "        self.探索(0, 全, 0, &mut 最良);",
      "        ビット列(最良)",
      "    }",
      "    /// 最大独立集合の頂点集合を返す（補グラフの最大クリーク）。",
      "    fn 最大独立集合(&self) -> Vec<usize> {",
      "        let 全 = if self.n == 64 {",
      "            u64::MAX",
      "        } else {",
      "            (1u64 << self.n) - 1",
      "        };",
      "        let mut 補 = 最大クリーク探索::new(self.n);",
      "        for v in 0..self.n {",
      "            補.グラフ[v] = !self.グラフ[v] & 全 & !(1u64 << v);",
      "        }",
      "        let mut 最良 = 0u64;",
      "        補.探索(0, 全, 0, &mut 最良);",
      "        ビット列(最良)",
      "    }",
      "    /// Bron–Kerbosch（ピボット付き）。`r` 現在のクリーク、`p` 候補、`x` 除外済み。",
      "    fn 探索(&self, r: u64, p: u64, x: u64, 最良: &mut u64) {",
      "        if p == 0 && x == 0 {",
      "            if r.count_ones() > 最良.count_ones() {",
      "                *最良 = r;",
      "            }",
      "            return;",
      "        }",
      "        if r.count_ones() + p.count_ones() <= 最良.count_ones() {",
      "            return;",
      "        }",
      "        let mut ピボット候補 = p | x;",
      "        let mut ピボット = 0usize;",
      "        let mut 最多 = -1i64;",
      "        while ピボット候補 != 0 {",
      "            let v = ピボット候補.trailing_zeros() as usize;",
      "            ピボット候補 &= ピボット候補 - 1;",
      "            let c = (p & self.グラフ[v]).count_ones() as i64;",
      "            if c > 最多 {",
      "                最多 = c;",
      "                ピボット = v;",
      "            }",
      "        }",
      "        let mut 候補 = p & !self.グラフ[ピボット];",
      "        let mut p = p;",
      "        let mut x = x;",
      "        while 候補 != 0 {",
      "            let v = 候補.trailing_zeros() as usize;",
      "            let ビット = 1u64 << v;",
      "            候補 &= 候補 - 1;",
      "            self.探索(r | ビット, p & self.グラフ[v], x & self.グラフ[v], 最良);",
      "            p &= !ビット;",
      "            x |= ビット;",
      "        }",
      "    }",
      "}",
      "/// ビットマスクを立っている添字の昇順 `Vec` に変換する。",
      "fn ビット列(mut m: u64) -> Vec<usize> {",
      "    let mut v = Vec::new();",
      "    while m != 0 {",
      "        v.push(m.trailing_zeros() as usize);",
      "        m &= m - 1;",
      "    }",
      "    v",
      "}"
    ]
  },
  "最大_二部_マッチング": {
    "scope": "rust",
    "prefix": "最大_二部_マッチング",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::VecDeque;",
      "/// Hopcroft-Karp 法による二部グラフの最大マッチング。O(E√V)。",
      "/// `ac_library::MaxFlow` でも最大二部マッチングは解けるが、こちらは二部マッチング専用で",
      "/// E√V と高速。`pathfinding::kuhn_munkres` は重み付き割当専用なので、",
      "/// 単純な最大本数マッチングにはこちらを使う。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に対応も保持）。",
      "/// - [`Self::マッチング`] : マッチした `(左, 右)` の組を返す。",
      "struct ホップクロフトカープ {",
      "    左数: usize,",
      "    グラフ: Vec<Vec<usize>>,",
      "    左相手: Vec<i64>,",
      "    右相手: Vec<i64>,",
      "    距離: Vec<i64>,",
      "}",
      "impl ホップクロフトカープ {",
      "    /// 左頂点 `左数` 個・右頂点 `右数` 個の二部グラフを作る。",
      "    fn new(左数: usize, 右数: usize) -> Self {",
      "        Self {",
      "            左数,",
      "            グラフ: vec![Vec::new(); 左数],",
      "            左相手: vec![-1; 左数],",
      "            右相手: vec![-1; 右数],",
      "            距離: vec![-1; 左数],",
      "        }",
      "    }",
      "    /// 左頂点 `u` と右頂点 `v` を結ぶ辺を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.グラフ[u].push(v);",
      "    }",
      "    /// 未マッチ左頂点から BFS して層（距離）を作る。増加道が存在すれば true。",
      "    fn bfs(&mut self) -> bool {",
      "        let mut 探索 = VecDeque::new();",
      "        for u in 0..self.左数 {",
      "            if self.左相手[u] < 0 {",
      "                self.距離[u] = 0;",
      "                探索.push_back(u);",
      "            } else {",
      "                self.距離[u] = -1;",
      "            }",
      "        }",
      "        let mut 増加道あり = false;",
      "        while let Some(u) = 探索.pop_front() {",
      "            for i in 0..self.グラフ[u].len() {",
      "                let v = self.グラフ[u][i];",
      "                let w = self.右相手[v];",
      "                if w < 0 {",
      "                    増加道あり = true;",
      "                } else {",
      "                    let w = w as usize;",
      "                    if self.距離[w] < 0 {",
      "                        self.距離[w] = self.距離[u] + 1;",
      "                        探索.push_back(w);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        増加道あり",
      "    }",
      "    /// 層に沿って `u` から増加道を探し、見つかれば反転して true。",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn dfs(&mut self, u: usize) -> bool {",
      "        for i in 0..self.グラフ[u].len() {",
      "            let v = self.グラフ[u][i];",
      "            let w = self.右相手[v];",
      "            let 進める =",
      "                w < 0 || (self.距離[w as usize] == self.距離[u] + 1 && self.dfs(w as usize));",
      "            if 進める {",
      "                self.左相手[u] = v as i64;",
      "                self.右相手[v] = u as i64;",
      "                return true;",
      "            }",
      "        }",
      "        self.距離[u] = -1;",
      "        false",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut 本数 = 0;",
      "        while self.bfs() {",
      "            for u in 0..self.左数 {",
      "                if self.左相手[u] < 0 && self.dfs(u) {",
      "                    本数 += 1;",
      "                }",
      "            }",
      "        }",
      "        本数",
      "    }",
      "    /// マッチした `(左, 右)` の組を返す。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn マッチング(&self) -> Vec<(usize, usize)> {",
      "        (0..self.左数)",
      "            .filter(|&u| self.左相手[u] >= 0)",
      "            .map(|u| (u, self.左相手[u] as usize))",
      "            .collect()",
      "    }",
      "}"
    ]
  },
  "最大_区間_数": {
    "scope": "rust",
    "prefix": "最大_区間_数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 区間スケジューリング問題。半開区間 `[開始, 終了)` の集合から、",
      "/// 互いに重ならないように選べる区間の最大個数を返す貪欲法。O(N log N)。",
      "/// `区間` は `(開始, 終了)` の列。終端 `終了` が早い順に貪欲に取れば最適になる。",
      "/// 端点が接するだけ（前の `終了 == 次の 開始`）は重ならないとみなす。",
      "/// 「最大個数」ではなく実際に選んだ区間が欲しいときは [`区間スケジューリング_選択`] を使う。",
      "fn 区間スケジューリング(区間: &[(i64, i64)]) -> usize {",
      "    let mut 並び: Vec<(i64, i64)> = 区間.to_vec();",
      "    並び.sort_unstable_by_key(|&(_, 終)| 終);",
      "    let mut 個数 = 0;",
      "    let mut 直前の終了 = i64::MIN;",
      "    for &(開始, 終了) in &並び {",
      "        if 開始 >= 直前の終了 {",
      "            個数 += 1;",
      "            直前の終了 = 終了;",
      "        }",
      "    }",
      "    個数",
      "}"
    ]
  },
