  "オフライン_動的_連結性": {
    "scope": "rust",
    "prefix": "オフライン_動的_連結性",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// オフライン動的連結性で使う巻き戻し（Undo）可能 Union-Find。経路圧縮せずユニオン by サイズで結合し、",
      "/// 各結合をスタックに積んで任意時点へ復元する。`連結成分数` も追跡する。",
      "struct 巻き戻しDSU {",
      "    親orサイズ: Vec<i64>,",
      "    履歴: Vec<(usize, i64)>,",
      "    成分数: usize,",
      "}",
      "impl 巻き戻しDSU {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親orサイズ: vec![-1; n],",
      "            履歴: Vec::new(),",
      "            成分数: n,",
      "        }",
      "    }",
      "    /// `x` の根（経路圧縮なし）。",
      "    fn 根(&self, mut x: usize) -> usize {",
      "        while self.親orサイズ[x] >= 0 {",
      "            x = self.親orサイズ[x] as usize;",
      "        }",
      "        x",
      "    }",
      "    /// `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "    /// `x` の属する集合の要素数。",
      "    fn サイズ(&self, x: usize) -> usize {",
      "        let r = self.根(x);",
      "        (-self.親orサイズ[r]) as usize",
      "    }",
      "    /// 現在の連結成分数。",
      "    fn 連結成分数(&self) -> usize {",
      "        self.成分数",
      "    }",
      "    /// `x` と `y` を結合する。既に同じ集合なら `false`。",
      "    fn 統合(&mut self, x: usize, y: usize) -> bool {",
      "        let mut a = self.根(x);",
      "        let mut b = self.根(y);",
      "        if a == b {",
      "            return false;",
      "        }",
      "        if self.親orサイズ[a] > self.親orサイズ[b] {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        self.履歴.push((a, self.親orサイズ[a]));",
      "        self.履歴.push((b, self.親orサイズ[b]));",
      "        self.親orサイズ[a] += self.親orサイズ[b];",
      "        self.親orサイズ[b] = a as i64;",
      "        self.成分数 -= 1;",
      "        true",
      "    }",
      "    /// 現在のスナップショット（履歴長）。",
      "    fn 現在時点(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    /// `時点` まで状態を巻き戻す（履歴は 1 結合につき 2 件）。成分数も復元する。",
      "    fn ロールバック(&mut self, 時点: usize) {",
      "        let 結合数 = (self.履歴.len() - 時点) / 2;",
      "        while self.履歴.len() > 時点 {",
      "            let (i, v) = self.履歴.pop().unwrap();",
      "            self.親orサイズ[i] = v;",
      "        }",
      "        self.成分数 += 結合数;",
      "    }",
      "}",
      "/// オフライン動的連結性。辺の追加・削除がある時系列（時刻 `0..T`）に対し、各時刻での連結性を一括で求める。",
      "/// 「各辺が存在する時刻区間 `[開始, 終了)`」を時間方向のセグメント木に載せて分割統治する。",
      "/// 全体 `O((辺 + T) log T α)`。クエリを先読みできる（オフライン）ことが前提。",
      "/// - [`Self::辺追加`] : 辺 `(u, v)` が存在する時刻区間を登録。",
      "/// - [`Self::解く`] : 各時刻 `t` でコールバックに DSU を渡す。",
      "struct オフライン動的連結性 {",
      "    時刻数: usize,",
      "    頂点数: usize,",
      "    辺: Vec<Vec<(usize, usize)>>,",
      "}",
      "impl オフライン動的連結性 {",
      "    /// 頂点数 `頂点数`、時刻数 `時刻数`（時刻は `0..時刻数`）で初期化する。",
      "    fn new(頂点数: usize, 時刻数: usize) -> Self {",
      "        Self {",
      "            時刻数,",
      "            頂点数,",
      "            辺: vec![Vec::new(); 4 * 時刻数.max(1)],",
      "        }",
      "    }",
      "    /// 辺 `(u, v)` が時刻区間 `[開始, 終了)` に存在することを登録する。",
      "    fn 辺追加(&mut self, u: usize, v: usize, 開始: usize, 終了: usize) {",
      "        if 開始 < 終了 {",
      "            self.区間に追加(1, 0, self.時刻数, 開始, 終了, (u, v));",
      "        }",
      "    }",
      "    fn 区間に追加(",
      "        &mut self,",
      "        節点: usize,",
      "        nl: usize,",
      "        nr: usize,",
      "        l: usize,",
      "        r: usize,",
      "        辺: (usize, usize),",
      "    ) {",
      "        if r <= nl || nr <= l {",
      "            return;",
      "        }",
      "        if l <= nl && nr <= r {",
      "            self.辺[節点].push(辺);",
      "            return;",
      "        }",
      "        let 中 = (nl + nr) / 2;",
      "        self.区間に追加(2 * 節点, nl, 中, l, r, 辺);",
      "        self.区間に追加(2 * 節点 + 1, 中, nr, l, r, 辺);",
      "    }",
      "    /// セグメント木を DFS し、各時刻 `t`（`0..時刻数`）でその時点の DSU をコールバックに渡す。",
      "    fn 解く<F: FnMut(usize, &巻き戻しDSU)>(&self, mut 処理: F) {",
      "        if self.時刻数 == 0 {",
      "            return;",
      "        }",
      "        let mut dsu = 巻き戻しDSU::new(self.頂点数);",
      "        self.探索(1, 0, self.時刻数, &mut dsu, &mut 処理);",
      "    }",
      "    fn 探索<F: FnMut(usize, &巻き戻しDSU)>(",
      "        &self,",
      "        節点: usize,",
      "        nl: usize,",
      "        nr: usize,",
      "        dsu: &mut 巻き戻しDSU,",
      "        処理: &mut F,",
      "    ) {",
      "        let スナップ = dsu.現在時点();",
      "        for &(u, v) in &self.辺[節点] {",
      "            dsu.統合(u, v);",
      "        }",
      "        if nr - nl == 1 {",
      "            処理(nl, dsu);",
      "        } else {",
      "            let 中 = (nl + nr) / 2;",
      "            self.探索(2 * 節点, nl, 中, dsu, 処理);",
      "            self.探索(2 * 節点 + 1, 中, nr, dsu, 処理);",
      "        }",
      "        dsu.ロールバック(スナップ);",
      "    }",
      "}"
    ]
  },
  "オフライン_区間_クエリ": {
    "scope": "rust",
    "prefix": "オフライン_区間_クエリ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Mo のアルゴリズムで扱う区間状態。現在の対象区間 `[l, r)` を 1 要素ずつ伸縮させながら、",
      "/// 各クエリの答えを得るためのインタフェースを実装する。",
      "/// 伸縮は端点の単純な追加・削除で答えを更新できる問題（区間内の種類数・同値ペア数など）に",
      "/// 適用できる。状態は `状態.追加 / 削除` の呼び出しに対し O(1)〜O(log) で更新できること。",
      "trait Mo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 位置 `位置` の要素を現在の対象区間に加える。",
      "    fn 追加(&mut self, 位置: usize);",
      "    /// 位置 `位置` の要素を現在の対象区間から取り除く。",
      "    fn 削除(&mut self, 位置: usize);",
      "    /// 現在の対象区間に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// Mo のアルゴリズム本体。`クエリ` は半開区間 `[l, r)` の列で、各クエリの答えを",
      "/// 入力順に並べて返す。全体 O((N + Q)·√N · 更新コスト)。",
      "/// `状態` は空区間 `[0, 0)` を表す初期状態で渡すこと。`S` は [`Mo`] を実装した型。",
      "fn mo実行<S: Mo>(状態: &mut S, クエリ: &[(usize, usize)]) -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    let mut 答え = Vec::with_capacity(q);",
      "    if q == 0 {",
      "        return 答え;",
      "    }",
      "    let 上限 = クエリ.iter().map(|&(_, r)| r).max().unwrap().max(1);",
      "    let ブロック = ((上限 as f64).sqrt() as usize).max(1);",
      "    let mut 順: Vec<usize> = (0..q).collect();",
      "    順.sort_by(|&a, &b| {",
      "        let (la, ra) = クエリ[a];",
      "        let (lb, rb) = クエリ[b];",
      "        let (ba, bb) = (la / ブロック, lb / ブロック);",
      "        if ba != bb {",
      "            return ba.cmp(&bb);",
      "        }",
      "        if ba % 2 == 0 {",
      "            ra.cmp(&rb)",
      "        } else {",
      "            rb.cmp(&ra)",
      "        }",
      "    });",
      "    let mut 出力: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let (mut cl, mut cr) = (0usize, 0usize);",
      "    for &i in &順 {",
      "        let (l, r) = クエリ[i];",
      "        while cr < r {",
      "            状態.追加(cr);",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            状態.追加(cl);",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            状態.削除(cr);",
      "        }",
      "        while cl < l {",
      "            状態.削除(cl);",
      "            cl += 1;",
      "        }",
      "        出力[i] = Some(状態.答え());",
      "    }",
      "    for o in 出力 {",
      "        答え.push(o.unwrap());",
      "    }",
      "    答え",
      "}"
    ]
  },
  "カルテシアン_木": {
    "scope": "rust",
    "prefix": "カルテシアン_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 配列からデカルト木（Cartesian tree）を O(N) で構築する。返り値は `(親配列, 根)`。",
      "/// 親配列の根は `-1`。値が等しいときは添字の小さい方を祖先（根側）にする最小ヒープ版。",
      "/// デカルト木は「中順走査が元の配列順」かつ「親の値 <= 子の値（最小ヒープ）」を満たす二分木で、",
      "/// 区間最小値クエリ（RMQ）を LCA に帰着したり、ヒストグラム最大長方形・単調スタック系の問題に使える。",
      "/// 要素型 `T` は順序比較できる型なら何でもよい（`i64`・`f64` など `PartialOrd`）。",
      "fn デカルト木<T: PartialOrd>(a: &[T]) -> (Vec<i64>, usize) {",
      "    let n = a.len();",
      "    let mut prev = vec![-1i64; n];",
      "    let mut スタック: Vec<usize> = Vec::new();",
      "    for i in 0..n {",
      "        let mut 直前 = -1i64;",
      "        while let Some(&天) = スタック.last() {",
      "            if a[天] <= a[i] {",
      "                break;",
      "            }",
      "            直前 = 天 as i64;",
      "            スタック.pop();",
      "        }",
      "        if 直前 != -1 {",
      "            prev[直前 as usize] = i as i64;",
      "        }",
      "        if let Some(&天) = スタック.last() {",
      "            prev[i] = 天 as i64;",
      "        }",
      "        スタック.push(i);",
      "    }",
      "    let 根 = (0..n).find(|&i| prev[i] == -1).unwrap_or(0);",
      "    (prev, 根)",
      "}"
    ]
  },
  "ガウス_消去_mod": {
    "scope": "rust",
    "prefix": "ガウス_消去_mod",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `法` 上の連立一次方程式 `A x = b` を掃き出し（RREF）で解く。O(行数·変数数·min)。",
      "/// `係数` は各式の係数行（全行同じ長さ）、`右辺` は各式の右辺。解が無ければ `None`、",
      "/// 有れば解の一つ（自由変数は 0 とおく）を返す。`法` は**素数**であること。",
      "/// XOR（mod 2）専用の高速版は [`crate::gf2_elimination`]、行列式だけなら",
      "/// [`crate::matrix_det_mod`] を使う。",
      "fn 連立一次方程式_mod(係数: &[Vec<u64>], 右辺: &[u64], 法: u64) -> Option<Vec<u64>> {",
      "    let 行数 = 係数.len();",
      "    let 変数数 = if 行数 == 0 { 0 } else { 係数[0].len() };",
      "    let mut a: Vec<Vec<u64>> = (0..行数)",
      "        .map(|i| {",
      "            let mut row: Vec<u64> = 係数[i].iter().map(|&x| x % 法).collect();",
      "            row.push(右辺[i] % 法);",
      "            row",
      "        })",
      "        .collect();",
      "    let mut ピボット行 = vec![!0; 変数数];",
      "    let mut r = 0usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for c in 0..変数数 {",
      "        let Some(sel) = (r..行数).find(|&i| a[i][c] != 0) else {",
      "            continue;",
      "        };",
      "        a.swap(r, sel);",
      "        let inv = 累乗_mod(a[r][c], 法 - 2, 法);",
      "        for j in c..=変数数 {",
      "            a[r][j] = a[r][j] * inv % 法;",
      "        }",
      "        for i in 0..行数 {",
      "            if i != r && a[i][c] != 0 {",
      "                let f = a[i][c];",
      "                for j in c..=変数数 {",
      "                    a[i][j] = (a[i][j] + 法 - f * a[r][j] % 法) % 法;",
      "                }",
      "            }",
      "        }",
      "        ピボット行[c] = r;",
      "        r += 1;",
      "        if r == 行数 {",
      "            break;",
      "        }",
      "    }",
      "    for row in &a {",
      "        if row[..変数数].iter().all(|&v| v == 0) && row[変数数] != 0 {",
      "            return None;",
      "        }",
      "    }",
      "    let mut x = vec![0u64; 変数数];",
      "    for (c, &pr) in ピボット行.iter().enumerate() {",
      "        if pr != !0 {",
      "            x[c] = a[pr][変数数];",
      "        }",
      "    }",
      "    Some(x)",
      "}"
    ]
  },
  "キルヒホッフ": {
    "scope": "rust",
    "prefix": "キルヒホッフ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `法` 上での正方行列の行列式を掃き出し（前進消去）で求める。O(n^3)。",
      "/// `法` は**素数**であること（フェルマーの小定理で逆元を取るため）。",
      "/// 行列はムーブで受け取り破壊的に消去する。`法 < 2^31` 程度を想定。",
      "fn 行列式_mod(mut 行列: Vec<Vec<u64>>, 法: u64) -> u64 {",
      "    let n = 行列.len();",
      "    for row in &mut 行列 {",
      "        for x in row.iter_mut() {",
      "            *x %= 法;",
      "        }",
      "    }",
      "    let mut 結果 = 1u64 % 法;",
      "    for 列 in 0..n {",
      "        let ピボット = (列..n).find(|&r| 行列[r][列] != 0);",
      "        let Some(p) = ピボット else {",
      "            return 0;",
      "        };",
      "        if p != 列 {",
      "            行列.swap(p, 列);",
      "            結果 = (法 - 結果) % 法;",
      "        }",
      "        let 逆 = 累乗_mod(行列[列][列], 法 - 2, 法);",
      "        結果 = 結果 * 行列[列][列] % 法;",
      "        for r in 列 + 1..n {",
      "            let 係数 = 行列[r][列] * 逆 % 法;",
      "            if 係数 != 0 {",
      "                for c in 列..n {",
      "                    行列[r][c] = (行列[r][c] + 法 - 係数 * 行列[列][c] % 法) % 法;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    結果",
      "}",
      "/// 行列木定理（キルヒホッフの定理）で、無向グラフの全域木の個数を `法`（素数）で求める。O(V^3)。",
      "/// `辺` は無向辺 `(u, v)`（`0..頂点数`、多重辺可・自己ループは無視推奨）。ラプラシアン行列",
      "/// から 1 行 1 列を除いた小行列の行列式が全域木数に等しい。連結でなければ 0。",
      "/// 頂点 1 個のときは（辺のない木が 1 通りとして）1 を返す。",
      "fn 全域木数_mod(頂点数: usize, 辺: &[(usize, usize)], 法: u64) -> u64 {",
      "    if 頂点数 <= 1 {",
      "        return 1 % 法;",
      "    }",
      "    let n = 頂点数;",
      "    let mut l = vec![vec![0u64; n]; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            continue;",
      "        }",
      "        l[u][u] += 1;",
      "        l[v][v] += 1;",
      "        l[u][v] = (l[u][v] + 法 - 1) % 法;",
      "        l[v][u] = (l[v][u] + 法 - 1) % 法;",
      "    }",
      "    for (i, row) in l.iter_mut().enumerate() {",
      "        row[i] %= 法;",
      "    }",
      "    let 小行列: Vec<Vec<u64>> = (0..n - 1).map(|i| l[i][0..n - 1].to_vec()).collect();",
      "    行列式_mod(小行列, 法)",
      "}"
    ]
  },
  "クヌース_最適化": {
    "scope": "rust",
    "prefix": "クヌース_最適化",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// クヌース（Knuth–Yao）最適化。区間 DP `dp[i][j] = 区間コスト(i, j) + min_{i<=k<j} (dp[i][k] + dp[k+1][j])`",
      "/// を、最適分割点の単調性 `opt[i][j-1] <= opt[i][j] <= opt[i+1][j]` を用いて `O(n^2)` で解く。",
      "/// `区間コスト(i, j)` が四角不等式（QI）と区間単調性を満たすとき正しい（石の合体・最適二分探索木など、",
      "/// 区間長に関する凸なコスト）。素朴な区間 DP は `O(n^3)`。`n` 要素を 1 つに併合する総コストを返す。",
      "/// [`crate::divide_and_conquer_dp`]（層状の遷移）とは別物。",
      "fn クヌース最適化<F: Fn(usize, usize) -> i64>(n: usize, 区間コスト: F) -> i64 {",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let mut dp = vec![vec![0i64; n]; n];",
      "    let mut opt = vec![vec![0usize; n]; n];",
      "    for (i, 行) in opt.iter_mut().enumerate() {",
      "        行[i] = i;",
      "    }",
      "    for 長 in 1..n {",
      "        for i in 0..n - 長 {",
      "            let j = i + 長;",
      "            let 下 = opt[i][j - 1];",
      "            let 上 = opt[i + 1][j].min(j - 1);",
      "            let mut 最良 = i64::MAX;",
      "            let mut 最良k = 下;",
      "            for k in 下..=上 {",
      "                let v = dp[i][k] + dp[k + 1][j];",
      "                if v < 最良 {",
      "                    最良 = v;",
      "                    最良k = k;",
      "                }",
      "            }",
      "            dp[i][j] = 最良 + 区間コスト(i, j);",
      "            opt[i][j] = 最良k;",
      "        }",
      "    }",
      "    dp[0][n - 1]",
      "}"
    ]
  },
