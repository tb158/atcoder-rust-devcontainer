  "IntervalSet": {
    "scope": "rust",
    "prefix": "IntervalSet",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::collections::BTreeMap;",
      "/// 互いに素な半開区間 `[l, r)` の集合を `BTreeMap` で管理する「区間を set で管理」テクニックの実装。",
      "/// 区間の追加（和）・削除、点の被覆判定、被覆長、`mex`（被覆されていない最小値）を扱う。",
      "/// 隣接する区間（端が接する）は自動的に併合され、常に互いに素かつ非隣接な正規形を保つ。",
      "/// 各操作は併合・分割した区間数を `k` として `O((k+1) log n)`、全体で償却効率が良い。",
      "#[derive(Default, Clone, Debug)]",
      "struct 区間集合 {",
      "    区間: BTreeMap<i64, i64>,",
      "    被覆: i64,",
      "}",
      "impl 区間集合 {",
      "    /// 空の区間集合を作る。",
      "    fn new() -> Self {",
      "        Self::default()",
      "    }",
      "    /// `RangeBounds` を半開区間 `[l, r)`（i64）に解決する。土台の値域が無いので両端は必須",
      "    /// （`..` / `l..` / `..r` は panic。`l..r` か `l..=r` を使う）。",
      "    fn 半開<T: Copy + TryInto<i64>>(範囲: impl std::ops::RangeBounds<T>) -> (i64, i64) {",
      "        use std::ops::Bound::{Excluded, Included, Unbounded};",
      "        let l = match 範囲.start_bound() {",
      "            Included(&x) => to_i64(x),",
      "            Excluded(&x) => to_i64(x) + 1,",
      "            Unbounded => panic!(\"区間集合: 下端は必須（l..r か l..=r を使う）\"),",
      "        };",
      "        let r = match 範囲.end_bound() {",
      "            Included(&x) => to_i64(x) + 1,",
      "            Excluded(&x) => to_i64(x),",
      "            Unbounded => panic!(\"区間集合: 上端は必須（l..r か l..=r を使う）\"),",
      "        };",
      "        (l, r)",
      "    }",
      "    /// 区間（`l..r`=半開 / `l..=r`=閉）を追加（和を取る）。重なり・隣接する既存区間はすべて",
      "    /// 1 本に併合される。整数型は任意（usize / i64 など。ただし両端は同じ型）。",
      "    fn 追加<T: Copy + TryInto<i64>>(&mut self, 範囲: impl std::ops::RangeBounds<T>) {",
      "        let (l, r) = Self::半開(範囲);",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let mut nl = l;",
      "        let mut nr = r;",
      "        let 対象: Vec<i64> = self",
      "            .区間",
      "            .range(..=r)",
      "            .filter(|&(_, &e)| e >= l)",
      "            .map(|(&s, _)| s)",
      "            .collect();",
      "        for s in 対象 {",
      "            let e = self.区間.remove(&s).unwrap();",
      "            self.被覆 -= e - s;",
      "            nl = nl.min(s);",
      "            nr = nr.max(e);",
      "        }",
      "        self.被覆 += nr - nl;",
      "        self.区間.insert(nl, nr);",
      "    }",
      "    /// 区間（`l..r`=半開 / `l..=r`=閉）を削除する。またがる既存区間は両端で分割される。",
      "    fn 削除<T: Copy + TryInto<i64>>(&mut self, 範囲: impl std::ops::RangeBounds<T>) {",
      "        let (l, r) = Self::半開(範囲);",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let 対象: Vec<i64> = self",
      "            .区間",
      "            .range(..r)",
      "            .filter(|&(_, &e)| e > l)",
      "            .map(|(&s, _)| s)",
      "            .collect();",
      "        for s in 対象 {",
      "            let e = self.区間.remove(&s).unwrap();",
      "            self.被覆 -= e - s;",
      "            if s < l {",
      "                self.被覆 += l - s;",
      "                self.区間.insert(s, l);",
      "            }",
      "            if e > r {",
      "                self.被覆 += e - r;",
      "                self.区間.insert(r, e);",
      "            }",
      "        }",
      "    }",
      "    /// 点 `x` が被覆されているか（いずれかの区間に含まれるか）を返す。",
      "    fn 含む(&self, x: impl TryInto<i64>) -> bool {",
      "        let x = to_i64(x);",
      "        self.区間",
      "            .range(..=x)",
      "            .next_back()",
      "            .is_some_and(|(_, &e)| e > x)",
      "    }",
      "    /// 点 `x` を含む区間 `[l, r)` を返す。含まれなければ `None`。",
      "    fn 区間取得(&self, x: impl TryInto<i64>) -> Option<(i64, i64)> {",
      "        let x = to_i64(x);",
      "        self.区間",
      "            .range(..=x)",
      "            .next_back()",
      "            .and_then(|(&s, &e)| if e > x { Some((s, e)) } else { None })",
      "    }",
      "    /// `x` 以上で被覆されていない最小の整数（mex）を返す。`x` 自身が空きならそのまま `x`。",
      "    fn mex(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        match self.区間取得(x) {",
      "            Some((_, e)) => e,",
      "            None => x,",
      "        }",
      "    }",
      "    /// 被覆されている整数の総数（= 全区間の長さの和）。",
      "    fn 被覆長(&self) -> i64 {",
      "        self.被覆",
      "    }",
      "    /// 現在の区間一覧を始点昇順の `(l, r)` で返す。",
      "    fn 区間列(&self) -> Vec<(i64, i64)> {",
      "        self.区間.iter().map(|(&s, &e)| (s, e)).collect()",
      "    }",
      "}"
    ]
  },
  "KDTree": {
    "scope": "rust",
    "prefix": "KDTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// 平面上の静的な点集合を、軸を交互に切り替えながら中央値で分割して作る平衡 **2 次元 kd 木**。",
      "/// 構築 `O(N log N)`、最近傍クエリ平均 `O(log N)`、矩形範囲計数は最悪 `O(√N)`。",
      "/// [`closest_pair`](crate::closest_pair) は点集合全体の**最近点対 1 組**を `O(N log N)` で求める別物で、",
      "/// 任意のクエリ点に対する最近傍探索や矩形内点数は扱わない。[`wavelet_matrix`](crate::wavelet_matrix) は",
      "/// 1 次元列の区間クエリ用。",
      "struct KD木 {",
      "    点: Vec<(i64, i64, usize)>,",
      "}",
      "/// 区間 `点[..]` を `axis`（0=x, 1=y）の中央値で再帰的に分割し、陰的平衡 kd 木を組む内部関数。",
      "fn 構築(点: &mut [(i64, i64, usize)], axis: usize) {",
      "    let n = 点.len();",
      "    if n <= 1 {",
      "        return;",
      "    }",
      "    let m = n / 2;",
      "    if axis == 0 {",
      "        点.select_nth_unstable_by_key(m, |&(x, _, _)| x);",
      "    } else {",
      "        点.select_nth_unstable_by_key(m, |&(_, y, _)| y);",
      "    }",
      "    let (左, 右) = 点.split_at_mut(m);",
      "    構築(左, 1 - axis);",
      "    構築(&mut 右[1..], 1 - axis);",
      "}",
      "impl KD木 {",
      "    /// 点群から kd 木を構築する。`O(N log N)`。",
      "    fn new(点群: &[(i64, i64)]) -> Self {",
      "        let mut 点: Vec<(i64, i64, usize)> = 点群",
      "            .iter()",
      "            .enumerate()",
      "            .map(|(i, &(x, y))| (x, y, i))",
      "            .collect();",
      "        構築(&mut 点, 0);",
      "        KD木 { 点 }",
      "    }",
      "    /// クエリ点 `q` に最も近い点の `(距離の2乗, 元の添字)` を返す。点が無ければ `None`。",
      "    /// 距離が等しい点が複数あるときどの添字を返すかは不定（距離は必ず最小）。平均 `O(log N)`。",
      "    fn 最近傍<X: TryInto<i64>, Y: TryInto<i64>>(&self, q: (X, Y)) -> Option<(i128, usize)> {",
      "        if self.点.is_empty() {",
      "            return None;",
      "        }",
      "        let q = (to_i64(q.0), to_i64(q.1));",
      "        let mut 最良 = (i128::MAX, !0);",
      "        self.近傍探索(0, self.点.len(), 0, q, &mut 最良);",
      "        Some(最良)",
      "    }",
      "    /// 軸平行な閉矩形 `[x1, x2] × [y1, y2]`（端点含む）に入る点の個数を返す。最悪 `O(√N)`。",
      "    fn 矩形内点数(",
      "        &self,",
      "        x1: impl TryInto<i64>,",
      "        y1: impl TryInto<i64>,",
      "        x2: impl TryInto<i64>,",
      "        y2: impl TryInto<i64>,",
      "    ) -> usize {",
      "        let (x1, y1, x2, y2) = (to_i64(x1), to_i64(y1), to_i64(x2), to_i64(y2));",
      "        self.範囲計数(0, self.点.len(), 0, x1, y1, x2, y2)",
      "    }",
      "    fn 近傍探索(",
      "        &self,",
      "        l: usize,",
      "        r: usize,",
      "        axis: usize,",
      "        q: (i64, i64),",
      "        最良: &mut (i128, usize),",
      "    ) {",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let m = l + (r - l) / 2;",
      "        let (px, py, idx) = self.点[m];",
      "        let dx = (q.0 - px) as i128;",
      "        let dy = (q.1 - py) as i128;",
      "        let d = dx * dx + dy * dy;",
      "        if d < 最良.0 {",
      "            *最良 = (d, idx);",
      "        }",
      "        let 面 = if axis == 0 {",
      "            (q.0 - px) as i128",
      "        } else {",
      "            (q.1 - py) as i128",
      "        };",
      "        let q側が左 = if axis == 0 { q.0 <= px } else { q.1 <= py };",
      "        let (近l, 近r, 遠l, 遠r) = if q側が左 {",
      "            (l, m, m + 1, r)",
      "        } else {",
      "            (m + 1, r, l, m)",
      "        };",
      "        self.近傍探索(近l, 近r, 1 - axis, q, 最良);",
      "        if 面 * 面 < 最良.0 {",
      "            self.近傍探索(遠l, 遠r, 1 - axis, q, 最良);",
      "        }",
      "    }",
      "    #[allow(clippy::too_many_arguments)]",
      "    fn 範囲計数(",
      "        &self,",
      "        l: usize,",
      "        r: usize,",
      "        axis: usize,",
      "        x1: i64,",
      "        y1: i64,",
      "        x2: i64,",
      "        y2: i64,",
      "    ) -> usize {",
      "        if l >= r {",
      "            return 0;",
      "        }",
      "        let m = l + (r - l) / 2;",
      "        let (px, py, _) = self.点[m];",
      "        let mut c = usize::from(x1 <= px && px <= x2 && y1 <= py && py <= y2);",
      "        let (下, 上) = if axis == 0 {",
      "            (x1 <= px, px <= x2)",
      "        } else {",
      "            (y1 <= py, py <= y2)",
      "        };",
      "        if 下 {",
      "            c += self.範囲計数(l, m, 1 - axis, x1, y1, x2, y2);",
      "        }",
      "        if 上 {",
      "            c += self.範囲計数(m + 1, r, 1 - axis, x1, y1, x2, y2);",
      "        }",
      "        c",
      "    }",
      "}"
    ]
  },
