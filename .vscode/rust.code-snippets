  "区間_加算": {
    "scope": "rust",
    "prefix": "区間_加算",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// いもす法(1次元)。「区間への一括加算」を O(1) で記録し、最後に O(N) で各点の値へ展開する。",
      "/// 区間加算クエリが大量にあり、最終的な各点の値だけが欲しいときに使う。",
      "/// （累積和が「点の配列 → 区間和」なのに対し、いもす法は「区間加算 → 点の値」。）",
      "/// 値の型 `T` は加減算できる符号付きの型（`i64`・`f64`・ModInt など）で、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "/// `usize` / `u64` などの符号なし整数は使えない（差分配列が途中で負の値を持つため）。",
      "/// 符号なしで扱いたい場合は `std::num::Wrapping<u64>` を使う（最終値が `u64` に収まるなら正しい）。",
      "struct いもす法<T> {",
      "    差分: Vec<T>,",
      "}",
      "impl<T> いもす法<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::SubAssign + std::ops::Neg,",
      "{",
      "    /// 長さ `長さ` の配列に対するいもす法を、全要素 0（`T::default()`）で初期化する。",
      "    fn new(長さ: usize) -> Self {",
      "        Self {",
      "            差分: vec![T::default(); 長さ + 1],",
      "        }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に `値` を加算する（記録のみ。展開は `展開()`）。",
      "    fn 区間加算(&mut self, 範囲: impl std::ops::RangeBounds<usize>, 値: T) {",
      "        let (l, r) = 半開(範囲, self.差分.len() - 1);",
      "        self.差分[l] += 値;",
      "        self.差分[r] -= 値;",
      "    }",
      "    /// 記録した加算をすべて反映した、各点の最終的な値を返す。",
      "    fn 展開(&self) -> Vec<T> {",
      "        let mut 累積 = T::default();",
      "        self.差分[..self.差分.len() - 1]",
      "            .iter()",
      "            .map(|&d| {",
      "                累積 += d;",
      "                累積",
      "            })",
      "            .collect()",
      "    }",
      "}"
    ]
  },
  "区間_反転": {
    "scope": "rust",
    "prefix": "区間_反転",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 陰的 Treap（implicit treap）。配列を平衡二分木で表し、任意位置への挿入・削除、",
      "/// 区間反転、区間和、一点取得を全て O(log N) で行える。添字をキーに持たず部分木サイズで",
      "/// 位置を決める「陰的キー」方式。",
      "/// - [`Self::挿入`] / [`Self::削除`] : 位置指定の挿入・削除。",
      "/// - [`Self::反転`] : 半開区間 `[l, r)` を反転。",
      "/// - [`Self::区間和`] : 半開区間 `[l, r)` の和。",
      "/// - [`Self::取得`] : 1 要素の値。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "/// 位置ではなく値の大小で並べた集合（k 番目・順位）が欲しいなら",
      "/// [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合) を使う。",
      "struct 陰的Treap<T> {",
      "    値: Vec<T>,",
      "    優先度: Vec<u64>,",
      "    サイズ: Vec<usize>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "    左: Vec<usize>,",
      "    右: Vec<usize>,",
      "    rng: u64,",
      "    根: usize,",
      "}",
      "impl<T> 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn new() -> Self {",
      "        Self {",
      "            値: vec![T::default()],",
      "            優先度: vec![0],",
      "            サイズ: vec![0],",
      "            和: vec![T::default()],",
      "            反転: vec![false],",
      "            左: vec![0],",
      "            右: vec![0],",
      "            rng: 0x9e37_79b9_7f4a_7c15,",
      "            根: 0,",
      "        }",
      "    }",
      "    fn 乱数(&mut self) -> u64 {",
      "        let mut x = self.rng;",
      "        x ^= x << 13;",
      "        x ^= x >> 7;",
      "        x ^= x << 17;",
      "        self.rng = x;",
      "        x",
      "    }",
      "    fn 新規ノード(&mut self, 値: T) -> usize {",
      "        let p = self.乱数();",
      "        self.値.push(値);",
      "        self.優先度.push(p);",
      "        self.サイズ.push(1);",
      "        self.和.push(値);",
      "        self.反転.push(false);",
      "        self.左.push(0);",
      "        self.右.push(0);",
      "        self.値.len() - 1",
      "    }",
      "    /// 子の情報から `t` のサイズと和を再計算する。反転フラグはサイズ・和に影響しない。",
      "    fn 更新(&mut self, t: usize) {",
      "        if t == 0 {",
      "            return;",
      "        }",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.サイズ[t] = 1 + self.サイズ[l] + self.サイズ[r];",
      "        self.和[t] = self.値[t] + self.和[l] + self.和[r];",
      "    }",
      "    /// `t` に溜まった反転遅延を子へ押し下げる。",
      "    fn 伝播(&mut self, t: usize) {",
      "        if t == 0 || !self.反転[t] {",
      "            return;",
      "        }",
      "        self.反転[t] = false;",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.左[t] = r;",
      "        self.右[t] = l;",
      "        if l != 0 {",
      "            self.反転[l] ^= true;",
      "        }",
      "        if r != 0 {",
      "            self.反転[r] ^= true;",
      "        }",
      "    }",
      "    /// `t` を「左 k 要素」と「残り」に分割し、`(左根, 右根)` を返す。",
      "    fn split(&mut self, t: usize, k: usize) -> (usize, usize) {",
      "        if t == 0 {",
      "            return (0, 0);",
      "        }",
      "        self.伝播(t);",
      "        let 左サイズ = self.サイズ[self.左[t]];",
      "        if k <= 左サイズ {",
      "            let (l, r) = self.split(self.左[t], k);",
      "            self.左[t] = r;",
      "            self.更新(t);",
      "            (l, t)",
      "        } else {",
      "            let (l, r) = self.split(self.右[t], k - 左サイズ - 1);",
      "            self.右[t] = l;",
      "            self.更新(t);",
      "            (t, r)",
      "        }",
      "    }",
      "    /// 2 つの木を連結する。`l` の全要素が `r` の前に来る。",
      "    fn merge(&mut self, l: usize, r: usize) -> usize {",
      "        if l == 0 {",
      "            return r;",
      "        }",
      "        if r == 0 {",
      "            return l;",
      "        }",
      "        if self.優先度[l] > self.優先度[r] {",
      "            self.伝播(l);",
      "            let 新右 = self.merge(self.右[l], r);",
      "            self.右[l] = 新右;",
      "            self.更新(l);",
      "            l",
      "        } else {",
      "            self.伝播(r);",
      "            let 新左 = self.merge(l, self.左[r]);",
      "            self.左[r] = 新左;",
      "            self.更新(r);",
      "            r",
      "        }",
      "    }",
      "    /// 末尾に値を追加する。",
      "    fn 末尾追加(&mut self, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        self.根 = self.merge(根, 新);",
      "    }",
      "    /// 位置 `pos`（0-indexed、`pos == 長さ` で末尾）に `値` を挿入する。",
      "    fn 挿入(&mut self, pos: usize, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let 左 = self.merge(l, 新);",
      "        self.根 = self.merge(左, r);",
      "    }",
      "    /// 位置 `pos`（0-indexed）の要素を削除する。",
      "    fn 削除(&mut self, pos: usize) {",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let (_削除, r2) = self.split(r, 1);",
      "        self.根 = self.merge(l, r2);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）を反転する。",
      "    fn 反転(&mut self, 範囲: impl std::ops::RangeBounds<usize>) {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        if b != 0 {",
      "            self.反転[b] ^= true;",
      "        }",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の和。",
      "    fn 区間和(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return T::default();",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        let 結果 = self.和[b];",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "        結果",
      "    }",
      "    /// 位置 `pos`（0-indexed）の値。",
      "    fn 取得(&mut self, pos: usize) -> T {",
      "        self.区間和(pos..pos + 1)",
      "    }",
      "    /// 要素数。",
      "    fn 長さ(&self) -> usize {",
      "        self.サイズ[self.根]",
      "    }",
      "}",
      "impl<T> Default for 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "区間_和_クエリ": {
    "scope": "rust",
    "prefix": "区間_和_クエリ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 分割スパーステーブル（Disjoint Sparse Table）。静的（更新なし）配列に対し、",
      "/// 「結合的だが冪等とは限らない」二項演算（和・積・xor・gcd・行列積・アフィン合成など）の",
      "/// 区間クエリを前処理 `O(N log N)`・各クエリ `O(1)` で答える。",
      "/// 通常のスパーステーブル（[`crate::sparse_table`]）は冪等演算（min/max/gcd）専用。こちらは",
      "/// **非可換・非冪等**な演算でも使える。",
      "/// - `merge` は結合的であること（可換・冪等は不要）。順序は `merge(左側, 右側)` で保たれる。",
      "struct 分割スパーステーブル<T, F> {",
      "    元: Vec<T>,",
      "    テーブル: Vec<Vec<T>>,",
      "    merge: F,",
      "}",
      "impl<T: Copy, F: Fn(T, T) -> T> 分割スパーステーブル<T, F> {",
      "    /// 配列と結合的な二項演算 `merge` から分割スパーステーブルを構築する。",
      "    /// # 例",
      "    /// ```ignore",
      "    /// let st = 分割スパーステーブル::new(&a, |x, y| x + y); // 区間和",
      "    /// assert_eq!(st.区間(1..4), a[1] + a[2] + a[3]);",
      "    /// ```",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn new(配列: &[T], merge: F) -> Self {",
      "        let n = 配列.len();",
      "        let mut レベル数 = 1;",
      "        while (1usize << レベル数) < n {",
      "            レベル数 += 1;",
      "        }",
      "        let mut テーブル = vec![配列.to_vec(); レベル数];",
      "        for k in 0..レベル数 {",
      "            let 半 = 1usize << k;",
      "            let 幅 = 半 * 2;",
      "            let mut s = 0;",
      "            while s < n {",
      "                let 中 = s + 半;",
      "                let 左終 = 中.min(n);",
      "                for i in (s..左終 - 1).rev() {",
      "                    テーブル[k][i] = merge(配列[i], テーブル[k][i + 1]);",
      "                }",
      "                if 中 < n {",
      "                    let 右終 = (s + 幅).min(n);",
      "                    for i in 中 + 1..右終 {",
      "                        テーブル[k][i] = merge(テーブル[k][i - 1], 配列[i]);",
      "                    }",
      "                }",
      "                s += 幅;",
      "            }",
      "        }",
      "        Self {",
      "            元: 配列.to_vec(),",
      "            テーブル,",
      "            merge,",
      "        }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対する `merge` の畳み込み（左→右の順）を",
      "    /// O(1) で返す。空区間は問い合わせ不可。",
      "    fn 区間(&self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.元.len());",
      "        debug_assert!(l < r, \"分割スパーステーブル: 空区間は問い合わせ不可\");",
      "        let 右 = r - 1;",
      "        if l == 右 {",
      "            return self.元[l];",
      "        }",
      "        let k = (usize::BITS - 1 - (l ^ 右).leading_zeros()) as usize;",
      "        (self.merge)(self.テーブル[k][l], self.テーブル[k][右])",
      "    }",
      "}"
    ]
  },
  "区間_最小値_更新": {
    "scope": "rust",
    "prefix": "区間_最小値_更新",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Segment Tree Beats の 1 ノード。最大側（最大値・厳密な 2 番目・最大値の個数）と",
      "/// 最小側（最小値・厳密な 2 番目・最小値の個数）、区間和、要素数を持つ。",
      "#[derive(Clone)]",
      "struct 節点 {",
      "    最大1: i64,",
      "    最大2: i64,",
      "    最大個数: i64,",
      "    最小1: i64,",
      "    最小2: i64,",
      "    最小個数: i64,",
      "    和: i64,",
      "    要素数: i64,",
      "}",
      "const 無限大: i64 = 1 << 60;",
      "impl 節点 {",
      "    fn 葉(v: i64) -> Self {",
      "        Self {",
      "            最大1: v,",
      "            最大2: -無限大,",
      "            最大個数: 1,",
      "            最小1: v,",
      "            最小2: 無限大,",
      "            最小個数: 1,",
      "            和: v,",
      "            要素数: 1,",
      "        }",
      "    }",
      "    fn 空() -> Self {",
      "        Self {",
      "            最大1: -無限大,",
      "            最大2: -無限大,",
      "            最大個数: 0,",
      "            最小1: 無限大,",
      "            最小2: 無限大,",
      "            最小個数: 0,",
      "            和: 0,",
      "            要素数: 0,",
      "        }",
      "    }",
      "}",
      "/// 2 つの子ノードを統合する。",
      "fn 合成(l: &節点, r: &節点) -> 節点 {",
      "    let mut p = 節点::空();",
      "    p.和 = l.和 + r.和;",
      "    p.要素数 = l.要素数 + r.要素数;",
      "    if l.最大1 == r.最大1 {",
      "        p.最大1 = l.最大1;",
      "        p.最大個数 = l.最大個数 + r.最大個数;",
      "        p.最大2 = l.最大2.max(r.最大2);",
      "    } else if l.最大1 > r.最大1 {",
      "        p.最大1 = l.最大1;",
      "        p.最大個数 = l.最大個数;",
      "        p.最大2 = l.最大2.max(r.最大1);",
      "    } else {",
      "        p.最大1 = r.最大1;",
      "        p.最大個数 = r.最大個数;",
      "        p.最大2 = r.最大2.max(l.最大1);",
      "    }",
      "    if l.最小1 == r.最小1 {",
      "        p.最小1 = l.最小1;",
      "        p.最小個数 = l.最小個数 + r.最小個数;",
      "        p.最小2 = l.最小2.min(r.最小2);",
      "    } else if l.最小1 < r.最小1 {",
      "        p.最小1 = l.最小1;",
      "        p.最小個数 = l.最小個数;",
      "        p.最小2 = l.最小2.min(r.最小1);",
      "    } else {",
      "        p.最小1 = r.最小1;",
      "        p.最小個数 = r.最小個数;",
      "        p.最小2 = r.最小2.min(l.最小1);",
      "    }",
      "    p",
      "}",
      "/// Segment Tree Beats。区間 chmin（`a[i] = min(a[i], x)`）・区間 chmax・区間和・区間最大・区間最小を",
      "/// ならし O(log^2 N) で処理する。`ac_library::LazySegtree` では chmin/chmax は扱えない。",
      "/// - [`Self::区間chmin`] / [`Self::区間chmax`] : 半開区間 `[l, r)` への min/max 更新。",
      "/// - [`Self::区間和`] / [`Self::区間最大`] / [`Self::区間最小`] : 半開区間 `[l, r)` の集計。",
      "struct セグ木ビーツ {",
      "    n: usize,",
      "    木: Vec<節点>,",
      "}",
      "impl セグ木ビーツ {",
      "    /// 初期配列から構築する。",
      "    fn new(配列: &[i64]) -> Self {",
      "        let n = 配列.len();",
      "        let mut t = Self {",
      "            n,",
      "            木: vec![節点::空(); 4 * n.max(1)],",
      "        };",
      "        if n > 0 {",
      "            t.構築(1, 0, n, 配列);",
      "        }",
      "        t",
      "    }",
      "    fn 構築(&mut self, 節: usize, lo: usize, hi: usize, 配列: &[i64]) {",
      "        if hi - lo == 1 {",
      "            self.木[節] = 節点::葉(配列[lo]);",
      "            return;",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        self.構築(2 * 節, lo, m, 配列);",
      "        self.構築(2 * 節 + 1, m, hi, 配列);",
      "        self.統合(節);",
      "    }",
      "    fn 統合(&mut self, 節: usize) {",
      "        self.木[節] = 合成(&self.木[2 * 節].clone(), &self.木[2 * 節 + 1].clone());",
      "    }",
      "    /// 節点 `節` の最大値を `x` 以下に抑える（`x > 最大2` が前提）。",
      "    fn chmin適用(&mut self, 節: usize, x: i64) {",
      "        let nd = &mut self.木[節];",
      "        if x >= nd.最大1 {",
      "            return;",
      "        }",
      "        nd.和 -= (nd.最大1 - x) * nd.最大個数;",
      "        if nd.最小1 == nd.最大1 {",
      "            nd.最小1 = x;",
      "        } else if nd.最小2 == nd.最大1 {",
      "            nd.最小2 = x;",
      "        }",
      "        nd.最大1 = x;",
      "    }",
      "    /// 節点 `節` の最小値を `x` 以上に持ち上げる（`x < 最小2` が前提）。",
      "    fn chmax適用(&mut self, 節: usize, x: i64) {",
      "        let nd = &mut self.木[節];",
      "        if x <= nd.最小1 {",
      "            return;",
      "        }",
      "        nd.和 += (x - nd.最小1) * nd.最小個数;",
      "        if nd.最大1 == nd.最小1 {",
      "            nd.最大1 = x;",
      "        } else if nd.最大2 == nd.最小1 {",
      "            nd.最大2 = x;",
      "        }",
      "        nd.最小1 = x;",
      "    }",
      "    /// 親の cap（最大1）・floor（最小1）を子へ伝播する。",
      "    fn 伝播(&mut self, 節: usize) {",
      "        let cap = self.木[節].最大1;",
      "        let floor = self.木[節].最小1;",
      "        for 子 in [2 * 節, 2 * 節 + 1] {",
      "            self.chmin適用(子, cap);",
      "            self.chmax適用(子, floor);",
      "        }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対し `a[i] = min(a[i], x)`。ならし `O(log² N)`。",
      "    fn 区間chmin(&mut self, 範囲: impl std::ops::RangeBounds<usize>, x: impl TryInto<i64>) {",
      "        let x = to_i64(x);",
      "        let (l, r) = 半開(範囲, self.n);",
      "        if l < r {",
      "            self.chmin内部(1, 0, self.n, l, r, x);",
      "        }",
      "    }",
      "    fn chmin内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize, x: i64) {",
      "        if r <= lo || hi <= l || self.木[節].最大1 <= x {",
      "            return;",
      "        }",
      "        if l <= lo && hi <= r && self.木[節].最大2 < x {",
      "            self.chmin適用(節, x);",
      "            return;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.chmin内部(2 * 節, lo, m, l, r, x);",
      "        self.chmin内部(2 * 節 + 1, m, hi, l, r, x);",
      "        self.統合(節);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対し `a[i] = max(a[i], x)`。ならし `O(log² N)`。",
      "    fn 区間chmax(&mut self, 範囲: impl std::ops::RangeBounds<usize>, x: impl TryInto<i64>) {",
      "        let x = to_i64(x);",
      "        let (l, r) = 半開(範囲, self.n);",
      "        if l < r {",
      "            self.chmax内部(1, 0, self.n, l, r, x);",
      "        }",
      "    }",
      "    fn chmax内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize, x: i64) {",
      "        if r <= lo || hi <= l || self.木[節].最小1 >= x {",
      "            return;",
      "        }",
      "        if l <= lo && hi <= r && self.木[節].最小2 > x {",
      "            self.chmax適用(節, x);",
      "            return;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.chmax内部(2 * 節, lo, m, l, r, x);",
      "        self.chmax内部(2 * 節 + 1, m, hi, l, r, x);",
      "        self.統合(節);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の総和。ならし `O(log N)`。",
      "    fn 区間和(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.和内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 和内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return 0;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].和;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.和内部(2 * 節, lo, m, l, r) + self.和内部(2 * 節 + 1, m, hi, l, r)",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の最大値。ならし `O(log N)`。",
      "    fn 区間最大(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.最大内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 最大内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return -無限大;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].最大1;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.最大内部(2 * 節, lo, m, l, r)",
      "            .max(self.最大内部(2 * 節 + 1, m, hi, l, r))",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の最小値。ならし `O(log N)`。",
      "    fn 区間最小(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.最小内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 最小内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return 無限大;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].最小1;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.最小内部(2 * 節, lo, m, l, r)",
      "            .min(self.最小内部(2 * 節 + 1, m, hi, l, r))",
      "    }",
      "}"
    ]
  },
  "区間_最頻値": {
    "scope": "rust",
    "prefix": "区間_最頻値",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 静的配列の区間最頻値（最も多く出現する値とその回数）を `O(√N)` で答えるデータ構造。",
      "/// 平方分割。構築 `O(N√N)`、1 クエリ `O(√N log N)`。",
      "/// 区間最頻値は和や最小と違って差分が取れず、セグ木では扱えない。Mo でもオフラインで解けるが、",
      "/// 本構造はオンライン（クエリを即時に答える）。[`ウェーブレット行列`](crate::wavelet_matrix)の",
      "/// 区間 k 番目とも別問題。",
      "/// 値の型 `T` は座標圧縮のため順序比較できる型なら何でもよい（`i64`・`&str` など `Ord`）。",
      "struct 区間最頻値<T> {",
      "    元: Vec<usize>,",
      "    値表: Vec<T>,",
      "    位置: Vec<Vec<usize>>,",
      "    幅: usize,",
      "    ブロック最頻: Vec<Vec<(usize, usize)>>,",
      "}",
      "impl<T: Ord + Copy> 区間最頻値<T> {",
      "    /// 配列から構築する。`O(N√N)`。",
      "    fn new(配列: &[T]) -> Self {",
      "        let n = 配列.len();",
      "        let mut 値表: Vec<T> = 配列.to_vec();",
      "        値表.sort_unstable();",
      "        値表.dedup();",
      "        let 元: Vec<usize> = 配列",
      "            .iter()",
      "            .map(|x| 値表.partition_point(|&y| y < *x))",
      "            .collect();",
      "        let mut 位置 = vec![Vec::new(); 値表.len()];",
      "        for (i, &v) in 元.iter().enumerate() {",
      "            位置[v].push(i);",
      "        }",
      "        let 幅 = ((n as f64).sqrt() as usize).max(1);",
      "        let ブロック数 = n.div_ceil(幅);",
      "        let mut ブロック最頻 = vec![vec![(0usize, 0usize); ブロック数]; ブロック数];",
      "        let mut 個数 = vec![0usize; 値表.len()];",
      "        for (bi, 行) in ブロック最頻.iter_mut().enumerate() {",
      "            個数.fill(0);",
      "            let mut 現数 = 0usize;",
      "            let mut 現値 = 0usize;",
      "            for (bj, セル) in 行.iter_mut().enumerate().skip(bi) {",
      "                let lo = bj * 幅;",
      "                let hi = ((bj + 1) * 幅).min(n);",
      "                for &v in &元[lo..hi] {",
      "                    個数[v] += 1;",
      "                    if 個数[v] > 現数 {",
      "                        現数 = 個数[v];",
      "                        現値 = v;",
      "                    }",
      "                }",
      "                *セル = (現数, 現値);",
      "            }",
      "        }",
      "        区間最頻値 {",
      "            元,",
      "            値表,",
      "            位置,",
      "            幅,",
      "            ブロック最頻,",
      "        }",
      "    }",
      "    /// 圧縮値 `v` が `[l, r]`（両端含む）に出現する回数。`O(log N)`。",
      "    fn 区間出現数(&self, v: usize, l: usize, r: usize) -> usize {",
      "        let p = &self.位置[v];",
      "        let lo = p.partition_point(|&x| x < l);",
      "        let hi = p.partition_point(|&x| x <= r);",
      "        hi - lo",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など、0-indexed）の最頻値 `(値, 出現回数)` を返す。`O(√N)`。",
      "    /// 空区間は問い合わせ不可。",
      "    /// 同点の値が複数あるときはそのうちの 1 つを返す（回数は最大値で一意）。",
      "    fn クエリ(&self, 範囲: impl std::ops::RangeBounds<usize>) -> (T, usize) {",
      "        let (l, 半開右) = 半開(範囲, self.元.len());",
      "        assert!(l < 半開右, \"区間最頻値: 空区間は問い合わせ不可\");",
      "        let r = 半開右 - 1;",
      "        let bl = l / self.幅;",
      "        let br = r / self.幅;",
      "        if bl == br {",
      "            let mut 最良数 = 0usize;",
      "            let mut 最良値 = 0usize;",
      "            for &v in &self.元[l..=r] {",
      "                let c = self.区間出現数(v, l, r);",
      "                if c > 最良数 {",
      "                    最良数 = c;",
      "                    最良値 = v;",
      "                }",
      "            }",
      "            return (self.値表[最良値], 最良数);",
      "        }",
      "        let (mut 最良数, mut 最良値) = if bl + 2 <= br {",
      "            self.ブロック最頻[bl + 1][br - 1]",
      "        } else {",
      "            (0usize, 0usize)",
      "        };",
      "        let 左終 = ((bl + 1) * self.幅).min(self.元.len());",
      "        for &v in &self.元[l..左終] {",
      "            let c = self.区間出現数(v, l, r);",
      "            if c > 最良数 {",
      "                最良数 = c;",
      "                最良値 = v;",
      "            }",
      "        }",
      "        for &v in &self.元[br * self.幅..=r] {",
      "            let c = self.区間出現数(v, l, r);",
      "            if c > 最良数 {",
      "                最良数 = c;",
      "                最良値 = v;",
      "            }",
      "        }",
      "        (self.値表[最良値], 最良数)",
      "    }",
      "}"
    ]
  },
  "区間_積": {
    "scope": "rust",
    "prefix": "区間_積",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 分割スパーステーブル（Disjoint Sparse Table）。静的（更新なし）配列に対し、",
      "/// 「結合的だが冪等とは限らない」二項演算（和・積・xor・gcd・行列積・アフィン合成など）の",
      "/// 区間クエリを前処理 `O(N log N)`・各クエリ `O(1)` で答える。",
      "/// 通常のスパーステーブル（[`crate::sparse_table`]）は冪等演算（min/max/gcd）専用。こちらは",
      "/// **非可換・非冪等**な演算でも使える。",
      "/// - `merge` は結合的であること（可換・冪等は不要）。順序は `merge(左側, 右側)` で保たれる。",
      "struct 分割スパーステーブル<T, F> {",
      "    元: Vec<T>,",
      "    テーブル: Vec<Vec<T>>,",
      "    merge: F,",
      "}",
      "impl<T: Copy, F: Fn(T, T) -> T> 分割スパーステーブル<T, F> {",
      "    /// 配列と結合的な二項演算 `merge` から分割スパーステーブルを構築する。",
      "    /// # 例",
      "    /// ```ignore",
      "    /// let st = 分割スパーステーブル::new(&a, |x, y| x + y); // 区間和",
      "    /// assert_eq!(st.区間(1..4), a[1] + a[2] + a[3]);",
      "    /// ```",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn new(配列: &[T], merge: F) -> Self {",
      "        let n = 配列.len();",
      "        let mut レベル数 = 1;",
      "        while (1usize << レベル数) < n {",
      "            レベル数 += 1;",
      "        }",
      "        let mut テーブル = vec![配列.to_vec(); レベル数];",
      "        for k in 0..レベル数 {",
      "            let 半 = 1usize << k;",
      "            let 幅 = 半 * 2;",
      "            let mut s = 0;",
      "            while s < n {",
      "                let 中 = s + 半;",
      "                let 左終 = 中.min(n);",
      "                for i in (s..左終 - 1).rev() {",
      "                    テーブル[k][i] = merge(配列[i], テーブル[k][i + 1]);",
      "                }",
      "                if 中 < n {",
      "                    let 右終 = (s + 幅).min(n);",
      "                    for i in 中 + 1..右終 {",
      "                        テーブル[k][i] = merge(テーブル[k][i - 1], 配列[i]);",
      "                    }",
      "                }",
      "                s += 幅;",
      "            }",
      "        }",
      "        Self {",
      "            元: 配列.to_vec(),",
      "            テーブル,",
      "            merge,",
      "        }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対する `merge` の畳み込み（左→右の順）を",
      "    /// O(1) で返す。空区間は問い合わせ不可。",
      "    fn 区間(&self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.元.len());",
      "        debug_assert!(l < r, \"分割スパーステーブル: 空区間は問い合わせ不可\");",
      "        let 右 = r - 1;",
      "        if l == 右 {",
      "            return self.元[l];",
      "        }",
      "        let k = (usize::BITS - 1 - (l ^ 右).leading_zeros()) as usize;",
      "        (self.merge)(self.テーブル[k][l], self.テーブル[k][右])",
      "    }",
      "}"
    ]
  },
  "区間_第_k_小": {
    "scope": "rust",
    "prefix": "区間_第_k_小",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// rank 補助付きビットベクトル（ウェーブレット行列の各層）。64 ビットブロック + 累積 popcount。",
      "struct ビットベクトル {",
      "    bits: Vec<u64>,",
      "    累積: Vec<u32>,",
      "}",
      "impl ビットベクトル {",
      "    fn new(n: usize) -> Self {",
      "        let ブロック数 = n / 64 + 1;",
      "        Self {",
      "            bits: vec![0; ブロック数],",
      "            累積: vec![0; ブロック数 + 1],",
      "        }",
      "    }",
      "    fn 立てる(&mut self, i: usize) {",
      "        self.bits[i / 64] |= 1 << (i % 64);",
      "    }",
      "    fn 構築(&mut self) {",
      "        for i in 0..self.bits.len() {",
      "            self.累積[i + 1] = self.累積[i] + self.bits[i].count_ones();",
      "        }",
      "    }",
      "    /// `[0, i)` に含まれる 1 の個数。",
      "    fn rank1(&self, i: usize) -> usize {",
      "        let ブロック = i / 64;",
      "        let 余り = i % 64;",
      "        let マスク = if 余り == 0 {",
      "            0",
      "        } else {",
      "            self.bits[ブロック] & ((1u64 << 余り) - 1)",
      "        };",
      "        self.累積[ブロック] as usize + マスク.count_ones() as usize",
      "    }",
      "    /// `[0, i)` に含まれる 0 の個数。",
      "    fn rank0(&self, i: usize) -> usize {",
      "        i - self.rank1(i)",
      "    }",
      "}",
      "/// ウェーブレット行列。非負整数列に対し「位置区間 `[l, r)` の第 k 小」「位置区間 × 値域の個数」を",
      "/// それぞれ O(ビット長) で答える静的構造。構築 O(N·ビット長)。",
      "/// 位置・値域はいずれも `a..b` / `a..=b` / `..b` / `a..` / `..` を受け取れる（`RangeBounds`）。",
      "/// 値域が広くても座標圧縮なしに `u64` のまま扱える（ビット長は最大値で決まる）。",
      "/// 同種の用途（区間第 k 小・順位）を提供するクレートは AtCoder 標準セットにないため自作する。",
      "struct ウェーブレット行列 {",
      "    n: usize,",
      "    ビット数: usize,",
      "    層: Vec<ビットベクトル>,",
      "    ゼロ数: Vec<usize>,",
      "}",
      "impl ウェーブレット行列 {",
      "    /// 非負整数列から構築する。",
      "    fn new(配列: &[impl TryInto<u64> + Copy]) -> Self {",
      "        let 配列: Vec<u64> = 配列",
      "            .iter()",
      "            .map(|&x| {",
      "                x.try_into()",
      "                    .ok()",
      "                    .expect(\"WaveletMatrix: 引数が u64 に収まりません\")",
      "            })",
      "            .collect();",
      "        let n = 配列.len();",
      "        let 最大 = 配列.iter().copied().max().unwrap_or(0);",
      "        let ビット数 = (64 - 最大.leading_zeros() as usize).max(1);",
      "        let mut 現在 = 配列.to_vec();",
      "        let mut 層 = Vec::with_capacity(ビット数);",
      "        let mut ゼロ数 = Vec::with_capacity(ビット数);",
      "        for b in (0..ビット数).rev() {",
      "            let mut bv = ビットベクトル::new(n);",
      "            for (i, &x) in 現在.iter().enumerate() {",
      "                if x >> b & 1 == 1 {",
      "                    bv.立てる(i);",
      "                }",
      "            }",
      "            bv.構築();",
      "            let mut ゼロ群 = Vec::with_capacity(n);",
      "            let mut 一群 = Vec::new();",
      "            for &x in &現在 {",
      "                if x >> b & 1 == 1 {",
      "                    一群.push(x);",
      "                } else {",
      "                    ゼロ群.push(x);",
      "                }",
      "            }",
      "            ゼロ数.push(ゼロ群.len());",
      "            ゼロ群.extend(一群);",
      "            現在 = ゼロ群;",
      "            層.push(bv);",
      "        }",
      "        Self {",
      "            n,",
      "            ビット数,",
      "            層,",
      "            ゼロ数,",
      "        }",
      "    }",
      "    /// 位置範囲 `位置`（`a..b` / `a..=b` / `..` など）で `k` 番目（0-indexed、昇順）に",
      "    /// 小さい値。`k < 範囲の長さ` であること。",
      "    fn 区間k番目(&self, 位置: impl std::ops::RangeBounds<usize>, mut k: usize) -> usize {",
      "        let (mut l, mut r) = 半開(位置, self.n);",
      "        assert!(l <= r && r <= self.n && k < r - l, \"区間k番目: 範囲外\");",
      "        let mut 結果 = 0u64;",
      "        for d in 0..self.ビット数 {",
      "            let bv = &self.層[d];",
      "            let l0 = bv.rank0(l);",
      "            let r0 = bv.rank0(r);",
      "            let ゼロ個 = r0 - l0;",
      "            if k < ゼロ個 {",
      "                l = l0;",
      "                r = r0;",
      "            } else {",
      "                結果 |= 1 << (self.ビット数 - 1 - d);",
      "                k -= ゼロ個;",
      "                let z = self.ゼロ数[d];",
      "                l = z + (l - l0);",
      "                r = z + (r - r0);",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 位置 `[l, r)` の中で値が `x` 未満である要素の個数（内部プリミティブ）。",
      "    fn 未満数(&self, mut l: usize, mut r: usize, x: u64) -> usize {",
      "        if x >> self.ビット数 != 0 {",
      "            return r - l;",
      "        }",
      "        let mut 個数 = 0usize;",
      "        for d in 0..self.ビット数 {",
      "            let bv = &self.層[d];",
      "            let l0 = bv.rank0(l);",
      "            let r0 = bv.rank0(r);",
      "            if x >> (self.ビット数 - 1 - d) & 1 == 1 {",
      "                個数 += r0 - l0;",
      "                let z = self.ゼロ数[d];",
      "                l = z + (l - l0);",
      "                r = z + (r - r0);",
      "            } else {",
      "                l = l0;",
      "                r = r0;",
      "            }",
      "        }",
      "        個数",
      "    }",
      "    /// 位置範囲 `位置` にある要素のうち、値が `値域` に入るものの個数。",
      "    /// 位置は `a..b` / `a..=b` / `..` など、値域は `a..b` / `a..=b` / `..b`（＝旧「未満の個数」）/",
      "    /// `a..` / `..` などを受け取れる。値域の端点は `i64`・`usize` など `u64` へ変換できる整数型で",
      "    /// よい（負や超過は panic）。",
      "    fn 区間内個数<T: Copy + TryInto<u64>>(",
      "        &self,",
      "        位置: impl std::ops::RangeBounds<usize>,",
      "        値域: impl std::ops::RangeBounds<T>,",
      "    ) -> usize {",
      "        use std::ops::Bound::{Excluded, Included, Unbounded};",
      "        let (l, r) = 半開(位置, self.n);",
      "        assert!(l <= r && r <= self.n, \"区間内個数: 範囲外\");",
      "        let 上限個数 = match 値域.end_bound() {",
      "            Included(&x) => self.未満数(l, r, to_u64(x).saturating_add(1)),",
      "            Excluded(&x) => self.未満数(l, r, to_u64(x)),",
      "            Unbounded => r - l,",
      "        };",
      "        let 下限個数 = match 値域.start_bound() {",
      "            Included(&x) => self.未満数(l, r, to_u64(x)),",
      "            Excluded(&x) => self.未満数(l, r, to_u64(x).saturating_add(1)),",
      "            Unbounded => 0,",
      "        };",
      "        上限個数.saturating_sub(下限個数)",
      "    }",
      "}"
    ]
  },
  "区間_管理": {
    "scope": "rust",
    "prefix": "区間_管理",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::collections::BTreeMap;",
      "/// 互いに素な半開区間 `[l, r)` の集合を `BTreeMap` で管理する「区間を set で管理」テクニックの実装。",
      "/// 区間の追加（和）・削除、点の被覆判定、被覆長、`mex`（被覆されていない最小値）を扱う。",
      "/// 隣接する区間（端が接する）は自動的に併合され、常に互いに素かつ非隣接な正規形を保つ。",
      "/// 各操作は併合・分割した区間数を `k` として `O((k+1) log n)`、全体で償却効率が良い。",
      "#[derive(Default, Clone, Debug)]",
      "struct 区間集合 {",
      "    区間: BTreeMap<i64, i64>,",
      "    被覆: i64,",
      "}",
      "impl 区間集合 {",
      "    /// 空の区間集合を作る。",
      "    fn new() -> Self {",
      "        Self::default()",
      "    }",
      "    /// `RangeBounds` を半開区間 `[l, r)`（i64）に解決する。土台の値域が無いので両端は必須",
      "    /// （`..` / `l..` / `..r` は panic。`l..r` か `l..=r` を使う）。",
      "    fn 半開<T: Copy + TryInto<i64>>(範囲: impl std::ops::RangeBounds<T>) -> (i64, i64) {",
      "        use std::ops::Bound::{Excluded, Included, Unbounded};",
      "        let l = match 範囲.start_bound() {",
      "            Included(&x) => to_i64(x),",
      "            Excluded(&x) => to_i64(x) + 1,",
      "            Unbounded => panic!(\"区間集合: 下端は必須（l..r か l..=r を使う）\"),",
      "        };",
      "        let r = match 範囲.end_bound() {",
      "            Included(&x) => to_i64(x) + 1,",
      "            Excluded(&x) => to_i64(x),",
      "            Unbounded => panic!(\"区間集合: 上端は必須（l..r か l..=r を使う）\"),",
      "        };",
      "        (l, r)",
      "    }",
      "    /// 区間（`l..r`=半開 / `l..=r`=閉）を追加（和を取る）。重なり・隣接する既存区間はすべて",
      "    /// 1 本に併合される。整数型は任意（usize / i64 など。ただし両端は同じ型）。",
      "    fn 追加<T: Copy + TryInto<i64>>(&mut self, 範囲: impl std::ops::RangeBounds<T>) {",
      "        let (l, r) = Self::半開(範囲);",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let mut nl = l;",
      "        let mut nr = r;",
      "        let 対象: Vec<i64> = self",
      "            .区間",
      "            .range(..=r)",
      "            .filter(|&(_, &e)| e >= l)",
      "            .map(|(&s, _)| s)",
      "            .collect();",
      "        for s in 対象 {",
      "            let e = self.区間.remove(&s).unwrap();",
      "            self.被覆 -= e - s;",
      "            nl = nl.min(s);",
      "            nr = nr.max(e);",
      "        }",
      "        self.被覆 += nr - nl;",
      "        self.区間.insert(nl, nr);",
      "    }",
      "    /// 区間（`l..r`=半開 / `l..=r`=閉）を削除する。またがる既存区間は両端で分割される。",
      "    fn 削除<T: Copy + TryInto<i64>>(&mut self, 範囲: impl std::ops::RangeBounds<T>) {",
      "        let (l, r) = Self::半開(範囲);",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let 対象: Vec<i64> = self",
      "            .区間",
      "            .range(..r)",
      "            .filter(|&(_, &e)| e > l)",
      "            .map(|(&s, _)| s)",
      "            .collect();",
      "        for s in 対象 {",
      "            let e = self.区間.remove(&s).unwrap();",
      "            self.被覆 -= e - s;",
      "            if s < l {",
      "                self.被覆 += l - s;",
      "                self.区間.insert(s, l);",
      "            }",
      "            if e > r {",
      "                self.被覆 += e - r;",
      "                self.区間.insert(r, e);",
      "            }",
      "        }",
      "    }",
      "    /// 点 `x` が被覆されているか（いずれかの区間に含まれるか）を返す。",
      "    fn 含む(&self, x: impl TryInto<i64>) -> bool {",
      "        let x = to_i64(x);",
      "        self.区間",
      "            .range(..=x)",
      "            .next_back()",
      "            .is_some_and(|(_, &e)| e > x)",
      "    }",
      "    /// 点 `x` を含む区間 `[l, r)` を返す。含まれなければ `None`。",
      "    fn 区間取得(&self, x: impl TryInto<i64>) -> Option<(i64, i64)> {",
      "        let x = to_i64(x);",
      "        self.区間",
      "            .range(..=x)",
      "            .next_back()",
      "            .and_then(|(&s, &e)| if e > x { Some((s, e)) } else { None })",
      "    }",
      "    /// `x` 以上で被覆されていない最小の整数（mex）を返す。`x` 自身が空きならそのまま `x`。",
      "    fn mex(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        match self.区間取得(x) {",
      "            Some((_, e)) => e,",
      "            None => x,",
      "        }",
      "    }",
      "    /// 被覆されている整数の総数（= 全区間の長さの和）。",
      "    fn 被覆長(&self) -> i64 {",
      "        self.被覆",
      "    }",
      "    /// 現在の区間一覧を始点昇順の `(l, r)` で返す。",
      "    fn 区間列(&self) -> Vec<(i64, i64)> {",
      "        self.区間.iter().map(|(&s, &e)| (s, e)).collect()",
      "    }",
      "}"
    ]
  },
  "区間_篩": {
    "scope": "rust",
    "prefix": "区間_篩",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 区間（`l..r`=半開 / `l..=r`=閉。`..=r` のように下端省略も可）に含まれる素数をすべて昇順で返す",
      "/// **区間篩**。`r` が `10¹²` 程度でも、区間幅 `r−l` が小さければ高速に列挙できる。計算量",
      "/// `O((√r) + (r−l) loglog r)`、追加メモリ `O(√r + 区間幅)`。上端は必須（土台の長さが無いので",
      "/// `..` や `l..` は解決できず panic）。",
      "/// 同じファイルの [`素因数分解器`] は上限 `5·10⁷` までの線形篩なので `r` が大きいと使えない。",
      "/// 区間篩は「`10¹²` 近辺の素数」のように上限だけ大きく幅が狭い場合に使う。",
      "fn 区間篩<T: Copy + TryInto<u64>>(範囲: impl std::ops::RangeBounds<T>) -> Vec<usize> {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let 変換 = |x: T| -> u64 {",
      "        x.try_into()",
      "            .ok()",
      "            .expect(\"区間篩: 引数が u64 に収まりません\")",
      "    };",
      "    let l: u64 = match 範囲.start_bound() {",
      "        Included(&x) => 変換(x),",
      "        Excluded(&x) => 変換(x).saturating_add(1),",
      "        Unbounded => 0,",
      "    };",
      "    let r: u64 = match 範囲.end_bound() {",
      "        Included(&x) => 変換(x),",
      "        Excluded(&x) => 変換(x).saturating_sub(1),",
      "        Unbounded => panic!(\"区間篩: 上端は必須（.. や l.. は不可。l..r か l..=r を使う）\"),",
      "    };",
      "    if r < 2 || l > r {",
      "        return Vec::new();",
      "    }",
      "    let l = l.max(2);",
      "    let lim = (r as f64).sqrt() as u64 + 2;",
      "    let mut 合成基底 = vec![false; (lim + 1) as usize];",
      "    let mut 基底素数 = Vec::new();",
      "    for i in 2..=lim {",
      "        if !合成基底[i as usize] {",
      "            基底素数.push(i);",
      "            let mut j = i * i;",
      "            while j <= lim {",
      "                合成基底[j as usize] = true;",
      "                j += i;",
      "            }",
      "        }",
      "    }",
      "    let 幅 = (r - l + 1) as usize;",
      "    let mut 合成 = vec![false; 幅];",
      "    for &p in &基底素数 {",
      "        let mut 始 = l.div_ceil(p) * p;",
      "        始 = 始.max(p * p);",
      "        let mut j = 始;",
      "        while j <= r {",
      "            合成[(j - l) as usize] = true;",
      "            j += p;",
      "        }",
      "    }",
      "    (l..=r)",
      "        .filter(|&x| !合成[(x - l) as usize])",
      "        .map(|x| x as usize)",
      "        .collect()",
      "}"
    ]
  },
  "区間_集合": {
    "scope": "rust",
    "prefix": "区間_集合",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::collections::BTreeMap;",
      "/// 互いに素な半開区間 `[l, r)` の集合を `BTreeMap` で管理する「区間を set で管理」テクニックの実装。",
      "/// 区間の追加（和）・削除、点の被覆判定、被覆長、`mex`（被覆されていない最小値）を扱う。",
      "/// 隣接する区間（端が接する）は自動的に併合され、常に互いに素かつ非隣接な正規形を保つ。",
      "/// 各操作は併合・分割した区間数を `k` として `O((k+1) log n)`、全体で償却効率が良い。",
      "#[derive(Default, Clone, Debug)]",
      "struct 区間集合 {",
      "    区間: BTreeMap<i64, i64>,",
      "    被覆: i64,",
      "}",
      "impl 区間集合 {",
      "    /// 空の区間集合を作る。",
      "    fn new() -> Self {",
      "        Self::default()",
      "    }",
      "    /// `RangeBounds` を半開区間 `[l, r)`（i64）に解決する。土台の値域が無いので両端は必須",
      "    /// （`..` / `l..` / `..r` は panic。`l..r` か `l..=r` を使う）。",
      "    fn 半開<T: Copy + TryInto<i64>>(範囲: impl std::ops::RangeBounds<T>) -> (i64, i64) {",
      "        use std::ops::Bound::{Excluded, Included, Unbounded};",
      "        let l = match 範囲.start_bound() {",
      "            Included(&x) => to_i64(x),",
      "            Excluded(&x) => to_i64(x) + 1,",
      "            Unbounded => panic!(\"区間集合: 下端は必須（l..r か l..=r を使う）\"),",
      "        };",
      "        let r = match 範囲.end_bound() {",
      "            Included(&x) => to_i64(x) + 1,",
      "            Excluded(&x) => to_i64(x),",
      "            Unbounded => panic!(\"区間集合: 上端は必須（l..r か l..=r を使う）\"),",
      "        };",
      "        (l, r)",
      "    }",
      "    /// 区間（`l..r`=半開 / `l..=r`=閉）を追加（和を取る）。重なり・隣接する既存区間はすべて",
      "    /// 1 本に併合される。整数型は任意（usize / i64 など。ただし両端は同じ型）。",
      "    fn 追加<T: Copy + TryInto<i64>>(&mut self, 範囲: impl std::ops::RangeBounds<T>) {",
      "        let (l, r) = Self::半開(範囲);",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let mut nl = l;",
      "        let mut nr = r;",
      "        let 対象: Vec<i64> = self",
      "            .区間",
      "            .range(..=r)",
      "            .filter(|&(_, &e)| e >= l)",
      "            .map(|(&s, _)| s)",
      "            .collect();",
      "        for s in 対象 {",
      "            let e = self.区間.remove(&s).unwrap();",
      "            self.被覆 -= e - s;",
      "            nl = nl.min(s);",
      "            nr = nr.max(e);",
      "        }",
      "        self.被覆 += nr - nl;",
      "        self.区間.insert(nl, nr);",
      "    }",
      "    /// 区間（`l..r`=半開 / `l..=r`=閉）を削除する。またがる既存区間は両端で分割される。",
      "    fn 削除<T: Copy + TryInto<i64>>(&mut self, 範囲: impl std::ops::RangeBounds<T>) {",
      "        let (l, r) = Self::半開(範囲);",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let 対象: Vec<i64> = self",
      "            .区間",
      "            .range(..r)",
      "            .filter(|&(_, &e)| e > l)",
      "            .map(|(&s, _)| s)",
      "            .collect();",
      "        for s in 対象 {",
      "            let e = self.区間.remove(&s).unwrap();",
      "            self.被覆 -= e - s;",
      "            if s < l {",
      "                self.被覆 += l - s;",
      "                self.区間.insert(s, l);",
      "            }",
      "            if e > r {",
      "                self.被覆 += e - r;",
      "                self.区間.insert(r, e);",
      "            }",
      "        }",
      "    }",
      "    /// 点 `x` が被覆されているか（いずれかの区間に含まれるか）を返す。",
      "    fn 含む(&self, x: impl TryInto<i64>) -> bool {",
      "        let x = to_i64(x);",
      "        self.区間",
      "            .range(..=x)",
      "            .next_back()",
      "            .is_some_and(|(_, &e)| e > x)",
      "    }",
      "    /// 点 `x` を含む区間 `[l, r)` を返す。含まれなければ `None`。",
      "    fn 区間取得(&self, x: impl TryInto<i64>) -> Option<(i64, i64)> {",
      "        let x = to_i64(x);",
      "        self.区間",
      "            .range(..=x)",
      "            .next_back()",
      "            .and_then(|(&s, &e)| if e > x { Some((s, e)) } else { None })",
      "    }",
      "    /// `x` 以上で被覆されていない最小の整数（mex）を返す。`x` 自身が空きならそのまま `x`。",
      "    fn mex(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        match self.区間取得(x) {",
      "            Some((_, e)) => e,",
      "            None => x,",
      "        }",
      "    }",
      "    /// 被覆されている整数の総数（= 全区間の長さの和）。",
      "    fn 被覆長(&self) -> i64 {",
      "        self.被覆",
      "    }",
      "    /// 現在の区間一覧を始点昇順の `(l, r)` で返す。",
      "    fn 区間列(&self) -> Vec<(i64, i64)> {",
      "        self.区間.iter().map(|(&s, &e)| (s, e)).collect()",
      "    }",
      "}"
    ]
  },
