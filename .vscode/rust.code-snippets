    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::cmp::Ordering;",
      "fn 偏角グループ<T: Copy + PartialOrd + Default>((x, y): (T, T)) -> i32 {",
      "    let z = T::default();",
      "    if y > z || (y == z && x > z) {",
      "        0",
      "    } else {",
      "        1",
      "    }",
      "}",
      "/// 2次元ベクトル `a`, `b` の外積 `a×b = a.x*b.y - a.y*b.x` を i64 で返す。",
      "/// 符号: 正 → b は a の反時計回り側、負 → 時計回り側、0 → 平行。",
      "/// `i32`・`i64` など `Into<i64>` な整数型に対応。座標の絶対値が 2×10^9 以下で安全。",
      "fn 外積<T: Copy + Into<i64>>(a: (T, T), b: (T, T)) -> i64 {",
      "    a.0.into() * b.1.into() - a.1.into() * b.0.into()",
      "}",
      "/// x 軸正方向を起点に反時計回りで点を並べる偏角比較。",
      "/// 原点 `(0, 0)` は常に先頭（他の全点より `Less`）。",
      "/// 偏角が同じ点同士は `Equal` を返す（ノルムでは比較しない）。",
      "/// `i32`・`i64` など `Into<i64>` な整数型のタプルに対応。座標の絶対値が 2×10^9 以下で安全。",
      "/// ```ignore",
      "/// points.sort_by(|a, b| a.cmp_偏角(b));",
      "/// ```",
      "trait 偏角Ord {",
      "    fn cmp_偏角(&self, other: &Self) -> Ordering;",
      "}",
      "impl<T> 偏角Ord for (T, T)",
      "where",
      "    T: Copy + Into<i64> + Default + PartialOrd,",
      "{",
      "    fn cmp_偏角(&self, other: &Self) -> Ordering {",
      "        let z = T::default();",
      "        let za = self.0 == z && self.1 == z;",
      "        let zb = other.0 == z && other.1 == z;",
      "        match (za, zb) {",
      "            (true, true) => return Ordering::Equal,",
      "            (true, false) => return Ordering::Less,",
      "            (false, true) => return Ordering::Greater,",
      "            (false, false) => {}",
      "        }",
      "        let ha = 偏角グループ(*self);",
      "        let hb = 偏角グループ(*other);",
      "        if ha != hb {",
      "            return ha.cmp(&hb);",
      "        }",
      "        let c = 外積(*self, *other);",
      "        if c > 0 {",
      "            Ordering::Less",
      "        } else if c < 0 {",
      "            Ordering::Greater",
      "        } else {",
      "            Ordering::Equal",
      "        }",
      "    }",
      "}"
    ]
  },
