  "巻き戻し_Mo": {
    "scope": "rust",
    "prefix": "巻き戻し_Mo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 「追加は容易だが削除が難しい」区間クエリを扱うロールバック Mo の状態インタフェース。",
      "/// 削除の代わりに、チェックポイント [`保存`](ロールバックMo::保存) と",
      "/// [`巻き戻し`](ロールバックMo::巻き戻し) で状態を巻き戻す。区間の左側の一時追加を",
      "/// 巻き戻すことで、各左ブロック内で右ポインタを単調増加に保ったまま処理できる。",
      "/// 素の [`Mo`](crate::mo)・[更新あり Mo](crate::mo_with_updates) とは別アルゴリズム。",
      "/// 連結性（rollback 可能 union-find）や max・mode 系で使う。",
      "trait ロールバックMo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 位置 `位置` の要素を現在の集合に加える（削除は無い）。",
      "    fn 追加(&mut self, 位置: usize);",
      "    /// 現在の状態をチェックポイントとして積む。",
      "    fn 保存(&mut self);",
      "    /// 直近のチェックポイントまで状態を巻き戻す（その時点以降の追加を取り消す）。",
      "    fn 巻き戻し(&mut self);",
      "    /// 状態を空に戻す（各左ブロックの処理開始時に呼ばれる）。",
      "    fn 全消去(&mut self);",
      "    /// 現在の集合に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// ロールバック Mo 本体。`n` は要素数、`クエリ` は半開区間 `[l, r)`（`l < r`）の列。",
      "/// 全体 `O((N + Q)√N · 追加コスト)`。`状態` は空の初期状態で渡すこと。",
      "fn ロールバックmo実行<S: ロールバックMo>(",
      "    状態: &mut S,",
      "    n: usize,",
      "    クエリ: &[(usize, usize)],",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    if q == 0 {",
      "        return Vec::new();",
      "    }",
      "    let b = ((n as f64).sqrt() as usize).max(1);",
      "    let mut 順: Vec<usize> = (0..q).collect();",
      "    順.sort_by(|&x, &y| {",
      "        let (lx, rx) = クエリ[x];",
      "        let (ly, ry) = クエリ[y];",
      "        let (bx, by) = (lx / b, ly / b);",
      "        if bx != by {",
      "            bx.cmp(&by)",
      "        } else {",
      "            rx.cmp(&ry)",
      "        }",
      "    });",
      "    let mut 答え: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let mut idx = 0;",
      "    while idx < 順.len() {",
      "        let ブロック = クエリ[順[idx]].0 / b;",
      "        let r0 = ((ブロック + 1) * b).min(n);",
      "        状態.全消去();",
      "        let mut 右 = r0;",
      "        while idx < 順.len() && クエリ[順[idx]].0 / b == ブロック {",
      "            let i = 順[idx];",
      "            let (l, r) = クエリ[i];",
      "            if r <= r0 {",
      "                状態.保存();",
      "                for p in l..r {",
      "                    状態.追加(p);",
      "                }",
      "                答え[i] = Some(状態.答え());",
      "                状態.巻き戻し();",
      "                idx += 1;",
      "                continue;",
      "            }",
      "            while 右 < r {",
      "                状態.追加(右);",
      "                右 += 1;",
      "            }",
      "            状態.保存();",
      "            for p in (l..r0).rev() {",
      "                状態.追加(p);",
      "            }",
      "            答え[i] = Some(状態.答え());",
      "            状態.巻き戻し();",
      "            idx += 1;",
      "        }",
      "    }",
      "    答え.into_iter().map(|o| o.unwrap()).collect()",
      "}"
    ]
  },
  "巻き戻し_UnionFind": {
    "scope": "rust",
    "prefix": "巻き戻し_UnionFind",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巻き戻し（Undo）可能な Union-Find。経路圧縮を行わずユニオン by サイズのみで結合し、",
      "/// 各結合の変更を履歴に積むことで任意時点へ `O(操作数)` で復元できる。",
      "/// `ac_library::Dsu` は経路圧縮するため undo できない。オフライン動的連結性",
      "/// （時間方向のセグメント木上の分割統治）などで「結合 → 探索 → 巻き戻し」を繰り返す用途に使う。",
      "/// `根`・`同じ`・`サイズ` は経路圧縮なしの O(log N)。",
      "struct ロールバック可能UnionFind {",
      "    /// 根なら `-(サイズ)`、非根なら親の添字。",
      "    親orサイズ: Vec<i64>,",
      "    /// `(書き換えた添字, 直前の値)` の履歴。1 回の結合で 2 件積む。",
      "    履歴: Vec<(usize, i64)>,",
      "}",
      "impl ロールバック可能UnionFind {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親orサイズ: vec![-1; n],",
      "            履歴: Vec::new(),",
      "        }",
      "    }",
      "    /// `x` の根（経路圧縮なし）。",
      "    fn 根(&self, mut x: usize) -> usize {",
      "        while self.親orサイズ[x] >= 0 {",
      "            x = self.親orサイズ[x] as usize;",
      "        }",
      "        x",
      "    }",
      "    /// `x` と `y` を結合する。既に同じ集合なら `false`（履歴は積まない）。",
      "    fn 統合(&mut self, x: usize, y: usize) -> bool {",
      "        let mut a = self.根(x);",
      "        let mut b = self.根(y);",
      "        if a == b {",
      "            return false;",
      "        }",
      "        if self.親orサイズ[a] > self.親orサイズ[b] {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        self.履歴.push((a, self.親orサイズ[a]));",
      "        self.履歴.push((b, self.親orサイズ[b]));",
      "        self.親orサイズ[a] += self.親orサイズ[b];",
      "        self.親orサイズ[b] = a as i64;",
      "        true",
      "    }",
      "    /// `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "    /// `x` の属する集合の要素数。",
      "    fn サイズ(&self, x: usize) -> usize {",
      "        let r = self.根(x);",
      "        (-self.親orサイズ[r]) as usize",
      "    }",
      "    /// 現在のスナップショット（履歴の長さ）。[`Self::ロールバック`] に渡す。",
      "    fn 現在時点(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    /// 直近の `統合` 1 回ぶんを取り消す（履歴 2 件を巻き戻す）。",
      "    fn 巻き戻し(&mut self) {",
      "        for _ in 0..2 {",
      "            if let Some((i, v)) = self.履歴.pop() {",
      "                self.親orサイズ[i] = v;",
      "            }",
      "        }",
      "    }",
      "    /// [`Self::現在時点`] で得た時点まで状態を巻き戻す。",
      "    fn ロールバック(&mut self, 時点: usize) {",
      "        while self.履歴.len() > 時点 {",
      "            let (i, v) = self.履歴.pop().unwrap();",
      "            self.親orサイズ[i] = v;",
      "        }",
      "    }",
      "}"
    ]
  },
  "平方_分割_クエリ": {
    "scope": "rust",
    "prefix": "平方_分割_クエリ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Mo のアルゴリズムで扱う区間状態。現在の対象区間 `[l, r)` を 1 要素ずつ伸縮させながら、",
      "/// 各クエリの答えを得るためのインタフェースを実装する。",
      "/// 伸縮は端点の単純な追加・削除で答えを更新できる問題（区間内の種類数・同値ペア数など）に",
      "/// 適用できる。状態は `状態.追加 / 削除` の呼び出しに対し O(1)〜O(log) で更新できること。",
      "trait Mo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 位置 `位置` の要素を現在の対象区間に加える。",
      "    fn 追加(&mut self, 位置: usize);",
      "    /// 位置 `位置` の要素を現在の対象区間から取り除く。",
      "    fn 削除(&mut self, 位置: usize);",
      "    /// 現在の対象区間に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// Mo のアルゴリズム本体。`クエリ` は半開区間 `[l, r)` の列で、各クエリの答えを",
      "/// 入力順に並べて返す。全体 O((N + Q)·√N · 更新コスト)。",
      "/// `状態` は空区間 `[0, 0)` を表す初期状態で渡すこと。`S` は [`Mo`] を実装した型。",
      "fn mo実行<S: Mo>(状態: &mut S, クエリ: &[(usize, usize)]) -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    let mut 答え = Vec::with_capacity(q);",
      "    if q == 0 {",
      "        return 答え;",
      "    }",
      "    let 上限 = クエリ.iter().map(|&(_, r)| r).max().unwrap().max(1);",
      "    let ブロック = ((上限 as f64).sqrt() as usize).max(1);",
      "    let mut 順: Vec<usize> = (0..q).collect();",
      "    順.sort_by(|&a, &b| {",
      "        let (la, ra) = クエリ[a];",
      "        let (lb, rb) = クエリ[b];",
      "        let (ba, bb) = (la / ブロック, lb / ブロック);",
      "        if ba != bb {",
      "            return ba.cmp(&bb);",
      "        }",
      "        if ba % 2 == 0 {",
      "            ra.cmp(&rb)",
      "        } else {",
      "            rb.cmp(&ra)",
      "        }",
      "    });",
      "    let mut 出力: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let (mut cl, mut cr) = (0usize, 0usize);",
      "    for &i in &順 {",
      "        let (l, r) = クエリ[i];",
      "        while cr < r {",
      "            状態.追加(cr);",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            状態.追加(cl);",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            状態.削除(cr);",
      "        }",
      "        while cl < l {",
      "            状態.削除(cl);",
      "            cl += 1;",
      "        }",
      "        出力[i] = Some(状態.答え());",
      "    }",
      "    for o in 出力 {",
      "        答え.push(o.unwrap());",
      "    }",
      "    答え",
      "}"
    ]
  },
  "平方_剰余": {
    "scope": "rust",
    "prefix": "平方_剰余",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `p` を法とする平方根：`x^2 ≡ a (mod p)` を満たす `x` を 1 つ返す（無ければ `None`）。",
      "/// Tonelli-Shanks 法。期待 O(log^2 p)。",
      "/// `p` は**素数**であること。`a` は `mod p` 前で渡してよい。返り値 `x` に対し `p - x` も解。",
      "/// `a ≡ 0` のときは `Some(0)`。平方非剰余なら `None`。`p < 2^31` 程度を想定。",
      "fn modの平方根(a: u64, p: u64) -> Option<u64> {",
      "    let a = a % p;",
      "    if a == 0 {",
      "        return Some(0);",
      "    }",
      "    if p == 2 {",
      "        return Some(a & 1);",
      "    }",
      "    if 累乗_mod(a, (p - 1) / 2, p) != 1 {",
      "        return None;",
      "    }",
      "    if p % 4 == 3 {",
      "        return Some(累乗_mod(a, (p + 1) / 4, p));",
      "    }",
      "    let mut q = p - 1;",
      "    let mut s = 0u32;",
      "    while q % 2 == 0 {",
      "        q /= 2;",
      "        s += 1;",
      "    }",
      "    let mut z = 2u64;",
      "    while 累乗_mod(z, (p - 1) / 2, p) != p - 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = 累乗_mod(z, q, p);",
      "    let mut t = 累乗_mod(a, q, p);",
      "    let mut r = 累乗_mod(a, q.div_ceil(2), p);",
      "    loop {",
      "        if t == 1 {",
      "            return Some(r);",
      "        }",
      "        let mut i = 0u32;",
      "        let mut 暫定 = t;",
      "        while 暫定 != 1 {",
      "            暫定 = 暫定 * 暫定 % p;",
      "            i += 1;",
      "        }",
      "        let b = 累乗_mod(c, 1u64 << (m - i - 1), p);",
      "        m = i;",
      "        c = b * b % p;",
      "        t = t * c % p;",
      "        r = r * b % p;",
      "    }",
      "}"
    ]
  },
  "床関数の_列挙": {
    "scope": "rust",
    "prefix": "床関数の_列挙",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `⌊n/i⌋`（`i = 1..=n`）の値が一定になる `i` の区間をまとめて列挙する。O(√n)。",
      "/// 各要素は `(商, 左, 右)`：`i ∈ [左, 右]` の範囲で `⌊n/i⌋ == 商`。区間は `i` の昇順、",
      "/// `商` は降順に並ぶ。`Σ_{i=1}^{n} ⌊n/i⌋` や約数関数の和などを O(√n) で計算するのに使う。",
      "fn 商の列挙(n: u64) -> Vec<(u64, u64, u64)> {",
      "    let mut res = Vec::new();",
      "    let mut i = 1;",
      "    while i <= n {",
      "        let 商 = n / i;",
      "        let 右 = n / 商;",
      "        res.push((商, i, 右));",
      "        i = 右 + 1;",
      "    }",
      "    res",
      "}"
    ]
  },
  "形式的_冪級数": {
    "scope": "rust",
    "prefix": "形式的_冪級数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, ModInt998244353};",
      "/// 形式的冪級数（FPS）で扱う係数の型。mod 998244353（NTT フレンドリ素数）。",
      "type 係数 = ModInt998244353;",
      "/// 形式的微分。`f = Σ a_i x^i` → `Σ i·a_i x^{i-1}`。",
      "fn 微分(f: &[係数]) -> Vec<係数> {",
      "    if f.len() <= 1 {",
      "        return Vec::new();",
      "    }",
      "    (1..f.len()).map(|i| f[i] * 係数::new(i as u64)).collect()",
      "}",
      "/// 形式的積分。`f = Σ a_i x^i` → `Σ a_i/(i+1) x^{i+1}`（定数項 0）。",
      "fn 積分(f: &[係数]) -> Vec<係数> {",
      "    let mut r = vec![係数::new(0); f.len() + 1];",
      "    for (i, &c) in f.iter().enumerate() {",
      "        r[i + 1] = c * 係数::new((i + 1) as u64).inv();",
      "    }",
      "    r",
      "}",
      "/// `f * g ≡ 1 (mod x^n)` なる逆元 `g`（長さ `n`）を Newton 法で求める。O(n log n)。",
      "/// 定数項が 0 のときは逆元が存在しないので panic する。乗算には `ac_library::convolution`（NTT）を使う。",
      "fn 逆元(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        !f.is_empty() && f[0].val() != 0,",
      "        \"constant term must be nonzero\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut g = vec![f[0].inv()];",
      "    let mut k = 1;",
      "    while k < n {",
      "        k <<= 1;",
      "        let 上限 = k.min(f.len());",
      "        let mut fg = convolution(&f[..上限], &g);",
      "        fg.truncate(k);",
      "        for x in fg.iter_mut() {",
      "            *x = -*x;",
      "        }",
      "        fg[0] += 係数::new(2);",
      "        let mut ng = convolution(&g, &fg);",
      "        ng.truncate(k);",
      "        g = ng;",
      "    }",
      "    g.truncate(n);",
      "    g.resize(n, 係数::new(0));",
      "    g",
      "}",
      "/// `log f` を mod x^n で求める（長さ `n`）。定数項は 1 でなければならない。`log f = ∫ f'/f`。",
      "fn log(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        !f.is_empty() && f[0].val() == 1,",
      "        \"constant term must be 1 for log\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    if n == 1 {",
      "        return vec![係数::new(0)];",
      "    }",
      "    let fd = 微分(f);",
      "    let fi = 逆元(f, n);",
      "    let mut prod = convolution(&fd, &fi);",
      "    prod.truncate(n - 1);",
      "    let mut r = 積分(&prod);",
      "    r.truncate(n);",
      "    r.resize(n, 係数::new(0));",
      "    r",
      "}",
      "/// `exp f` を mod x^n で求める（長さ `n`）。定数項は 0 でなければならない。Newton 法で O(n log n)。",
      "fn exp(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        f.is_empty() || f[0].val() == 0,",
      "        \"constant term must be 0 for exp\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < n {",
      "        k <<= 1;",
      "        let lg = log(&g, k);",
      "        let mut h = vec![係数::new(0); k];",
      "        h[0] = 係数::new(1);",
      "        for (i, hi) in h.iter_mut().enumerate() {",
      "            *hi -= lg[i];",
      "            if i < f.len() {",
      "                *hi += f[i];",
      "            }",
      "        }",
      "        let mut ng = convolution(&g, &h);",
      "        ng.truncate(k);",
      "        g = ng;",
      "    }",
      "    g.truncate(n);",
      "    g.resize(n, 係数::new(0));",
      "    g",
      "}",
      "/// `f^m` を mod x^n で求める（長さ `n`）。最低次の非零項を括り出し `exp(m·log)` で計算する。",
      "/// `f ≡ 0` でも `m == 0` でも正しく扱う（`0^0 = 1`）。",
      "fn 累乗(f: &[係数], m: impl TryInto<u64>, n: usize) -> Vec<係数> {",
      "    let m: u64 = m.try_into().ok().expect(\"累乗: 引数が u64 に収まりません\");",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    if m == 0 {",
      "        let mut r = vec![係数::new(0); n];",
      "        r[0] = 係数::new(1);",
      "        return r;",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return vec![係数::new(0); n];",
      "    }",
      "    if (d as u128) * (m as u128) >= n as u128 {",
      "        return vec![係数::new(0); n];",
      "    }",
      "    let shift = d * (m as usize);",
      "    let len = n - shift;",
      "    let c = f[d];",
      "    let cinv = c.inv();",
      "    let g: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let lg = log(&g, len);",
      "    let mm = 係数::new(m);",
      "    let scaled: Vec<係数> = lg.iter().map(|&x| x * mm).collect();",
      "    let eg = exp(&scaled, len);",
      "    let cm = c.pow(m);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in eg.iter().enumerate() {",
      "        r[shift + i] = v * cm;",
      "    }",
      "    r",
      "}",
      "/// mod 998244353 上の平方根（Tonelli–Shanks）。`a` が平方剰余なら 1 つの解（小さい方）を `Some`、",
      "/// 非平方剰余なら `None` を返す。FPS 平方根の定数項計算に使う。`p - 1 = 2^23·119` なので確実に動く。",
      "fn 平方剰余の根(a: u64) -> Option<u64> {",
      "    const P: u64 = 998244353;",
      "    let a = a % P;",
      "    if a == 0 {",
      "        return Some(0);",
      "    }",
      "    let pw = |mut b: u64, mut e: u64| -> u64 {",
      "        let mut r = 1u64;",
      "        b %= P;",
      "        while e > 0 {",
      "            if e & 1 == 1 {",
      "                r = r * b % P;",
      "            }",
      "            b = b * b % P;",
      "            e >>= 1;",
      "        }",
      "        r",
      "    };",
      "    if pw(a, (P - 1) / 2) != 1 {",
      "        return None;",
      "    }",
      "    let mut q = P - 1;",
      "    let mut s = 0u32;",
      "    while q % 2 == 0 {",
      "        q /= 2;",
      "        s += 1;",
      "    }",
      "    let mut z = 2u64;",
      "    while pw(z, (P - 1) / 2) == 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = pw(z, q);",
      "    let mut t = pw(a, q);",
      "    let mut r = pw(a, q.div_ceil(2));",
      "    loop {",
      "        if t == 1 {",
      "            return Some(r.min(P - r));",
      "        }",
      "        let mut i = 0u32;",
      "        let mut tt = t;",
      "        while tt != 1 {",
      "            tt = tt * tt % P;",
      "            i += 1;",
      "        }",
      "        let b = pw(c, 1u64 << (m - i - 1));",
      "        m = i;",
      "        c = b * b % P;",
      "        t = t * c % P;",
      "        r = r * b % P;",
      "    }",
      "}",
      "/// `g^2 ≡ f (mod x^n)` なる平方根 `g`（長さ `n`）を Newton 法で求める。`O(n log n)`。",
      "/// 最低次の非零項の次数が奇数、または定数項が平方剰余でない場合は平方根が存在せず `None` を返す。",
      "/// `f ≡ 0` なら全 0 を返す。定数項が 1 でなくても（平方剰余であれば）扱える。",
      "fn 平方根(f: &[係数], n: usize) -> Option<Vec<係数>> {",
      "    if n == 0 {",
      "        return Some(Vec::new());",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    if d % 2 != 0 {",
      "        return None;",
      "    }",
      "    let c0 = 平方剰余の根(f[d].val() as u64)?;",
      "    let shift = d / 2;",
      "    if shift >= n {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    let len = n - shift;",
      "    let cinv = f[d].inv();",
      "    let h: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let 逆2 = 係数::new(2).inv();",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < len {",
      "        k <<= 1;",
      "        let 上限 = k.min(h.len());",
      "        let ig = 逆元(&g, k);",
      "        let mut t = convolution(&h[..上限], &ig);",
      "        t.truncate(k);",
      "        g.resize(k, 係数::new(0));",
      "        for (gi, &ti) in g.iter_mut().zip(t.iter()) {",
      "            *gi = (*gi + ti) * 逆2;",
      "        }",
      "    }",
      "    g.truncate(len);",
      "    let c = 係数::new(c0);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in g.iter().enumerate() {",
      "        r[shift + i] = v * c;",
      "    }",
      "    Some(r)",
      "}"
    ]
  },
  "彩色数": {
    "scope": "rust",
    "prefix": "彩色数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向グラフの彩色数（隣接頂点を異色で塗り分けるのに必要な最小色数）を O(2^n · n) で求める。頂点数 `n <= 20`。",
      "/// 包除原理: 「`k` 個の独立集合（順序付き・重複可）で全頂点を覆う場合の数」",
      "/// `f(k) = Σ_S (-1)^{n-|S|} · g(S)^k`（`g(S)` は `S` に含まれる独立集合の個数）が正になる最小の `k` が彩色数。",
      "fn 彩色数(n: usize, 辺: &[(usize, usize)]) -> usize {",
      "    assert!(n <= 20, \"n must be <= 20\");",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let mut グラフ = vec![0u32; n];",
      "    for &(u, v) in 辺 {",
      "        if u != v {",
      "            グラフ[u] |= 1 << v;",
      "            グラフ[v] |= 1 << u;",
      "        }",
      "    }",
      "    let 全 = 1usize << n;",
      "    let mut g = vec![0u64; 全];",
      "    g[0] = 1;",
      "    for s in 1..全 {",
      "        let v = s.trailing_zeros() as usize;",
      "        let 無v = s & !(1 << v);",
      "        g[s] = g[無v] + g[無v & !(グラフ[v] as usize)];",
      "    }",
      "    const 素数: [u64; 2] = [1_000_000_007, 1_000_000_009];",
      "    let mut 現在 = [vec![1u64; 全], vec![1u64; 全]];",
      "    for k in 1..=n {",
      "        let mut 非零 = false;",
      "        for (idx, &p) in 素数.iter().enumerate() {",
      "            let mut 和: i64 = 0;",
      "            #[allow(clippy::needless_range_loop)]",
      "            for s in 0..全 {",
      "                現在[idx][s] = 現在[idx][s] * (g[s] % p) % p;",
      "                let 符号 = if (n - s.count_ones() as usize) % 2 == 0 {",
      "                    1i64",
      "                } else {",
      "                    -1",
      "                };",
      "                和 += 符号 * 現在[idx][s] as i64;",
      "            }",
      "            if 和 % p as i64 != 0 {",
      "                非零 = true;",
      "            }",
      "        }",
      "        if 非零 {",
      "            return k;",
      "        }",
      "    }",
      "    n",
      "}"
    ]
  },
  "成分ごとの_白黒": {
    "scope": "rust",
    "prefix": "成分ごとの_白黒",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向グラフを2色に塗り分ける（二部グラフ判定）。O(V+E)。",
      "/// `グラフ[u]` は隣接頂点の列。塗り分けられたら各頂点の色（`false` / `true`）を返し、",
      "/// 奇閉路（自己ループを含む）があれば `None`。非連結でもよく、連結成分ごとに",
      "/// 「その成分の最小番号の頂点を `false`」として独立に塗る。",
      "/// `petgraph::algo::is_bipartite_undirected` は「始点の連結成分が二部か」の `bool` だけで、",
      "/// 塗り分けそのものは得られない。「白側の頂点を列挙」「白と黒の個数を比べる」型の問題には",
      "/// こちらが要る。辺が後から増えていくオンライン形なら",
      "/// [`crate::weighted_union_find`] を mod 2 のポテンシャルで使う方が向く。",
      "fn 二部彩色(グラフ: &[Vec<usize>]) -> Option<Vec<bool>> {",
      "    use std::collections::VecDeque;",
      "    let n = グラフ.len();",
      "    let mut 色: Vec<Option<bool>> = vec![None; n];",
      "    let mut 探索 = VecDeque::new();",
      "    for 始点 in 0..n {",
      "        if 色[始点].is_some() {",
      "            continue;",
      "        }",
      "        色[始点] = Some(false);",
      "        探索.push_back(始点);",
      "        while let Some(now) = 探索.pop_front() {",
      "            let c = 色[now].unwrap();",
      "            for &next in &グラフ[now] {",
      "                match 色[next] {",
      "                    None => {",
      "                        色[next] = Some(!c);",
      "                        探索.push_back(next);",
      "                    }",
      "                    Some(隣) if 隣 == c => return None,",
      "                    Some(_) => {}",
      "                }",
      "            }",
      "        }",
      "    }",
      "    Some(色.into_iter().map(|c| c.unwrap()).collect())",
      "}",
      "/// 二部グラフを連結成分ごとに `(色 false の頂点, 色 true の頂点)` へ分ける。O(V log V + E)。",
      "/// 奇閉路があれば `None`。「成分ごとに白の個数×黒の個数を足す」「成分ごとに多い方の色を選ぶ」",
      "/// 型の数え上げ用で、[`二部彩色`] の色配列だけでは足りない「どの成分か」をまとめて返す。",
      "/// 頂点番号は各リスト内で昇順。孤立頂点は `(vec![その頂点], vec![])` の成分になる。",
      "fn 二部成分分割(グラフ: &[Vec<usize>]) -> Option<Vec<(Vec<usize>, Vec<usize>)>> {",
      "    use std::collections::VecDeque;",
      "    let 色 = 二部彩色(グラフ)?;",
      "    let n = グラフ.len();",
      "    let mut 到達済 = vec![false; n];",
      "    let mut 成分列 = Vec::new();",
      "    let mut 探索 = VecDeque::new();",
      "    for 始点 in 0..n {",
      "        if 到達済[始点] {",
      "            continue;",
      "        }",
      "        到達済[始点] = true;",
      "        探索.push_back(始点);",
      "        let (mut 白, mut 黒) = (Vec::new(), Vec::new());",
      "        while let Some(now) = 探索.pop_front() {",
      "            if 色[now] {",
      "                黒.push(now)",
      "            } else {",
      "                白.push(now)",
      "            }",
      "            for &next in &グラフ[now] {",
      "                if !到達済[next] {",
      "                    到達済[next] = true;",
      "                    探索.push_back(next);",
      "                }",
      "            }",
      "        }",
      "        白.sort_unstable();",
      "        黒.sort_unstable();",
      "        成分列.push((白, 黒));",
      "    }",
      "    Some(成分列)",
      "}"
    ]
  },
  "挿入_削除_可能_配列": {
    "scope": "rust",
    "prefix": "挿入_削除_可能_配列",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 陰的 Treap（implicit treap）。配列を平衡二分木で表し、任意位置への挿入・削除、",
      "/// 区間反転、区間和、一点取得を全て O(log N) で行える。添字をキーに持たず部分木サイズで",
      "/// 位置を決める「陰的キー」方式。",
      "/// - [`Self::挿入`] / [`Self::削除`] : 位置指定の挿入・削除。",
      "/// - [`Self::反転`] : 半開区間 `[l, r)` を反転。",
      "/// - [`Self::区間和`] : 半開区間 `[l, r)` の和。",
      "/// - [`Self::取得`] : 1 要素の値。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "/// 位置ではなく値の大小で並べた集合（k 番目・順位）が欲しいなら",
      "/// [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合) を使う。",
      "struct 陰的Treap<T> {",
      "    値: Vec<T>,",
      "    優先度: Vec<u64>,",
      "    サイズ: Vec<usize>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "    左: Vec<usize>,",
      "    右: Vec<usize>,",
      "    rng: u64,",
      "    根: usize,",
      "}",
      "impl<T> 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn new() -> Self {",
      "        Self {",
      "            値: vec![T::default()],",
      "            優先度: vec![0],",
      "            サイズ: vec![0],",
      "            和: vec![T::default()],",
      "            反転: vec![false],",
      "            左: vec![0],",
      "            右: vec![0],",
      "            rng: 0x9e37_79b9_7f4a_7c15,",
      "            根: 0,",
      "        }",
      "    }",
      "    fn 乱数(&mut self) -> u64 {",
      "        let mut x = self.rng;",
      "        x ^= x << 13;",
      "        x ^= x >> 7;",
      "        x ^= x << 17;",
      "        self.rng = x;",
      "        x",
      "    }",
      "    fn 新規ノード(&mut self, 値: T) -> usize {",
      "        let p = self.乱数();",
      "        self.値.push(値);",
      "        self.優先度.push(p);",
      "        self.サイズ.push(1);",
      "        self.和.push(値);",
      "        self.反転.push(false);",
      "        self.左.push(0);",
      "        self.右.push(0);",
      "        self.値.len() - 1",
      "    }",
      "    /// 子の情報から `t` のサイズと和を再計算する。反転フラグはサイズ・和に影響しない。",
      "    fn 更新(&mut self, t: usize) {",
      "        if t == 0 {",
      "            return;",
      "        }",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.サイズ[t] = 1 + self.サイズ[l] + self.サイズ[r];",
      "        self.和[t] = self.値[t] + self.和[l] + self.和[r];",
      "    }",
      "    /// `t` に溜まった反転遅延を子へ押し下げる。",
      "    fn 伝播(&mut self, t: usize) {",
      "        if t == 0 || !self.反転[t] {",
      "            return;",
      "        }",
      "        self.反転[t] = false;",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.左[t] = r;",
      "        self.右[t] = l;",
      "        if l != 0 {",
      "            self.反転[l] ^= true;",
      "        }",
      "        if r != 0 {",
      "            self.反転[r] ^= true;",
      "        }",
      "    }",
      "    /// `t` を「左 k 要素」と「残り」に分割し、`(左根, 右根)` を返す。",
      "    fn split(&mut self, t: usize, k: usize) -> (usize, usize) {",
      "        if t == 0 {",
      "            return (0, 0);",
      "        }",
      "        self.伝播(t);",
      "        let 左サイズ = self.サイズ[self.左[t]];",
      "        if k <= 左サイズ {",
      "            let (l, r) = self.split(self.左[t], k);",
      "            self.左[t] = r;",
      "            self.更新(t);",
      "            (l, t)",
      "        } else {",
      "            let (l, r) = self.split(self.右[t], k - 左サイズ - 1);",
      "            self.右[t] = l;",
      "            self.更新(t);",
      "            (t, r)",
      "        }",
      "    }",
      "    /// 2 つの木を連結する。`l` の全要素が `r` の前に来る。",
      "    fn merge(&mut self, l: usize, r: usize) -> usize {",
      "        if l == 0 {",
      "            return r;",
      "        }",
      "        if r == 0 {",
      "            return l;",
      "        }",
      "        if self.優先度[l] > self.優先度[r] {",
      "            self.伝播(l);",
      "            let 新右 = self.merge(self.右[l], r);",
      "            self.右[l] = 新右;",
      "            self.更新(l);",
      "            l",
      "        } else {",
      "            self.伝播(r);",
      "            let 新左 = self.merge(l, self.左[r]);",
      "            self.左[r] = 新左;",
      "            self.更新(r);",
      "            r",
      "        }",
      "    }",
      "    /// 末尾に値を追加する。",
      "    fn 末尾追加(&mut self, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        self.根 = self.merge(根, 新);",
      "    }",
      "    /// 位置 `pos`（0-indexed、`pos == 長さ` で末尾）に `値` を挿入する。",
      "    fn 挿入(&mut self, pos: usize, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let 左 = self.merge(l, 新);",
      "        self.根 = self.merge(左, r);",
      "    }",
      "    /// 位置 `pos`（0-indexed）の要素を削除する。",
      "    fn 削除(&mut self, pos: usize) {",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let (_削除, r2) = self.split(r, 1);",
      "        self.根 = self.merge(l, r2);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）を反転する。",
      "    fn 反転(&mut self, 範囲: impl std::ops::RangeBounds<usize>) {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        if b != 0 {",
      "            self.反転[b] ^= true;",
      "        }",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の和。",
      "    fn 区間和(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return T::default();",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        let 結果 = self.和[b];",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "        結果",
      "    }",
      "    /// 位置 `pos`（0-indexed）の値。",
      "    fn 取得(&mut self, pos: usize) -> T {",
      "        self.区間和(pos..pos + 1)",
      "    }",
      "    /// 要素数。",
      "    fn 長さ(&self) -> usize {",
      "        self.サイズ[self.根]",
      "    }",
      "}",
      "impl<T> Default for 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "掃き出し_法_GF2": {
    "scope": "rust",
    "prefix": "掃き出し_法_GF2",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// GF(2) 上の連立一次方程式 `A x = b` を掃き出し（ガウス消去）で解く。O(式数 · 変数数)。",
      "/// 変数は `0..変数数`（`変数数 <= 63`）。各式は `(係数ビット集合, 右辺)` で表し、",
      "/// 係数ビット集合の `k` ビット目が立っていれば変数 `x_k` を含む。右辺は 0/1。",
      "/// 解が無ければ `None`。`Some(解)` は解の一つ（自由変数は 0 とおく）。",
      "/// 実数の連立方程式は `nalgebra` を使うこと。これは XOR（mod 2）専用。",
      "fn xor連立方程式(変数数: usize, 式: &[(u64, u8)]) -> Option<Vec<u8>> {",
      "    let 右辺ビット = 1u64 << 変数数;",
      "    let mut 行: Vec<u64> = 式",
      "        .iter()",
      "        .map(|&(係数, b)| 係数 | ((b as u64 & 1) << 変数数))",
      "        .collect();",
      "    let mut ピボット行 = vec![!0; 変数数];",
      "    let mut 行位置 = 0usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for 列 in 0..変数数 {",
      "        let Some(選択) = (行位置..行.len()).find(|&r| 行[r] >> 列 & 1 == 1) else {",
      "            continue;",
      "        };",
      "        行.swap(行位置, 選択);",
      "        let 基準 = 行[行位置];",
      "        for (r, row) in 行.iter_mut().enumerate() {",
      "            if r != 行位置 && *row >> 列 & 1 == 1 {",
      "                *row ^= 基準;",
      "            }",
      "        }",
      "        ピボット行[列] = 行位置;",
      "        行位置 += 1;",
      "    }",
      "    if 行[行位置..].contains(&右辺ビット) {",
      "        return None;",
      "    }",
      "    let mut 解 = vec![0u8; 変数数];",
      "    for (列, &pr) in ピボット行.iter().enumerate() {",
      "        if pr != !0 {",
      "            解[列] = ((行[pr] >> 変数数) & 1) as u8;",
      "        }",
      "    }",
      "    Some(解)",
      "}"
    ]
  },
  "接尾辞_オートマトン": {
    "scope": "rust",
    "prefix": "接尾辞_オートマトン",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 接尾辞オートマトンの 1 状態。`len` は同値類の最長文字列長、`link` は suffix link",
      "/// （根は -1）、`next` は文字ごとの遷移先。",
      "struct 状態 {",
      "    len: usize,",
      "    link: i64,",
      "    next: HashMap<u8, usize>,",
      "}",
      "/// 接尾辞オートマトン（SAM）。文字列の全部分文字列を O(N) 状態で表す。構築 O(N)。",
      "/// - [`Self::相異なる部分文字列数`] : 相異なる（空でない）部分文字列の個数。",
      "/// - [`Self::含む`] : ある文字列が部分文字列として現れるか。",
      "struct 接尾辞オートマトン {",
      "    states: Vec<状態>,",
      "    last: usize,",
      "}",
      "impl 接尾辞オートマトン {",
      "    fn new() -> Self {",
      "        Self {",
      "            states: vec![状態 {",
      "                len: 0,",
      "                link: -1,",
      "                next: HashMap::new(),",
      "            }],",
      "            last: 0,",
      "        }",
      "    }",
      "    /// バイト列から構築する。",
      "    fn 構築(s: &[u8]) -> Self {",
      "        let mut sam = Self::new();",
      "        for &c in s {",
      "            sam.追加(c);",
      "        }",
      "        sam",
      "    }",
      "    /// 末尾に 1 文字追加する（オンライン構築）。",
      "    fn 追加(&mut self, c: u8) {",
      "        let cur = self.states.len();",
      "        self.states.push(状態 {",
      "            len: self.states[self.last].len + 1,",
      "            link: -1,",
      "            next: HashMap::new(),",
      "        });",
      "        let mut p = self.last as i64;",
      "        while p != -1 && !self.states[p as usize].next.contains_key(&c) {",
      "            self.states[p as usize].next.insert(c, cur);",
      "            p = self.states[p as usize].link;",
      "        }",
      "        if p == -1 {",
      "            self.states[cur].link = 0;",
      "        } else {",
      "            let q = self.states[p as usize].next[&c];",
      "            if self.states[p as usize].len + 1 == self.states[q].len {",
      "                self.states[cur].link = q as i64;",
      "            } else {",
      "                let clone = self.states.len();",
      "                self.states.push(状態 {",
      "                    len: self.states[p as usize].len + 1,",
      "                    link: self.states[q].link,",
      "                    next: self.states[q].next.clone(),",
      "                });",
      "                while p != -1 && self.states[p as usize].next.get(&c) == Some(&q) {",
      "                    self.states[p as usize].next.insert(c, clone);",
      "                    p = self.states[p as usize].link;",
      "                }",
      "                self.states[q].link = clone as i64;",
      "                self.states[cur].link = clone as i64;",
      "            }",
      "        }",
      "        self.last = cur;",
      "    }",
      "    /// 相異なる（空でない）部分文字列の個数。O(状態数)。",
      "    fn 相異なる部分文字列数(&self) -> usize {",
      "        let mut 合計 = 0usize;",
      "        for v in 1..self.states.len() {",
      "            let link = self.states[v].link;",
      "            let 親len = if link < 0 {",
      "                0",
      "            } else {",
      "                self.states[link as usize].len",
      "            };",
      "            合計 += self.states[v].len - 親len;",
      "        }",
      "        合計",
      "    }",
      "    /// `t` が部分文字列として現れるか。O(|t|)。",
      "    fn 含む(&self, t: &[u8]) -> bool {",
      "        let mut v = 0usize;",
      "        for &c in t {",
      "            match self.states[v].next.get(&c) {",
      "                Some(&nx) => v = nx,",
      "                None => return false,",
      "            }",
      "        }",
      "        true",
      "    }",
      "}",
      "impl Default for 接尾辞オートマトン {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "接頭辞_関数": {
    "scope": "rust",
    "prefix": "接頭辞_関数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 接頭辞関数（KMP の failure 配列）。`pi[i]` は `s[0..=i]` の真の接頭辞かつ接尾辞となる",
      "/// 最長文字列（ボーダー）の長さ。O(n)。`s` の要素は `PartialEq` であればよい。",
      "/// ボーダー・周期性の解析や [`kmp検索`] の前処理に使う。`ac_library::z_algorithm` は Z 配列を",
      "/// 返す別アルゴリズムで、用途（周期・ボーダーの直接取得）が異なる。",
      "fn 接頭辞関数<T: PartialEq>(s: &[T]) -> Vec<usize> {",
      "    let n = s.len();",
      "    let mut pi = vec![0usize; n];",
      "    for i in 1..n {",
      "        let mut j = pi[i - 1];",
      "        while j > 0 && s[i] != s[j] {",
      "            j = pi[j - 1];",
      "        }",
      "        if s[i] == s[j] {",
      "            j += 1;",
      "        }",
      "        pi[i] = j;",
      "    }",
      "    pi",
      "}",
      "/// `テキスト` 中に `パターン` が出現する開始位置（0-indexed）を全て昇順で返す。O(n + m)。",
      "/// 重なり合う出現も全て列挙する。空パターンは「マッチなし」として空の `Vec` を返す。",
      "fn kmp検索<T: PartialEq>(テキスト: &[T], パターン: &[T]) -> Vec<usize> {",
      "    let m = パターン.len();",
      "    let mut 結果 = Vec::new();",
      "    if m == 0 {",
      "        return 結果;",
      "    }",
      "    let pi = 接頭辞関数(パターン);",
      "    let mut j = 0usize;",
      "    for (i, c) in テキスト.iter().enumerate() {",
      "        while j > 0 && *c != パターン[j] {",
      "            j = pi[j - 1];",
      "        }",
      "        if *c == パターン[j] {",
      "            j += 1;",
      "        }",
      "        if j == m {",
      "            結果.push(i + 1 - m);",
      "            j = pi[j - 1];",
      "        }",
      "    }",
      "    結果",
      "}",
      "/// `s` の最小周期長。`s` は長さ `周期` のブロックの繰り返しの接頭辞になる",
      "/// （`s[i] == s[i + 周期]` が全ての有効な `i` で成り立つ最小の `周期`）。空列なら 0。",
      "/// 例: `\"aabaab\"` → 3、`\"aabaa\"` → 3、`\"abcabc\"` → 3、`\"abcd\"` → 4。",
      "/// `s.len() % 周期 == 0` のときだけ `s` はそのブロックの「ちょうど整数回」の繰り返し。",
      "fn 最小周期<T: PartialEq>(s: &[T]) -> usize {",
      "    let n = s.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let pi = 接頭辞関数(s);",
      "    n - pi[n - 1]",
      "}"
    ]
  },
  "撤回_可能_DSU": {
    "scope": "rust",
    "prefix": "撤回_可能_DSU",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巻き戻し（Undo）可能な Union-Find。経路圧縮を行わずユニオン by サイズのみで結合し、",
      "/// 各結合の変更を履歴に積むことで任意時点へ `O(操作数)` で復元できる。",
      "/// `ac_library::Dsu` は経路圧縮するため undo できない。オフライン動的連結性",
      "/// （時間方向のセグメント木上の分割統治）などで「結合 → 探索 → 巻き戻し」を繰り返す用途に使う。",
      "/// `根`・`同じ`・`サイズ` は経路圧縮なしの O(log N)。",
      "struct ロールバック可能UnionFind {",
      "    /// 根なら `-(サイズ)`、非根なら親の添字。",
      "    親orサイズ: Vec<i64>,",
      "    /// `(書き換えた添字, 直前の値)` の履歴。1 回の結合で 2 件積む。",
      "    履歴: Vec<(usize, i64)>,",
      "}",
      "impl ロールバック可能UnionFind {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親orサイズ: vec![-1; n],",
      "            履歴: Vec::new(),",
      "        }",
      "    }",
      "    /// `x` の根（経路圧縮なし）。",
      "    fn 根(&self, mut x: usize) -> usize {",
      "        while self.親orサイズ[x] >= 0 {",
      "            x = self.親orサイズ[x] as usize;",
      "        }",
      "        x",
      "    }",
      "    /// `x` と `y` を結合する。既に同じ集合なら `false`（履歴は積まない）。",
      "    fn 統合(&mut self, x: usize, y: usize) -> bool {",
      "        let mut a = self.根(x);",
      "        let mut b = self.根(y);",
      "        if a == b {",
      "            return false;",
      "        }",
      "        if self.親orサイズ[a] > self.親orサイズ[b] {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        self.履歴.push((a, self.親orサイズ[a]));",
      "        self.履歴.push((b, self.親orサイズ[b]));",
      "        self.親orサイズ[a] += self.親orサイズ[b];",
      "        self.親orサイズ[b] = a as i64;",
      "        true",
      "    }",
      "    /// `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "    /// `x` の属する集合の要素数。",
      "    fn サイズ(&self, x: usize) -> usize {",
      "        let r = self.根(x);",
      "        (-self.親orサイズ[r]) as usize",
      "    }",
      "    /// 現在のスナップショット（履歴の長さ）。[`Self::ロールバック`] に渡す。",
      "    fn 現在時点(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    /// 直近の `統合` 1 回ぶんを取り消す（履歴 2 件を巻き戻す）。",
      "    fn 巻き戻し(&mut self) {",
      "        for _ in 0..2 {",
      "            if let Some((i, v)) = self.履歴.pop() {",
      "                self.親orサイズ[i] = v;",
      "            }",
      "        }",
      "    }",
      "    /// [`Self::現在時点`] で得た時点まで状態を巻き戻す。",
      "    fn ロールバック(&mut self, 時点: usize) {",
      "        while self.履歴.len() > 時点 {",
      "            let (i, v) = self.履歴.pop().unwrap();",
      "            self.親orサイズ[i] = v;",
      "        }",
      "    }",
      "}"
    ]
  },
  "撹乱_順列": {
    "scope": "rust",
    "prefix": "撹乱_順列",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::ModInt as Mint;",
      "/// モンモール数（完全順列＝撹乱順列の数）`D(0..=n)` を前計算して返す。O(n)。",
      "/// mod は `Mint`（ac_library::ModInt）のグローバル modulus。Comb は不要。",
      "/// `D(n)` は `1..=n` のどの位置も自分自身を指さない順列の数。u64 なら n ≥ 21 で溢れる。",
      "fn モンモール数(n: usize) -> Vec<Mint> {",
      "    let mut d = vec![Mint::new(0); n + 1];",
      "    d[0] = Mint::new(1);",
      "    for i in 2..=n {",
      "        d[i] = Mint::new(i - 1) * (d[i - 1] + d[i - 2]);",
      "    }",
      "    d",
      "}"
    ]
  },
  "支配木": {
    "scope": "rust",
    "prefix": "支配木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから有向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺[i] = (u, v)` を `u → v` の一方向の辺として `グラフ[u]` にだけ積む。",
      "/// 逆辺が欲しい場合は `(v, u)` に読み替えてもう一度呼ぶ。",
      "fn 有向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "    }",
      "    グラフ",
      "}",
      "/// 支配木（dominator tree）を求める。`根` から各頂点への全経路が必ず通る頂点のうち",
      "/// 最も近いもの（直接支配点 idom）を返す。`辺` は AtCoder の入力そのまま",
      "/// （0-indexed の有向辺 `(u, v)` = `u → v`）。",
      "/// 返り値 `idom`：`idom[根] = 根`、到達可能な `v` は `idom[v]` がその直接支配点、到達不能な頂点は",
      "/// `!0`。制御フロー解析や「ある頂点を経由しないと到達できない頂点」の判定に使う。",
      "/// 最悪計算量は Lengauer–Tarjan の `O((V+E) log V)` に劣るが、実グラフでは十分高速。",
      "fn 支配木(n: usize, 辺: &[(usize, usize)], 根: usize) -> Vec<usize> {",
      "    let mut g = petgraph::graph::DiGraph::<(), ()>::new();",
      "    let 節: Vec<petgraph::graph::NodeIndex> = (0..n).map(|_| g.add_node(())).collect();",
      "    for &(v, u) in 辺 {",
      "        g.add_edge(節[v], 節[u], ());",
      "    }",
      "    let dom = petgraph::algo::dominators::simple_fast(&g, 節[根]);",
      "    let mut 結果 = vec![!0; n];",
      "    結果[根] = 根;",
      "    for (v, &節v) in 節.iter().enumerate() {",
      "        if v != 根",
      "            && let Some(d) = dom.immediate_dominator(節v)",
      "        {",
      "            結果[v] = d.index();",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "支配点": {
    "scope": "rust",
    "prefix": "支配点",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから有向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺[i] = (u, v)` を `u → v` の一方向の辺として `グラフ[u]` にだけ積む。",
      "/// 逆辺が欲しい場合は `(v, u)` に読み替えてもう一度呼ぶ。",
      "fn 有向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "    }",
      "    グラフ",
      "}",
      "/// 支配木（dominator tree）を求める。`根` から各頂点への全経路が必ず通る頂点のうち",
      "/// 最も近いもの（直接支配点 idom）を返す。`辺` は AtCoder の入力そのまま",
      "/// （0-indexed の有向辺 `(u, v)` = `u → v`）。",
      "/// 返り値 `idom`：`idom[根] = 根`、到達可能な `v` は `idom[v]` がその直接支配点、到達不能な頂点は",
      "/// `!0`。制御フロー解析や「ある頂点を経由しないと到達できない頂点」の判定に使う。",
      "/// 最悪計算量は Lengauer–Tarjan の `O((V+E) log V)` に劣るが、実グラフでは十分高速。",
      "fn 支配木(n: usize, 辺: &[(usize, usize)], 根: usize) -> Vec<usize> {",
      "    let mut g = petgraph::graph::DiGraph::<(), ()>::new();",
      "    let 節: Vec<petgraph::graph::NodeIndex> = (0..n).map(|_| g.add_node(())).collect();",
      "    for &(v, u) in 辺 {",
      "        g.add_edge(節[v], 節[u], ());",
      "    }",
      "    let dom = petgraph::algo::dominators::simple_fast(&g, 節[根]);",
      "    let mut 結果 = vec![!0; n];",
      "    結果[根] = 根;",
      "    for (v, &節v) in 節.iter().enumerate() {",
      "        if v != 根",
      "            && let Some(d) = dom.immediate_dominator(節v)",
      "        {",
      "            結果[v] = d.index();",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "数値_積分": {
    "scope": "rust",
    "prefix": "数値_積分",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 関数 `f` の区間 `[a, b]` 上の定積分を**適応的シンプソン法**で近似する。許容誤差 `許容誤差`。",
      "/// 収束していない所だけ再帰的に細かく刻む。再帰深さは最大 50。",
      "/// [`黄金分割探索`](crate::ternary_search) は凸関数の最小化で別目的。",
      "/// 幾何の面積・確率分布・物理量の累積など、閉形式が無い積分に使う。",
      "fn 数値積分<F: Fn(f64) -> f64>(f: &F, a: f64, b: f64, 許容誤差: f64) -> f64 {",
      "    fn 単純<F: Fn(f64) -> f64>(f: &F, a: f64, b: f64) -> f64 {",
      "        let c = (a + b) * 0.5;",
      "        (b - a) / 6.0 * (f(a) + 4.0 * f(c) + f(b))",
      "    }",
      "    #[allow(clippy::too_many_arguments)]",
      "    fn 再帰<F: Fn(f64) -> f64>(",
      "        f: &F, a: f64, b: f64, eps: f64, 全体: f64, 深さ: usize",
      "    ) -> f64 {",
      "        let c = (a + b) * 0.5;",
      "        let 左 = 単純(f, a, c);",
      "        let 右 = 単純(f, c, b);",
      "        let 差 = 左 + 右 - 全体;",
      "        if 深さ == 0 || 差.abs() <= 15.0 * eps {",
      "            return 左 + 右 + 差 / 15.0;",
      "        }",
      "        再帰(f, a, c, eps * 0.5, 左, 深さ - 1) + 再帰(f, c, b, eps * 0.5, 右, 深さ - 1)",
      "    }",
      "    再帰(f, a, b, 許容誤差, 単純(f, a, b), 50)",
      "}"
    ]
  },
  "数列の_第_n_項": {
    "scope": "rust",
    "prefix": "数列の_第_n_項",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// Berlekamp-Massey 法。数列 `数列`（素数 `法` 上）を生成する最短の線形漸化式の係数を返す。",
      "/// O(N·L)（L は漸化式の次数）。",
      "/// 返り値 `c`（長さ L）は `S[i] = Σ_{j=0}^{L-1} c[j]·S[i-1-j]`（`i ≥ L`）を満たす。",
      "/// 数列は少なくとも `2L` 項あると安全。第 N 項を求めるには [`線形漸化式の第n項`] に渡す。",
      "fn ベルレカンプマッシー(数列: &[u64], 法: u64) -> Vec<u64> {",
      "    let p = 法 as i128;",
      "    let n = 数列.len();",
      "    let s: Vec<i128> = 数列.iter().map(|&x| (x as i128) % p).collect();",
      "    let mut c = vec![0i128; n + 1];",
      "    let mut b = vec![0i128; n + 1];",
      "    c[0] = 1 % p;",
      "    b[0] = 1 % p;",
      "    let mut l = 0usize;",
      "    let mut m = 0usize;",
      "    let mut bb = 1i128 % p;",
      "    for i in 0..n {",
      "        m += 1;",
      "        let mut d = s[i] % p;",
      "        for j in 1..=l {",
      "            d = (d + c[j] * s[i - j]) % p;",
      "        }",
      "        if d == 0 {",
      "            continue;",
      "        }",
      "        let t = c.clone();",
      "        let coef = d * 累乗_mod((bb % p) as u64, 法 - 2, 法) as i128 % p;",
      "        for j in m..=n {",
      "            c[j] = ((c[j] - coef * b[j - m]) % p + p) % p;",
      "        }",
      "        if 2 * l > i {",
      "            continue;",
      "        }",
      "        l = i + 1 - l;",
      "        b = t;",
      "        bb = d;",
      "        m = 0;",
      "    }",
      "    c.truncate(l + 1);",
      "    c.drain(0..1);",
      "    c.iter().map(|&x| (((p - x) % p + p) % p) as u64).collect()",
      "}",
      "/// 多項式の積を `x^k = Σ 係数[j]·x^{k-1-j}` で次数 `k` 未満に縮約する内部関数。",
      "fn 多項式乗算縮約(a: &[u64], b: &[u64], 係数: &[u64], 法: u64) -> Vec<u64> {",
      "    let k = 係数.len();",
      "    let m = 法 as u128;",
      "    let mut res = vec![0u128; (a.len() + b.len()).saturating_sub(1).max(k)];",
      "    for (i, &ai) in a.iter().enumerate() {",
      "        if ai == 0 {",
      "            continue;",
      "        }",
      "        for (j, &bj) in b.iter().enumerate() {",
      "            res[i + j] = (res[i + j] + ai as u128 * bj as u128) % m;",
      "        }",
      "    }",
      "    for d in (k..res.len()).rev() {",
      "        let v = res[d];",
      "        if v != 0 {",
      "            res[d] = 0;",
      "            for (j, &係) in 係数.iter().enumerate() {",
      "                let deg = d - 1 - j;",
      "                res[deg] = (res[deg] + v * 係 as u128) % m;",
      "            }",
      "        }",
      "    }",
      "    res.truncate(k);",
      "    res.resize(k, 0);",
      "    res.iter().map(|&x| x as u64).collect()",
      "}",
      "/// きたまさ法。線形漸化式 `S[i] = Σ_{j} 係数[j]·S[i-1-j]` と初項 `初項`（長さ ≥ 次数）から、",
      "/// 第 `n` 項を素数 `法` で O(k^2 log n) で求める（k は次数）。",
      "fn 線形漸化式の第n項(初項: &[u64], 係数: &[u64], n: usize, 法: u64) -> u64 {",
      "    let k = 係数.len();",
      "    if k == 0 {",
      "        return 0;",
      "    }",
      "    if n < k {",
      "        return 初項[n] % 法;",
      "    }",
      "    let mut 結果 = vec![0u64; k];",
      "    結果[0] = 1 % 法;",
      "    let mut 底 = if k >= 2 {",
      "        let mut v = vec![0u64; k];",
      "        v[1] = 1 % 法;",
      "        v",
      "    } else {",
      "        vec![係数[0] % 法]",
      "    };",
      "    let mut e = n;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            結果 = 多項式乗算縮約(&結果, &底, 係数, 法);",
      "        }",
      "        底 = 多項式乗算縮約(&底, &底, 係数, 法);",
      "        e >>= 1;",
      "    }",
      "    let m = 法 as u128;",
      "    let mut ans = 0u128;",
      "    for (i, &係) in 結果.iter().enumerate() {",
      "        ans = (ans + 係 as u128 * (初項[i] % 法) as u128) % m;",
      "    }",
      "    ans as u64",
      "}",
      "/// 数列の先頭を渡すと、Berlekamp-Massey で漸化式を推定し、きたまさ法で第 `n` 項を返す。",
      "/// 数列は最短漸化式の次数の 2 倍以上の項を含むこと（足りないと誤った外挿になる）。",
      "fn 数列の第n項(数列: &[u64], n: usize, 法: u64) -> u64 {",
      "    let 係数 = ベルレカンプマッシー(数列, 法);",
      "    線形漸化式の第n項(数列, &係数, n, 法)",
      "}"
    ]
  },
  "数論_メビウス": {
    "scope": "rust",
    "prefix": "数論_メビウス",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 数論的メビウス関数 `μ(0..=n)` を線形篩で `O(n)` 求める。",
      "/// `μ(1)=1`、`n` が平方因子を持てば `0`、相異なる素因数 `k` 個の積なら `(-1)^k`。`μ(0)=0`。",
      "/// メビウス反転・互いに素なペア数え・約数包除で使う。",
      "/// 集合の包除である [`zeta_mobius`](crate::zeta_mobius) とは別物（あちらは部分集合の和）。",
      "fn メビウス関数表(n: usize) -> Vec<i64> {",
      "    let mut μ = vec![0i64; n + 1];",
      "    if n >= 1 {",
      "        μ[1] = 1;",
      "    }",
      "    let mut 素数 = Vec::new();",
      "    let mut 合成 = vec![false; n + 1];",
      "    for i in 2..=n {",
      "        if !合成[i] {",
      "            素数.push(i);",
      "            μ[i] = -1;",
      "        }",
      "        for &p in &素数 {",
      "            if i * p > n {",
      "                break;",
      "            }",
      "            合成[i * p] = true;",
      "            if i % p == 0 {",
      "                μ[i * p] = 0;",
      "                break;",
      "            }",
      "            μ[i * p] = -μ[i];",
      "        }",
      "    }",
      "    μ",
      "}",
      "/// 単一の `n` についてメビウス関数 `μ(n)` を試し割りで `O(√n)` 求める。",
      "/// 表が要らない・`n` が大きい単発計算向け。`μ(0)=0`、`μ(1)=1`。",
      "fn メビウス関数(n: impl TryInto<u64>) -> i64 {",
      "    let mut n: u64 = n",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"メビウス関数: 引数が u64 に収まりません\");",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let mut 符号 = 1i64;",
      "    let mut d = 2u64;",
      "    while d * d <= n {",
      "        if n % d == 0 {",
      "            n /= d;",
      "            if n % d == 0 {",
      "                return 0;",
      "            }",
      "            符号 = -符号;",
      "        }",
      "        d += 1;",
      "    }",
      "    if n > 1 {",
      "        符号 = -符号;",
      "    }",
      "    符号",
      "}"
    ]
  },
  "整数_分割の_全列挙": {
    "scope": "rust",
    "prefix": "整数_分割の_全列挙",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `n` を `k` 個以下の正整数の和に分ける組を、各組を降順にして全列挙する（個数は",
      "/// [`分割数表_k個以下`]。ここだけ値ではなく組そのものを返すので usize）。",
      "/// `分割列挙(4, 3) = [[4], [3, 1], [2, 2], [2, 1, 1]]`（辞書順の降順）。",
      "/// 制限なし（`k >= n`）だと組数は p(n) で、n=50 は 20 万・27MB・11ms、n=60 は 97 万・143MB・0.13s、",
      "/// n=70 は 409 万・660MB・0.5s。n ≤ 60 までが実用の目安（それ以上は列挙せず数えること）。",
      "fn 分割列挙(n: usize, k: usize) -> Vec<Vec<usize>> {",
      "    fn 再帰(",
      "        残り: usize,",
      "        最大: usize,",
      "        残り個数: usize,",
      "        組: &mut Vec<usize>,",
      "        結果: &mut Vec<Vec<usize>>,",
      "    ) {",
      "        if 残り == 0 {",
      "            結果.push(組.clone());",
      "            return;",
      "        }",
      "        if 残り個数 == 0 {",
      "            return;",
      "        }",
      "        for 部分 in (1..=最大.min(残り)).rev() {",
      "            組.push(部分);",
      "            再帰(残り - 部分, 部分, 残り個数 - 1, 組, 結果);",
      "            組.pop();",
      "        }",
      "    }",
      "    let mut 結果 = Vec::new();",
      "    再帰(n, n, k, &mut Vec::new(), &mut 結果);",
      "    結果",
      "}"
    ]
  },
  "整数の_分割": {
    "scope": "rust",
    "prefix": "整数の_分割",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::ModInt as Mint;",
      "/// 分割数 p(0..=n) を前計算して返す。`p(k)` は整数 `k` を順序を無視して正整数の和に",
      "/// 分ける方法の総数。五角数定理を用いて O(n√n)。",
      "/// mod は `Mint`（ac_library::ModInt）のグローバル modulus（既定 998_244_353、",
      "/// 変更は `Mint::set_modulus`）。Comb は不要。",
      "/// `p(0)=1, p(1)=1, p(2)=2, p(3)=3, p(4)=5, p(5)=7, ...`。u64 なら n ≥ 417 で溢れる。",
      "fn 分割数表(n: usize) -> Vec<Mint> {",
      "    let mut p = vec![Mint::new(0); n + 1];",
      "    p[0] = Mint::new(1);",
      "    for i in 1..=n {",
      "        let mut 和 = Mint::new(0);",
      "        let mut k = 1usize;",
      "        loop {",
      "            let g1 = k * (3 * k - 1) / 2;",
      "            if g1 > i {",
      "                break;",
      "            }",
      "            let mut 項 = p[i - g1];",
      "            let g2 = k * (3 * k + 1) / 2;",
      "            if g2 <= i {",
      "                項 += p[i - g2];",
      "            }",
      "            if k % 2 == 1 {",
      "                和 += 項;",
      "            } else {",
      "                和 -= 項;",
      "            }",
      "            k += 1;",
      "        }",
      "        p[i] = 和;",
      "    }",
      "    p",
      "}"
    ]
  },
  "文字列_ハッシュ": {
    "scope": "rust",
    "prefix": "文字列_ハッシュ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// ローリングハッシュ（mod 2^61-1）。構築 O(N) 後、任意の半開区間 `[l, r)` のハッシュを",
      "/// O(1) で取得でき、部分文字列の一致判定を高速に行える。",
      "/// 法と基数は固定の定数なので、同じ型から作った2つのインスタンス同士のハッシュは比較可能。",
      "/// （AtCoder では衝突を狙う anti-hash ケースはまず無いが、心配なら基数を書き換える。）",
      "struct ローリングハッシュ {",
      "    /// 前方ハッシュ。`前方[i]` = `s[0..i]` のハッシュ",
      "    前方: Vec<u64>,",
      "    /// `基数^i mod 法`",
      "    べき: Vec<u64>,",
      "}",
      "impl ローリングハッシュ {",
      "    /// バイト列（`s.as_bytes()` や `Vec<u8>`）からローリングハッシュを構築する。",
      "    fn new(s: &[u8]) -> Self {",
      "        const 法: u64 = (1 << 61) - 1;",
      "        const 基数: u64 = 1_000_000_007;",
      "        let n = s.len();",
      "        let mut 前方 = vec![0u64; n + 1];",
      "        let mut べき = vec![1u64; n + 1];",
      "        for i in 0..n {",
      "            前方[i + 1] = Self::積(前方[i], 基数, 法).wrapping_add(s[i] as u64) % 法;",
      "            べき[i + 1] = Self::積(べき[i], 基数, 法);",
      "        }",
      "        Self { 前方, べき }",
      "    }",
      "    /// `a * b mod (2^61-1)` を u128 経由で計算する内部関数。",
      "    fn 積(a: u64, b: u64, 法: u64) -> u64 {",
      "        (a as u128 * b as u128 % 法 as u128) as u64",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の部分文字列のハッシュ値を返す。O(1)。",
      "    fn 区間ハッシュ(&self, 範囲: impl std::ops::RangeBounds<usize>) -> u64 {",
      "        const 法: u64 = (1 << 61) - 1;",
      "        let (l, r) = 半開(範囲, self.前方.len() - 1);",
      "        let 全体 = self.前方[r];",
      "        let 前 = Self::積(self.前方[l], self.べき[r - l], 法);",
      "        (全体 + 法 - 前) % 法",
      "    }",
      "    /// 2 つの区間（`a..b` / `a..=b` / `..` など）が表す部分文字列が等しいかを O(1) で判定する。",
      "    fn 等しい(",
      "        &self,",
      "        区間1: impl std::ops::RangeBounds<usize>,",
      "        区間2: impl std::ops::RangeBounds<usize>,",
      "    ) -> bool {",
      "        let n = self.前方.len() - 1;",
      "        let (l1, r1) = 半開(区間1, n);",
      "        let (l2, r2) = 半開(区間2, n);",
      "        (r1 - l1) == (r2 - l2) && self.区間ハッシュ(l1..r1) == self.区間ハッシュ(l2..r2)",
      "    }",
      "}"
    ]
  },
  "時刻軸_Mo": {
