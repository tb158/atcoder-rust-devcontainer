  "凸_多角形の_最小_幅": {
    "scope": "rust",
    "prefix": "凸_多角形の_最小_幅",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 凸包（Andrew's monotone chain）。与えた点集合をすべて含む最小の凸多角形の",
      "/// 頂点を、反時計回りの順で返す。O(N log N)。",
      "/// 一直線上に並ぶ中間点（凸包の辺上の点）は頂点に含めない。",
      "/// 点が2個以下のときは重複を除いた入力をそのまま返す。",
      "fn 凸包(点群: &[(i64, i64)]) -> Vec<(i64, i64)> {",
      "    let mut 点 = 点群.to_vec();",
      "    点.sort();",
      "    点.dedup();",
      "    let n = 点.len();",
      "    if n <= 2 {",
      "        return 点;",
      "    }",
      "    let mut 下側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in &点 {",
      "        while 下側.len() >= 2 && 外積3点(下側[下側.len() - 2], 下側[下側.len() - 1], p) <= 0",
      "        {",
      "            下側.pop();",
      "        }",
      "        下側.push(p);",
      "    }",
      "    let mut 上側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in 点.iter().rev() {",
      "        while 上側.len() >= 2 && 外積3点(上側[上側.len() - 2], 上側[上側.len() - 1], p) <= 0",
      "        {",
      "            上側.pop();",
      "        }",
      "        上側.push(p);",
      "    }",
      "    下側.pop();",
      "    上側.pop();",
      "    下側.extend(上側);",
      "    下側",
      "}",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "/// 凸多角形（点群の凸包）の**最小幅**＝平行な 2 直線で挟んだときの最小の間隔を返す。回転キャリパスで",
      "/// 凸包の各辺について最遠頂点までの距離を測り、その最小を取る。凸包構築 O(N log N) ＋ 走査 O(N)。",
      "/// 点が 2 個以下（または一直線）なら幅 0。",
      "/// 同じファイルの [`最遠点対の距離2乗`] が「最遠＝直径」なのに対し、こちらは「最薄＝幅」。",
      "/// 最小幅は、棒を通せる最小の隙間や、凸形状を平行平板で挟む最小厚みの判定に使う。",
      "fn 凸多角形の最小幅(点群: &[(i64, i64)]) -> f64 {",
      "    let 包 = 凸包(点群);",
      "    let m = 包.len();",
      "    if m <= 2 {",
      "        return 0.0;",
      "    }",
      "    let mut 最小 = f64::INFINITY;",
      "    let mut j = 1usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for i in 0..m {",
      "        let ni = (i + 1) % m;",
      "        while 外積3点(包[i], 包[ni], 包[(j + 1) % m]) > 外積3点(包[i], 包[ni], 包[j]) {",
      "            j = (j + 1) % m;",
      "        }",
      "        let 高さ2倍 = 外積3点(包[i], 包[ni], 包[j]).abs() as f64;",
      "        let 辺長 =",
      "            (((包[ni].0 - 包[i].0) as f64).powi(2) + ((包[ni].1 - 包[i].1) as f64).powi(2)).sqrt();",
      "        最小 = 最小.min(高さ2倍 / 辺長);",
      "    }",
      "    最小",
      "}"
    ]
  },
  "凸_多角形の_直径": {
    "scope": "rust",
    "prefix": "凸_多角形の_直径",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗を `i128` で返す。",
      "/// 平方根を取らないので誤差なしで距離を比較できる。差を取ってから `i128` に広げるため、",
      "/// 座標が `±10^18` でも桁あふれしない。実距離が要るときは `(d as f64).sqrt()`。",
      "fn 距離2乗(a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let dx = (a.0 - b.0) as i128;",
      "    let dy = (a.1 - b.1) as i128;",
      "    dx * dx + dy * dy",
      "}",
      "/// 凸包（Andrew's monotone chain）。与えた点集合をすべて含む最小の凸多角形の",
      "/// 頂点を、反時計回りの順で返す。O(N log N)。",
      "/// 一直線上に並ぶ中間点（凸包の辺上の点）は頂点に含めない。",
      "/// 点が2個以下のときは重複を除いた入力をそのまま返す。",
      "fn 凸包(点群: &[(i64, i64)]) -> Vec<(i64, i64)> {",
      "    let mut 点 = 点群.to_vec();",
      "    点.sort();",
      "    点.dedup();",
      "    let n = 点.len();",
      "    if n <= 2 {",
      "        return 点;",
      "    }",
      "    let mut 下側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in &点 {",
      "        while 下側.len() >= 2 && 外積3点(下側[下側.len() - 2], 下側[下側.len() - 1], p) <= 0",
      "        {",
      "            下側.pop();",
      "        }",
      "        下側.push(p);",
      "    }",
      "    let mut 上側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in 点.iter().rev() {",
      "        while 上側.len() >= 2 && 外積3点(上側[上側.len() - 2], 上側[上側.len() - 1], p) <= 0",
      "        {",
      "            上側.pop();",
      "        }",
      "        上側.push(p);",
      "    }",
      "    下側.pop();",
      "    上側.pop();",
      "    下側.extend(上側);",
      "    下側",
      "}",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "/// 点群の最遠点対の距離の 2 乗を回転キャリパスで求める。凸包構築 O(N log N) ＋ 走査 O(N)。",
      "/// 点が 1 個以下なら 0。",
      "fn 最遠点対の距離2乗(点群: &[(i64, i64)]) -> i128 {",
      "    let 包 = 凸包(点群);",
      "    let m = 包.len();",
      "    if m <= 1 {",
      "        return 0;",
      "    }",
      "    if m == 2 {",
      "        return 距離2乗(包[0], 包[1]);",
      "    }",
      "    let mut 最良 = 0i128;",
      "    let mut j = 1usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for i in 0..m {",
      "        let ni = (i + 1) % m;",
      "        while 外積3点(包[i], 包[ni], 包[(j + 1) % m]) > 外積3点(包[i], 包[ni], 包[j]) {",
      "            j = (j + 1) % m;",
      "        }",
      "        最良 = 最良.max(距離2乗(包[i], 包[j])).max(距離2乗(包[ni], 包[j]));",
      "    }",
      "    最良",
      "}"
    ]
  },
  "凸_関数_DP": {
    "scope": "rust",
    "prefix": "凸_関数_DP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::cmp::Reverse;",
      "use std::collections::BinaryHeap;",
      "/// スロープトリック。区分線形な凸関数 `f(x)` を、傾きが変化する点（折れ点）の多重集合として管理する。",
      "/// 各操作 `O(log N)`。DP の遷移が「`f += max(0, x-a)`」「`f += |x-a|`」",
      "/// 「累積 min（スライド最小値）」などで書けるとき計算量を落とせる。",
      "/// - [`Self::絶対値加算`] : `f(x) += |x - a|`。",
      "/// - [`Self::右側を平坦化`] / [`Self::左側を平坦化`] : 累積 min。",
      "/// - [`Self::最小値`] / [`Self::評価`] : 値の取得。",
      "struct スロープトリック {",
      "    最小値: i64,",
      "    左: BinaryHeap<i64>,",
      "    右: BinaryHeap<Reverse<i64>>,",
      "    加算左: i64,",
      "    加算右: i64,",
      "}",
      "impl スロープトリック {",
      "    /// 恒等的に 0 の関数 `f(x) = 0` を作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            最小値: 0,",
      "            左: BinaryHeap::new(),",
      "            右: BinaryHeap::new(),",
      "            加算左: 0,",
      "            加算右: 0,",
      "        }",
      "    }",
      "    fn 左頂点(&self) -> Option<i64> {",
      "        self.左.peek().map(|&v| v + self.加算左)",
      "    }",
      "    fn 右頂点(&self) -> Option<i64> {",
      "        self.右.peek().map(|&Reverse(v)| v + self.加算右)",
      "    }",
      "    fn 左へ(&mut self, a: i64) {",
      "        self.左.push(a - self.加算左);",
      "    }",
      "    fn 右へ(&mut self, a: i64) {",
      "        self.右.push(Reverse(a - self.加算右));",
      "    }",
      "    /// 現在の最小値 `min_x f(x)`。",
      "    fn 最小値(&self) -> i64 {",
      "        self.最小値",
      "    }",
      "    /// `f(x) += c`（定数加算）。引数は任意の整数型でよい（他のメソッドも同様）。",
      "    fn 定数加算(&mut self, c: impl TryInto<i64>) {",
      "        self.最小値 += to_i64(c);",
      "    }",
      "    /// `f(x) += max(0, x - a)`（右上がりの折れを追加）。",
      "    fn 右傾き加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        if let Some(l) = self.左頂点()",
      "            && l > a",
      "        {",
      "            self.最小値 += l - a;",
      "        }",
      "        self.左へ(a);",
      "        let v = self.左.pop().unwrap() + self.加算左;",
      "        self.右へ(v);",
      "    }",
      "    /// `f(x) += max(0, a - x)`（左上がりの折れを追加）。",
      "    fn 左傾き加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        if let Some(r) = self.右頂点()",
      "            && r < a",
      "        {",
      "            self.最小値 += a - r;",
      "        }",
      "        self.右へ(a);",
      "        let Reverse(v) = self.右.pop().unwrap();",
      "        let v = v + self.加算右;",
      "        self.左へ(v);",
      "    }",
      "    /// `f(x) += |x - a|`。",
      "    fn 絶対値加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        self.右傾き加算(a);",
      "        self.左傾き加算(a);",
      "    }",
      "    /// 累積 min: `f(x) := min_{y <= x} f(y)`（右側の上がりを消し、右へ平坦化）。",
      "    fn 右側を平坦化(&mut self) {",
      "        self.右.clear();",
      "    }",
      "    /// 累積 min: `f(x) := min_{y >= x} f(y)`（左側の上がりを消し、左へ平坦化）。",
      "    fn 左側を平坦化(&mut self) {",
      "        self.左.clear();",
      "    }",
      "    /// 平行移動: `f(x) := f(x - a)`（全折れ点を `a` ずらす）。",
      "    fn 平行移動(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        self.加算左 += a;",
      "        self.加算右 += a;",
      "    }",
      "    /// スライド最小値: `f(x) := min_{a <= d <= b} f(x - d)`（`a <= b`）。",
      "    fn 窓最小(&mut self, a: impl TryInto<i64>, b: impl TryInto<i64>) {",
      "        let (a, b) = (to_i64(a), to_i64(b));",
      "        assert!(a <= b);",
      "        self.加算左 += a;",
      "        self.加算右 += b;",
      "    }",
      "    /// `f(x)` の値を O(N) で評価する。",
      "    fn 評価(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        let mut v = self.最小値;",
      "        for &l in self.左.iter() {",
      "            let l = l + self.加算左;",
      "            if l > x {",
      "                v += l - x;",
      "            }",
      "        }",
      "        for &Reverse(r) in self.右.iter() {",
      "            let r = r + self.加算右;",
      "            if r < x {",
      "                v += x - r;",
      "            }",
      "        }",
      "        v",
      "    }",
      "}",
      "impl Default for スロープトリック {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "凸_関数_最小化": {
    "scope": "rust",
    "prefix": "凸_関数_最小化",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 下に凸（単峰）な実数関数 `f` の最小値を与える `x` を黄金分割探索で求める。",
      "/// 区間 `[左, 右]` で単峰であることが前提。`反復回数` 回だけ区間を 0.618 倍に狭める",
      "/// （`f` の評価は `反復回数 + 2` 回。幅 1e9 → 1e-9 でも 90 回程度で足りる）。",
      "/// `f` の値は `PartialOrd` なら何でもよい（`f64` / `i64` / タプルなど）。",
      "fn 黄金分割探索<T: PartialOrd>(",
      "    mut 左: f64,",
      "    mut 右: f64,",
      "    反復回数: usize,",
      "    mut f: impl FnMut(f64) -> T,",
      ") -> f64 {",
      "    let r = (5f64.sqrt() - 1.0) / 2.0;",
      "    let mut m1 = 右 - r * (右 - 左);",
      "    let mut m2 = 左 + r * (右 - 左);",
      "    let (mut f1, mut f2) = (f(m1), f(m2));",
      "    for _ in 0..反復回数 {",
      "        if f1 < f2 {",
      "            右 = m2;",
      "            (m2, f2) = (m1, f1);",
      "            m1 = 右 - r * (右 - 左);",
      "            f1 = f(m1);",
      "        } else {",
      "            左 = m1;",
      "            (m1, f1) = (m2, f2);",
      "            m2 = 左 + r * (右 - 左);",
      "            f2 = f(m2);",
      "        }",
      "    }",
      "    (左 + 右) / 2.0",
      "}",
      "/// 下に凸（単峰）な整数関数 `f` の最小値を与える整数 `x` をフィボナッチ探索で求める。",
      "/// 閉区間 `[左, 右]` で単峰であること（同値の平坦部が最小値以外にあると誤る場合がある）。",
      "/// `f` の評価は約 `log_φ(右 - 左)` 回で、`[左, 右]` の外は評価しない。",
      "/// `f` の値は `PartialOrd` なら何でもよい（`i64` / `f64` / タプルなど）。",
      "fn フィボナッチ探索<T: PartialOrd>(左: i64, 右: i64, mut f: impl FnMut(i64) -> T) -> i64 {",
      "    assert!(左 <= 右, \"フィボナッチ探索: 空区間です\");",
      "    let (mut a, mut b) = (1i64, 2i64);",
      "    while b < 右 - 左 + 2 {",
      "        (a, b) = (b, a + b);",
      "    }",
      "    let mut g = |x: i64| if x <= 右 { Some(f(x)) } else { None };",
      "    let より小 = |p: &Option<T>, q: &Option<T>| match (p, q) {",
      "        (Some(p), Some(q)) => p < q,",
      "        (Some(_), None) => true,",
      "        _ => false,",
      "    };",
      "    let (mut lo, mut hi) = (左 - 1, 左 - 1 + b);",
      "    let (mut m1, mut m2) = (hi - a, lo + a);",
      "    let (mut f1, mut f2) = (g(m1), g(m2));",
      "    while hi - lo > 3 {",
      "        if より小(&f1, &f2) {",
      "            hi = m2;",
      "            (m2, f2) = (m1, f1);",
      "            m1 = lo + hi - m2;",
      "            f1 = g(m1);",
      "        } else {",
      "            lo = m1;",
      "            (m1, f1) = (m2, f2);",
      "            m2 = lo + hi - m1;",
      "            f2 = g(m2);",
      "        }",
      "    }",
      "    let mut 最良 = (m1, f1);",
      "    for x in lo + 1..hi {",
      "        if x != m1 {",
      "            let v = g(x);",
      "            if より小(&v, &最良.1) {",
      "                最良 = (x, v);",
      "            }",
      "        }",
      "    }",
      "    最良.0",
      "}"
    ]
  },
