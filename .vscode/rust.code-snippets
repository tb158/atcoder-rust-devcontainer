    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `法` 上の連立一次方程式 `A x = b` を掃き出し（RREF）で解く。O(行数·変数数·min)。",
      "/// `係数` は各式の係数行（全行同じ長さ）、`右辺` は各式の右辺。解が無ければ `None`、",
      "/// 有れば解の一つ（自由変数は 0 とおく）を返す。`法` は**素数**であること。",
      "/// XOR（mod 2）専用の高速版は [`crate::gf2_elimination`]、行列式だけなら",
      "/// [`crate::matrix_det_mod`] を使う。",
      "fn 連立一次方程式_mod(係数: &[Vec<u64>], 右辺: &[u64], 法: u64) -> Option<Vec<u64>> {",
      "    let 行数 = 係数.len();",
      "    let 変数数 = if 行数 == 0 { 0 } else { 係数[0].len() };",
      "    let mut a: Vec<Vec<u64>> = (0..行数)",
      "        .map(|i| {",
      "            let mut row: Vec<u64> = 係数[i].iter().map(|&x| x % 法).collect();",
      "            row.push(右辺[i] % 法);",
      "            row",
      "        })",
      "        .collect();",
      "    let mut ピボット行 = vec![!0; 変数数];",
      "    let mut r = 0usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for c in 0..変数数 {",
      "        let Some(sel) = (r..行数).find(|&i| a[i][c] != 0) else {",
      "            continue;",
      "        };",
      "        a.swap(r, sel);",
      "        let inv = 累乗_mod(a[r][c], 法 - 2, 法);",
      "        for j in c..=変数数 {",
      "            a[r][j] = a[r][j] * inv % 法;",
      "        }",
      "        for i in 0..行数 {",
      "            if i != r && a[i][c] != 0 {",
      "                let f = a[i][c];",
      "                for j in c..=変数数 {",
      "                    a[i][j] = (a[i][j] + 法 - f * a[r][j] % 法) % 法;",
      "                }",
      "            }",
      "        }",
      "        ピボット行[c] = r;",
      "        r += 1;",
      "        if r == 行数 {",
      "            break;",
      "        }",
      "    }",
      "    for row in &a {",
      "        if row[..変数数].iter().all(|&v| v == 0) && row[変数数] != 0 {",
      "            return None;",
      "        }",
      "    }",
      "    let mut x = vec![0u64; 変数数];",
      "    for (c, &pr) in ピボット行.iter().enumerate() {",
      "        if pr != !0 {",
      "            x[c] = a[pr][変数数];",
      "        }",
      "    }",
      "    Some(x)",
      "}"
    ]
  },
  "n_割る_i_の_列挙": {
    "scope": "rust",
    "prefix": "n_割る_i_の_列挙",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `⌊n/i⌋`（`i = 1..=n`）の値が一定になる `i` の区間をまとめて列挙する。O(√n)。",
      "/// 各要素は `(商, 左, 右)`：`i ∈ [左, 右]` の範囲で `⌊n/i⌋ == 商`。区間は `i` の昇順、",
      "/// `商` は降順に並ぶ。`Σ_{i=1}^{n} ⌊n/i⌋` や約数関数の和などを O(√n) で計算するのに使う。",
      "fn 商の列挙(n: u64) -> Vec<(u64, u64, u64)> {",
      "    let mut res = Vec::new();",
      "    let mut i = 1;",
      "    while i <= n {",
      "        let 商 = n / i;",
      "        let 右 = n / 商;",
      "        res.push((商, i, 右));",
      "        i = 右 + 1;",
      "    }",
      "    res",
      "}"
    ]
  },
  "odd_cycle": {
    "scope": "rust",
    "prefix": "odd_cycle",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 奇数長の閉路をひとつ見つけて頂点列で返す。O(V+E)。",
      "/// 二部グラフ（＝奇閉路なし）なら `None`。返り値 `[v0, v1, …, vk]` は",
      "/// `v0-v1-…-vk-v0` がそのまま閉路で、頂点は相異なり辺数 `k+1` は奇数。",
      "/// 自己ループ `(u, u)` は長さ1の奇閉路として `[u]` を返す。",
      "/// [`二部彩色`] が `None` を返す「証拠」が欲しいとき（奇閉路を出力させる問題、",
      "/// 奇閉路上の頂点を使う構築）用。BFS 木の親を辿って同色辺の両端の合流点まで戻して復元する。",
      "fn 奇閉路(グラフ: &[Vec<usize>]) -> Option<Vec<usize>> {",
      "    use std::collections::VecDeque;",
      "    let n = グラフ.len();",
      "    let mut 色: Vec<Option<bool>> = vec![None; n];",
      "    let mut prev = vec![!0; n];",
      "    let mut 探索 = VecDeque::new();",
      "    for 始点 in 0..n {",
      "        if 色[始点].is_some() {",
      "            continue;",
      "        }",
      "        色[始点] = Some(false);",
      "        探索.push_back(始点);",
      "        while let Some(now) = 探索.pop_front() {",
      "            let c = 色[now].unwrap();",
      "            for &next in &グラフ[now] {",
      "                match 色[next] {",
      "                    None => {",
      "                        色[next] = Some(!c);",
      "                        prev[next] = now;",
      "                        探索.push_back(next);",
      "                    }",
      "                    Some(隣) if 隣 == c => {",
      "                        if now == next {",
      "                            return Some(vec![now]);",
      "                        }",
      "                        let mut 経路now = Vec::new();",
      "                        let mut x = now;",
      "                        loop {",
      "                            経路now.push(x);",
      "                            if prev[x] == !0 {",
      "                                break;",
      "                            }",
      "                            x = prev[x];",
      "                        }",
      "                        let mut 位置 = vec![!0; n];",
      "                        for (i, &x) in 経路now.iter().enumerate() {",
      "                            位置[x] = i;",
      "                        }",
      "                        let mut 経路next = Vec::new();",
      "                        let mut y = next;",
      "                        while 位置[y] == !0 {",
      "                            経路next.push(y);",
      "                            y = prev[y];",
      "                        }",
      "                        let mut 閉路 = 経路now[..=位置[y]].to_vec();",
      "                        閉路.extend(経路next.into_iter().rev());",
      "                        return Some(閉路);",
      "                    }",
      "                    Some(_) => {}",
      "                }",
      "            }",
      "        }",
      "    }",
      "    None",
      "}"
    ]
  },
  "range_二分探索": {
    "scope": "rust",
    "prefix": "range_二分探索",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "trait RangeSearch<T> {",
      "    /// 述語が最初に false になる要素の、範囲の先頭からの添字を返す（`slice::partition_point` と同じ）。",
      "    /// 全 true なら範囲の長さ、全 false と空範囲なら 0。",
      "    fn partition_point(&self, pred: impl FnMut(T) -> bool) -> usize;",
      "    /// `cmp` が `Less→Equal→Greater` の順に並ぶ前提で `Equal` の半開区間を、範囲の先頭からの添字で返す。",
      "    /// 例: `(0..n).equal_range(|i| a[i].cmp(&target))`",
      "    fn equal_range(&self, cmp: impl FnMut(T) -> std::cmp::Ordering) -> std::ops::Range<usize>;",
      "}",
      "impl<T> RangeSearch<T> for std::ops::Range<T>",
      "where",
      "    T: Copy",
      "        + Ord",
      "        + std::ops::Add<Output = T>",
      "        + std::ops::Sub<Output = T>",
      "        + std::ops::Shr<u32, Output = T>",
      "        + TryInto<usize>,",
      "{",
      "    fn partition_point(&self, mut pred: impl FnMut(T) -> bool) -> usize {",
      "        let start = self.start;",
      "        let end = self.end.max(start);",
      "        if start == end || !pred(start) {",
      "            return 0;",
      "        }",
      "        let (mut left, mut right) = (start, end);",
      "        loop {",
      "            let mid = left + ((right - left) >> 1);",
      "            if mid == left {",
      "                break;",
      "            }",
      "            if pred(mid) {",
      "                left = mid;",
      "            } else {",
      "                right = mid;",
      "            }",
      "        }",
      "        (right - start)",
      "            .try_into()",
      "            .ok()",
      "            .expect(\"partition_point: 範囲の長さが usize に収まりません\")",
      "    }",
      "    fn equal_range(&self, mut cmp: impl FnMut(T) -> std::cmp::Ordering) -> std::ops::Range<usize> {",
      "        use std::cmp::Ordering::{Greater, Less};",
      "        let lower = self.partition_point(|x| cmp(x) == Less);",
      "        let upper = self.partition_point(|x| cmp(x) != Greater);",
      "        lower..upper",
      "    }",
      "}"
    ]
  },
