      "    while pw(z, (P - 1) / 2) == 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = pw(z, q);",
      "    let mut t = pw(a, q);",
      "    let mut r = pw(a, q.div_ceil(2));",
      "    loop {",
