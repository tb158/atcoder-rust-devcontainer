    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// オイラーツアー（部分木 → 区間への変換）。根 `根` から木を DFS し、各頂点 `v` の",
      "/// 入時刻 `in_[v]` と出時刻 `out[v]` を返す（再帰なし）。O(N)。`in_` は行きがけ順 0..N。",
      "/// `辺` は 0-indexed の頂点対（AtCoder の入力そのまま）。",
      "/// 部分木 `v` は半開区間 `[in_[v], out[v])` に対応する（`out[v] - in_[v]` が部分木サイズ）。",
      "/// `u` が `v` の部分木に含まれる ⇔ `in_[v] <= in_[u] < out[v]`。",
      "/// この区間を BIT / セグ木の添字に使えば「部分木への一括加算・部分木和」を扱える。",
      "fn オイラーツアー(n: usize, 辺: &[(usize, usize)], 根: usize) -> (Vec<usize>, Vec<usize>) {",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut in_ = vec![0usize; n];",
      "    let mut out = vec![0usize; n];",
      "    let mut 時刻 = 0usize;",
      "    let mut 探索 = vec![(根, !0)];",
      "    while let Some((now, prev)) = 探索.pop() {",
      "        if now >= n {",
      "            let now = !now;",
      "            out[now] = 時刻;",
      "            continue;",
      "        }",
      "        in_[now] = 時刻;",
      "        時刻 += 1;",
      "        探索.push((!now, prev));",
      "        for &next in &グラフ[now] {",
      "            if next != prev {",
      "                探索.push((next, now));",
      "            }",
      "        }",
      "    }",
      "    (in_, out)",
      "}"
    ]
  },
  "オイラー_ツアー_Mo": {
    "scope": "rust",
    "prefix": "オイラー_ツアー_Mo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木のパスクエリ（頂点 `u`-`v` 間の単純パス上の集計）を扱う Mo の状態インタフェース。",
      "/// オイラーツアー上の位置を出入りさせると、ある頂点はパス上にあるとき区間内にちょうど 1 回現れる。",
      "/// ランナーがその「出現回数の偶奇」を管理し、パスに入る頂点で [`追加`](木Mo::追加)、",
      "/// 出る頂点で [`削除`](木Mo::削除) を呼ぶ。状態は集合への頂点の出入りだけ実装すればよい。",
      "/// 列に対する素の [`Mo`](crate::mo) とは別技法。",
      "trait 木Mo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 頂点 `頂点` を現在の集合に加える。",
      "    fn 追加(&mut self, 頂点: usize);",
      "    /// 頂点 `頂点` を現在の集合から取り除く。",
      "    fn 削除(&mut self, 頂点: usize);",
      "    /// 現在の集合に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// 木上の Mo 本体。`n` は頂点数、`辺` は AtCoder の入力そのまま（0-indexed の頂点対）、",
      "/// `根` は根、`クエリ` は `(u, v)`（u-v パス）の列。",
      "/// 全体 `O((N + Q)√N · 更新コスト)`。`状態` は空集合の初期状態で渡すこと。",
      "fn 木上mo実行<S: 木Mo>(",
      "    n: usize,",
      "    辺: &[(usize, usize)],",
      "    根: usize,",
      "    クエリ: &[(usize, usize)],",
      "    状態: &mut S,",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    if q == 0 {",
      "        return Vec::new();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut st = vec![0usize; n];",
      "    let mut en = vec![0usize; n];",
      "    let mut 順 = Vec::with_capacity(2 * n);",
      "    let mut depth = vec![0usize; n];",
      "    let mut prev = vec![!0; n];",
      "    let mut 時刻 = 0usize;",
      "    let mut 探索 = vec![根];",
      "    while let Some(now) = 探索.pop() {",
      "        if now >= n {",
      "            let now = !now;",
      "            en[now] = 時刻;",
      "            順.push(now);",
      "            時刻 += 1;",
      "            continue;",
      "        }",
      "        depth[now] = if prev[now] == !0 {",
      "            0",
      "        } else {",
      "            depth[prev[now]] + 1",
      "        };",
      "        st[now] = 時刻;",
      "        順.push(now);",
      "        時刻 += 1;",
      "        探索.push(!now);",
      "        for &next in &グラフ[now] {",
      "            if next != prev[now] {",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let log = (usize::BITS - n.leading_zeros()).max(1) as usize;",
      "    let mut up = vec![vec![!0; n]; log];",
      "    up[0].copy_from_slice(&prev);",
      "    for k in 1..log {",
      "        for v in 0..n {",
      "            let m = up[k - 1][v];",
      "            up[k][v] = if m == !0 { !0 } else { up[k - 1][m] };",
      "        }",
      "    }",
      "    let lca = |mut u: usize, mut v: usize| -> usize {",
      "        if depth[u] < depth[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = depth[u] - depth[v];",
      "        for (k, 上) in up.iter().enumerate() {",
      "            if 差 >> k & 1 == 1 {",
      "                u = 上[u];",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for 上 in up.iter().rev() {",
      "            if 上[u] != 上[v] {",
      "                u = 上[u];",
      "                v = 上[v];",
      "            }",
      "        }",
      "        prev[u]",
      "    };",
      "    let mut 区間: Vec<(usize, usize, Option<usize>, usize)> = Vec::with_capacity(q);",
      "    for (qi, &(mut u, mut v)) in クエリ.iter().enumerate() {",
      "        if st[u] > st[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let l = lca(u, v);",
      "        if l == u {",
      "            区間.push((st[u], st[v] + 1, None, qi));",
      "        } else {",
      "            区間.push((en[u], st[v] + 1, Some(l), qi));",
      "        }",
      "    }",
      "    let b = ((2 * n) as f64).sqrt() as usize + 1;",
      "    区間.sort_by(|x, y| {",
      "        let (bx, by) = (x.0 / b, y.0 / b);",
      "        if bx != by {",
      "            bx.cmp(&by)",
      "        } else if bx % 2 == 0 {",
      "            x.1.cmp(&y.1)",
      "        } else {",
      "            y.1.cmp(&x.1)",
      "        }",
      "    });",
      "    let mut 使用中 = vec![false; n];",
      "    let mut 出力: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let (mut cl, mut cr) = (0usize, 0usize);",
      "    for &(l, r, extra, qi) in &区間 {",
      "        while cr < r {",
      "            let v = 順[cr];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            let v = 順[cl];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            let v = 順[cr];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "        }",
      "        while cl < l {",
      "            let v = 順[cl];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "            cl += 1;",
      "        }",
      "        出力[qi] = Some(match extra {",
      "            Some(w) => {",
      "                状態.追加(w);",
      "                let a = 状態.答え();",
      "                状態.削除(w);",
      "                a",
      "            }",
      "            None => 状態.答え(),",
      "        });",
      "    }",
      "    出力.into_iter().map(|o| o.unwrap()).collect()",
      "}"
    ]
  },
