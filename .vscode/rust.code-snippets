  "ChromaticNumber": {
    "scope": "rust",
    "prefix": "ChromaticNumber",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向グラフの彩色数（隣接頂点を異色で塗り分けるのに必要な最小色数）を O(2^n · n) で求める。頂点数 `n <= 20`。",
      "/// 包除原理: 「`k` 個の独立集合（順序付き・重複可）で全頂点を覆う場合の数」",
      "/// `f(k) = Σ_S (-1)^{n-|S|} · g(S)^k`（`g(S)` は `S` に含まれる独立集合の個数）が正になる最小の `k` が彩色数。",
      "fn 彩色数(n: usize, 辺: &[(usize, usize)]) -> usize {",
      "    assert!(n <= 20, \"n must be <= 20\");",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let mut グラフ = vec![0u32; n];",
      "    for &(u, v) in 辺 {",
      "        if u != v {",
      "            グラフ[u] |= 1 << v;",
      "            グラフ[v] |= 1 << u;",
      "        }",
      "    }",
      "    let 全 = 1usize << n;",
      "    let mut g = vec![0u64; 全];",
      "    g[0] = 1;",
      "    for s in 1..全 {",
      "        let v = s.trailing_zeros() as usize;",
      "        let 無v = s & !(1 << v);",
      "        g[s] = g[無v] + g[無v & !(グラフ[v] as usize)];",
      "    }",
      "    const 素数: [u64; 2] = [1_000_000_007, 1_000_000_009];",
      "    let mut 現在 = [vec![1u64; 全], vec![1u64; 全]];",
      "    for k in 1..=n {",
      "        let mut 非零 = false;",
      "        for (idx, &p) in 素数.iter().enumerate() {",
      "            let mut 和: i64 = 0;",
      "            #[allow(clippy::needless_range_loop)]",
      "            for s in 0..全 {",
      "                現在[idx][s] = 現在[idx][s] * (g[s] % p) % p;",
      "                let 符号 = if (n - s.count_ones() as usize) % 2 == 0 {",
      "                    1i64",
      "                } else {",
      "                    -1",
      "                };",
      "                和 += 符号 * 現在[idx][s] as i64;",
      "            }",
      "            if 和 % p as i64 != 0 {",
      "                非零 = true;",
      "            }",
      "        }",
      "        if 非零 {",
      "            return k;",
      "        }",
      "    }",
      "    n",
      "}"
    ]
  },
  "ChuLiu": {
    "scope": "rust",
    "prefix": "ChuLiu",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最小有向全域木（最小全域内向木 / arborescence）の総コストを Chu-Liu/Edmonds 法で求める。",
      "/// 根から全頂点へ到達する有向木のうちコスト最小のもの。O(V·E)。",
      "/// `辺` は `(始点, 終点, コスト)`。根から到達できない頂点があれば `None`。",
      "/// petgraph の `min_spanning_tree` は無向専用なので、有向版が要るときはこれを使う。",
      "fn 最小有向全域木(頂点数: usize, 根: usize, 辺: &[(usize, usize, i64)]) -> Option<i64> {",
      "    const 無限: i64 = i64::MAX;",
      "    let mut n = 頂点数;",
      "    let mut 根 = 根;",
      "    let mut 辺: Vec<(usize, usize, i64)> = 辺.to_vec();",
      "    let mut 合計 = 0i64;",
      "    loop {",
      "        let mut 入コスト = vec![無限; n];",
      "        let mut 入元 = vec![!0; n];",
      "        for &(u, v, w) in &辺 {",
      "            if u != v && w < 入コスト[v] {",
      "                入コスト[v] = w;",
      "                入元[v] = u;",
      "            }",
      "        }",
      "        for (v, &c) in 入コスト.iter().enumerate() {",
      "            if v != 根 && c == 無限 {",
      "                return None;",
      "            }",
      "        }",
      "        let mut id = vec![!0; n];",
      "        let mut 到達済 = vec![!0; n];",
      "        let mut 閉路数 = 0usize;",
      "        #[allow(clippy::needless_range_loop)]",
      "        for v in 0..n {",
      "            if v == 根 {",
      "                continue;",
      "            }",
      "            合計 += 入コスト[v];",
      "            let mut u = v;",
      "            while 到達済[u] != v && id[u] == !0 && u != 根 {",
      "                到達済[u] = v;",
      "                u = 入元[u];",
      "            }",
      "            if u != 根 && id[u] == !0 {",
      "                let mut x = 入元[u];",
      "                while x != u {",
      "                    id[x] = 閉路数;",
      "                    x = 入元[x];",
      "                }",
      "                id[u] = 閉路数;",
      "                閉路数 += 1;",
      "            }",
      "        }",
      "        if 閉路数 == 0 {",
      "            return Some(合計);",
      "        }",
      "        for x in id.iter_mut() {",
      "            if *x == !0 {",
      "                *x = 閉路数;",
      "                閉路数 += 1;",
      "            }",
      "        }",
      "        let mut 新辺 = Vec::new();",
      "        for &(u, v, w) in &辺 {",
      "            if id[u] != id[v] {",
      "                新辺.push((id[u], id[v], w - 入コスト[v]));",
      "            }",
      "        }",
      "        辺 = 新辺;",
      "        n = 閉路数;",
      "        根 = id[根];",
      "    }",
      "}"
    ]
  },
