      "            ct += 1;",
      "        }",
      "        while ct > t {",
      "            ct -= 1;",
      "            状態.後退(ct, cl, cr);",
      "        }",
      "        出力[i] = Some(状態.答え());",
      "    }",
      "    for o in 出力 {",
      "        答え.push(o.unwrap());",
      "    }",
      "    答え",
      "}"
