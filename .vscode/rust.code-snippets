      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// HL 分解（Heavy-Light Decomposition）。根付き木のパス/部分木を `pos` 上の連続区間に",
      "/// 落とし込み、`ac_library::Segtree` 等の区間データ構造と組み合わせて使う。構築 O(N)。",
      "/// - [`Self::パス区間`] : `u`-`v` パス（頂点モデル、LCA を含む）を半開区間 `[l, r)` の列に分解。",
      "/// - [`Self::部分木区間`] : `v` の部分木を 1 つの半開区間に。",
      "/// - [`Self::lca`] : 最近共通祖先 O(log N)。",
      "/// `pos[v]` は heavy path が連続するよう振った Euler 順位置。区間データ構造には",
      "/// `pos` 順で値を載せる。辺に値を持たせたい場合は「子頂点に辺の値を載せ、パス分解時に",
      "/// LCA を 1 つ除く」運用にする。",
      "struct 重軽分解 {",
      "    prev: Vec<usize>,",
      "    深さ: Vec<usize>,",
      "    sz: Vec<usize>,",
      "    /// `head[v]`: `v` を含む heavy path の先頭（最も浅い）頂点",
      "    head: Vec<usize>,",
      "    /// `pos[v]`: 区間データ構造上での `v` の位置",
      "    pos: Vec<usize>,",
      "}",
      "impl 重軽分解 {",
      "    /// 頂点数 `n`・辺リスト `辺`（AtCoder の入力そのまま）と根から構築する。O(N)。",
      "    fn new(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut prev = vec![!0; n];",
      "        let mut 深さ = vec![0usize; n];",
      "        let mut sz = vec![1usize; n];",
      "        let mut heavy = vec![!0; n];",
      "        let mut 順 = Vec::with_capacity(n);",
      "        let mut 探索 = vec![根];",
      "        while let Some(now) = 探索.pop() {",
      "            順.push(now);",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] {",
      "                    prev[next] = now;",
      "                    深さ[next] = 深さ[now] + 1;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        for &now in 順.iter().rev() {",
      "            let mut 最大 = 0;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] {",
      "                    sz[now] += sz[next];",
      "                    if sz[next] > 最大 {",
      "                        最大 = sz[next];",
      "                        heavy[now] = next;",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        let mut head = vec![0usize; n];",
      "        let mut pos = vec![0usize; n];",
      "        let mut 次位置 = 0usize;",
      "        let mut 探索 = vec![(根, 根)];",
      "        while let Some((now, h)) = 探索.pop() {",
      "            head[now] = h;",
      "            pos[now] = 次位置;",
      "            次位置 += 1;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] && next != heavy[now] {",
      "                    探索.push((next, next));",
      "                }",
      "            }",
      "            if heavy[now] != !0 {",
      "                探索.push((heavy[now], h));",
      "            }",
      "        }",
      "        Self {",
      "            prev,",
      "            深さ,",
      "            sz,",
      "            head,",
      "            pos,",
      "        }",
      "    }",
      "    /// 区間データ構造上の位置 `pos[v]`。",
      "    fn 位置(&self, v: usize) -> usize {",
      "        self.pos[v]",
      "    }",
      "    /// 最近共通祖先。O(log N)。",
      "    fn lca(&self, mut u: usize, mut v: usize) -> usize {",
      "        while self.head[u] != self.head[v] {",
      "            if self.深さ[self.head[u]] < self.深さ[self.head[v]] {",
      "                std::mem::swap(&mut u, &mut v);",
      "            }",
      "            u = self.prev[self.head[u]];",
      "        }",
      "        if self.深さ[u] < self.深さ[v] {",
      "            u",
      "        } else {",
      "            v",
      "        }",
      "    }",
      "    /// `u`-`v` パス上の頂点集合を、区間データ構造上の半開区間 `[l, r)` の列で返す（順不同）。",
      "    /// LCA を含む頂点モデル。区間は O(log N) 本。",
      "    fn パス区間(&self, mut u: usize, mut v: usize) -> Vec<(usize, usize)> {",
      "        let mut 区間 = Vec::new();",
      "        while self.head[u] != self.head[v] {",
      "            if self.深さ[self.head[u]] < self.深さ[self.head[v]] {",
      "                std::mem::swap(&mut u, &mut v);",
      "            }",
      "            let h = self.head[u];",
      "            区間.push((self.pos[h], self.pos[u] + 1));",
      "            u = self.prev[h];",
      "        }",
      "        let (lo, hi) = if self.pos[u] <= self.pos[v] {",
      "            (self.pos[u], self.pos[v])",
      "        } else {",
      "            (self.pos[v], self.pos[u])",
      "        };",
      "        区間.push((lo, hi + 1));",
      "        区間",
      "    }",
      "    /// `v` を根とする部分木に対応する半開区間 `[l, r)`。O(1)。",
      "    fn 部分木区間(&self, v: usize) -> (usize, usize) {",
      "        (self.pos[v], self.pos[v] + self.sz[v])",
      "    }",
      "}"
    ]
  },
  "Hierholzer": {
    "scope": "rust",
    "prefix": "Hierholzer",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 有向グラフのオイラー路（全ての辺をちょうど 1 回ずつ通る路）を Hierholzer 法で求める。",
      "/// 再帰なし、O(V + E)。",
      "/// `頂点数` は頂点数、`辺` は `(from, to)` の列。存在すれば通過頂点列（長さ `辺数 + 1`）を返し、",
      "/// 存在しなければ `None`。オイラー閉路の場合は始点と終点が一致する列になる。",
      "/// 存在条件: 辺を持つ頂点が連結で、各頂点の `出次数 - 入次数` が",
      "/// 「全て 0（閉路）」または「始点だけ +1・終点だけ -1・他 0（路）」であること。",
      "fn オイラー路_有向(頂点数: usize, 辺: &[(usize, usize)]) -> Option<Vec<usize>> {",
      "    let m = 辺.len();",
      "    if m == 0 {",
      "        return None;",
      "    }",
      "    let mut 出辺: Vec<Vec<usize>> = vec![vec![]; 頂点数];",
      "    let mut 出次数 = vec![0i64; 頂点数];",
      "    let mut 入次数 = vec![0i64; 頂点数];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        出辺[u].push(i);",
      "        出次数[u] += 1;",
      "        入次数[v] += 1;",
      "    }",
      "    let mut 始点 = !0;",
      "    let mut 始点候補数 = 0;",
      "    let mut 終点候補数 = 0;",
      "    for v in 0..頂点数 {",
      "        match 出次数[v] - 入次数[v] {",
      "            0 => {}",
      "            1 => {",
      "                始点候補数 += 1;",
      "                始点 = v;",
      "            }",
      "            -1 => 終点候補数 += 1,",
      "            _ => return None,",
      "        }",
      "    }",
      "    let 閉路 = 始点候補数 == 0 && 終点候補数 == 0;",
      "    if !(閉路 || (始点候補数 == 1 && 終点候補数 == 1)) {",
      "        return None;",
      "    }",
      "    if 始点 == !0 {",
      "        始点 = (0..頂点数).find(|&v| 出次数[v] > 0)?;",
      "    }",
      "    let mut 次に見る = vec![0usize; 頂点数];",
      "    let mut 探索 = vec![始点];",
      "    let mut 経路 = Vec::with_capacity(m + 1);",
      "    while let Some(&now) = 探索.last() {",
      "        if 次に見る[now] < 出辺[now].len() {",
      "            let e = 出辺[now][次に見る[now]];",
      "            次に見る[now] += 1;",
      "            探索.push(辺[e].1);",
      "        } else {",
      "            経路.push(now);",
      "            探索.pop();",
      "        }",
      "    }",
      "    経路.reverse();",
      "    if 経路.len() == m + 1 {",
      "        Some(経路)",
      "    } else {",
      "        None",
      "    }",
      "}"
    ]
  },
  "HopcroftKarp": {
    "scope": "rust",
    "prefix": "HopcroftKarp",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::VecDeque;",
      "/// Hopcroft-Karp 法による二部グラフの最大マッチング。O(E√V)。",
      "/// `ac_library::MaxFlow` でも最大二部マッチングは解けるが、こちらは二部マッチング専用で",
      "/// E√V と高速。`pathfinding::kuhn_munkres` は重み付き割当専用なので、",
      "/// 単純な最大本数マッチングにはこちらを使う。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に対応も保持）。",
      "/// - [`Self::マッチング`] : マッチした `(左, 右)` の組を返す。",
      "struct ホップクロフトカープ {",
      "    左数: usize,",
      "    グラフ: Vec<Vec<usize>>,",
      "    左相手: Vec<i64>,",
      "    右相手: Vec<i64>,",
      "    距離: Vec<i64>,",
      "}",
      "impl ホップクロフトカープ {",
      "    /// 左頂点 `左数` 個・右頂点 `右数` 個の二部グラフを作る。",
      "    fn new(左数: usize, 右数: usize) -> Self {",
      "        Self {",
      "            左数,",
      "            グラフ: vec![Vec::new(); 左数],",
      "            左相手: vec![-1; 左数],",
      "            右相手: vec![-1; 右数],",
      "            距離: vec![-1; 左数],",
      "        }",
      "    }",
      "    /// 左頂点 `u` と右頂点 `v` を結ぶ辺を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.グラフ[u].push(v);",
      "    }",
      "    /// 未マッチ左頂点から BFS して層（距離）を作る。増加道が存在すれば true。",
      "    fn bfs(&mut self) -> bool {",
      "        let mut 探索 = VecDeque::new();",
      "        for u in 0..self.左数 {",
      "            if self.左相手[u] < 0 {",
      "                self.距離[u] = 0;",
      "                探索.push_back(u);",
      "            } else {",
      "                self.距離[u] = -1;",
      "            }",
      "        }",
      "        let mut 増加道あり = false;",
      "        while let Some(u) = 探索.pop_front() {",
      "            for i in 0..self.グラフ[u].len() {",
      "                let v = self.グラフ[u][i];",
      "                let w = self.右相手[v];",
      "                if w < 0 {",
      "                    増加道あり = true;",
      "                } else {",
      "                    let w = w as usize;",
      "                    if self.距離[w] < 0 {",
      "                        self.距離[w] = self.距離[u] + 1;",
      "                        探索.push_back(w);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        増加道あり",
      "    }",
      "    /// 層に沿って `u` から増加道を探し、見つかれば反転して true。",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn dfs(&mut self, u: usize) -> bool {",
      "        for i in 0..self.グラフ[u].len() {",
      "            let v = self.グラフ[u][i];",
      "            let w = self.右相手[v];",
      "            let 進める =",
      "                w < 0 || (self.距離[w as usize] == self.距離[u] + 1 && self.dfs(w as usize));",
      "            if 進める {",
      "                self.左相手[u] = v as i64;",
      "                self.右相手[v] = u as i64;",
      "                return true;",
      "            }",
      "        }",
      "        self.距離[u] = -1;",
      "        false",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut 本数 = 0;",
      "        while self.bfs() {",
      "            for u in 0..self.左数 {",
      "                if self.左相手[u] < 0 && self.dfs(u) {",
      "                    本数 += 1;",
      "                }",
      "            }",
      "        }",
      "        本数",
      "    }",
      "    /// マッチした `(左, 右)` の組を返す。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn マッチング(&self) -> Vec<(usize, usize)> {",
      "        (0..self.左数)",
      "            .filter(|&u| self.左相手[u] >= 0)",
      "            .map(|u| (u, self.左相手[u] as usize))",
      "            .collect()",
      "    }",
      "}"
    ]
  },
  "Hungarian": {
    "scope": "rust",
    "prefix": "Hungarian",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ハンガリアン法（Kuhn–Munkres）で割当問題（最小重み完全マッチング）を解く。`O(n²m)`。",
      "/// `コスト[i][j]` を行 `i`・列 `j` の費用とし、各行に相異なる列を割り当てて総費用を最小化する。",
      "/// 行数 `n <= 列数 m` であること（足りない列があると割り当て不能）。費用は負でもよい。",
      "/// 返り値は `(最小総費用, 割当)`。`割当[i]` は行 `i` に割り当てられた列（0 始まり）。",
      "fn 割当問題(コスト: &[Vec<i64>]) -> (i64, Vec<usize>) {",
      "    let n = コスト.len();",
      "    if n == 0 {",
      "        return (0, Vec::new());",
      "    }",
      "    assert!(",
      "        コスト[0].len() >= n,",
      "        \"ハンガリアン法: 列数は行数以上である必要があります\"",
      "    );",
      "    let 行列 = pathfinding::matrix::Matrix::from_rows(コスト.iter().cloned())",
      "        .expect(\"コストの全行は同じ列数であること\");",
      "    pathfinding::kuhn_munkres::kuhn_munkres_min(&行列)",
      "}"
    ]
  },
  "ImplicitTreap": {
    "scope": "rust",
    "prefix": "ImplicitTreap",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 陰的 Treap（implicit treap）。配列を平衡二分木で表し、任意位置への挿入・削除、",
      "/// 区間反転、区間和、一点取得を全て O(log N) で行える。添字をキーに持たず部分木サイズで",
      "/// 位置を決める「陰的キー」方式。",
      "/// - [`Self::挿入`] / [`Self::削除`] : 位置指定の挿入・削除。",
      "/// - [`Self::反転`] : 半開区間 `[l, r)` を反転。",
      "/// - [`Self::区間和`] : 半開区間 `[l, r)` の和。",
      "/// - [`Self::取得`] : 1 要素の値。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "/// 位置ではなく値の大小で並べた集合（k 番目・順位）が欲しいなら",
      "/// [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合) を使う。",
      "struct 陰的Treap<T> {",
      "    値: Vec<T>,",
      "    優先度: Vec<u64>,",
      "    サイズ: Vec<usize>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "    左: Vec<usize>,",
      "    右: Vec<usize>,",
      "    rng: u64,",
      "    根: usize,",
      "}",
      "impl<T> 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn new() -> Self {",
      "        Self {",
      "            値: vec![T::default()],",
      "            優先度: vec![0],",
      "            サイズ: vec![0],",
      "            和: vec![T::default()],",
      "            反転: vec![false],",
      "            左: vec![0],",
      "            右: vec![0],",
      "            rng: 0x9e37_79b9_7f4a_7c15,",
      "            根: 0,",
      "        }",
      "    }",
      "    fn 乱数(&mut self) -> u64 {",
      "        let mut x = self.rng;",
      "        x ^= x << 13;",
      "        x ^= x >> 7;",
      "        x ^= x << 17;",
      "        self.rng = x;",
      "        x",
      "    }",
      "    fn 新規ノード(&mut self, 値: T) -> usize {",
      "        let p = self.乱数();",
      "        self.値.push(値);",
      "        self.優先度.push(p);",
      "        self.サイズ.push(1);",
      "        self.和.push(値);",
      "        self.反転.push(false);",
      "        self.左.push(0);",
      "        self.右.push(0);",
      "        self.値.len() - 1",
      "    }",
      "    /// 子の情報から `t` のサイズと和を再計算する。反転フラグはサイズ・和に影響しない。",
      "    fn 更新(&mut self, t: usize) {",
      "        if t == 0 {",
      "            return;",
      "        }",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.サイズ[t] = 1 + self.サイズ[l] + self.サイズ[r];",
      "        self.和[t] = self.値[t] + self.和[l] + self.和[r];",
      "    }",
      "    /// `t` に溜まった反転遅延を子へ押し下げる。",
      "    fn 伝播(&mut self, t: usize) {",
      "        if t == 0 || !self.反転[t] {",
      "            return;",
      "        }",
      "        self.反転[t] = false;",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.左[t] = r;",
      "        self.右[t] = l;",
      "        if l != 0 {",
      "            self.反転[l] ^= true;",
      "        }",
      "        if r != 0 {",
      "            self.反転[r] ^= true;",
      "        }",
      "    }",
      "    /// `t` を「左 k 要素」と「残り」に分割し、`(左根, 右根)` を返す。",
      "    fn split(&mut self, t: usize, k: usize) -> (usize, usize) {",
      "        if t == 0 {",
      "            return (0, 0);",
      "        }",
      "        self.伝播(t);",
      "        let 左サイズ = self.サイズ[self.左[t]];",
      "        if k <= 左サイズ {",
      "            let (l, r) = self.split(self.左[t], k);",
      "            self.左[t] = r;",
      "            self.更新(t);",
      "            (l, t)",
      "        } else {",
      "            let (l, r) = self.split(self.右[t], k - 左サイズ - 1);",
      "            self.右[t] = l;",
      "            self.更新(t);",
      "            (t, r)",
      "        }",
      "    }",
      "    /// 2 つの木を連結する。`l` の全要素が `r` の前に来る。",
      "    fn merge(&mut self, l: usize, r: usize) -> usize {",
      "        if l == 0 {",
      "            return r;",
      "        }",
      "        if r == 0 {",
      "            return l;",
      "        }",
      "        if self.優先度[l] > self.優先度[r] {",
      "            self.伝播(l);",
      "            let 新右 = self.merge(self.右[l], r);",
      "            self.右[l] = 新右;",
      "            self.更新(l);",
      "            l",
      "        } else {",
      "            self.伝播(r);",
      "            let 新左 = self.merge(l, self.左[r]);",
      "            self.左[r] = 新左;",
      "            self.更新(r);",
      "            r",
      "        }",
      "    }",
      "    /// 末尾に値を追加する。",
      "    fn 末尾追加(&mut self, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        self.根 = self.merge(根, 新);",
      "    }",
      "    /// 位置 `pos`（0-indexed、`pos == 長さ` で末尾）に `値` を挿入する。",
      "    fn 挿入(&mut self, pos: usize, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let 左 = self.merge(l, 新);",
      "        self.根 = self.merge(左, r);",
      "    }",
      "    /// 位置 `pos`（0-indexed）の要素を削除する。",
      "    fn 削除(&mut self, pos: usize) {",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let (_削除, r2) = self.split(r, 1);",
      "        self.根 = self.merge(l, r2);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）を反転する。",
      "    fn 反転(&mut self, 範囲: impl std::ops::RangeBounds<usize>) {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        if b != 0 {",
      "            self.反転[b] ^= true;",
      "        }",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の和。",
      "    fn 区間和(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return T::default();",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        let 結果 = self.和[b];",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "        結果",
      "    }",
      "    /// 位置 `pos`（0-indexed）の値。",
      "    fn 取得(&mut self, pos: usize) -> T {",
      "        self.区間和(pos..pos + 1)",
      "    }",
      "    /// 要素数。",
      "    fn 長さ(&self) -> usize {",
      "        self.サイズ[self.根]",
      "    }",
      "}",
      "impl<T> Default for 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
