      "fn 行列の階数_mod(行列: &[Vec<u64>], 法: u64) -> usize {",
      "    let 行数 = 行列.len();",
      "    if 行数 == 0 {",
      "        return 0;",
      "    }",
      "    let 列数 = 行列[0].len();",
      "    let mut a: Vec<Vec<u64>> = 行列",
      "        .iter()",
