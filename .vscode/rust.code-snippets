      "            pos[now] = 次位置;",
      "            次位置 += 1;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] && next != heavy[now] {",
      "                    探索.push((next, next));",
      "                }",
      "            }",
      "            if heavy[now] != !0 {",
      "                探索.push((heavy[now], h));",
      "            }",
      "        }",
      "        Self {",
      "            prev,",
      "            深さ,",
      "            sz,",
      "            head,",
      "            pos,",
      "        }",
      "    }",
      "    /// 区間データ構造上の位置 `pos[v]`。",
