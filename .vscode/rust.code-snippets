      "    }",
      "}",
      "/// Gusfield の簡易アルゴリズムで Gomory–Hu 木（等価フロー木）を構築する。`ac_library::MfGraph` を",
      "/// `n-1` 回呼ぶ。`辺` は `(u, v, 容量)` の無向辺（容量非負、多重辺は別々に追加、自己ループは無視）。",
      "/// 計算量は最大流 `n-1` 回ぶん。非連結なグラフでは成分間のカットは `0` になる。",
      "fn 全点対最小カット木構築(",
      "    n: usize,",
      "    辺: &[(usize, usize, i64)],",
      ") -> 全点対最小カット木 {",
      "    let mut prev = vec![0usize; n];",
      "    let mut 重み = vec![0i64; n];",
      "    for i in 1..n {",
      "        let t = prev[i];",
      "        let mut g = MfGraph::<i64>::new(n);",
      "        for &(u, v, w) in 辺 {",
      "            if u != v {",
      "                g.add_edge(u, v, w);",
      "                g.add_edge(v, u, w);",
      "            }",
      "        }",
      "        let f = g.flow(i, t);",
      "        重み[i] = f;",
      "        let 側 = g.min_cut(i);",
      "        for j in (i + 1)..n {",
      "            if 側[j] && prev[j] == t {",
      "                prev[j] = i;",
      "            }",
      "        }",
      "    }",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for i in 1..n {",
      "        グラフ[i].push((prev[i], 重み[i]));",
      "        グラフ[prev[i]].push((i, 重み[i]));",
      "    }",
      "    全点対最小カット木 {",
      "        prev, 重み, グラフ",
      "    }",
      "}"
    ]
  },
