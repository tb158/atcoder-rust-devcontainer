    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 下位集合に対する高速ゼータ変換（SOS DP, sum over subsets）。",
      "/// `f[S]` を `g[S] = Σ_{T ⊆ S} f[T]` へ in-place に書き換える。O(N · 2^N)。",
      "/// `f.len()` は 2 のべき乗（= 2^N）であること。逆変換は [`下位集合メビウス変換`]。",
      "/// 要素型は加算できれば何でもよい（i64 / usize / f64 / ModInt など）。",
      "fn 下位集合ゼータ変換<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    let mut bit = 1;",
      "    while bit < n {",
      "        for s in 0..n {",
      "            if s & bit != 0 {",
      "                f[s] += f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}",
      "/// [`下位集合ゼータ変換`] の逆変換。`g[S] = Σ_{T ⊆ S} f[T]` から `f` を復元する。O(N · 2^N)。",
      "/// 符号なし整数は変換途中で負になり得るので i64 / ModInt 等を使うこと（ゼータ像の復元なら符号なしでも可）。",
      "fn 下位集合メビウス変換<T: Copy + std::ops::SubAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    let mut bit = 1;",
      "    while bit < n {",
      "        for s in 0..n {",
      "            if s & bit != 0 {",
      "                f[s] -= f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}"
    ]
  },
  "部分集合_和_畳み込み": {
    "scope": "rust",
    "prefix": "部分集合_和_畳み込み",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 下位集合方向のゼータ変換（SOS）。`f[S]` を `Σ_{T ⊆ S} f[T]` へ in-place 変換する。`O(n · 2^n)`。",
      "/// 部分集合畳み込み内部で各ランク層に適用する補助関数。",
      "fn 部分集合ゼータ<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let m = f.len();",
      "    let mut bit = 1;",
      "    while bit < m {",
      "        for s in 0..m {",
      "            if s & bit != 0 {",
      "                f[s] += f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}",
      "/// [`部分集合ゼータ`] の逆（メビウス）。`Σ_{T ⊆ S} f[T]` から `f` を復元する。`O(n · 2^n)`。",
      "fn 部分集合メビウス<T: Copy + std::ops::SubAssign>(f: &mut [T]) {",
      "    let m = f.len();",
      "    let mut bit = 1;",
      "    while bit < m {",
      "        for s in 0..m {",
      "            if s & bit != 0 {",
      "                f[s] -= f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}",
      "/// 部分集合畳み込み（subset sum convolution）。`h[S] = Σ_{T ⊆ S} f[T]·g[S∖T]` を",
      "/// `O(n^2 · 2^n)` で求める（`n` はビット数、配列長は `2^n`）。`T` と `S∖T` が**素**（重なり無し）な",
      "/// 分割だけを足し合わせる点が、単なる下位集合ゼータ（[`zeta_mobius`](crate::zeta_mobius)）の積とは異なる。",
      "/// 連結部分グラフ数え上げ・集合被覆 DP・独立集合の合成などに使う。",
      "/// 要素型は加減乗できれば何でもよい（i64 / f64 / ModInt など）。i64 は乗算の重なりで",
      "/// オーバーフローし得るので、MOD 付き数え上げでは ModInt をそのまま渡す。",
      "fn 部分集合畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::SubAssign + std::ops::Mul<Output = T>,",
      "{",
      "    let m = f.len();",
      "    assert_eq!(m, g.len(), \"f と g は同じ長さ\");",
      "    assert!(m.is_power_of_two(), \"長さは 2 のべき乗\");",
      "    let n = m.trailing_zeros() as usize;",
      "    let mut fh = vec![vec![T::default(); m]; n + 1];",
      "    let mut gh = vec![vec![T::default(); m]; n + 1];",
      "    for (s, (&fv, &gv)) in f.iter().zip(g).enumerate() {",
      "        let k = (s as u32).count_ones() as usize;",
      "        fh[k][s] = fv;",
      "        gh[k][s] = gv;",
      "    }",
      "    for k in 0..=n {",
      "        部分集合ゼータ(&mut fh[k]);",
      "        部分集合ゼータ(&mut gh[k]);",
      "    }",
      "    let mut hh = vec![vec![T::default(); m]; n + 1];",
      "    for i in 0..=n {",
      "        for j in 0..=(n - i) {",
      "            for s in 0..m {",
      "                hh[i + j][s] += fh[i][s] * gh[j][s];",
      "            }",
      "        }",
      "    }",
      "    for 層 in hh.iter_mut() {",
      "        部分集合メビウス(層);",
      "    }",
      "    let mut h = vec![T::default(); m];",
      "    for (s, hs) in h.iter_mut().enumerate() {",
      "        let k = (s as u32).count_ones() as usize;",
      "        *hs = hh[k][s];",
      "    }",
      "    h",
      "}"
    ]
