    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `n` の正の約数を昇順で全列挙する。O(√n)。",
      "/// 素因数分解（`primal::Sieve::factor` 等）ではなく「約数そのものの一覧」が欲しいとき用。",
      "/// 例: `12 → [1, 2, 3, 4, 6, 12]`。",
      "fn 約数列挙(n: usize) -> Vec<usize> {",
      "    let mut 小さい側 = Vec::new();",
      "    let mut 大きい側 = Vec::new();",
      "    let mut i = 1;",
      "    while i * i <= n {",
      "        if n % i == 0 {",
      "            小さい側.push(i);",
      "            if i != n / i {",
      "                大きい側.push(n / i);",
      "            }",
      "        }",
      "        i += 1;",
      "    }",
      "    大きい側.reverse();",
      "    小さい側.extend(大きい側);",
      "    小さい側",
      "}"
    ]
