  "傾き_トリック": {
    "scope": "rust",
    "prefix": "傾き_トリック",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::cmp::Reverse;",
      "use std::collections::BinaryHeap;",
      "/// スロープトリック。区分線形な凸関数 `f(x)` を、傾きが変化する点（折れ点）の多重集合として管理する。",
      "/// 各操作 `O(log N)`。DP の遷移が「`f += max(0, x-a)`」「`f += |x-a|`」",
      "/// 「累積 min（スライド最小値）」などで書けるとき計算量を落とせる。",
      "/// - [`Self::絶対値加算`] : `f(x) += |x - a|`。",
      "/// - [`Self::右側を平坦化`] / [`Self::左側を平坦化`] : 累積 min。",
      "/// - [`Self::最小値`] / [`Self::評価`] : 値の取得。",
      "struct スロープトリック {",
      "    最小値: i64,",
      "    左: BinaryHeap<i64>,",
      "    右: BinaryHeap<Reverse<i64>>,",
      "    加算左: i64,",
      "    加算右: i64,",
      "}",
      "impl スロープトリック {",
      "    /// 恒等的に 0 の関数 `f(x) = 0` を作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            最小値: 0,",
      "            左: BinaryHeap::new(),",
      "            右: BinaryHeap::new(),",
      "            加算左: 0,",
      "            加算右: 0,",
      "        }",
      "    }",
      "    fn 左頂点(&self) -> Option<i64> {",
      "        self.左.peek().map(|&v| v + self.加算左)",
      "    }",
      "    fn 右頂点(&self) -> Option<i64> {",
      "        self.右.peek().map(|&Reverse(v)| v + self.加算右)",
      "    }",
      "    fn 左へ(&mut self, a: i64) {",
      "        self.左.push(a - self.加算左);",
      "    }",
      "    fn 右へ(&mut self, a: i64) {",
      "        self.右.push(Reverse(a - self.加算右));",
      "    }",
      "    /// 現在の最小値 `min_x f(x)`。",
      "    fn 最小値(&self) -> i64 {",
      "        self.最小値",
      "    }",
      "    /// `f(x) += c`（定数加算）。引数は任意の整数型でよい（他のメソッドも同様）。",
      "    fn 定数加算(&mut self, c: impl TryInto<i64>) {",
      "        self.最小値 += to_i64(c);",
      "    }",
      "    /// `f(x) += max(0, x - a)`（右上がりの折れを追加）。",
      "    fn 右傾き加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        if let Some(l) = self.左頂点()",
      "            && l > a",
      "        {",
      "            self.最小値 += l - a;",
      "        }",
      "        self.左へ(a);",
      "        let v = self.左.pop().unwrap() + self.加算左;",
      "        self.右へ(v);",
      "    }",
      "    /// `f(x) += max(0, a - x)`（左上がりの折れを追加）。",
      "    fn 左傾き加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        if let Some(r) = self.右頂点()",
      "            && r < a",
      "        {",
      "            self.最小値 += a - r;",
      "        }",
      "        self.右へ(a);",
      "        let Reverse(v) = self.右.pop().unwrap();",
      "        let v = v + self.加算右;",
      "        self.左へ(v);",
      "    }",
      "    /// `f(x) += |x - a|`。",
      "    fn 絶対値加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        self.右傾き加算(a);",
      "        self.左傾き加算(a);",
      "    }",
      "    /// 累積 min: `f(x) := min_{y <= x} f(y)`（右側の上がりを消し、右へ平坦化）。",
      "    fn 右側を平坦化(&mut self) {",
      "        self.右.clear();",
      "    }",
      "    /// 累積 min: `f(x) := min_{y >= x} f(y)`（左側の上がりを消し、左へ平坦化）。",
      "    fn 左側を平坦化(&mut self) {",
      "        self.左.clear();",
      "    }",
      "    /// 平行移動: `f(x) := f(x - a)`（全折れ点を `a` ずらす）。",
      "    fn 平行移動(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        self.加算左 += a;",
      "        self.加算右 += a;",
      "    }",
      "    /// スライド最小値: `f(x) := min_{a <= d <= b} f(x - d)`（`a <= b`）。",
      "    fn 窓最小(&mut self, a: impl TryInto<i64>, b: impl TryInto<i64>) {",
      "        let (a, b) = (to_i64(a), to_i64(b));",
      "        assert!(a <= b);",
      "        self.加算左 += a;",
      "        self.加算右 += b;",
      "    }",
      "    /// `f(x)` の値を O(N) で評価する。",
      "    fn 評価(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        let mut v = self.最小値;",
      "        for &l in self.左.iter() {",
      "            let l = l + self.加算左;",
      "            if l > x {",
      "                v += l - x;",
      "            }",
      "        }",
      "        for &Reverse(r) in self.右.iter() {",
      "            let r = r + self.加算右;",
      "            if r < x {",
      "                v += x - r;",
      "            }",
      "        }",
      "        v",
      "    }",
      "}",
      "impl Default for スロープトリック {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "傾き_単調_DP_高速化": {
    "scope": "rust",
    "prefix": "傾き_単調_DP_高速化",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Convex Hull Trick（CHT, 最小クエリ版）。直線 `y = 傾き·x + 切片` を複数追加し、",
      "/// 与えた `x` での最小値を高速に求める。DP の `min_j (a_j·x + b_j)` 型の高速化に使う。",
      "/// 追加する直線の傾きは **単調非増加** の順で渡すこと（追加は償却 O(1)）。",
      "/// クエリ `x` は任意で、凸性を使った二分探索で O(log 本数)。",
      "/// 最大値が欲しいときは全ての `傾き`・`切片` の符号を反転して入れ、結果を反転する。",
      "/// 評価は i64 素のまま行うので `傾き·x + 切片` が i64 に収まる範囲で使うこと",
      "/// （直線の不要判定は i128 で行うため安全）。",
      "struct ConvexHullTrick {",
      "    直線: Vec<(i64, i64)>,",
      "}",
      "impl Default for ConvexHullTrick {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "impl ConvexHullTrick {",
      "    /// 空の直線集合を作る。",
      "    fn new() -> Self {",
      "        Self { 直線: Vec::new() }",
      "    }",
      "    fn 不要(l1: (i64, i64), l2: (i64, i64), l3: (i64, i64)) -> bool {",
      "        (l3.1 as i128 - l1.1 as i128) * (l1.0 as i128 - l2.0 as i128)",
      "            <= (l2.1 as i128 - l1.1 as i128) * (l1.0 as i128 - l3.0 as i128)",
      "    }",
      "    /// 直線 `y = 傾き·x + 切片` を追加する。傾きは単調非増加の順で渡すこと。",
      "    /// 引数は任意の整数型でよい（[`Self::最小値`] も同様）。",
      "    fn 直線追加(&mut self, 傾き: impl TryInto<i64>, 切片: impl TryInto<i64>) {",
      "        let l = (to_i64(傾き), to_i64(切片));",
      "        while self.直線.len() >= 2 {",
      "            let n = self.直線.len();",
      "            if Self::不要(self.直線[n - 2], self.直線[n - 1], l) {",
      "                self.直線.pop();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        self.直線.push(l);",
      "    }",
      "    fn 評価(l: (i64, i64), x: i64) -> i64 {",
      "        l.0 * x + l.1",
      "    }",
      "    /// `x` における全直線の最小値。直線が 1 本も無いときは呼ばないこと。",
      "    fn 最小値(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        debug_assert!(!self.直線.is_empty(), \"CHT: 直線が空です\");",
      "        let (mut lo, mut hi) = (0usize, self.直線.len() - 1);",
      "        while lo < hi {",
      "            let m = (lo + hi) / 2;",
      "            if Self::評価(self.直線[m], x) > Self::評価(self.直線[m + 1], x) {",
      "                lo = m + 1;",
      "            } else {",
      "                hi = m;",
      "            }",
      "        }",
      "        Self::評価(self.直線[lo], x)",
      "    }",
      "}"
    ]
  },
  "全域_最小_カット": {
    "scope": "rust",
    "prefix": "全域_最小_カット",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向重み付きグラフの**全域最小カット**（global minimum cut）を Stoer–Wagner 法で求める。",
      "/// 始点・終点を指定せず「頂点集合を空でない 2 つに分ける切断のうち、またぐ辺の重み和が最小のもの」を返す。",
      "/// `n` 頂点、`辺` は `(u, v, 重み)` の無向辺（重み非負、多重辺は加算、自己ループは無視）。計算量 `O(n^3)`。",
      "/// `ac_library` の `maxflow` は s–t 間の最小カット専用で、全ペアを試さずに大域最小カットを出すのはこちら。",
      "/// `n <= 1` のときは `0` を返す。",
      "fn 全域最小カット(n: usize, 辺: &[(usize, usize, i64)]) -> i64 {",
      "    if n <= 1 {",
      "        return 0;",
      "    }",
      "    let mut グラフ = vec![vec![0i64; n]; n];",
      "    for &(u, v, w) in 辺 {",
      "        if u != v {",
      "            グラフ[u][v] += w;",
      "            グラフ[v][u] += w;",
      "        }",
      "    }",
      "    let mut 最良 = i64::MAX;",
      "    let mut 頂点: Vec<usize> = (0..n).collect();",
      "    while 頂点.len() > 1 {",
      "        let m = 頂点.len();",
      "        let mut 接続重み = vec![0i64; n];",
      "        let mut 取込済 = vec![false; n];",
      "        let mut 順序 = Vec::with_capacity(m);",
      "        for _ in 0..m {",
      "            let mut 選 = !0;",
      "            for &v in &頂点 {",
      "                if !取込済[v] && (選 == !0 || 接続重み[v] > 接続重み[選]) {",
      "                    選 = v;",
      "                }",
      "            }",
      "            取込済[選] = true;",
      "            順序.push(選);",
      "            for &v in &頂点 {",
      "                if !取込済[v] {",
      "                    接続重み[v] += グラフ[選][v];",
      "                }",
      "            }",
      "        }",
      "        let t = 順序[m - 1];",
      "        let s = 順序[m - 2];",
      "        最良 = 最良.min(接続重み[t]);",
      "        for &v in &頂点 {",
      "            グラフ[s][v] += グラフ[t][v];",
      "            グラフ[v][s] += グラフ[v][t];",
      "        }",
      "        頂点.retain(|&x| x != t);",
      "    }",
      "    最良",
      "}"
    ]
  },
  "全域木_数え上げ": {
    "scope": "rust",
    "prefix": "全域木_数え上げ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `法` 上での正方行列の行列式を掃き出し（前進消去）で求める。O(n^3)。",
      "/// `法` は**素数**であること（フェルマーの小定理で逆元を取るため）。",
      "/// 行列はムーブで受け取り破壊的に消去する。`法 < 2^31` 程度を想定。",
      "fn 行列式_mod(mut 行列: Vec<Vec<u64>>, 法: u64) -> u64 {",
      "    let n = 行列.len();",
      "    for row in &mut 行列 {",
      "        for x in row.iter_mut() {",
      "            *x %= 法;",
      "        }",
      "    }",
      "    let mut 結果 = 1u64 % 法;",
      "    for 列 in 0..n {",
      "        let ピボット = (列..n).find(|&r| 行列[r][列] != 0);",
      "        let Some(p) = ピボット else {",
      "            return 0;",
      "        };",
      "        if p != 列 {",
      "            行列.swap(p, 列);",
      "            結果 = (法 - 結果) % 法;",
      "        }",
      "        let 逆 = 累乗_mod(行列[列][列], 法 - 2, 法);",
      "        結果 = 結果 * 行列[列][列] % 法;",
      "        for r in 列 + 1..n {",
      "            let 係数 = 行列[r][列] * 逆 % 法;",
      "            if 係数 != 0 {",
      "                for c in 列..n {",
      "                    行列[r][c] = (行列[r][c] + 法 - 係数 * 行列[列][c] % 法) % 法;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    結果",
      "}",
      "/// 行列木定理（キルヒホッフの定理）で、無向グラフの全域木の個数を `法`（素数）で求める。O(V^3)。",
      "/// `辺` は無向辺 `(u, v)`（`0..頂点数`、多重辺可・自己ループは無視推奨）。ラプラシアン行列",
      "/// から 1 行 1 列を除いた小行列の行列式が全域木数に等しい。連結でなければ 0。",
      "/// 頂点 1 個のときは（辺のない木が 1 通りとして）1 を返す。",
      "fn 全域木数_mod(頂点数: usize, 辺: &[(usize, usize)], 法: u64) -> u64 {",
      "    if 頂点数 <= 1 {",
      "        return 1 % 法;",
      "    }",
      "    let n = 頂点数;",
      "    let mut l = vec![vec![0u64; n]; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            continue;",
      "        }",
      "        l[u][u] += 1;",
      "        l[v][v] += 1;",
      "        l[u][v] = (l[u][v] + 法 - 1) % 法;",
      "        l[v][u] = (l[v][u] + 法 - 1) % 法;",
      "    }",
      "    for (i, row) in l.iter_mut().enumerate() {",
      "        row[i] %= 法;",
      "    }",
      "    let 小行列: Vec<Vec<u64>> = (0..n - 1).map(|i| l[i][0..n - 1].to_vec()).collect();",
      "    行列式_mod(小行列, 法)",
      "}"
    ]
  },
  "全方位_木_DP": {
    "scope": "rust",
    "prefix": "全方位_木_DP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 全方位木DP（再帰なし版）の代表例。各頂点 `v` について",
      "/// 「`v` から木の全頂点への距離（辺数）の総和」を一括で O(N) 計算する。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対、重みなし無向木）。",
      "/// 戻り値 `ans[v]` が頂点 `v` の距離総和。",
      "fn 全頂点への距離総和(n: usize, 辺: &[(usize, usize)]) -> Vec<i64> {",
      "    if n == 0 {",
      "        return vec![];",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut prev = vec![!0; n];",
      "    let mut 順 = Vec::with_capacity(n);",
      "    let mut 到達済 = vec![false; n];",
      "    let mut 探索 = vec![0usize];",
      "    到達済[0] = true;",
      "    while let Some(now) = 探索.pop() {",
      "        順.push(now);",
      "        for &next in &グラフ[now] {",
      "            if !到達済[next] {",
      "                到達済[next] = true;",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let mut sz = vec![1i64; n];",
      "    let mut 部分木距離和 = vec![0i64; n];",
      "    for &now in 順.iter().rev() {",
      "        let p = prev[now];",
      "        if p != !0 {",
      "            sz[p] += sz[now];",
      "            部分木距離和[p] += 部分木距離和[now] + sz[now];",
      "        }",
      "    }",
      "    let mut ans = vec![0i64; n];",
      "    ans[0] = 部分木距離和[0];",
      "    for &now in &順 {",
      "        for &next in &グラフ[now] {",
      "            if prev[next] == now {",
      "                ans[next] = ans[now] + (n as i64 - sz[next]) - sz[next];",
      "            }",
      "        }",
      "    }",
      "    ans",
      "}"
    ]
  },
  "全方位_木_DP_汎用": {
    "scope": "rust",
    "prefix": "全方位_木_DP_汎用",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 全方位木DP（rerooting）を任意の可換モノイドで行うための演算インタフェース。",
      "/// 部分木の集約値の型 [`値`](Self::値) に対し、子方向の結果をまとめる可換モノイド",
      "/// （[`単位元`](Self::単位元)・[`併合`](Self::併合)）、子部分木の値を辺で親側へ持ち上げる",
      "/// [`辺寄与`](Self::辺寄与)、子方向寄与の併合に頂点自身を載せる [`頂点載せ`](Self::頂点載せ)",
      "/// を与える。[`全方位木dp実行`] がこれらを使い、全頂点を根にした答えを `O(N)` でまとめて返す。",
      "/// [`rerooting_distance`](crate::rerooting_distance) は「距離総和」専用の固定実装で、本トレイトは",
      "/// 任意の集約（個数・最大深さ・木 DP など）を載せられる汎用版。",
      "trait 全方位木DP {",
      "    /// 部分木の集約値。",
      "    type 値: Clone;",
      "    /// [`併合`](Self::併合) の単位元。",
      "    fn 単位元(&self) -> Self::値;",
      "    /// 子方向の結果同士をまとめる可換モノイド演算。",
      "    fn 併合(&self, a: &Self::値, b: &Self::値) -> Self::値;",
      "    /// 子頂点 `子` を根とする部分木の集約 `下` を、辺 `(親, 子)` を通して親 `親` 側の寄与に変換する。",
      "    fn 辺寄与(&self, 下: &Self::値, 親: usize, 子: usize) -> Self::値;",
      "    /// 頂点 `v` の子方向寄与の併合結果 `集約` に、頂点 `v` 自身を載せて部分木値にする。",
      "    fn 頂点載せ(&self, 集約: &Self::値, v: usize) -> Self::値;",
      "}",
      "/// 頂点数 `n`・辺リスト `辺` の木について、各頂点 `v` を根としたときの部分木集約値を `O(N)` で求める。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対）を渡せばよい。",
      "fn 全方位木dp実行<S: 全方位木DP>(",
      "    n: usize,",
      "    辺: &[(usize, usize)],",
      "    状態: &S,",
      ") -> Vec<S::値> {",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut prev = vec![!0; n];",
      "    let mut 順 = Vec::with_capacity(n);",
      "    let mut 到達済 = vec![false; n];",
      "    let mut 探索 = vec![0usize];",
      "    到達済[0] = true;",
      "    while let Some(now) = 探索.pop() {",
      "        順.push(now);",
      "        for &next in &グラフ[now] {",
      "            if !到達済[next] {",
      "                到達済[next] = true;",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let mut down: Vec<S::値> = (0..n).map(|_| 状態.単位元()).collect();",
      "    for &now in 順.iter().rev() {",
      "        let mut acc = 状態.単位元();",
      "        for &next in &グラフ[now] {",
      "            if next != prev[now] {",
      "                acc = 状態.併合(&acc, &状態.辺寄与(&down[next], now, next));",
      "            }",
      "        }",
      "        down[now] = 状態.頂点載せ(&acc, now);",
      "    }",
      "    let mut 親寄与: Vec<S::値> = (0..n).map(|_| 状態.単位元()).collect();",
      "    let mut 答え: Vec<S::値> = (0..n).map(|_| 状態.単位元()).collect();",
      "    for &now in &順 {",
      "        let deg = グラフ[now].len();",
      "        let mut 寄与列: Vec<S::値> = Vec::with_capacity(deg);",
      "        for &next in &グラフ[now] {",
      "            if next == prev[now] {",
      "                寄与列.push(親寄与[now].clone());",
      "            } else {",
      "                寄与列.push(状態.辺寄与(&down[next], now, next));",
      "            }",
      "        }",
      "        let mut pre = vec![状態.単位元(); deg + 1];",
      "        for k in 0..deg {",
      "            pre[k + 1] = 状態.併合(&pre[k], &寄与列[k]);",
      "        }",
      "        let mut suf = vec![状態.単位元(); deg + 1];",
      "        for k in (0..deg).rev() {",
      "            suf[k] = 状態.併合(&寄与列[k], &suf[k + 1]);",
      "        }",
      "        答え[now] = 状態.頂点載せ(&pre[deg], now);",
      "        for (k, &next) in グラフ[now].iter().enumerate() {",
      "            if next != prev[now] {",
      "                let m = 状態.併合(&pre[k], &suf[k + 1]);",
      "                let 親側 = 状態.頂点載せ(&m, now);",
      "                親寄与[next] = 状態.辺寄与(&親側, next, now);",
      "            }",
      "        }",
      "    }",
      "    答え",
      "}"
    ]
  },
  "全点対_最小_カット": {
    "scope": "rust",
    "prefix": "全点対_最小_カット",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::MfGraph;",
      "/// 全点対最小カット木（Gomory–Hu 木）。無向重み付きグラフの「任意の 2 頂点間の最小カット」を、",
      "/// `n-1` 本の辺からなる 1 本の木で表す。木上の `u`–`v` パスの最小辺重みが `u`–`v` の最小カットに等しい。",
      "/// `prev[i]`（`i >= 1`）はその親、`重み[i]` は辺 `(i, prev[i])` の容量（＝そのカット値）。",
      "struct 全点対最小カット木 {",
      "    /// `prev[i]` は木における頂点 `i` の親（`prev[0] = 0`）。",
      "    prev: Vec<usize>,",
      "    /// `重み[i]` は辺 `(i, prev[i])` の最小カット値（`重み[0] = 0`）。",
      "    重み: Vec<i64>,",
      "    グラフ: Vec<Vec<(usize, i64)>>,",
      "}",
      "impl 全点対最小カット木 {",
      "    /// 木上のパスの最小辺重み = 頂点 `u`, `v` 間の最小カット値を `O(n)` で返す。",
      "    fn 最小カット(&self, u: usize, v: usize) -> i64 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        let n = self.グラフ.len();",
      "        let mut 最小 = vec![i64::MAX; n];",
      "        let mut 到達済 = vec![false; n];",
      "        到達済[u] = true;",
      "        let mut 探索 = vec![u];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, w) in &self.グラフ[now] {",
      "                if !到達済[next] {",
      "                    到達済[next] = true;",
      "                    最小[next] = 最小[now].min(w);",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        最小[v]",
      "    }",
      "}",
      "/// Gusfield の簡易アルゴリズムで Gomory–Hu 木（等価フロー木）を構築する。`ac_library::MfGraph` を",
      "/// `n-1` 回呼ぶ。`辺` は `(u, v, 容量)` の無向辺（容量非負、多重辺は別々に追加、自己ループは無視）。",
      "/// 計算量は最大流 `n-1` 回ぶん。非連結なグラフでは成分間のカットは `0` になる。",
      "fn 全点対最小カット木構築(",
      "    n: usize,",
      "    辺: &[(usize, usize, i64)],",
      ") -> 全点対最小カット木 {",
      "    let mut prev = vec![0usize; n];",
      "    let mut 重み = vec![0i64; n];",
      "    for i in 1..n {",
      "        let t = prev[i];",
      "        let mut g = MfGraph::<i64>::new(n);",
      "        for &(u, v, w) in 辺 {",
      "            if u != v {",
      "                g.add_edge(u, v, w);",
      "                g.add_edge(v, u, w);",
      "            }",
      "        }",
      "        let f = g.flow(i, t);",
      "        重み[i] = f;",
      "        let 側 = g.min_cut(i);",
      "        for j in (i + 1)..n {",
      "            if 側[j] && prev[j] == t {",
      "                prev[j] = i;",
      "            }",
      "        }",
      "    }",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for i in 1..n {",
      "        グラフ[i].push((prev[i], 重み[i]));",
      "        グラフ[prev[i]].push((i, 重み[i]));",
      "    }",
      "    全点対最小カット木 {",
      "        prev, 重み, グラフ",
      "    }",
      "}"
    ]
  },
  "全頂点への_距離_総和": {
    "scope": "rust",
    "prefix": "全頂点への_距離_総和",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 全方位木DP（再帰なし版）の代表例。各頂点 `v` について",
      "/// 「`v` から木の全頂点への距離（辺数）の総和」を一括で O(N) 計算する。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対、重みなし無向木）。",
      "/// 戻り値 `ans[v]` が頂点 `v` の距離総和。",
      "fn 全頂点への距離総和(n: usize, 辺: &[(usize, usize)]) -> Vec<i64> {",
      "    if n == 0 {",
      "        return vec![];",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut prev = vec![!0; n];",
      "    let mut 順 = Vec::with_capacity(n);",
      "    let mut 到達済 = vec![false; n];",
      "    let mut 探索 = vec![0usize];",
      "    到達済[0] = true;",
      "    while let Some(now) = 探索.pop() {",
      "        順.push(now);",
      "        for &next in &グラフ[now] {",
      "            if !到達済[next] {",
      "                到達済[next] = true;",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let mut sz = vec![1i64; n];",
      "    let mut 部分木距離和 = vec![0i64; n];",
      "    for &now in 順.iter().rev() {",
      "        let p = prev[now];",
      "        if p != !0 {",
      "            sz[p] += sz[now];",
      "            部分木距離和[p] += 部分木距離和[now] + sz[now];",
      "        }",
      "    }",
      "    let mut ans = vec![0i64; n];",
      "    ans[0] = 部分木距離和[0];",
      "    for &now in &順 {",
      "        for &next in &グラフ[now] {",
      "            if prev[next] == now {",
      "                ans[next] = ans[now] + (n as i64 - sz[next]) - sz[next];",
      "            }",
      "        }",
      "    }",
      "    ans",
      "}"
    ]
  },
  "共通_接線_本数": {
    "scope": "rust",
    "prefix": "共通_接線_本数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円の共通接線の本数を返す。同心で半径が等しい場合のみ無数（`!0`）。`O(1)`。",
      "/// 中心間距離 `d` と半径から分類する：`d>r1+r2`→4、`=r1+r2`→3、`|r1-r2|<d<r1+r2`→2、",
      "/// `d=|r1-r2|`→1、`d<|r1-r2|`→0（一方が他方の内部）。半径 0（点）も同じ枠組みで扱える。",
      "fn 共通接線本数(c1: 点, r1: f64, c2: 点, r2: f64) -> usize {",
      "    const EPS: f64 = 1e-9;",
      "    let d = (c1.0 - c2.0).hypot(c1.1 - c2.1);",
      "    let 和 = r1 + r2;",
      "    let 差 = (r1 - r2).abs();",
      "    if d < EPS && 差 < EPS {",
      "        return !0;",
      "    }",
      "    if d > 和 + EPS {",
      "        4",
      "    } else if (d - 和).abs() <= EPS {",
      "        3",
      "    } else if d > 差 + EPS {",
      "        2",
      "    } else if (d - 差).abs() <= EPS {",
      "        1",
      "    } else {",
      "        0",
      "    }",
      "}"
    ]
  },
  "共通_部分列": {
    "scope": "rust",
    "prefix": "共通_部分列",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2つの列の最長共通部分列(LCS)の長さを返す。O(N*M)。",
      "/// 文字列なら `s.chars().collect::<Vec<_>>()` や `s.as_bytes()` を渡す。",
      "/// 連続している必要はなく、順序を保って共通に取れる最長の部分列の長さ。",
      "fn 最長共通部分列<T: PartialEq>(a: &[T], b: &[T]) -> usize {",
      "    let n = a.len();",
      "    let m = b.len();",
      "    let mut dp = vec![vec![0usize; m + 1]; n + 1];",
      "    for i in 0..n {",
      "        for (j, b要素) in b.iter().enumerate() {",
      "            dp[i + 1][j + 1] = if a[i] == *b要素 {",
      "                dp[i][j] + 1",
      "            } else {",
      "                dp[i][j + 1].max(dp[i + 1][j])",
      "            };",
      "        }",
      "    }",
      "    dp[n][m]",
      "}"
    ]
  },
  "内向き_全域木": {
    "scope": "rust",
    "prefix": "内向き_全域木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `法` 上での正方行列の行列式を掃き出し（前進消去）で求める。O(n^3)。",
      "/// `法` は**素数**であること（フェルマーの小定理で逆元を取るため）。",
      "/// 行列はムーブで受け取り破壊的に消去する。`法 < 2^31` 程度を想定。",
      "fn 行列式_mod(mut 行列: Vec<Vec<u64>>, 法: u64) -> u64 {",
      "    let n = 行列.len();",
      "    for row in &mut 行列 {",
      "        for x in row.iter_mut() {",
      "            *x %= 法;",
      "        }",
      "    }",
      "    let mut 結果 = 1u64 % 法;",
      "    for 列 in 0..n {",
      "        let ピボット = (列..n).find(|&r| 行列[r][列] != 0);",
      "        let Some(p) = ピボット else {",
      "            return 0;",
      "        };",
      "        if p != 列 {",
      "            行列.swap(p, 列);",
      "            結果 = (法 - 結果) % 法;",
      "        }",
      "        let 逆 = 累乗_mod(行列[列][列], 法 - 2, 法);",
      "        結果 = 結果 * 行列[列][列] % 法;",
      "        for r in 列 + 1..n {",
      "            let 係数 = 行列[r][列] * 逆 % 法;",
      "            if 係数 != 0 {",
      "                for c in 列..n {",
      "                    行列[r][c] = (行列[r][c] + 法 - 係数 * 行列[列][c] % 法) % 法;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    結果",
      "}",
      "/// 有向版の行列木定理（Tutte の定理）。有向グラフで、根 `根` から**葉に向かって**辺が伸びる",
      "/// 全域有向木（arborescence。根以外の各頂点の入次数がちょうど 1）の個数を `法`（素数）で数える。",
      "/// O(V^3)。",
      "/// `辺` は有向辺 `(u, v)`（`u → v`、`0..頂点数`、多重辺可・自己ループは無視）。",
      "/// 無向版 [`全域木数_mod`] と違って辺の向きを区別する。",
      "/// 「根に向かう（in-arborescence）」全域木を数えたいときは全辺を逆向きにして渡す。",
      "fn 有向全域木数_mod(頂点数: usize, 辺: &[(usize, usize)], 根: usize, 法: u64) -> u64 {",
      "    if 頂点数 == 0 {",
      "        return 0;",
      "    }",
      "    if 頂点数 == 1 {",
      "        return 1 % 法;",
      "    }",
      "    let n = 頂点数;",
      "    let mut l = vec![vec![0u64; n]; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            continue;",
      "        }",
      "        l[v][v] = (l[v][v] + 1) % 法;",
      "        l[u][v] = (l[u][v] + 法 - 1) % 法;",
      "    }",
      "    let 残: Vec<usize> = (0..n).filter(|&i| i != 根).collect();",
      "    let 小行列: Vec<Vec<u64>> = 残",
      "        .iter()",
      "        .map(|&i| 残.iter().map(|&j| l[i][j]).collect())",
      "        .collect();",
      "    行列式_mod(小行列, 法)",
      "}"
    ]
  },
  "内外_判定": {
    "scope": "rust",
    "prefix": "内外_判定",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 点が多角形の内部・境界・外部のどれにあるかを整数演算のみで判定する。O(N)。",
      "/// `2` = 内部、`1` = 境界上、`0` = 外部。凸でない単純多角形にも使える（射影法／レイキャスティング）。",
      "fn 点の内外(多角形: &[(i64, i64)], 点: (i64, i64)) -> i32 {",
      "    let n = 多角形.len();",
      "    let (px, py) = 点;",
      "    let mut 内 = false;",
      "    for i in 0..n {",
      "        let (xi, yi) = 多角形[i];",
      "        let (xj, yj) = 多角形[(i + 1) % n];",
      "        let 外積 = (xj - xi) * (py - yi) - (yj - yi) * (px - xi);",
      "        if 外積 == 0 && (px - xi) * (px - xj) <= 0 && (py - yi) * (py - yj) <= 0 {",
      "            return 1;",
      "        }",
      "        if (yi > py) != (yj > py) {",
      "            let 左 = if yj - yi > 0 { 外積 > 0 } else { 外積 < 0 };",
      "            if 左 {",
      "                内 = !内;",
      "            }",
      "        }",
      "    }",
      "    if 内 {",
      "        2",
      "    } else {",
      "        0",
      "    }",
      "}"
    ]
  },
  "内心": {
    "scope": "rust",
    "prefix": "内心",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 三角形 `a, b, c` の内接円 `(中心, 半径)` を返す。退化（周長 0）なら `None`。`O(1)`。",
      "fn 内接円(a: 点, b: 点, c: 点) -> Option<(点, f64)> {",
      "    let la = (b.0 - c.0).hypot(b.1 - c.1);",
      "    let lb = (c.0 - a.0).hypot(c.1 - a.1);",
      "    let lc = (a.0 - b.0).hypot(a.1 - b.1);",
      "    let 周 = la + lb + lc;",
      "    if 周 < 1e-12 {",
      "        return None;",
      "    }",
      "    let cx = (la * a.0 + lb * b.0 + lc * c.0) / 周;",
      "    let cy = (la * a.1 + lb * b.1 + lc * c.1) / 周;",
      "    let 面積 = ((b.0 - a.0) * (c.1 - a.1) - (b.1 - a.1) * (c.0 - a.0)).abs() / 2.0;",
      "    let r = 2.0 * 面積 / 周;",
      "    Some(((cx, cy), r))",
      "}"
    ]
  },
  "内接円": {
    "scope": "rust",
    "prefix": "内接円",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 三角形 `a, b, c` の内接円 `(中心, 半径)` を返す。退化（周長 0）なら `None`。`O(1)`。",
      "fn 内接円(a: 点, b: 点, c: 点) -> Option<(点, f64)> {",
      "    let la = (b.0 - c.0).hypot(b.1 - c.1);",
      "    let lb = (c.0 - a.0).hypot(c.1 - a.1);",
      "    let lc = (a.0 - b.0).hypot(a.1 - b.1);",
      "    let 周 = la + lb + lc;",
      "    if 周 < 1e-12 {",
      "        return None;",
      "    }",
      "    let cx = (la * a.0 + lb * b.0 + lc * c.0) / 周;",
      "    let cy = (la * a.1 + lb * b.1 + lc * c.1) / 周;",
      "    let 面積 = ((b.0 - a.0) * (c.1 - a.1) - (b.1 - a.1) * (c.0 - a.0)).abs() / 2.0;",
      "    let r = 2.0 * 面積 / 周;",
      "    Some(((cx, cy), r))",
      "}"
    ]
  },
  "円_多角形_面積": {
    "scope": "rust",
    "prefix": "円_多角形_面積",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 円（中心 `中心`・半径 `r`）と単純多角形（頂点を順に並べた列）が重なる部分の面積を返す。O(N)。",
      "/// 頂点列の向きは問わず、凸でなくてもよい。",
      "fn 円と多角形の交差面積(中心: 点, r: f64, 多角形: &[点]) -> f64 {",
      "    let n = 多角形.len();",
      "    if n < 3 || r <= 0.0 {",
      "        return 0.0;",
      "    }",
      "    let 内積 = |p: 点, q: 点| p.0 * q.0 + p.1 * q.1;",
      "    let 外積 = |p: 点, q: 点| p.0 * q.1 - p.1 * q.0;",
      "    let 偏角 = |p: 点, q: 点| 外積(p, q).atan2(内積(p, q));",
      "    let r2 = r * r / 2.0;",
      "    let 三角 = |p: 点, q: 点| -> f64 {",
      "        let d = (q.0 - p.0, q.1 - p.1);",
      "        let d2 = 内積(d, d);",
      "        if d2 < 1e-18 {",
      "            return 0.0;",
      "        }",
      "        let a = 内積(d, p) / d2;",
      "        let b = (内積(p, p) - r * r) / d2;",
      "        let det = a * a - b;",
      "        if det <= 0.0 {",
      "            return 偏角(p, q) * r2;",
      "        }",
      "        let sq = det.sqrt();",
      "        let s = (-a - sq).max(0.0);",
      "        let t = (-a + sq).min(1.0);",
      "        if t < 0.0 || 1.0 <= s {",
      "            return 偏角(p, q) * r2;",
      "        }",
      "        let u = (p.0 + d.0 * s, p.1 + d.1 * s);",
      "        let v = (p.0 + d.0 * t, p.1 + d.1 * t);",
      "        偏角(p, u) * r2 + 外積(u, v) / 2.0 + 偏角(v, q) * r2",
      "    };",
      "    let mut 和 = 0.0f64;",
      "    for i in 0..n {",
      "        let p = (多角形[i].0 - 中心.0, 多角形[i].1 - 中心.1);",
      "        let q = (",
      "            多角形[(i + 1) % n].0 - 中心.0,",
      "            多角形[(i + 1) % n].1 - 中心.1,",
      "        );",
      "        和 += 三角(p, q);",
      "    }",
      "    和.abs()",
      "}"
    ]
  },
  "円と_円の_交点": {
    "scope": "rust",
    "prefix": "円と_円の_交点",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円（中心 `c1` 半径 `r1`、中心 `c2` 半径 `r2`）の交点を返す。`0`/`1`（接する）/`2` 個。",
      "/// 中心間距離 `d` が `r1+r2` より大きい・`|r1-r2|` より小さい・同心（`d≈0`）のときは交わらない。",
      "/// [`segment_intersection`](crate::segment_intersection) は直線・線分用で円は扱えない。",
      "fn 円と円の交点(c1: 点, r1: f64, c2: 点, r2: f64) -> Vec<点> {",
      "    const EPS: f64 = 1e-9;",
      "    let dx = c2.0 - c1.0;",
      "    let dy = c2.1 - c1.1;",
      "    let d2 = dx * dx + dy * dy;",
      "    let d = d2.sqrt();",
      "    if d < EPS {",
      "        return Vec::new();",
      "    }",
      "    if d > r1 + r2 + EPS || d < (r1 - r2).abs() - EPS {",
      "        return Vec::new();",
      "    }",
      "    let a = (r1 * r1 - r2 * r2 + d2) / (2.0 * d);",
      "    let h2 = r1 * r1 - a * a;",
      "    let h = if h2 < 0.0 { 0.0 } else { h2.sqrt() };",
      "    let px = c1.0 + a * dx / d;",
      "    let py = c1.1 + a * dy / d;",
      "    if h < EPS {",
      "        return vec![(px, py)];",
      "    }",
      "    let ox = -dy / d * h;",
      "    let oy = dx / d * h;",
      "    vec![(px + ox, py + oy), (px - ox, py - oy)]",
      "}"
    ]
  },
  "円と_多角形の_交差_面積": {
    "scope": "rust",
    "prefix": "円と_多角形の_交差_面積",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 円（中心 `中心`・半径 `r`）と単純多角形（頂点を順に並べた列）が重なる部分の面積を返す。O(N)。",
      "/// 頂点列の向きは問わず、凸でなくてもよい。",
      "fn 円と多角形の交差面積(中心: 点, r: f64, 多角形: &[点]) -> f64 {",
      "    let n = 多角形.len();",
      "    if n < 3 || r <= 0.0 {",
      "        return 0.0;",
      "    }",
      "    let 内積 = |p: 点, q: 点| p.0 * q.0 + p.1 * q.1;",
      "    let 外積 = |p: 点, q: 点| p.0 * q.1 - p.1 * q.0;",
      "    let 偏角 = |p: 点, q: 点| 外積(p, q).atan2(内積(p, q));",
      "    let r2 = r * r / 2.0;",
      "    let 三角 = |p: 点, q: 点| -> f64 {",
      "        let d = (q.0 - p.0, q.1 - p.1);",
      "        let d2 = 内積(d, d);",
      "        if d2 < 1e-18 {",
      "            return 0.0;",
      "        }",
      "        let a = 内積(d, p) / d2;",
      "        let b = (内積(p, p) - r * r) / d2;",
      "        let det = a * a - b;",
      "        if det <= 0.0 {",
      "            return 偏角(p, q) * r2;",
      "        }",
      "        let sq = det.sqrt();",
      "        let s = (-a - sq).max(0.0);",
      "        let t = (-a + sq).min(1.0);",
      "        if t < 0.0 || 1.0 <= s {",
      "            return 偏角(p, q) * r2;",
      "        }",
      "        let u = (p.0 + d.0 * s, p.1 + d.1 * s);",
      "        let v = (p.0 + d.0 * t, p.1 + d.1 * t);",
      "        偏角(p, u) * r2 + 外積(u, v) / 2.0 + 偏角(v, q) * r2",
      "    };",
      "    let mut 和 = 0.0f64;",
      "    for i in 0..n {",
      "        let p = (多角形[i].0 - 中心.0, 多角形[i].1 - 中心.1);",
      "        let q = (",
      "            多角形[(i + 1) % n].0 - 中心.0,",
      "            多角形[(i + 1) % n].1 - 中心.1,",
      "        );",
      "        和 += 三角(p, q);",
      "    }",
      "    和.abs()",
      "}"
    ]
  },
  "円と_直線の_交点": {
    "scope": "rust",
    "prefix": "円と_直線の_交点",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円（中心 `c1` 半径 `r1`、中心 `c2` 半径 `r2`）の交点を返す。`0`/`1`（接する）/`2` 個。",
      "/// 中心間距離 `d` が `r1+r2` より大きい・`|r1-r2|` より小さい・同心（`d≈0`）のときは交わらない。",
      "/// [`segment_intersection`](crate::segment_intersection) は直線・線分用で円は扱えない。",
      "fn 円と円の交点(c1: 点, r1: f64, c2: 点, r2: f64) -> Vec<点> {",
      "    const EPS: f64 = 1e-9;",
      "    let dx = c2.0 - c1.0;",
      "    let dy = c2.1 - c1.1;",
      "    let d2 = dx * dx + dy * dy;",
      "    let d = d2.sqrt();",
      "    if d < EPS {",
      "        return Vec::new();",
      "    }",
      "    if d > r1 + r2 + EPS || d < (r1 - r2).abs() - EPS {",
      "        return Vec::new();",
      "    }",
      "    let a = (r1 * r1 - r2 * r2 + d2) / (2.0 * d);",
      "    let h2 = r1 * r1 - a * a;",
      "    let h = if h2 < 0.0 { 0.0 } else { h2.sqrt() };",
      "    let px = c1.0 + a * dx / d;",
      "    let py = c1.1 + a * dy / d;",
      "    if h < EPS {",
      "        return vec![(px, py)];",
      "    }",
      "    let ox = -dy / d * h;",
      "    let oy = dx / d * h;",
      "    vec![(px + ox, py + oy), (px - ox, py - oy)]",
      "}",
      "/// 円（中心 `c` 半径 `r`）と直線（`a`, `b` を通る）の交点を返す。`0`/`1`（接する）/`2` 個。",
      "fn 円と直線の交点(c: 点, r: f64, a: 点, b: 点) -> Vec<点> {",
      "    const EPS: f64 = 1e-9;",
      "    let dx = b.0 - a.0;",
      "    let dy = b.1 - a.1;",
      "    let 長2 = dx * dx + dy * dy;",
      "    if 長2 < EPS {",
      "        return Vec::new();",
      "    }",
      "    let t = ((c.0 - a.0) * dx + (c.1 - a.1) * dy) / 長2;",
      "    let fx = a.0 + t * dx;",
      "    let fy = a.1 + t * dy;",
      "    let dist2 = (c.0 - fx) * (c.0 - fx) + (c.1 - fy) * (c.1 - fy);",
      "    if dist2 > r * r + EPS {",
      "        return Vec::new();",
      "    }",
      "    let k2 = r * r - dist2;",
      "    let k = if k2 < 0.0 { 0.0 } else { k2.sqrt() };",
      "    let 長 = 長2.sqrt();",
      "    if k < EPS {",
      "        return vec![(fx, fy)];",
      "    }",
      "    let ux = dx / 長 * k;",
      "    let uy = dy / 長 * k;",
      "    vec![(fx + ux, fy + uy), (fx - ux, fy - uy)]",
      "}"
    ]
  },
