  "ビット_DP": {
    "scope": "rust",
    "prefix": "ビット_DP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巡回セールスマン問題（TSP）をビット DP で解く。O(2^N · N^2)。N は 18 程度まで。",
      "/// `距離[i][j]` は i→j のコスト（有向。到達不可は十分大きい値を入れる）。",
      "/// 頂点 0 を始点に全頂点をちょうど 1 回ずつ訪れて 0 に戻る最小コストを返す。",
      "/// 巡回が作れない場合は `None`。",
      "/// 「戻らない最短ハミルトンパス」が欲しい場合は最後の `+ 距離[v][0]` を外し、",
      "/// `dp[全集合][v]` の最小をそのまま使う。",
      "#[allow(clippy::needless_range_loop)]",
      "fn 巡回セールスマン(距離: &[Vec<i64>]) -> Option<i64> {",
      "    let n = 距離.len();",
      "    if n == 0 {",
      "        return Some(0);",
      "    }",
      "    const INF: i64 = i64::MAX / 4;",
      "    let mut dp = vec![vec![INF; n]; 1 << n];",
      "    dp[1][0] = 0;",
      "    for s in 1..(1usize << n) {",
      "        for v in 0..n {",
      "            if dp[s][v] >= INF || s & (1 << v) == 0 {",
      "                continue;",
      "            }",
      "            for u in 0..n {",
      "                if s & (1 << u) != 0 {",
      "                    continue;",
      "                }",
      "                let 次 = s | (1 << u);",
      "                let コスト = dp[s][v] + 距離[v][u];",
      "                if コスト < dp[次][u] {",
      "                    dp[次][u] = コスト;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 全集合 = (1usize << n) - 1;",
      "    let 答え = (0..n)",
      "        .filter(|&v| dp[全集合][v] < INF)",
      "        .map(|v| dp[全集合][v] + 距離[v][0])",
      "        .min()",
      "        .unwrap_or(INF);",
      "    if 答え >= INF {",
      "        None",
      "    } else {",
      "        Some(答え)",
      "    }",
      "}"
    ]
  },
  "ビット_トライ": {
    "scope": "rust",
    "prefix": "ビット_トライ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// 二進トライ（binary trie）。非負整数の多重集合を二進表現の木で管理し、挿入・削除・",
      "/// 「指定値 `x` との XOR の最大／最小」「k 番目に小さい値」「`x` 以下の個数」などを各 `O(ビット数)` で行う。",
      "/// `xor_basis`（線形基底）は「部分集合の XOR で作れる最大値」を扱うのに対し、こちらは",
      "/// **格納済み要素そのもの**との XOR 最適化や順位クエリを行う別物。",
      "/// `挿入` した値の上位 `ビット数` ビットのみを見るので、扱う値域に合わせて `ビット数` を決める。",
      "/// XOR を使わず k 番目・順位だけが目的なら [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合)",
      "/// を使う（負の値や整数以外も載り、メモリも軽く速い）。",
      "struct 二進トライ {",
      "    ビット数: usize,",
      "    子: Vec<[Option<usize>; 2]>,",
      "    通過数: Vec<usize>,",
      "}",
      "impl 二進トライ {",
      "    /// `ビット数` ビット幅（`0..2^ビット数` の値）の空トライを作る。",
      "    fn new(ビット数: usize) -> Self {",
      "        Self {",
      "            ビット数,",
      "            子: vec![[None, None]],",
      "            通過数: vec![0],",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個追加する。",
      "    fn 挿入(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] += 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = match self.子[v][ビット] {",
      "                Some(次) => 次,",
      "                None => {",
      "                    let 新 = self.子.len();",
      "                    self.子.push([None, None]);",
      "                    self.通過数.push(0);",
      "                    self.子[v][ビット] = Some(新);",
      "                    新",
      "                }",
      "            };",
      "            self.通過数[v] += 1;",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個削除する（存在する前提）。木構造は保持し、通過数のみ減らす。",
      "    fn 削除(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] -= 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = self.子[v][ビット].unwrap();",
      "            self.通過数[v] -= 1;",
      "        }",
      "    }",
      "    /// 格納されている要素の総数。",
      "    fn 個数(&self) -> usize {",
      "        self.通過数[0]",
      "    }",
      "    /// 値 `x` が格納されている個数。",
      "    fn 含む個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 0,",
      "            }",
      "        }",
      "        self.通過数[v]",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最大化する `x ^ y` を返す（空でないこと）。",
      "    fn 最大xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            let 望み = ビット ^ 1;",
      "            match self.子[v][望み] {",
      "                Some(c) if self.通過数[c] > 0 => {",
      "                    結果 |= 1 << b;",
      "                    v = c;",
      "                }",
      "                _ => v = self.子[v][ビット].unwrap(),",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最小化する `x ^ y` を返す（空でないこと）。",
      "    fn 最小xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => {",
      "                    結果 |= 1 << b;",
      "                    v = self.子[v][ビット ^ 1].unwrap();",
      "                }",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 0 始まりで `k` 番目に小さい値を返す（多重度込み、`0 <= k < 個数`）。",
      "    fn k番目(&self, mut k: usize) -> usize {",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let c0 = self.子[v][0];",
      "            let 左 = c0.map_or(0, |c| self.通過数[c]);",
      "            if k < 左 {",
      "                v = c0.unwrap();",
      "            } else {",
      "                k -= 左;",
      "                結果 |= 1 << b;",
      "                v = self.子[v][1].unwrap();",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// `x` 以下の格納要素の個数（多重度込み）。",
      "    fn 以下の個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 個数 = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            if ビット == 1 {",
      "                if let Some(c0) = self.子[v][0] {",
      "                    個数 += self.通過数[c0];",
      "                }",
      "            }",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 個数,",
      "            }",
      "        }",
      "        個数 + self.通過数[v]",
      "    }",
      "}"
    ]
  },
  "ビット_連立_方程式": {
    "scope": "rust",
    "prefix": "ビット_連立_方程式",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// GF(2) 上の連立一次方程式 `A x = b` を掃き出し（ガウス消去）で解く。O(式数 · 変数数)。",
      "/// 変数は `0..変数数`（`変数数 <= 63`）。各式は `(係数ビット集合, 右辺)` で表し、",
      "/// 係数ビット集合の `k` ビット目が立っていれば変数 `x_k` を含む。右辺は 0/1。",
      "/// 解が無ければ `None`。`Some(解)` は解の一つ（自由変数は 0 とおく）。",
      "/// 実数の連立方程式は `nalgebra` を使うこと。これは XOR（mod 2）専用。",
      "fn xor連立方程式(変数数: usize, 式: &[(u64, u8)]) -> Option<Vec<u8>> {",
      "    let 右辺ビット = 1u64 << 変数数;",
      "    let mut 行: Vec<u64> = 式",
      "        .iter()",
      "        .map(|&(係数, b)| 係数 | ((b as u64 & 1) << 変数数))",
      "        .collect();",
      "    let mut ピボット行 = vec![!0; 変数数];",
      "    let mut 行位置 = 0usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for 列 in 0..変数数 {",
      "        let Some(選択) = (行位置..行.len()).find(|&r| 行[r] >> 列 & 1 == 1) else {",
      "            continue;",
      "        };",
      "        行.swap(行位置, 選択);",
      "        let 基準 = 行[行位置];",
      "        for (r, row) in 行.iter_mut().enumerate() {",
      "            if r != 行位置 && *row >> 列 & 1 == 1 {",
      "                *row ^= 基準;",
      "            }",
      "        }",
      "        ピボット行[列] = 行位置;",
      "        行位置 += 1;",
      "    }",
      "    if 行[行位置..].contains(&右辺ビット) {",
      "        return None;",
      "    }",
      "    let mut 解 = vec![0u8; 変数数];",
      "    for (列, &pr) in ピボット行.iter().enumerate() {",
      "        if pr != !0 {",
      "            解[列] = ((行[pr] >> 変数数) & 1) as u8;",
      "        }",
      "    }",
      "    Some(解)",
      "}"
    ]
  },
  "ビット_集合の_二分割": {
    "scope": "rust",
    "prefix": "ビット_集合の_二分割",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `ビット` の部分集合を降順（`ビット` → … → `0`）に全列挙する。空集合を含み `2^popcount` 個",
      "/// （全マスクを回すと合計 `3^N`）。相方は `ビット ^ 部分`。`ビット == 0` なら `0` を 1 個返す。",
      "fn 部分集合(ビット: usize) -> impl Iterator<Item = usize> {",
      "    let mut 次 = Some(ビット);",
      "    std::iter::from_fn(move || {",
      "        let 今 = 次?;",
      "        次 = if 今 == 0 {",
      "            None",
      "        } else {",
      "            Some((今 - 1) & ビット)",
      "        };",
      "        Some(今)",
      "    })",
      "}",
      "/// `ビット` を `(最下位ビットを含むグループ, 残り)` に分ける全通り（`2^(popcount-1)` 個）を列挙する。",
      "/// 最下位ビットを片側に固定するので空グループが出ず、`(A, B)` と `(B, A)` を二重に数えない。",
      "/// 集合を空でない部分に切る DP（TSP・集合被覆・シュタイナー木）向け。`ビット != 0` が前提。",
      "fn 分割(ビット: usize) -> impl Iterator<Item = (usize, usize)> {",
      "    let 最下位 = ビット & ビット.wrapping_neg();",
      "    部分集合(ビット ^ 最下位).map(move |s| {",
      "        let グループ = s | 最下位;",
      "        (グループ, ビット ^ グループ)",
      "    })",
      "}"
    ]
  },
