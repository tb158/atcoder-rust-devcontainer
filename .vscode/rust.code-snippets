      "                    }",
      "                    Some(隣) if 隣 == c => {",
      "                        if now == next {",
      "                            return Some(vec![now]);",
      "                        }",
      "                        let mut 経路now = Vec::new();",
      "                        let mut x = now;",
      "                        loop {",
      "                            経路now.push(x);",
      "                            if prev[x] == !0 {",
      "                                break;",
      "                            }",
      "                            x = prev[x];",
      "                        }",
      "                        let mut 位置 = vec![!0; n];",
      "                        for (i, &x) in 経路now.iter().enumerate() {",
      "                            位置[x] = i;",
      "                        }",
