  "線形_拡大_数": {
    "scope": "rust",
    "prefix": "線形_拡大_数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// DAG（半順序）の**位相順序（線形拡大）の総数**を `法` で数える。頂点数 `N ≤ 20` 程度向けの",
      "/// 部分集合 DP。`O(2^N · N)`。",
      "/// `辺` は有向辺 `(u, v)`（`u → v`、`u` が `v` より前）。閉路があれば 0。",
      "/// 半順序集合の線形拡大数（ソートの仕方の数）を求めるのに使う。",
      "#[allow(clippy::needless_range_loop)]",
      "fn 位相順序数(頂点数: usize, 辺: &[(usize, usize)], 法: u64) -> u64 {",
      "    let n = 頂点数;",
      "    if n == 0 {",
      "        return 1 % 法;",
      "    }",
      "    assert!(n <= 31, \"頂点数が多すぎる（2^N が大きすぎる）: {n}\");",
      "    let mut 前提 = vec![0u32; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        前提[v] |= 1 << u;",
      "    }",
      "    let 全体 = (1u32 << n) - 1;",
      "    let mut dp = vec![0u64; 1 << n];",
      "    dp[0] = 1 % 法;",
      "    for s in 0..=全体 {",
      "        if dp[s as usize] == 0 {",
      "            continue;",
      "        }",
      "        let cur = dp[s as usize];",
      "        for v in 0..n {",
      "            let bit = 1u32 << v;",
      "            if s & bit == 0 && 前提[v] & s == 前提[v] {",
      "                let ns = (s | bit) as usize;",
      "                dp[ns] = (dp[ns] + cur) % 法;",
      "            }",
      "        }",
      "    }",
      "    dp[全体 as usize]",
      "}"
    ]
  },
  "線形_漸化式": {
    "scope": "rust",
    "prefix": "線形_漸化式",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// Berlekamp-Massey 法。数列 `数列`（素数 `法` 上）を生成する最短の線形漸化式の係数を返す。",
      "/// O(N·L)（L は漸化式の次数）。",
      "/// 返り値 `c`（長さ L）は `S[i] = Σ_{j=0}^{L-1} c[j]·S[i-1-j]`（`i ≥ L`）を満たす。",
      "/// 数列は少なくとも `2L` 項あると安全。第 N 項を求めるには [`線形漸化式の第n項`] に渡す。",
      "fn ベルレカンプマッシー(数列: &[u64], 法: u64) -> Vec<u64> {",
      "    let p = 法 as i128;",
      "    let n = 数列.len();",
      "    let s: Vec<i128> = 数列.iter().map(|&x| (x as i128) % p).collect();",
      "    let mut c = vec![0i128; n + 1];",
      "    let mut b = vec![0i128; n + 1];",
      "    c[0] = 1 % p;",
      "    b[0] = 1 % p;",
      "    let mut l = 0usize;",
      "    let mut m = 0usize;",
      "    let mut bb = 1i128 % p;",
      "    for i in 0..n {",
      "        m += 1;",
      "        let mut d = s[i] % p;",
      "        for j in 1..=l {",
      "            d = (d + c[j] * s[i - j]) % p;",
      "        }",
      "        if d == 0 {",
      "            continue;",
      "        }",
      "        let t = c.clone();",
      "        let coef = d * 累乗_mod((bb % p) as u64, 法 - 2, 法) as i128 % p;",
      "        for j in m..=n {",
      "            c[j] = ((c[j] - coef * b[j - m]) % p + p) % p;",
      "        }",
      "        if 2 * l > i {",
      "            continue;",
      "        }",
      "        l = i + 1 - l;",
      "        b = t;",
      "        bb = d;",
      "        m = 0;",
      "    }",
      "    c.truncate(l + 1);",
      "    c.drain(0..1);",
      "    c.iter().map(|&x| (((p - x) % p + p) % p) as u64).collect()",
      "}",
      "/// 多項式の積を `x^k = Σ 係数[j]·x^{k-1-j}` で次数 `k` 未満に縮約する内部関数。",
      "fn 多項式乗算縮約(a: &[u64], b: &[u64], 係数: &[u64], 法: u64) -> Vec<u64> {",
      "    let k = 係数.len();",
      "    let m = 法 as u128;",
      "    let mut res = vec![0u128; (a.len() + b.len()).saturating_sub(1).max(k)];",
      "    for (i, &ai) in a.iter().enumerate() {",
      "        if ai == 0 {",
      "            continue;",
      "        }",
      "        for (j, &bj) in b.iter().enumerate() {",
      "            res[i + j] = (res[i + j] + ai as u128 * bj as u128) % m;",
      "        }",
      "    }",
      "    for d in (k..res.len()).rev() {",
      "        let v = res[d];",
      "        if v != 0 {",
      "            res[d] = 0;",
      "            for (j, &係) in 係数.iter().enumerate() {",
      "                let deg = d - 1 - j;",
      "                res[deg] = (res[deg] + v * 係 as u128) % m;",
      "            }",
      "        }",
      "    }",
      "    res.truncate(k);",
      "    res.resize(k, 0);",
      "    res.iter().map(|&x| x as u64).collect()",
      "}",
      "/// きたまさ法。線形漸化式 `S[i] = Σ_{j} 係数[j]·S[i-1-j]` と初項 `初項`（長さ ≥ 次数）から、",
      "/// 第 `n` 項を素数 `法` で O(k^2 log n) で求める（k は次数）。",
      "fn 線形漸化式の第n項(初項: &[u64], 係数: &[u64], n: usize, 法: u64) -> u64 {",
      "    let k = 係数.len();",
      "    if k == 0 {",
      "        return 0;",
      "    }",
      "    if n < k {",
      "        return 初項[n] % 法;",
      "    }",
      "    let mut 結果 = vec![0u64; k];",
      "    結果[0] = 1 % 法;",
      "    let mut 底 = if k >= 2 {",
      "        let mut v = vec![0u64; k];",
      "        v[1] = 1 % 法;",
      "        v",
      "    } else {",
      "        vec![係数[0] % 法]",
      "    };",
      "    let mut e = n;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            結果 = 多項式乗算縮約(&結果, &底, 係数, 法);",
      "        }",
      "        底 = 多項式乗算縮約(&底, &底, 係数, 法);",
      "        e >>= 1;",
      "    }",
      "    let m = 法 as u128;",
      "    let mut ans = 0u128;",
      "    for (i, &係) in 結果.iter().enumerate() {",
      "        ans = (ans + 係 as u128 * (初項[i] % 法) as u128) % m;",
      "    }",
      "    ans as u64",
      "}",
      "/// 数列の先頭を渡すと、Berlekamp-Massey で漸化式を推定し、きたまさ法で第 `n` 項を返す。",
      "/// 数列は最短漸化式の次数の 2 倍以上の項を含むこと（足りないと誤った外挿になる）。",
      "fn 数列の第n項(数列: &[u64], n: usize, 法: u64) -> u64 {",
      "    let 係数 = ベルレカンプマッシー(数列, 法);",
      "    線形漸化式の第n項(数列, &係数, n, 法)",
      "}"
    ]
  },
  "編集_距離": {
    "scope": "rust",
    "prefix": "編集_距離",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// レーベンシュタイン編集距離。`a` を `b` に変えるのに必要な",
      "/// 「1文字の挿入・削除・置換」の最小回数を返す（各操作コスト 1）。O(N*M)。",
      "fn 編集距離<T: PartialEq>(a: &[T], b: &[T]) -> usize {",
      "    let n = a.len();",
      "    let m = b.len();",
      "    let mut dp = vec![vec![0usize; m + 1]; n + 1];",
      "    for (i, 行) in dp.iter_mut().enumerate() {",
      "        行[0] = i;",
      "    }",
      "    for (j, v) in dp[0].iter_mut().enumerate() {",
      "        *v = j;",
      "    }",
      "    for i in 1..=n {",
      "        for j in 1..=m {",
      "            let 置換コスト = if a[i - 1] == b[j - 1] { 0 } else { 1 };",
      "            dp[i][j] = (dp[i - 1][j] + 1)",
      "                .min(dp[i][j - 1] + 1)",
      "                .min(dp[i - 1][j - 1] + 置換コスト);",
      "        }",
      "    }",
      "    dp[n][m]",
      "}"
    ]
  },
  "縮約木": {
    "scope": "rust",
    "prefix": "縮約木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 仮想木（Auxiliary Tree）。根付き木と頂点集合 `S` が与えられたとき、`S` と「`S` 内 2 頂点の LCA」だけを",
      "/// 残して縮約した木を作る。頂点数 `|S|` に対し O(|S| log |S|) で構築でき、クエリごとの木 DP を高速化する。",
      "/// 二分上昇 LCA を内包する自己完結版。",
      "/// - [`Self::lca`] : 最近共通祖先。",
      "/// - [`Self::構築`] : 頂点集合から仮想木の `(頂点リスト, 辺(親, 子))` を返す。",
      "struct 仮想木 {",
      "    上: Vec<Vec<i64>>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    log: usize,",
      "}",
      "impl 仮想木 {",
      "    /// 頂点数 `n`・辺リスト `辺`（AtCoder の入力そのまま）と根から前計算する。",
      "    fn new(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut log = 1;",
      "        while (1usize << log) < n.max(2) {",
      "            log += 1;",
      "        }",
      "        let mut 上 = vec![vec![-1i64; n]; log];",
      "        let 深さ = vec![0usize; n];",
      "        let 入時刻 = vec![0usize; n];",
      "        let 出時刻 = vec![0usize; n];",
      "        let mut d = 構築データ {",
      "            prev: std::mem::take(&mut 上[0]),",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            時刻: 0,",
      "        };",
      "        探索(根, -1, &グラフ, &mut d);",
      "        上[0] = d.prev;",
      "        let 深さ = d.深さ;",
      "        let 入時刻 = d.入時刻;",
      "        let 出時刻 = d.出時刻;",
      "        for k in 1..log {",
      "            for v in 0..n {",
      "                let 中 = 上[k - 1][v];",
      "                上[k][v] = if 中 < 0 {",
      "                    -1",
      "                } else {",
      "                    上[k - 1][中 as usize]",
      "                };",
      "            }",
      "        }",
      "        Self {",
      "            上,",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            log,",
      "        }",
      "    }",
      "    /// `a` が `b` の祖先か（自身も祖先とみなす）。",
      "    fn 祖先か(&self, a: usize, b: usize) -> bool {",
      "        self.入時刻[a] <= self.入時刻[b] && self.出時刻[b] <= self.出時刻[a]",
      "    }",
      "    /// 最近共通祖先。",
      "    fn lca(&self, mut u: usize, mut v: usize) -> usize {",
      "        if self.深さ[u] < self.深さ[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = self.深さ[u] - self.深さ[v];",
      "        for k in 0..self.log {",
      "            if (差 >> k) & 1 == 1 {",
      "                u = self.上[k][u] as usize;",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for k in (0..self.log).rev() {",
      "            if self.上[k][u] != self.上[k][v] {",
      "                u = self.上[k][u] as usize;",
      "                v = self.上[k][v] as usize;",
      "            }",
      "        }",
      "        self.上[0][u] as usize",
      "    }",
      "    /// 頂点集合から仮想木を構築し、`(頂点リスト, 辺(親, 子))` を返す。",
      "    /// 頂点リストは入時刻順。辺は親が子の祖先になる向き。",
      "    fn 構築(&self, 頂点集合: &[usize]) -> (Vec<usize>, Vec<(usize, usize)>) {",
      "        if 頂点集合.is_empty() {",
      "            return (Vec::new(), Vec::new());",
      "        }",
      "        let mut s = 頂点集合.to_vec();",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 追加 = Vec::new();",
      "        for w in s.windows(2) {",
      "            追加.push(self.lca(w[0], w[1]));",
      "        }",
      "        s.extend(追加);",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 辺 = Vec::new();",
      "        let mut スタック: Vec<usize> = Vec::new();",
      "        for &v in &s {",
      "            while let Some(&天辺) = スタック.last() {",
      "                if self.祖先か(天辺, v) {",
      "                    break;",
      "                }",
      "                スタック.pop();",
      "            }",
      "            if let Some(&天辺) = スタック.last() {",
      "                辺.push((天辺, v));",
      "            }",
      "            スタック.push(v);",
      "        }",
      "        (s, 辺)",
      "    }",
      "}",
      "/// DFS 中に埋める配列をまとめた作業領域（引数を 1 つに減らすため）。",
      "struct 構築データ {",
      "    prev: Vec<i64>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    時刻: usize,",
      "}",
      "/// 入時刻・出時刻・深さ・直接の親を埋める DFS。",
      "fn 探索(now: usize, prev: i64, グラフ: &[Vec<usize>], d: &mut 構築データ) {",
      "    d.prev[now] = prev;",
      "    d.入時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "    for &next in &グラフ[now] {",
      "        if next as i64 != prev {",
      "            d.深さ[next] = d.深さ[now] + 1;",
      "            探索(next, now as i64, グラフ, d);",
      "        }",
      "    }",
      "    d.出時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "}"
    ]
  },
  "繰り返し_二乗法": {
    "scope": "rust",
    "prefix": "繰り返し_二乗法",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}"
    ]
  },
  "花_アルゴリズム": {
    "scope": "rust",
    "prefix": "花_アルゴリズム",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 一般グラフ（二部とは限らない、奇閉路を含んでよい）の最大マッチング。O(V·E)。",
      "/// 二部グラフに限るなら [`crate::hopcroft_karp`] の方が高速。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に相手も保持）。",
      "/// - [`Self::相手一覧`] : 各頂点の相手（未マッチは -1）。",
      "struct 一般マッチング {",
      "    n: usize,",
      "    辺: Vec<(usize, usize)>,",
      "    相手: Vec<i64>,",
      "}",
      "impl 一般マッチング {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            辺: Vec::new(),",
      "            相手: vec![-1; n],",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.辺.push((u, v));",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut g = petgraph::graph::UnGraph::<(), ()>::new_undirected();",
      "        let 節: Vec<petgraph::graph::NodeIndex> = (0..self.n).map(|_| g.add_node(())).collect();",
      "        for &(u, v) in &self.辺 {",
      "            g.add_edge(節[u], 節[v], ());",
      "        }",
      "        let マッチング = petgraph::algo::maximum_matching(&g);",
      "        self.相手 = vec![-1; self.n];",
      "        let mut 本数 = 0;",
      "        for (a, b) in マッチング.edges() {",
      "            self.相手[a.index()] = b.index() as i64;",
      "            self.相手[b.index()] = a.index() as i64;",
      "            本数 += 1;",
      "        }",
      "        本数",
      "    }",
      "    /// 各頂点の相手（未マッチは -1）。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn 相手一覧(&self) -> &[i64] {",
      "        &self.相手",
      "    }",
      "}"
    ]
  },
  "行_最小値": {
    "scope": "rust",
    "prefix": "行_最小値",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// REDUCE 操作: どの行の最小にもなり得ない列を取り除き、残す列数を行数以下にする内部関数。",
      "fn 列削減<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行: &[usize],",
      "    列: &[usize],",
      "    コスト: &F,",
      ") -> Vec<usize> {",
      "    let mut 残す: Vec<usize> = Vec::new();",
      "    for &c in 列 {",
      "        while let Some(&上) = 残す.last() {",
      "            let k = 残す.len() - 1;",
      "            if k < 行.len() && コスト(行[k], 上) > コスト(行[k], c) {",
      "                残す.pop();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        if 残す.len() < 行.len() {",
      "            残す.push(c);",
      "        }",
      "    }",
      "    残す",
      "}",
      "/// SMAWK 本体（再帰）。偶数位置の行は奇数位置の行の答えで挟み込んで線形に解く。",
      "fn 解く<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行: &[usize],",
      "    列: &[usize],",
      "    コスト: &F,",
      "    答え: &mut [usize],",
      ") {",
      "    if 行.is_empty() {",
      "        return;",
      "    }",
      "    let 列 = 列削減(行, 列, コスト);",
      "    let 奇: Vec<usize> = 行.iter().skip(1).step_by(2).copied().collect();",
      "    解く(&奇, &列, コスト, 答え);",
      "    let mut j = 0;",
      "    let mut pos = 0;",
      "    while pos < 行.len() {",
      "        let r = 行[pos];",
      "        let 終列 = if pos + 1 < 行.len() {",
      "            答え[行[pos + 1]]",
      "        } else {",
      "            *列.last().unwrap()",
      "        };",
      "        let mut 最良 = 列[j];",
      "        while 列[j] != 終列 {",
      "            j += 1;",
      "            if コスト(r, 列[j]) < コスト(r, 最良) {",
      "                最良 = 列[j];",
      "            }",
      "        }",
      "        答え[r] = 最良;",
      "        pos += 2;",
      "    }",
      "}",
      "/// SMAWK 法。完全単調（totally monotone, Monge を含む）な `行数 × 列数` 行列について、",
      "/// 各行の最小値をとる列番号を `O(行数 + 列数)` で求める。`コスト(i, j)` で要素を遅延参照する。",
      "/// 行列が完全単調（任意の `i<i'`, `j<j'` で `A[i][j]>A[i][j']` ⇒ `A[i'][j]>A[i'][j']`）であることが前提。",
      "/// 分割統治の単調最小値（[`divide_and_conquer_dp`](crate::divide_and_conquer_dp)、`O(n log n)`）より",
      "/// 高速。最近点・DP 高速化などで使う。",
      "/// 返り値 `argmin[i]` は行 `i` の最小値をとる列（同点は最左）。`列数 == 0` のときは空でない行に `0` が入る。",
      "/// コストの型は比較できれば何でもよい（i64 / f64 など）。",
      "fn 行ごとの最小列<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行数: usize,",
      "    列数: usize,",
      "    コスト: F,",
      ") -> Vec<usize> {",
      "    let mut 答え = vec![0usize; 行数];",
      "    if 行数 == 0 || 列数 == 0 {",
      "        return 答え;",
      "    }",
      "    let 行: Vec<usize> = (0..行数).collect();",
      "    let 列: Vec<usize> = (0..列数).collect();",
      "    解く(&行, &列, &コスト, &mut 答え);",
      "    答え",
      "}"
    ]
  },
  "行きがけ_帰りがけ": {
    "scope": "rust",
    "prefix": "行きがけ_帰りがけ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// オイラーツアー（部分木 → 区間への変換）。根 `根` から木を DFS し、各頂点 `v` の",
      "/// 入時刻 `in_[v]` と出時刻 `out[v]` を返す（再帰なし）。O(N)。`in_` は行きがけ順 0..N。",
      "/// `辺` は 0-indexed の頂点対（AtCoder の入力そのまま）。",
      "/// 部分木 `v` は半開区間 `[in_[v], out[v])` に対応する（`out[v] - in_[v]` が部分木サイズ）。",
      "/// `u` が `v` の部分木に含まれる ⇔ `in_[v] <= in_[u] < out[v]`。",
      "/// この区間を BIT / セグ木の添字に使えば「部分木への一括加算・部分木和」を扱える。",
      "fn オイラーツアー(n: usize, 辺: &[(usize, usize)], 根: usize) -> (Vec<usize>, Vec<usize>) {",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut in_ = vec![0usize; n];",
      "    let mut out = vec![0usize; n];",
      "    let mut 時刻 = 0usize;",
      "    let mut 探索 = vec![(根, !0)];",
