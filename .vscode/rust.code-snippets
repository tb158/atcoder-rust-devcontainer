  "最も_近い_2点": {
    "scope": "rust",
    "prefix": "最も_近い_2点",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗を `i128` で返す。",
      "/// 平方根を取らないので誤差なしで距離を比較できる。差を取ってから `i128` に広げるため、",
      "/// 座標が `±10^18` でも桁あふれしない。実距離が要るときは `(d as f64).sqrt()`。",
      "fn 距離2乗(a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let dx = (a.0 - b.0) as i128;",
      "    let dy = (a.1 - b.1) as i128;",
      "    dx * dx + dy * dy",
      "}",
      "/// 平面上の点群から最も近い 2 点を分割統治で求める。O(N log^2 N)。",
      "/// 返り値は `(最小距離の 2 乗, (点 i の添字, 点 j の添字))`。点が 2 個未満なら `None`。",
      "/// 距離は整数の 2 乗で厳密に比較する（誤差なし）。",
      "fn 最近点対(点群: &[(i64, i64)]) -> Option<(i128, (usize, usize))> {",
      "    if 点群.len() < 2 {",
      "        return None;",
      "    }",
      "    let mut idx: Vec<usize> = (0..点群.len()).collect();",
      "    idx.sort_by_key(|&i| (点群[i].0, 点群[i].1));",
      "    let n = idx.len();",
      "    Some(再帰(点群, &idx, 0, n))",
      "}",
      "/// `idx[l..r]`（x 昇順）の範囲で最近点対を求める。",
      "fn 再帰(点群: &[(i64, i64)], idx: &[usize], l: usize, r: usize) -> (i128, (usize, usize)) {",
      "    if r - l <= 3 {",
      "        let mut 最良 = (i128::MAX, (0usize, 0usize));",
      "        for a in l..r {",
      "            for b in a + 1..r {",
      "                let d = 距離2乗(点群[idx[a]], 点群[idx[b]]);",
      "                if d < 最良.0 {",
      "                    最良 = (d, (idx[a], idx[b]));",
      "                }",
      "            }",
      "        }",
      "        return 最良;",
      "    }",
      "    let 中 = (l + r) / 2;",
      "    let 中x = 点群[idx[中]].0;",
      "    let 左 = 再帰(点群, idx, l, 中);",
      "    let 右 = 再帰(点群, idx, 中, r);",
      "    let mut 最良 = if 左.0 <= 右.0 { 左 } else { 右 };",
      "    let mut 帯: Vec<usize> = idx[l..r]",
      "        .iter()",
      "        .copied()",
      "        .filter(|&p| {",
      "            let dx = (点群[p].0 - 中x) as i128;",
      "            dx * dx < 最良.0",
      "        })",
      "        .collect();",
      "    帯.sort_by_key(|&p| 点群[p].1);",
      "    for (i, &pi) in 帯.iter().enumerate() {",
      "        for &pj in &帯[i + 1..] {",
      "            let dy = (点群[pj].1 - 点群[pi].1) as i128;",
      "            if dy * dy >= 最良.0 {",
      "                break;",
      "            }",
      "            let d = 距離2乗(点群[pi], 点群[pj]);",
      "            if d < 最良.0 {",
      "                最良 = (d, (pi, pj));",
      "            }",
      "        }",
      "    }",
      "    最良",
      "}"
    ]
  },
