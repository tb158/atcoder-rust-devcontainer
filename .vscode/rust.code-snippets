    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// スライド最小値。長さ `窓` の連続する各区間の最小値を、単調デックで O(N) に列挙する。",
      "/// 戻り値の長さは `a.len() + 1 - 窓`（`窓 == 0` または `窓 > a.len()` のとき空）。",
      "/// 戻り値 `res[i]` は区間 `a[i..i+窓]` の最小値。",
      "fn スライド最小値<T: Ord + Copy>(a: &[T], 窓: usize) -> Vec<T> {",
      "    use std::collections::VecDeque;",
      "    let mut res = Vec::new();",
      "    if 窓 == 0 || 窓 > a.len() {",
      "        return res;",
      "    }",
      "    let mut dq: VecDeque<usize> = VecDeque::new();",
      "    for (i, &x) in a.iter().enumerate() {",
      "        while let Some(&後) = dq.back() {",
      "            if a[後] >= x {",
      "                dq.pop_back();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        dq.push_back(i);",
      "        if i + 1 >= 窓 {",
      "            let 左端 = i + 1 - 窓;",
      "            while let Some(&先) = dq.front() {",
      "                if 先 < 左端 {",
      "                    dq.pop_front();",
      "                } else {",
      "                    break;",
      "                }",
      "            }",
      "            res.push(a[*dq.front().unwrap()]);",
      "        }",
      "    }",
      "    res",
      "}",
      "/// スライド最大値。長さ `窓` の連続する各区間の最大値を単調デックで O(N) に列挙する。",
      "/// 仕様は [`スライド最小値`] と同じで、デック内が単調減少になる点だけが異なる。",
      "fn スライド最大値<T: Ord + Copy>(a: &[T], 窓: usize) -> Vec<T> {",
      "    use std::collections::VecDeque;",
      "    let mut res = Vec::new();",
      "    if 窓 == 0 || 窓 > a.len() {",
      "        return res;",
      "    }",
      "    let mut dq: VecDeque<usize> = VecDeque::new();",
      "    for (i, &x) in a.iter().enumerate() {",
      "        while let Some(&後) = dq.back() {",
      "            if a[後] <= x {",
      "                dq.pop_back();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        dq.push_back(i);",
      "        if i + 1 >= 窓 {",
      "            let 左端 = i + 1 - 窓;",
      "            while let Some(&先) = dq.front() {",
      "                if 先 < 左端 {",
      "                    dq.pop_front();",
      "                } else {",
      "                    break;",
      "                }",
      "            }",
      "            res.push(a[*dq.front().unwrap()]);",
      "        }",
      "    }",
      "    res",
      "}"
    ]
  },
  "単調_最小値": {
    "scope": "rust",
    "prefix": "単調_最小値",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 単調最小値（monotone minima）。各行 `i` の最小値をとる列 `argmin(i)` が `i` について単調非減少",
      "/// であるような暗黙の行列に対し、全行の `(最小値, argmin)` を `O((行数 + 列数) log 行数)` で求める。",
      "/// `コスト(i, j)` が行 `i`・列 `j` の値を返す。Monge（凸四角不等式）な行列で成り立つ。",
      "/// 同点のときはより小さい列を採用する。`列数 == 0` のときは全行 `(i64::MAX, 0)`。",
      "fn 単調最小値<F: Fn(usize, usize) -> i64>(",
      "    行数: usize,",
      "    列数: usize,",
      "    コスト: F,",
      ") -> Vec<(i64, usize)> {",
      "    let mut 結果 = vec![(i64::MAX, 0usize); 行数];",
      "    if 行数 == 0 || 列数 == 0 {",
      "        return 結果;",
      "    }",
      "    let mut スタック = vec![(0usize, 行数, 0usize, 列数 - 1)];",
      "    while let Some((行下, 行上, 列下, 列上)) = スタック.pop() {",
      "        if 行下 >= 行上 {",
      "            continue;",
      "        }",
      "        let 中 = (行下 + 行上) / 2;",
      "        let mut 最良値 = i64::MAX;",
      "        let mut 最良列 = 列下;",
      "        for j in 列下..=列上 {",
      "            let v = コスト(中, j);",
      "            if v < 最良値 {",
      "                最良値 = v;",
      "                最良列 = j;",
      "            }",
      "        }",
      "        結果[中] = (最良値, 最良列);",
      "        スタック.push((行下, 中, 列下, 最良列));",
      "        スタック.push((中 + 1, 行上, 最良列, 列上));",
      "    }",
      "    結果",
      "}",
      "/// 1 層の DP 遷移 `新[j] = min_{0 <= k <= j} ( 旧[k] + コスト(k, j) )` を、最適 `k` が `j` について",
      "/// 単調と仮定して `O(N log N)` で計算する（[`単調最小値`] を三角制約付きで適用）。",
      "/// `コスト(k, j)` は `k <= j` のときに呼ばれ、Monge 性（`コスト(a,c)+コスト(b,d) <= コスト(a,d)+コスト(b,c)`、",
      "/// `a<=b<=c<=d`）を満たすときに正しい。`旧[k] == i64::MAX` は到達不能として扱う（飽和加算）。",
      "/// 返り値の長さは `旧.len()`。",
      "fn 分割統治dp層<F: Fn(usize, usize) -> i64>(旧: &[i64], コスト: F) -> Vec<i64> {",
      "    let n = 旧.len();",
      "    let 行列 = |j: usize, k: usize| -> i64 {",
      "        if k <= j && 旧[k] != i64::MAX {",
      "            旧[k].saturating_add(コスト(k, j))",
      "        } else {",
      "            i64::MAX",
      "        }",
      "    };",
      "    単調最小値(n, n, 行列).into_iter().map(|(v, _)| v).collect()",
      "}"
    ]
  },
  "原始根": {
    "scope": "rust",
    "prefix": "原始根",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// `n` の相異なる素因数を昇順で返す（試し割り）。`n` の最大素因数が ~10^7 程度までなら高速。",
      "fn 素因数集合(mut n: u64) -> Vec<u64> {",
      "    let mut v = Vec::new();",
      "    let mut d = 2u64;",
      "    while d * d <= n {",
      "        if n % d == 0 {",
      "            v.push(d);",
      "            while n % d == 0 {",
      "                n /= d;",
      "            }",
      "        }",
      "        d += 1;",
      "    }",
      "    if n > 1 {",
      "        v.push(n);",
      "    }",
      "    v",
      "}",
      "/// 素数 `p` の最小の原始根を返す。`p == 2` なら 1。",
      "/// 原始根 `g` は位数が `p-1`、すなわち `g^1, g^2, ..., g^{p-1}` が `1..p` を一巡する数。NTT の回転因子や",
      "/// 離散対数の底に使う。",
      "/// `p` は素数であること（`p-1` の素因数分解に試し割りを使うので `p-1` の最大素因数が大きすぎないこと）。",
      "fn 原始根(p: impl TryInto<u64>) -> usize {",
      "    let p: u64 = p",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"原始根: 引数が u64 に収まりません\");",
      "    if p == 2 {",
      "        return 1;",
      "    }",
      "    let 素因数 = 素因数集合(p - 1);",
      "    let mut g = 2u64;",
      "    loop {",
      "        if 素因数.iter().all(|&q| 累乗_mod(g, (p - 1) / q, p) != 1) {",
      "            return g as usize;",
      "        }",
      "        g += 1;",
      "    }",
      "}",
      "/// 素数 `p` を法とする `a`（`a % p != 0`）の乗法的位数（`a^k ≡ 1 mod p` となる最小の正の `k`）。",
      "/// 位数は `p-1` の約数。`p` は素数であること。",
      "fn 位数(a: impl TryInto<u64>, p: impl TryInto<u64>) -> usize {",
      "    let a: u64 = a.try_into().ok().expect(\"位数: 引数が u64 に収まりません\");",
      "    let p: u64 = p.try_into().ok().expect(\"位数: 引数が u64 に収まりません\");",
      "    assert!(a % p != 0, \"a must not be a multiple of p\");",
      "    let mut k = p - 1;",
      "    for q in 素因数集合(p - 1) {",
      "        while k % q == 0 && 累乗_mod(a, k / q, p) == 1 {",
      "            k /= q;",
      "        }",
      "    }",
      "    k as usize",
      "}"
    ]
  },
  "商の_列挙": {
    "scope": "rust",
    "prefix": "商の_列挙",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `⌊n/i⌋`（`i = 1..=n`）の値が一定になる `i` の区間をまとめて列挙する。O(√n)。",
      "/// 各要素は `(商, 左, 右)`：`i ∈ [左, 右]` の範囲で `⌊n/i⌋ == 商`。区間は `i` の昇順、",
      "/// `商` は降順に並ぶ。`Σ_{i=1}^{n} ⌊n/i⌋` や約数関数の和などを O(√n) で計算するのに使う。",
      "fn 商の列挙(n: u64) -> Vec<(u64, u64, u64)> {",
      "    let mut res = Vec::new();",
      "    let mut i = 1;",
      "    while i <= n {",
      "        let 商 = n / i;",
      "        let 右 = n / 商;",
      "        res.push((商, i, 右));",
      "        i = 右 + 1;",
      "    }",
      "    res",
      "}"
    ]
  },
  "回文": {
    "scope": "rust",
    "prefix": "回文",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Manacher 法。列に含まれる最長の回文部分列の長さを O(N) で返す。",
      "/// 偶数長の回文にも対応するため、内部で文字の間に区切りを挟んだ列を作って処理する。",
      "/// 要素型 `T` は等値比較できれば何でもよい（バイト列 `s.as_bytes()` のほか",
      "/// `&[char]`・`&[i64]` などにも使える）。",
      "fn マナカー最長回文<T: PartialEq>(s: &[T]) -> usize {",
      "    if s.is_empty() {",
      "        return 0;",
      "    }",
      "    let mut t: Vec<Option<&T>> = Vec::with_capacity(2 * s.len() + 1);",
      "    for c in s {",
      "        t.push(None);",
      "        t.push(Some(c));",
      "    }",
      "    t.push(None);",
      "    let n = t.len();",
      "    let mut 半径 = vec![0usize; n];",
      "    let (mut 中心, mut 右端) = (0usize, 0usize);",
      "    for i in 0..n {",
      "        if i < 右端 {",
      "            半径[i] = (右端 - i).min(半径[2 * 中心 - i]);",
      "        }",
      "        while i > 半径[i] && i + 半径[i] + 1 < n && t[i + 半径[i] + 1] == t[i - 半径[i] - 1]",
      "        {",
      "            半径[i] += 1;",
      "        }",
      "        if i + 半径[i] > 右端 {",
      "            中心 = i;",
      "            右端 = i + 半径[i];",
      "        }",
      "    }",
      "    半径.into_iter().max().unwrap()",
      "}"
    ]
  },
  "回文_分割": {
    "scope": "rust",
    "prefix": "回文_分割",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 文字列を**すべて回文になるように分割する最小カット数**を返す（分割数 − 1）。`O(N²)`。",
      "/// 文字列全体がすでに回文なら 0。空文字列も 0。",
      "/// [`manacher`](crate::manacher) は最長回文「部分文字列」、[`palindromic_tree`](crate::palindromic_tree) は",
      "/// 回文の数え上げで、いずれも分割の最小化は扱わない。",
      "fn 回文分割の最小カット数(s: &[u8]) -> usize {",
      "    let n = s.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let mut 回文 = vec![vec![false; n]; n];",
      "    for i in (0..n).rev() {",
      "        for j in i..n {",
      "            回文[i][j] = s[i] == s[j] && (j - i < 2 || 回文[i + 1][j - 1]);",
      "        }",
      "    }",
      "    const INF: i64 = 1 << 50;",
      "    let mut カット = vec![INF; n + 1];",
      "    カット[0] = -1;",
      "    for i in 1..=n {",
      "        for j in 0..i {",
      "            if 回文[j][i - 1] && カット[j] + 1 < カット[i] {",
      "                カット[i] = カット[j] + 1;",
      "            }",
      "        }",
      "    }",
      "    カット[n] as usize",
      "}"
    ]
  },
