      "        while cr < r {",
      "            状態.追加(cr);",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            状態.追加(cl);",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            状態.削除(cr);",
      "        }",
      "        while cl < l {",
      "            状態.削除(cl);",
      "            cl += 1;",
      "        }",
      "        while ct < t {",
