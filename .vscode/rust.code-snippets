  "重心": {
    "scope": "rust",
    "prefix": "重心",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木の重心を求める（再帰なし）。重心とは、その頂点を取り除いたとき残る",
      "/// 各連結成分の最大サイズが `n/2` 以下になる頂点。木の重心は 1 個か 2 個ある。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対）。戻り値は重心の頂点番号（昇順、長さ 1 か 2）。",
      "/// 重心を分割の基準に使うと、各部分木サイズが半分以下に抑えられる（重心分解の核）。",
      "/// 離心数最小の「中心」は別物で [`木の中心`](crate::tree_diameter::木の中心) を使う。",
      "fn 木の重心(n: usize, 辺: &[(usize, usize)]) -> Vec<usize> {",
      "    if n <= 1 {",
      "        return (0..n).collect();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut prev = vec![!0; n];",
      "    let mut 順 = Vec::with_capacity(n);",
      "    let mut 到達済 = vec![false; n];",
      "    let mut 探索 = vec![0usize];",
      "    到達済[0] = true;",
      "    while let Some(now) = 探索.pop() {",
      "        順.push(now);",
      "        for &next in &グラフ[now] {",
      "            if !到達済[next] {",
      "                到達済[next] = true;",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let mut sz = vec![1usize; n];",
      "    for &now in 順.iter().rev() {",
      "        if prev[now] != !0 {",
      "            sz[prev[now]] += sz[now];",
      "        }",
      "    }",
      "    let mut 重心 = Vec::new();",
      "    for now in 0..n {",
      "        let mut 最大成分 = n - sz[now];",
      "        for &next in &グラフ[now] {",
      "            if prev[next] == now {",
      "                最大成分 = 最大成分.max(sz[next]);",
      "            }",
      "        }",
      "        if 最大成分 <= n / 2 {",
      "            重心.push(now);",
      "        }",
      "    }",
      "    重心",
      "}"
    ]
  },
  "重心_分解": {
    "scope": "rust",
    "prefix": "重心_分解",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木の重心分解。各頂点の「重心木」での親を返す（根は `!0`）。O(N log N)。",
      "/// `辺` は 0-indexed の頂点対（AtCoder の入力そのまま）。返り値 `重心親[v]` は、",
      "/// 重心分解で得られる木構造における `v` の親頂点。重心木の深さは O(log N) に収まるため、",
      "/// 「2 頂点間のパスは必ず両者の重心木祖先のいずれかを通る」性質を使ったパスクエリの",
      "/// 分割統治に用いる。連結な木を前提とする。",
      "fn 重心分解(n: usize, 辺: &[(usize, usize)]) -> Vec<usize> {",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut 重心親 = vec![!0; n];",
      "    let mut 削除済 = vec![false; n];",
      "    let mut sz = vec![0usize; n];",
      "    let mut 作業 = vec![(0usize, !0)];",
      "    let mut 順 = Vec::new();",
      "    let mut prev = vec![!0; n];",
      "    while let Some((開始, 重心木親)) = 作業.pop() {",
      "        順.clear();",
      "        prev[開始] = !0;",
      "        let mut 探索 = vec![開始];",
      "        while let Some(now) = 探索.pop() {",
      "            順.push(now);",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] && !削除済[next] {",
      "                    prev[next] = now;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        let 全体 = 順.len();",
      "        for &now in 順.iter().rev() {",
      "            sz[now] = 1;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] && !削除済[next] {",
      "                    sz[now] += sz[next];",
      "                }",
      "            }",
      "        }",
      "        let mut 重心 = 開始;",
      "        let mut 前 = !0;",
      "        loop {",
      "            let mut 次 = !0;",
      "            for &v in &グラフ[重心] {",
      "                if v != 前 && !削除済[v] && sz[v] * 2 > 全体 {",
      "                    次 = v;",
      "                    break;",
      "                }",
      "            }",
      "            if 次 == !0 {",
      "                break;",
      "            }",
      "            sz[重心] = 全体 - sz[次];",
      "            前 = 重心;",
      "            重心 = 次;",
      "        }",
      "        重心親[重心] = 重心木親;",
      "        削除済[重心] = true;",
      "        for &next in &グラフ[重心] {",
      "            if !削除済[next] {",
      "                作業.push((next, 重心));",
      "            }",
      "        }",
      "    }",
      "    重心親",
      "}"
    ]
  },
  "重軽_分解": {
    "scope": "rust",
    "prefix": "重軽_分解",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// HL 分解（Heavy-Light Decomposition）。根付き木のパス/部分木を `pos` 上の連続区間に",
      "/// 落とし込み、`ac_library::Segtree` 等の区間データ構造と組み合わせて使う。構築 O(N)。",
      "/// - [`Self::パス区間`] : `u`-`v` パス（頂点モデル、LCA を含む）を半開区間 `[l, r)` の列に分解。",
      "/// - [`Self::部分木区間`] : `v` の部分木を 1 つの半開区間に。",
      "/// - [`Self::lca`] : 最近共通祖先 O(log N)。",
      "/// `pos[v]` は heavy path が連続するよう振った Euler 順位置。区間データ構造には",
      "/// `pos` 順で値を載せる。辺に値を持たせたい場合は「子頂点に辺の値を載せ、パス分解時に",
      "/// LCA を 1 つ除く」運用にする。",
      "struct 重軽分解 {",
      "    prev: Vec<usize>,",
      "    深さ: Vec<usize>,",
      "    sz: Vec<usize>,",
      "    /// `head[v]`: `v` を含む heavy path の先頭（最も浅い）頂点",
      "    head: Vec<usize>,",
      "    /// `pos[v]`: 区間データ構造上での `v` の位置",
      "    pos: Vec<usize>,",
      "}",
      "impl 重軽分解 {",
      "    /// 頂点数 `n`・辺リスト `辺`（AtCoder の入力そのまま）と根から構築する。O(N)。",
      "    fn new(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut prev = vec![!0; n];",
      "        let mut 深さ = vec![0usize; n];",
      "        let mut sz = vec![1usize; n];",
      "        let mut heavy = vec![!0; n];",
      "        let mut 順 = Vec::with_capacity(n);",
      "        let mut 探索 = vec![根];",
      "        while let Some(now) = 探索.pop() {",
      "            順.push(now);",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] {",
      "                    prev[next] = now;",
      "                    深さ[next] = 深さ[now] + 1;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        for &now in 順.iter().rev() {",
      "            let mut 最大 = 0;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] {",
      "                    sz[now] += sz[next];",
      "                    if sz[next] > 最大 {",
      "                        最大 = sz[next];",
      "                        heavy[now] = next;",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        let mut head = vec![0usize; n];",
      "        let mut pos = vec![0usize; n];",
      "        let mut 次位置 = 0usize;",
      "        let mut 探索 = vec![(根, 根)];",
      "        while let Some((now, h)) = 探索.pop() {",
      "            head[now] = h;",
      "            pos[now] = 次位置;",
      "            次位置 += 1;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] && next != heavy[now] {",
      "                    探索.push((next, next));",
      "                }",
      "            }",
      "            if heavy[now] != !0 {",
      "                探索.push((heavy[now], h));",
      "            }",
      "        }",
      "        Self {",
      "            prev,",
      "            深さ,",
      "            sz,",
      "            head,",
      "            pos,",
      "        }",
      "    }",
      "    /// 区間データ構造上の位置 `pos[v]`。",
      "    fn 位置(&self, v: usize) -> usize {",
      "        self.pos[v]",
      "    }",
      "    /// 最近共通祖先。O(log N)。",
      "    fn lca(&self, mut u: usize, mut v: usize) -> usize {",
      "        while self.head[u] != self.head[v] {",
      "            if self.深さ[self.head[u]] < self.深さ[self.head[v]] {",
      "                std::mem::swap(&mut u, &mut v);",
      "            }",
      "            u = self.prev[self.head[u]];",
      "        }",
      "        if self.深さ[u] < self.深さ[v] {",
      "            u",
      "        } else {",
      "            v",
      "        }",
      "    }",
      "    /// `u`-`v` パス上の頂点集合を、区間データ構造上の半開区間 `[l, r)` の列で返す（順不同）。",
      "    /// LCA を含む頂点モデル。区間は O(log N) 本。",
      "    fn パス区間(&self, mut u: usize, mut v: usize) -> Vec<(usize, usize)> {",
      "        let mut 区間 = Vec::new();",
      "        while self.head[u] != self.head[v] {",
      "            if self.深さ[self.head[u]] < self.深さ[self.head[v]] {",
      "                std::mem::swap(&mut u, &mut v);",
      "            }",
      "            let h = self.head[u];",
      "            区間.push((self.pos[h], self.pos[u] + 1));",
      "            u = self.prev[h];",
      "        }",
      "        let (lo, hi) = if self.pos[u] <= self.pos[v] {",
      "            (self.pos[u], self.pos[v])",
      "        } else {",
      "            (self.pos[v], self.pos[u])",
      "        };",
      "        区間.push((lo, hi + 1));",
      "        区間",
      "    }",
      "    /// `v` を根とする部分木に対応する半開区間 `[l, r)`。O(1)。",
      "    fn 部分木区間(&self, v: usize) -> (usize, usize) {",
      "        (self.pos[v], self.pos[v] + self.sz[v])",
      "    }",
      "}"
    ]
  },
  "長方形_和集合の_面積": {
    "scope": "rust",
    "prefix": "長方形_和集合の_面積",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 軸平行長方形の**和集合の面積**（重なりを 1 回だけ数えた被覆面積）を返す。各長方形は",
      "/// `(x1, y1, x2, y2)`（`x1<x2`, `y1<y2`、半開矩形 `[x1,x2)×[y1,y2)`）。`O(N log N)`。",
      "/// x 座標圧縮 + y 方向の平面走査（Klee の長方形面積アルゴリズム）。",
      "/// [`segment_intersection`](crate::segment_intersection) は線分交差、[`imos`](crate::imos) は格子の",
      "/// 一括加算で、いずれも「連続座標の和集合面積」は扱わない。",
      "fn 長方形和集合の面積(矩形: &[(i64, i64, i64, i64)]) -> i64 {",
      "    if 矩形.is_empty() {",
      "        return 0;",
      "    }",
      "    let mut xs: Vec<i64> = Vec::with_capacity(矩形.len() * 2);",
      "    for &(x1, _, x2, _) in 矩形 {",
      "        if x1 < x2 {",
      "            xs.push(x1);",
      "            xs.push(x2);",
      "        }",
      "    }",
      "    xs.sort_unstable();",
      "    xs.dedup();",
      "    let m = xs.len();",
      "    if m < 2 {",
      "        return 0;",
      "    }",
      "    let mut イベント: Vec<(i64, usize, usize, i64)> = Vec::new();",
      "    for &(x1, y1, x2, y2) in 矩形 {",
      "        if x1 >= x2 || y1 >= y2 {",
      "            continue;",
      "        }",
      "        let i1 = xs.partition_point(|&v| v < x1);",
      "        let i2 = xs.partition_point(|&v| v < x2);",
      "        イベント.push((y1, i1, i2, 1));",
      "        イベント.push((y2, i1, i2, -1));",
      "    }",
      "    if イベント.is_empty() {",
      "        return 0;",
      "    }",
      "    イベント.sort_by_key(|&(y, _, _, _)| y);",
      "    let mut seg = 面積セグ::new(xs);",
      "    let mut 面積 = 0i64;",
      "    let mut 前y = イベント[0].0;",
      "    for (y, i1, i2, d) in イベント {",
      "        面積 += seg.被覆長() * (y - 前y);",
      "        seg.更新(1, 0, m - 1, i1, i2, d);",
      "        前y = y;",
      "    }",
      "    面積",
      "}",
      "struct 面積セグ {",
      "    xs: Vec<i64>,",
      "    count: Vec<i64>,",
      "    len: Vec<i64>,",
      "}",
      "impl 面積セグ {",
      "    fn new(xs: Vec<i64>) -> Self {",
      "        let size = 4 * xs.len().max(1);",
      "        面積セグ {",
      "            xs,",
      "            count: vec![0; size],",
      "            len: vec![0; size],",
      "        }",
      "    }",
      "    fn 被覆長(&self) -> i64 {",
      "        self.len[1]",
      "    }",
      "    fn 更新(&mut self, node: usize, nl: usize, nr: usize, ql: usize, qr: usize, d: i64) {",
      "        if qr <= nl || nr <= ql {",
      "            return;",
      "        }",
      "        if ql <= nl && nr <= qr {",
      "            self.count[node] += d;",
      "        } else {",
      "            let mid = (nl + nr) / 2;",
      "            self.更新(2 * node, nl, mid, ql, qr, d);",
      "            self.更新(2 * node + 1, mid, nr, ql, qr, d);",
      "        }",
      "        self.len[node] = if self.count[node] > 0 {",
      "            self.xs[nr] - self.xs[nl]",
      "        } else if nr - nl <= 1 {",
      "            0",
      "        } else {",
      "            self.len[2 * node] + self.len[2 * node + 1]",
      "        };",
      "    }",
      "}"
    ]
  },
  "関節点": {
    "scope": "rust",
    "prefix": "関節点",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向グラフの橋（取り除くと連結成分が増える辺）と関節点（取り除くと連結成分が増える頂点）を",
      "/// lowlink で求める。構築 O(V + E)。非連結でも全成分を処理する。",
      "/// 多重辺がある場合、同じ 2 頂点を結ぶ辺が 2 本以上あればその辺は橋にならない（辺番号で区別）。",
      "/// - [`Self::橋一覧`] : 橋を `(u, v)`（u < v）の昇順で返す。",
      "/// - [`Self::関節点一覧`] : 関節点を昇順で返す。",
      "struct ローリンク {",
      "    n: usize,",
      "    グラフ: Vec<Vec<(usize, usize)>>,",
      "    辺数: usize,",
      "}",
      "/// DFS 中に使い回す作業領域。",
      "struct 作業領域 {",
      "    カウンタ: usize,",
      "    ord: Vec<i64>,",
      "    low: Vec<usize>,",
      "    橋: Vec<(usize, usize)>,",
      "    関節: Vec<bool>,",
      "}",
      "impl ローリンク {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            グラフ: vec![Vec::new(); n],",
      "            辺数: 0,",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。多重辺・自己ループも許容する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        let id = self.辺数;",
      "        self.グラフ[u].push((v, id));",
      "        self.グラフ[v].push((u, id));",
      "        self.辺数 += 1;",
      "    }",
      "    /// DFS で `ord`（行きがけ順）と `low` を計算し、橋・関節点を収集する。",
      "    fn 探索(&self, now: usize, 親辺: usize, 根か: bool, w: &mut 作業領域) {",
      "        w.ord[now] = w.カウンタ as i64;",
      "        w.low[now] = w.カウンタ;",
      "        w.カウンタ += 1;",
      "        let mut 子数 = 0usize;",
      "        let mut 関節点フラグ = false;",
      "        for &(next, 辺) in &self.グラフ[now] {",
      "            if 辺 == 親辺 {",
      "                continue;",
      "            }",
      "            if w.ord[next] == -1 {",
      "                子数 += 1;",
      "                self.探索(next, 辺, false, w);",
      "                w.low[now] = w.low[now].min(w.low[next]);",
      "                if w.low[next] > w.ord[now] as usize {",
      "                    let (a, b) = if now < next { (now, next) } else { (next, now) };",
      "                    w.橋.push((a, b));",
      "                }",
      "                if !根か && w.low[next] >= w.ord[now] as usize {",
      "                    関節点フラグ = true;",
      "                }",
      "            } else {",
      "                w.low[now] = w.low[now].min(w.ord[next] as usize);",
      "            }",
      "        }",
      "        if 根か {",
      "            if 子数 >= 2 {",
      "                w.関節[now] = true;",
      "            }",
      "        } else if 関節点フラグ {",
      "            w.関節[now] = true;",
      "        }",
      "    }",
      "    fn 計算(&self) -> (Vec<(usize, usize)>, Vec<bool>) {",
      "        let mut w = 作業領域 {",
      "            カウンタ: 0,",
      "            ord: vec![-1i64; self.n],",
      "            low: vec![0usize; self.n],",
      "            橋: Vec::new(),",
      "            関節: vec![false; self.n],",
      "        };",
      "        for s in 0..self.n {",
      "            if w.ord[s] == -1 {",
      "                self.探索(s, !0, true, &mut w);",
      "            }",
      "        }",
      "        (w.橋, w.関節)",
      "    }",
      "    /// 橋を `(u, v)`（u < v）の昇順で返す。",
      "    fn 橋一覧(&self) -> Vec<(usize, usize)> {",
      "        let (mut 橋, _) = self.計算();",
      "        橋.sort_unstable();",
      "        橋",
      "    }",
      "    /// 関節点を昇順で返す。",
      "    fn 関節点一覧(&self) -> Vec<usize> {",
      "        let (_, 関節) = self.計算();",
      "        (0..self.n).filter(|&v| 関節[v]).collect()",
      "    }",
      "}"
    ]
  },
  "陰的_Treap": {
    "scope": "rust",
    "prefix": "陰的_Treap",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 陰的 Treap（implicit treap）。配列を平衡二分木で表し、任意位置への挿入・削除、",
      "/// 区間反転、区間和、一点取得を全て O(log N) で行える。添字をキーに持たず部分木サイズで",
      "/// 位置を決める「陰的キー」方式。",
      "/// - [`Self::挿入`] / [`Self::削除`] : 位置指定の挿入・削除。",
      "/// - [`Self::反転`] : 半開区間 `[l, r)` を反転。",
      "/// - [`Self::区間和`] : 半開区間 `[l, r)` の和。",
      "/// - [`Self::取得`] : 1 要素の値。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "/// 位置ではなく値の大小で並べた集合（k 番目・順位）が欲しいなら",
      "/// [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合) を使う。",
      "struct 陰的Treap<T> {",
      "    値: Vec<T>,",
      "    優先度: Vec<u64>,",
      "    サイズ: Vec<usize>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "    左: Vec<usize>,",
      "    右: Vec<usize>,",
      "    rng: u64,",
      "    根: usize,",
      "}",
      "impl<T> 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn new() -> Self {",
      "        Self {",
      "            値: vec![T::default()],",
      "            優先度: vec![0],",
      "            サイズ: vec![0],",
      "            和: vec![T::default()],",
      "            反転: vec![false],",
      "            左: vec![0],",
      "            右: vec![0],",
      "            rng: 0x9e37_79b9_7f4a_7c15,",
      "            根: 0,",
      "        }",
      "    }",
      "    fn 乱数(&mut self) -> u64 {",
      "        let mut x = self.rng;",
      "        x ^= x << 13;",
      "        x ^= x >> 7;",
      "        x ^= x << 17;",
      "        self.rng = x;",
      "        x",
      "    }",
      "    fn 新規ノード(&mut self, 値: T) -> usize {",
      "        let p = self.乱数();",
      "        self.値.push(値);",
      "        self.優先度.push(p);",
      "        self.サイズ.push(1);",
      "        self.和.push(値);",
      "        self.反転.push(false);",
      "        self.左.push(0);",
      "        self.右.push(0);",
      "        self.値.len() - 1",
      "    }",
      "    /// 子の情報から `t` のサイズと和を再計算する。反転フラグはサイズ・和に影響しない。",
      "    fn 更新(&mut self, t: usize) {",
      "        if t == 0 {",
      "            return;",
      "        }",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.サイズ[t] = 1 + self.サイズ[l] + self.サイズ[r];",
      "        self.和[t] = self.値[t] + self.和[l] + self.和[r];",
      "    }",
      "    /// `t` に溜まった反転遅延を子へ押し下げる。",
      "    fn 伝播(&mut self, t: usize) {",
      "        if t == 0 || !self.反転[t] {",
      "            return;",
      "        }",
      "        self.反転[t] = false;",
      "        let l = self.左[t];",
      "        let r = self.右[t];",
      "        self.左[t] = r;",
      "        self.右[t] = l;",
      "        if l != 0 {",
      "            self.反転[l] ^= true;",
      "        }",
      "        if r != 0 {",
      "            self.反転[r] ^= true;",
      "        }",
      "    }",
      "    /// `t` を「左 k 要素」と「残り」に分割し、`(左根, 右根)` を返す。",
      "    fn split(&mut self, t: usize, k: usize) -> (usize, usize) {",
      "        if t == 0 {",
      "            return (0, 0);",
      "        }",
      "        self.伝播(t);",
      "        let 左サイズ = self.サイズ[self.左[t]];",
      "        if k <= 左サイズ {",
      "            let (l, r) = self.split(self.左[t], k);",
      "            self.左[t] = r;",
      "            self.更新(t);",
      "            (l, t)",
      "        } else {",
      "            let (l, r) = self.split(self.右[t], k - 左サイズ - 1);",
      "            self.右[t] = l;",
      "            self.更新(t);",
      "            (t, r)",
      "        }",
      "    }",
      "    /// 2 つの木を連結する。`l` の全要素が `r` の前に来る。",
      "    fn merge(&mut self, l: usize, r: usize) -> usize {",
      "        if l == 0 {",
      "            return r;",
      "        }",
      "        if r == 0 {",
      "            return l;",
      "        }",
      "        if self.優先度[l] > self.優先度[r] {",
      "            self.伝播(l);",
      "            let 新右 = self.merge(self.右[l], r);",
      "            self.右[l] = 新右;",
      "            self.更新(l);",
      "            l",
      "        } else {",
      "            self.伝播(r);",
      "            let 新左 = self.merge(l, self.左[r]);",
      "            self.左[r] = 新左;",
      "            self.更新(r);",
      "            r",
      "        }",
      "    }",
      "    /// 末尾に値を追加する。",
      "    fn 末尾追加(&mut self, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        self.根 = self.merge(根, 新);",
      "    }",
      "    /// 位置 `pos`（0-indexed、`pos == 長さ` で末尾）に `値` を挿入する。",
      "    fn 挿入(&mut self, pos: usize, 値: T) {",
      "        let 新 = self.新規ノード(値);",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let 左 = self.merge(l, 新);",
      "        self.根 = self.merge(左, r);",
      "    }",
      "    /// 位置 `pos`（0-indexed）の要素を削除する。",
      "    fn 削除(&mut self, pos: usize) {",
      "        let 根 = self.根;",
      "        let (l, r) = self.split(根, pos);",
      "        let (_削除, r2) = self.split(r, 1);",
      "        self.根 = self.merge(l, r2);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）を反転する。",
      "    fn 反転(&mut self, 範囲: impl std::ops::RangeBounds<usize>) {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return;",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        if b != 0 {",
      "            self.反転[b] ^= true;",
      "        }",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の和。",
      "    fn 区間和(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.長さ());",
      "        if l >= r {",
      "            return T::default();",
      "        }",
      "        let 根 = self.根;",
      "        let (a, bc) = self.split(根, l);",
      "        let (b, c) = self.split(bc, r - l);",
      "        let 結果 = self.和[b];",
      "        let 左 = self.merge(a, b);",
      "        self.根 = self.merge(左, c);",
      "        結果",
      "    }",
      "    /// 位置 `pos`（0-indexed）の値。",
      "    fn 取得(&mut self, pos: usize) -> T {",
      "        self.区間和(pos..pos + 1)",
      "    }",
      "    /// 要素数。",
      "    fn 長さ(&self) -> usize {",
      "        self.サイズ[self.根]",
      "    }",
      "}",
      "impl<T> Default for 陰的Treap<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "隣接_リスト": {
    "scope": "rust",
    "prefix": "隣接_リスト",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 辺リストから有向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺[i] = (u, v)` を `u → v` の一方向の辺として `グラフ[u]` にだけ積む。",
      "/// 逆辺が欲しい場合は `(v, u)` に読み替えてもう一度呼ぶ。",
      "fn 有向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "    }",
      "    グラフ",
      "}",
      "/// 重み付き辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺[i] = (u, v, w)` に対し `グラフ[u]` へ `(v, w)`、`グラフ[v]` へ `(u, w)` を積む。",
      "/// 重みの型 `T` は `Copy` であれば何でもよい（`i64`・`u64`・`(i64, usize)` など）。",
      "fn 重み付き無向グラフ<T: Copy>(",
      "    n: usize,",
      "    辺: &[(usize, usize, T)],",
      ") -> Vec<Vec<(usize, T)>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v, w) in 辺 {",
      "        グラフ[u].push((v, w));",
      "        グラフ[v].push((u, w));",
      "    }",
      "    グラフ",
      "}",
      "/// 重み付き辺リストから有向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺[i] = (u, v, w)` を `u → v`（重み `w`）として `グラフ[u]` にだけ積む。",
      "fn 重み付き有向グラフ<T: Copy>(",
      "    n: usize,",
      "    辺: &[(usize, usize, T)],",
      ") -> Vec<Vec<(usize, T)>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v, w) in 辺 {",
      "        グラフ[u].push((v, w));",
      "    }",
      "    グラフ",
      "}"
    ]
  },
  "集合_DP": {
    "scope": "rust",
    "prefix": "集合_DP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巡回セールスマン問題（TSP）をビット DP で解く。O(2^N · N^2)。N は 18 程度まで。",
      "/// `距離[i][j]` は i→j のコスト（有向。到達不可は十分大きい値を入れる）。",
      "/// 頂点 0 を始点に全頂点をちょうど 1 回ずつ訪れて 0 に戻る最小コストを返す。",
      "/// 巡回が作れない場合は `None`。",
      "/// 「戻らない最短ハミルトンパス」が欲しい場合は最後の `+ 距離[v][0]` を外し、",
      "/// `dp[全集合][v]` の最小をそのまま使う。",
      "#[allow(clippy::needless_range_loop)]",
      "fn 巡回セールスマン(距離: &[Vec<i64>]) -> Option<i64> {",
      "    let n = 距離.len();",
      "    if n == 0 {",
      "        return Some(0);",
      "    }",
      "    const INF: i64 = i64::MAX / 4;",
      "    let mut dp = vec![vec![INF; n]; 1 << n];",
      "    dp[1][0] = 0;",
      "    for s in 1..(1usize << n) {",
      "        for v in 0..n {",
      "            if dp[s][v] >= INF || s & (1 << v) == 0 {",
      "                continue;",
      "            }",
      "            for u in 0..n {",
      "                if s & (1 << u) != 0 {",
      "                    continue;",
      "                }",
      "                let 次 = s | (1 << u);",
      "                let コスト = dp[s][v] + 距離[v][u];",
      "                if コスト < dp[次][u] {",
      "                    dp[次][u] = コスト;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 全集合 = (1usize << n) - 1;",
      "    let 答え = (0..n)",
      "        .filter(|&v| dp[全集合][v] < INF)",
      "        .map(|v| dp[全集合][v] + 距離[v][0])",
      "        .min()",
      "        .unwrap_or(INF);",
      "    if 答え >= INF {",
      "        None",
      "    } else {",
      "        Some(答え)",
      "    }",
      "}"
    ]
  },
  "集合の_分割": {
    "scope": "rust",
    "prefix": "集合の_分割",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::ModInt as Mint;",
      "/// 第二種スターリング数 S(n, k) の表（`0..=n` 行、`0..=n` 列）を前計算して返す。O(n^2)。",
      "/// mod は `Mint`（ac_library::ModInt）のグローバル modulus。Comb は不要。",
      "/// `S(n,k)` は `n` 要素を空でない `k` 個のグループに分割する方法の数。u64 なら n ≥ 27 で溢れる。",
      "fn 第二種スターリング数表(n: usize) -> Vec<Vec<Mint>> {",
      "    let mut s = vec![vec![Mint::new(0); n + 1]; n + 1];",
      "    s[0][0] = Mint::new(1);",
      "    for i in 1..=n {",
      "        for k in 1..=i {",
      "            s[i][k] = Mint::new(k) * s[i - 1][k] + s[i - 1][k - 1];",
      "        }",
      "    }",
      "    s",
      "}"
    ]
  },
  "離散_対数": {
    "scope": "rust",
    "prefix": "離散_対数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 離散対数：`a^x ≡ b (mod m)` を満たす最小の非負整数 `x` を返す（無ければ `None`）。O(√m)。",
      "/// Baby-step Giant-step 法。`gcd(a, m) ≠ 1`（`m` が合成数で `a` と互いに素でない）でも動く",
      "/// 一般版。`a`・`b` は `mod m` 前で渡してよい。`m < 2^31` 程度を想定（乗算は u64 内で完結）。",
      "/// 例：`a^x ≡ b (mod m)` の位数計算や、巡回的な遷移の到達ステップ数を求めるのに使う。",
      "fn 離散対数(a: u64, b: u64, m: u64) -> Option<u64> {",
      "    if m == 1 {",
      "        return Some(0);",
      "    }",
      "    let a = a % m;",
      "    let mut b = b % m;",
      "    let mut m = m;",
      "    let mut k = 1u64 % m;",
      "    let mut 加算 = 0u64;",
      "    loop {",
      "        let g = num::integer::gcd(a, m);",
      "        if g <= 1 {",
      "            break;",
      "        }",
      "        if k == b {",
      "            return Some(加算);",
      "        }",
      "        if b % g != 0 {",
      "            return None;",
      "        }",
      "        b /= g;",
      "        m /= g;",
      "        k = k * (a / g) % m;",
      "        加算 += 1;",
      "    }",
      "    let n = (m as f64).sqrt() as u64 + 1;",
      "    let mut an = 1u64 % m;",
      "    for _ in 0..n {",
      "        an = an * (a % m) % m;",
      "    }",
      "    let mut テーブル: HashMap<u64, u64> = HashMap::new();",
      "    let mut cur = b % m;",
      "    for q in 0..=n {",
      "        テーブル.insert(cur, q);",
      "        cur = cur * (a % m) % m;",
      "    }",
      "    let mut cur = k;",
      "    for p in 1..=n {",
      "        cur = cur * an % m;",
      "        if let Some(&q) = テーブル.get(&cur) {",
      "            return Some(n * p - q + 加算);",
      "        }",
      "    }",
      "    None",
      "}"
    ]
  },
