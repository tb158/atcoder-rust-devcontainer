      "        Self { 前方, べき }",
      "    }",
      "    /// `a * b mod (2^61-1)` を u128 経由で計算する内部関数。",
      "    fn 積(a: u64, b: u64, 法: u64) -> u64 {",
      "        (a as u128 * b as u128 % 法 as u128) as u64",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の部分文字列のハッシュ値を返す。O(1)。",
      "    fn 区間ハッシュ(&self, 範囲: impl std::ops::RangeBounds<usize>) -> u64 {",
      "        const 法: u64 = (1 << 61) - 1;",
      "        let (l, r) = 半開(範囲, self.前方.len() - 1);",
      "        let 全体 = self.前方[r];",
      "        let 前 = Self::積(self.前方[l], self.べき[r - l], 法);",
      "        (全体 + 法 - 前) % 法",
      "    }",
      "    /// 2 つの区間（`a..b` / `a..=b` / `..` など）が表す部分文字列が等しいかを O(1) で判定する。",
      "    fn 等しい(",
      "        &self,",
      "        区間1: impl std::ops::RangeBounds<usize>,",
      "        区間2: impl std::ops::RangeBounds<usize>,",
      "    ) -> bool {",
      "        let n = self.前方.len() - 1;",
      "        let (l1, r1) = 半開(区間1, n);",
      "        let (l2, r2) = 半開(区間2, n);",
      "        (r1 - l1) == (r2 - l2) && self.区間ハッシュ(l1..r1) == self.区間ハッシュ(l2..r2)",
      "    }",
      "}"
    ]
  },
  "ロールバック_Mo": {
    "scope": "rust",
    "prefix": "ロールバック_Mo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 「追加は容易だが削除が難しい」区間クエリを扱うロールバック Mo の状態インタフェース。",
      "/// 削除の代わりに、チェックポイント [`保存`](ロールバックMo::保存) と",
      "/// [`巻き戻し`](ロールバックMo::巻き戻し) で状態を巻き戻す。区間の左側の一時追加を",
      "/// 巻き戻すことで、各左ブロック内で右ポインタを単調増加に保ったまま処理できる。",
      "/// 素の [`Mo`](crate::mo)・[更新あり Mo](crate::mo_with_updates) とは別アルゴリズム。",
      "/// 連結性（rollback 可能 union-find）や max・mode 系で使う。",
      "trait ロールバックMo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 位置 `位置` の要素を現在の集合に加える（削除は無い）。",
      "    fn 追加(&mut self, 位置: usize);",
      "    /// 現在の状態をチェックポイントとして積む。",
      "    fn 保存(&mut self);",
      "    /// 直近のチェックポイントまで状態を巻き戻す（その時点以降の追加を取り消す）。",
      "    fn 巻き戻し(&mut self);",
      "    /// 状態を空に戻す（各左ブロックの処理開始時に呼ばれる）。",
      "    fn 全消去(&mut self);",
      "    /// 現在の集合に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// ロールバック Mo 本体。`n` は要素数、`クエリ` は半開区間 `[l, r)`（`l < r`）の列。",
      "/// 全体 `O((N + Q)√N · 追加コスト)`。`状態` は空の初期状態で渡すこと。",
      "fn ロールバックmo実行<S: ロールバックMo>(",
      "    状態: &mut S,",
      "    n: usize,",
      "    クエリ: &[(usize, usize)],",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    if q == 0 {",
      "        return Vec::new();",
      "    }",
      "    let b = ((n as f64).sqrt() as usize).max(1);",
      "    let mut 順: Vec<usize> = (0..q).collect();",
      "    順.sort_by(|&x, &y| {",
      "        let (lx, rx) = クエリ[x];",
      "        let (ly, ry) = クエリ[y];",
      "        let (bx, by) = (lx / b, ly / b);",
      "        if bx != by {",
      "            bx.cmp(&by)",
      "        } else {",
      "            rx.cmp(&ry)",
      "        }",
      "    });",
      "    let mut 答え: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let mut idx = 0;",
      "    while idx < 順.len() {",
      "        let ブロック = クエリ[順[idx]].0 / b;",
      "        let r0 = ((ブロック + 1) * b).min(n);",
      "        状態.全消去();",
      "        let mut 右 = r0;",
      "        while idx < 順.len() && クエリ[順[idx]].0 / b == ブロック {",
      "            let i = 順[idx];",
      "            let (l, r) = クエリ[i];",
      "            if r <= r0 {",
      "                状態.保存();",
      "                for p in l..r {",
      "                    状態.追加(p);",
      "                }",
      "                答え[i] = Some(状態.答え());",
      "                状態.巻き戻し();",
      "                idx += 1;",
      "                continue;",
      "            }",
      "            while 右 < r {",
      "                状態.追加(右);",
      "                右 += 1;",
      "            }",
      "            状態.保存();",
      "            for p in (l..r0).rev() {",
      "                状態.追加(p);",
      "            }",
      "            答え[i] = Some(状態.答え());",
      "            状態.巻き戻し();",
      "            idx += 1;",
      "        }",
      "    }",
      "    答え.into_iter().map(|o| o.unwrap()).collect()",
      "}"
    ]
  },
  "ロールバック_UnionFind": {
    "scope": "rust",
    "prefix": "ロールバック_UnionFind",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 巻き戻し（Undo）可能な Union-Find。経路圧縮を行わずユニオン by サイズのみで結合し、",
      "/// 各結合の変更を履歴に積むことで任意時点へ `O(操作数)` で復元できる。",
      "/// `ac_library::Dsu` は経路圧縮するため undo できない。オフライン動的連結性",
      "/// （時間方向のセグメント木上の分割統治）などで「結合 → 探索 → 巻き戻し」を繰り返す用途に使う。",
      "/// `根`・`同じ`・`サイズ` は経路圧縮なしの O(log N)。",
      "struct ロールバック可能UnionFind {",
      "    /// 根なら `-(サイズ)`、非根なら親の添字。",
      "    親orサイズ: Vec<i64>,",
      "    /// `(書き換えた添字, 直前の値)` の履歴。1 回の結合で 2 件積む。",
      "    履歴: Vec<(usize, i64)>,",
      "}",
      "impl ロールバック可能UnionFind {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親orサイズ: vec![-1; n],",
      "            履歴: Vec::new(),",
      "        }",
      "    }",
      "    /// `x` の根（経路圧縮なし）。",
      "    fn 根(&self, mut x: usize) -> usize {",
      "        while self.親orサイズ[x] >= 0 {",
      "            x = self.親orサイズ[x] as usize;",
      "        }",
      "        x",
      "    }",
      "    /// `x` と `y` を結合する。既に同じ集合なら `false`（履歴は積まない）。",
      "    fn 統合(&mut self, x: usize, y: usize) -> bool {",
      "        let mut a = self.根(x);",
      "        let mut b = self.根(y);",
      "        if a == b {",
      "            return false;",
      "        }",
      "        if self.親orサイズ[a] > self.親orサイズ[b] {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        self.履歴.push((a, self.親orサイズ[a]));",
      "        self.履歴.push((b, self.親orサイズ[b]));",
      "        self.親orサイズ[a] += self.親orサイズ[b];",
      "        self.親orサイズ[b] = a as i64;",
      "        true",
      "    }",
      "    /// `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "    /// `x` の属する集合の要素数。",
      "    fn サイズ(&self, x: usize) -> usize {",
      "        let r = self.根(x);",
      "        (-self.親orサイズ[r]) as usize",
      "    }",
      "    /// 現在のスナップショット（履歴の長さ）。[`Self::ロールバック`] に渡す。",
      "    fn 現在時点(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    /// 直近の `統合` 1 回ぶんを取り消す（履歴 2 件を巻き戻す）。",
      "    fn 巻き戻し(&mut self) {",
      "        for _ in 0..2 {",
      "            if let Some((i, v)) = self.履歴.pop() {",
      "                self.親orサイズ[i] = v;",
      "            }",
      "        }",
      "    }",
      "    /// [`Self::現在時点`] で得た時点まで状態を巻き戻す。",
      "    fn ロールバック(&mut self, 時点: usize) {",
      "        while self.履歴.len() > 時点 {",
      "            let (i, v) = self.履歴.pop().unwrap();",
      "            self.親orサイズ[i] = v;",
      "        }",
      "    }",
      "}"
    ]
  },
  "一筆書き": {
    "scope": "rust",
    "prefix": "一筆書き",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 有向グラフのオイラー路（全ての辺をちょうど 1 回ずつ通る路）を Hierholzer 法で求める。",
      "/// 再帰なし、O(V + E)。",
      "/// `頂点数` は頂点数、`辺` は `(from, to)` の列。存在すれば通過頂点列（長さ `辺数 + 1`）を返し、",
      "/// 存在しなければ `None`。オイラー閉路の場合は始点と終点が一致する列になる。",
      "/// 存在条件: 辺を持つ頂点が連結で、各頂点の `出次数 - 入次数` が",
      "/// 「全て 0（閉路）」または「始点だけ +1・終点だけ -1・他 0（路）」であること。",
      "fn オイラー路_有向(頂点数: usize, 辺: &[(usize, usize)]) -> Option<Vec<usize>> {",
      "    let m = 辺.len();",
      "    if m == 0 {",
      "        return None;",
      "    }",
      "    let mut 出辺: Vec<Vec<usize>> = vec![vec![]; 頂点数];",
      "    let mut 出次数 = vec![0i64; 頂点数];",
      "    let mut 入次数 = vec![0i64; 頂点数];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        出辺[u].push(i);",
      "        出次数[u] += 1;",
      "        入次数[v] += 1;",
      "    }",
      "    let mut 始点 = !0;",
      "    let mut 始点候補数 = 0;",
      "    let mut 終点候補数 = 0;",
      "    for v in 0..頂点数 {",
      "        match 出次数[v] - 入次数[v] {",
      "            0 => {}",
      "            1 => {",
      "                始点候補数 += 1;",
      "                始点 = v;",
      "            }",
      "            -1 => 終点候補数 += 1,",
      "            _ => return None,",
      "        }",
      "    }",
      "    let 閉路 = 始点候補数 == 0 && 終点候補数 == 0;",
      "    if !(閉路 || (始点候補数 == 1 && 終点候補数 == 1)) {",
      "        return None;",
      "    }",
      "    if 始点 == !0 {",
      "        始点 = (0..頂点数).find(|&v| 出次数[v] > 0)?;",
      "    }",
      "    let mut 次に見る = vec![0usize; 頂点数];",
      "    let mut 探索 = vec![始点];",
      "    let mut 経路 = Vec::with_capacity(m + 1);",
      "    while let Some(&now) = 探索.last() {",
      "        if 次に見る[now] < 出辺[now].len() {",
      "            let e = 出辺[now][次に見る[now]];",
      "            次に見る[now] += 1;",
      "            探索.push(辺[e].1);",
      "        } else {",
      "            経路.push(now);",
      "            探索.pop();",
      "        }",
      "    }",
      "    経路.reverse();",
      "    if 経路.len() == m + 1 {",
      "        Some(経路)",
      "    } else {",
      "        None",
      "    }",
      "}"
    ]
  },
  "一般_グラフ_最大_マッチング": {
    "scope": "rust",
    "prefix": "一般_グラフ_最大_マッチング",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 一般グラフ（二部とは限らない、奇閉路を含んでよい）の最大マッチング。O(V·E)。",
      "/// 二部グラフに限るなら [`crate::hopcroft_karp`] の方が高速。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に相手も保持）。",
      "/// - [`Self::相手一覧`] : 各頂点の相手（未マッチは -1）。",
      "struct 一般マッチング {",
      "    n: usize,",
      "    辺: Vec<(usize, usize)>,",
      "    相手: Vec<i64>,",
      "}",
      "impl 一般マッチング {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            辺: Vec::new(),",
      "            相手: vec![-1; n],",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.辺.push((u, v));",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut g = petgraph::graph::UnGraph::<(), ()>::new_undirected();",
      "        let 節: Vec<petgraph::graph::NodeIndex> = (0..self.n).map(|_| g.add_node(())).collect();",
      "        for &(u, v) in &self.辺 {",
      "            g.add_edge(節[u], 節[v], ());",
      "        }",
      "        let マッチング = petgraph::algo::maximum_matching(&g);",
      "        self.相手 = vec![-1; self.n];",
      "        let mut 本数 = 0;",
      "        for (a, b) in マッチング.edges() {",
      "            self.相手[a.index()] = b.index() as i64;",
      "            self.相手[b.index()] = a.index() as i64;",
      "            本数 += 1;",
      "        }",
      "        本数",
      "    }",
      "    /// 各頂点の相手（未マッチは -1）。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn 相手一覧(&self) -> &[i64] {",
      "        &self.相手",
      "    }",
      "}"
    ]
  },
