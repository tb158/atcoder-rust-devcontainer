  "多角形": {
    "scope": "rust",
    "prefix": "多角形",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 多角形（頂点を順に並べた整数座標列）の符号付き面積の 2 倍を返す。O(N)。",
      "/// 反時計回りなら正、時計回りなら負。",
      "/// 整数座標のまま厳密に計算するため、実面積は `面積2倍(p).abs() as f64 / 2.0`。",
      "fn 符号付き面積2倍(多角形: &[(i64, i64)]) -> i64 {",
      "    let n = 多角形.len();",
      "    let mut s = 0i64;",
      "    for i in 0..n {",
      "        let (ax, ay) = 多角形[i];",
      "        let (bx, by) = 多角形[(i + 1) % n];",
      "        s += ax * by - bx * ay;",
      "    }",
      "    s",
      "}",
      "/// 点が多角形の内部・境界・外部のどれにあるかを整数演算のみで判定する。O(N)。",
      "/// `2` = 内部、`1` = 境界上、`0` = 外部。凸でない単純多角形にも使える（射影法／レイキャスティング）。",
      "fn 点の内外(多角形: &[(i64, i64)], 点: (i64, i64)) -> i32 {",
      "    let n = 多角形.len();",
      "    let (px, py) = 点;",
      "    let mut 内 = false;",
      "    for i in 0..n {",
      "        let (xi, yi) = 多角形[i];",
      "        let (xj, yj) = 多角形[(i + 1) % n];",
      "        let 外積 = (xj - xi) * (py - yi) - (yj - yi) * (px - xi);",
      "        if 外積 == 0 && (px - xi) * (px - xj) <= 0 && (py - yi) * (py - yj) <= 0 {",
      "            return 1;",
      "        }",
      "        if (yi > py) != (yj > py) {",
      "            let 左 = if yj - yi > 0 { 外積 > 0 } else { 外積 < 0 };",
      "            if 左 {",
      "                内 = !内;",
      "            }",
      "        }",
      "    }",
      "    if 内 {",
      "        2",
      "    } else {",
      "        0",
      "    }",
      "}",
      "/// 頂点列が凸多角形をなすか（同一向きに曲がり続けるか）を判定する。O(N)。",
      "/// 共線な 3 点は許容する。`n < 3` は `false`。",
      "fn 凸多角形か(多角形: &[(i64, i64)]) -> bool {",
      "    let n = 多角形.len();",
      "    if n < 3 {",
      "        return false;",
      "    }",
      "    let mut 符号 = 0i64;",
      "    for i in 0..n {",
      "        let (ax, ay) = 多角形[i];",
      "        let (bx, by) = 多角形[(i + 1) % n];",
      "        let (cx, cy) = 多角形[(i + 2) % n];",
      "        let 外積 = (bx - ax) * (cy - by) - (by - ay) * (cx - bx);",
      "        if 外積 != 0 {",
      "            let s = 外積.signum();",
      "            if 符号 == 0 {",
      "                符号 = s;",
      "            } else if 符号 != s {",
      "                return false;",
      "            }",
      "        }",
      "    }",
      "    true",
      "}",
      "/// 多角形の辺上にある格子点の個数を返す（各辺の `gcd(|dx|, |dy|)` の総和）。O(N log)。",
      "fn 境界格子点数(多角形: &[(i64, i64)]) -> i64 {",
      "    let n = 多角形.len();",
      "    let mut b = 0i64;",
      "    for i in 0..n {",
      "        let (ax, ay) = 多角形[i];",
      "        let (bx, by) = 多角形[(i + 1) % n];",
      "        b += gcd((ax - bx).abs(), (ay - by).abs());",
      "    }",
      "    b",
      "}",
      "/// ユークリッドの互除法（[`内部格子点数`] / [`境界格子点数`] 用の内部関数）。",
      "fn gcd(a: i64, b: i64) -> i64 {",
      "    if b == 0 {",
      "        a",
      "    } else {",
      "        gcd(b, a % b)",
      "    }",
      "}",
      "/// ピックの定理で多角形**内部**の格子点数 `i = A - b/2 + 1` を返す（`A` は面積、`b` は[`境界格子点数`]）。",
      "/// 整数座標の単純多角形に対して厳密。`A = 符号付き面積2倍.abs()/2`。",
      "fn 内部格子点数(多角形: &[(i64, i64)]) -> i64 {",
      "    let 面積2 = 符号付き面積2倍(多角形).abs();",
      "    let b = 境界格子点数(多角形);",
      "    (面積2 - b + 2) / 2",
      "}"
    ]
  },
  "多角形_クリップ": {
    "scope": "rust",
    "prefix": "多角形_クリップ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 凸多角形 `多角形`（反時計回り）を有向直線 `a → b` で切り、その**左側**に残る部分を返す。`O(N)`。",
      "/// Sutherland–Hodgman の片側クリップ。左側が空なら空の頂点列を返す。",
      "/// [`half_plane_intersection`](crate::half_plane_intersection) は多数の半平面の共通部分を求める別物。",
      "fn 凸多角形切断(多角形: &[点], a: 点, b: 点) -> Vec<点> {",
      "    let n = 多角形.len();",
      "    let 符号 = |p: 点| (b.0 - a.0) * (p.1 - a.1) - (b.1 - a.1) * (p.0 - a.0);",
      "    let mut 結果 = Vec::with_capacity(n + 1);",
      "    for i in 0..n {",
      "        let c = 多角形[i];",
      "        let d = 多角形[(i + 1) % n];",
      "        let fc = 符号(c);",
      "        let fd = 符号(d);",
      "        if fc >= 0.0 {",
      "            結果.push(c);",
      "        }",
      "        if fc * fd < 0.0 {",
      "            let t = fc / (fc - fd);",
      "            結果.push((c.0 + t * (d.0 - c.0), c.1 + t * (d.1 - c.1)));",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "多角形の_重心": {
    "scope": "rust",
    "prefix": "多角形の_重心",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 単純多角形（頂点を順に並べた列）の**重心**（面積の中心）を返す。面積 0 の退化形は `None`。`O(N)`。",
      "/// 頂点の単純平均ではない点に注意。[`重心`](crate::triangle_centers::重心) は三角形 3 点専用。",
      "fn 多角形の重心(多角形: &[点]) -> Option<点> {",
      "    let n = 多角形.len();",
      "    if n < 3 {",
      "        return None;",
      "    }",
      "    let mut 面積2 = 0.0f64;",
      "    let mut cx = 0.0f64;",
      "    let mut cy = 0.0f64;",
      "    for i in 0..n {",
      "        let (x0, y0) = 多角形[i];",
      "        let (x1, y1) = 多角形[(i + 1) % n];",
      "        let cross = x0 * y1 - x1 * y0;",
      "        面積2 += cross;",
      "        cx += (x0 + x1) * cross;",
      "        cy += (y0 + y1) * cross;",
      "    }",
      "    if 面積2.abs() < 1e-12 {",
      "        return None;",
      "    }",
      "    Some((cx / (3.0 * 面積2), cy / (3.0 * 面積2)))",
      "}"
    ]
  },
  "多重_文字列_検索": {
    "scope": "rust",
    "prefix": "多重_文字列_検索",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::{HashMap, VecDeque};",
      "/// Aho-Corasick 法による複数パターン同時照合。バイト列（`&[u8]`）を対象とする。",
      "/// トライ + fail リンクを構築し、テキストを 1 度走査して各パターンの**出現回数**を",
      "/// まとめて数える。重なる出現も全て数える。",
      "struct エイホコラシック {",
      "    遷移: Vec<HashMap<u8, usize>>,",
      "    fail: Vec<usize>,",
      "    bfs順: Vec<usize>,",
      "    パターン終端: Vec<usize>,",
      "}",
      "impl エイホコラシック {",
      "    /// パターン群から構築する。O(Σパターン長)。空パターンは終端＝根として扱う。",
      "    fn new(パターン群: &[&[u8]]) -> Self {",
      "        let mut 遷移: Vec<HashMap<u8, usize>> = vec![HashMap::new()];",
      "        let mut パターン終端 = vec![0usize; パターン群.len()];",
      "        for (pi, pat) in パターン群.iter().enumerate() {",
      "            let mut cur = 0usize;",
      "            for &c in *pat {",
      "                if let Some(&nx) = 遷移[cur].get(&c) {",
      "                    cur = nx;",
      "                } else {",
      "                    let 新 = 遷移.len();",
      "                    遷移.push(HashMap::new());",
      "                    遷移[cur].insert(c, 新);",
      "                    cur = 新;",
      "                }",
      "            }",
      "            パターン終端[pi] = cur;",
      "        }",
      "        let mut fail = vec![0usize; 遷移.len()];",
      "        let mut bfs順 = Vec::new();",
      "        let mut 探索 = VecDeque::new();",
      "        let 直下: Vec<usize> = 遷移[0].values().copied().collect();",
      "        for next in 直下 {",
      "            fail[next] = 0;",
      "            bfs順.push(next);",
      "            探索.push_back(next);",
      "        }",
      "        while let Some(now) = 探索.pop_front() {",
      "            let 子: Vec<(u8, usize)> = 遷移[now].iter().map(|(&c, &next)| (c, next)).collect();",
      "            for (c, next) in 子 {",
      "                let mut f = fail[now];",
      "                let nf = loop {",
      "                    if let Some(&nx) = 遷移[f].get(&c) {",
      "                        break nx;",
      "                    }",
      "                    if f == 0 {",
      "                        break 0;",
      "                    }",
      "                    f = fail[f];",
      "                };",
      "                fail[next] = nf;",
      "                bfs順.push(next);",
      "                探索.push_back(next);",
      "            }",
      "        }",
      "        Self {",
      "            遷移,",
      "            fail,",
      "            bfs順,",
      "            パターン終端,",
      "        }",
      "    }",
      "    /// 文字 `c` での遷移（fail リンクを辿るオートマトン遷移）。",
      "    fn 進む(&self, mut v: usize, c: u8) -> usize {",
      "        loop {",
      "            if let Some(&nx) = self.遷移[v].get(&c) {",
      "                return nx;",
      "            }",
      "            if v == 0 {",
      "                return 0;",
      "            }",
      "            v = self.fail[v];",
      "        }",
      "    }",
      "    /// `テキスト` 中での各パターンの出現回数を、`new` に渡した順で返す。",
      "    /// O(テキスト長 + マッチ数)。",
      "    fn 出現回数(&self, テキスト: &[u8]) -> Vec<usize> {",
      "        let mut 訪問 = vec![0usize; self.遷移.len()];",
      "        let mut v = 0usize;",
      "        for &c in テキスト {",
      "            v = self.進む(v, c);",
      "            訪問[v] += 1;",
      "        }",
      "        for &node in self.bfs順.iter().rev() {",
      "            訪問[self.fail[node]] += 訪問[node];",
      "        }",
      "        self.パターン終端.iter().map(|&node| 訪問[node]).collect()",
      "    }",
      "}"
    ]
  },
  "多項式_exp": {
    "scope": "rust",
    "prefix": "多項式_exp",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, ModInt998244353};",
      "/// 形式的冪級数（FPS）で扱う係数の型。mod 998244353（NTT フレンドリ素数）。",
      "type 係数 = ModInt998244353;",
      "/// 形式的微分。`f = Σ a_i x^i` → `Σ i·a_i x^{i-1}`。",
      "fn 微分(f: &[係数]) -> Vec<係数> {",
      "    if f.len() <= 1 {",
      "        return Vec::new();",
      "    }",
      "    (1..f.len()).map(|i| f[i] * 係数::new(i as u64)).collect()",
      "}",
      "/// 形式的積分。`f = Σ a_i x^i` → `Σ a_i/(i+1) x^{i+1}`（定数項 0）。",
      "fn 積分(f: &[係数]) -> Vec<係数> {",
      "    let mut r = vec![係数::new(0); f.len() + 1];",
      "    for (i, &c) in f.iter().enumerate() {",
      "        r[i + 1] = c * 係数::new((i + 1) as u64).inv();",
      "    }",
      "    r",
      "}",
      "/// `f * g ≡ 1 (mod x^n)` なる逆元 `g`（長さ `n`）を Newton 法で求める。O(n log n)。",
      "/// 定数項が 0 のときは逆元が存在しないので panic する。乗算には `ac_library::convolution`（NTT）を使う。",
      "fn 逆元(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        !f.is_empty() && f[0].val() != 0,",
      "        \"constant term must be nonzero\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut g = vec![f[0].inv()];",
      "    let mut k = 1;",
      "    while k < n {",
      "        k <<= 1;",
      "        let 上限 = k.min(f.len());",
      "        let mut fg = convolution(&f[..上限], &g);",
      "        fg.truncate(k);",
      "        for x in fg.iter_mut() {",
      "            *x = -*x;",
      "        }",
      "        fg[0] += 係数::new(2);",
      "        let mut ng = convolution(&g, &fg);",
      "        ng.truncate(k);",
      "        g = ng;",
      "    }",
      "    g.truncate(n);",
      "    g.resize(n, 係数::new(0));",
      "    g",
      "}",
      "/// `log f` を mod x^n で求める（長さ `n`）。定数項は 1 でなければならない。`log f = ∫ f'/f`。",
      "fn log(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        !f.is_empty() && f[0].val() == 1,",
      "        \"constant term must be 1 for log\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    if n == 1 {",
      "        return vec![係数::new(0)];",
      "    }",
      "    let fd = 微分(f);",
      "    let fi = 逆元(f, n);",
      "    let mut prod = convolution(&fd, &fi);",
      "    prod.truncate(n - 1);",
      "    let mut r = 積分(&prod);",
      "    r.truncate(n);",
      "    r.resize(n, 係数::new(0));",
      "    r",
      "}",
      "/// `exp f` を mod x^n で求める（長さ `n`）。定数項は 0 でなければならない。Newton 法で O(n log n)。",
      "fn exp(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        f.is_empty() || f[0].val() == 0,",
      "        \"constant term must be 0 for exp\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < n {",
      "        k <<= 1;",
      "        let lg = log(&g, k);",
      "        let mut h = vec![係数::new(0); k];",
      "        h[0] = 係数::new(1);",
      "        for (i, hi) in h.iter_mut().enumerate() {",
      "            *hi -= lg[i];",
      "            if i < f.len() {",
      "                *hi += f[i];",
      "            }",
      "        }",
      "        let mut ng = convolution(&g, &h);",
      "        ng.truncate(k);",
      "        g = ng;",
      "    }",
      "    g.truncate(n);",
      "    g.resize(n, 係数::new(0));",
      "    g",
      "}",
      "/// `f^m` を mod x^n で求める（長さ `n`）。最低次の非零項を括り出し `exp(m·log)` で計算する。",
      "/// `f ≡ 0` でも `m == 0` でも正しく扱う（`0^0 = 1`）。",
      "fn 累乗(f: &[係数], m: impl TryInto<u64>, n: usize) -> Vec<係数> {",
      "    let m: u64 = m.try_into().ok().expect(\"累乗: 引数が u64 に収まりません\");",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    if m == 0 {",
      "        let mut r = vec![係数::new(0); n];",
      "        r[0] = 係数::new(1);",
      "        return r;",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return vec![係数::new(0); n];",
      "    }",
      "    if (d as u128) * (m as u128) >= n as u128 {",
      "        return vec![係数::new(0); n];",
      "    }",
      "    let shift = d * (m as usize);",
      "    let len = n - shift;",
      "    let c = f[d];",
      "    let cinv = c.inv();",
      "    let g: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let lg = log(&g, len);",
      "    let mm = 係数::new(m);",
      "    let scaled: Vec<係数> = lg.iter().map(|&x| x * mm).collect();",
      "    let eg = exp(&scaled, len);",
      "    let cm = c.pow(m);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in eg.iter().enumerate() {",
      "        r[shift + i] = v * cm;",
      "    }",
      "    r",
      "}",
      "/// mod 998244353 上の平方根（Tonelli–Shanks）。`a` が平方剰余なら 1 つの解（小さい方）を `Some`、",
      "/// 非平方剰余なら `None` を返す。FPS 平方根の定数項計算に使う。`p - 1 = 2^23·119` なので確実に動く。",
      "fn 平方剰余の根(a: u64) -> Option<u64> {",
      "    const P: u64 = 998244353;",
      "    let a = a % P;",
      "    if a == 0 {",
      "        return Some(0);",
      "    }",
      "    let pw = |mut b: u64, mut e: u64| -> u64 {",
      "        let mut r = 1u64;",
      "        b %= P;",
      "        while e > 0 {",
      "            if e & 1 == 1 {",
      "                r = r * b % P;",
      "            }",
      "            b = b * b % P;",
      "            e >>= 1;",
      "        }",
      "        r",
      "    };",
      "    if pw(a, (P - 1) / 2) != 1 {",
      "        return None;",
      "    }",
      "    let mut q = P - 1;",
      "    let mut s = 0u32;",
      "    while q % 2 == 0 {",
      "        q /= 2;",
      "        s += 1;",
      "    }",
      "    let mut z = 2u64;",
      "    while pw(z, (P - 1) / 2) == 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = pw(z, q);",
      "    let mut t = pw(a, q);",
      "    let mut r = pw(a, q.div_ceil(2));",
      "    loop {",
      "        if t == 1 {",
      "            return Some(r.min(P - r));",
      "        }",
      "        let mut i = 0u32;",
      "        let mut tt = t;",
      "        while tt != 1 {",
      "            tt = tt * tt % P;",
      "            i += 1;",
      "        }",
      "        let b = pw(c, 1u64 << (m - i - 1));",
      "        m = i;",
      "        c = b * b % P;",
      "        t = t * c % P;",
      "        r = r * b % P;",
      "    }",
      "}",
      "/// `g^2 ≡ f (mod x^n)` なる平方根 `g`（長さ `n`）を Newton 法で求める。`O(n log n)`。",
      "/// 最低次の非零項の次数が奇数、または定数項が平方剰余でない場合は平方根が存在せず `None` を返す。",
      "/// `f ≡ 0` なら全 0 を返す。定数項が 1 でなくても（平方剰余であれば）扱える。",
      "fn 平方根(f: &[係数], n: usize) -> Option<Vec<係数>> {",
      "    if n == 0 {",
      "        return Some(Vec::new());",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    if d % 2 != 0 {",
      "        return None;",
      "    }",
      "    let c0 = 平方剰余の根(f[d].val() as u64)?;",
      "    let shift = d / 2;",
      "    if shift >= n {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    let len = n - shift;",
      "    let cinv = f[d].inv();",
      "    let h: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let 逆2 = 係数::new(2).inv();",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < len {",
      "        k <<= 1;",
      "        let 上限 = k.min(h.len());",
      "        let ig = 逆元(&g, k);",
      "        let mut t = convolution(&h[..上限], &ig);",
      "        t.truncate(k);",
      "        g.resize(k, 係数::new(0));",
      "        for (gi, &ti) in g.iter_mut().zip(t.iter()) {",
      "            *gi = (*gi + ti) * 逆2;",
      "        }",
      "    }",
      "    g.truncate(len);",
      "    let c = 係数::new(c0);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in g.iter().enumerate() {",
      "        r[shift + i] = v * c;",
      "    }",
      "    Some(r)",
      "}"
    ]
  },
  "多項式_log": {
    "scope": "rust",
    "prefix": "多項式_log",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, ModInt998244353};",
      "/// 形式的冪級数（FPS）で扱う係数の型。mod 998244353（NTT フレンドリ素数）。",
      "type 係数 = ModInt998244353;",
      "/// 形式的微分。`f = Σ a_i x^i` → `Σ i·a_i x^{i-1}`。",
      "fn 微分(f: &[係数]) -> Vec<係数> {",
      "    if f.len() <= 1 {",
      "        return Vec::new();",
      "    }",
      "    (1..f.len()).map(|i| f[i] * 係数::new(i as u64)).collect()",
      "}",
      "/// 形式的積分。`f = Σ a_i x^i` → `Σ a_i/(i+1) x^{i+1}`（定数項 0）。",
      "fn 積分(f: &[係数]) -> Vec<係数> {",
      "    let mut r = vec![係数::new(0); f.len() + 1];",
      "    for (i, &c) in f.iter().enumerate() {",
      "        r[i + 1] = c * 係数::new((i + 1) as u64).inv();",
      "    }",
      "    r",
      "}",
      "/// `f * g ≡ 1 (mod x^n)` なる逆元 `g`（長さ `n`）を Newton 法で求める。O(n log n)。",
