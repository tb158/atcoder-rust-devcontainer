      "        let mut x = x;",
      "        while 候補 != 0 {",
      "            let v = 候補.trailing_zeros() as usize;",
      "            let ビット = 1u64 << v;",
      "            候補 &= 候補 - 1;",
      "            self.探索(r | ビット, p & self.グラフ[v], x & self.グラフ[v], 最良);",
      "            p &= !ビット;",
      "            x |= ビット;",
      "        }",
      "    }",
      "}",
      "/// ビットマスクを立っている添字の昇順 `Vec` に変換する。",
      "fn ビット列(mut m: u64) -> Vec<usize> {",
      "    let mut v = Vec::new();",
      "    while m != 0 {",
      "        v.push(m.trailing_zeros() as usize);",
      "        m &= m - 1;",
      "    }",
      "    v",
      "}"
    ]
  },
  "最大_重み_閉包": {
    "scope": "rust",
    "prefix": "最大_重み_閉包",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最大重み閉包問題（Project Selection／いわゆる「燃やす埋める」）。",
      "/// 各要素に整数重み `w_i`（負も可）があり、「要素 `i` を選ぶなら `j` も必ず選ぶ」という依存",
      "/// （有向辺 `i→j`）が課されている。依存を満たす部分集合 `S`（`i∈S ⇒ j∈S`）のうち重み総和",
      "/// `Σ_{i∈S} w_i` を最大にするものを求める。空集合も選択可能なので答えは常に `0` 以上。",
      "/// 内部で最小カット（[`ac_library::MfGraph`] の Dinic）へ帰着する。",
      "struct 最大重み閉包 {",
      "    重み: Vec<i64>,",
      "    依存: Vec<(usize, usize)>,",
      "}",
      "impl 最大重み閉包 {",
      "    /// 各要素の重み（負も可）を与えて初期化する。",
      "    fn new(重み: Vec<i64>) -> Self {",
      "        最大重み閉包 {",
      "            重み,",
      "            依存: Vec::new(),",
      "        }",
      "    }",
      "    /// 依存「要素 `i` を選ぶなら `j` も選ぶ」を追加する。",
      "    fn 依存追加(&mut self, i: usize, j: usize) {",
      "        assert!(i < self.重み.len() && j < self.重み.len());",
      "        self.依存.push((i, j));",
      "    }",
      "    /// 最大重みと、それを達成する選択集合 `選択[i]` を返す。`O(最大流)`。",
      "    fn 解く(&self) -> (i64, Vec<bool>) {",
      "        use ac_library::MfGraph;",
      "        const INF: i64 = 1 << 60;",
      "        let n = self.重み.len();",
      "        let (源, 匯) = (n, n + 1);",
      "        let mut g = MfGraph::<i64>::new(n + 2);",
      "        let mut 正の和 = 0i64;",
      "        for (i, &w) in self.重み.iter().enumerate() {",
      "            if w > 0 {",
      "                g.add_edge(源, i, w);",
      "                正の和 += w;",
      "            } else if w < 0 {",
      "                g.add_edge(i, 匯, -w);",
      "            }",
      "        }",
      "        for &(i, j) in &self.依存 {",
      "            g.add_edge(i, j, INF);",
      "        }",
      "        let カット = g.flow(源, 匯);",
      "        let 到達 = g.min_cut(源);",
      "        let 選択 = (0..n).map(|i| 到達[i]).collect();",
      "        (正の和 - カット, 選択)",
      "    }",
      "}"
    ]
  },
  "最大_長方形": {
    "scope": "rust",
    "prefix": "最大_長方形",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ヒストグラム内に収まる最大長方形の面積を O(N) で求める（スタック法）。",
      "/// `高さ` は各列のバーの高さ。返り値は軸に平行な長方形の最大面積。",
      "/// 0/1 グリッドの「全て 1 の最大長方形」は、各行について",
      "/// 「その列まで上に連続する 1 の数」を高さ配列として行ごとにこの関数へ渡せば求まる。",
      "fn ヒストグラム最大長方形(高さ: &[i64]) -> i64 {",
      "    let mut スタック: Vec<(usize, i64)> = Vec::new();",
      "    let mut 最大 = 0i64;",
      "    for (i, &h) in 高さ.iter().enumerate() {",
      "        let mut 開始 = i;",
      "        while let Some(&(位置, 積んだ高さ)) = スタック.last() {",
      "            if 積んだ高さ <= h {",
      "                break;",
      "            }",
      "            最大 = 最大.max(積んだ高さ * (i - 位置) as i64);",
      "            開始 = 位置;",
      "            スタック.pop();",
      "        }",
      "        スタック.push((開始, h));",
      "    }",
      "    let n = 高さ.len();",
      "    for (位置, 積んだ高さ) in スタック {",
      "        最大 = 最大.max(積んだ高さ * (n - 位置) as i64);",
      "    }",
      "    最大",
      "}"
    ]
  },
  "最小_カット_木": {
    "scope": "rust",
    "prefix": "最小_カット_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::MfGraph;",
      "/// 全点対最小カット木（Gomory–Hu 木）。無向重み付きグラフの「任意の 2 頂点間の最小カット」を、",
      "/// `n-1` 本の辺からなる 1 本の木で表す。木上の `u`–`v` パスの最小辺重みが `u`–`v` の最小カットに等しい。",
      "/// `prev[i]`（`i >= 1`）はその親、`重み[i]` は辺 `(i, prev[i])` の容量（＝そのカット値）。",
      "struct 全点対最小カット木 {",
      "    /// `prev[i]` は木における頂点 `i` の親（`prev[0] = 0`）。",
      "    prev: Vec<usize>,",
      "    /// `重み[i]` は辺 `(i, prev[i])` の最小カット値（`重み[0] = 0`）。",
      "    重み: Vec<i64>,",
      "    グラフ: Vec<Vec<(usize, i64)>>,",
      "}",
      "impl 全点対最小カット木 {",
      "    /// 木上のパスの最小辺重み = 頂点 `u`, `v` 間の最小カット値を `O(n)` で返す。",
      "    fn 最小カット(&self, u: usize, v: usize) -> i64 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        let n = self.グラフ.len();",
      "        let mut 最小 = vec![i64::MAX; n];",
      "        let mut 到達済 = vec![false; n];",
      "        到達済[u] = true;",
      "        let mut 探索 = vec![u];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, w) in &self.グラフ[now] {",
      "                if !到達済[next] {",
      "                    到達済[next] = true;",
      "                    最小[next] = 最小[now].min(w);",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        最小[v]",
      "    }",
      "}",
      "/// Gusfield の簡易アルゴリズムで Gomory–Hu 木（等価フロー木）を構築する。`ac_library::MfGraph` を",
      "/// `n-1` 回呼ぶ。`辺` は `(u, v, 容量)` の無向辺（容量非負、多重辺は別々に追加、自己ループは無視）。",
      "/// 計算量は最大流 `n-1` 回ぶん。非連結なグラフでは成分間のカットは `0` になる。",
      "fn 全点対最小カット木構築(",
      "    n: usize,",
      "    辺: &[(usize, usize, i64)],",
      ") -> 全点対最小カット木 {",
      "    let mut prev = vec![0usize; n];",
      "    let mut 重み = vec![0i64; n];",
      "    for i in 1..n {",
      "        let t = prev[i];",
      "        let mut g = MfGraph::<i64>::new(n);",
      "        for &(u, v, w) in 辺 {",
      "            if u != v {",
      "                g.add_edge(u, v, w);",
      "                g.add_edge(v, u, w);",
      "            }",
      "        }",
      "        let f = g.flow(i, t);",
      "        重み[i] = f;",
      "        let 側 = g.min_cut(i);",
      "        for j in (i + 1)..n {",
      "            if 側[j] && prev[j] == t {",
      "                prev[j] = i;",
      "            }",
      "        }",
      "    }",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for i in 1..n {",
      "        グラフ[i].push((prev[i], 重み[i]));",
      "        グラフ[prev[i]].push((i, 重み[i]));",
      "    }",
      "    全点対最小カット木 {",
      "        prev, 重み, グラフ",
      "    }",
      "}"
    ]
  },
  "最小_シュタイナー_木": {
    "scope": "rust",
    "prefix": "最小_シュタイナー_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::cmp::Reverse;",
      "use std::collections::BinaryHeap;",
      "const 無限大シュタイナー: i64 = 1 << 60;",
      "/// 最小シュタイナー木。重み付き無向グラフで、指定した「端子（terminal）」をすべて連結する最小重み部分木の",
      "/// 重みを求める。端子数 `k` に対し O(3^k V + 2^k (V + E) log V) の集合 DP。辺重みは非負（内部で Dijkstra を使う）。",
      "/// 全域木（最小全域木）とは異なり、端子以外の頂点（Steiner 点）を経由してよい点が特徴。",
      "/// 端子が 0/1 個なら 0、連結できないときは [`Self::到達不可`] を返す。",
      "/// - [`Self::解く`] : 端子集合を連結する最小重み。",
      "struct 最小シュタイナー木 {",
      "    n: usize,",
      "    グラフ: Vec<Vec<(usize, i64)>>,",
      "}",
      "impl 最小シュタイナー木 {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            グラフ: vec![Vec::new(); n],",
      "        }",
      "    }",
      "    /// 重み `w`（非負）の無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize, w: impl TryInto<i64>) {",
      "        let w = to_i64(w);",
      "        self.グラフ[u].push((v, w));",
      "        self.グラフ[v].push((u, w));",
      "    }",
      "    /// 連結できないことを表す番兵値。",
      "    fn 到達不可() -> i64 {",
      "        無限大シュタイナー",
      "    }",
      "    /// 端子集合をすべて連結する最小重み部分木の総重みを返す。",
      "    fn 解く(&self, 端子: &[usize]) -> i64 {",
      "        let k = 端子.len();",
      "        if k <= 1 {",
      "            return 0;",
      "        }",
      "        let 全 = 1usize << k;",
      "        let mut dp = vec![vec![無限大シュタイナー; self.n]; 全];",
      "        for (i, &t) in 端子.iter().enumerate() {",
      "            dp[1 << i][t] = 0;",
      "        }",
      "        for mask in 1..全 {",
      "            let mut sub = (mask - 1) & mask;",
      "            while sub > 0 {",
      "                let 他 = mask ^ sub;",
      "                for v in 0..self.n {",
      "                    let 候補 = dp[sub][v].saturating_add(dp[他][v]);",
      "                    if 候補 < dp[mask][v] {",
      "                        dp[mask][v] = 候補;",
      "                    }",
      "                }",
      "                sub = (sub - 1) & mask;",
      "            }",
      "            let mut ヒープ = BinaryHeap::new();",
      "            for (v, &d) in dp[mask].iter().enumerate() {",
      "                if d < 無限大シュタイナー {",
      "                    ヒープ.push((Reverse(d), v));",
      "                }",
      "            }",
      "            while let Some((Reverse(d), now)) = ヒープ.pop() {",
      "                if d > dp[mask][now] {",
      "                    continue;",
      "                }",
      "                for &(next, w) in &self.グラフ[now] {",
      "                    if dp[mask][now] + w < dp[mask][next] {",
      "                        dp[mask][next] = dp[mask][now] + w;",
      "                        ヒープ.push((Reverse(dp[mask][next]), next));",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        dp[全 - 1].iter().copied().min().unwrap()",
      "    }",
      "}"
    ]
  },
  "最小_パス_被覆": {
    "scope": "rust",
    "prefix": "最小_パス_被覆",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::VecDeque;",
      "/// Hopcroft-Karp 法による二部グラフの最大マッチング。O(E√V)。",
      "/// `ac_library::MaxFlow` でも最大二部マッチングは解けるが、こちらは二部マッチング専用で",
      "/// E√V と高速。`pathfinding::kuhn_munkres` は重み付き割当専用なので、",
      "/// 単純な最大本数マッチングにはこちらを使う。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に対応も保持）。",
      "/// - [`Self::マッチング`] : マッチした `(左, 右)` の組を返す。",
      "struct ホップクロフトカープ {",
      "    左数: usize,",
      "    グラフ: Vec<Vec<usize>>,",
      "    左相手: Vec<i64>,",
      "    右相手: Vec<i64>,",
      "    距離: Vec<i64>,",
      "}",
      "impl ホップクロフトカープ {",
      "    /// 左頂点 `左数` 個・右頂点 `右数` 個の二部グラフを作る。",
      "    fn new(左数: usize, 右数: usize) -> Self {",
      "        Self {",
      "            左数,",
      "            グラフ: vec![Vec::new(); 左数],",
      "            左相手: vec![-1; 左数],",
      "            右相手: vec![-1; 右数],",
      "            距離: vec![-1; 左数],",
      "        }",
      "    }",
      "    /// 左頂点 `u` と右頂点 `v` を結ぶ辺を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.グラフ[u].push(v);",
      "    }",
      "    /// 未マッチ左頂点から BFS して層（距離）を作る。増加道が存在すれば true。",
      "    fn bfs(&mut self) -> bool {",
      "        let mut 探索 = VecDeque::new();",
      "        for u in 0..self.左数 {",
      "            if self.左相手[u] < 0 {",
      "                self.距離[u] = 0;",
      "                探索.push_back(u);",
      "            } else {",
      "                self.距離[u] = -1;",
      "            }",
      "        }",
      "        let mut 増加道あり = false;",
      "        while let Some(u) = 探索.pop_front() {",
      "            for i in 0..self.グラフ[u].len() {",
      "                let v = self.グラフ[u][i];",
      "                let w = self.右相手[v];",
      "                if w < 0 {",
      "                    増加道あり = true;",
      "                } else {",
      "                    let w = w as usize;",
      "                    if self.距離[w] < 0 {",
      "                        self.距離[w] = self.距離[u] + 1;",
      "                        探索.push_back(w);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        増加道あり",
      "    }",
      "    /// 層に沿って `u` から増加道を探し、見つかれば反転して true。",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn dfs(&mut self, u: usize) -> bool {",
      "        for i in 0..self.グラフ[u].len() {",
      "            let v = self.グラフ[u][i];",
      "            let w = self.右相手[v];",
      "            let 進める =",
      "                w < 0 || (self.距離[w as usize] == self.距離[u] + 1 && self.dfs(w as usize));",
      "            if 進める {",
      "                self.左相手[u] = v as i64;",
      "                self.右相手[v] = u as i64;",
      "                return true;",
      "            }",
      "        }",
      "        self.距離[u] = -1;",
      "        false",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut 本数 = 0;",
      "        while self.bfs() {",
      "            for u in 0..self.左数 {",
      "                if self.左相手[u] < 0 && self.dfs(u) {",
      "                    本数 += 1;",
      "                }",
      "            }",
      "        }",
      "        本数",
      "    }",
      "    /// マッチした `(左, 右)` の組を返す。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn マッチング(&self) -> Vec<(usize, usize)> {",
      "        (0..self.左数)",
      "            .filter(|&u| self.左相手[u] >= 0)",
      "            .map(|u| (u, self.左相手[u] as usize))",
      "            .collect()",
      "    }",
      "}",
      "/// DAG（閉路のない有向グラフ）の**頂点素な最小パス被覆**を求める。すべての頂点をちょうど 1 本の",
      "/// 有向パスに含めるとき、必要なパスの最小本数と、その実際のパス列を返す。`O(E√V)`（二部マッチング）。",
      "/// 半順序の比較可能対を辺にすれば、最小パス被覆数は**最大反鎖**の大きさに等しい（Dilworth の定理）。",
      "/// [`hopcroft_karp`](crate::hopcroft_karp) は素のマッチング、本関数はその DAG パス被覆への応用。",
      "/// 入力に閉路があると正しい結果を保証しない（事前にトポロジカル性を仮定）。",
      "fn dag最小パス被覆(頂点数: usize, 辺: &[(usize, usize)]) -> (usize, Vec<Vec<usize>>) {",
      "    let mut hk = ホップクロフトカープ::new(頂点数, 頂点数);",
      "    for &(u, v) in 辺 {",
      "        hk.辺追加(u, v);",
      "    }",
      "    let m = hk.最大マッチング();",
      "    let mut next = vec![!0; 頂点数];",
      "    let mut prev = vec![!0; 頂点数];",
      "    for (u, v) in hk.マッチング() {",
      "        next[u] = v;",
      "        prev[v] = u;",
      "    }",
      "    let mut パス = Vec::new();",
      "    for (s, &prev_s) in prev.iter().enumerate() {",
      "        if prev_s == !0 {",
      "            let mut p = Vec::new();",
      "            let mut now = s;",
      "            while now != !0 {",
      "                p.push(now);",
      "                now = next[now];",
      "            }",
      "            パス.push(p);",
      "        }",
      "    }",
      "    (頂点数 - m, パス)",
      "}"
    ]
  },
  "最小_全域_有向木": {
    "scope": "rust",
    "prefix": "最小_全域_有向木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最小有向全域木（最小全域内向木 / arborescence）の総コストを Chu-Liu/Edmonds 法で求める。",
      "/// 根から全頂点へ到達する有向木のうちコスト最小のもの。O(V·E)。",
      "/// `辺` は `(始点, 終点, コスト)`。根から到達できない頂点があれば `None`。",
      "/// petgraph の `min_spanning_tree` は無向専用なので、有向版が要るときはこれを使う。",
      "fn 最小有向全域木(頂点数: usize, 根: usize, 辺: &[(usize, usize, i64)]) -> Option<i64> {",
      "    const 無限: i64 = i64::MAX;",
      "    let mut n = 頂点数;",
      "    let mut 根 = 根;",
      "    let mut 辺: Vec<(usize, usize, i64)> = 辺.to_vec();",
      "    let mut 合計 = 0i64;",
      "    loop {",
      "        let mut 入コスト = vec![無限; n];",
      "        let mut 入元 = vec![!0; n];",
      "        for &(u, v, w) in &辺 {",
      "            if u != v && w < 入コスト[v] {",
      "                入コスト[v] = w;",
      "                入元[v] = u;",
      "            }",
      "        }",
      "        for (v, &c) in 入コスト.iter().enumerate() {",
      "            if v != 根 && c == 無限 {",
      "                return None;",
      "            }",
      "        }",
      "        let mut id = vec![!0; n];",
      "        let mut 到達済 = vec![!0; n];",
      "        let mut 閉路数 = 0usize;",
      "        #[allow(clippy::needless_range_loop)]",
      "        for v in 0..n {",
      "            if v == 根 {",
      "                continue;",
      "            }",
      "            合計 += 入コスト[v];",
      "            let mut u = v;",
      "            while 到達済[u] != v && id[u] == !0 && u != 根 {",
      "                到達済[u] = v;",
      "                u = 入元[u];",
      "            }",
      "            if u != 根 && id[u] == !0 {",
      "                let mut x = 入元[u];",
      "                while x != u {",
      "                    id[x] = 閉路数;",
      "                    x = 入元[x];",
      "                }",
      "                id[u] = 閉路数;",
      "                閉路数 += 1;",
      "            }",
      "        }",
      "        if 閉路数 == 0 {",
      "            return Some(合計);",
      "        }",
      "        for x in id.iter_mut() {",
      "            if *x == !0 {",
      "                *x = 閉路数;",
      "                閉路数 += 1;",
      "            }",
      "        }",
      "        let mut 新辺 = Vec::new();",
      "        for &(u, v, w) in &辺 {",
      "            if id[u] != id[v] {",
      "                新辺.push((id[u], id[v], w - 入コスト[v]));",
      "            }",
      "        }",
      "        辺 = 新辺;",
      "        n = 閉路数;",
      "        根 = id[根];",
      "    }",
      "}"
    ]
