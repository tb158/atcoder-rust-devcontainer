      "    const P: u64 = 998244353;",
      "    let a = a % P;",
      "    if a == 0 {",
      "        return Some(0);",
      "    }",
      "    let pw = |mut b: u64, mut e: u64| -> u64 {",
      "        let mut r = 1u64;",
      "        b %= P;",
      "        while e > 0 {",
      "            if e & 1 == 1 {",
      "                r = r * b % P;",
      "            }",
      "            b = b * b % P;",
      "            e >>= 1;",
      "        }",
      "        r",
      "    };",
      "    if pw(a, (P - 1) / 2) != 1 {",
      "        return None;",
      "    }",
      "    let mut q = P - 1;",
      "    let mut s = 0u32;",
      "    while q % 2 == 0 {",
      "        q /= 2;",
      "        s += 1;",
      "    }",
      "    let mut z = 2u64;",
      "    while pw(z, (P - 1) / 2) == 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = pw(z, q);",
      "    let mut t = pw(a, q);",
      "    let mut r = pw(a, q.div_ceil(2));",
      "    loop {",
      "        if t == 1 {",
      "            return Some(r.min(P - r));",
      "        }",
      "        let mut i = 0u32;",
      "        let mut tt = t;",
      "        while tt != 1 {",
      "            tt = tt * tt % P;",
      "            i += 1;",
      "        }",
      "        let b = pw(c, 1u64 << (m - i - 1));",
      "        m = i;",
      "        c = b * b % P;",
      "        t = t * c % P;",
      "        r = r * b % P;",
      "    }",
      "}",
      "/// `g^2 ≡ f (mod x^n)` なる平方根 `g`（長さ `n`）を Newton 法で求める。`O(n log n)`。",
      "/// 最低次の非零項の次数が奇数、または定数項が平方剰余でない場合は平方根が存在せず `None` を返す。",
      "/// `f ≡ 0` なら全 0 を返す。定数項が 1 でなくても（平方剰余であれば）扱える。",
      "fn 平方根(f: &[係数], n: usize) -> Option<Vec<係数>> {",
      "    if n == 0 {",
      "        return Some(Vec::new());",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    if d % 2 != 0 {",
      "        return None;",
      "    }",
      "    let c0 = 平方剰余の根(f[d].val() as u64)?;",
      "    let shift = d / 2;",
      "    if shift >= n {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    let len = n - shift;",
      "    let cinv = f[d].inv();",
      "    let h: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let 逆2 = 係数::new(2).inv();",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < len {",
      "        k <<= 1;",
      "        let 上限 = k.min(h.len());",
      "        let ig = 逆元(&g, k);",
      "        let mut t = convolution(&h[..上限], &ig);",
      "        t.truncate(k);",
      "        g.resize(k, 係数::new(0));",
      "        for (gi, &ti) in g.iter_mut().zip(t.iter()) {",
      "            *gi = (*gi + ti) * 逆2;",
      "        }",
      "    }",
      "    g.truncate(len);",
      "    let c = 係数::new(c0);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in g.iter().enumerate() {",
      "        r[shift + i] = v * c;",
      "    }",
      "    Some(r)",
      "}"
