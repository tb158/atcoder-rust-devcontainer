      "}",
      "/// 木の重心を求める（再帰なし）。重心とは、その頂点を取り除いたとき残る",
      "/// 各連結成分の最大サイズが `n/2` 以下になる頂点。木の重心は 1 個か 2 個ある。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対）。戻り値は重心の頂点番号（昇順、長さ 1 か 2）。",
      "/// 重心を分割の基準に使うと、各部分木サイズが半分以下に抑えられる（重心分解の核）。",
      "/// 離心数最小の「中心」は別物で [`木の中心`](crate::tree_diameter::木の中心) を使う。",
      "fn 木の重心(n: usize, 辺: &[(usize, usize)]) -> Vec<usize> {",
      "    if n <= 1 {",
      "        return (0..n).collect();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut prev = vec![!0; n];",
      "    let mut 順 = Vec::with_capacity(n);",
      "    let mut 到達済 = vec![false; n];",
      "    let mut 探索 = vec![0usize];",
      "    到達済[0] = true;",
      "    while let Some(now) = 探索.pop() {",
      "        順.push(now);",
      "        for &next in &グラフ[now] {",
      "            if !到達済[next] {",
      "                到達済[next] = true;",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let mut sz = vec![1usize; n];",
      "    for &now in 順.iter().rev() {",
      "        if prev[now] != !0 {",
      "            sz[prev[now]] += sz[now];",
      "        }",
      "    }",
      "    let mut 重心 = Vec::new();",
      "    for now in 0..n {",
      "        let mut 最大成分 = n - sz[now];",
      "        for &next in &グラフ[now] {",
      "            if prev[next] == now {",
      "                最大成分 = 最大成分.max(sz[next]);",
      "            }",
      "        }",
      "        if 最大成分 <= n / 2 {",
      "            重心.push(now);",
      "        }",
      "    }",
      "    重心",
      "}"
    ]
  },
  "木上_Mo": {
    "scope": "rust",
    "prefix": "木上_Mo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木のパスクエリ（頂点 `u`-`v` 間の単純パス上の集計）を扱う Mo の状態インタフェース。",
      "/// オイラーツアー上の位置を出入りさせると、ある頂点はパス上にあるとき区間内にちょうど 1 回現れる。",
      "/// ランナーがその「出現回数の偶奇」を管理し、パスに入る頂点で [`追加`](木Mo::追加)、",
      "/// 出る頂点で [`削除`](木Mo::削除) を呼ぶ。状態は集合への頂点の出入りだけ実装すればよい。",
      "/// 列に対する素の [`Mo`](crate::mo) とは別技法。",
      "trait 木Mo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 頂点 `頂点` を現在の集合に加える。",
      "    fn 追加(&mut self, 頂点: usize);",
      "    /// 頂点 `頂点` を現在の集合から取り除く。",
      "    fn 削除(&mut self, 頂点: usize);",
      "    /// 現在の集合に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// 木上の Mo 本体。`n` は頂点数、`辺` は AtCoder の入力そのまま（0-indexed の頂点対）、",
      "/// `根` は根、`クエリ` は `(u, v)`（u-v パス）の列。",
      "/// 全体 `O((N + Q)√N · 更新コスト)`。`状態` は空集合の初期状態で渡すこと。",
      "fn 木上mo実行<S: 木Mo>(",
      "    n: usize,",
      "    辺: &[(usize, usize)],",
      "    根: usize,",
      "    クエリ: &[(usize, usize)],",
      "    状態: &mut S,",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    if q == 0 {",
      "        return Vec::new();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut st = vec![0usize; n];",
      "    let mut en = vec![0usize; n];",
      "    let mut 順 = Vec::with_capacity(2 * n);",
      "    let mut depth = vec![0usize; n];",
      "    let mut prev = vec![!0; n];",
      "    let mut 時刻 = 0usize;",
      "    let mut 探索 = vec![根];",
      "    while let Some(now) = 探索.pop() {",
      "        if now >= n {",
      "            let now = !now;",
      "            en[now] = 時刻;",
      "            順.push(now);",
      "            時刻 += 1;",
      "            continue;",
      "        }",
      "        depth[now] = if prev[now] == !0 {",
      "            0",
      "        } else {",
      "            depth[prev[now]] + 1",
      "        };",
      "        st[now] = 時刻;",
      "        順.push(now);",
      "        時刻 += 1;",
      "        探索.push(!now);",
      "        for &next in &グラフ[now] {",
      "            if next != prev[now] {",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let log = (usize::BITS - n.leading_zeros()).max(1) as usize;",
      "    let mut up = vec![vec![!0; n]; log];",
      "    up[0].copy_from_slice(&prev);",
      "    for k in 1..log {",
      "        for v in 0..n {",
      "            let m = up[k - 1][v];",
      "            up[k][v] = if m == !0 { !0 } else { up[k - 1][m] };",
      "        }",
      "    }",
      "    let lca = |mut u: usize, mut v: usize| -> usize {",
      "        if depth[u] < depth[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = depth[u] - depth[v];",
      "        for (k, 上) in up.iter().enumerate() {",
      "            if 差 >> k & 1 == 1 {",
      "                u = 上[u];",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for 上 in up.iter().rev() {",
      "            if 上[u] != 上[v] {",
      "                u = 上[u];",
      "                v = 上[v];",
      "            }",
      "        }",
      "        prev[u]",
      "    };",
      "    let mut 区間: Vec<(usize, usize, Option<usize>, usize)> = Vec::with_capacity(q);",
      "    for (qi, &(mut u, mut v)) in クエリ.iter().enumerate() {",
      "        if st[u] > st[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let l = lca(u, v);",
      "        if l == u {",
      "            区間.push((st[u], st[v] + 1, None, qi));",
      "        } else {",
      "            区間.push((en[u], st[v] + 1, Some(l), qi));",
      "        }",
      "    }",
      "    let b = ((2 * n) as f64).sqrt() as usize + 1;",
      "    区間.sort_by(|x, y| {",
      "        let (bx, by) = (x.0 / b, y.0 / b);",
      "        if bx != by {",
      "            bx.cmp(&by)",
      "        } else if bx % 2 == 0 {",
      "            x.1.cmp(&y.1)",
      "        } else {",
      "            y.1.cmp(&x.1)",
      "        }",
      "    });",
      "    let mut 使用中 = vec![false; n];",
      "    let mut 出力: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let (mut cl, mut cr) = (0usize, 0usize);",
      "    for &(l, r, extra, qi) in &区間 {",
      "        while cr < r {",
      "            let v = 順[cr];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            let v = 順[cl];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            let v = 順[cr];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "        }",
      "        while cl < l {",
      "            let v = 順[cl];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "            cl += 1;",
      "        }",
      "        出力[qi] = Some(match extra {",
      "            Some(w) => {",
      "                状態.追加(w);",
      "                let a = 状態.答え();",
      "                状態.削除(w);",
      "                a",
      "            }",
      "            None => 状態.答え(),",
      "        });",
      "    }",
      "    出力.into_iter().map(|o| o.unwrap()).collect()",
      "}"
    ]
  },
  "李超木": {
    "scope": "rust",
    "prefix": "李超木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Li Chao 木（最小クエリ版）。直線 `y = 傾き·x + 切片` を **任意の順序** で追加でき、",
      "/// あらかじめ与えたクエリ座標群の各点での最小値を O(log) で求める。",
      "/// CHT（[`crate::convex_hull_trick`]）と違い傾きの単調性を要求しない。",
      "/// クエリ座標は `new` に渡したものに限る。最大値が欲しいときは傾き・切片の符号を",
      "/// 反転して入れ、結果を反転する（この実装は直線のみ、線分追加は非対応）。",
      "/// 評価は i64 素のまま行うので `傾き·x + 切片` が i64 に収まる範囲で使うこと。",
      "struct 李超木 {",
      "    xs: Vec<i64>,",
      "    直線: Vec<Option<(i64, i64)>>,",
      "}",
      "impl 李超木 {",
      "    /// クエリで使う x 座標を全て渡して構築する（重複・未ソートで可）。",
      "    /// 座標は任意の整数型の Vec / イテレータでよい（各メソッドの引数も同様）。",
      "    fn new<I>(座標群: I) -> Self",
      "    where",
      "        I: IntoIterator,",
      "        I::Item: TryInto<i64>,",
      "    {",
      "        let mut 座標群: Vec<i64> = 座標群.into_iter().map(to_i64).collect();",
      "        座標群.sort_unstable();",
      "        座標群.dedup();",
      "        if 座標群.is_empty() {",
      "            座標群.push(0);",
      "        }",
      "        let n = 座標群.len();",
      "        Self {",
      "            xs: 座標群,",
      "            直線: vec![None; 4 * n],",
      "        }",
      "    }",
      "    fn 評価(直線: (i64, i64), x: i64) -> i64 {",
      "        直線.0 * x + 直線.1",
      "    }",
      "    /// 直線 `y = 傾き·x + 切片` を追加する。",
      "    fn 直線追加(&mut self, 傾き: impl TryInto<i64>, 切片: impl TryInto<i64>) {",
      "        let n = self.xs.len();",
      "        self.追加内部(1, 0, n, (to_i64(傾き), to_i64(切片)));",
      "    }",
      "    fn 追加内部(&mut self, ノード: usize, lo: usize, hi: usize, mut 新規: (i64, i64)) {",
      "        let m = (lo + hi) / 2;",
      "        let Some(mut 現在) = self.直線[ノード] else {",
      "            self.直線[ノード] = Some(新規);",
      "            return;",
      "        };",
      "        if Self::評価(新規, self.xs[m]) < Self::評価(現在, self.xs[m]) {",
      "            std::mem::swap(&mut 新規, &mut 現在);",
      "            self.直線[ノード] = Some(現在);",
      "        }",
      "        if hi - lo == 1 {",
      "            return;",
      "        }",
      "        if Self::評価(新規, self.xs[lo]) < Self::評価(現在, self.xs[lo]) {",
      "            self.追加内部(2 * ノード, lo, m, 新規);",
      "        } else {",
      "            self.追加内部(2 * ノード + 1, m, hi, 新規);",
      "        }",
      "    }",
      "    /// クエリ座標 `x`（`new` に渡した値のいずれか）における最小値。",
      "    fn 最小値(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        let n = self.xs.len();",
      "        let idx = self.xs.partition_point(|&v| v < x);",
      "        debug_assert!(",
      "            idx < n && self.xs[idx] == x,",
      "            \"李超木: 未登録のクエリ座標 {x}\"",
      "        );",
      "        self.問い合わせ内部(1, 0, n, idx)",
      "    }",
      "    fn 問い合わせ内部(&self, ノード: usize, lo: usize, hi: usize, idx: usize) -> i64 {",
      "        let mut 最小 = self.直線[ノード]",
      "            .map(|l| Self::評価(l, self.xs[idx]))",
      "            .unwrap_or(i64::MAX);",
      "        if hi - lo > 1 {",
      "            let m = (lo + hi) / 2;",
      "            if idx < m {",
      "                最小 = 最小.min(self.問い合わせ内部(2 * ノード, lo, m, idx));",
      "            } else {",
      "                最小 = 最小.min(self.問い合わせ内部(2 * ノード + 1, m, hi, idx));",
      "            }",
      "        }",
      "        最小",
      "    }",
      "}"
    ]
  },
  "根付き木の_正準化": {
    "scope": "rust",
    "prefix": "根付き木の_正準化",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "use std::collections::HashMap;",
      "/// 木の同型判定（AHU アルゴリズムによる正準ラベル付け）。子の正準ラベルを整列して",
      "/// 共有辞書で番号付けすることで、衝突のない正準ラベルを与える。構築は木 1 本あたり O(N log N)。",
      "/// 木は `(頂点数, 辺リスト)` で渡す。`辺` は AtCoder の入力そのまま（0-indexed の頂点対）。",
      "/// 同じ [`木の正準化`] インスタンスへ複数の木を渡し、返り値のラベルが等しいかで同型を判定する。",
      "/// ハッシュではなく辞書による完全一致なので誤判定しない。",
      "/// - [`Self::根付きラベル`] : 根を固定した木の正準ラベル。",
      "/// - [`Self::無向ラベル`] : 根を持たない木の正準ラベル（重心で根付ける）。",
      "struct 木の正準化 {",
      "    辞書: HashMap<Vec<u64>, u64>,",
      "    次の番号: u64,",
      "}",
      "impl 木の正準化 {",
      "    fn new() -> Self {",
      "        Self {",
      "            辞書: HashMap::new(),",
      "            次の番号: 0,",
      "        }",
      "    }",
      "    /// 子ラベル列に対応する番号を引く（無ければ採番）。",
      "    fn 登録(&mut self, mut 子ラベル: Vec<u64>) -> u64 {",
      "        子ラベル.sort_unstable();",
      "        if let Some(&id) = self.辞書.get(&子ラベル) {",
      "            return id;",
      "        }",
      "        let id = self.次の番号;",
      "        self.次の番号 += 1;",
      "        self.辞書.insert(子ラベル, id);",
      "        id",
      "    }",
      "    fn 探索(&mut self, グラフ: &[Vec<usize>], now: usize, prev: usize) -> u64 {",
      "        let mut 子ラベル = Vec::new();",
      "        for &next in &グラフ[now] {",
      "            if next != prev {",
      "                子ラベル.push(self.探索(グラフ, next, now));",
      "            }",
      "        }",
      "        self.登録(子ラベル)",
      "    }",
      "    /// 根 `根` を固定した木の正準ラベルを返す。",
      "    fn 根付きラベル(&mut self, n: usize, 辺: &[(usize, usize)], 根: usize) -> u64 {",
      "        self.探索(&無向グラフ(n, 辺), 根, !0)",
      "    }",
      "    /// 根を持たない木の正準ラベル。重心（1 個または 2 個）で根付けたラベルを束ねる。",
      "    fn 無向ラベル(&mut self, n: usize, 辺: &[(usize, usize)]) -> u64 {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let 重心 = 重心列(&グラフ);",
      "        let ラベル: Vec<u64> = 重心.iter().map(|&c| self.探索(&グラフ, c, !0)).collect();",
      "        self.登録(ラベル)",
      "    }",
      "    /// 2 つの根付き木が同型か。",
      "    fn 根付き同型(",
      "        &mut self,",
      "        na: usize,",
      "        辺a: &[(usize, usize)],",
      "        根a: usize,",
      "        nb: usize,",
      "        辺b: &[(usize, usize)],",
      "        根b: usize,",
      "    ) -> bool {",
      "        self.根付きラベル(na, 辺a, 根a) == self.根付きラベル(nb, 辺b, 根b)",
      "    }",
      "    /// 2 つの無向木が同型か。",
      "    fn 無向同型(",
      "        &mut self,",
      "        na: usize,",
      "        辺a: &[(usize, usize)],",
      "        nb: usize,",
      "        辺b: &[(usize, usize)],",
      "    ) -> bool {",
      "        na == nb && self.無向ラベル(na, 辺a) == self.無向ラベル(nb, 辺b)",
      "    }",
      "}",
      "impl Default for 木の正準化 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "/// 木の重心（最大部分木が N/2 以下になる頂点）を求める。1 個または 2 個。",
      "fn 重心列(グラフ: &[Vec<usize>]) -> Vec<usize> {",
      "    let n = グラフ.len();",
      "    let mut sz = vec![0usize; n];",
      "    let mut 重心 = Vec::new();",
      "    fn dfs(",
      "        now: usize,",
      "        prev: usize,",
      "        n: usize,",
      "        グラフ: &[Vec<usize>],",
      "        sz: &mut [usize],",
      "        重心: &mut Vec<usize>,",
      "    ) {",
      "        sz[now] = 1;",
      "        let mut 最大 = 0;",
      "        for &next in &グラフ[now] {",
      "            if next == prev {",
      "                continue;",
      "            }",
      "            dfs(next, now, n, グラフ, sz, 重心);",
      "            sz[now] += sz[next];",
      "            最大 = 最大.max(sz[next]);",
      "        }",
      "        最大 = 最大.max(n - sz[now]);",
      "        if 最大 * 2 <= n {",
      "            重心.push(now);",
      "        }",
      "    }",
      "    dfs(0, !0, n, グラフ, &mut sz, &mut 重心);",
      "    重心",
      "}"
    ]
  },
  "格子点": {
    "scope": "rust",
    "prefix": "格子点",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 多角形（頂点を順に並べた整数座標列）の符号付き面積の 2 倍を返す。O(N)。",
      "/// 反時計回りなら正、時計回りなら負。",
      "/// 整数座標のまま厳密に計算するため、実面積は `面積2倍(p).abs() as f64 / 2.0`。",
      "fn 符号付き面積2倍(多角形: &[(i64, i64)]) -> i64 {",
      "    let n = 多角形.len();",
      "    let mut s = 0i64;",
      "    for i in 0..n {",
      "        let (ax, ay) = 多角形[i];",
      "        let (bx, by) = 多角形[(i + 1) % n];",
      "        s += ax * by - bx * ay;",
      "    }",
      "    s",
      "}",
      "/// 多角形の辺上にある格子点の個数を返す（各辺の `gcd(|dx|, |dy|)` の総和）。O(N log)。",
      "fn 境界格子点数(多角形: &[(i64, i64)]) -> i64 {",
      "    let n = 多角形.len();",
      "    let mut b = 0i64;",
      "    for i in 0..n {",
      "        let (ax, ay) = 多角形[i];",
      "        let (bx, by) = 多角形[(i + 1) % n];",
      "        b += gcd((ax - bx).abs(), (ay - by).abs());",
      "    }",
      "    b",
      "}",
      "/// ユークリッドの互除法（[`内部格子点数`] / [`境界格子点数`] 用の内部関数）。",
      "fn gcd(a: i64, b: i64) -> i64 {",
      "    if b == 0 {",
      "        a",
      "    } else {",
      "        gcd(b, a % b)",
      "    }",
      "}",
      "/// ピックの定理で多角形**内部**の格子点数 `i = A - b/2 + 1` を返す（`A` は面積、`b` は[`境界格子点数`]）。",
      "/// 整数座標の単純多角形に対して厳密。`A = 符号付き面積2倍.abs()/2`。",
      "fn 内部格子点数(多角形: &[(i64, i64)]) -> i64 {",
      "    let 面積2 = 符号付き面積2倍(多角形).abs();",
      "    let b = 境界格子点数(多角形);",
      "    (面積2 - b + 2) / 2",
      "}"
    ]
  },
  "橋": {
    "scope": "rust",
    "prefix": "橋",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向グラフの橋（取り除くと連結成分が増える辺）と関節点（取り除くと連結成分が増える頂点）を",
      "/// lowlink で求める。構築 O(V + E)。非連結でも全成分を処理する。",
      "/// 多重辺がある場合、同じ 2 頂点を結ぶ辺が 2 本以上あればその辺は橋にならない（辺番号で区別）。",
      "/// - [`Self::橋一覧`] : 橋を `(u, v)`（u < v）の昇順で返す。",
      "/// - [`Self::関節点一覧`] : 関節点を昇順で返す。",
      "struct ローリンク {",
      "    n: usize,",
      "    グラフ: Vec<Vec<(usize, usize)>>,",
      "    辺数: usize,",
      "}",
      "/// DFS 中に使い回す作業領域。",
      "struct 作業領域 {",
      "    カウンタ: usize,",
      "    ord: Vec<i64>,",
      "    low: Vec<usize>,",
      "    橋: Vec<(usize, usize)>,",
      "    関節: Vec<bool>,",
      "}",
      "impl ローリンク {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            グラフ: vec![Vec::new(); n],",
      "            辺数: 0,",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。多重辺・自己ループも許容する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        let id = self.辺数;",
      "        self.グラフ[u].push((v, id));",
      "        self.グラフ[v].push((u, id));",
      "        self.辺数 += 1;",
      "    }",
      "    /// DFS で `ord`（行きがけ順）と `low` を計算し、橋・関節点を収集する。",
      "    fn 探索(&self, now: usize, 親辺: usize, 根か: bool, w: &mut 作業領域) {",
      "        w.ord[now] = w.カウンタ as i64;",
      "        w.low[now] = w.カウンタ;",
      "        w.カウンタ += 1;",
      "        let mut 子数 = 0usize;",
      "        let mut 関節点フラグ = false;",
      "        for &(next, 辺) in &self.グラフ[now] {",
      "            if 辺 == 親辺 {",
      "                continue;",
      "            }",
      "            if w.ord[next] == -1 {",
      "                子数 += 1;",
      "                self.探索(next, 辺, false, w);",
      "                w.low[now] = w.low[now].min(w.low[next]);",
      "                if w.low[next] > w.ord[now] as usize {",
      "                    let (a, b) = if now < next { (now, next) } else { (next, now) };",
      "                    w.橋.push((a, b));",
      "                }",
      "                if !根か && w.low[next] >= w.ord[now] as usize {",
      "                    関節点フラグ = true;",
      "                }",
      "            } else {",
      "                w.low[now] = w.low[now].min(w.ord[next] as usize);",
      "            }",
      "        }",
      "        if 根か {",
      "            if 子数 >= 2 {",
      "                w.関節[now] = true;",
      "            }",
      "        } else if 関節点フラグ {",
      "            w.関節[now] = true;",
      "        }",
      "    }",
      "    fn 計算(&self) -> (Vec<(usize, usize)>, Vec<bool>) {",
      "        let mut w = 作業領域 {",
      "            カウンタ: 0,",
      "            ord: vec![-1i64; self.n],",
      "            low: vec![0usize; self.n],",
      "            橋: Vec::new(),",
      "            関節: vec![false; self.n],",
      "        };",
      "        for s in 0..self.n {",
      "            if w.ord[s] == -1 {",
      "                self.探索(s, !0, true, &mut w);",
      "            }",
      "        }",
      "        (w.橋, w.関節)",
      "    }",
      "    /// 橋を `(u, v)`（u < v）の昇順で返す。",
      "    fn 橋一覧(&self) -> Vec<(usize, usize)> {",
      "        let (mut 橋, _) = self.計算();",
      "        橋.sort_unstable();",
      "        橋",
      "    }",
      "    /// 関節点を昇順で返す。",
      "    fn 関節点一覧(&self) -> Vec<usize> {",
      "        let (_, 関節) = self.計算();",
      "        (0..self.n).filter(|&v| 関節[v]).collect()",
      "    }",
      "}"
    ]
  },
  "橋_森": {
    "scope": "rust",
    "prefix": "橋_森",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重辺連結成分分解の結果。`成分[v]` は頂点 `v` の属する二重辺連結成分の番号、`成分数` はその個数。",
      "/// `橋` は橋（取り除くと連結成分が増える辺）の一覧、`木` は成分を頂点とする**橋森**（橋でつないだ森）。",
      "struct 二重辺連結成分 {",
      "    /// 頂点 → 成分番号。",
      "    成分: Vec<usize>,",
      "    /// 成分の個数。",
      "    成分数: usize,",
      "    /// 橋の一覧（`(u, v)`、`u` は DFS 木で親側）。",
      "    橋: Vec<(usize, usize)>,",
      "    /// 橋森。`木[c]` は成分 `c` と橋で隣接する成分の一覧。",
      "    木: Vec<Vec<usize>>,",
      "}",
      "/// 無向グラフを二重辺連結成分（どの 1 辺を取り除いても連結が保たれる極大頂点集合）に分解し、",
      "/// 橋を縮約した**橋森**を返す。`lowlink`（橋・関節点の列挙）とは別で、成分分解と縮約木まで構成する。",
      "/// `辺` は多重辺・自己ループを含んでよい（並行辺は橋にならない／自己ループは無視）。計算量 `O(n + 辺数)`。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "fn 二重辺連結成分分解(n: usize, 辺: &[(usize, usize)]) -> 二重辺連結成分 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut 番号 = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 橋辺 = vec![false; 辺.len()];",
      "    let mut 橋 = Vec::new();",
      "    let mut 時刻 = 0i64;",
      "    for s in 0..n {",
      "        if 番号[s] != -1 {",
      "            continue;",
      "        }",
      "        番号[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if 番号[next] == -1 {",
      "                    番号[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    探索.push((next, eid as i64, 0));",
      "                } else {",
      "                    low[now] = low[now].min(番号[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] > 番号[prev] {",
      "                        橋辺[親辺 as usize] = true;",
      "                        橋.push((prev, now));",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 成分 = vec![!0; n];",
      "    let mut 成分数 = 0;",
      "    for s in 0..n {",
      "        if 成分[s] != !0 {",
      "            continue;",
      "        }",
      "        成分[s] = 成分数;",
      "        let mut 探索 = vec![s];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, eid) in &グラフ[now] {",
      "                if !橋辺[eid] && 成分[next] == !0 {",
      "                    成分[next] = 成分数;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        成分数 += 1;",
      "    }",
      "    let mut 木 = vec![Vec::new(); 成分数];",
      "    for &(a, b) in &橋 {",
      "        let (x, y) = (成分[a], 成分[b]);",
      "        木[x].push(y);",
      "        木[y].push(x);",
      "    }",
      "    二重辺連結成分 {",
      "        成分,",
      "        成分数,",
      "        橋,",
      "        木,",
      "    }",
      "}"
    ]
  },
