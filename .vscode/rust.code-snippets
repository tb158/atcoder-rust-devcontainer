      "}",
      "/// Lucas の定理による二項係数 `C(n, k) mod p`（`p` は素数）。`n`, `k` は最大 ~10^18 まで扱える。",
      "/// `n`/`k` を p 進展開して桁ごとに掛け合わせるので、`n` が巨大でも `O(log_p n)`。",
      "/// `0..p` の階乗を前計算するので `p` が小さめの素数のとき向き",
      "/// （`p` が 10^9+7 級で `n <= max_n` に収まるなら [`crate::comb`]）。",
      "struct リュカ {",
      "    p: u64,",
      "    階乗: Vec<u64>,",
      "    逆階乗: Vec<u64>,",
      "}",
      "impl リュカ {",
      "    /// 素数 `p` を法とする計算器を作る。`0..p` の階乗・逆階乗を前計算する（O(p)）。",
      "    fn new(p: impl TryInto<u64>) -> Self {",
      "        let p: u64 = p.try_into().ok().expect(\"リュカ: p が u64 に収まりません\");",
      "        assert!(p >= 2, \"p must be a prime >= 2\");",
      "        let mut 階乗 = vec![1u64; p as usize];",
      "        for i in 1..p as usize {",
      "            階乗[i] = 階乗[i - 1] * i as u64 % p;",
      "        }",
      "        let mut 逆階乗 = vec![1u64; p as usize];",
      "        逆階乗[p as usize - 1] = 累乗_mod(階乗[p as usize - 1], p - 2, p);",
      "        for i in (1..p as usize).rev() {",
      "            逆階乗[i - 1] = 逆階乗[i] * i as u64 % p;",
      "        }",
      "        Self {",
      "            p, 階乗, 逆階乗",
      "        }",
      "    }",
      "    /// `0 <= a, b < p` での `C(a, b) mod p`。",
      "    fn 小二項係数(&self, a: u64, b: u64) -> u64 {",
      "        if b > a {",
      "            return 0;",
      "        }",
      "        let a = a as usize;",
      "        let b = b as usize;",
      "        self.階乗[a] * self.逆階乗[b] % self.p * self.逆階乗[a - b] % self.p",
      "    }",
      "    /// `C(n, k) mod p`。`n`, `k` を p 進展開し、各桁の二項係数の積を取る。",
      "    /// 引数は任意の整数型でよい（負の値は 0 を返す）。",
      "    fn 二項係数(&self, n: impl TryInto<i128>, k: impl TryInto<i128>) -> u64 {",
      "        let n: i128 = n.try_into().ok().expect(\"リュカ: n が i128 に収まりません\");",
      "        let k: i128 = k.try_into().ok().expect(\"リュカ: k が i128 に収まりません\");",
      "        if n < 0 || k < 0 {",
      "            return 0;",
      "        }",
      "        let mut n = u64::try_from(n).expect(\"リュカ: n が u64 を超えています\");",
      "        let mut k = u64::try_from(k).expect(\"リュカ: k が u64 を超えています\");",
      "        let mut 結果 = 1u64;",
      "        while n > 0 || k > 0 {",
      "            let ni = n % self.p;",
      "            let ki = k % self.p;",
      "            if ki > ni {",
      "                return 0;",
      "            }",
      "            結果 = 結果 * self.小二項係数(ni, ki) % self.p;",
      "            n /= self.p;",
      "            k /= self.p;",
      "        }",
      "        結果",
      "    }",
      "}"
    ]
  },
  "LucyHedgehog": {
    "scope": "rust",
    "prefix": "LucyHedgehog",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Lucy_Hedgehog 法の内部 DP。`n` 以下の各「`floor(n/i)` で表せる値 `m`」について",
      "/// `Σ_{2<=k<=m, k は素数} 重み(k)` を計算し、最終的に `m = n` の値を返す。`O(n^(3/4))`。",
      "/// `接頭辞(x)` は初期値 `Σ_{k=2}^{x} 重み(k)`（素数に限らない総和）を返すこと。",
      "fn ルーシー篩<W: Fn(u64) -> i128, P: Fn(u64) -> i128>(",
      "    n: u64, 接頭辞: P, 重み: W",
      ") -> i128 {",
      "    if n < 2 {",
      "        return 0;",
      "    }",
      "    let mut v = (n as f64).sqrt() as u64;",
      "    while (v + 1) * (v + 1) <= n {",
      "        v += 1;",
      "    }",
      "    while v * v > n {",
      "        v -= 1;",
      "    }",
      "    let mut small = vec![0i128; (v + 1) as usize];",
      "    let mut large = vec![0i128; (v + 1) as usize];",
      "    for i in 1..=v {",
      "        small[i as usize] = 接頭辞(i);",
      "        large[i as usize] = 接頭辞(n / i);",
      "    }",
      "    for p in 2..=v {",
      "        if small[p as usize] == small[(p - 1) as usize] {",
      "            continue;",
      "        }",
      "        let sp = small[(p - 1) as usize];",
      "        let wp = 重み(p);",
      "        let p2 = p * p;",
      "        let lim = (n / p2).min(v);",
      "        for i in 1..=lim {",
      "            let d = i * p;",
      "            let 値 = if d <= v {",
      "                large[d as usize]",
      "            } else {",
      "                small[(n / d) as usize]",
      "            };",
      "            large[i as usize] -= wp * (値 - sp);",
      "        }",
      "        let mut i = v;",
      "        while i >= p2 {",
      "            small[i as usize] -= wp * (small[(i / p) as usize] - sp);",
      "            i -= 1;",
      "        }",
      "    }",
      "    large[1]",
      "}",
      "/// `n` 以下の素数の個数 `π(n)` を Lucy_Hedgehog 法で `O(n^(3/4))` で求める。",
      "/// 篩（[`prime_number`](crate::prime_number)・`primal` クレート）は `O(n)` 領域が必要で",
      "/// `n` が `10^10` 規模だと回らないが、本法は `√n` 規模の配列だけで個数を数えられる。",
      "fn 素数計数(n: impl TryInto<u64>) -> usize {",
      "    let n: u64 = n",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"素数計数: 引数が u64 に収まりません\");",
      "    ルーシー篩(n, |x| x as i128 - 1, |_| 1) as usize",
      "}",
      "/// `n` 以下の素数の総和を Lucy_Hedgehog 法で `O(n^(3/4))` で求める（`i128` で返す）。",
      "fn 素数和(n: impl TryInto<u64>) -> i128 {",
      "    let n: u64 = n",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"素数和: 引数が u64 に収まりません\");",
      "    ルーシー篩(",
      "        n,",
      "        |x| {",
      "            let x = x as i128;",
      "            x * (x + 1) / 2 - 1",
      "        },",
      "        |p| p as i128,",
      "    )",
      "}"
    ]
  },
  "LyndonFactorization": {
    "scope": "rust",
    "prefix": "LyndonFactorization",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// リンドン分解（Duval のアルゴリズム）。列 `s` を、辞書順で非増加に並ぶリンドン語",
      "/// `w1 >= w2 >= ... >= wk` の連結に一意分解し、各因子の半開区間 `[開始, 終了)` を `O(n)` で返す。",
      "/// リンドン語とは「自身が、その全ての真の接尾辞より辞書順で真に小さい」空でない列。最小回転や",
      "/// suffix array の補助、文字列周期性の解析に使う。比較できる任意の要素列に使える。",
      "fn リンドン分解<T: Ord>(s: &[T]) -> Vec<(usize, usize)> {",
      "    let n = s.len();",
      "    let mut 結果 = Vec::new();",
      "    let mut i = 0;",
      "    while i < n {",
      "        let mut j = i + 1;",
      "        let mut k = i;",
      "        while j < n && s[k] <= s[j] {",
      "            if s[k] < s[j] {",
      "                k = i;",
      "            } else {",
      "                k += 1;",
      "            }",
      "            j += 1;",
      "        }",
      "        while i <= k {",
      "            結果.push((i, i + (j - k)));",
      "            i += j - k;",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "Manacher": {
    "scope": "rust",
    "prefix": "Manacher",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Manacher 法。列に含まれる最長の回文部分列の長さを O(N) で返す。",
      "/// 偶数長の回文にも対応するため、内部で文字の間に区切りを挟んだ列を作って処理する。",
      "/// 要素型 `T` は等値比較できれば何でもよい（バイト列 `s.as_bytes()` のほか",
      "/// `&[char]`・`&[i64]` などにも使える）。",
      "fn マナカー最長回文<T: PartialEq>(s: &[T]) -> usize {",
      "    if s.is_empty() {",
      "        return 0;",
      "    }",
      "    let mut t: Vec<Option<&T>> = Vec::with_capacity(2 * s.len() + 1);",
      "    for c in s {",
      "        t.push(None);",
      "        t.push(Some(c));",
      "    }",
      "    t.push(None);",
      "    let n = t.len();",
      "    let mut 半径 = vec![0usize; n];",
      "    let (mut 中心, mut 右端) = (0usize, 0usize);",
      "    for i in 0..n {",
      "        if i < 右端 {",
      "            半径[i] = (右端 - i).min(半径[2 * 中心 - i]);",
      "        }",
      "        while i > 半径[i] && i + 半径[i] + 1 < n && t[i + 半径[i] + 1] == t[i - 半径[i] - 1]",
      "        {",
      "            半径[i] += 1;",
      "        }",
      "        if i + 半径[i] > 右端 {",
      "            中心 = i;",
      "            右端 = i + 半径[i];",
      "        }",
      "    }",
      "    半径.into_iter().max().unwrap()",
      "}"
    ]
  },
  "ManhattanMST": {
    "scope": "rust",
    "prefix": "ManhattanMST",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::BTreeMap;",
      "/// マンハッタン距離 `|dx| + |dy|` を辺重みとする完全グラフの最小全域木（の総重み）を O(N log N) で求める。",
      "/// 完全グラフは辺が O(N^2) 本あるが、各点について「8 方向（octant）ごとの最近点」だけが MST 候補になる",
      "/// という性質を使い、候補辺を O(N) 本に絞ってから Kruskal する。点が 1 個以下なら 0。",
      "fn マンハッタン最小全域木(点群: &[(i64, i64)]) -> i64 {",
      "    let n = 点群.len();",
      "    if n <= 1 {",
      "        return 0;",
      "    }",
      "    let mut 点 = 点群.to_vec();",
      "    let mut 辺: Vec<(i64, usize, usize)> = Vec::new();",
      "    let mut id: Vec<usize> = (0..n).collect();",
      "    for k in 0..4 {",
      "        id.sort_by_key(|&i| 点[i].0 + 点[i].1);",
      "        let mut スイープ: BTreeMap<i64, usize> = BTreeMap::new();",
      "        for &i in &id {",
      "            let mut 削除 = Vec::new();",
      "            for (&キー, &j) in スイープ.range(-点[i].1..) {",
      "                let dx = 点[i].0 - 点[j].0;",
      "                let dy = 点[i].1 - 点[j].1;",
      "                if dy > dx {",
      "                    break;",
      "                }",
      "                辺.push((dx + dy, i, j));",
      "                削除.push(キー);",
      "            }",
      "            for キー in 削除 {",
      "                スイープ.remove(&キー);",
      "            }",
      "            スイープ.insert(-点[i].1, i);",
      "        }",
      "        for p in 点.iter_mut() {",
      "            if k % 2 == 1 {",
      "                p.0 = -p.0;",
      "            } else {",
      "                std::mem::swap(&mut p.0, &mut p.1);",
      "            }",
      "        }",
      "    }",
      "    辺.sort_by_key(|e| e.0);",
      "    let mut 親: Vec<usize> = (0..n).collect();",
      "    fn 根(親: &mut [usize], x: usize) -> usize {",
      "        let mut x = x;",
      "        while 親[x] != x {",
      "            親[x] = 親[親[x]];",
      "            x = 親[x];",
      "        }",
      "        x",
      "    }",
      "    let mut 合計 = 0;",
      "    let mut 本数 = 0;",
      "    for &(w, u, v) in &辺 {",
      "        let a = 根(&mut 親, u);",
      "        let b = 根(&mut 親, v);",
      "        if a != b {",
      "            親[a] = b;",
      "            合計 += w;",
      "            本数 += 1;",
      "            if 本数 == n - 1 {",
      "                break;",
      "            }",
      "        }",
      "    }",
      "    合計",
      "}"
    ]
  },
  "MaxClique": {
    "scope": "rust",
    "prefix": "MaxClique",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最大クリーク（完全部分グラフ）を Bron–Kerbosch 法（ピボット付き）で求める。頂点数 `n <= 64`。",
      "/// ビットマスクで近傍を持ち、実用的には数十頂点まで高速（最悪 O(3^{n/3})）。",
      "/// [`Self::最大独立集合`] は補グラフの最大クリークとして同じ実装で求まる。",
      "struct 最大クリーク探索 {",
      "    n: usize,",
      "    グラフ: Vec<u64>,",
      "}",
      "impl 最大クリーク探索 {",
      "    /// 頂点数 `n`（`<= 64`）の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        assert!(n <= 64, \"n must be <= 64\");",
      "        Self {",
      "            n,",
      "            グラフ: vec![0u64; n],",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        if u != v {",
      "            self.グラフ[u] |= 1 << v;",
      "            self.グラフ[v] |= 1 << u;",
      "        }",
      "    }",
      "    /// 最大クリークの頂点集合を返す。",
      "    fn 最大クリーク(&self) -> Vec<usize> {",
      "        let 全 = if self.n == 64 {",
      "            u64::MAX",
      "        } else {",
      "            (1u64 << self.n) - 1",
      "        };",
      "        let mut 最良 = 0u64;",
      "        self.探索(0, 全, 0, &mut 最良);",
      "        ビット列(最良)",
      "    }",
      "    /// 最大独立集合の頂点集合を返す（補グラフの最大クリーク）。",
      "    fn 最大独立集合(&self) -> Vec<usize> {",
      "        let 全 = if self.n == 64 {",
      "            u64::MAX",
      "        } else {",
      "            (1u64 << self.n) - 1",
      "        };",
      "        let mut 補 = 最大クリーク探索::new(self.n);",
      "        for v in 0..self.n {",
      "            補.グラフ[v] = !self.グラフ[v] & 全 & !(1u64 << v);",
      "        }",
      "        let mut 最良 = 0u64;",
      "        補.探索(0, 全, 0, &mut 最良);",
      "        ビット列(最良)",
      "    }",
      "    /// Bron–Kerbosch（ピボット付き）。`r` 現在のクリーク、`p` 候補、`x` 除外済み。",
      "    fn 探索(&self, r: u64, p: u64, x: u64, 最良: &mut u64) {",
      "        if p == 0 && x == 0 {",
      "            if r.count_ones() > 最良.count_ones() {",
      "                *最良 = r;",
      "            }",
      "            return;",
      "        }",
      "        if r.count_ones() + p.count_ones() <= 最良.count_ones() {",
      "            return;",
      "        }",
      "        let mut ピボット候補 = p | x;",
      "        let mut ピボット = 0usize;",
      "        let mut 最多 = -1i64;",
      "        while ピボット候補 != 0 {",
      "            let v = ピボット候補.trailing_zeros() as usize;",
      "            ピボット候補 &= ピボット候補 - 1;",
      "            let c = (p & self.グラフ[v]).count_ones() as i64;",
      "            if c > 最多 {",
      "                最多 = c;",
      "                ピボット = v;",
      "            }",
      "        }",
      "        let mut 候補 = p & !self.グラフ[ピボット];",
      "        let mut p = p;",
      "        let mut x = x;",
      "        while 候補 != 0 {",
      "            let v = 候補.trailing_zeros() as usize;",
      "            let ビット = 1u64 << v;",
      "            候補 &= 候補 - 1;",
      "            self.探索(r | ビット, p & self.グラフ[v], x & self.グラフ[v], 最良);",
      "            p &= !ビット;",
      "            x |= ビット;",
      "        }",
      "    }",
      "}",
      "/// ビットマスクを立っている添字の昇順 `Vec` に変換する。",
      "fn ビット列(mut m: u64) -> Vec<usize> {",
      "    let mut v = Vec::new();",
      "    while m != 0 {",
      "        v.push(m.trailing_zeros() as usize);",
      "        m &= m - 1;",
      "    }",
      "    v",
      "}"
    ]
  },
  "MaxWeightClosure": {
    "scope": "rust",
    "prefix": "MaxWeightClosure",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最大重み閉包問題（Project Selection／いわゆる「燃やす埋める」）。",
      "/// 各要素に整数重み `w_i`（負も可）があり、「要素 `i` を選ぶなら `j` も必ず選ぶ」という依存",
      "/// （有向辺 `i→j`）が課されている。依存を満たす部分集合 `S`（`i∈S ⇒ j∈S`）のうち重み総和",
      "/// `Σ_{i∈S} w_i` を最大にするものを求める。空集合も選択可能なので答えは常に `0` 以上。",
      "/// 内部で最小カット（[`ac_library::MfGraph`] の Dinic）へ帰着する。",
      "struct 最大重み閉包 {",
      "    重み: Vec<i64>,",
      "    依存: Vec<(usize, usize)>,",
      "}",
      "impl 最大重み閉包 {",
      "    /// 各要素の重み（負も可）を与えて初期化する。",
      "    fn new(重み: Vec<i64>) -> Self {",
      "        最大重み閉包 {",
      "            重み,",
      "            依存: Vec::new(),",
      "        }",
      "    }",
      "    /// 依存「要素 `i` を選ぶなら `j` も選ぶ」を追加する。",
      "    fn 依存追加(&mut self, i: usize, j: usize) {",
      "        assert!(i < self.重み.len() && j < self.重み.len());",
      "        self.依存.push((i, j));",
      "    }",
      "    /// 最大重みと、それを達成する選択集合 `選択[i]` を返す。`O(最大流)`。",
      "    fn 解く(&self) -> (i64, Vec<bool>) {",
      "        use ac_library::MfGraph;",
      "        const INF: i64 = 1 << 60;",
      "        let n = self.重み.len();",
      "        let (源, 匯) = (n, n + 1);",
      "        let mut g = MfGraph::<i64>::new(n + 2);",
      "        let mut 正の和 = 0i64;",
      "        for (i, &w) in self.重み.iter().enumerate() {",
      "            if w > 0 {",
      "                g.add_edge(源, i, w);",
      "                正の和 += w;",
      "            } else if w < 0 {",
      "                g.add_edge(i, 匯, -w);",
      "            }",
      "        }",
      "        for &(i, j) in &self.依存 {",
      "            g.add_edge(i, j, INF);",
      "        }",
      "        let カット = g.flow(源, 匯);",
      "        let 到達 = g.min_cut(源);",
      "        let 選択 = (0..n).map(|i| 到達[i]).collect();",
      "        (正の和 - カット, 選択)",
      "    }",
      "}"
    ]
  },
  "MaximumIndependentSet": {
    "scope": "rust",
    "prefix": "MaximumIndependentSet",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最大クリーク（完全部分グラフ）を Bron–Kerbosch 法（ピボット付き）で求める。頂点数 `n <= 64`。",
      "/// ビットマスクで近傍を持ち、実用的には数十頂点まで高速（最悪 O(3^{n/3})）。",
      "/// [`Self::最大独立集合`] は補グラフの最大クリークとして同じ実装で求まる。",
      "struct 最大クリーク探索 {",
      "    n: usize,",
      "    グラフ: Vec<u64>,",
      "}",
      "impl 最大クリーク探索 {",
      "    /// 頂点数 `n`（`<= 64`）の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        assert!(n <= 64, \"n must be <= 64\");",
      "        Self {",
      "            n,",
      "            グラフ: vec![0u64; n],",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        if u != v {",
      "            self.グラフ[u] |= 1 << v;",
      "            self.グラフ[v] |= 1 << u;",
      "        }",
      "    }",
      "    /// 最大クリークの頂点集合を返す。",
      "    fn 最大クリーク(&self) -> Vec<usize> {",
      "        let 全 = if self.n == 64 {",
      "            u64::MAX",
      "        } else {",
      "            (1u64 << self.n) - 1",
      "        };",
      "        let mut 最良 = 0u64;",
      "        self.探索(0, 全, 0, &mut 最良);",
      "        ビット列(最良)",
      "    }",
      "    /// 最大独立集合の頂点集合を返す（補グラフの最大クリーク）。",
      "    fn 最大独立集合(&self) -> Vec<usize> {",
      "        let 全 = if self.n == 64 {",
      "            u64::MAX",
      "        } else {",
      "            (1u64 << self.n) - 1",
      "        };",
      "        let mut 補 = 最大クリーク探索::new(self.n);",
      "        for v in 0..self.n {",
      "            補.グラフ[v] = !self.グラフ[v] & 全 & !(1u64 << v);",
      "        }",
      "        let mut 最良 = 0u64;",
      "        補.探索(0, 全, 0, &mut 最良);",
      "        ビット列(最良)",
      "    }",
      "    /// Bron–Kerbosch（ピボット付き）。`r` 現在のクリーク、`p` 候補、`x` 除外済み。",
      "    fn 探索(&self, r: u64, p: u64, x: u64, 最良: &mut u64) {",
      "        if p == 0 && x == 0 {",
      "            if r.count_ones() > 最良.count_ones() {",
      "                *最良 = r;",
      "            }",
      "            return;",
      "        }",
      "        if r.count_ones() + p.count_ones() <= 最良.count_ones() {",
      "            return;",
      "        }",
      "        let mut ピボット候補 = p | x;",
      "        let mut ピボット = 0usize;",
      "        let mut 最多 = -1i64;",
      "        while ピボット候補 != 0 {",
      "            let v = ピボット候補.trailing_zeros() as usize;",
      "            ピボット候補 &= ピボット候補 - 1;",
      "            let c = (p & self.グラフ[v]).count_ones() as i64;",
      "            if c > 最多 {",
      "                最多 = c;",
      "                ピボット = v;",
      "            }",
      "        }",
      "        let mut 候補 = p & !self.グラフ[ピボット];",
      "        let mut p = p;",
      "        let mut x = x;",
      "        while 候補 != 0 {",
      "            let v = 候補.trailing_zeros() as usize;",
      "            let ビット = 1u64 << v;",
      "            候補 &= 候補 - 1;",
      "            self.探索(r | ビット, p & self.グラフ[v], x & self.グラフ[v], 最良);",
      "            p &= !ビット;",
      "            x |= ビット;",
      "        }",
      "    }",
      "}",
      "/// ビットマスクを立っている添字の昇順 `Vec` に変換する。",
      "fn ビット列(mut m: u64) -> Vec<usize> {",
      "    let mut v = Vec::new();",
      "    while m != 0 {",
      "        v.push(m.trailing_zeros() as usize);",
      "        m &= m - 1;",
      "    }",
      "    v",
      "}"
    ]
  },
  "MinEnclosingCircle": {
    "scope": "rust",
    "prefix": "MinEnclosingCircle",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗（浮動小数）。整数座標版は `geometry` の `距離2乗`。",
      "fn 距離2乗f64(a: (f64, f64), b: (f64, f64)) -> f64 {",
      "    let dx = a.0 - b.0;",
      "    let dy = a.1 - b.1;",
      "    dx * dx + dy * dy",
      "}",
      "/// 2 点の中点。",
      "fn 中点(a: (f64, f64), b: (f64, f64)) -> (f64, f64) {",
      "    ((a.0 + b.0) / 2.0, (a.1 + b.1) / 2.0)",
      "}",
      "/// 3 点を通る円の中心（外心）。3 点が一直線上だと数値的に破綻するので注意。",
      "fn 外心(a: (f64, f64), b: (f64, f64), c: (f64, f64)) -> (f64, f64) {",
      "    let (ax, ay) = a;",
      "    let (bx, by) = b;",
      "    let (cx, cy) = c;",
      "    let d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));",
      "    let a2 = ax * ax + ay * ay;",
      "    let b2 = bx * bx + by * by;",
      "    let c2 = cx * cx + cy * cy;",
      "    let ux = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / d;",
      "    let uy = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / d;",
      "    (ux, uy)",
      "}",
      "/// すべての点を含む最小の円 `(中心x, 中心y, 半径)` を求める（Welzl の漸増法）。期待 O(N)。",
      "/// 点が空なら `None`。",
      "fn 最小包含円(点群: &[(f64, f64)]) -> Option<(f64, f64, f64)> {",
      "    const イプシロン: f64 = 1e-12;",
      "    if 点群.is_empty() {",
      "        return None;",
      "    }",
      "    let mut p = 点群.to_vec();",
      "    let mut seed = 0x1234_5678u64;",
      "    let mut 乱数 = || {",
      "        seed = seed",
      "            .wrapping_mul(6364136223846793005)",
      "            .wrapping_add(1442695040888963407);",
      "        seed >> 33",
      "    };",
      "    for i in (1..p.len()).rev() {",
      "        let j = (乱数() as usize) % (i + 1);",
      "        p.swap(i, j);",
      "    }",
      "    let mut 中心 = p[0];",
      "    let mut 半径2 = 0.0f64;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for i in 1..p.len() {",
      "        if 距離2乗f64(中心, p[i]) <= 半径2 + イプシロン {",
      "            continue;",
      "        }",
      "        中心 = p[i];",
      "        半径2 = 0.0;",
      "        for j in 0..i {",
      "            if 距離2乗f64(中心, p[j]) <= 半径2 + イプシロン {",
      "                continue;",
      "            }",
      "            中心 = 中点(p[i], p[j]);",
      "            半径2 = 距離2乗f64(中心, p[i]);",
      "            for k in 0..j {",
      "                if 距離2乗f64(中心, p[k]) <= 半径2 + イプシロン {",
      "                    continue;",
      "                }",
      "                中心 = 外心(p[i], p[j], p[k]);",
      "                半径2 = 距離2乗f64(中心, p[i]);",
      "            }",
      "        }",
      "    }",
      "    Some((中心.0, 中心.1, 半径2.sqrt()))",
      "}"
    ]
  },
  "MinMeanCycle": {
    "scope": "rust",
    "prefix": "MinMeanCycle",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 有向重み付きグラフの**最小平均閉路**（辺の重み和 ÷ 辺数を最小化する閉路の、その比）を返す。",
      "/// 閉路が存在しなければ `None`。重みは負でもよい。`O(V·E)`。",
      "/// Karp の定理を用いる。最小費用流の最適性判定や周期最適化などで使う。",
      "fn 最小平均閉路(頂点数: usize, 辺: &[(usize, usize, i64)]) -> Option<f64> {",
      "    if 頂点数 == 0 {",
      "        return None;",
      "    }",
      "    const INF: i64 = 1 << 60;",
      "    let v = 頂点数;",
      "    let n = v + 1;",
      "    let 始点 = v;",
      "    let mut 全辺 = 辺.to_vec();",
      "    for w in 0..v {",
      "        全辺.push((始点, w, 0));",
      "    }",
      "    let mut d = vec![vec![INF; n]; n + 1];",
      "    d[0][始点] = 0;",
      "    for k in 1..=n {",
      "        let (前, 当) = d.split_at_mut(k);",
      "        let 前 = &前[k - 1];",
      "        let 当 = &mut 当[0];",
      "        for &(a, b, wt) in &全辺 {",
      "            if 前[a] < INF {",
      "                let nd = 前[a] + wt;",
      "                if nd < 当[b] {",
      "                    当[b] = nd;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 最小 = f64::INFINITY;",
      "    for t in 0..n {",
      "        if d[n][t] >= INF {",
      "            continue;",
      "        }",
      "        let mut 最大 = f64::NEG_INFINITY;",
      "        for k in 0..n {",
      "            if d[k][t] >= INF {",
      "                continue;",
      "            }",
      "            let 比 = (d[n][t] - d[k][t]) as f64 / (n - k) as f64;",
      "            if 比 > 最大 {",
      "                最大 = 比;",
      "            }",
      "        }",
      "        if 最大 < 最小 {",
      "            最小 = 最大;",
      "        }",
      "    }",
      "    if 最小.is_infinite() {",
      "        None",
      "    } else {",
      "        Some(最小)",
      "    }",
      "}"
    ]
  },
  "MinPlusMatrix": {
    "scope": "rust",
    "prefix": "MinPlusMatrix",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 到達不能・無限大を表す番兵。加算しても溢れないよう十分小さく取る。",
      "const 無限: i64 = 1 << 60;",
      "/// min-plus（トロピカル）半環での正方行列の積 `(A⊗B)[i][j] = min_k (A[i][k] + B[k][j])`。`O(n^3)`。",
      "/// `無限`（≒到達不能）同士の加算でも溢れないよう番兵で頭打ちにする。",
      "#[allow(clippy::needless_range_loop)]",
      "fn ミンプラス積(a: &[Vec<i64>], b: &[Vec<i64>]) -> Vec<Vec<i64>> {",
      "    let n = a.len();",
      "    let mut c = vec![vec![無限; n]; n];",
      "    for i in 0..n {",
      "        for k in 0..n {",
      "            if a[i][k] >= 無限 {",
      "                continue;",
      "            }",
      "            let aik = a[i][k];",
      "            for j in 0..n {",
      "                let v = aik.saturating_add(b[k][j]).min(無限);",
      "                if v < c[i][j] {",
      "                    c[i][j] = v;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    c",
      "}",
      "/// min-plus 行列の `e` 乗を二分累乗で求める。`O(n^3 log e)`。",
      "/// 入力 `行列[i][j]` を「辺 `i→j` の重み（辺が無ければ `無限` 以上）」とみなすと、結果の",
      "/// `[i][j]` は **`i` から `j` へちょうど `e` 本の辺で行く最短歩道**の重み（到達不能なら `≥ 無限`）。",
      "/// `e == 0` は単位元（対角 0・他 `無限`）。重み付き有向グラフで「辺数を固定した最短路」や",
      "/// 「k 手後の最小コスト」を求めるのに使う。",
      "fn ミンプラス累乗(行列: &[Vec<i64>], e: usize) -> Vec<Vec<i64>> {",
      "    let n = 行列.len();",
      "    let mut 結果 = vec![vec![無限; n]; n];",
      "    for (i, row) in 結果.iter_mut().enumerate() {",
      "        row[i] = 0;",
      "    }",
      "    let mut 底: Vec<Vec<i64>> = 行列",
      "        .iter()",
      "        .map(|r| r.iter().map(|&x| x.min(無限)).collect())",
      "        .collect();",
      "    let mut e = e;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            結果 = ミンプラス積(&結果, &底);",
      "        }",
      "        底 = ミンプラス積(&底, &底);",
      "        e >>= 1;",
      "    }",
      "    結果",
      "}"
    ]
  },
  "MinimumPathCover": {
    "scope": "rust",
    "prefix": "MinimumPathCover",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::VecDeque;",
      "/// Hopcroft-Karp 法による二部グラフの最大マッチング。O(E√V)。",
      "/// `ac_library::MaxFlow` でも最大二部マッチングは解けるが、こちらは二部マッチング専用で",
      "/// E√V と高速。`pathfinding::kuhn_munkres` は重み付き割当専用なので、",
      "/// 単純な最大本数マッチングにはこちらを使う。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に対応も保持）。",
      "/// - [`Self::マッチング`] : マッチした `(左, 右)` の組を返す。",
      "struct ホップクロフトカープ {",
      "    左数: usize,",
      "    グラフ: Vec<Vec<usize>>,",
      "    左相手: Vec<i64>,",
      "    右相手: Vec<i64>,",
      "    距離: Vec<i64>,",
      "}",
      "impl ホップクロフトカープ {",
      "    /// 左頂点 `左数` 個・右頂点 `右数` 個の二部グラフを作る。",
      "    fn new(左数: usize, 右数: usize) -> Self {",
      "        Self {",
      "            左数,",
      "            グラフ: vec![Vec::new(); 左数],",
      "            左相手: vec![-1; 左数],",
      "            右相手: vec![-1; 右数],",
      "            距離: vec![-1; 左数],",
      "        }",
      "    }",
      "    /// 左頂点 `u` と右頂点 `v` を結ぶ辺を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.グラフ[u].push(v);",
      "    }",
      "    /// 未マッチ左頂点から BFS して層（距離）を作る。増加道が存在すれば true。",
      "    fn bfs(&mut self) -> bool {",
      "        let mut 探索 = VecDeque::new();",
      "        for u in 0..self.左数 {",
      "            if self.左相手[u] < 0 {",
      "                self.距離[u] = 0;",
      "                探索.push_back(u);",
      "            } else {",
      "                self.距離[u] = -1;",
      "            }",
      "        }",
      "        let mut 増加道あり = false;",
      "        while let Some(u) = 探索.pop_front() {",
      "            for i in 0..self.グラフ[u].len() {",
      "                let v = self.グラフ[u][i];",
      "                let w = self.右相手[v];",
      "                if w < 0 {",
      "                    増加道あり = true;",
      "                } else {",
      "                    let w = w as usize;",
      "                    if self.距離[w] < 0 {",
      "                        self.距離[w] = self.距離[u] + 1;",
      "                        探索.push_back(w);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        増加道あり",
      "    }",
      "    /// 層に沿って `u` から増加道を探し、見つかれば反転して true。",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn dfs(&mut self, u: usize) -> bool {",
      "        for i in 0..self.グラフ[u].len() {",
      "            let v = self.グラフ[u][i];",
      "            let w = self.右相手[v];",
      "            let 進める =",
      "                w < 0 || (self.距離[w as usize] == self.距離[u] + 1 && self.dfs(w as usize));",
      "            if 進める {",
      "                self.左相手[u] = v as i64;",
      "                self.右相手[v] = u as i64;",
      "                return true;",
      "            }",
      "        }",
      "        self.距離[u] = -1;",
      "        false",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut 本数 = 0;",
      "        while self.bfs() {",
      "            for u in 0..self.左数 {",
      "                if self.左相手[u] < 0 && self.dfs(u) {",
      "                    本数 += 1;",
      "                }",
      "            }",
      "        }",
      "        本数",
      "    }",
      "    /// マッチした `(左, 右)` の組を返す。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn マッチング(&self) -> Vec<(usize, usize)> {",
      "        (0..self.左数)",
      "            .filter(|&u| self.左相手[u] >= 0)",
      "            .map(|u| (u, self.左相手[u] as usize))",
      "            .collect()",
      "    }",
      "}",
      "/// DAG（閉路のない有向グラフ）の**頂点素な最小パス被覆**を求める。すべての頂点をちょうど 1 本の",
      "/// 有向パスに含めるとき、必要なパスの最小本数と、その実際のパス列を返す。`O(E√V)`（二部マッチング）。",
      "/// 半順序の比較可能対を辺にすれば、最小パス被覆数は**最大反鎖**の大きさに等しい（Dilworth の定理）。",
      "/// [`hopcroft_karp`](crate::hopcroft_karp) は素のマッチング、本関数はその DAG パス被覆への応用。",
      "/// 入力に閉路があると正しい結果を保証しない（事前にトポロジカル性を仮定）。",
      "fn dag最小パス被覆(頂点数: usize, 辺: &[(usize, usize)]) -> (usize, Vec<Vec<usize>>) {",
      "    let mut hk = ホップクロフトカープ::new(頂点数, 頂点数);",
      "    for &(u, v) in 辺 {",
      "        hk.辺追加(u, v);",
      "    }",
      "    let m = hk.最大マッチング();",
      "    let mut next = vec![!0; 頂点数];",
      "    let mut prev = vec![!0; 頂点数];",
      "    for (u, v) in hk.マッチング() {",
      "        next[u] = v;",
      "        prev[v] = u;",
      "    }",
      "    let mut パス = Vec::new();",
      "    for (s, &prev_s) in prev.iter().enumerate() {",
      "        if prev_s == !0 {",
      "            let mut p = Vec::new();",
      "            let mut now = s;",
      "            while now != !0 {",
      "                p.push(now);",
      "                now = next[now];",
      "            }",
      "            パス.push(p);",
      "        }",
      "    }",
      "    (頂点数 - m, パス)",
      "}"
    ]
  },
  "MinimumRotation": {
    "scope": "rust",
    "prefix": "MinimumRotation",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最小回転（Booth のアルゴリズム）。列 `s` の巡回シフトのうち辞書順最小になるものの開始位置を",
      "/// `O(n)` で返す。`s[k..] ++ s[..k]` が最小の回転。空列なら `0`。",
      "/// 文字列の「最小表現（canonical form）」を取って同型判定する用途で頻出。",
      "/// 比較できる任意の要素列に使える。",
      "fn 最小回転<T: Ord>(s: &[T]) -> usize {",
      "    let n = s.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let c = |idx: usize| &s[idx % n];",
      "    let mut f: Vec<i64> = vec![-1; 2 * n];",
      "    let mut k: usize = 0;",
      "    for j in 1..2 * n {",
      "        let sj = c(j);",
      "        let mut i = f[j - k - 1];",
      "        while i != -1 && sj != c(k + i as usize + 1) {",
      "            if sj < c(k + i as usize + 1) {",
      "                k = j - i as usize - 1;",
      "            }",
      "            i = f[i as usize];",
      "        }",
      "        if sj != c(k + (i + 1) as usize) {",
      "            if sj < c(k + (i + 1) as usize) {",
      "                k = j;",
      "            }",
      "            f[j - k] = -1;",
      "        } else {",
      "            f[j - k] = i + 1;",
      "        }",
      "    }",
      "    k",
      "}"
    ]
  },
  "MinimumWidth": {
    "scope": "rust",
    "prefix": "MinimumWidth",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 凸包（Andrew's monotone chain）。与えた点集合をすべて含む最小の凸多角形の",
      "/// 頂点を、反時計回りの順で返す。O(N log N)。",
      "/// 一直線上に並ぶ中間点（凸包の辺上の点）は頂点に含めない。",
      "/// 点が2個以下のときは重複を除いた入力をそのまま返す。",
      "fn 凸包(点群: &[(i64, i64)]) -> Vec<(i64, i64)> {",
      "    let mut 点 = 点群.to_vec();",
      "    点.sort();",
      "    点.dedup();",
      "    let n = 点.len();",
      "    if n <= 2 {",
      "        return 点;",
      "    }",
      "    let mut 下側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in &点 {",
      "        while 下側.len() >= 2 && 外積3点(下側[下側.len() - 2], 下側[下側.len() - 1], p) <= 0",
      "        {",
      "            下側.pop();",
      "        }",
      "        下側.push(p);",
      "    }",
      "    let mut 上側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in 点.iter().rev() {",
      "        while 上側.len() >= 2 && 外積3点(上側[上側.len() - 2], 上側[上側.len() - 1], p) <= 0",
      "        {",
      "            上側.pop();",
      "        }",
      "        上側.push(p);",
      "    }",
      "    下側.pop();",
      "    上側.pop();",
      "    下側.extend(上側);",
      "    下側",
      "}",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "/// 凸多角形（点群の凸包）の**最小幅**＝平行な 2 直線で挟んだときの最小の間隔を返す。回転キャリパスで",
      "/// 凸包の各辺について最遠頂点までの距離を測り、その最小を取る。凸包構築 O(N log N) ＋ 走査 O(N)。",
      "/// 点が 2 個以下（または一直線）なら幅 0。",
      "/// 同じファイルの [`最遠点対の距離2乗`] が「最遠＝直径」なのに対し、こちらは「最薄＝幅」。",
      "/// 最小幅は、棒を通せる最小の隙間や、凸形状を平行平板で挟む最小厚みの判定に使う。",
      "fn 凸多角形の最小幅(点群: &[(i64, i64)]) -> f64 {",
      "    let 包 = 凸包(点群);",
      "    let m = 包.len();",
      "    if m <= 2 {",
      "        return 0.0;",
      "    }",
      "    let mut 最小 = f64::INFINITY;",
      "    let mut j = 1usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for i in 0..m {",
      "        let ni = (i + 1) % m;",
      "        while 外積3点(包[i], 包[ni], 包[(j + 1) % m]) > 外積3点(包[i], 包[ni], 包[j]) {",
      "            j = (j + 1) % m;",
      "        }",
      "        let 高さ2倍 = 外積3点(包[i], 包[ni], 包[j]).abs() as f64;",
      "        let 辺長 =",
      "            (((包[ni].0 - 包[i].0) as f64).powi(2) + ((包[ni].1 - 包[i].1) as f64).powi(2)).sqrt();",
      "        最小 = 最小.min(高さ2倍 / 辺長);",
      "    }",
      "    最小",
      "}"
    ]
  },
  "MinkowskiSum": {
    "scope": "rust",
    "prefix": "MinkowskiSum",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (i64, i64);",
      "/// 2 つの反時計回り凸多角形 `a`, `b` のミンコフスキー和 `{p + q | p∈A, q∈B}` の輪郭を",
      "/// 反時計回りで返す。`O(N + M)`。",
      "fn ミンコフスキー和(a: &[点], b: &[点]) -> Vec<点> {",
      "    let 整列 = |p: &[点]| -> Vec<点> {",
      "        let n = p.len();",
      "        let mut k = 0;",
      "        for i in 1..n {",
      "            if p[i].1 < p[k].1 || (p[i].1 == p[k].1 && p[i].0 < p[k].0) {",
      "                k = i;",
      "            }",
      "        }",
      "        (0..n).map(|i| p[(k + i) % n]).collect()",
      "    };",
      "    let a = 整列(a);",
      "    let b = 整列(b);",
      "    let n = a.len();",
      "    let m = b.len();",
      "    let mut 結果 = Vec::with_capacity(n + m);",
      "    let (mut i, mut j) = (0usize, 0usize);",
      "    while i < n || j < m {",
      "        結果.push((a[i % n].0 + b[j % m].0, a[i % n].1 + b[j % m].1));",
      "        let ae = (a[(i + 1) % n].0 - a[i % n].0, a[(i + 1) % n].1 - a[i % n].1);",
      "        let be = (b[(j + 1) % m].0 - b[j % m].0, b[(j + 1) % m].1 - b[j % m].1);",
      "        let cross = ae.0 as i128 * be.1 as i128 - ae.1 as i128 * be.0 as i128;",
      "        let 進i = i < n && (j >= m || cross >= 0);",
      "        let 進j = j < m && (i >= n || cross <= 0);",
      "        if 進i {",
      "            i += 1;",
      "        }",
      "        if 進j {",
      "            j += 1;",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "Mo": {
    "scope": "rust",
    "prefix": "Mo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Mo のアルゴリズムで扱う区間状態。現在の対象区間 `[l, r)` を 1 要素ずつ伸縮させながら、",
      "/// 各クエリの答えを得るためのインタフェースを実装する。",
      "/// 伸縮は端点の単純な追加・削除で答えを更新できる問題（区間内の種類数・同値ペア数など）に",
      "/// 適用できる。状態は `状態.追加 / 削除` の呼び出しに対し O(1)〜O(log) で更新できること。",
      "trait Mo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 位置 `位置` の要素を現在の対象区間に加える。",
      "    fn 追加(&mut self, 位置: usize);",
      "    /// 位置 `位置` の要素を現在の対象区間から取り除く。",
      "    fn 削除(&mut self, 位置: usize);",
      "    /// 現在の対象区間に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// Mo のアルゴリズム本体。`クエリ` は半開区間 `[l, r)` の列で、各クエリの答えを",
      "/// 入力順に並べて返す。全体 O((N + Q)·√N · 更新コスト)。",
      "/// `状態` は空区間 `[0, 0)` を表す初期状態で渡すこと。`S` は [`Mo`] を実装した型。",
      "fn mo実行<S: Mo>(状態: &mut S, クエリ: &[(usize, usize)]) -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    let mut 答え = Vec::with_capacity(q);",
      "    if q == 0 {",
      "        return 答え;",
      "    }",
      "    let 上限 = クエリ.iter().map(|&(_, r)| r).max().unwrap().max(1);",
      "    let ブロック = ((上限 as f64).sqrt() as usize).max(1);",
      "    let mut 順: Vec<usize> = (0..q).collect();",
      "    順.sort_by(|&a, &b| {",
      "        let (la, ra) = クエリ[a];",
      "        let (lb, rb) = クエリ[b];",
      "        let (ba, bb) = (la / ブロック, lb / ブロック);",
      "        if ba != bb {",
      "            return ba.cmp(&bb);",
      "        }",
      "        if ba % 2 == 0 {",
      "            ra.cmp(&rb)",
      "        } else {",
      "            rb.cmp(&ra)",
      "        }",
      "    });",
      "    let mut 出力: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let (mut cl, mut cr) = (0usize, 0usize);",
      "    for &i in &順 {",
      "        let (l, r) = クエリ[i];",
      "        while cr < r {",
      "            状態.追加(cr);",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            状態.追加(cl);",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            状態.削除(cr);",
      "        }",
      "        while cl < l {",
      "            状態.削除(cl);",
      "            cl += 1;",
      "        }",
      "        出力[i] = Some(状態.答え());",
      "    }",
      "    for o in 出力 {",
      "        答え.push(o.unwrap());",
      "    }",
      "    答え",
      "}"
