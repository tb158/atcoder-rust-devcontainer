    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗を `i128` で返す。",
      "/// 平方根を取らないので誤差なしで距離を比較できる。差を取ってから `i128` に広げるため、",
      "/// 座標が `±10^18` でも桁あふれしない。実距離が要るときは `(d as f64).sqrt()`。",
      "fn 距離2乗(a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let dx = (a.0 - b.0) as i128;",
      "    let dy = (a.1 - b.1) as i128;",
      "    dx * dx + dy * dy",
      "}"
    ]
  },
  "3次元_Mo": {
    "scope": "rust",
    "prefix": "3次元_Mo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 点更新を挟むオフライン区間クエリを扱う「更新あり Mo（時刻軸 Mo, 3D Mo）」の状態インタフェース。",
      "/// 素の [`Mo`](crate::mo) は配列が不変だが、こちらは「`t` 番目までの点更新を適用した配列」に対して",
      "/// 区間 `[l, r)` のクエリに答える。区間ポインタ（追加/削除）に加え、時刻ポインタを",
      "/// 前後させる `前進`/`後退` を実装する。更新位置が現在の対象区間内なら寄与も更新すること。",
      "trait 時刻付きMo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 位置 `位置` の要素を現在の対象区間に加える。",
      "    fn 追加(&mut self, 位置: usize);",
      "    /// 位置 `位置` の要素を現在の対象区間から取り除く。",
      "    fn 削除(&mut self, 位置: usize);",
      "    /// 時刻 `t` の更新を適用して時刻を 1 進める。`[cl, cr)` は現在の対象区間。",
      "    fn 前進(&mut self, t: usize, cl: usize, cr: usize);",
      "    /// 時刻 `t` の更新を取り消して時刻を 1 戻す。`[cl, cr)` は現在の対象区間。",
      "    fn 後退(&mut self, t: usize, cl: usize, cr: usize);",
      "    /// 現在の対象区間・時刻に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// 更新あり Mo 本体。`クエリ` は `(l, r, t)`（「先頭 `t` 個の更新を適用した配列」での区間 `[l, r)`）の列。",
      "/// 各クエリの答えを入力順に並べて返す。全体 `O(N^(5/3))`（更新コスト別）。",
      "/// `状態` は空区間 `[0, 0)`・時刻 `0` の初期状態で渡すこと。`S` は [`時刻付きMo`] を実装した型。",
      "fn 時刻付きmo実行<S: 時刻付きMo>(",
      "    状態: &mut S,",
      "    クエリ: &[(usize, usize, usize)],",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    let mut 答え = Vec::with_capacity(q);",
      "    if q == 0 {",
      "        return 答え;",
      "    }",
      "    let 上限 = クエリ.iter().map(|&(_, r, _)| r).max().unwrap().max(1);",
      "    let ブロック = ((上限 as f64).powf(2.0 / 3.0) as usize).max(1);",
      "    let mut 順: Vec<usize> = (0..q).collect();",
      "    順.sort_by(|&a, &b| {",
      "        let (la, ra, ta) = クエリ[a];",
      "        let (lb, rb, tb) = クエリ[b];",
      "        let (bla, blb) = (la / ブロック, lb / ブロック);",
      "        if bla != blb {",
      "            return bla.cmp(&blb);",
      "        }",
      "        let (bra, brb) = (ra / ブロック, rb / ブロック);",
      "        if bra != brb {",
      "            return if bla % 2 == 0 {",
      "                bra.cmp(&brb)",
      "            } else {",
      "                brb.cmp(&bra)",
      "            };",
      "        }",
      "        if bra % 2 == 0 {",
      "            ta.cmp(&tb)",
      "        } else {",
      "            tb.cmp(&ta)",
      "        }",
      "    });",
      "    let mut 出力: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let (mut cl, mut cr, mut ct) = (0usize, 0usize, 0usize);",
      "    for &i in &順 {",
      "        let (l, r, t) = クエリ[i];",
      "        while cr < r {",
      "            状態.追加(cr);",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            状態.追加(cl);",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            状態.削除(cr);",
      "        }",
      "        while cl < l {",
      "            状態.削除(cl);",
      "            cl += 1;",
      "        }",
      "        while ct < t {",
      "            状態.前進(ct, cl, cr);",
      "            ct += 1;",
      "        }",
      "        while ct > t {",
      "            ct -= 1;",
      "            状態.後退(ct, cl, cr);",
      "        }",
      "        出力[i] = Some(状態.答え());",
      "    }",
      "    for o in 出力 {",
      "        答え.push(o.unwrap());",
      "    }",
      "    答え",
      "}"
    ]
  },
  "AHU": {
    "scope": "rust",
    "prefix": "AHU",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "use std::collections::HashMap;",
      "/// 木の同型判定（AHU アルゴリズムによる正準ラベル付け）。子の正準ラベルを整列して",
      "/// 共有辞書で番号付けすることで、衝突のない正準ラベルを与える。構築は木 1 本あたり O(N log N)。",
      "/// 木は `(頂点数, 辺リスト)` で渡す。`辺` は AtCoder の入力そのまま（0-indexed の頂点対）。",
      "/// 同じ [`木の正準化`] インスタンスへ複数の木を渡し、返り値のラベルが等しいかで同型を判定する。",
      "/// ハッシュではなく辞書による完全一致なので誤判定しない。",
      "/// - [`Self::根付きラベル`] : 根を固定した木の正準ラベル。",
      "/// - [`Self::無向ラベル`] : 根を持たない木の正準ラベル（重心で根付ける）。",
      "struct 木の正準化 {",
      "    辞書: HashMap<Vec<u64>, u64>,",
      "    次の番号: u64,",
      "}",
      "impl 木の正準化 {",
      "    fn new() -> Self {",
      "        Self {",
      "            辞書: HashMap::new(),",
      "            次の番号: 0,",
      "        }",
      "    }",
      "    /// 子ラベル列に対応する番号を引く（無ければ採番）。",
      "    fn 登録(&mut self, mut 子ラベル: Vec<u64>) -> u64 {",
      "        子ラベル.sort_unstable();",
      "        if let Some(&id) = self.辞書.get(&子ラベル) {",
      "            return id;",
      "        }",
      "        let id = self.次の番号;",
      "        self.次の番号 += 1;",
      "        self.辞書.insert(子ラベル, id);",
      "        id",
      "    }",
      "    fn 探索(&mut self, グラフ: &[Vec<usize>], now: usize, prev: usize) -> u64 {",
      "        let mut 子ラベル = Vec::new();",
      "        for &next in &グラフ[now] {",
      "            if next != prev {",
      "                子ラベル.push(self.探索(グラフ, next, now));",
      "            }",
      "        }",
      "        self.登録(子ラベル)",
      "    }",
      "    /// 根 `根` を固定した木の正準ラベルを返す。",
      "    fn 根付きラベル(&mut self, n: usize, 辺: &[(usize, usize)], 根: usize) -> u64 {",
      "        self.探索(&無向グラフ(n, 辺), 根, !0)",
      "    }",
      "    /// 根を持たない木の正準ラベル。重心（1 個または 2 個）で根付けたラベルを束ねる。",
      "    fn 無向ラベル(&mut self, n: usize, 辺: &[(usize, usize)]) -> u64 {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let 重心 = 重心列(&グラフ);",
      "        let ラベル: Vec<u64> = 重心.iter().map(|&c| self.探索(&グラフ, c, !0)).collect();",
      "        self.登録(ラベル)",
      "    }",
      "    /// 2 つの根付き木が同型か。",
      "    fn 根付き同型(",
      "        &mut self,",
      "        na: usize,",
      "        辺a: &[(usize, usize)],",
      "        根a: usize,",
      "        nb: usize,",
      "        辺b: &[(usize, usize)],",
      "        根b: usize,",
      "    ) -> bool {",
      "        self.根付きラベル(na, 辺a, 根a) == self.根付きラベル(nb, 辺b, 根b)",
      "    }",
      "    /// 2 つの無向木が同型か。",
      "    fn 無向同型(",
      "        &mut self,",
      "        na: usize,",
      "        辺a: &[(usize, usize)],",
      "        nb: usize,",
      "        辺b: &[(usize, usize)],",
      "    ) -> bool {",
      "        na == nb && self.無向ラベル(na, 辺a) == self.無向ラベル(nb, 辺b)",
      "    }",
      "}",
      "impl Default for 木の正準化 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "/// 木の重心（最大部分木が N/2 以下になる頂点）を求める。1 個または 2 個。",
      "fn 重心列(グラフ: &[Vec<usize>]) -> Vec<usize> {",
      "    let n = グラフ.len();",
      "    let mut sz = vec![0usize; n];",
      "    let mut 重心 = Vec::new();",
      "    fn dfs(",
      "        now: usize,",
      "        prev: usize,",
      "        n: usize,",
      "        グラフ: &[Vec<usize>],",
      "        sz: &mut [usize],",
      "        重心: &mut Vec<usize>,",
      "    ) {",
      "        sz[now] = 1;",
      "        let mut 最大 = 0;",
      "        for &next in &グラフ[now] {",
      "            if next == prev {",
      "                continue;",
      "            }",
      "            dfs(next, now, n, グラフ, sz, 重心);",
      "            sz[now] += sz[next];",
      "            最大 = 最大.max(sz[next]);",
      "        }",
      "        最大 = 最大.max(n - sz[now]);",
      "        if 最大 * 2 <= n {",
      "            重心.push(now);",
      "        }",
      "    }",
      "    dfs(0, !0, n, グラフ, &mut sz, &mut 重心);",
      "    重心",
      "}"
    ]
  },
  "AdaptiveSimpson": {
    "scope": "rust",
    "prefix": "AdaptiveSimpson",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 関数 `f` の区間 `[a, b]` 上の定積分を**適応的シンプソン法**で近似する。許容誤差 `許容誤差`。",
      "/// 収束していない所だけ再帰的に細かく刻む。再帰深さは最大 50。",
      "/// [`黄金分割探索`](crate::ternary_search) は凸関数の最小化で別目的。",
      "/// 幾何の面積・確率分布・物理量の累積など、閉形式が無い積分に使う。",
      "fn 数値積分<F: Fn(f64) -> f64>(f: &F, a: f64, b: f64, 許容誤差: f64) -> f64 {",
      "    fn 単純<F: Fn(f64) -> f64>(f: &F, a: f64, b: f64) -> f64 {",
      "        let c = (a + b) * 0.5;",
      "        (b - a) / 6.0 * (f(a) + 4.0 * f(c) + f(b))",
      "    }",
      "    #[allow(clippy::too_many_arguments)]",
      "    fn 再帰<F: Fn(f64) -> f64>(",
      "        f: &F, a: f64, b: f64, eps: f64, 全体: f64, 深さ: usize",
      "    ) -> f64 {",
      "        let c = (a + b) * 0.5;",
      "        let 左 = 単純(f, a, c);",
      "        let 右 = 単純(f, c, b);",
      "        let 差 = 左 + 右 - 全体;",
      "        if 深さ == 0 || 差.abs() <= 15.0 * eps {",
      "            return 左 + 右 + 差 / 15.0;",
      "        }",
      "        再帰(f, a, c, eps * 0.5, 左, 深さ - 1) + 再帰(f, c, b, eps * 0.5, 右, 深さ - 1)",
      "    }",
      "    再帰(f, a, b, 許容誤差, 単純(f, a, b), 50)",
      "}"
    ]
  },
  "AhoCorasick": {
    "scope": "rust",
    "prefix": "AhoCorasick",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::{HashMap, VecDeque};",
      "/// Aho-Corasick 法による複数パターン同時照合。バイト列（`&[u8]`）を対象とする。",
      "/// トライ + fail リンクを構築し、テキストを 1 度走査して各パターンの**出現回数**を",
      "/// まとめて数える。重なる出現も全て数える。",
      "struct エイホコラシック {",
      "    遷移: Vec<HashMap<u8, usize>>,",
      "    fail: Vec<usize>,",
      "    bfs順: Vec<usize>,",
      "    パターン終端: Vec<usize>,",
      "}",
      "impl エイホコラシック {",
      "    /// パターン群から構築する。O(Σパターン長)。空パターンは終端＝根として扱う。",
      "    fn new(パターン群: &[&[u8]]) -> Self {",
      "        let mut 遷移: Vec<HashMap<u8, usize>> = vec![HashMap::new()];",
      "        let mut パターン終端 = vec![0usize; パターン群.len()];",
      "        for (pi, pat) in パターン群.iter().enumerate() {",
      "            let mut cur = 0usize;",
      "            for &c in *pat {",
      "                if let Some(&nx) = 遷移[cur].get(&c) {",
      "                    cur = nx;",
      "                } else {",
      "                    let 新 = 遷移.len();",
      "                    遷移.push(HashMap::new());",
      "                    遷移[cur].insert(c, 新);",
      "                    cur = 新;",
      "                }",
      "            }",
      "            パターン終端[pi] = cur;",
      "        }",
      "        let mut fail = vec![0usize; 遷移.len()];",
      "        let mut bfs順 = Vec::new();",
      "        let mut 探索 = VecDeque::new();",
      "        let 直下: Vec<usize> = 遷移[0].values().copied().collect();",
      "        for next in 直下 {",
      "            fail[next] = 0;",
      "            bfs順.push(next);",
      "            探索.push_back(next);",
      "        }",
      "        while let Some(now) = 探索.pop_front() {",
      "            let 子: Vec<(u8, usize)> = 遷移[now].iter().map(|(&c, &next)| (c, next)).collect();",
      "            for (c, next) in 子 {",
      "                let mut f = fail[now];",
      "                let nf = loop {",
      "                    if let Some(&nx) = 遷移[f].get(&c) {",
      "                        break nx;",
      "                    }",
      "                    if f == 0 {",
      "                        break 0;",
      "                    }",
      "                    f = fail[f];",
      "                };",
      "                fail[next] = nf;",
      "                bfs順.push(next);",
      "                探索.push_back(next);",
      "            }",
      "        }",
      "        Self {",
      "            遷移,",
      "            fail,",
      "            bfs順,",
      "            パターン終端,",
      "        }",
      "    }",
      "    /// 文字 `c` での遷移（fail リンクを辿るオートマトン遷移）。",
      "    fn 進む(&self, mut v: usize, c: u8) -> usize {",
      "        loop {",
      "            if let Some(&nx) = self.遷移[v].get(&c) {",
      "                return nx;",
      "            }",
      "            if v == 0 {",
      "                return 0;",
      "            }",
      "            v = self.fail[v];",
      "        }",
      "    }",
      "    /// `テキスト` 中での各パターンの出現回数を、`new` に渡した順で返す。",
      "    /// O(テキスト長 + マッチ数)。",
      "    fn 出現回数(&self, テキスト: &[u8]) -> Vec<usize> {",
      "        let mut 訪問 = vec![0usize; self.遷移.len()];",
      "        let mut v = 0usize;",
      "        for &c in テキスト {",
      "            v = self.進む(v, c);",
      "            訪問[v] += 1;",
      "        }",
      "        for &node in self.bfs順.iter().rev() {",
      "            訪問[self.fail[node]] += 訪問[node];",
      "        }",
      "        self.パターン終端.iter().map(|&node| 訪問[node]).collect()",
      "    }",
      "}"
    ]
  },
  "ArbitraryModConvolution": {
    "scope": "rust",
    "prefix": "ArbitraryModConvolution",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, inv_mod, ButterflyCache, Modulus, StaticModInt};",
      "use std::cell::RefCell;",
      "use std::thread::LocalKey;",
      "/// NTT 素数 1: `167772161 = 5·2^25 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法1 {}",
      "impl Modulus for 法1 {",
      "    const VALUE: u32 = 167_772_161;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法1 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// NTT 素数 2: `469762049 = 7·2^26 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法2 {}",
      "impl Modulus for 法2 {",
      "    const VALUE: u32 = 469_762_049;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法2 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// NTT 素数 3: `1224736769 = 73·2^24 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法3 {}",
      "impl Modulus for 法3 {",
      "    const VALUE: u32 = 1_224_736_769;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法3 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// 1 つの NTT 素数 `M` 上で `a * b`（係数を `法` で還元したもの）を畳み込む。",
      "fn 単一畳み込み<M: Modulus>(a: &[u64], b: &[u64], 法: u64) -> Vec<u64> {",
      "    let fa: Vec<StaticModInt<M>> = a.iter().map(|&x| StaticModInt::new(x % 法)).collect();",
      "    let fb: Vec<StaticModInt<M>> = b.iter().map(|&x| StaticModInt::new(x % 法)).collect();",
      "    convolution(&fa, &fb)",
      "        .iter()",
      "        .map(|x| x.val() as u64)",
      "        .collect()",
      "}",
      "/// 任意の法 `法` での畳み込み `c[k] = Σ_i a[i]·b[k-i] mod 法`。O(n log n)。",
      "/// 3 つの NTT 素数で畳み込み、Garner（CRT）で厳密値を復元してから `法` を取る。",
      "/// `法` と係数が ~2·10^9 未満なら正しい（厳密値が 3 素数の積 ≈ 9.6·10^25 に収まる範囲）。",
      "/// mod が NTT 素数（998244353 等）なら `ac_library::convolution` の方が速い。",
      "fn 任意mod畳み込み(",
      "    a: &[impl TryInto<u64> + Copy],",
      "    b: &[impl TryInto<u64> + Copy],",
      "    法: impl TryInto<u64>,",
      ") -> Vec<usize> {",
      "    let a: Vec<u64> = a",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"任意mod畳み込み: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let b: Vec<u64> = b",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"任意mod畳み込み: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let (a, b) = (&a[..], &b[..]);",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"任意mod畳み込み: 引数が u64 に収まりません\");",
      "    if a.is_empty() || b.is_empty() {",
      "        return Vec::new();",
      "    }",
      "    let p1 = 法1::VALUE as i128;",
      "    let p2 = 法2::VALUE as i128;",
      "    let p3 = 法3::VALUE as i128;",
      "    let r1 = 単一畳み込み::<法1>(a, b, 法);",
      "    let r2 = 単一畳み込み::<法2>(a, b, 法);",
      "    let r3 = 単一畳み込み::<法3>(a, b, 法);",
      "    let inv_p1_mod_p2 = inv_mod(p1 as i64, p2 as i64) as i128;",
      "    let inv_p1p2_mod_p3 = inv_mod((p1 * p2 % p3) as i64, p3 as i64) as i128;",
      "    let 法i = 法 as i128;",
      "    (0..r1.len())",
      "        .map(|i| {",
      "            let a1 = r1[i] as i128;",
      "            let a2 = r2[i] as i128;",
      "            let a3 = r3[i] as i128;",
      "            let k1 = ((a2 - a1) * inv_p1_mod_p2).rem_euclid(p2);",
      "            let t = a1 + p1 * k1;",
      "            let k2 = ((a3 - t) * inv_p1p2_mod_p3).rem_euclid(p3);",
      "            let x = t + p1 * p2 * k2;",
      "            x.rem_euclid(法i) as usize",
      "        })",
      "        .collect()",
      "}"
    ]
  },
  "ArborescenceCount": {
    "scope": "rust",
    "prefix": "ArborescenceCount",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `法` 上での正方行列の行列式を掃き出し（前進消去）で求める。O(n^3)。",
      "/// `法` は**素数**であること（フェルマーの小定理で逆元を取るため）。",
      "/// 行列はムーブで受け取り破壊的に消去する。`法 < 2^31` 程度を想定。",
      "fn 行列式_mod(mut 行列: Vec<Vec<u64>>, 法: u64) -> u64 {",
      "    let n = 行列.len();",
      "    for row in &mut 行列 {",
      "        for x in row.iter_mut() {",
      "            *x %= 法;",
      "        }",
      "    }",
      "    let mut 結果 = 1u64 % 法;",
      "    for 列 in 0..n {",
      "        let ピボット = (列..n).find(|&r| 行列[r][列] != 0);",
      "        let Some(p) = ピボット else {",
      "            return 0;",
      "        };",
      "        if p != 列 {",
      "            行列.swap(p, 列);",
      "            結果 = (法 - 結果) % 法;",
      "        }",
      "        let 逆 = 累乗_mod(行列[列][列], 法 - 2, 法);",
      "        結果 = 結果 * 行列[列][列] % 法;",
      "        for r in 列 + 1..n {",
      "            let 係数 = 行列[r][列] * 逆 % 法;",
      "            if 係数 != 0 {",
      "                for c in 列..n {",
      "                    行列[r][c] = (行列[r][c] + 法 - 係数 * 行列[列][c] % 法) % 法;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    結果",
      "}",
      "/// 有向版の行列木定理（Tutte の定理）。有向グラフで、根 `根` から**葉に向かって**辺が伸びる",
      "/// 全域有向木（arborescence。根以外の各頂点の入次数がちょうど 1）の個数を `法`（素数）で数える。",
      "/// O(V^3)。",
      "/// `辺` は有向辺 `(u, v)`（`u → v`、`0..頂点数`、多重辺可・自己ループは無視）。",
      "/// 無向版 [`全域木数_mod`] と違って辺の向きを区別する。",
      "/// 「根に向かう（in-arborescence）」全域木を数えたいときは全辺を逆向きにして渡す。",
      "fn 有向全域木数_mod(頂点数: usize, 辺: &[(usize, usize)], 根: usize, 法: u64) -> u64 {",
      "    if 頂点数 == 0 {",
      "        return 0;",
      "    }",
      "    if 頂点数 == 1 {",
      "        return 1 % 法;",
      "    }",
      "    let n = 頂点数;",
      "    let mut l = vec![vec![0u64; n]; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            continue;",
      "        }",
      "        l[v][v] = (l[v][v] + 1) % 法;",
      "        l[u][v] = (l[u][v] + 法 - 1) % 法;",
      "    }",
      "    let 残: Vec<usize> = (0..n).filter(|&i| i != 根).collect();",
      "    let 小行列: Vec<Vec<u64>> = 残",
      "        .iter()",
      "        .map(|&i| 残.iter().map(|&j| l[i][j]).collect())",
      "        .collect();",
      "    行列式_mod(小行列, 法)",
      "}"
    ]
  },
  "AuxiliaryTree": {
    "scope": "rust",
    "prefix": "AuxiliaryTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 仮想木（Auxiliary Tree）。根付き木と頂点集合 `S` が与えられたとき、`S` と「`S` 内 2 頂点の LCA」だけを",
      "/// 残して縮約した木を作る。頂点数 `|S|` に対し O(|S| log |S|) で構築でき、クエリごとの木 DP を高速化する。",
      "/// 二分上昇 LCA を内包する自己完結版。",
      "/// - [`Self::lca`] : 最近共通祖先。",
      "/// - [`Self::構築`] : 頂点集合から仮想木の `(頂点リスト, 辺(親, 子))` を返す。",
      "struct 仮想木 {",
      "    上: Vec<Vec<i64>>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    log: usize,",
      "}",
      "impl 仮想木 {",
      "    /// 頂点数 `n`・辺リスト `辺`（AtCoder の入力そのまま）と根から前計算する。",
      "    fn new(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut log = 1;",
      "        while (1usize << log) < n.max(2) {",
      "            log += 1;",
      "        }",
      "        let mut 上 = vec![vec![-1i64; n]; log];",
      "        let 深さ = vec![0usize; n];",
      "        let 入時刻 = vec![0usize; n];",
      "        let 出時刻 = vec![0usize; n];",
      "        let mut d = 構築データ {",
      "            prev: std::mem::take(&mut 上[0]),",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            時刻: 0,",
      "        };",
      "        探索(根, -1, &グラフ, &mut d);",
      "        上[0] = d.prev;",
      "        let 深さ = d.深さ;",
      "        let 入時刻 = d.入時刻;",
      "        let 出時刻 = d.出時刻;",
      "        for k in 1..log {",
      "            for v in 0..n {",
      "                let 中 = 上[k - 1][v];",
      "                上[k][v] = if 中 < 0 {",
      "                    -1",
      "                } else {",
      "                    上[k - 1][中 as usize]",
      "                };",
      "            }",
      "        }",
      "        Self {",
      "            上,",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            log,",
      "        }",
      "    }",
      "    /// `a` が `b` の祖先か（自身も祖先とみなす）。",
      "    fn 祖先か(&self, a: usize, b: usize) -> bool {",
      "        self.入時刻[a] <= self.入時刻[b] && self.出時刻[b] <= self.出時刻[a]",
      "    }",
      "    /// 最近共通祖先。",
      "    fn lca(&self, mut u: usize, mut v: usize) -> usize {",
      "        if self.深さ[u] < self.深さ[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = self.深さ[u] - self.深さ[v];",
      "        for k in 0..self.log {",
      "            if (差 >> k) & 1 == 1 {",
      "                u = self.上[k][u] as usize;",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for k in (0..self.log).rev() {",
      "            if self.上[k][u] != self.上[k][v] {",
      "                u = self.上[k][u] as usize;",
      "                v = self.上[k][v] as usize;",
      "            }",
      "        }",
      "        self.上[0][u] as usize",
      "    }",
      "    /// 頂点集合から仮想木を構築し、`(頂点リスト, 辺(親, 子))` を返す。",
      "    /// 頂点リストは入時刻順。辺は親が子の祖先になる向き。",
      "    fn 構築(&self, 頂点集合: &[usize]) -> (Vec<usize>, Vec<(usize, usize)>) {",
      "        if 頂点集合.is_empty() {",
      "            return (Vec::new(), Vec::new());",
      "        }",
      "        let mut s = 頂点集合.to_vec();",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 追加 = Vec::new();",
      "        for w in s.windows(2) {",
      "            追加.push(self.lca(w[0], w[1]));",
      "        }",
      "        s.extend(追加);",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 辺 = Vec::new();",
      "        let mut スタック: Vec<usize> = Vec::new();",
      "        for &v in &s {",
      "            while let Some(&天辺) = スタック.last() {",
      "                if self.祖先か(天辺, v) {",
      "                    break;",
      "                }",
      "                スタック.pop();",
      "            }",
      "            if let Some(&天辺) = スタック.last() {",
      "                辺.push((天辺, v));",
      "            }",
      "            スタック.push(v);",
      "        }",
      "        (s, 辺)",
      "    }",
      "}",
      "/// DFS 中に埋める配列をまとめた作業領域（引数を 1 つに減らすため）。",
      "struct 構築データ {",
      "    prev: Vec<i64>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    時刻: usize,",
      "}",
      "/// 入時刻・出時刻・深さ・直接の親を埋める DFS。",
      "fn 探索(now: usize, prev: i64, グラフ: &[Vec<usize>], d: &mut 構築データ) {",
      "    d.prev[now] = prev;",
      "    d.入時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "    for &next in &グラフ[now] {",
      "        if next as i64 != prev {",
      "            d.深さ[next] = d.深さ[now] + 1;",
      "            探索(next, now as i64, グラフ, d);",
      "        }",
      "    }",
      "    d.出時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "}"
    ]
  },
  "BCC": {
    "scope": "rust",
    "prefix": "BCC",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重頂点連結成分（BCC, block）分解と block-cut 木。`lowlink`（橋・関節点の列挙のみ）とは別で、",
      "/// 辺をブロックに分割し、関節点とブロックを頂点とする木（非連結なら森）を構成する。",
      "/// - `成分[i]`: i 番目の BCC に属する元グラフ頂点の一覧（関節点は複数の BCC に現れる）。",
      "/// - `木`: block-cut 木の隣接リスト（木頂点空間）。前半 `成分数` 個が BCC、後半が関節点。",
      "/// - `関節点番号[v]`: 元頂点 `v` が関節点なら対応する木頂点番号（`>= 成分数`）、そうでなければ `None`。",
      "/// - `所属[v]`: 元頂点 `v` が属する BCC 番号の一覧。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "struct ブロックカット木 {",
      "    /// 各 BCC の頂点集合。",
      "    成分: Vec<Vec<usize>>,",
      "    /// BCC の個数。",
      "    成分数: usize,",
      "    /// block-cut 木の隣接リスト（木頂点番号空間、頂点数 = `木頂点数`）。",
      "    木: Vec<Vec<usize>>,",
      "    /// block-cut 木の頂点数（= `成分数` + 関節点数）。",
      "    木頂点数: usize,",
      "    /// 元頂点 → 関節点に対応する木頂点番号（非関節点は `None`）。",
      "    関節点番号: Vec<Option<usize>>,",
      "    /// 元頂点 → 属する BCC 番号の一覧。",
      "    所属: Vec<Vec<usize>>,",
      "}",
      "impl ブロックカット木 {",
      "    /// 関節点（複数の BCC に属する頂点）の一覧を昇順で返す。",
      "    fn 関節点一覧(&self) -> Vec<usize> {",
      "        (0..self.関節点番号.len())",
      "            .filter(|&v| self.関節点番号[v].is_some())",
      "            .collect()",
      "    }",
      "}",
      "/// 無向グラフを二重頂点連結成分に分解し block-cut 木を構成する。`辺` は多重辺・自己ループを含んでよい",
      "/// （自己ループは無視、多重辺は同じ 2 頂点の BCC を成す）。計算量 `O(n + 辺数)`。",
      "fn ブロックカット木分解(n: usize, 辺: &[(usize, usize)]) -> ブロックカット木 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut ord = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 時刻 = 0i64;",
      "    let mut 辺スタック: Vec<(usize, usize)> = Vec::new();",
      "    let mut 成分: Vec<Vec<usize>> = Vec::new();",
      "    for s in 0..n {",
      "        if ord[s] != -1 {",
      "            continue;",
      "        }",
      "        if グラフ[s].is_empty() {",
      "            成分.push(vec![s]);",
      "            ord[s] = 時刻;",
      "            時刻 += 1;",
      "            continue;",
      "        }",
      "        ord[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if ord[next] == -1 {",
      "                    ord[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    辺スタック.push((now, next));",
      "                    探索.push((next, eid as i64, 0));",
      "                } else if ord[next] < ord[now] {",
      "                    辺スタック.push((now, next));",
      "                    low[now] = low[now].min(ord[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] >= ord[prev] {",
      "                        let mut 頂点 = Vec::new();",
      "                        loop {",
      "                            let (x, y) = 辺スタック.pop().unwrap();",
      "                            頂点.push(x);",
      "                            頂点.push(y);",
      "                            if (x, y) == (prev, now) {",
      "                                break;",
      "                            }",
      "                        }",
      "                        頂点.sort_unstable();",
      "                        頂点.dedup();",
      "                        成分.push(頂点);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 成分数 = 成分.len();",
      "    let mut 所属: Vec<Vec<usize>> = vec![Vec::new(); n];",
      "    for (i, c) in 成分.iter().enumerate() {",
      "        for &v in c {",
      "            所属[v].push(i);",
      "        }",
      "    }",
      "    let mut 関節点番号 = vec![None; n];",
      "    let mut 木頂点数 = 成分数;",
      "    for (v, 番号) in 関節点番号.iter_mut().enumerate() {",
      "        if 所属[v].len() >= 2 {",
      "            *番号 = Some(木頂点数);",
      "            木頂点数 += 1;",
      "        }",
      "    }",
      "    let mut 木: Vec<Vec<usize>> = vec![Vec::new(); 木頂点数];",
      "    for (i, c) in 成分.iter().enumerate() {",
      "        for &v in c {",
      "            if let Some(a) = 関節点番号[v] {",
      "                木[i].push(a);",
      "                木[a].push(i);",
      "            }",
      "        }",
      "    }",
      "    ブロックカット木 {",
      "        成分,",
      "        成分数,",
      "        木,",
      "        木頂点数,",
      "        関節点番号,",
      "        所属,",
      "    }",
      "}"
    ]
  },
  "BSGS": {
    "scope": "rust",
    "prefix": "BSGS",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 離散対数：`a^x ≡ b (mod m)` を満たす最小の非負整数 `x` を返す（無ければ `None`）。O(√m)。",
      "/// Baby-step Giant-step 法。`gcd(a, m) ≠ 1`（`m` が合成数で `a` と互いに素でない）でも動く",
      "/// 一般版。`a`・`b` は `mod m` 前で渡してよい。`m < 2^31` 程度を想定（乗算は u64 内で完結）。",
      "/// 例：`a^x ≡ b (mod m)` の位数計算や、巡回的な遷移の到達ステップ数を求めるのに使う。",
      "fn 離散対数(a: u64, b: u64, m: u64) -> Option<u64> {",
      "    if m == 1 {",
      "        return Some(0);",
      "    }",
      "    let a = a % m;",
      "    let mut b = b % m;",
      "    let mut m = m;",
      "    let mut k = 1u64 % m;",
      "    let mut 加算 = 0u64;",
      "    loop {",
      "        let g = num::integer::gcd(a, m);",
      "        if g <= 1 {",
      "            break;",
      "        }",
      "        if k == b {",
      "            return Some(加算);",
      "        }",
      "        if b % g != 0 {",
      "            return None;",
      "        }",
      "        b /= g;",
      "        m /= g;",
      "        k = k * (a / g) % m;",
      "        加算 += 1;",
      "    }",
      "    let n = (m as f64).sqrt() as u64 + 1;",
      "    let mut an = 1u64 % m;",
      "    for _ in 0..n {",
      "        an = an * (a % m) % m;",
      "    }",
      "    let mut テーブル: HashMap<u64, u64> = HashMap::new();",
      "    let mut cur = b % m;",
      "    for q in 0..=n {",
      "        テーブル.insert(cur, q);",
      "        cur = cur * (a % m) % m;",
      "    }",
      "    let mut cur = k;",
      "    for p in 1..=n {",
      "        cur = cur * an % m;",
      "        if let Some(&q) = テーブル.get(&cur) {",
      "            return Some(n * p - q + 加算);",
      "        }",
      "    }",
      "    None",
      "}"
    ]
  },
  "Bernoulli": {
    "scope": "rust",
    "prefix": "Bernoulli",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 素数 `法` を法とする `a` の逆元（フェルマーの小定理 `a^(法-2)`）。`O(log 法)`。",
      "/// `法` が素数で `a % 法 != 0` であることが前提。合成数を法とする場合や `a` が",
      "/// `法` の倍数の場合は正しい値を返さない（拡張ユークリッドを使うこと）。",
      "fn 逆元(a: u64, 法: u64) -> u64 {",
      "    累乗_mod(a, 法 - 2, 法)",
      "}",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// `0..=上限` の階乗・逆階乗を素数 `法` 上で返す内部関数（二項係数用）。",
      "fn 階乗表(上限: usize, 法: u64) -> (Vec<u64>, Vec<u64>) {",
      "    let mut 階乗 = vec![1u64; 上限 + 1];",
      "    for i in 1..=上限 {",
      "        階乗[i] = 階乗[i - 1] * i as u64 % 法;",
      "    }",
      "    let mut 逆階乗 = vec![1u64; 上限 + 1];",
      "    逆階乗[上限] = 逆元(階乗[上限], 法);",
      "    for i in (0..上限).rev() {",
      "        逆階乗[i] = 逆階乗[i + 1] * (i as u64 + 1) % 法;",
      "    }",
      "    (階乗, 逆階乗)",
      "}",
      "/// ベルヌーイ数 `B_0, B_1, …, B_k` を素数 `法` 上で返す（`B_1 = -1/2` の規約）。`O(k^2)`。",
      "/// 累乗和（Faulhaber 公式）の係数として使う。",
      "fn ベルヌーイ数(k: usize, 法: impl TryInto<u64>) -> Vec<usize> {",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ベルヌーイ数: 引数が u64 に収まりません\");",
      "    let (階乗, 逆階乗) = 階乗表(k + 1, 法);",
      "    let 二項 = |n: usize, r: usize| -> u64 {",
      "        if r > n {",
      "            0",
      "        } else {",
      "            階乗[n] * 逆階乗[r] % 法 * 逆階乗[n - r] % 法",
      "        }",
      "    };",
      "    let mut b = vec![0u64; k + 1];",
      "    b[0] = 1 % 法;",
      "    for m in 1..=k {",
      "        let mut s = 0u64;",
      "        for (j, &bj) in b.iter().enumerate().take(m) {",
      "            s = (s + 二項(m + 1, j) * bj) % 法;",
      "        }",
      "        let 逆 = 逆元((m as u64 + 1) % 法, 法);",
      "        b[m] = (法 - s) % 法 * 逆 % 法;",
      "    }",
      "    b.into_iter().map(|x| x as usize).collect()",
      "}"
    ]
  },
  "BinaryTrie": {
    "scope": "rust",
    "prefix": "BinaryTrie",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_u64(x: impl TryInto<u64>) -> u64 {",
      "    x.try_into().ok().expect(\"u64 に収まりません\")",
      "}",
      "/// 二進トライ（binary trie）。非負整数の多重集合を二進表現の木で管理し、挿入・削除・",
      "/// 「指定値 `x` との XOR の最大／最小」「k 番目に小さい値」「`x` 以下の個数」などを各 `O(ビット数)` で行う。",
      "/// `xor_basis`（線形基底）は「部分集合の XOR で作れる最大値」を扱うのに対し、こちらは",
      "/// **格納済み要素そのもの**との XOR 最適化や順位クエリを行う別物。",
      "/// `挿入` した値の上位 `ビット数` ビットのみを見るので、扱う値域に合わせて `ビット数` を決める。",
      "/// XOR を使わず k 番目・順位だけが目的なら [`ソート済み多重集合`](crate::sorted_multiset::ソート済み多重集合)",
      "/// を使う（負の値や整数以外も載り、メモリも軽く速い）。",
      "struct 二進トライ {",
      "    ビット数: usize,",
      "    子: Vec<[Option<usize>; 2]>,",
      "    通過数: Vec<usize>,",
      "}",
      "impl 二進トライ {",
      "    /// `ビット数` ビット幅（`0..2^ビット数` の値）の空トライを作る。",
      "    fn new(ビット数: usize) -> Self {",
      "        Self {",
      "            ビット数,",
      "            子: vec![[None, None]],",
      "            通過数: vec![0],",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個追加する。",
      "    fn 挿入(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] += 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = match self.子[v][ビット] {",
      "                Some(次) => 次,",
      "                None => {",
      "                    let 新 = self.子.len();",
      "                    self.子.push([None, None]);",
      "                    self.通過数.push(0);",
      "                    self.子[v][ビット] = Some(新);",
      "                    新",
      "                }",
      "            };",
      "            self.通過数[v] += 1;",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個削除する（存在する前提）。木構造は保持し、通過数のみ減らす。",
      "    fn 削除(&mut self, x: impl TryInto<u64>) {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        self.通過数[0] -= 1;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            v = self.子[v][ビット].unwrap();",
      "            self.通過数[v] -= 1;",
      "        }",
      "    }",
      "    /// 格納されている要素の総数。",
      "    fn 個数(&self) -> usize {",
      "        self.通過数[0]",
      "    }",
      "    /// 値 `x` が格納されている個数。",
      "    fn 含む個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 0,",
      "            }",
      "        }",
      "        self.通過数[v]",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最大化する `x ^ y` を返す（空でないこと）。",
      "    fn 最大xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            let 望み = ビット ^ 1;",
      "            match self.子[v][望み] {",
      "                Some(c) if self.通過数[c] > 0 => {",
      "                    結果 |= 1 << b;",
      "                    v = c;",
      "                }",
      "                _ => v = self.子[v][ビット].unwrap(),",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 格納済みのいずれかの要素 `y` との `x ^ y` を最小化する `x ^ y` を返す（空でないこと）。",
      "    fn 最小xor(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => {",
      "                    結果 |= 1 << b;",
      "                    v = self.子[v][ビット ^ 1].unwrap();",
      "                }",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// 0 始まりで `k` 番目に小さい値を返す（多重度込み、`0 <= k < 個数`）。",
      "    fn k番目(&self, mut k: usize) -> usize {",
      "        let mut v = 0usize;",
      "        let mut 結果 = 0u64;",
      "        for b in (0..self.ビット数).rev() {",
      "            let c0 = self.子[v][0];",
      "            let 左 = c0.map_or(0, |c| self.通過数[c]);",
      "            if k < 左 {",
      "                v = c0.unwrap();",
      "            } else {",
      "                k -= 左;",
      "                結果 |= 1 << b;",
      "                v = self.子[v][1].unwrap();",
      "            }",
      "        }",
      "        結果 as usize",
      "    }",
      "    /// `x` 以下の格納要素の個数（多重度込み）。",
      "    fn 以下の個数(&self, x: impl TryInto<u64>) -> usize {",
      "        let x = to_u64(x);",
      "        let mut v = 0usize;",
      "        let mut 個数 = 0usize;",
      "        for b in (0..self.ビット数).rev() {",
      "            let ビット = ((x >> b) & 1) as usize;",
      "            if ビット == 1 {",
      "                if let Some(c0) = self.子[v][0] {",
      "                    個数 += self.通過数[c0];",
      "                }",
      "            }",
      "            match self.子[v][ビット] {",
      "                Some(c) if self.通過数[c] > 0 => v = c,",
      "                _ => return 個数,",
      "            }",
      "        }",
      "        個数 + self.通過数[v]",
      "    }",
      "}"
    ]
  },
  "BlockCutTree": {
    "scope": "rust",
    "prefix": "BlockCutTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重頂点連結成分（BCC, block）分解と block-cut 木。`lowlink`（橋・関節点の列挙のみ）とは別で、",
      "/// 辺をブロックに分割し、関節点とブロックを頂点とする木（非連結なら森）を構成する。",
      "/// - `成分[i]`: i 番目の BCC に属する元グラフ頂点の一覧（関節点は複数の BCC に現れる）。",
      "/// - `木`: block-cut 木の隣接リスト（木頂点空間）。前半 `成分数` 個が BCC、後半が関節点。",
      "/// - `関節点番号[v]`: 元頂点 `v` が関節点なら対応する木頂点番号（`>= 成分数`）、そうでなければ `None`。",
      "/// - `所属[v]`: 元頂点 `v` が属する BCC 番号の一覧。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "struct ブロックカット木 {",
      "    /// 各 BCC の頂点集合。",
      "    成分: Vec<Vec<usize>>,",
      "    /// BCC の個数。",
      "    成分数: usize,",
      "    /// block-cut 木の隣接リスト（木頂点番号空間、頂点数 = `木頂点数`）。",
      "    木: Vec<Vec<usize>>,",
      "    /// block-cut 木の頂点数（= `成分数` + 関節点数）。",
      "    木頂点数: usize,",
      "    /// 元頂点 → 関節点に対応する木頂点番号（非関節点は `None`）。",
      "    関節点番号: Vec<Option<usize>>,",
      "    /// 元頂点 → 属する BCC 番号の一覧。",
      "    所属: Vec<Vec<usize>>,",
      "}",
      "impl ブロックカット木 {",
      "    /// 関節点（複数の BCC に属する頂点）の一覧を昇順で返す。",
      "    fn 関節点一覧(&self) -> Vec<usize> {",
      "        (0..self.関節点番号.len())",
      "            .filter(|&v| self.関節点番号[v].is_some())",
      "            .collect()",
      "    }",
      "}",
      "/// 無向グラフを二重頂点連結成分に分解し block-cut 木を構成する。`辺` は多重辺・自己ループを含んでよい",
      "/// （自己ループは無視、多重辺は同じ 2 頂点の BCC を成す）。計算量 `O(n + 辺数)`。",
      "fn ブロックカット木分解(n: usize, 辺: &[(usize, usize)]) -> ブロックカット木 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut ord = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 時刻 = 0i64;",
      "    let mut 辺スタック: Vec<(usize, usize)> = Vec::new();",
      "    let mut 成分: Vec<Vec<usize>> = Vec::new();",
      "    for s in 0..n {",
      "        if ord[s] != -1 {",
      "            continue;",
      "        }",
      "        if グラフ[s].is_empty() {",
      "            成分.push(vec![s]);",
      "            ord[s] = 時刻;",
      "            時刻 += 1;",
      "            continue;",
      "        }",
      "        ord[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if ord[next] == -1 {",
      "                    ord[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    辺スタック.push((now, next));",
      "                    探索.push((next, eid as i64, 0));",
      "                } else if ord[next] < ord[now] {",
      "                    辺スタック.push((now, next));",
      "                    low[now] = low[now].min(ord[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] >= ord[prev] {",
      "                        let mut 頂点 = Vec::new();",
      "                        loop {",
      "                            let (x, y) = 辺スタック.pop().unwrap();",
      "                            頂点.push(x);",
      "                            頂点.push(y);",
      "                            if (x, y) == (prev, now) {",
      "                                break;",
      "                            }",
      "                        }",
      "                        頂点.sort_unstable();",
      "                        頂点.dedup();",
      "                        成分.push(頂点);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 成分数 = 成分.len();",
      "    let mut 所属: Vec<Vec<usize>> = vec![Vec::new(); n];",
      "    for (i, c) in 成分.iter().enumerate() {",
      "        for &v in c {",
      "            所属[v].push(i);",
      "        }",
      "    }",
      "    let mut 関節点番号 = vec![None; n];",
      "    let mut 木頂点数 = 成分数;",
      "    for (v, 番号) in 関節点番号.iter_mut().enumerate() {",
      "        if 所属[v].len() >= 2 {",
      "            *番号 = Some(木頂点数);",
      "            木頂点数 += 1;",
      "        }",
      "    }",
      "    let mut 木: Vec<Vec<usize>> = vec![Vec::new(); 木頂点数];",
      "    for (i, c) in 成分.iter().enumerate() {",
      "        for &v in c {",
      "            if let Some(a) = 関節点番号[v] {",
      "                木[i].push(a);",
      "                木[a].push(i);",
      "            }",
      "        }",
      "    }",
      "    ブロックカット木 {",
      "        成分,",
      "        成分数,",
      "        木,",
      "        木頂点数,",
      "        関節点番号,",
      "        所属,",
      "    }",
      "}"
    ]
  },
  "Blossom": {
    "scope": "rust",
    "prefix": "Blossom",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 一般グラフ（二部とは限らない、奇閉路を含んでよい）の最大マッチング。O(V·E)。",
      "/// 二部グラフに限るなら [`crate::hopcroft_karp`] の方が高速。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に相手も保持）。",
      "/// - [`Self::相手一覧`] : 各頂点の相手（未マッチは -1）。",
      "struct 一般マッチング {",
      "    n: usize,",
      "    辺: Vec<(usize, usize)>,",
      "    相手: Vec<i64>,",
      "}",
      "impl 一般マッチング {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            辺: Vec::new(),",
      "            相手: vec![-1; n],",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.辺.push((u, v));",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut g = petgraph::graph::UnGraph::<(), ()>::new_undirected();",
      "        let 節: Vec<petgraph::graph::NodeIndex> = (0..self.n).map(|_| g.add_node(())).collect();",
      "        for &(u, v) in &self.辺 {",
      "            g.add_edge(節[u], 節[v], ());",
      "        }",
      "        let マッチング = petgraph::algo::maximum_matching(&g);",
      "        self.相手 = vec![-1; self.n];",
      "        let mut 本数 = 0;",
      "        for (a, b) in マッチング.edges() {",
      "            self.相手[a.index()] = b.index() as i64;",
      "            self.相手[b.index()] = a.index() as i64;",
      "            本数 += 1;",
      "        }",
      "        本数",
      "    }",
      "    /// 各頂点の相手（未マッチは -1）。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn 相手一覧(&self) -> &[i64] {",
      "        &self.相手",
      "    }",
      "}"
    ]
  },
  "Booth": {
    "scope": "rust",
    "prefix": "Booth",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最小回転（Booth のアルゴリズム）。列 `s` の巡回シフトのうち辞書順最小になるものの開始位置を",
      "/// `O(n)` で返す。`s[k..] ++ s[..k]` が最小の回転。空列なら `0`。",
      "/// 文字列の「最小表現（canonical form）」を取って同型判定する用途で頻出。",
      "/// 比較できる任意の要素列に使える。",
      "fn 最小回転<T: Ord>(s: &[T]) -> usize {",
      "    let n = s.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let c = |idx: usize| &s[idx % n];",
      "    let mut f: Vec<i64> = vec![-1; 2 * n];",
      "    let mut k: usize = 0;",
      "    for j in 1..2 * n {",
      "        let sj = c(j);",
      "        let mut i = f[j - k - 1];",
      "        while i != -1 && sj != c(k + i as usize + 1) {",
      "            if sj < c(k + i as usize + 1) {",
      "                k = j - i as usize - 1;",
      "            }",
      "            i = f[i as usize];",
      "        }",
      "        if sj != c(k + (i + 1) as usize) {",
      "            if sj < c(k + (i + 1) as usize) {",
      "                k = j;",
      "            }",
      "            f[j - k] = -1;",
      "        } else {",
      "            f[j - k] = i + 1;",
      "        }",
      "    }",
      "    k",
      "}"
    ]
  },
  "BoundedFlow": {
    "scope": "rust",
    "prefix": "BoundedFlow",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// 各辺に流量の**下限・上限**を課したネットワークで、`s` から `t` への最大流を求める。",
      "/// 内部は [`ac_library::MfGraph`] の Dinic なので `O(V²E)`。",
      "/// 下限を満たす循環の存在判定（実行可能流）も同時に得られる。",
      "struct 下限付き最大流 {",
      "    n: usize,",
      "    辺: Vec<(usize, usize, i64, i64)>,",
      "}",
      "impl 下限付き最大流 {",
      "    /// 頂点数 `n` の空ネットワークを作る。",
      "    fn new(n: usize) -> Self {",
      "        下限付き最大流 { n, 辺: Vec::new() }",
      "    }",
      "    /// 辺 `from → to` を下限 `下限`・上限 `上限`（`0 ≤ 下限 ≤ 上限`）で追加し、その辺番号を返す。",
      "    fn 辺追加(",
      "        &mut self,",
      "        from: usize,",
      "        to: usize,",
      "        下限: impl TryInto<i64>,",
      "        上限: impl TryInto<i64>,",
      "    ) -> usize {",
      "        let (下限, 上限) = (to_i64(下限), to_i64(上限));",
      "        assert!(from < self.n && to < self.n);",
      "        assert!(0 <= 下限 && 下限 <= 上限);",
      "        let id = self.辺.len();",
      "        self.辺.push((from, to, 下限, 上限));",
      "        id",
      "    }",
      "    /// `s → t` の最大流を解く。実行可能なら `Some((最大流量, 各辺の流量))`、",
      "    /// 下限を満たす流が存在しなければ `None`。各辺の流量は [`辺追加`](Self::辺追加) の順。",
      "    fn 解く(&self, s: usize, t: usize) -> Option<(i64, Vec<i64>)> {",
      "        use ac_library::MfGraph;",
      "        const INF: i64 = 1 << 60;",
      "        let n = self.n;",
      "        let (超源, 超匯) = (n, n + 1);",
      "        let mut g = MfGraph::<i64>::new(n + 2);",
      "        let mut 辺id = Vec::with_capacity(self.辺.len());",
      "        let mut d = vec![0i64; n];",
      "        for &(u, v, lo, cap) in &self.辺 {",
      "            辺id.push(g.add_edge(u, v, cap - lo));",
      "            d[u] -= lo;",
      "            d[v] += lo;",
      "        }",
      "        let 戻り = g.add_edge(t, s, INF);",
      "        let mut 必要 = 0i64;",
      "        for (v, &dv) in d.iter().enumerate() {",
      "            if dv > 0 {",
      "                g.add_edge(超源, v, dv);",
      "                必要 += dv;",
      "            } else if dv < 0 {",
      "                g.add_edge(v, 超匯, -dv);",
      "            }",
      "        }",
      "        if g.flow(超源, 超匯) != 必要 {",
      "            return None;",
      "        }",
      "        let f0 = g.get_edge(戻り).flow;",
      "        g.change_edge(戻り, 0, 0);",
      "        let 追加 = g.flow(s, t);",
      "        let 値 = f0 + 追加;",
      "        let flows = self",
      "            .辺",
      "            .iter()",
      "            .zip(&辺id)",
      "            .map(|(&(_, _, lo, _), &id)| lo + g.get_edge(id).flow)",
      "            .collect();",
      "        Some((値, flows))",
      "    }",
      "}"
    ]
  },
  "BoundedKnapsack": {
    "scope": "rust",
    "prefix": "BoundedKnapsack",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 個数制限付きナップサック。各品物 `(重さ, 価値, 個数)` を `0..=個数` 個まで使い、総重量が `容量`",
      "/// 以下で価値和を最大化する。O(N·容量)。",
      "/// 単調デックを使うので計算量は `個数` に依存しない。各 1 個までなら [`ナップサック`]、",
      "/// 無制限なら [`個数制限なしナップサック`]。",
      "fn 個数制限付きナップサック(品物: &[(usize, i64, usize)], 容量: usize) -> i64 {",
      "    use std::collections::VecDeque;",
      "    let mut dp = vec![0i64; 容量 + 1];",
      "    for &(w, v, c) in 品物 {",
      "        if c == 0 {",
      "            continue;",
      "        }",
      "        if w == 0 {",
      "            if v > 0 {",
      "                let 加算 = v * c as i64;",
      "                for x in dp.iter_mut() {",
      "                    *x += 加算;",
      "                }",
      "            }",
      "            continue;",
      "        }",
      "        let 旧 = dp.clone();",
      "        for r in 0..w {",
      "            if r > 容量 {",
      "                break;",
      "            }",
      "            let mut デック: VecDeque<usize> = VecDeque::new();",
      "            let mut k = 0usize;",
      "            while r + k * w <= 容量 {",
      "                let h = 旧[r + k * w] - (k as i64) * v;",
      "                while let Some(&b) = デック.back() {",
      "                    let hb = 旧[r + b * w] - (b as i64) * v;",
      "                    if hb <= h {",
      "                        デック.pop_back();",
      "                    } else {",
      "                        break;",
      "                    }",
      "                }",
      "                デック.push_back(k);",
      "                while let Some(&前) = デック.front() {",
      "                    if 前 + c < k {",
      "                        デック.pop_front();",
      "                    } else {",
      "                        break;",
      "                    }",
      "                }",
      "                let &先頭 = デック.front().unwrap();",
      "                let 最大h = 旧[r + 先頭 * w] - (先頭 as i64) * v;",
      "                dp[r + k * w] = 最大h + (k as i64) * v;",
      "                k += 1;",
      "            }",
      "        }",
      "    }",
      "    dp[容量]",
      "}"
    ]
  },
  "BridgeTree": {
    "scope": "rust",
    "prefix": "BridgeTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重辺連結成分分解の結果。`成分[v]` は頂点 `v` の属する二重辺連結成分の番号、`成分数` はその個数。",
      "/// `橋` は橋（取り除くと連結成分が増える辺）の一覧、`木` は成分を頂点とする**橋森**（橋でつないだ森）。",
      "struct 二重辺連結成分 {",
      "    /// 頂点 → 成分番号。",
      "    成分: Vec<usize>,",
      "    /// 成分の個数。",
      "    成分数: usize,",
      "    /// 橋の一覧（`(u, v)`、`u` は DFS 木で親側）。",
      "    橋: Vec<(usize, usize)>,",
      "    /// 橋森。`木[c]` は成分 `c` と橋で隣接する成分の一覧。",
      "    木: Vec<Vec<usize>>,",
      "}",
      "/// 無向グラフを二重辺連結成分（どの 1 辺を取り除いても連結が保たれる極大頂点集合）に分解し、",
      "/// 橋を縮約した**橋森**を返す。`lowlink`（橋・関節点の列挙）とは別で、成分分解と縮約木まで構成する。",
      "/// `辺` は多重辺・自己ループを含んでよい（並行辺は橋にならない／自己ループは無視）。計算量 `O(n + 辺数)`。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "fn 二重辺連結成分分解(n: usize, 辺: &[(usize, usize)]) -> 二重辺連結成分 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut 番号 = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 橋辺 = vec![false; 辺.len()];",
      "    let mut 橋 = Vec::new();",
      "    let mut 時刻 = 0i64;",
      "    for s in 0..n {",
      "        if 番号[s] != -1 {",
      "            continue;",
      "        }",
      "        番号[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if 番号[next] == -1 {",
      "                    番号[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    探索.push((next, eid as i64, 0));",
      "                } else {",
      "                    low[now] = low[now].min(番号[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] > 番号[prev] {",
      "                        橋辺[親辺 as usize] = true;",
      "                        橋.push((prev, now));",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 成分 = vec![!0; n];",
      "    let mut 成分数 = 0;",
      "    for s in 0..n {",
      "        if 成分[s] != !0 {",
      "            continue;",
      "        }",
      "        成分[s] = 成分数;",
      "        let mut 探索 = vec![s];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, eid) in &グラフ[now] {",
      "                if !橋辺[eid] && 成分[next] == !0 {",
      "                    成分[next] = 成分数;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        成分数 += 1;",
      "    }",
      "    let mut 木 = vec![Vec::new(); 成分数];",
      "    for &(a, b) in &橋 {",
      "        let (x, y) = (成分[a], 成分[b]);",
      "        木[x].push(y);",
      "        木[y].push(x);",
      "    }",
      "    二重辺連結成分 {",
      "        成分,",
      "        成分数,",
      "        橋,",
      "        木,",
      "    }",
      "}"
    ]
  },
  "BronKerbosch": {
    "scope": "rust",
    "prefix": "BronKerbosch",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最大クリーク（完全部分グラフ）を Bron–Kerbosch 法（ピボット付き）で求める。頂点数 `n <= 64`。",
      "/// ビットマスクで近傍を持ち、実用的には数十頂点まで高速（最悪 O(3^{n/3})）。",
      "/// [`Self::最大独立集合`] は補グラフの最大クリークとして同じ実装で求まる。",
      "struct 最大クリーク探索 {",
      "    n: usize,",
      "    グラフ: Vec<u64>,",
      "}",
      "impl 最大クリーク探索 {",
      "    /// 頂点数 `n`（`<= 64`）の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        assert!(n <= 64, \"n must be <= 64\");",
      "        Self {",
      "            n,",
      "            グラフ: vec![0u64; n],",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        if u != v {",
      "            self.グラフ[u] |= 1 << v;",
      "            self.グラフ[v] |= 1 << u;",
      "        }",
      "    }",
      "    /// 最大クリークの頂点集合を返す。",
      "    fn 最大クリーク(&self) -> Vec<usize> {",
      "        let 全 = if self.n == 64 {",
      "            u64::MAX",
      "        } else {",
      "            (1u64 << self.n) - 1",
      "        };",
      "        let mut 最良 = 0u64;",
      "        self.探索(0, 全, 0, &mut 最良);",
      "        ビット列(最良)",
      "    }",
      "    /// 最大独立集合の頂点集合を返す（補グラフの最大クリーク）。",
      "    fn 最大独立集合(&self) -> Vec<usize> {",
      "        let 全 = if self.n == 64 {",
      "            u64::MAX",
      "        } else {",
      "            (1u64 << self.n) - 1",
      "        };",
      "        let mut 補 = 最大クリーク探索::new(self.n);",
      "        for v in 0..self.n {",
      "            補.グラフ[v] = !self.グラフ[v] & 全 & !(1u64 << v);",
      "        }",
      "        let mut 最良 = 0u64;",
      "        補.探索(0, 全, 0, &mut 最良);",
      "        ビット列(最良)",
      "    }",
      "    /// Bron–Kerbosch（ピボット付き）。`r` 現在のクリーク、`p` 候補、`x` 除外済み。",
      "    fn 探索(&self, r: u64, p: u64, x: u64, 最良: &mut u64) {",
      "        if p == 0 && x == 0 {",
      "            if r.count_ones() > 最良.count_ones() {",
      "                *最良 = r;",
      "            }",
      "            return;",
      "        }",
      "        if r.count_ones() + p.count_ones() <= 最良.count_ones() {",
      "            return;",
      "        }",
      "        let mut ピボット候補 = p | x;",
      "        let mut ピボット = 0usize;",
      "        let mut 最多 = -1i64;",
      "        while ピボット候補 != 0 {",
      "            let v = ピボット候補.trailing_zeros() as usize;",
      "            ピボット候補 &= ピボット候補 - 1;",
      "            let c = (p & self.グラフ[v]).count_ones() as i64;",
      "            if c > 最多 {",
      "                最多 = c;",
      "                ピボット = v;",
      "            }",
      "        }",
      "        let mut 候補 = p & !self.グラフ[ピボット];",
      "        let mut p = p;",
      "        let mut x = x;",
      "        while 候補 != 0 {",
      "            let v = 候補.trailing_zeros() as usize;",
      "            let ビット = 1u64 << v;",
      "            候補 &= 候補 - 1;",
      "            self.探索(r | ビット, p & self.グラフ[v], x & self.グラフ[v], 最良);",
      "            p &= !ビット;",
      "            x |= ビット;",
      "        }",
      "    }",
      "}",
      "/// ビットマスクを立っている添字の昇順 `Vec` に変換する。",
      "fn ビット列(mut m: u64) -> Vec<usize> {",
      "    let mut v = Vec::new();",
      "    while m != 0 {",
      "        v.push(m.trailing_zeros() as usize);",
      "        m &= m - 1;",
      "    }",
      "    v",
      "}"
    ]
  },
  "CHT": {
    "scope": "rust",
    "prefix": "CHT",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Convex Hull Trick（CHT, 最小クエリ版）。直線 `y = 傾き·x + 切片` を複数追加し、",
      "/// 与えた `x` での最小値を高速に求める。DP の `min_j (a_j·x + b_j)` 型の高速化に使う。",
      "/// 追加する直線の傾きは **単調非増加** の順で渡すこと（追加は償却 O(1)）。",
      "/// クエリ `x` は任意で、凸性を使った二分探索で O(log 本数)。",
      "/// 最大値が欲しいときは全ての `傾き`・`切片` の符号を反転して入れ、結果を反転する。",
      "/// 評価は i64 素のまま行うので `傾き·x + 切片` が i64 に収まる範囲で使うこと",
      "/// （直線の不要判定は i128 で行うため安全）。",
      "struct ConvexHullTrick {",
      "    直線: Vec<(i64, i64)>,",
      "}",
      "impl Default for ConvexHullTrick {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "impl ConvexHullTrick {",
      "    /// 空の直線集合を作る。",
      "    fn new() -> Self {",
      "        Self { 直線: Vec::new() }",
      "    }",
      "    fn 不要(l1: (i64, i64), l2: (i64, i64), l3: (i64, i64)) -> bool {",
      "        (l3.1 as i128 - l1.1 as i128) * (l1.0 as i128 - l2.0 as i128)",
      "            <= (l2.1 as i128 - l1.1 as i128) * (l1.0 as i128 - l3.0 as i128)",
      "    }",
      "    /// 直線 `y = 傾き·x + 切片` を追加する。傾きは単調非増加の順で渡すこと。",
      "    /// 引数は任意の整数型でよい（[`Self::最小値`] も同様）。",
      "    fn 直線追加(&mut self, 傾き: impl TryInto<i64>, 切片: impl TryInto<i64>) {",
      "        let l = (to_i64(傾き), to_i64(切片));",
      "        while self.直線.len() >= 2 {",
      "            let n = self.直線.len();",
      "            if Self::不要(self.直線[n - 2], self.直線[n - 1], l) {",
      "                self.直線.pop();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        self.直線.push(l);",
      "    }",
      "    fn 評価(l: (i64, i64), x: i64) -> i64 {",
      "        l.0 * x + l.1",
      "    }",
      "    /// `x` における全直線の最小値。直線が 1 本も無いときは呼ばないこと。",
      "    fn 最小値(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        debug_assert!(!self.直線.is_empty(), \"CHT: 直線が空です\");",
      "        let (mut lo, mut hi) = (0usize, self.直線.len() - 1);",
      "        while lo < hi {",
      "            let m = (lo + hi) / 2;",
      "            if Self::評価(self.直線[m], x) > Self::評価(self.直線[m + 1], x) {",
      "                lo = m + 1;",
      "            } else {",
      "                hi = m;",
      "            }",
      "        }",
      "        Self::評価(self.直線[lo], x)",
      "    }",
      "}"
    ]
  },
  "CartesianTree": {
    "scope": "rust",
    "prefix": "CartesianTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 配列からデカルト木（Cartesian tree）を O(N) で構築する。返り値は `(親配列, 根)`。",
      "/// 親配列の根は `-1`。値が等しいときは添字の小さい方を祖先（根側）にする最小ヒープ版。",
      "/// デカルト木は「中順走査が元の配列順」かつ「親の値 <= 子の値（最小ヒープ）」を満たす二分木で、",
      "/// 区間最小値クエリ（RMQ）を LCA に帰着したり、ヒストグラム最大長方形・単調スタック系の問題に使える。",
      "/// 要素型 `T` は順序比較できる型なら何でもよい（`i64`・`f64` など `PartialOrd`）。",
      "fn デカルト木<T: PartialOrd>(a: &[T]) -> (Vec<i64>, usize) {",
      "    let n = a.len();",
      "    let mut prev = vec![-1i64; n];",
      "    let mut スタック: Vec<usize> = Vec::new();",
      "    for i in 0..n {",
      "        let mut 直前 = -1i64;",
      "        while let Some(&天) = スタック.last() {",
      "            if a[天] <= a[i] {",
      "                break;",
      "            }",
      "            直前 = 天 as i64;",
      "            スタック.pop();",
      "        }",
      "        if 直前 != -1 {",
      "            prev[直前 as usize] = i as i64;",
      "        }",
      "        if let Some(&天) = スタック.last() {",
      "            prev[i] = 天 as i64;",
      "        }",
      "        スタック.push(i);",
      "    }",
      "    let 根 = (0..n).find(|&i| prev[i] == -1).unwrap_or(0);",
      "    (prev, 根)",
      "}"
    ]
  },
  "CentroidDecomposition": {
    "scope": "rust",
    "prefix": "CentroidDecomposition",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木の重心分解。各頂点の「重心木」での親を返す（根は `!0`）。O(N log N)。",
      "/// `辺` は 0-indexed の頂点対（AtCoder の入力そのまま）。返り値 `重心親[v]` は、",
      "/// 重心分解で得られる木構造における `v` の親頂点。重心木の深さは O(log N) に収まるため、",
      "/// 「2 頂点間のパスは必ず両者の重心木祖先のいずれかを通る」性質を使ったパスクエリの",
      "/// 分割統治に用いる。連結な木を前提とする。",
      "fn 重心分解(n: usize, 辺: &[(usize, usize)]) -> Vec<usize> {",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut 重心親 = vec![!0; n];",
      "    let mut 削除済 = vec![false; n];",
      "    let mut sz = vec![0usize; n];",
      "    let mut 作業 = vec![(0usize, !0)];",
      "    let mut 順 = Vec::new();",
      "    let mut prev = vec![!0; n];",
      "    while let Some((開始, 重心木親)) = 作業.pop() {",
      "        順.clear();",
      "        prev[開始] = !0;",
      "        let mut 探索 = vec![開始];",
      "        while let Some(now) = 探索.pop() {",
      "            順.push(now);",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] && !削除済[next] {",
      "                    prev[next] = now;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        let 全体 = 順.len();",
      "        for &now in 順.iter().rev() {",
      "            sz[now] = 1;",
      "            for &next in &グラフ[now] {",
      "                if next != prev[now] && !削除済[next] {",
      "                    sz[now] += sz[next];",
      "                }",
      "            }",
      "        }",
      "        let mut 重心 = 開始;",
      "        let mut 前 = !0;",
      "        loop {",
      "            let mut 次 = !0;",
      "            for &v in &グラフ[重心] {",
      "                if v != 前 && !削除済[v] && sz[v] * 2 > 全体 {",
      "                    次 = v;",
      "                    break;",
      "                }",
      "            }",
      "            if 次 == !0 {",
      "                break;",
      "            }",
      "            sz[重心] = 全体 - sz[次];",
      "            前 = 重心;",
      "            重心 = 次;",
      "        }",
      "        重心親[重心] = 重心木親;",
      "        削除済[重心] = true;",
      "        for &next in &グラフ[重心] {",
      "            if !削除済[next] {",
      "                作業.push((next, 重心));",
      "            }",
      "        }",
      "    }",
      "    重心親",
      "}"
    ]
  },
