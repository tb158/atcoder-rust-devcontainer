  "ハンガリアン_法": {
    "scope": "rust",
    "prefix": "ハンガリアン_法",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ハンガリアン法（Kuhn–Munkres）で割当問題（最小重み完全マッチング）を解く。`O(n²m)`。",
      "/// `コスト[i][j]` を行 `i`・列 `j` の費用とし、各行に相異なる列を割り当てて総費用を最小化する。",
      "/// 行数 `n <= 列数 m` であること（足りない列があると割り当て不能）。費用は負でもよい。",
      "/// 返り値は `(最小総費用, 割当)`。`割当[i]` は行 `i` に割り当てられた列（0 始まり）。",
      "fn 割当問題(コスト: &[Vec<i64>]) -> (i64, Vec<usize>) {",
      "    let n = コスト.len();",
      "    if n == 0 {",
      "        return (0, Vec::new());",
      "    }",
      "    assert!(",
      "        コスト[0].len() >= n,",
      "        \"ハンガリアン法: 列数は行数以上である必要があります\"",
      "    );",
      "    let 行列 = pathfinding::matrix::Matrix::from_rows(コスト.iter().cloned())",
      "        .expect(\"コストの全行は同じ列数であること\");",
      "    pathfinding::kuhn_munkres::kuhn_munkres_min(&行列)",
      "}"
    ]
  },
  "パス_クエリ_Mo": {
    "scope": "rust",
    "prefix": "パス_クエリ_Mo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木のパスクエリ（頂点 `u`-`v` 間の単純パス上の集計）を扱う Mo の状態インタフェース。",
      "/// オイラーツアー上の位置を出入りさせると、ある頂点はパス上にあるとき区間内にちょうど 1 回現れる。",
      "/// ランナーがその「出現回数の偶奇」を管理し、パスに入る頂点で [`追加`](木Mo::追加)、",
      "/// 出る頂点で [`削除`](木Mo::削除) を呼ぶ。状態は集合への頂点の出入りだけ実装すればよい。",
      "/// 列に対する素の [`Mo`](crate::mo) とは別技法。",
      "trait 木Mo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 頂点 `頂点` を現在の集合に加える。",
      "    fn 追加(&mut self, 頂点: usize);",
      "    /// 頂点 `頂点` を現在の集合から取り除く。",
      "    fn 削除(&mut self, 頂点: usize);",
      "    /// 現在の集合に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// 木上の Mo 本体。`n` は頂点数、`辺` は AtCoder の入力そのまま（0-indexed の頂点対）、",
      "/// `根` は根、`クエリ` は `(u, v)`（u-v パス）の列。",
      "/// 全体 `O((N + Q)√N · 更新コスト)`。`状態` は空集合の初期状態で渡すこと。",
      "fn 木上mo実行<S: 木Mo>(",
      "    n: usize,",
      "    辺: &[(usize, usize)],",
      "    根: usize,",
      "    クエリ: &[(usize, usize)],",
      "    状態: &mut S,",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    if q == 0 {",
      "        return Vec::new();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut st = vec![0usize; n];",
      "    let mut en = vec![0usize; n];",
      "    let mut 順 = Vec::with_capacity(2 * n);",
      "    let mut depth = vec![0usize; n];",
      "    let mut prev = vec![!0; n];",
      "    let mut 時刻 = 0usize;",
      "    let mut 探索 = vec![根];",
      "    while let Some(now) = 探索.pop() {",
      "        if now >= n {",
      "            let now = !now;",
      "            en[now] = 時刻;",
      "            順.push(now);",
      "            時刻 += 1;",
      "            continue;",
      "        }",
      "        depth[now] = if prev[now] == !0 {",
      "            0",
      "        } else {",
      "            depth[prev[now]] + 1",
      "        };",
      "        st[now] = 時刻;",
      "        順.push(now);",
      "        時刻 += 1;",
      "        探索.push(!now);",
      "        for &next in &グラフ[now] {",
      "            if next != prev[now] {",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let log = (usize::BITS - n.leading_zeros()).max(1) as usize;",
      "    let mut up = vec![vec![!0; n]; log];",
      "    up[0].copy_from_slice(&prev);",
      "    for k in 1..log {",
      "        for v in 0..n {",
      "            let m = up[k - 1][v];",
      "            up[k][v] = if m == !0 { !0 } else { up[k - 1][m] };",
      "        }",
      "    }",
      "    let lca = |mut u: usize, mut v: usize| -> usize {",
      "        if depth[u] < depth[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = depth[u] - depth[v];",
      "        for (k, 上) in up.iter().enumerate() {",
      "            if 差 >> k & 1 == 1 {",
      "                u = 上[u];",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for 上 in up.iter().rev() {",
      "            if 上[u] != 上[v] {",
      "                u = 上[u];",
      "                v = 上[v];",
      "            }",
      "        }",
      "        prev[u]",
      "    };",
      "    let mut 区間: Vec<(usize, usize, Option<usize>, usize)> = Vec::with_capacity(q);",
      "    for (qi, &(mut u, mut v)) in クエリ.iter().enumerate() {",
      "        if st[u] > st[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let l = lca(u, v);",
      "        if l == u {",
      "            区間.push((st[u], st[v] + 1, None, qi));",
      "        } else {",
      "            区間.push((en[u], st[v] + 1, Some(l), qi));",
      "        }",
      "    }",
      "    let b = ((2 * n) as f64).sqrt() as usize + 1;",
      "    区間.sort_by(|x, y| {",
      "        let (bx, by) = (x.0 / b, y.0 / b);",
      "        if bx != by {",
      "            bx.cmp(&by)",
      "        } else if bx % 2 == 0 {",
      "            x.1.cmp(&y.1)",
      "        } else {",
      "            y.1.cmp(&x.1)",
      "        }",
      "    });",
      "    let mut 使用中 = vec![false; n];",
      "    let mut 出力: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let (mut cl, mut cr) = (0usize, 0usize);",
      "    for &(l, r, extra, qi) in &区間 {",
      "        while cr < r {",
      "            let v = 順[cr];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "            cr += 1;",
      "        }",
      "        while cl > l {",
      "            cl -= 1;",
      "            let v = 順[cl];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "        }",
      "        while cr > r {",
      "            cr -= 1;",
      "            let v = 順[cr];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "        }",
      "        while cl < l {",
      "            let v = 順[cl];",
      "            if 使用中[v] {",
      "                状態.削除(v);",
      "            } else {",
      "                状態.追加(v);",
      "            }",
      "            使用中[v] = !使用中[v];",
      "            cl += 1;",
      "        }",
      "        出力[qi] = Some(match extra {",
      "            Some(w) => {",
      "                状態.追加(w);",
      "                let a = 状態.答え();",
      "                状態.削除(w);",
      "                a",
      "            }",
      "            None => 状態.答え(),",
      "        });",
      "    }",
      "    出力.into_iter().map(|o| o.unwrap()).collect()",
      "}"
    ]
  },
  "パス_和_動的": {
    "scope": "rust",
    "prefix": "パス_和_動的",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Link-Cut Tree。森に対する辺の追加・削除（[`Self::辺を張る`] / [`Self::辺を切る`]）、",
      "/// 連結判定、2 頂点間パスの頂点値の総和を、すべてならし O(log N) で処理する。",
      "/// 頂点番号は 0-indexed。",
      "/// - [`Self::辺を張る`] : 別の木に属する 2 頂点を結ぶ（同一木の頂点に呼んではならない）。",
      "/// - [`Self::辺を切る`] : 既存の辺を取り除く（隣接していない 2 頂点に呼んではならない）。",
      "/// - [`Self::連結`] : 2 頂点が同じ木か。",
      "/// - [`Self::パス和`] : 2 頂点間パス上の頂点値の総和。",
      "/// - [`Self::値設定`] : 1 頂点の値を更新。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "struct リンクカット木<T> {",
      "    親: Vec<usize>,",
      "    子: Vec<[usize; 2]>,",
      "    値: Vec<T>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "}",
      "impl<T> リンクカット木<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    /// 各頂点の初期値から構築する。",
      "    fn new(初期値: &[T]) -> Self {",
      "        let n = 初期値.len();",
      "        let mut s = Self {",
      "            親: vec![0; n + 1],",
      "            子: vec![[0, 0]; n + 1],",
      "            値: vec![T::default(); n + 1],",
      "            和: vec![T::default(); n + 1],",
      "            反転: vec![false; n + 1],",
      "        };",
      "        for (i, &v) in 初期値.iter().enumerate() {",
      "            s.値[i + 1] = v;",
      "            s.和[i + 1] = v;",
      "        }",
      "        s",
      "    }",
      "    /// `x` がスプレー木の根（パス親へのリンクしか持たない）か。",
      "    fn is_root(&self, x: usize) -> bool {",
      "        let p = self.親[x];",
      "        p == 0 || (self.子[p][0] != x && self.子[p][1] != x)",
      "    }",
      "    fn 更新(&mut self, x: usize) {",
      "        if x == 0 {",
      "            return;",
      "        }",
      "        self.和[x] = self.和[self.子[x][0]] + self.値[x] + self.和[self.子[x][1]];",
      "    }",
      "    fn 伝播(&mut self, x: usize) {",
      "        if x != 0 && self.反転[x] {",
      "            let l = self.子[x][0];",
      "            let r = self.子[x][1];",
      "            self.子[x][0] = r;",
      "            self.子[x][1] = l;",
      "            if l != 0 {",
      "                self.反転[l] ^= true;",
      "            }",
      "            if r != 0 {",
      "                self.反転[r] ^= true;",
      "            }",
      "            self.反転[x] = false;",
      "        }",
      "    }",
      "    fn 回転(&mut self, x: usize) {",
      "        let p = self.親[x];",
      "        let g = self.親[p];",
      "        let pがルート = self.is_root(p);",
      "        let d = if self.子[p][1] == x { 1 } else { 0 };",
      "        let b = self.子[x][d ^ 1];",
      "        self.子[p][d] = b;",
      "        if b != 0 {",
      "            self.親[b] = p;",
      "        }",
      "        self.子[x][d ^ 1] = p;",
      "        self.親[p] = x;",
      "        self.親[x] = g;",
      "        if !pがルート {",
      "            if self.子[g][0] == p {",
      "                self.子[g][0] = x;",
      "            } else if self.子[g][1] == p {",
      "                self.子[g][1] = x;",
      "            }",
      "        }",
      "        self.更新(p);",
      "        self.更新(x);",
      "    }",
      "    fn splay(&mut self, x: usize) {",
      "        let mut スタック = vec![x];",
      "        let mut y = x;",
      "        while !self.is_root(y) {",
      "            y = self.親[y];",
      "            スタック.push(y);",
      "        }",
      "        while let Some(v) = スタック.pop() {",
      "            self.伝播(v);",
      "        }",
      "        while !self.is_root(x) {",
      "            let p = self.親[x];",
      "            if self.is_root(p) {",
      "                self.回転(x);",
      "            } else {",
      "                let g = self.親[p];",
      "                let 同方向 = (self.子[g][1] == p) == (self.子[p][1] == x);",
      "                if 同方向 {",
      "                    self.回転(p);",
      "                } else {",
      "                    self.回転(x);",
      "                }",
      "                self.回転(x);",
      "            }",
      "        }",
      "    }",
      "    fn access(&mut self, x: usize) -> usize {",
      "        let mut last = 0;",
      "        let mut cur = x;",
      "        while cur != 0 {",
      "            self.splay(cur);",
      "            self.子[cur][1] = last;",
      "            self.更新(cur);",
      "            last = cur;",
      "            cur = self.親[cur];",
      "        }",
      "        self.splay(x);",
      "        last",
      "    }",
      "    fn make_root(&mut self, x: usize) {",
      "        self.access(x);",
      "        self.反転[x] ^= true;",
      "        self.伝播(x);",
      "    }",
      "    fn find_root(&mut self, x: usize) -> usize {",
      "        self.access(x);",
      "        let mut r = x;",
      "        self.伝播(r);",
      "        while self.子[r][0] != 0 {",
      "            r = self.子[r][0];",
      "            self.伝播(r);",
      "        }",
      "        self.splay(r);",
      "        r",
      "    }",
      "    /// 別の木に属する頂点 `u`・`v` を結ぶ辺を張る。同じ木の 2 頂点に呼んではならない。",
      "    fn 辺を張る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.親[a] = b;",
      "    }",
      "    /// 既存の辺 `u - v` を取り除く。隣接していない 2 頂点に呼んではならない。",
      "    fn 辺を切る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.子[b][0] = 0;",
      "        self.親[a] = 0;",
      "        self.更新(b);",
      "    }",
      "    /// 頂点 `u`・`v` が同じ木に属するか。",
      "    fn 連結(&mut self, u: usize, v: usize) -> bool {",
      "        if u == v {",
      "            return true;",
      "        }",
      "        self.find_root(u + 1) == self.find_root(v + 1)",
      "    }",
      "    /// 任意頂点 `u` をその木の根にする。",
      "    fn 根を変更(&mut self, u: usize) {",
      "        self.make_root(u + 1);",
      "    }",
      "    /// 頂点 `u`・`v` 間のパス上にある頂点値の総和。同じ木に属することが前提。",
      "    fn パス和(&mut self, u: usize, v: usize) -> T {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.和[b]",
      "    }",
      "    /// 頂点 `u` の値を `新値` に設定する。",
      "    fn 値設定(&mut self, u: usize, 新値: T) {",
      "        let a = u + 1;",
      "        self.access(a);",
      "        self.値[a] = 新値;",
      "        self.更新(a);",
      "    }",
      "    /// 頂点 `u` の現在の値。",
      "    fn 頂点値(&self, u: usize) -> T {",
      "        self.値[u + 1]",
      "    }",
      "}"
    ]
  },
  "ヒストグラム": {
    "scope": "rust",
    "prefix": "ヒストグラム",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ヒストグラム内に収まる最大長方形の面積を O(N) で求める（スタック法）。",
      "/// `高さ` は各列のバーの高さ。返り値は軸に平行な長方形の最大面積。",
      "/// 0/1 グリッドの「全て 1 の最大長方形」は、各行について",
