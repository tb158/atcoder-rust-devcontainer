  "二重_辺_連結_成分": {
    "scope": "rust",
    "prefix": "二重_辺_連結_成分",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重辺連結成分分解の結果。`成分[v]` は頂点 `v` の属する二重辺連結成分の番号、`成分数` はその個数。",
      "/// `橋` は橋（取り除くと連結成分が増える辺）の一覧、`木` は成分を頂点とする**橋森**（橋でつないだ森）。",
      "struct 二重辺連結成分 {",
      "    /// 頂点 → 成分番号。",
      "    成分: Vec<usize>,",
      "    /// 成分の個数。",
      "    成分数: usize,",
      "    /// 橋の一覧（`(u, v)`、`u` は DFS 木で親側）。",
      "    橋: Vec<(usize, usize)>,",
      "    /// 橋森。`木[c]` は成分 `c` と橋で隣接する成分の一覧。",
      "    木: Vec<Vec<usize>>,",
      "}",
      "/// 無向グラフを二重辺連結成分（どの 1 辺を取り除いても連結が保たれる極大頂点集合）に分解し、",
      "/// 橋を縮約した**橋森**を返す。`lowlink`（橋・関節点の列挙）とは別で、成分分解と縮約木まで構成する。",
      "/// `辺` は多重辺・自己ループを含んでよい（並行辺は橋にならない／自己ループは無視）。計算量 `O(n + 辺数)`。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "fn 二重辺連結成分分解(n: usize, 辺: &[(usize, usize)]) -> 二重辺連結成分 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut 番号 = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 橋辺 = vec![false; 辺.len()];",
      "    let mut 橋 = Vec::new();",
      "    let mut 時刻 = 0i64;",
      "    for s in 0..n {",
      "        if 番号[s] != -1 {",
      "            continue;",
      "        }",
      "        番号[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if 番号[next] == -1 {",
      "                    番号[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    探索.push((next, eid as i64, 0));",
      "                } else {",
      "                    low[now] = low[now].min(番号[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] > 番号[prev] {",
      "                        橋辺[親辺 as usize] = true;",
      "                        橋.push((prev, now));",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 成分 = vec![!0; n];",
      "    let mut 成分数 = 0;",
      "    for s in 0..n {",
      "        if 成分[s] != !0 {",
      "            continue;",
      "        }",
      "        成分[s] = 成分数;",
      "        let mut 探索 = vec![s];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, eid) in &グラフ[now] {",
      "                if !橋辺[eid] && 成分[next] == !0 {",
      "                    成分[next] = 成分数;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        成分数 += 1;",
      "    }",
      "    let mut 木 = vec![Vec::new(); 成分数];",
      "    for &(a, b) in &橋 {",
      "        let (x, y) = (成分[a], 成分[b]);",
      "        木[x].push(y);",
      "        木[y].push(x);",
      "    }",
      "    二重辺連結成分 {",
      "        成分,",
      "        成分数,",
      "        橋,",
      "        木,",
      "    }",
      "}"
    ]
  },
  "二重_頂点_連結_成分": {
    "scope": "rust",
    "prefix": "二重_頂点_連結_成分",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 二重頂点連結成分（BCC, block）分解と block-cut 木。`lowlink`（橋・関節点の列挙のみ）とは別で、",
      "/// 辺をブロックに分割し、関節点とブロックを頂点とする木（非連結なら森）を構成する。",
      "/// - `成分[i]`: i 番目の BCC に属する元グラフ頂点の一覧（関節点は複数の BCC に現れる）。",
      "/// - `木`: block-cut 木の隣接リスト（木頂点空間）。前半 `成分数` 個が BCC、後半が関節点。",
      "/// - `関節点番号[v]`: 元頂点 `v` が関節点なら対応する木頂点番号（`>= 成分数`）、そうでなければ `None`。",
      "/// - `所属[v]`: 元頂点 `v` が属する BCC 番号の一覧。",
      "/// 反復 DFS なので深いグラフでもスタック安全。",
      "struct ブロックカット木 {",
      "    /// 各 BCC の頂点集合。",
      "    成分: Vec<Vec<usize>>,",
      "    /// BCC の個数。",
      "    成分数: usize,",
      "    /// block-cut 木の隣接リスト（木頂点番号空間、頂点数 = `木頂点数`）。",
      "    木: Vec<Vec<usize>>,",
      "    /// block-cut 木の頂点数（= `成分数` + 関節点数）。",
      "    木頂点数: usize,",
      "    /// 元頂点 → 関節点に対応する木頂点番号（非関節点は `None`）。",
      "    関節点番号: Vec<Option<usize>>,",
      "    /// 元頂点 → 属する BCC 番号の一覧。",
      "    所属: Vec<Vec<usize>>,",
      "}",
      "impl ブロックカット木 {",
      "    /// 関節点（複数の BCC に属する頂点）の一覧を昇順で返す。",
      "    fn 関節点一覧(&self) -> Vec<usize> {",
      "        (0..self.関節点番号.len())",
      "            .filter(|&v| self.関節点番号[v].is_some())",
      "            .collect()",
      "    }",
      "}",
      "/// 無向グラフを二重頂点連結成分に分解し block-cut 木を構成する。`辺` は多重辺・自己ループを含んでよい",
      "/// （自己ループは無視、多重辺は同じ 2 頂点の BCC を成す）。計算量 `O(n + 辺数)`。",
      "fn ブロックカット木分解(n: usize, 辺: &[(usize, usize)]) -> ブロックカット木 {",
      "    let mut グラフ: Vec<Vec<(usize, usize)>> = vec![Vec::new(); n];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        if u != v {",
      "            グラフ[u].push((v, i));",
      "            グラフ[v].push((u, i));",
      "        }",
      "    }",
      "    let mut ord = vec![-1i64; n];",
      "    let mut low = vec![0i64; n];",
      "    let mut 時刻 = 0i64;",
      "    let mut 辺スタック: Vec<(usize, usize)> = Vec::new();",
      "    let mut 成分: Vec<Vec<usize>> = Vec::new();",
      "    for s in 0..n {",
      "        if ord[s] != -1 {",
      "            continue;",
      "        }",
      "        if グラフ[s].is_empty() {",
      "            成分.push(vec![s]);",
      "            ord[s] = 時刻;",
      "            時刻 += 1;",
      "            continue;",
      "        }",
      "        ord[s] = 時刻;",
      "        low[s] = 時刻;",
      "        時刻 += 1;",
      "        let mut 探索: Vec<(usize, i64, usize)> = vec![(s, -1, 0)];",
      "        while let Some(&(now, 親辺, 位置)) = 探索.last() {",
      "            if 位置 < グラフ[now].len() {",
      "                探索.last_mut().unwrap().2 += 1;",
      "                let (next, eid) = グラフ[now][位置];",
      "                if eid as i64 == 親辺 {",
      "                    continue;",
      "                }",
      "                if ord[next] == -1 {",
      "                    ord[next] = 時刻;",
      "                    low[next] = 時刻;",
      "                    時刻 += 1;",
      "                    辺スタック.push((now, next));",
      "                    探索.push((next, eid as i64, 0));",
      "                } else if ord[next] < ord[now] {",
      "                    辺スタック.push((now, next));",
      "                    low[now] = low[now].min(ord[next]);",
      "                }",
      "            } else {",
      "                探索.pop();",
      "                if let Some(&(prev, _, _)) = 探索.last() {",
      "                    low[prev] = low[prev].min(low[now]);",
      "                    if low[now] >= ord[prev] {",
      "                        let mut 頂点 = Vec::new();",
      "                        loop {",
      "                            let (x, y) = 辺スタック.pop().unwrap();",
      "                            頂点.push(x);",
      "                            頂点.push(y);",
      "                            if (x, y) == (prev, now) {",
      "                                break;",
      "                            }",
      "                        }",
      "                        頂点.sort_unstable();",
      "                        頂点.dedup();",
      "                        成分.push(頂点);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let 成分数 = 成分.len();",
      "    let mut 所属: Vec<Vec<usize>> = vec![Vec::new(); n];",
      "    for (i, c) in 成分.iter().enumerate() {",
      "        for &v in c {",
      "            所属[v].push(i);",
      "        }",
      "    }",
      "    let mut 関節点番号 = vec![None; n];",
      "    let mut 木頂点数 = 成分数;",
      "    for (v, 番号) in 関節点番号.iter_mut().enumerate() {",
      "        if 所属[v].len() >= 2 {",
      "            *番号 = Some(木頂点数);",
      "            木頂点数 += 1;",
      "        }",
      "    }",
      "    let mut 木: Vec<Vec<usize>> = vec![Vec::new(); 木頂点数];",
      "    for (i, c) in 成分.iter().enumerate() {",
      "        for &v in c {",
      "            if let Some(a) = 関節点番号[v] {",
      "                木[i].push(a);",
      "                木[a].push(i);",
      "            }",
      "        }",
      "    }",
      "    ブロックカット木 {",
      "        成分,",
      "        成分数,",
      "        木,",
      "        木頂点数,",
      "        関節点番号,",
      "        所属,",
      "    }",
      "}"
    ]
  },
  "二項_係数_mod_素数": {
    "scope": "rust",
    "prefix": "二項_係数_mod_素数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// Lucas の定理による二項係数 `C(n, k) mod p`（`p` は素数）。`n`, `k` は最大 ~10^18 まで扱える。",
      "/// `n`/`k` を p 進展開して桁ごとに掛け合わせるので、`n` が巨大でも `O(log_p n)`。",
      "/// `0..p` の階乗を前計算するので `p` が小さめの素数のとき向き",
      "/// （`p` が 10^9+7 級で `n <= max_n` に収まるなら [`crate::comb`]）。",
      "struct リュカ {",
      "    p: u64,",
      "    階乗: Vec<u64>,",
      "    逆階乗: Vec<u64>,",
      "}",
      "impl リュカ {",
      "    /// 素数 `p` を法とする計算器を作る。`0..p` の階乗・逆階乗を前計算する（O(p)）。",
      "    fn new(p: impl TryInto<u64>) -> Self {",
      "        let p: u64 = p.try_into().ok().expect(\"リュカ: p が u64 に収まりません\");",
      "        assert!(p >= 2, \"p must be a prime >= 2\");",
      "        let mut 階乗 = vec![1u64; p as usize];",
      "        for i in 1..p as usize {",
      "            階乗[i] = 階乗[i - 1] * i as u64 % p;",
      "        }",
      "        let mut 逆階乗 = vec![1u64; p as usize];",
      "        逆階乗[p as usize - 1] = 累乗_mod(階乗[p as usize - 1], p - 2, p);",
      "        for i in (1..p as usize).rev() {",
      "            逆階乗[i - 1] = 逆階乗[i] * i as u64 % p;",
      "        }",
      "        Self {",
      "            p, 階乗, 逆階乗",
      "        }",
      "    }",
      "    /// `0 <= a, b < p` での `C(a, b) mod p`。",
      "    fn 小二項係数(&self, a: u64, b: u64) -> u64 {",
      "        if b > a {",
      "            return 0;",
      "        }",
      "        let a = a as usize;",
      "        let b = b as usize;",
      "        self.階乗[a] * self.逆階乗[b] % self.p * self.逆階乗[a - b] % self.p",
      "    }",
      "    /// `C(n, k) mod p`。`n`, `k` を p 進展開し、各桁の二項係数の積を取る。",
      "    /// 引数は任意の整数型でよい（負の値は 0 を返す）。",
      "    fn 二項係数(&self, n: impl TryInto<i128>, k: impl TryInto<i128>) -> u64 {",
      "        let n: i128 = n.try_into().ok().expect(\"リュカ: n が i128 に収まりません\");",
      "        let k: i128 = k.try_into().ok().expect(\"リュカ: k が i128 に収まりません\");",
      "        if n < 0 || k < 0 {",
      "            return 0;",
      "        }",
      "        let mut n = u64::try_from(n).expect(\"リュカ: n が u64 を超えています\");",
      "        let mut k = u64::try_from(k).expect(\"リュカ: k が u64 を超えています\");",
      "        let mut 結果 = 1u64;",
      "        while n > 0 || k > 0 {",
      "            let ni = n % self.p;",
      "            let ki = k % self.p;",
      "            if ki > ni {",
      "                return 0;",
      "            }",
      "            結果 = 結果 * self.小二項係数(ni, ki) % self.p;",
      "            n /= self.p;",
      "            k /= self.p;",
      "        }",
      "        結果",
      "    }",
      "}"
    ]
  },
  "互いに素な_個数": {
    "scope": "rust",
    "prefix": "互いに素な_個数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// オイラーのφ関数 φ(n)：`1..=n` のうち `n` と互いに素な整数の個数。O(√n)。",
      "/// 多くの `n` について一括で欲しいときは [`オイラーのファイ表`] を使う。",
      "fn オイラーのファイ(mut n: u64) -> u64 {",
      "    let mut 結果 = n;",
      "    let mut p = 2u64;",
      "    while p * p <= n {",
      "        if n % p == 0 {",
      "            while n % p == 0 {",
      "                n /= p;",
      "            }",
      "            結果 -= 結果 / p;",
      "        }",
      "        p += 1;",
      "    }",
      "    if n > 1 {",
      "        結果 -= 結果 / n;",
      "    }",
      "    結果",
      "}",
      "/// `0..=n` の各 `i` について φ(i) を入れた配列を篩で前計算する。O(n log log n)。",
      "/// `表[0] = 0`、`表[1] = 1`。",
      "fn オイラーのファイ表(n: usize) -> Vec<u64> {",
      "    let mut 表: Vec<u64> = (0..=n as u64).collect();",
      "    for i in 2..=n {",
      "        if 表[i] == i as u64 {",
      "            let mut j = i;",
      "            while j <= n {",
      "                表[j] -= 表[j] / i as u64;",
      "                j += i;",
      "            }",
      "        }",
      "    }",
      "    表",
      "}"
    ]
  },
  "五角数_定理": {
    "scope": "rust",
    "prefix": "五角数_定理",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::ModInt as Mint;",
      "/// 分割数 p(0..=n) を前計算して返す。`p(k)` は整数 `k` を順序を無視して正整数の和に",
      "/// 分ける方法の総数。五角数定理を用いて O(n√n)。",
      "/// mod は `Mint`（ac_library::ModInt）のグローバル modulus（既定 998_244_353、",
      "/// 変更は `Mint::set_modulus`）。Comb は不要。",
      "/// `p(0)=1, p(1)=1, p(2)=2, p(3)=3, p(4)=5, p(5)=7, ...`。u64 なら n ≥ 417 で溢れる。",
      "fn 分割数表(n: usize) -> Vec<Mint> {",
      "    let mut p = vec![Mint::new(0); n + 1];",
      "    p[0] = Mint::new(1);",
      "    for i in 1..=n {",
      "        let mut 和 = Mint::new(0);",
      "        let mut k = 1usize;",
      "        loop {",
      "            let g1 = k * (3 * k - 1) / 2;",
      "            if g1 > i {",
      "                break;",
      "            }",
      "            let mut 項 = p[i - g1];",
      "            let g2 = k * (3 * k + 1) / 2;",
      "            if g2 <= i {",
      "                項 += p[i - g2];",
      "            }",
      "            if k % 2 == 1 {",
      "                和 += 項;",
      "            } else {",
      "                和 -= 項;",
      "            }",
      "            k += 1;",
      "        }",
      "        p[i] = 和;",
      "    }",
      "    p",
      "}"
    ]
  },
  "仮想木": {
    "scope": "rust",
    "prefix": "仮想木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 仮想木（Auxiliary Tree）。根付き木と頂点集合 `S` が与えられたとき、`S` と「`S` 内 2 頂点の LCA」だけを",
      "/// 残して縮約した木を作る。頂点数 `|S|` に対し O(|S| log |S|) で構築でき、クエリごとの木 DP を高速化する。",
      "/// 二分上昇 LCA を内包する自己完結版。",
      "/// - [`Self::lca`] : 最近共通祖先。",
      "/// - [`Self::構築`] : 頂点集合から仮想木の `(頂点リスト, 辺(親, 子))` を返す。",
      "struct 仮想木 {",
      "    上: Vec<Vec<i64>>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    log: usize,",
      "}",
      "impl 仮想木 {",
      "    /// 頂点数 `n`・辺リスト `辺`（AtCoder の入力そのまま）と根から前計算する。",
      "    fn new(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut log = 1;",
      "        while (1usize << log) < n.max(2) {",
      "            log += 1;",
      "        }",
      "        let mut 上 = vec![vec![-1i64; n]; log];",
      "        let 深さ = vec![0usize; n];",
      "        let 入時刻 = vec![0usize; n];",
      "        let 出時刻 = vec![0usize; n];",
      "        let mut d = 構築データ {",
      "            prev: std::mem::take(&mut 上[0]),",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            時刻: 0,",
      "        };",
      "        探索(根, -1, &グラフ, &mut d);",
      "        上[0] = d.prev;",
      "        let 深さ = d.深さ;",
      "        let 入時刻 = d.入時刻;",
      "        let 出時刻 = d.出時刻;",
      "        for k in 1..log {",
      "            for v in 0..n {",
      "                let 中 = 上[k - 1][v];",
      "                上[k][v] = if 中 < 0 {",
      "                    -1",
      "                } else {",
      "                    上[k - 1][中 as usize]",
      "                };",
      "            }",
      "        }",
      "        Self {",
      "            上,",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            log,",
      "        }",
      "    }",
      "    /// `a` が `b` の祖先か（自身も祖先とみなす）。",
      "    fn 祖先か(&self, a: usize, b: usize) -> bool {",
      "        self.入時刻[a] <= self.入時刻[b] && self.出時刻[b] <= self.出時刻[a]",
      "    }",
      "    /// 最近共通祖先。",
      "    fn lca(&self, mut u: usize, mut v: usize) -> usize {",
      "        if self.深さ[u] < self.深さ[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = self.深さ[u] - self.深さ[v];",
      "        for k in 0..self.log {",
      "            if (差 >> k) & 1 == 1 {",
      "                u = self.上[k][u] as usize;",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for k in (0..self.log).rev() {",
      "            if self.上[k][u] != self.上[k][v] {",
      "                u = self.上[k][u] as usize;",
      "                v = self.上[k][v] as usize;",
      "            }",
      "        }",
      "        self.上[0][u] as usize",
      "    }",
      "    /// 頂点集合から仮想木を構築し、`(頂点リスト, 辺(親, 子))` を返す。",
      "    /// 頂点リストは入時刻順。辺は親が子の祖先になる向き。",
      "    fn 構築(&self, 頂点集合: &[usize]) -> (Vec<usize>, Vec<(usize, usize)>) {",
      "        if 頂点集合.is_empty() {",
      "            return (Vec::new(), Vec::new());",
      "        }",
      "        let mut s = 頂点集合.to_vec();",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 追加 = Vec::new();",
      "        for w in s.windows(2) {",
      "            追加.push(self.lca(w[0], w[1]));",
      "        }",
      "        s.extend(追加);",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 辺 = Vec::new();",
      "        let mut スタック: Vec<usize> = Vec::new();",
      "        for &v in &s {",
      "            while let Some(&天辺) = スタック.last() {",
      "                if self.祖先か(天辺, v) {",
      "                    break;",
      "                }",
      "                スタック.pop();",
      "            }",
      "            if let Some(&天辺) = スタック.last() {",
      "                辺.push((天辺, v));",
      "            }",
      "            スタック.push(v);",
      "        }",
      "        (s, 辺)",
      "    }",
      "}",
      "/// DFS 中に埋める配列をまとめた作業領域（引数を 1 つに減らすため）。",
      "struct 構築データ {",
      "    prev: Vec<i64>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    時刻: usize,",
      "}",
      "/// 入時刻・出時刻・深さ・直接の親を埋める DFS。",
      "fn 探索(now: usize, prev: i64, グラフ: &[Vec<usize>], d: &mut 構築データ) {",
      "    d.prev[now] = prev;",
      "    d.入時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "    for &next in &グラフ[now] {",
      "        if next as i64 != prev {",
      "            d.深さ[next] = d.深さ[now] + 1;",
      "            探索(next, now as i64, グラフ, d);",
      "        }",
      "    }",
      "    d.出時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "}"
    ]
  },
  "任意_modNTT": {
    "scope": "rust",
    "prefix": "任意_modNTT",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, inv_mod, ButterflyCache, Modulus, StaticModInt};",
      "use std::cell::RefCell;",
      "use std::thread::LocalKey;",
      "/// NTT 素数 1: `167772161 = 5·2^25 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法1 {}",
      "impl Modulus for 法1 {",
      "    const VALUE: u32 = 167_772_161;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
