    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// グリッド内で特定の要素（target）が含まれる最小の長方形範囲（上下左右の境界インデックス）を返す。O(HW)。",
      "/// 返り値: Option<(h_min, h_max, w_min, w_max)>",
      "fn グリッドの境界頂点<T: PartialEq + Copy>(",
      "    グリッド: &[Vec<T>],",
      "    target: T,",
      ") -> Option<(usize, usize, usize, usize)> {",
      "    let h_min = グリッド.iter().position(|行| 行.contains(&target))?;",
      "    let h_max = グリッド.iter().rposition(|行| 行.contains(&target))?;",
      "    let w_min = グリッド",
      "        .iter()",
      "        .filter_map(|行| 行.iter().position(|&マス| マス == target))",
      "        .min()?;",
      "    let w_max = グリッド",
      "        .iter()",
      "        .filter_map(|行| 行.iter().rposition(|&c| c == target))",
      "        .max()?;",
      "    Some((h_min, h_max, w_min, w_max))",
      "}"
    ]
  },
  "ケーニッヒ": {
    "scope": "rust",
    "prefix": "ケーニッヒ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Kuhn 法で増加路を 1 本探す内部関数。`右相手`・`左相手` を更新する。",
      "fn 増加(",
      "    u: usize,",
      "    グラフ: &[Vec<usize>],",
      "    右相手: &mut [Option<usize>],",
      "    左相手: &mut [Option<usize>],",
      "    到達済: &mut [bool],",
      ") -> bool {",
      "    for &v in &グラフ[u] {",
      "        if 到達済[v] {",
      "            continue;",
      "        }",
      "        到達済[v] = true;",
      "        if 右相手[v].is_none() || 増加(右相手[v].unwrap(), グラフ, 右相手, 左相手, 到達済)",
      "        {",
      "            右相手[v] = Some(u);",
      "            左相手[u] = Some(v);",
      "            return true;",
      "        }",
      "    }",
      "    false",
      "}",
      "/// König の定理の核。最大マッチングを求め、未マッチ左頂点から交互路で到達できる",
      "/// 左集合 `z左` と右集合 `z右` を返す。最小点被覆・最大独立集合の両方の土台。",
      "fn ケーニッヒ核(",
      "    左数: usize, 右数: usize, 辺: &[(usize, usize)]",
      ") -> (Vec<bool>, Vec<bool>) {",
      "    let mut グラフ = vec![Vec::new(); 左数];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "    }",
      "    let mut 右相手: Vec<Option<usize>> = vec![None; 右数];",
      "    let mut 左相手: Vec<Option<usize>> = vec![None; 左数];",
      "    for u in 0..左数 {",
      "        let mut 到達済 = vec![false; 右数];",
      "        増加(u, &グラフ, &mut 右相手, &mut 左相手, &mut 到達済);",
      "    }",
      "    let mut z左 = vec![false; 左数];",
      "    let mut z右 = vec![false; 右数];",
      "    let mut 探索 = Vec::new();",
      "    for (u, &相手) in 左相手.iter().enumerate() {",
      "        if 相手.is_none() {",
      "            z左[u] = true;",
      "            探索.push(u);",
      "        }",
      "    }",
      "    while let Some(u) = 探索.pop() {",
      "        for &v in &グラフ[u] {",
      "            if 左相手[u] == Some(v) || z右[v] {",
      "                continue;",
      "            }",
      "            z右[v] = true;",
      "            if let Some(w) = 右相手[v]",
      "                && !z左[w]",
      "            {",
      "                z左[w] = true;",
      "                探索.push(w);",
      "            }",
      "        }",
      "    }",
      "    (z左, z右)",
      "}",
      "/// König の定理で二部グラフの最小点被覆を求める。`O(V·E)`（内部は Kuhn 法）。",
      "/// 左頂点 `0..左数`・右頂点 `0..右数`、`辺` は `(左, 右)` の列。返り値 `(左被覆, 右被覆)` は",
      "/// 被覆に含める左・右の頂点番号。被覆サイズ `= 最大マッチング数`（König の定理）。",
      "/// マッチングのみの [`hopcroft_karp`](crate::hopcroft_karp) と異なり点被覆を復元する。",
      "fn 二部最小点被覆(",
      "    左数: usize,",
      "    右数: usize,",
      "    辺: &[(usize, usize)],",
      ") -> (Vec<usize>, Vec<usize>) {",
      "    let (z左, z右) = ケーニッヒ核(左数, 右数, 辺);",
      "    let 左被覆: Vec<usize> = (0..左数).filter(|&u| !z左[u]).collect();",
      "    let 右被覆: Vec<usize> = (0..右数).filter(|&v| z右[v]).collect();",
      "    (左被覆, 右被覆)",
      "}",
      "/// König の定理で二部グラフの最大独立集合を求める（最小点被覆の補集合）。`O(V·E)`。",
      "/// 返り値 `(左独立, 右独立)`。サイズ `= 全頂点数 - 最大マッチング数`。",
      "fn 二部最大独立集合(",
      "    左数: usize,",
      "    右数: usize,",
      "    辺: &[(usize, usize)],",
      ") -> (Vec<usize>, Vec<usize>) {",
      "    let (z左, z右) = ケーニッヒ核(左数, 右数, 辺);",
      "    let 左独立: Vec<usize> = (0..左数).filter(|&u| z左[u]).collect();",
      "    let 右独立: Vec<usize> = (0..右数).filter(|&v| !z右[v]).collect();",
      "    (左独立, 右独立)",
      "}"
    ]
  },
  "ゴモリー_フー_木": {
    "scope": "rust",
    "prefix": "ゴモリー_フー_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::MfGraph;",
      "/// 全点対最小カット木（Gomory–Hu 木）。無向重み付きグラフの「任意の 2 頂点間の最小カット」を、",
      "/// `n-1` 本の辺からなる 1 本の木で表す。木上の `u`–`v` パスの最小辺重みが `u`–`v` の最小カットに等しい。",
      "/// `prev[i]`（`i >= 1`）はその親、`重み[i]` は辺 `(i, prev[i])` の容量（＝そのカット値）。",
      "struct 全点対最小カット木 {",
      "    /// `prev[i]` は木における頂点 `i` の親（`prev[0] = 0`）。",
      "    prev: Vec<usize>,",
      "    /// `重み[i]` は辺 `(i, prev[i])` の最小カット値（`重み[0] = 0`）。",
      "    重み: Vec<i64>,",
      "    グラフ: Vec<Vec<(usize, i64)>>,",
      "}",
      "impl 全点対最小カット木 {",
      "    /// 木上のパスの最小辺重み = 頂点 `u`, `v` 間の最小カット値を `O(n)` で返す。",
      "    fn 最小カット(&self, u: usize, v: usize) -> i64 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        let n = self.グラフ.len();",
      "        let mut 最小 = vec![i64::MAX; n];",
      "        let mut 到達済 = vec![false; n];",
      "        到達済[u] = true;",
      "        let mut 探索 = vec![u];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, w) in &self.グラフ[now] {",
      "                if !到達済[next] {",
      "                    到達済[next] = true;",
      "                    最小[next] = 最小[now].min(w);",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        最小[v]",
      "    }",
      "}",
      "/// Gusfield の簡易アルゴリズムで Gomory–Hu 木（等価フロー木）を構築する。`ac_library::MfGraph` を",
      "/// `n-1` 回呼ぶ。`辺` は `(u, v, 容量)` の無向辺（容量非負、多重辺は別々に追加、自己ループは無視）。",
      "/// 計算量は最大流 `n-1` 回ぶん。非連結なグラフでは成分間のカットは `0` になる。",
      "fn 全点対最小カット木構築(",
      "    n: usize,",
      "    辺: &[(usize, usize, i64)],",
      ") -> 全点対最小カット木 {",
      "    let mut prev = vec![0usize; n];",
      "    let mut 重み = vec![0i64; n];",
      "    for i in 1..n {",
      "        let t = prev[i];",
      "        let mut g = MfGraph::<i64>::new(n);",
      "        for &(u, v, w) in 辺 {",
      "            if u != v {",
      "                g.add_edge(u, v, w);",
      "                g.add_edge(v, u, w);",
      "            }",
      "        }",
      "        let f = g.flow(i, t);",
      "        重み[i] = f;",
      "        let 側 = g.min_cut(i);",
      "        for j in (i + 1)..n {",
      "            if 側[j] && prev[j] == t {",
      "                prev[j] = i;",
      "            }",
      "        }",
      "    }",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for i in 1..n {",
      "        グラフ[i].push((prev[i], 重み[i]));",
      "        グラフ[prev[i]].push((i, 重み[i]));",
      "    }",
      "    全点対最小カット木 {",
      "        prev, 重み, グラフ",
      "    }",
      "}"
    ]
  },
  "ザック_DP": {
    "scope": "rust",
    "prefix": "ザック_DP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 0/1 ナップサック問題。容量 `容量` のリュックに、品物 `(重さ, 価値)` を",
      "/// 各 0 個か 1 個選び、重さ合計が容量以下になるときの価値合計の最大値を返す。O(N·容量)。",
      "/// 重さが大きく価値が小さいとき（容量が巨大で価値合計が小さいとき）は",
      "/// [`価値基準ナップサック`] を使うと O(N·Σ価値) で解ける。",
      "fn ナップサック(品物: &[(usize, i64)], 容量: usize) -> i64 {",
      "    let mut dp = vec![0i64; 容量 + 1];",
      "    for &(重さ, 価値) in 品物 {",
      "        for w in (重さ..=容量).rev() {",
      "            dp[w] = dp[w].max(dp[w - 重さ] + 価値);",
      "        }",
      "    }",
      "    dp[容量]",
      "}"
    ]
  },
  "シュタイナー_木": {
    "scope": "rust",
    "prefix": "シュタイナー_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::cmp::Reverse;",
      "use std::collections::BinaryHeap;",
      "const 無限大シュタイナー: i64 = 1 << 60;",
      "/// 最小シュタイナー木。重み付き無向グラフで、指定した「端子（terminal）」をすべて連結する最小重み部分木の",
      "/// 重みを求める。端子数 `k` に対し O(3^k V + 2^k (V + E) log V) の集合 DP。辺重みは非負（内部で Dijkstra を使う）。",
      "/// 全域木（最小全域木）とは異なり、端子以外の頂点（Steiner 点）を経由してよい点が特徴。",
      "/// 端子が 0/1 個なら 0、連結できないときは [`Self::到達不可`] を返す。",
      "/// - [`Self::解く`] : 端子集合を連結する最小重み。",
      "struct 最小シュタイナー木 {",
      "    n: usize,",
      "    グラフ: Vec<Vec<(usize, i64)>>,",
      "}",
      "impl 最小シュタイナー木 {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            グラフ: vec![Vec::new(); n],",
      "        }",
      "    }",
      "    /// 重み `w`（非負）の無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize, w: impl TryInto<i64>) {",
      "        let w = to_i64(w);",
      "        self.グラフ[u].push((v, w));",
      "        self.グラフ[v].push((u, w));",
      "    }",
      "    /// 連結できないことを表す番兵値。",
      "    fn 到達不可() -> i64 {",
      "        無限大シュタイナー",
      "    }",
      "    /// 端子集合をすべて連結する最小重み部分木の総重みを返す。",
      "    fn 解く(&self, 端子: &[usize]) -> i64 {",
      "        let k = 端子.len();",
      "        if k <= 1 {",
      "            return 0;",
      "        }",
      "        let 全 = 1usize << k;",
      "        let mut dp = vec![vec![無限大シュタイナー; self.n]; 全];",
      "        for (i, &t) in 端子.iter().enumerate() {",
      "            dp[1 << i][t] = 0;",
      "        }",
      "        for mask in 1..全 {",
      "            let mut sub = (mask - 1) & mask;",
      "            while sub > 0 {",
      "                let 他 = mask ^ sub;",
      "                for v in 0..self.n {",
      "                    let 候補 = dp[sub][v].saturating_add(dp[他][v]);",
      "                    if 候補 < dp[mask][v] {",
      "                        dp[mask][v] = 候補;",
      "                    }",
      "                }",
      "                sub = (sub - 1) & mask;",
      "            }",
      "            let mut ヒープ = BinaryHeap::new();",
      "            for (v, &d) in dp[mask].iter().enumerate() {",
      "                if d < 無限大シュタイナー {",
      "                    ヒープ.push((Reverse(d), v));",
      "                }",
      "            }",
      "            while let Some((Reverse(d), now)) = ヒープ.pop() {",
      "                if d > dp[mask][now] {",
      "                    continue;",
      "                }",
      "                for &(next, w) in &self.グラフ[now] {",
      "                    if dp[mask][now] + w < dp[mask][next] {",
      "                        dp[mask][next] = dp[mask][now] + w;",
      "                        ヒープ.push((Reverse(dp[mask][next]), next));",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        dp[全 - 1].iter().copied().min().unwrap()",
      "    }",
      "}"
    ]
  },
  "スキュー_ヒープ": {
    "scope": "rust",
    "prefix": "スキュー_ヒープ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// スキューヒープの節点（最小ヒープ）。値と左右の子を持つ自己平衡しない二分ヒープ。",
      "struct 節点<T> {",
      "    値: T,",
      "    左: Option<Box<節点<T>>>,",
      "    右: Option<Box<節点<T>>>,",
      "}",
      "/// 2 つの部分木を併合する内部関数。",
      "fn 併合節点<T: Ord>(",
      "    a: Option<Box<節点<T>>>,",
      "    b: Option<Box<節点<T>>>,",
      ") -> Option<Box<節点<T>>> {",
      "    match (a, b) {",
      "        (None, x) | (x, None) => x,",
      "        (Some(mut na), Some(mut nb)) => {",
      "            if na.値 > nb.値 {",
      "                std::mem::swap(&mut na, &mut nb);",
      "            }",
      "            let 右 = na.右.take();",
      "            na.右 = 併合節点(右, Some(nb));",
      "            std::mem::swap(&mut na.左, &mut na.右);",
      "            Some(na)",
      "        }",
      "    }",
      "}",
      "/// 2 つのヒープを `O(log n)` で併合（meld）できる最小ヒープ（スキューヒープ）。",
      "/// 標準の `BinaryHeap` は 2 つのヒープの併合に `O(n)` かかるが、本実装は併合・挿入・",
      "/// 最小取り出しすべて償却 `O(log n)`。最小有向全域木や Dijkstra 風のヒープ統合で使う。",
      "#[derive(Default)]",
      "struct スキューヒープ<T: Ord> {",
      "    根: Option<Box<節点<T>>>,",
      "    個数: usize,",
      "}",
      "impl<T: Ord> スキューヒープ<T> {",
      "    /// 空のヒープを作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            根: None, 個数: 0",
      "        }",
      "    }",
      "    /// 要素数を返す。",
      "    fn 個数(&self) -> usize {",
      "        self.個数",
      "    }",
      "    /// 空かどうかを返す。",
      "    fn 空か(&self) -> bool {",
      "        self.個数 == 0",
      "    }",
      "    /// 値 `v` を挿入する。償却 `O(log n)`。",
      "    fn 挿入(&mut self, v: T) {",
      "        let 節 = Some(Box::new(節点 {",
      "            値: v,",
      "            左: None,",
      "            右: None,",
      "        }));",
      "        self.根 = 併合節点(self.根.take(), 節);",
      "        self.個数 += 1;",
      "    }",
      "    /// 最小値への参照を返す（空なら `None`）。`O(1)`。",
      "    fn 最小参照(&self) -> Option<&T> {",
      "        self.根.as_ref().map(|n| &n.値)",
      "    }",
      "    /// 最小値を取り出して返す（空なら `None`）。償却 `O(log n)`。",
      "    fn 最小取り出し(&mut self) -> Option<T> {",
      "        let 根 = self.根.take()?;",
      "        self.個数 -= 1;",
      "        self.根 = 併合節点(根.左, 根.右);",
      "        Some(根.値)",
      "    }",
      "    /// 別のヒープ `other` を自分に併合する。`other` は空になる。償却 `O(log n)`。",
      "    fn 併合(&mut self, other: &mut Self) {",
      "        self.根 = 併合節点(self.根.take(), other.根.take());",
      "        self.個数 += other.個数;",
      "        other.個数 = 0;",
      "    }",
      "}"
    ]
  },
  "スターリング_数": {
    "scope": "rust",
    "prefix": "スターリング_数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::ModInt as Mint;",
      "/// 第二種スターリング数 S(n, k) の表（`0..=n` 行、`0..=n` 列）を前計算して返す。O(n^2)。",
      "/// mod は `Mint`（ac_library::ModInt）のグローバル modulus。Comb は不要。",
      "/// `S(n,k)` は `n` 要素を空でない `k` 個のグループに分割する方法の数。u64 なら n ≥ 27 で溢れる。",
      "fn 第二種スターリング数表(n: usize) -> Vec<Vec<Mint>> {",
      "    let mut s = vec![vec![Mint::new(0); n + 1]; n + 1];",
      "    s[0][0] = Mint::new(1);",
      "    for i in 1..=n {",
      "        for k in 1..=i {",
      "            s[i][k] = Mint::new(k) * s[i - 1][k] + s[i - 1][k - 1];",
      "        }",
      "    }",
      "    s",
      "}"
    ]
  },
  "スパース_テーブル": {
    "scope": "rust",
    "prefix": "スパース_テーブル",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// スパーステーブル。静的（更新なし）な配列に対し、区間 min / max / gcd など",
      "/// 「冪等な二項演算」の区間クエリを前処理 O(N log N)・各クエリ O(1) で答える。",
      "/// `merge` は結合的かつ冪等（`merge(x, x) == x`）な演算であること（min, max, gcd, &, | など）。",
      "/// 和のような非冪等な演算には使えない（その用途は累積和やセグメント木を使う）。",
      "struct スパーステーブル<T, F> {",
      "    table: Vec<Vec<T>>,",
      "    merge: F,",
      "}",
      "impl<T: Copy, F: Fn(T, T) -> T> スパーステーブル<T, F> {",
      "    /// 配列と冪等な二項演算 `merge` からスパーステーブルを構築する。",
      "    /// # 例",
      "    /// ```ignore",
      "    /// let st = スパーステーブル::new(&a, |x, y| x.min(y)); // 区間 min",
      "    /// ```",
      "    fn new(配列: &[T], merge: F) -> Self {",
      "        let n = 配列.len();",
      "        let mut table = vec![配列.to_vec()];",
      "        let mut 幅 = 1;",
      "        while 幅 * 2 <= n {",
      "            let 前 = table.last().unwrap();",
      "            let 行: Vec<T> = (0..=n - 幅 * 2).map(|i| merge(前[i], 前[i + 幅])).collect();",
      "            table.push(行);",
      "            幅 *= 2;",
      "        }",
      "        Self { table, merge }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対する `merge` の畳み込み結果を O(1) で返す。",
      "    /// 空区間は問い合わせ不可。",
      "    fn 区間(&self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.table[0].len());",
      "        debug_assert!(l < r, \"スパーステーブル: 空区間は問い合わせ不可\");",
      "        let j = (usize::BITS - 1 - (r - l).leading_zeros()) as usize;",
      "        (self.merge)(self.table[j][l], self.table[j][r - (1 << j)])",
      "    }",
      "}"
    ]
  },
  "スプラーグ_グランディ": {
    "scope": "rust",
    "prefix": "スプラーグ_グランディ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 非負整数の集合に含まれない最小の非負整数 **mex**（minimum excludant）を返す。`O(N)`。",
      "/// 重複があってもよい（ソート不要）。",
      "fn mex(集合: &[usize]) -> usize {",
      "    let mut 出現 = vec![false; 集合.len() + 1];",
      "    for &x in 集合 {",
      "        if x < 出現.len() {",
      "            出現[x] = true;",
      "        }",
      "    }",
      "    出現.iter().position(|&出| !出).unwrap()",
      "}",
      "/// 状態 `0..=上限` それぞれの**グランディ数**（Sprague–Grundy 値）を表で返す。",
      "/// `遷移(i)` は状態 `i` から 1 手で到達できる状態の集合で、要素はすべて `i` 未満であること",
      "/// （有限・非循環な不偏ゲーム）。`grundy[i] = mex{ grundy[j] : j ∈ 遷移(i) }`。",
      "/// `grundy[i] == 0` が後手必勝（手番側の負け）状態。独立した複数のゲームの合成局面は",
      "/// 各ゲームのグランディ数の XOR（[`ニム和`]）で判定でき、XOR が 0 なら手番側の負け",
      "/// （Sprague–Grundy の定理）。計算量は `O(Σ|遷移(i)|)`。",
      "/// 状態を整数に符号化できる山取り・減算ゲームなどに使う。",
      "fn グランディ数列<F: Fn(usize) -> Vec<usize>>(上限: usize, 遷移: F) -> Vec<usize> {",
      "    let mut g = vec![0usize; 上限 + 1];",
      "    for i in 0..=上限 {",
      "        let 次: Vec<usize> = 遷移(i).iter().map(|&j| g[j]).collect();",
      "        g[i] = mex(&次);",
      "    }",
      "    g",
      "}"
    ]
  },
