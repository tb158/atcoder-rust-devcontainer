  "スロープ_トリック": {
    "scope": "rust",
    "prefix": "スロープ_トリック",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "use std::cmp::Reverse;",
      "use std::collections::BinaryHeap;",
      "/// スロープトリック。区分線形な凸関数 `f(x)` を、傾きが変化する点（折れ点）の多重集合として管理する。",
      "/// 各操作 `O(log N)`。DP の遷移が「`f += max(0, x-a)`」「`f += |x-a|`」",
      "/// 「累積 min（スライド最小値）」などで書けるとき計算量を落とせる。",
      "/// - [`Self::絶対値加算`] : `f(x) += |x - a|`。",
      "/// - [`Self::右側を平坦化`] / [`Self::左側を平坦化`] : 累積 min。",
      "/// - [`Self::最小値`] / [`Self::評価`] : 値の取得。",
      "struct スロープトリック {",
      "    最小値: i64,",
      "    左: BinaryHeap<i64>,",
      "    右: BinaryHeap<Reverse<i64>>,",
      "    加算左: i64,",
      "    加算右: i64,",
      "}",
      "impl スロープトリック {",
      "    /// 恒等的に 0 の関数 `f(x) = 0` を作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            最小値: 0,",
      "            左: BinaryHeap::new(),",
      "            右: BinaryHeap::new(),",
      "            加算左: 0,",
      "            加算右: 0,",
      "        }",
      "    }",
      "    fn 左頂点(&self) -> Option<i64> {",
      "        self.左.peek().map(|&v| v + self.加算左)",
      "    }",
      "    fn 右頂点(&self) -> Option<i64> {",
      "        self.右.peek().map(|&Reverse(v)| v + self.加算右)",
      "    }",
      "    fn 左へ(&mut self, a: i64) {",
      "        self.左.push(a - self.加算左);",
      "    }",
      "    fn 右へ(&mut self, a: i64) {",
      "        self.右.push(Reverse(a - self.加算右));",
      "    }",
      "    /// 現在の最小値 `min_x f(x)`。",
      "    fn 最小値(&self) -> i64 {",
      "        self.最小値",
      "    }",
      "    /// `f(x) += c`（定数加算）。引数は任意の整数型でよい（他のメソッドも同様）。",
      "    fn 定数加算(&mut self, c: impl TryInto<i64>) {",
      "        self.最小値 += to_i64(c);",
      "    }",
      "    /// `f(x) += max(0, x - a)`（右上がりの折れを追加）。",
      "    fn 右傾き加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        if let Some(l) = self.左頂点()",
      "            && l > a",
      "        {",
      "            self.最小値 += l - a;",
      "        }",
      "        self.左へ(a);",
      "        let v = self.左.pop().unwrap() + self.加算左;",
      "        self.右へ(v);",
      "    }",
      "    /// `f(x) += max(0, a - x)`（左上がりの折れを追加）。",
      "    fn 左傾き加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        if let Some(r) = self.右頂点()",
      "            && r < a",
      "        {",
      "            self.最小値 += a - r;",
      "        }",
      "        self.右へ(a);",
      "        let Reverse(v) = self.右.pop().unwrap();",
      "        let v = v + self.加算右;",
      "        self.左へ(v);",
      "    }",
      "    /// `f(x) += |x - a|`。",
      "    fn 絶対値加算(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        self.右傾き加算(a);",
      "        self.左傾き加算(a);",
      "    }",
      "    /// 累積 min: `f(x) := min_{y <= x} f(y)`（右側の上がりを消し、右へ平坦化）。",
      "    fn 右側を平坦化(&mut self) {",
      "        self.右.clear();",
      "    }",
      "    /// 累積 min: `f(x) := min_{y >= x} f(y)`（左側の上がりを消し、左へ平坦化）。",
      "    fn 左側を平坦化(&mut self) {",
      "        self.左.clear();",
      "    }",
      "    /// 平行移動: `f(x) := f(x - a)`（全折れ点を `a` ずらす）。",
      "    fn 平行移動(&mut self, a: impl TryInto<i64>) {",
      "        let a = to_i64(a);",
      "        self.加算左 += a;",
      "        self.加算右 += a;",
      "    }",
      "    /// スライド最小値: `f(x) := min_{a <= d <= b} f(x - d)`（`a <= b`）。",
      "    fn 窓最小(&mut self, a: impl TryInto<i64>, b: impl TryInto<i64>) {",
      "        let (a, b) = (to_i64(a), to_i64(b));",
      "        assert!(a <= b);",
      "        self.加算左 += a;",
      "        self.加算右 += b;",
      "    }",
      "    /// `f(x)` の値を O(N) で評価する。",
      "    fn 評価(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        let mut v = self.最小値;",
      "        for &l in self.左.iter() {",
      "            let l = l + self.加算左;",
      "            if l > x {",
      "                v += l - x;",
      "            }",
      "        }",
      "        for &Reverse(r) in self.右.iter() {",
      "            let r = r + self.加算右;",
      "            if r < x {",
      "                v += x - r;",
      "            }",
      "        }",
      "        v",
      "    }",
      "}",
      "impl Default for スロープトリック {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "セグメント_篩": {
    "scope": "rust",
    "prefix": "セグメント_篩",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 区間（`l..r`=半開 / `l..=r`=閉。`..=r` のように下端省略も可）に含まれる素数をすべて昇順で返す",
      "/// **区間篩**。`r` が `10¹²` 程度でも、区間幅 `r−l` が小さければ高速に列挙できる。計算量",
      "/// `O((√r) + (r−l) loglog r)`、追加メモリ `O(√r + 区間幅)`。上端は必須（土台の長さが無いので",
      "/// `..` や `l..` は解決できず panic）。",
      "/// 同じファイルの [`素因数分解器`] は上限 `5·10⁷` までの線形篩なので `r` が大きいと使えない。",
      "/// 区間篩は「`10¹²` 近辺の素数」のように上限だけ大きく幅が狭い場合に使う。",
      "fn 区間篩<T: Copy + TryInto<u64>>(範囲: impl std::ops::RangeBounds<T>) -> Vec<usize> {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let 変換 = |x: T| -> u64 {",
      "        x.try_into()",
      "            .ok()",
      "            .expect(\"区間篩: 引数が u64 に収まりません\")",
      "    };",
      "    let l: u64 = match 範囲.start_bound() {",
      "        Included(&x) => 変換(x),",
      "        Excluded(&x) => 変換(x).saturating_add(1),",
      "        Unbounded => 0,",
      "    };",
      "    let r: u64 = match 範囲.end_bound() {",
      "        Included(&x) => 変換(x),",
      "        Excluded(&x) => 変換(x).saturating_sub(1),",
      "        Unbounded => panic!(\"区間篩: 上端は必須（.. や l.. は不可。l..r か l..=r を使う）\"),",
      "    };",
      "    if r < 2 || l > r {",
      "        return Vec::new();",
      "    }",
      "    let l = l.max(2);",
      "    let lim = (r as f64).sqrt() as u64 + 2;",
      "    let mut 合成基底 = vec![false; (lim + 1) as usize];",
      "    let mut 基底素数 = Vec::new();",
      "    for i in 2..=lim {",
      "        if !合成基底[i as usize] {",
      "            基底素数.push(i);",
      "            let mut j = i * i;",
      "            while j <= lim {",
      "                合成基底[j as usize] = true;",
      "                j += i;",
      "            }",
      "        }",
      "    }",
      "    let 幅 = (r - l + 1) as usize;",
      "    let mut 合成 = vec![false; 幅];",
      "    for &p in &基底素数 {",
      "        let mut 始 = l.div_ceil(p) * p;",
      "        始 = 始.max(p * p);",
      "        let mut j = 始;",
      "        while j <= r {",
      "            合成[(j - l) as usize] = true;",
      "            j += p;",
      "        }",
      "    }",
      "    (l..=r)",
      "        .filter(|&x| !合成[(x - l) as usize])",
      "        .map(|x| x as usize)",
      "        .collect()",
      "}"
    ]
  },
  "セグ木_ビーツ": {
    "scope": "rust",
    "prefix": "セグ木_ビーツ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Segment Tree Beats の 1 ノード。最大側（最大値・厳密な 2 番目・最大値の個数）と",
      "/// 最小側（最小値・厳密な 2 番目・最小値の個数）、区間和、要素数を持つ。",
      "#[derive(Clone)]",
      "struct 節点 {",
      "    最大1: i64,",
      "    最大2: i64,",
      "    最大個数: i64,",
      "    最小1: i64,",
      "    最小2: i64,",
      "    最小個数: i64,",
      "    和: i64,",
      "    要素数: i64,",
      "}",
      "const 無限大: i64 = 1 << 60;",
      "impl 節点 {",
      "    fn 葉(v: i64) -> Self {",
      "        Self {",
      "            最大1: v,",
      "            最大2: -無限大,",
      "            最大個数: 1,",
      "            最小1: v,",
      "            最小2: 無限大,",
      "            最小個数: 1,",
      "            和: v,",
      "            要素数: 1,",
      "        }",
      "    }",
      "    fn 空() -> Self {",
      "        Self {",
      "            最大1: -無限大,",
      "            最大2: -無限大,",
      "            最大個数: 0,",
      "            最小1: 無限大,",
      "            最小2: 無限大,",
      "            最小個数: 0,",
      "            和: 0,",
      "            要素数: 0,",
      "        }",
      "    }",
      "}",
      "/// 2 つの子ノードを統合する。",
      "fn 合成(l: &節点, r: &節点) -> 節点 {",
      "    let mut p = 節点::空();",
      "    p.和 = l.和 + r.和;",
      "    p.要素数 = l.要素数 + r.要素数;",
      "    if l.最大1 == r.最大1 {",
      "        p.最大1 = l.最大1;",
      "        p.最大個数 = l.最大個数 + r.最大個数;",
      "        p.最大2 = l.最大2.max(r.最大2);",
      "    } else if l.最大1 > r.最大1 {",
      "        p.最大1 = l.最大1;",
      "        p.最大個数 = l.最大個数;",
      "        p.最大2 = l.最大2.max(r.最大1);",
      "    } else {",
      "        p.最大1 = r.最大1;",
      "        p.最大個数 = r.最大個数;",
      "        p.最大2 = r.最大2.max(l.最大1);",
      "    }",
      "    if l.最小1 == r.最小1 {",
      "        p.最小1 = l.最小1;",
      "        p.最小個数 = l.最小個数 + r.最小個数;",
      "        p.最小2 = l.最小2.min(r.最小2);",
      "    } else if l.最小1 < r.最小1 {",
      "        p.最小1 = l.最小1;",
      "        p.最小個数 = l.最小個数;",
      "        p.最小2 = l.最小2.min(r.最小1);",
      "    } else {",
      "        p.最小1 = r.最小1;",
      "        p.最小個数 = r.最小個数;",
      "        p.最小2 = r.最小2.min(l.最小1);",
      "    }",
      "    p",
      "}",
      "/// Segment Tree Beats。区間 chmin（`a[i] = min(a[i], x)`）・区間 chmax・区間和・区間最大・区間最小を",
      "/// ならし O(log^2 N) で処理する。`ac_library::LazySegtree` では chmin/chmax は扱えない。",
      "/// - [`Self::区間chmin`] / [`Self::区間chmax`] : 半開区間 `[l, r)` への min/max 更新。",
      "/// - [`Self::区間和`] / [`Self::区間最大`] / [`Self::区間最小`] : 半開区間 `[l, r)` の集計。",
      "struct セグ木ビーツ {",
      "    n: usize,",
      "    木: Vec<節点>,",
      "}",
      "impl セグ木ビーツ {",
      "    /// 初期配列から構築する。",
      "    fn new(配列: &[i64]) -> Self {",
      "        let n = 配列.len();",
      "        let mut t = Self {",
      "            n,",
      "            木: vec![節点::空(); 4 * n.max(1)],",
      "        };",
      "        if n > 0 {",
      "            t.構築(1, 0, n, 配列);",
      "        }",
      "        t",
      "    }",
      "    fn 構築(&mut self, 節: usize, lo: usize, hi: usize, 配列: &[i64]) {",
      "        if hi - lo == 1 {",
      "            self.木[節] = 節点::葉(配列[lo]);",
      "            return;",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        self.構築(2 * 節, lo, m, 配列);",
      "        self.構築(2 * 節 + 1, m, hi, 配列);",
      "        self.統合(節);",
      "    }",
      "    fn 統合(&mut self, 節: usize) {",
      "        self.木[節] = 合成(&self.木[2 * 節].clone(), &self.木[2 * 節 + 1].clone());",
      "    }",
      "    /// 節点 `節` の最大値を `x` 以下に抑える（`x > 最大2` が前提）。",
      "    fn chmin適用(&mut self, 節: usize, x: i64) {",
      "        let nd = &mut self.木[節];",
      "        if x >= nd.最大1 {",
      "            return;",
      "        }",
      "        nd.和 -= (nd.最大1 - x) * nd.最大個数;",
      "        if nd.最小1 == nd.最大1 {",
      "            nd.最小1 = x;",
      "        } else if nd.最小2 == nd.最大1 {",
      "            nd.最小2 = x;",
      "        }",
      "        nd.最大1 = x;",
      "    }",
      "    /// 節点 `節` の最小値を `x` 以上に持ち上げる（`x < 最小2` が前提）。",
      "    fn chmax適用(&mut self, 節: usize, x: i64) {",
      "        let nd = &mut self.木[節];",
      "        if x <= nd.最小1 {",
      "            return;",
      "        }",
      "        nd.和 += (x - nd.最小1) * nd.最小個数;",
      "        if nd.最大1 == nd.最小1 {",
      "            nd.最大1 = x;",
      "        } else if nd.最大2 == nd.最小1 {",
      "            nd.最大2 = x;",
      "        }",
      "        nd.最小1 = x;",
      "    }",
      "    /// 親の cap（最大1）・floor（最小1）を子へ伝播する。",
      "    fn 伝播(&mut self, 節: usize) {",
      "        let cap = self.木[節].最大1;",
      "        let floor = self.木[節].最小1;",
      "        for 子 in [2 * 節, 2 * 節 + 1] {",
      "            self.chmin適用(子, cap);",
      "            self.chmax適用(子, floor);",
      "        }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対し `a[i] = min(a[i], x)`。ならし `O(log² N)`。",
      "    fn 区間chmin(&mut self, 範囲: impl std::ops::RangeBounds<usize>, x: impl TryInto<i64>) {",
      "        let x = to_i64(x);",
      "        let (l, r) = 半開(範囲, self.n);",
      "        if l < r {",
      "            self.chmin内部(1, 0, self.n, l, r, x);",
      "        }",
      "    }",
      "    fn chmin内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize, x: i64) {",
      "        if r <= lo || hi <= l || self.木[節].最大1 <= x {",
      "            return;",
      "        }",
      "        if l <= lo && hi <= r && self.木[節].最大2 < x {",
      "            self.chmin適用(節, x);",
      "            return;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.chmin内部(2 * 節, lo, m, l, r, x);",
      "        self.chmin内部(2 * 節 + 1, m, hi, l, r, x);",
      "        self.統合(節);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対し `a[i] = max(a[i], x)`。ならし `O(log² N)`。",
      "    fn 区間chmax(&mut self, 範囲: impl std::ops::RangeBounds<usize>, x: impl TryInto<i64>) {",
      "        let x = to_i64(x);",
      "        let (l, r) = 半開(範囲, self.n);",
      "        if l < r {",
      "            self.chmax内部(1, 0, self.n, l, r, x);",
      "        }",
      "    }",
      "    fn chmax内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize, x: i64) {",
      "        if r <= lo || hi <= l || self.木[節].最小1 >= x {",
      "            return;",
      "        }",
      "        if l <= lo && hi <= r && self.木[節].最小2 > x {",
      "            self.chmax適用(節, x);",
      "            return;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.chmax内部(2 * 節, lo, m, l, r, x);",
      "        self.chmax内部(2 * 節 + 1, m, hi, l, r, x);",
      "        self.統合(節);",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の総和。ならし `O(log N)`。",
      "    fn 区間和(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.和内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 和内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return 0;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].和;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.和内部(2 * 節, lo, m, l, r) + self.和内部(2 * 節 + 1, m, hi, l, r)",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の最大値。ならし `O(log N)`。",
      "    fn 区間最大(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.最大内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 最大内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return -無限大;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].最大1;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.最大内部(2 * 節, lo, m, l, r)",
      "            .max(self.最大内部(2 * 節 + 1, m, hi, l, r))",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）の最小値。ならし `O(log N)`。",
      "    fn 区間最小(&mut self, 範囲: impl std::ops::RangeBounds<usize>) -> i64 {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.最小内部(1, 0, self.n, l, r)",
      "    }",
      "    fn 最小内部(&mut self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> i64 {",
      "        if r <= lo || hi <= l {",
      "            return 無限大;",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.木[節].最小1;",
      "        }",
      "        self.伝播(節);",
      "        let m = (lo + hi) / 2;",
      "        self.最小内部(2 * 節, lo, m, l, r)",
      "            .min(self.最小内部(2 * 節 + 1, m, hi, l, r))",
      "    }",
      "}"
    ]
  },
  "ゼロイチ_BFS": {
    "scope": "rust",
    "prefix": "ゼロイチ_BFS",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 0-1 BFS。辺の重みが 0 か 1 のグラフの単一始点最短距離を O(V+E) で求める。",
      "/// `グラフ[u]` は `(隣接頂点, 重み)` の列で、重みは 0 または 1 のみ。",
      "/// 重み 0 の辺は両端デックの先頭へ、重み 1 の辺は末尾へ入れることで距離順を保つ。",
      "/// 到達不能な頂点は `None`。",
      "fn zero_one_bfs(グラフ: &[Vec<(usize, usize)>], 始点: usize) -> Vec<Option<usize>> {",
      "    use std::collections::VecDeque;",
      "    let n = グラフ.len();",
      "    let mut 距離: Vec<Option<usize>> = vec![None; n];",
      "    let mut 探索: VecDeque<usize> = VecDeque::new();",
      "    距離[始点] = Some(0);",
      "    探索.push_back(始点);",
      "    while let Some(now) = 探索.pop_front() {",
      "        let d = 距離[now].unwrap();",
      "        for &(next, w) in &グラフ[now] {",
      "            let 新 = d + w;",
      "            if 距離[next].is_none_or(|現| 新 < 現) {",
      "                距離[next] = Some(新);",
      "                if w == 0 {",
      "                    探索.push_front(next);",
      "                } else {",
      "                    探索.push_back(next);",
      "                }",
      "            }",
      "        }",
      "    }",
      "    距離",
      "}"
    ]
  },
  "ソート済み_インデックスアクセス可": {
    "scope": "rust",
    "prefix": "ソート済み_インデックスアクセス可",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ソート済み多重集合（平方分割）。常に昇順に並んだ多重集合で、挿入・1 個削除・k 番目・",
      "/// 順位（`x` 未満／以下の個数）・`x` 以上の最小／`x` 以下の最大をまとめて扱う。",
      "/// 値を事前に知らなくてよい（オンライン）ので、二分探索をその場で書かずにここへ押し付けられる。",
      "/// 内部は長さ 1024 以下の昇順 `Vec` を並べたバケット列。各バケット末尾への二分探索で対象バケットを",
      "/// 決め、バケット内も二分探索する。1024 を超えたバケットは半分に割り、空になったバケットは除去する。",
      "/// バケット数を `B`（≤ 挿入回数 / 512 + 1。`N = 2·10^5` なら約 400）として",
      "/// - [`Self::挿入`] / [`Self::削除`] : 二分探索 + バケット内の `Vec` 途中挿入・削除で `O(log N + 1024 + B)`",
      "/// - [`Self::以上の最小`] / [`Self::以下の最大`] / [`Self::最小`] / [`Self::最大`] : `O(log N)`",
      "/// - [`Self::k番目`] / [`Self::未満の個数`] / [`Self::以下の個数`] : バケット長の線形走査で `O(B + log N)`",
      "/// - [`Self::含む個数`] : `O(log N + x がまたがるバケット数)`",
      "/// `BTreeSet` / `BTreeMap` は k 番目・順位を取れない。[`二進トライ`](crate::binary_trie::二進トライ) は",
      "/// 非負整数専用でメモリも重く、BIT＋座標圧縮は値を先読みできるとき限定、",
      "/// [`陰的Treap`](crate::treap::陰的Treap) は位置で管理する列なので、値の大小で並べたいならこちらを使う。",
      "/// 値の型は `Ord + Copy` なら何でもよい（整数・`(i64, usize)` などのタプル・`char`）。",
      "/// 引数も返り値も値渡しにして呼び出し側の `&` / `*` を省くため `Copy` を要求する。",
      "#[derive(Clone, Debug)]",
      "struct ソート済み多重集合<T> {",
      "    バケット: Vec<Vec<T>>,",
      "    長さ: usize,",
      "}",
      "impl<T: Ord + Copy> ソート済み多重集合<T> {",
      "    /// バケットを半分に割る長さ。小さいと k 番目・順位の線形走査が、大きいと `Vec` の途中挿入が重い。",
      "    /// `N = 2·10^5`・値 `[0, 10^9)` の乱数で挿入／k 番目／順位を各 `N` 回した合計（1.89.0 release）:",
      "    /// 256 → 109ms, 512 → 66ms, 1024 → 54ms, 2048 → 57ms, 4096 → 74ms。",
      "    const 分割閾値: usize = 1024;",
      "    /// 空の多重集合を作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            バケット: Vec::new(),",
      "            長さ: 0,",
      "        }",
      "    }",
      "    /// 要素数（重複込み）。",
      "    fn 長さ(&self) -> usize {",
      "        self.長さ",
      "    }",
      "    /// 空かどうか。",
      "    fn 空か(&self) -> bool {",
      "        self.長さ == 0",
      "    }",
      "    /// 昇順に見て true が続きある所から false になる述語 `前か` が、初めて false になる要素の位置",
      "    /// `(バケット番号, バケット内位置)`。全要素で true なら `(バケット数, 0)`。",
      "    fn 境界(&self, 前か: impl Fn(T) -> bool) -> (usize, usize) {",
      "        let i = self.バケット.partition_point(|b| 前か(b[b.len() - 1]));",
      "        let j = self",
      "            .バケット",
      "            .get(i)",
      "            .map_or(0, |b| b.partition_point(|&y| 前か(y)));",
      "        (i, j)",
      "    }",
      "    /// 値 `x` を 1 個追加する。",
      "    fn 挿入(&mut self, x: T) {",
      "        self.長さ += 1;",
      "        if self.バケット.is_empty() {",
      "            self.バケット.push(vec![x]);",
      "            return;",
      "        }",
      "        let (mut i, mut j) = self.境界(|y| y < x);",
      "        if i == self.バケット.len() {",
      "            i -= 1;",
      "            j = self.バケット[i].len();",
      "        }",
      "        let b = &mut self.バケット[i];",
      "        b.insert(j, x);",
      "        if b.len() > Self::分割閾値 {",
      "            let 後半 = b.split_off(b.len() / 2);",
      "            self.バケット.insert(i + 1, 後半);",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個だけ削除し、削除できたら `true`（無ければ何もせず `false`）。",
      "    fn 削除(&mut self, x: T) -> bool {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        match self.バケット.get_mut(i) {",
      "            Some(b) if b[j] == x => {",
      "                b.remove(j);",
      "                if b.is_empty() {",
      "                    self.バケット.remove(i);",
      "                }",
      "                self.長さ -= 1;",
      "                true",
      "            }",
      "            _ => false,",
      "        }",
      "    }",
      "    /// 0 始まりで `k` 番目に小さい値（重複込み）。`k >= 長さ` なら panic。",
      "    fn k番目(&self, k: usize) -> T {",
      "        let mut 残り = k;",
      "        for b in &self.バケット {",
      "            if 残り < b.len() {",
      "                return b[残り];",
      "            }",
      "            残り -= b.len();",
      "        }",
      "        panic!(\"ソート済み多重集合: k = {k} が範囲外（長さ {}）\", self.長さ)",
      "    }",
      "    /// `x` 未満の要素数（`x` の順位。`k番目(未満の個数(x))` が `x` 以上の最小）。",
      "    fn 未満の個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        self.バケット[..i].iter().map(Vec::len).sum::<usize>() + j",
      "    }",
      "    /// `x` 以下の要素数。",
      "    fn 以下の個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y <= x);",
      "        self.バケット[..i].iter().map(Vec::len).sum::<usize>() + j",
      "    }",
      "    /// 値 `x` の個数。",
      "    fn 含む個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        let (i2, j2) = self.境界(|y| y <= x);",
      "        self.バケット[i..i2].iter().map(Vec::len).sum::<usize>() + j2 - j",
      "    }",
      "    /// `x` 以上の最小値（無ければ `None`）。",
      "    fn 以上の最小(&self, x: T) -> Option<T> {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        self.バケット.get(i).map(|b| b[j])",
      "    }",
      "    /// `x` 以下の最大値（無ければ `None`）。",
      "    fn 以下の最大(&self, x: T) -> Option<T> {",
      "        let (i, j) = self.境界(|y| y <= x);",
      "        if j > 0 {",
      "            Some(self.バケット[i][j - 1])",
      "        } else {",
      "            self.バケット[..i].last().map(|b| b[b.len() - 1])",
      "        }",
      "    }",
      "    /// 最小値（空なら `None`）。",
      "    fn 最小(&self) -> Option<T> {",
      "        self.バケット.first().map(|b| b[0])",
      "    }",
      "    /// 最大値（空なら `None`）。",
      "    fn 最大(&self) -> Option<T> {",
      "        self.バケット.last().map(|b| b[b.len() - 1])",
      "    }",
      "    /// 全要素を昇順に列挙する（重複込み）。",
      "    fn 昇順(&self) -> impl Iterator<Item = T> {",
      "        self.バケット.iter().flatten().copied()",
      "    }",
      "}",
      "impl<T: Ord + Copy> Default for ソート済み多重集合<T> {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "ソート済み_多重集合": {
    "scope": "rust",
    "prefix": "ソート済み_多重集合",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ソート済み多重集合（平方分割）。常に昇順に並んだ多重集合で、挿入・1 個削除・k 番目・",
      "/// 順位（`x` 未満／以下の個数）・`x` 以上の最小／`x` 以下の最大をまとめて扱う。",
      "/// 値を事前に知らなくてよい（オンライン）ので、二分探索をその場で書かずにここへ押し付けられる。",
      "/// 内部は長さ 1024 以下の昇順 `Vec` を並べたバケット列。各バケット末尾への二分探索で対象バケットを",
      "/// 決め、バケット内も二分探索する。1024 を超えたバケットは半分に割り、空になったバケットは除去する。",
      "/// バケット数を `B`（≤ 挿入回数 / 512 + 1。`N = 2·10^5` なら約 400）として",
      "/// - [`Self::挿入`] / [`Self::削除`] : 二分探索 + バケット内の `Vec` 途中挿入・削除で `O(log N + 1024 + B)`",
      "/// - [`Self::以上の最小`] / [`Self::以下の最大`] / [`Self::最小`] / [`Self::最大`] : `O(log N)`",
      "/// - [`Self::k番目`] / [`Self::未満の個数`] / [`Self::以下の個数`] : バケット長の線形走査で `O(B + log N)`",
      "/// - [`Self::含む個数`] : `O(log N + x がまたがるバケット数)`",
      "/// `BTreeSet` / `BTreeMap` は k 番目・順位を取れない。[`二進トライ`](crate::binary_trie::二進トライ) は",
      "/// 非負整数専用でメモリも重く、BIT＋座標圧縮は値を先読みできるとき限定、",
      "/// [`陰的Treap`](crate::treap::陰的Treap) は位置で管理する列なので、値の大小で並べたいならこちらを使う。",
      "/// 値の型は `Ord + Copy` なら何でもよい（整数・`(i64, usize)` などのタプル・`char`）。",
      "/// 引数も返り値も値渡しにして呼び出し側の `&` / `*` を省くため `Copy` を要求する。",
      "#[derive(Clone, Debug)]",
      "struct ソート済み多重集合<T> {",
      "    バケット: Vec<Vec<T>>,",
      "    長さ: usize,",
      "}",
      "impl<T: Ord + Copy> ソート済み多重集合<T> {",
      "    /// バケットを半分に割る長さ。小さいと k 番目・順位の線形走査が、大きいと `Vec` の途中挿入が重い。",
      "    /// `N = 2·10^5`・値 `[0, 10^9)` の乱数で挿入／k 番目／順位を各 `N` 回した合計（1.89.0 release）:",
      "    /// 256 → 109ms, 512 → 66ms, 1024 → 54ms, 2048 → 57ms, 4096 → 74ms。",
      "    const 分割閾値: usize = 1024;",
      "    /// 空の多重集合を作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            バケット: Vec::new(),",
      "            長さ: 0,",
      "        }",
      "    }",
      "    /// 要素数（重複込み）。",
      "    fn 長さ(&self) -> usize {",
      "        self.長さ",
      "    }",
      "    /// 空かどうか。",
      "    fn 空か(&self) -> bool {",
      "        self.長さ == 0",
      "    }",
      "    /// 昇順に見て true が続きある所から false になる述語 `前か` が、初めて false になる要素の位置",
      "    /// `(バケット番号, バケット内位置)`。全要素で true なら `(バケット数, 0)`。",
      "    fn 境界(&self, 前か: impl Fn(T) -> bool) -> (usize, usize) {",
      "        let i = self.バケット.partition_point(|b| 前か(b[b.len() - 1]));",
      "        let j = self",
      "            .バケット",
      "            .get(i)",
      "            .map_or(0, |b| b.partition_point(|&y| 前か(y)));",
      "        (i, j)",
      "    }",
      "    /// 値 `x` を 1 個追加する。",
      "    fn 挿入(&mut self, x: T) {",
      "        self.長さ += 1;",
      "        if self.バケット.is_empty() {",
      "            self.バケット.push(vec![x]);",
      "            return;",
      "        }",
      "        let (mut i, mut j) = self.境界(|y| y < x);",
      "        if i == self.バケット.len() {",
      "            i -= 1;",
      "            j = self.バケット[i].len();",
      "        }",
      "        let b = &mut self.バケット[i];",
      "        b.insert(j, x);",
      "        if b.len() > Self::分割閾値 {",
      "            let 後半 = b.split_off(b.len() / 2);",
      "            self.バケット.insert(i + 1, 後半);",
      "        }",
      "    }",
      "    /// 値 `x` を 1 個だけ削除し、削除できたら `true`（無ければ何もせず `false`）。",
      "    fn 削除(&mut self, x: T) -> bool {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        match self.バケット.get_mut(i) {",
      "            Some(b) if b[j] == x => {",
      "                b.remove(j);",
      "                if b.is_empty() {",
      "                    self.バケット.remove(i);",
      "                }",
      "                self.長さ -= 1;",
      "                true",
      "            }",
      "            _ => false,",
      "        }",
      "    }",
      "    /// 0 始まりで `k` 番目に小さい値（重複込み）。`k >= 長さ` なら panic。",
      "    fn k番目(&self, k: usize) -> T {",
      "        let mut 残り = k;",
      "        for b in &self.バケット {",
      "            if 残り < b.len() {",
      "                return b[残り];",
      "            }",
      "            残り -= b.len();",
      "        }",
      "        panic!(\"ソート済み多重集合: k = {k} が範囲外（長さ {}）\", self.長さ)",
      "    }",
      "    /// `x` 未満の要素数（`x` の順位。`k番目(未満の個数(x))` が `x` 以上の最小）。",
      "    fn 未満の個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        self.バケット[..i].iter().map(Vec::len).sum::<usize>() + j",
      "    }",
      "    /// `x` 以下の要素数。",
      "    fn 以下の個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y <= x);",
      "        self.バケット[..i].iter().map(Vec::len).sum::<usize>() + j",
      "    }",
      "    /// 値 `x` の個数。",
      "    fn 含む個数(&self, x: T) -> usize {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        let (i2, j2) = self.境界(|y| y <= x);",
      "        self.バケット[i..i2].iter().map(Vec::len).sum::<usize>() + j2 - j",
      "    }",
      "    /// `x` 以上の最小値（無ければ `None`）。",
      "    fn 以上の最小(&self, x: T) -> Option<T> {",
      "        let (i, j) = self.境界(|y| y < x);",
      "        self.バケット.get(i).map(|b| b[j])",
      "    }",
      "    /// `x` 以下の最大値（無ければ `None`）。",
      "    fn 以下の最大(&self, x: T) -> Option<T> {",
      "        let (i, j) = self.境界(|y| y <= x);",
      "        if j > 0 {",
      "            Some(self.バケット[i][j - 1])",
      "        } else {",
      "            self.バケット[..i].last().map(|b| b[b.len() - 1])",
      "        }",
      "    }",
      "    /// 最小値（空なら `None`）。",
      "    fn 最小(&self) -> Option<T> {",
      "        self.バケット.first().map(|b| b[0])",
      "    }",
      "    /// 最大値（空なら `None`）。",
      "    fn 最大(&self) -> Option<T> {",
      "        self.バケット.last().map(|b| b[b.len() - 1])",
      "    }",
      "    /// 全要素を昇順に列挙する（重複込み）。",
      "    fn 昇順(&self) -> impl Iterator<Item = T> {",
      "        self.バケット.iter().flatten().copied()",
      "    }",
      "}",
      "impl<T: Ord + Copy> Default for ソート済み多重集合<T> {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "ダブリング": {
    "scope": "rust",
    "prefix": "ダブリング",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ダブリング。「各頂点から1回で進む先」を与えると、任意の頂点から",
      "/// `k` 回進んだ先を O(log k) で求められるよう前処理する。",
      "/// 各頂点の出次数が 1 のグラフ（ファンクショナルグラフ）での「k 個先」、",
      "/// 「同じ写像を k 回適用した結果」などに使う。",
      "struct ダブリング {",
      "    /// `table[j][v]` = `v` から `2^j` 回進んだ先",
      "    table: Vec<Vec<usize>>,",
      "}",
      "impl ダブリング {",
      "    /// `次[v]` = `v` から1回で進む先（`0..次.len()`）。",
      "    /// `最大回数` までのジャンプに対応するテーブルを構築する。O(N log(最大回数))。",
      "    fn new(次: &[usize], 最大回数: usize) -> Self {",
      "        let n = 次.len();",
      "        let log = (usize::BITS - 最大回数.leading_zeros()).max(1) as usize;",
      "        let mut table = vec![vec![0usize; n]; log];",
      "        table[0].copy_from_slice(次);",
      "        for j in 1..log {",
      "            for v in 0..n {",
      "                table[j][v] = table[j - 1][table[j - 1][v]];",
      "            }",
      "        }",
      "        Self { table }",
      "    }",
      "    /// `始点` から `回数` 回進んだ先の頂点を返す。`回数 <= 最大回数` であること。O(log 回数)。",
      "    fn 進む(&self, 始点: usize, mut 回数: usize) -> usize {",
      "        let mut v = 始点;",
      "        let mut j = 0;",
      "        while 回数 > 0 {",
      "            if 回数 & 1 == 1 {",
      "                v = self.table[j][v];",
      "            }",
      "            回数 >>= 1;",
      "            j += 1;",
      "        }",
      "        v",
      "    }",
      "    /// `始点` から進み続け、到達頂点が `条件` を満たす限り進めるだけ進んだ回数を返す。O(log)。",
      "    /// `条件` は経路上で単調（一度偽になったら以降ずっと偽）であることが前提。",
      "    /// 添字が単調増加する遷移（次がより大きい添字を指す）で「上限以下に留まれる最大回数」などに使う。",
      "    /// 例: `d.進める回数(始点, |v| v <= 上限)`。返り値はそのまま [`進む`](Self::進む) に渡せる。",
      "    fn 進める回数(&self, 始点: usize, mut 条件: impl FnMut(usize) -> bool) -> usize {",
      "        let mut 現在 = 始点;",
      "        let mut 回数 = 0;",
      "        for j in (0..self.table.len()).rev() {",
      "            let 行先 = self.table[j][現在];",
      "            if 条件(行先) {",
      "                回数 += 1 << j;",
      "                現在 = 行先;",
      "            }",
      "        }",
      "        回数",
      "    }",
      "}"
    ]
  },
  "デカルト_木": {
    "scope": "rust",
    "prefix": "デカルト_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 配列からデカルト木（Cartesian tree）を O(N) で構築する。返り値は `(親配列, 根)`。",
      "/// 親配列の根は `-1`。値が等しいときは添字の小さい方を祖先（根側）にする最小ヒープ版。",
      "/// デカルト木は「中順走査が元の配列順」かつ「親の値 <= 子の値（最小ヒープ）」を満たす二分木で、",
      "/// 区間最小値クエリ（RMQ）を LCA に帰着したり、ヒストグラム最大長方形・単調スタック系の問題に使える。",
      "/// 要素型 `T` は順序比較できる型なら何でもよい（`i64`・`f64` など `PartialOrd`）。",
      "fn デカルト木<T: PartialOrd>(a: &[T]) -> (Vec<i64>, usize) {",
      "    let n = a.len();",
      "    let mut prev = vec![-1i64; n];",
      "    let mut スタック: Vec<usize> = Vec::new();",
      "    for i in 0..n {",
      "        let mut 直前 = -1i64;",
      "        while let Some(&天) = スタック.last() {",
      "            if a[天] <= a[i] {",
      "                break;",
      "            }",
      "            直前 = 天 as i64;",
      "            スタック.pop();",
      "        }",
      "        if 直前 != -1 {",
      "            prev[直前 as usize] = i as i64;",
      "        }",
      "        if let Some(&天) = スタック.last() {",
      "            prev[i] = 天 as i64;",
      "        }",
      "        スタック.push(i);",
      "    }",
      "    let 根 = (0..n).find(|&i| prev[i] == -1).unwrap_or(0);",
      "    (prev, 根)",
      "}"
    ]
  },
  "トネリ_シャンクス": {
    "scope": "rust",
    "prefix": "トネリ_シャンクス",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `p` を法とする平方根：`x^2 ≡ a (mod p)` を満たす `x` を 1 つ返す（無ければ `None`）。",
      "/// Tonelli-Shanks 法。期待 O(log^2 p)。",
      "/// `p` は**素数**であること。`a` は `mod p` 前で渡してよい。返り値 `x` に対し `p - x` も解。",
      "/// `a ≡ 0` のときは `Some(0)`。平方非剰余なら `None`。`p < 2^31` 程度を想定。",
      "fn modの平方根(a: u64, p: u64) -> Option<u64> {",
      "    let a = a % p;",
      "    if a == 0 {",
      "        return Some(0);",
      "    }",
      "    if p == 2 {",
      "        return Some(a & 1);",
      "    }",
      "    if 累乗_mod(a, (p - 1) / 2, p) != 1 {",
      "        return None;",
      "    }",
      "    if p % 4 == 3 {",
      "        return Some(累乗_mod(a, (p + 1) / 4, p));",
      "    }",
      "    let mut q = p - 1;",
      "    let mut s = 0u32;",
      "    while q % 2 == 0 {",
      "        q /= 2;",
      "        s += 1;",
      "    }",
      "    let mut z = 2u64;",
      "    while 累乗_mod(z, (p - 1) / 2, p) != p - 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = 累乗_mod(z, q, p);",
      "    let mut t = 累乗_mod(a, q, p);",
      "    let mut r = 累乗_mod(a, q.div_ceil(2), p);",
      "    loop {",
      "        if t == 1 {",
      "            return Some(r);",
      "        }",
      "        let mut i = 0u32;",
      "        let mut 暫定 = t;",
      "        while 暫定 != 1 {",
      "            暫定 = 暫定 * 暫定 % p;",
      "            i += 1;",
      "        }",
      "        let b = 累乗_mod(c, 1u64 << (m - i - 1), p);",
      "        m = i;",
      "        c = b * b % p;",
      "        t = t * c % p;",
      "        r = r * b % p;",
      "    }",
      "}"
    ]
  },
  "トポロジカル_順序_数": {
    "scope": "rust",
    "prefix": "トポロジカル_順序_数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// DAG（半順序）の**位相順序（線形拡大）の総数**を `法` で数える。頂点数 `N ≤ 20` 程度向けの",
      "/// 部分集合 DP。`O(2^N · N)`。",
      "/// `辺` は有向辺 `(u, v)`（`u → v`、`u` が `v` より前）。閉路があれば 0。",
      "/// 半順序集合の線形拡大数（ソートの仕方の数）を求めるのに使う。",
      "#[allow(clippy::needless_range_loop)]",
      "fn 位相順序数(頂点数: usize, 辺: &[(usize, usize)], 法: u64) -> u64 {",
      "    let n = 頂点数;",
      "    if n == 0 {",
      "        return 1 % 法;",
      "    }",
      "    assert!(n <= 31, \"頂点数が多すぎる（2^N が大きすぎる）: {n}\");",
      "    let mut 前提 = vec![0u32; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        前提[v] |= 1 << u;",
      "    }",
      "    let 全体 = (1u32 << n) - 1;",
      "    let mut dp = vec![0u64; 1 << n];",
      "    dp[0] = 1 % 法;",
      "    for s in 0..=全体 {",
      "        if dp[s as usize] == 0 {",
      "            continue;",
      "        }",
      "        let cur = dp[s as usize];",
      "        for v in 0..n {",
      "            let bit = 1u32 << v;",
      "            if s & bit == 0 && 前提[v] & s == 前提[v] {",
      "                let ns = (s | bit) as usize;",
      "                dp[ns] = (dp[ns] + cur) % 法;",
      "            }",
      "        }",
      "    }",
      "    dp[全体 as usize]",
      "}"
    ]
  },
  "トライ": {
    "scope": "rust",
    "prefix": "トライ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 英小文字（a–z）用のトライ木。文字列集合への挿入・完全一致検索・",
      "/// 接頭辞を共有する単語数の取得ができる。",
      "/// 各操作の計算量は文字列長に比例。文字種を増やすときは配列幅 26 を変更する。",
      "struct トライ木 {",
      "    /// 各ノードの子（`子[ノード][c]` = 文字 c の子ノード番号）",
      "    子: Vec<[Option<usize>; 26]>,",
      "    /// そのノードを通過する単語数（= そのノードが表す接頭辞を持つ単語数）",
      "    通過数: Vec<usize>,",
      "    /// そのノードで終わる単語数",
      "    終端数: Vec<usize>,",
      "}",
      "impl Default for トライ木 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "impl トライ木 {",
      "    /// 空のトライ木を作る（根ノードのみ）。",
      "    fn new() -> Self {",
      "        Self {",
      "            子: vec![[None; 26]],",
      "            通過数: vec![0],",
      "            終端数: vec![0],",
      "        }",
      "    }",
      "    /// 単語を挿入する。同じ単語の重複挿入も数えられる。",
      "    fn 挿入(&mut self, 単語: &str) {",
      "        let mut 現在 = 0;",
      "        for c in 単語.bytes() {",
      "            let idx = (c - b'a') as usize;",
      "            現在 = match self.子[現在][idx] {",
      "                Some(次) => 次,",
      "                None => {",
      "                    let 新 = self.子.len();",
      "                    self.子.push([None; 26]);",
      "                    self.通過数.push(0);",
      "                    self.終端数.push(0);",
      "                    self.子[現在][idx] = Some(新);",
      "                    新",
      "                }",
      "            };",
      "            self.通過数[現在] += 1;",
      "        }",
      "        self.終端数[現在] += 1;",
      "    }",
      "    /// `単語` がちょうど登録されているか（完全一致）。",
      "    fn 含む(&self, 単語: &str) -> bool {",
      "        matches ! (self . 末尾ノード (単語 ) , Some (n ) if self . 終端数 [n ] > 0 )",
      "    }",
      "    /// `接頭辞` を接頭辞に持つ登録単語の個数（空文字列を渡したときは 0）。",
      "    fn 接頭辞数(&self, 接頭辞: &str) -> usize {",
      "        match self.末尾ノード(接頭辞) {",
      "            Some(n) if n != 0 => self.通過数[n],",
      "            _ => 0,",
      "        }",
      "    }",
      "    /// 文字列 `s` を根からたどった末尾ノード番号。途中で枝が無ければ `None`。",
      "    fn 末尾ノード(&self, s: &str) -> Option<usize> {",
      "        let mut 現在 = 0;",
      "        for c in s.bytes() {",
      "            let idx = (c - b'a') as usize;",
      "            現在 = self.子[現在][idx]?;",
      "        }",
      "        Some(現在)",
      "    }",
      "}"
    ]
  },
  "トライ_木": {
    "scope": "rust",
    "prefix": "トライ_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 英小文字（a–z）用のトライ木。文字列集合への挿入・完全一致検索・",
      "/// 接頭辞を共有する単語数の取得ができる。",
      "/// 各操作の計算量は文字列長に比例。文字種を増やすときは配列幅 26 を変更する。",
      "struct トライ木 {",
      "    /// 各ノードの子（`子[ノード][c]` = 文字 c の子ノード番号）",
      "    子: Vec<[Option<usize>; 26]>,",
      "    /// そのノードを通過する単語数（= そのノードが表す接頭辞を持つ単語数）",
      "    通過数: Vec<usize>,",
      "    /// そのノードで終わる単語数",
      "    終端数: Vec<usize>,",
      "}",
      "impl Default for トライ木 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "impl トライ木 {",
      "    /// 空のトライ木を作る（根ノードのみ）。",
      "    fn new() -> Self {",
      "        Self {",
      "            子: vec![[None; 26]],",
      "            通過数: vec![0],",
      "            終端数: vec![0],",
      "        }",
      "    }",
      "    /// 単語を挿入する。同じ単語の重複挿入も数えられる。",
      "    fn 挿入(&mut self, 単語: &str) {",
      "        let mut 現在 = 0;",
      "        for c in 単語.bytes() {",
      "            let idx = (c - b'a') as usize;",
      "            現在 = match self.子[現在][idx] {",
      "                Some(次) => 次,",
      "                None => {",
      "                    let 新 = self.子.len();",
      "                    self.子.push([None; 26]);",
      "                    self.通過数.push(0);",
      "                    self.終端数.push(0);",
      "                    self.子[現在][idx] = Some(新);",
      "                    新",
      "                }",
      "            };",
      "            self.通過数[現在] += 1;",
      "        }",
      "        self.終端数[現在] += 1;",
      "    }",
      "    /// `単語` がちょうど登録されているか（完全一致）。",
      "    fn 含む(&self, 単語: &str) -> bool {",
      "        matches ! (self . 末尾ノード (単語 ) , Some (n ) if self . 終端数 [n ] > 0 )",
      "    }",
      "    /// `接頭辞` を接頭辞に持つ登録単語の個数（空文字列を渡したときは 0）。",
      "    fn 接頭辞数(&self, 接頭辞: &str) -> usize {",
      "        match self.末尾ノード(接頭辞) {",
      "            Some(n) if n != 0 => self.通過数[n],",
      "            _ => 0,",
      "        }",
      "    }",
      "    /// 文字列 `s` を根からたどった末尾ノード番号。途中で枝が無ければ `None`。",
      "    fn 末尾ノード(&self, s: &str) -> Option<usize> {",
      "        let mut 現在 = 0;",
      "        for c in s.bytes() {",
      "            let idx = (c - b'a') as usize;",
      "            現在 = self.子[現在][idx]?;",
      "        }",
      "        Some(現在)",
      "    }",
      "}"
    ]
  },
  "トライ_法_オートマトン": {
    "scope": "rust",
    "prefix": "トライ_法_オートマトン",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::{HashMap, VecDeque};",
      "/// Aho-Corasick 法による複数パターン同時照合。バイト列（`&[u8]`）を対象とする。",
      "/// トライ + fail リンクを構築し、テキストを 1 度走査して各パターンの**出現回数**を",
      "/// まとめて数える。重なる出現も全て数える。",
      "struct エイホコラシック {",
      "    遷移: Vec<HashMap<u8, usize>>,",
      "    fail: Vec<usize>,",
      "    bfs順: Vec<usize>,",
      "    パターン終端: Vec<usize>,",
      "}",
      "impl エイホコラシック {",
      "    /// パターン群から構築する。O(Σパターン長)。空パターンは終端＝根として扱う。",
      "    fn new(パターン群: &[&[u8]]) -> Self {",
      "        let mut 遷移: Vec<HashMap<u8, usize>> = vec![HashMap::new()];",
      "        let mut パターン終端 = vec![0usize; パターン群.len()];",
      "        for (pi, pat) in パターン群.iter().enumerate() {",
      "            let mut cur = 0usize;",
      "            for &c in *pat {",
      "                if let Some(&nx) = 遷移[cur].get(&c) {",
      "                    cur = nx;",
      "                } else {",
      "                    let 新 = 遷移.len();",
      "                    遷移.push(HashMap::new());",
      "                    遷移[cur].insert(c, 新);",
      "                    cur = 新;",
      "                }",
      "            }",
      "            パターン終端[pi] = cur;",
      "        }",
      "        let mut fail = vec![0usize; 遷移.len()];",
      "        let mut bfs順 = Vec::new();",
      "        let mut 探索 = VecDeque::new();",
      "        let 直下: Vec<usize> = 遷移[0].values().copied().collect();",
      "        for next in 直下 {",
      "            fail[next] = 0;",
      "            bfs順.push(next);",
      "            探索.push_back(next);",
      "        }",
      "        while let Some(now) = 探索.pop_front() {",
      "            let 子: Vec<(u8, usize)> = 遷移[now].iter().map(|(&c, &next)| (c, next)).collect();",
      "            for (c, next) in 子 {",
      "                let mut f = fail[now];",
      "                let nf = loop {",
      "                    if let Some(&nx) = 遷移[f].get(&c) {",
      "                        break nx;",
      "                    }",
      "                    if f == 0 {",
      "                        break 0;",
      "                    }",
      "                    f = fail[f];",
      "                };",
      "                fail[next] = nf;",
      "                bfs順.push(next);",
      "                探索.push_back(next);",
      "            }",
      "        }",
      "        Self {",
      "            遷移,",
      "            fail,",
      "            bfs順,",
      "            パターン終端,",
      "        }",
      "    }",
      "    /// 文字 `c` での遷移（fail リンクを辿るオートマトン遷移）。",
      "    fn 進む(&self, mut v: usize, c: u8) -> usize {",
      "        loop {",
      "            if let Some(&nx) = self.遷移[v].get(&c) {",
      "                return nx;",
      "            }",
      "            if v == 0 {",
      "                return 0;",
      "            }",
      "            v = self.fail[v];",
      "        }",
      "    }",
      "    /// `テキスト` 中での各パターンの出現回数を、`new` に渡した順で返す。",
      "    /// O(テキスト長 + マッチ数)。",
      "    fn 出現回数(&self, テキスト: &[u8]) -> Vec<usize> {",
      "        let mut 訪問 = vec![0usize; self.遷移.len()];",
      "        let mut v = 0usize;",
      "        for &c in テキスト {",
      "            v = self.進む(v, c);",
      "            訪問[v] += 1;",
      "        }",
      "        for &node in self.bfs順.iter().rev() {",
      "            訪問[self.fail[node]] += 訪問[node];",
      "        }",
      "        self.パターン終端.iter().map(|&node| 訪問[node]).collect()",
      "    }",
      "}"
    ]
  },
  "トロピカル_行列": {
    "scope": "rust",
    "prefix": "トロピカル_行列",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 到達不能・無限大を表す番兵。加算しても溢れないよう十分小さく取る。",
      "const 無限: i64 = 1 << 60;",
      "/// min-plus（トロピカル）半環での正方行列の積 `(A⊗B)[i][j] = min_k (A[i][k] + B[k][j])`。`O(n^3)`。",
      "/// `無限`（≒到達不能）同士の加算でも溢れないよう番兵で頭打ちにする。",
      "#[allow(clippy::needless_range_loop)]",
      "fn ミンプラス積(a: &[Vec<i64>], b: &[Vec<i64>]) -> Vec<Vec<i64>> {",
      "    let n = a.len();",
      "    let mut c = vec![vec![無限; n]; n];",
      "    for i in 0..n {",
      "        for k in 0..n {",
      "            if a[i][k] >= 無限 {",
      "                continue;",
      "            }",
      "            let aik = a[i][k];",
      "            for j in 0..n {",
      "                let v = aik.saturating_add(b[k][j]).min(無限);",
      "                if v < c[i][j] {",
      "                    c[i][j] = v;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    c",
      "}",
      "/// min-plus 行列の `e` 乗を二分累乗で求める。`O(n^3 log e)`。",
      "/// 入力 `行列[i][j]` を「辺 `i→j` の重み（辺が無ければ `無限` 以上）」とみなすと、結果の",
      "/// `[i][j]` は **`i` から `j` へちょうど `e` 本の辺で行く最短歩道**の重み（到達不能なら `≥ 無限`）。",
      "/// `e == 0` は単位元（対角 0・他 `無限`）。重み付き有向グラフで「辺数を固定した最短路」や",
      "/// 「k 手後の最小コスト」を求めるのに使う。",
      "fn ミンプラス累乗(行列: &[Vec<i64>], e: usize) -> Vec<Vec<i64>> {",
      "    let n = 行列.len();",
      "    let mut 結果 = vec![vec![無限; n]; n];",
      "    for (i, row) in 結果.iter_mut().enumerate() {",
      "        row[i] = 0;",
      "    }",
      "    let mut 底: Vec<Vec<i64>> = 行列",
      "        .iter()",
      "        .map(|r| r.iter().map(|&x| x.min(無限)).collect())",
      "        .collect();",
      "    let mut e = e;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            結果 = ミンプラス積(&結果, &底);",
      "        }",
      "        底 = ミンプラス積(&底, &底);",
      "        e >>= 1;",
      "    }",
      "    結果",
      "}"
    ]
  },
  "トーシェント_関数": {
    "scope": "rust",
    "prefix": "トーシェント_関数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// オイラーのφ関数 φ(n)：`1..=n` のうち `n` と互いに素な整数の個数。O(√n)。",
      "/// 多くの `n` について一括で欲しいときは [`オイラーのファイ表`] を使う。",
      "fn オイラーのファイ(mut n: u64) -> u64 {",
      "    let mut 結果 = n;",
      "    let mut p = 2u64;",
      "    while p * p <= n {",
      "        if n % p == 0 {",
      "            while n % p == 0 {",
      "                n /= p;",
      "            }",
      "            結果 -= 結果 / p;",
      "        }",
      "        p += 1;",
      "    }",
      "    if n > 1 {",
      "        結果 -= 結果 / n;",
      "    }",
      "    結果",
      "}",
      "/// `0..=n` の各 `i` について φ(i) を入れた配列を篩で前計算する。O(n log log n)。",
      "/// `表[0] = 0`、`表[1] = 1`。",
      "fn オイラーのファイ表(n: usize) -> Vec<u64> {",
      "    let mut 表: Vec<u64> = (0..=n as u64).collect();",
      "    for i in 2..=n {",
      "        if 表[i] == i as u64 {",
      "            let mut j = i;",
      "            while j <= n {",
      "                表[j] -= 表[j] / i as u64;",
      "                j += i;",
      "            }",
      "        }",
      "    }",
      "    表",
      "}"
    ]
  },
  "トータル_モノトーン": {
    "scope": "rust",
    "prefix": "トータル_モノトーン",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// REDUCE 操作: どの行の最小にもなり得ない列を取り除き、残す列数を行数以下にする内部関数。",
      "fn 列削減<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行: &[usize],",
      "    列: &[usize],",
      "    コスト: &F,",
      ") -> Vec<usize> {",
      "    let mut 残す: Vec<usize> = Vec::new();",
      "    for &c in 列 {",
      "        while let Some(&上) = 残す.last() {",
      "            let k = 残す.len() - 1;",
      "            if k < 行.len() && コスト(行[k], 上) > コスト(行[k], c) {",
      "                残す.pop();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        if 残す.len() < 行.len() {",
      "            残す.push(c);",
      "        }",
      "    }",
      "    残す",
      "}",
      "/// SMAWK 本体（再帰）。偶数位置の行は奇数位置の行の答えで挟み込んで線形に解く。",
      "fn 解く<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行: &[usize],",
      "    列: &[usize],",
      "    コスト: &F,",
      "    答え: &mut [usize],",
      ") {",
      "    if 行.is_empty() {",
      "        return;",
      "    }",
      "    let 列 = 列削減(行, 列, コスト);",
      "    let 奇: Vec<usize> = 行.iter().skip(1).step_by(2).copied().collect();",
      "    解く(&奇, &列, コスト, 答え);",
      "    let mut j = 0;",
      "    let mut pos = 0;",
      "    while pos < 行.len() {",
      "        let r = 行[pos];",
      "        let 終列 = if pos + 1 < 行.len() {",
      "            答え[行[pos + 1]]",
      "        } else {",
      "            *列.last().unwrap()",
      "        };",
      "        let mut 最良 = 列[j];",
      "        while 列[j] != 終列 {",
      "            j += 1;",
      "            if コスト(r, 列[j]) < コスト(r, 最良) {",
      "                最良 = 列[j];",
      "            }",
      "        }",
      "        答え[r] = 最良;",
      "        pos += 2;",
      "    }",
      "}",
      "/// SMAWK 法。完全単調（totally monotone, Monge を含む）な `行数 × 列数` 行列について、",
      "/// 各行の最小値をとる列番号を `O(行数 + 列数)` で求める。`コスト(i, j)` で要素を遅延参照する。",
      "/// 行列が完全単調（任意の `i<i'`, `j<j'` で `A[i][j]>A[i][j']` ⇒ `A[i'][j]>A[i'][j']`）であることが前提。",
      "/// 分割統治の単調最小値（[`divide_and_conquer_dp`](crate::divide_and_conquer_dp)、`O(n log n)`）より",
      "/// 高速。最近点・DP 高速化などで使う。",
      "/// 返り値 `argmin[i]` は行 `i` の最小値をとる列（同点は最左）。`列数 == 0` のときは空でない行に `0` が入る。",
      "/// コストの型は比較できれば何でもよい（i64 / f64 など）。",
      "fn 行ごとの最小列<T: PartialOrd, F: Fn(usize, usize) -> T>(",
      "    行数: usize,",
      "    列数: usize,",
      "    コスト: F,",
      ") -> Vec<usize> {",
      "    let mut 答え = vec![0usize; 行数];",
      "    if 行数 == 0 || 列数 == 0 {",
      "        return 答え;",
      "    }",
      "    let 行: Vec<usize> = (0..行数).collect();",
      "    let 列: Vec<usize> = (0..列数).collect();",
      "    解く(&行, &列, &コスト, &mut 答え);",
      "    答え",
      "}"
    ]
  },
  "ナップサック": {
    "scope": "rust",
    "prefix": "ナップサック",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 0/1 ナップサック問題。容量 `容量` のリュックに、品物 `(重さ, 価値)` を",
      "/// 各 0 個か 1 個選び、重さ合計が容量以下になるときの価値合計の最大値を返す。O(N·容量)。",
      "/// 重さが大きく価値が小さいとき（容量が巨大で価値合計が小さいとき）は",
      "/// [`価値基準ナップサック`] を使うと O(N·Σ価値) で解ける。",
      "fn ナップサック(品物: &[(usize, i64)], 容量: usize) -> i64 {",
      "    let mut dp = vec![0i64; 容量 + 1];",
      "    for &(重さ, 価値) in 品物 {",
      "        for w in (重さ..=容量).rev() {",
      "            dp[w] = dp[w].max(dp[w - 重さ] + 価値);",
      "        }",
      "    }",
      "    dp[容量]",
      "}",
      "/// 個数制限なしナップサック。各品物を何個でも選べる版。O(N·容量)。",
      "fn 個数制限なしナップサック(品物: &[(usize, i64)], 容量: usize) -> i64 {",
      "    let mut dp = vec![0i64; 容量 + 1];",
      "    for &(重さ, 価値) in 品物 {",
      "        for w in 重さ..=容量 {",
      "            dp[w] = dp[w].max(dp[w - 重さ] + 価値);",
      "        }",
      "    }",
      "    dp[容量]",
      "}",
      "/// 価値を添字にする 0/1 ナップサック。容量が大きく（〜10^9）価値合計が小さいとき向け。",
      "/// 「価値合計をちょうど v にする最小の重さ」を全 v について求め、",
      "/// 重さが `容量` 以下で達成できる最大の価値 v を返す。O(N·Σ価値)。",
      "fn 価値基準ナップサック(品物: &[(usize, i64)], 容量: usize) -> i64 {",
      "    let 価値合計: i64 = 品物.iter().map(|&(_, v)| v).sum();",
      "    const INF: usize = !0 / 2;",
      "    let mut dp = vec![INF; 価値合計 as usize + 1];",
      "    dp[0] = 0;",
      "    for &(重さ, 価値) in 品物 {",
      "        for v in (価値..=価値合計).rev() {",
      "            let prev = dp[(v - 価値) as usize];",
      "            if prev != INF {",
      "                let cand = prev + 重さ;",
      "                let cur = &mut dp[v as usize];",
      "                if cand < *cur {",
      "                    *cur = cand;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    (0..=価値合計)",
      "        .rev()",
      "        .find(|&v| dp[v as usize] <= 容量)",
      "        .unwrap_or(0)",
      "}",
      "/// 個数制限付きナップサック。各品物 `(重さ, 価値, 個数)` を `0..=個数` 個まで使い、総重量が `容量`",
      "/// 以下で価値和を最大化する。O(N·容量)。",
      "/// 単調デックを使うので計算量は `個数` に依存しない。各 1 個までなら [`ナップサック`]、",
      "/// 無制限なら [`個数制限なしナップサック`]。",
      "fn 個数制限付きナップサック(品物: &[(usize, i64, usize)], 容量: usize) -> i64 {",
      "    use std::collections::VecDeque;",
      "    let mut dp = vec![0i64; 容量 + 1];",
      "    for &(w, v, c) in 品物 {",
      "        if c == 0 {",
      "            continue;",
      "        }",
      "        if w == 0 {",
      "            if v > 0 {",
      "                let 加算 = v * c as i64;",
      "                for x in dp.iter_mut() {",
      "                    *x += 加算;",
      "                }",
      "            }",
      "            continue;",
      "        }",
      "        let 旧 = dp.clone();",
      "        for r in 0..w {",
      "            if r > 容量 {",
      "                break;",
      "            }",
      "            let mut デック: VecDeque<usize> = VecDeque::new();",
      "            let mut k = 0usize;",
      "            while r + k * w <= 容量 {",
      "                let h = 旧[r + k * w] - (k as i64) * v;",
      "                while let Some(&b) = デック.back() {",
      "                    let hb = 旧[r + b * w] - (b as i64) * v;",
      "                    if hb <= h {",
      "                        デック.pop_back();",
      "                    } else {",
      "                        break;",
      "                    }",
      "                }",
      "                デック.push_back(k);",
      "                while let Some(&前) = デック.front() {",
      "                    if 前 + c < k {",
      "                        デック.pop_front();",
      "                    } else {",
      "                        break;",
      "                    }",
      "                }",
      "                let &先頭 = デック.front().unwrap();",
      "                let 最大h = 旧[r + 先頭 * w] - (先頭 as i64) * v;",
      "                dp[r + k * w] = 最大h + (k as i64) * v;",
      "                k += 1;",
      "            }",
      "        }",
      "    }",
      "    dp[容量]",
      "}"
    ]
  },
  "ナップサック_DP": {
    "scope": "rust",
    "prefix": "ナップサック_DP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 0/1 ナップサック問題。容量 `容量` のリュックに、品物 `(重さ, 価値)` を",
      "/// 各 0 個か 1 個選び、重さ合計が容量以下になるときの価値合計の最大値を返す。O(N·容量)。",
      "/// 重さが大きく価値が小さいとき（容量が巨大で価値合計が小さいとき）は",
      "/// [`価値基準ナップサック`] を使うと O(N·Σ価値) で解ける。",
      "fn ナップサック(品物: &[(usize, i64)], 容量: usize) -> i64 {",
      "    let mut dp = vec![0i64; 容量 + 1];",
      "    for &(重さ, 価値) in 品物 {",
      "        for w in (重さ..=容量).rev() {",
      "            dp[w] = dp[w].max(dp[w - 重さ] + 価値);",
      "        }",
      "    }",
      "    dp[容量]",
      "}"
    ]
  },
