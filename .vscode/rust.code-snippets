      "impl 半平面 {",
      "    fn cross(a: (f64, f64), b: (f64, f64)) -> f64 {",
      "        a.0 * b.1 - a.1 * b.0",
      "    }",
      "    fn dot(a: (f64, f64), b: (f64, f64)) -> f64 {",
      "        a.0 * b.0 + a.1 * b.1",
      "    }",
