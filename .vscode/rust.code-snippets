  "ラグランジュ_補間": {
    "scope": "rust",
    "prefix": "ラグランジュ_補間",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 素数 `法` を法とする `a` の逆元（フェルマーの小定理 `a^(法-2)`）。`O(log 法)`。",
      "/// `法` が素数で `a % 法 != 0` であることが前提。合成数を法とする場合や `a` が",
      "/// `法` の倍数の場合は正しい値を返さない（拡張ユークリッドを使うこと）。",
      "fn 逆元(a: u64, 法: u64) -> u64 {",
      "    累乗_mod(a, 法 - 2, 法)",
      "}",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 相異なる点 `(xs[i], ys[i])` を通る次数 `< n` の多項式を素数 `法` 上で求め、`t` での値を返す。O(n^2)。",
      "/// `法` は素数で、`xs` は互いに異なること。点が等間隔（0,1,2,...）なら [`連続点補間`] が O(n) で速い。",
      "fn ラグランジュ補間(",
      "    xs: &[impl TryInto<u64> + Copy],",
      "    ys: &[impl TryInto<u64> + Copy],",
      "    t: impl TryInto<u64>,",
      "    法: impl TryInto<u64>,",
      ") -> usize {",
      "    let xs: Vec<u64> = xs",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"ラグランジュ補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let ys: Vec<u64> = ys",
      "        .iter()",
      "        .map(|&y| {",
      "            y.try_into()",
      "                .ok()",
      "                .expect(\"ラグランジュ補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let t: u64 = t",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ラグランジュ補間: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ラグランジュ補間: 引数が u64 に収まりません\");",
      "    let n = xs.len();",
      "    let t = t % 法;",
      "    let mut 結果 = 0u64;",
      "    for i in 0..n {",
      "        let mut 分子 = 1u64;",
      "        let mut 分母 = 1u64;",
      "        for j in 0..n {",
      "            if i != j {",
      "                分子 = 分子 * ((t + 法 - xs[j] % 法) % 法) % 法;",
      "                分母 = 分母 * ((xs[i] % 法 + 法 - xs[j] % 法) % 法) % 法;",
      "            }",
      "        }",
      "        結果 = (結果 + ys[i] % 法 * 分子 % 法 * 逆元(分母, 法)) % 法;",
      "    }",
      "    結果 as usize",
      "}",
      "/// `ys[i] = f(i)`（`i = 0..n`）から次数 `< n` の多項式 `f` を定め、`f(t)` を素数 `法` 上で O(n) で返す。",
      "/// `Σ i^k` のような多項式和の閉じた式を点から外挿する用途で頻出。",
      "/// `t` が `0..n` の範囲なら `ys[t]` をそのまま返す。",
      "fn 連続点補間(",
      "    ys: &[impl TryInto<u64> + Copy],",
      "    t: impl TryInto<u64>,",
      "    法: impl TryInto<u64>,",
      ") -> usize {",
      "    let ys: Vec<u64> = ys",
      "        .iter()",
      "        .map(|&y| {",
      "            y.try_into()",
      "                .ok()",
      "                .expect(\"連続点補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let t: u64 = t",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連続点補間: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連続点補間: 引数が u64 に収まりません\");",
      "    let n = ys.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    if t < n as u64 {",
      "        return (ys[t as usize] % 法) as usize;",
      "    }",
      "    let d = n - 1;",
      "    let tm = t % 法;",
      "    let mut 階乗 = vec![1u64; n];",
      "    for i in 1..n {",
      "        階乗[i] = 階乗[i - 1] * i as u64 % 法;",
      "    }",
      "    let mut 前 = vec![1u64; n + 1];",
      "    for i in 0..n {",
      "        前[i + 1] = 前[i] * ((tm + 法 - i as u64 % 法) % 法) % 法;",
      "    }",
      "    let mut 後 = vec![1u64; n + 1];",
      "    for i in (0..n).rev() {",
      "        後[i] = 後[i + 1] * ((tm + 法 - i as u64 % 法) % 法) % 法;",
      "    }",
      "    let mut 結果 = 0u64;",
      "    for i in 0..n {",
      "        let 分子 = 前[i] * 後[i + 1] % 法;",
      "        let 分母 = 階乗[i] * 階乗[d - i] % 法;",
      "        let mut 項 = ys[i] % 法 * 分子 % 法 * 逆元(分母, 法) % 法;",
      "        if (d - i) % 2 == 1 {",
      "            項 = (法 - 項) % 法;",
      "        }",
      "        結果 = (結果 + 項) % 法;",
      "    }",
      "    結果 as usize",
      "}"
    ]
  },
  "ランク付き_ゼータ": {
    "scope": "rust",
    "prefix": "ランク付き_ゼータ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 下位集合方向のゼータ変換（SOS）。`f[S]` を `Σ_{T ⊆ S} f[T]` へ in-place 変換する。`O(n · 2^n)`。",
      "/// 部分集合畳み込み内部で各ランク層に適用する補助関数。",
      "fn 部分集合ゼータ<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let m = f.len();",
      "    let mut bit = 1;",
      "    while bit < m {",
      "        for s in 0..m {",
      "            if s & bit != 0 {",
      "                f[s] += f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}",
      "/// [`部分集合ゼータ`] の逆（メビウス）。`Σ_{T ⊆ S} f[T]` から `f` を復元する。`O(n · 2^n)`。",
      "fn 部分集合メビウス<T: Copy + std::ops::SubAssign>(f: &mut [T]) {",
      "    let m = f.len();",
      "    let mut bit = 1;",
      "    while bit < m {",
      "        for s in 0..m {",
      "            if s & bit != 0 {",
      "                f[s] -= f[s ^ bit];",
      "            }",
      "        }",
      "        bit <<= 1;",
      "    }",
      "}",
      "/// 部分集合畳み込み（subset sum convolution）。`h[S] = Σ_{T ⊆ S} f[T]·g[S∖T]` を",
      "/// `O(n^2 · 2^n)` で求める（`n` はビット数、配列長は `2^n`）。`T` と `S∖T` が**素**（重なり無し）な",
      "/// 分割だけを足し合わせる点が、単なる下位集合ゼータ（[`zeta_mobius`](crate::zeta_mobius)）の積とは異なる。",
      "/// 連結部分グラフ数え上げ・集合被覆 DP・独立集合の合成などに使う。",
      "/// 要素型は加減乗できれば何でもよい（i64 / f64 / ModInt など）。i64 は乗算の重なりで",
      "/// オーバーフローし得るので、MOD 付き数え上げでは ModInt をそのまま渡す。",
      "fn 部分集合畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::SubAssign + std::ops::Mul<Output = T>,",
      "{",
      "    let m = f.len();",
      "    assert_eq!(m, g.len(), \"f と g は同じ長さ\");",
      "    assert!(m.is_power_of_two(), \"長さは 2 のべき乗\");",
      "    let n = m.trailing_zeros() as usize;",
      "    let mut fh = vec![vec![T::default(); m]; n + 1];",
      "    let mut gh = vec![vec![T::default(); m]; n + 1];",
      "    for (s, (&fv, &gv)) in f.iter().zip(g).enumerate() {",
      "        let k = (s as u32).count_ones() as usize;",
      "        fh[k][s] = fv;",
      "        gh[k][s] = gv;",
      "    }",
      "    for k in 0..=n {",
      "        部分集合ゼータ(&mut fh[k]);",
      "        部分集合ゼータ(&mut gh[k]);",
      "    }",
      "    let mut hh = vec![vec![T::default(); m]; n + 1];",
      "    for i in 0..=n {",
      "        for j in 0..=(n - i) {",
      "            for s in 0..m {",
      "                hh[i + j][s] += fh[i][s] * gh[j][s];",
      "            }",
      "        }",
      "    }",
      "    for 層 in hh.iter_mut() {",
      "        部分集合メビウス(層);",
      "    }",
      "    let mut h = vec![T::default(); m];",
      "    for (s, hs) in h.iter_mut().enumerate() {",
      "        let k = (s as u32).count_ones() as usize;",
      "        *hs = hh[k][s];",
      "    }",
      "    h",
      "}"
    ]
  },
  "リュカの_定理": {
    "scope": "rust",
    "prefix": "リュカの_定理",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// Lucas の定理による二項係数 `C(n, k) mod p`（`p` は素数）。`n`, `k` は最大 ~10^18 まで扱える。",
      "/// `n`/`k` を p 進展開して桁ごとに掛け合わせるので、`n` が巨大でも `O(log_p n)`。",
      "/// `0..p` の階乗を前計算するので `p` が小さめの素数のとき向き",
      "/// （`p` が 10^9+7 級で `n <= max_n` に収まるなら [`crate::comb`]）。",
      "struct リュカ {",
      "    p: u64,",
      "    階乗: Vec<u64>,",
      "    逆階乗: Vec<u64>,",
      "}",
      "impl リュカ {",
      "    /// 素数 `p` を法とする計算器を作る。`0..p` の階乗・逆階乗を前計算する（O(p)）。",
      "    fn new(p: impl TryInto<u64>) -> Self {",
      "        let p: u64 = p.try_into().ok().expect(\"リュカ: p が u64 に収まりません\");",
      "        assert!(p >= 2, \"p must be a prime >= 2\");",
      "        let mut 階乗 = vec![1u64; p as usize];",
      "        for i in 1..p as usize {",
      "            階乗[i] = 階乗[i - 1] * i as u64 % p;",
      "        }",
      "        let mut 逆階乗 = vec![1u64; p as usize];",
      "        逆階乗[p as usize - 1] = 累乗_mod(階乗[p as usize - 1], p - 2, p);",
      "        for i in (1..p as usize).rev() {",
      "            逆階乗[i - 1] = 逆階乗[i] * i as u64 % p;",
      "        }",
      "        Self {",
      "            p, 階乗, 逆階乗",
      "        }",
      "    }",
      "    /// `0 <= a, b < p` での `C(a, b) mod p`。",
      "    fn 小二項係数(&self, a: u64, b: u64) -> u64 {",
      "        if b > a {",
      "            return 0;",
      "        }",
      "        let a = a as usize;",
      "        let b = b as usize;",
      "        self.階乗[a] * self.逆階乗[b] % self.p * self.逆階乗[a - b] % self.p",
      "    }",
      "    /// `C(n, k) mod p`。`n`, `k` を p 進展開し、各桁の二項係数の積を取る。",
      "    /// 引数は任意の整数型でよい（負の値は 0 を返す）。",
      "    fn 二項係数(&self, n: impl TryInto<i128>, k: impl TryInto<i128>) -> u64 {",
      "        let n: i128 = n.try_into().ok().expect(\"リュカ: n が i128 に収まりません\");",
      "        let k: i128 = k.try_into().ok().expect(\"リュカ: k が i128 に収まりません\");",
      "        if n < 0 || k < 0 {",
      "            return 0;",
      "        }",
      "        let mut n = u64::try_from(n).expect(\"リュカ: n が u64 を超えています\");",
      "        let mut k = u64::try_from(k).expect(\"リュカ: k が u64 を超えています\");",
      "        let mut 結果 = 1u64;",
      "        while n > 0 || k > 0 {",
      "            let ni = n % self.p;",
      "            let ki = k % self.p;",
      "            if ki > ni {",
      "                return 0;",
      "            }",
      "            結果 = 結果 * self.小二項係数(ni, ki) % self.p;",
      "            n /= self.p;",
      "            k /= self.p;",
      "        }",
      "        結果",
      "    }",
      "}"
    ]
  },
  "リンク_カット_木": {
    "scope": "rust",
    "prefix": "リンク_カット_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Link-Cut Tree。森に対する辺の追加・削除（[`Self::辺を張る`] / [`Self::辺を切る`]）、",
      "/// 連結判定、2 頂点間パスの頂点値の総和を、すべてならし O(log N) で処理する。",
      "/// 頂点番号は 0-indexed。",
      "/// - [`Self::辺を張る`] : 別の木に属する 2 頂点を結ぶ（同一木の頂点に呼んではならない）。",
      "/// - [`Self::辺を切る`] : 既存の辺を取り除く（隣接していない 2 頂点に呼んではならない）。",
      "/// - [`Self::連結`] : 2 頂点が同じ木か。",
      "/// - [`Self::パス和`] : 2 頂点間パス上の頂点値の総和。",
      "/// - [`Self::値設定`] : 1 頂点の値を更新。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "struct リンクカット木<T> {",
      "    親: Vec<usize>,",
      "    子: Vec<[usize; 2]>,",
      "    値: Vec<T>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "}",
      "impl<T> リンクカット木<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    /// 各頂点の初期値から構築する。",
      "    fn new(初期値: &[T]) -> Self {",
      "        let n = 初期値.len();",
      "        let mut s = Self {",
      "            親: vec![0; n + 1],",
      "            子: vec![[0, 0]; n + 1],",
      "            値: vec![T::default(); n + 1],",
      "            和: vec![T::default(); n + 1],",
      "            反転: vec![false; n + 1],",
      "        };",
      "        for (i, &v) in 初期値.iter().enumerate() {",
      "            s.値[i + 1] = v;",
      "            s.和[i + 1] = v;",
      "        }",
      "        s",
      "    }",
      "    /// `x` がスプレー木の根（パス親へのリンクしか持たない）か。",
      "    fn is_root(&self, x: usize) -> bool {",
      "        let p = self.親[x];",
      "        p == 0 || (self.子[p][0] != x && self.子[p][1] != x)",
      "    }",
      "    fn 更新(&mut self, x: usize) {",
      "        if x == 0 {",
      "            return;",
      "        }",
      "        self.和[x] = self.和[self.子[x][0]] + self.値[x] + self.和[self.子[x][1]];",
      "    }",
      "    fn 伝播(&mut self, x: usize) {",
      "        if x != 0 && self.反転[x] {",
      "            let l = self.子[x][0];",
      "            let r = self.子[x][1];",
      "            self.子[x][0] = r;",
      "            self.子[x][1] = l;",
      "            if l != 0 {",
      "                self.反転[l] ^= true;",
      "            }",
      "            if r != 0 {",
      "                self.反転[r] ^= true;",
      "            }",
      "            self.反転[x] = false;",
      "        }",
      "    }",
      "    fn 回転(&mut self, x: usize) {",
      "        let p = self.親[x];",
      "        let g = self.親[p];",
      "        let pがルート = self.is_root(p);",
      "        let d = if self.子[p][1] == x { 1 } else { 0 };",
      "        let b = self.子[x][d ^ 1];",
      "        self.子[p][d] = b;",
      "        if b != 0 {",
      "            self.親[b] = p;",
      "        }",
      "        self.子[x][d ^ 1] = p;",
      "        self.親[p] = x;",
      "        self.親[x] = g;",
      "        if !pがルート {",
      "            if self.子[g][0] == p {",
      "                self.子[g][0] = x;",
      "            } else if self.子[g][1] == p {",
      "                self.子[g][1] = x;",
      "            }",
      "        }",
      "        self.更新(p);",
      "        self.更新(x);",
      "    }",
      "    fn splay(&mut self, x: usize) {",
      "        let mut スタック = vec![x];",
      "        let mut y = x;",
      "        while !self.is_root(y) {",
      "            y = self.親[y];",
      "            スタック.push(y);",
      "        }",
      "        while let Some(v) = スタック.pop() {",
      "            self.伝播(v);",
      "        }",
      "        while !self.is_root(x) {",
      "            let p = self.親[x];",
      "            if self.is_root(p) {",
      "                self.回転(x);",
      "            } else {",
      "                let g = self.親[p];",
      "                let 同方向 = (self.子[g][1] == p) == (self.子[p][1] == x);",
      "                if 同方向 {",
      "                    self.回転(p);",
      "                } else {",
      "                    self.回転(x);",
      "                }",
      "                self.回転(x);",
      "            }",
      "        }",
      "    }",
      "    fn access(&mut self, x: usize) -> usize {",
      "        let mut last = 0;",
      "        let mut cur = x;",
      "        while cur != 0 {",
      "            self.splay(cur);",
      "            self.子[cur][1] = last;",
      "            self.更新(cur);",
      "            last = cur;",
      "            cur = self.親[cur];",
      "        }",
      "        self.splay(x);",
      "        last",
      "    }",
      "    fn make_root(&mut self, x: usize) {",
      "        self.access(x);",
      "        self.反転[x] ^= true;",
      "        self.伝播(x);",
      "    }",
      "    fn find_root(&mut self, x: usize) -> usize {",
      "        self.access(x);",
      "        let mut r = x;",
      "        self.伝播(r);",
      "        while self.子[r][0] != 0 {",
      "            r = self.子[r][0];",
      "            self.伝播(r);",
      "        }",
      "        self.splay(r);",
      "        r",
      "    }",
      "    /// 別の木に属する頂点 `u`・`v` を結ぶ辺を張る。同じ木の 2 頂点に呼んではならない。",
      "    fn 辺を張る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.親[a] = b;",
      "    }",
      "    /// 既存の辺 `u - v` を取り除く。隣接していない 2 頂点に呼んではならない。",
      "    fn 辺を切る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.子[b][0] = 0;",
      "        self.親[a] = 0;",
      "        self.更新(b);",
      "    }",
      "    /// 頂点 `u`・`v` が同じ木に属するか。",
      "    fn 連結(&mut self, u: usize, v: usize) -> bool {",
      "        if u == v {",
      "            return true;",
      "        }",
      "        self.find_root(u + 1) == self.find_root(v + 1)",
      "    }",
      "    /// 任意頂点 `u` をその木の根にする。",
      "    fn 根を変更(&mut self, u: usize) {",
      "        self.make_root(u + 1);",
      "    }",
      "    /// 頂点 `u`・`v` 間のパス上にある頂点値の総和。同じ木に属することが前提。",
      "    fn パス和(&mut self, u: usize, v: usize) -> T {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.和[b]",
      "    }",
      "    /// 頂点 `u` の値を `新値` に設定する。",
      "    fn 値設定(&mut self, u: usize, 新値: T) {",
      "        let a = u + 1;",
      "        self.access(a);",
      "        self.値[a] = 新値;",
      "        self.更新(a);",
      "    }",
      "    /// 頂点 `u` の現在の値。",
      "    fn 頂点値(&self, u: usize) -> T {",
      "        self.値[u + 1]",
      "    }",
      "}"
    ]
  },
  "リンドン_分解": {
    "scope": "rust",
    "prefix": "リンドン_分解",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// リンドン分解（Duval のアルゴリズム）。列 `s` を、辞書順で非増加に並ぶリンドン語",
      "/// `w1 >= w2 >= ... >= wk` の連結に一意分解し、各因子の半開区間 `[開始, 終了)` を `O(n)` で返す。",
      "/// リンドン語とは「自身が、その全ての真の接尾辞より辞書順で真に小さい」空でない列。最小回転や",
      "/// suffix array の補助、文字列周期性の解析に使う。比較できる任意の要素列に使える。",
      "fn リンドン分解<T: Ord>(s: &[T]) -> Vec<(usize, usize)> {",
      "    let n = s.len();",
      "    let mut 結果 = Vec::new();",
      "    let mut i = 0;",
      "    while i < n {",
      "        let mut j = i + 1;",
      "        let mut k = i;",
      "        while j < n && s[k] <= s[j] {",
      "            if s[k] < s[j] {",
      "                k = i;",
      "            } else {",
      "                k += 1;",
      "            }",
      "            j += 1;",
      "        }",
      "        while i <= k {",
      "            結果.push((i, i + (j - k)));",
      "            i += j - k;",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "レンズ_面積": {
    "scope": "rust",
    "prefix": "レンズ_面積",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円（中心 `c1` 半径 `r1`、中心 `c2` 半径 `r2`）が重なる部分の面積を返す。`O(1)`。",
      "/// 離れていれば `0`、一方が他方を含めば小さい円の面積。",
      "/// [`円と円の交点`](crate::circle_intersection::円と円の交点) は交点座標で、こちらは面積。",
      "fn 二円の交差面積(c1: 点, r1: f64, c2: 点, r2: f64) -> f64 {",
      "    let d = (c1.0 - c2.0).hypot(c1.1 - c2.1);",
      "    if d >= r1 + r2 {",
      "        return 0.0;",
      "    }",
      "    if d <= (r1 - r2).abs() {",
      "        let r = r1.min(r2);",
      "        return std::f64::consts::PI * r * r;",
      "    }",
      "    let a1 = ((d * d + r1 * r1 - r2 * r2) / (2.0 * d * r1))",
      "        .clamp(-1.0, 1.0)",
      "        .acos();",
      "    let a2 = ((d * d + r2 * r2 - r1 * r1) / (2.0 * d * r2))",
      "        .clamp(-1.0, 1.0)",
      "        .acos();",
      "    let 三角 = 0.5",
      "        * ((-d + r1 + r2) * (d + r1 - r2) * (d - r1 + r2) * (d + r1 + r2))",
      "            .max(0.0)",
      "            .sqrt();",
      "    r1 * r1 * a1 + r2 * r2 * a2 - 三角",
      "}"
    ]
  },
  "レーベンシュタイン": {
    "scope": "rust",
