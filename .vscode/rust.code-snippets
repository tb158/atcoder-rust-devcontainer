      "            (q.1 - py) as i128",
      "        };",
      "        let q側が左 = if axis == 0 { q.0 <= px } else { q.1 <= py };",
      "        let (近l, 近r, 遠l, 遠r) = if q側が左 {",
      "            (l, m, m + 1, r)",
      "        } else {",
      "            (m + 1, r, l, m)",
      "        };",
      "        self.近傍探索(近l, 近r, 1 - axis, q, 最良);",
      "        if 面 * 面 < 最良.0 {",
      "            self.近傍探索(遠l, 遠r, 1 - axis, q, 最良);",
      "        }",
      "    }",
      "    #[allow(clippy::too_many_arguments)]",
      "    fn 範囲計数(",
      "        &self,",
      "        l: usize,",
      "        r: usize,",
      "        axis: usize,",
      "        x1: i64,",
      "        y1: i64,",
      "        x2: i64,",
      "        y2: i64,",
      "    ) -> usize {",
      "        if l >= r {",
      "            return 0;",
      "        }",
      "        let m = l + (r - l) / 2;",
      "        let (px, py, _) = self.点[m];",
      "        let mut c = usize::from(x1 <= px && px <= x2 && y1 <= py && py <= y2);",
      "        let (下, 上) = if axis == 0 {",
      "            (x1 <= px, px <= x2)",
      "        } else {",
      "            (y1 <= py, py <= y2)",
      "        };",
      "        if 下 {",
      "            c += self.範囲計数(l, m, 1 - axis, x1, y1, x2, y2);",
      "        }",
      "        if 上 {",
      "            c += self.範囲計数(m + 1, r, 1 - axis, x1, y1, x2, y2);",
      "        }",
      "        c",
      "    }",
      "}"
    ]
  },
  "KMP": {
    "scope": "rust",
    "prefix": "KMP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 接頭辞関数（KMP の failure 配列）。`pi[i]` は `s[0..=i]` の真の接頭辞かつ接尾辞となる",
      "/// 最長文字列（ボーダー）の長さ。O(n)。`s` の要素は `PartialEq` であればよい。",
      "/// ボーダー・周期性の解析や [`kmp検索`] の前処理に使う。`ac_library::z_algorithm` は Z 配列を",
      "/// 返す別アルゴリズムで、用途（周期・ボーダーの直接取得）が異なる。",
      "fn 接頭辞関数<T: PartialEq>(s: &[T]) -> Vec<usize> {",
      "    let n = s.len();",
      "    let mut pi = vec![0usize; n];",
      "    for i in 1..n {",
      "        let mut j = pi[i - 1];",
      "        while j > 0 && s[i] != s[j] {",
      "            j = pi[j - 1];",
      "        }",
      "        if s[i] == s[j] {",
      "            j += 1;",
      "        }",
      "        pi[i] = j;",
      "    }",
      "    pi",
      "}",
      "/// `テキスト` 中に `パターン` が出現する開始位置（0-indexed）を全て昇順で返す。O(n + m)。",
      "/// 重なり合う出現も全て列挙する。空パターンは「マッチなし」として空の `Vec` を返す。",
      "fn kmp検索<T: PartialEq>(テキスト: &[T], パターン: &[T]) -> Vec<usize> {",
      "    let m = パターン.len();",
      "    let mut 結果 = Vec::new();",
      "    if m == 0 {",
      "        return 結果;",
      "    }",
      "    let pi = 接頭辞関数(パターン);",
      "    let mut j = 0usize;",
      "    for (i, c) in テキスト.iter().enumerate() {",
      "        while j > 0 && *c != パターン[j] {",
      "            j = pi[j - 1];",
      "        }",
      "        if *c == パターン[j] {",
      "            j += 1;",
      "        }",
      "        if j == m {",
      "            結果.push(i + 1 - m);",
      "            j = pi[j - 1];",
      "        }",
      "    }",
      "    結果",
      "}",
      "/// `s` の最小周期長。`s` は長さ `周期` のブロックの繰り返しの接頭辞になる",
      "/// （`s[i] == s[i + 周期]` が全ての有効な `i` で成り立つ最小の `周期`）。空列なら 0。",
      "/// 例: `\"aabaab\"` → 3、`\"aabaa\"` → 3、`\"abcabc\"` → 3、`\"abcd\"` → 4。",
      "/// `s.len() % 周期 == 0` のときだけ `s` はそのブロックの「ちょうど整数回」の繰り返し。",
      "fn 最小周期<T: PartialEq>(s: &[T]) -> usize {",
      "    let n = s.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let pi = 接頭辞関数(s);",
      "    n - pi[n - 1]",
      "}"
    ]
  },
