  "位数": {
    "scope": "rust",
    "prefix": "位数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// `n` の相異なる素因数を昇順で返す（試し割り）。`n` の最大素因数が ~10^7 程度までなら高速。",
      "fn 素因数集合(mut n: u64) -> Vec<u64> {",
      "    let mut v = Vec::new();",
      "    let mut d = 2u64;",
      "    while d * d <= n {",
      "        if n % d == 0 {",
      "            v.push(d);",
      "            while n % d == 0 {",
      "                n /= d;",
      "            }",
      "        }",
      "        d += 1;",
      "    }",
      "    if n > 1 {",
      "        v.push(n);",
      "    }",
      "    v",
      "}",
      "/// 素数 `p` の最小の原始根を返す。`p == 2` なら 1。",
      "/// 原始根 `g` は位数が `p-1`、すなわち `g^1, g^2, ..., g^{p-1}` が `1..p` を一巡する数。NTT の回転因子や",
      "/// 離散対数の底に使う。",
      "/// `p` は素数であること（`p-1` の素因数分解に試し割りを使うので `p-1` の最大素因数が大きすぎないこと）。",
      "fn 原始根(p: impl TryInto<u64>) -> usize {",
      "    let p: u64 = p",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"原始根: 引数が u64 に収まりません\");",
      "    if p == 2 {",
      "        return 1;",
      "    }",
      "    let 素因数 = 素因数集合(p - 1);",
      "    let mut g = 2u64;",
      "    loop {",
      "        if 素因数.iter().all(|&q| 累乗_mod(g, (p - 1) / q, p) != 1) {",
      "            return g as usize;",
      "        }",
      "        g += 1;",
      "    }",
      "}",
      "/// 素数 `p` を法とする `a`（`a % p != 0`）の乗法的位数（`a^k ≡ 1 mod p` となる最小の正の `k`）。",
      "/// 位数は `p-1` の約数。`p` は素数であること。",
      "fn 位数(a: impl TryInto<u64>, p: impl TryInto<u64>) -> usize {",
      "    let a: u64 = a.try_into().ok().expect(\"位数: 引数が u64 に収まりません\");",
      "    let p: u64 = p.try_into().ok().expect(\"位数: 引数が u64 に収まりません\");",
      "    assert!(a % p != 0, \"a must not be a multiple of p\");",
      "    let mut k = p - 1;",
      "    for q in 素因数集合(p - 1) {",
      "        while k % q == 0 && 累乗_mod(a, k / q, p) == 1 {",
      "            k /= q;",
      "        }",
      "    }",
      "    k as usize",
      "}"
    ]
  },
  "位相_順序_数え上げ": {
    "scope": "rust",
    "prefix": "位相_順序_数え上げ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// DAG（半順序）の**位相順序（線形拡大）の総数**を `法` で数える。頂点数 `N ≤ 20` 程度向けの",
      "/// 部分集合 DP。`O(2^N · N)`。",
      "/// `辺` は有向辺 `(u, v)`（`u → v`、`u` が `v` より前）。閉路があれば 0。",
      "/// 半順序集合の線形拡大数（ソートの仕方の数）を求めるのに使う。",
      "#[allow(clippy::needless_range_loop)]",
      "fn 位相順序数(頂点数: usize, 辺: &[(usize, usize)], 法: u64) -> u64 {",
      "    let n = 頂点数;",
      "    if n == 0 {",
      "        return 1 % 法;",
      "    }",
      "    assert!(n <= 31, \"頂点数が多すぎる（2^N が大きすぎる）: {n}\");",
      "    let mut 前提 = vec![0u32; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        前提[v] |= 1 << u;",
      "    }",
      "    let 全体 = (1u32 << n) - 1;",
      "    let mut dp = vec![0u64; 1 << n];",
      "    dp[0] = 1 % 法;",
      "    for s in 0..=全体 {",
      "        if dp[s as usize] == 0 {",
      "            continue;",
      "        }",
      "        let cur = dp[s as usize];",
      "        for v in 0..n {",
      "            let bit = 1u32 << v;",
      "            if s & bit == 0 && 前提[v] & s == 前提[v] {",
      "                let ns = (s | bit) as usize;",
      "                dp[ns] = (dp[ns] + cur) % 法;",
      "            }",
      "        }",
      "    }",
      "    dp[全体 as usize]",
      "}"
    ]
  },
  "併合_可能_ヒープ": {
    "scope": "rust",
    "prefix": "併合_可能_ヒープ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// スキューヒープの節点（最小ヒープ）。値と左右の子を持つ自己平衡しない二分ヒープ。",
      "struct 節点<T> {",
      "    値: T,",
      "    左: Option<Box<節点<T>>>,",
      "    右: Option<Box<節点<T>>>,",
      "}",
      "/// 2 つの部分木を併合する内部関数。",
      "fn 併合節点<T: Ord>(",
      "    a: Option<Box<節点<T>>>,",
      "    b: Option<Box<節点<T>>>,",
      ") -> Option<Box<節点<T>>> {",
      "    match (a, b) {",
      "        (None, x) | (x, None) => x,",
      "        (Some(mut na), Some(mut nb)) => {",
      "            if na.値 > nb.値 {",
      "                std::mem::swap(&mut na, &mut nb);",
      "            }",
      "            let 右 = na.右.take();",
      "            na.右 = 併合節点(右, Some(nb));",
      "            std::mem::swap(&mut na.左, &mut na.右);",
      "            Some(na)",
      "        }",
      "    }",
      "}",
      "/// 2 つのヒープを `O(log n)` で併合（meld）できる最小ヒープ（スキューヒープ）。",
      "/// 標準の `BinaryHeap` は 2 つのヒープの併合に `O(n)` かかるが、本実装は併合・挿入・",
      "/// 最小取り出しすべて償却 `O(log n)`。最小有向全域木や Dijkstra 風のヒープ統合で使う。",
      "#[derive(Default)]",
      "struct スキューヒープ<T: Ord> {",
      "    根: Option<Box<節点<T>>>,",
      "    個数: usize,",
      "}",
      "impl<T: Ord> スキューヒープ<T> {",
      "    /// 空のヒープを作る。",
      "    fn new() -> Self {",
      "        Self {",
      "            根: None, 個数: 0",
      "        }",
      "    }",
      "    /// 要素数を返す。",
      "    fn 個数(&self) -> usize {",
      "        self.個数",
      "    }",
      "    /// 空かどうかを返す。",
      "    fn 空か(&self) -> bool {",
      "        self.個数 == 0",
      "    }",
      "    /// 値 `v` を挿入する。償却 `O(log n)`。",
      "    fn 挿入(&mut self, v: T) {",
      "        let 節 = Some(Box::new(節点 {",
      "            値: v,",
      "            左: None,",
      "            右: None,",
      "        }));",
      "        self.根 = 併合節点(self.根.take(), 節);",
      "        self.個数 += 1;",
      "    }",
      "    /// 最小値への参照を返す（空なら `None`）。`O(1)`。",
      "    fn 最小参照(&self) -> Option<&T> {",
      "        self.根.as_ref().map(|n| &n.値)",
      "    }",
      "    /// 最小値を取り出して返す（空なら `None`）。償却 `O(log n)`。",
      "    fn 最小取り出し(&mut self) -> Option<T> {",
      "        let 根 = self.根.take()?;",
      "        self.個数 -= 1;",
      "        self.根 = 併合節点(根.左, 根.右);",
      "        Some(根.値)",
      "    }",
      "    /// 別のヒープ `other` を自分に併合する。`other` は空になる。償却 `O(log n)`。",
      "    fn 併合(&mut self, other: &mut Self) {",
      "        self.根 = 併合節点(self.根.take(), other.根.take());",
      "        self.個数 += other.個数;",
      "        other.個数 = 0;",
      "    }",
      "}"
    ]
  },
  "価値_基準_ナップサック": {
    "scope": "rust",
    "prefix": "価値_基準_ナップサック",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 価値を添字にする 0/1 ナップサック。容量が大きく（〜10^9）価値合計が小さいとき向け。",
      "/// 「価値合計をちょうど v にする最小の重さ」を全 v について求め、",
      "/// 重さが `容量` 以下で達成できる最大の価値 v を返す。O(N·Σ価値)。",
      "fn 価値基準ナップサック(品物: &[(usize, i64)], 容量: usize) -> i64 {",
      "    let 価値合計: i64 = 品物.iter().map(|&(_, v)| v).sum();",
      "    const INF: usize = !0 / 2;",
      "    let mut dp = vec![INF; 価値合計 as usize + 1];",
      "    dp[0] = 0;",
      "    for &(重さ, 価値) in 品物 {",
      "        for v in (価値..=価値合計).rev() {",
      "            let prev = dp[(v - 価値) as usize];",
      "            if prev != INF {",
      "                let cand = prev + 重さ;",
      "                let cur = &mut dp[v as usize];",
