      "    let mut 自由: VecDeque<usize> = (0..n).collect();",
      "    while let Some(m) = 自由.pop_front() {",
      "        let w = 男性選好[m][次提案[m]];",
      "        次提案[m] += 1;",
      "        match 夫[w] {",
      "            None => 夫[w] = Some(m),",
      "            Some(m2) => {",
      "                if 女性順位[w][m] < 女性順位[w][m2] {",
