  "下限付き_最大流": {
    "scope": "rust",
    "prefix": "下限付き_最大流",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// 各辺に流量の**下限・上限**を課したネットワークで、`s` から `t` への最大流を求める。",
      "/// 内部は [`ac_library::MfGraph`] の Dinic なので `O(V²E)`。",
      "/// 下限を満たす循環の存在判定（実行可能流）も同時に得られる。",
      "struct 下限付き最大流 {",
      "    n: usize,",
      "    辺: Vec<(usize, usize, i64, i64)>,",
      "}",
      "impl 下限付き最大流 {",
      "    /// 頂点数 `n` の空ネットワークを作る。",
      "    fn new(n: usize) -> Self {",
      "        下限付き最大流 { n, 辺: Vec::new() }",
      "    }",
      "    /// 辺 `from → to` を下限 `下限`・上限 `上限`（`0 ≤ 下限 ≤ 上限`）で追加し、その辺番号を返す。",
      "    fn 辺追加(",
      "        &mut self,",
      "        from: usize,",
      "        to: usize,",
      "        下限: impl TryInto<i64>,",
      "        上限: impl TryInto<i64>,",
      "    ) -> usize {",
      "        let (下限, 上限) = (to_i64(下限), to_i64(上限));",
      "        assert!(from < self.n && to < self.n);",
      "        assert!(0 <= 下限 && 下限 <= 上限);",
      "        let id = self.辺.len();",
      "        self.辺.push((from, to, 下限, 上限));",
      "        id",
      "    }",
      "    /// `s → t` の最大流を解く。実行可能なら `Some((最大流量, 各辺の流量))`、",
      "    /// 下限を満たす流が存在しなければ `None`。各辺の流量は [`辺追加`](Self::辺追加) の順。",
      "    fn 解く(&self, s: usize, t: usize) -> Option<(i64, Vec<i64>)> {",
      "        use ac_library::MfGraph;",
      "        const INF: i64 = 1 << 60;",
      "        let n = self.n;",
      "        let (超源, 超匯) = (n, n + 1);",
      "        let mut g = MfGraph::<i64>::new(n + 2);",
      "        let mut 辺id = Vec::with_capacity(self.辺.len());",
      "        let mut d = vec![0i64; n];",
      "        for &(u, v, lo, cap) in &self.辺 {",
      "            辺id.push(g.add_edge(u, v, cap - lo));",
      "            d[u] -= lo;",
      "            d[v] += lo;",
      "        }",
      "        let 戻り = g.add_edge(t, s, INF);",
      "        let mut 必要 = 0i64;",
      "        for (v, &dv) in d.iter().enumerate() {",
      "            if dv > 0 {",
      "                g.add_edge(超源, v, dv);",
      "                必要 += dv;",
      "            } else if dv < 0 {",
      "                g.add_edge(v, 超匯, -dv);",
      "            }",
      "        }",
      "        if g.flow(超源, 超匯) != 必要 {",
      "            return None;",
      "        }",
      "        let f0 = g.get_edge(戻り).flow;",
      "        g.change_edge(戻り, 0, 0);",
      "        let 追加 = g.flow(s, t);",
      "        let 値 = f0 + 追加;",
      "        let flows = self",
      "            .辺",
      "            .iter()",
      "            .zip(&辺id)",
      "            .map(|(&(_, _, lo, _), &id)| lo + g.get_edge(id).flow)",
      "            .collect();",
      "        Some((値, flows))",
      "    }",
      "}"
    ]
  },
  "乗法的_関数_線形_篩": {
    "scope": "rust",
    "prefix": "乗法的_関数_線形_篩",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 任意の**乗法的関数** `f`（`gcd(a,b)=1 ⇒ f(ab)=f(a)f(b)`）の `f(1..=n)` を線形篩 `O(N)` で作る。",
      "/// 利用者は単位元 `単位 = f(1)`、値の乗算 `乗算`、素数冪での値 `素数冪値(p, c) = f(pᶜ)` を渡す。",
      "/// [`メビウス関数表`](crate::mobius::メビウス関数表)・[`オイラー関数`](crate::totient) は μ・φ 専用、",
      "/// [`divisor_sieve`](crate::divisor_sieve) は約数個数・約数和の `O(N log N)` 調和篩。本関数は",
      "/// 約数個数・約数和・μ・φ・`p`進付値・積性なら何でも同じ `O(N)` 篩で作れる汎用版。",
      "/// 戻り値は長さ `n+1`。`f[0]` は未定義（`単位` を置く）、`f[1] = 単位`。",
      "fn 乗法的関数表<T, M, P>(n: usize, 単位: T, 乗算: M, 素数冪値: P) -> Vec<T>",
      "where",
      "    T: Clone,",
      "    M: Fn(&T, &T) -> T,",
      "    P: Fn(u64, u32) -> T,",
      "{",
      "    let mut f = vec![単位.clone(); n + 1];",
      "    if n == 0 {",
      "        return f;",
      "    }",
      "    let mut 合成 = vec![false; n + 1];",
      "    let mut 最小素数冪 = vec![0usize; n + 1];",
      "    let mut 指数 = vec![0u32; n + 1];",
      "    let mut 素数: Vec<usize> = Vec::new();",
      "    for i in 2..=n {",
      "        if !合成[i] {",
      "            素数.push(i);",
      "            最小素数冪[i] = i;",
      "            指数[i] = 1;",
      "            f[i] = 素数冪値(i as u64, 1);",
      "        }",
      "        for &p in &素数 {",
      "            let ip = i * p;",
      "            if ip > n {",
      "                break;",
      "            }",
      "            合成[ip] = true;",
      "            if i % p == 0 {",
      "                最小素数冪[ip] = 最小素数冪[i] * p;",
      "                指数[ip] = 指数[i] + 1;",
      "                let 残り = i / 最小素数冪[i];",
      "                f[ip] = 乗算(&f[残り], &素数冪値(p as u64, 指数[ip]));",
      "                break;",
      "            } else {",
      "                最小素数冪[ip] = p;",
      "                指数[ip] = 1;",
      "                f[ip] = 乗算(&f[i], &f[p]);",
      "            }",
      "        }",
      "    }",
      "    f",
      "}"
    ]
  },
