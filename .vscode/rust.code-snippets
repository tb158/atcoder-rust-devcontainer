  "totient": {
    "scope": "rust",
    "prefix": "totient",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// オイラーのφ関数 φ(n)：`1..=n` のうち `n` と互いに素な整数の個数。O(√n)。",
      "/// 多くの `n` について一括で欲しいときは [`オイラーのファイ表`] を使う。",
      "fn オイラーのファイ(mut n: u64) -> u64 {",
      "    let mut 結果 = n;",
      "    let mut p = 2u64;",
      "    while p * p <= n {",
      "        if n % p == 0 {",
      "            while n % p == 0 {",
      "                n /= p;",
      "            }",
      "            結果 -= 結果 / p;",
      "        }",
      "        p += 1;",
      "    }",
      "    if n > 1 {",
      "        結果 -= 結果 / n;",
      "    }",
      "    結果",
      "}",
      "/// `0..=n` の各 `i` について φ(i) を入れた配列を篩で前計算する。O(n log log n)。",
      "/// `表[0] = 0`、`表[1] = 1`。",
      "fn オイラーのファイ表(n: usize) -> Vec<u64> {",
      "    let mut 表: Vec<u64> = (0..=n as u64).collect();",
      "    for i in 2..=n {",
      "        if 表[i] == i as u64 {",
      "            let mut j = i;",
      "            while j <= n {",
      "                表[j] -= 表[j] / i as u64;",
      "                j += i;",
      "            }",
      "        }",
      "    }",
      "    表",
      "}"
    ]
  },
  "tree_center": {
    "scope": "rust",
    "prefix": "tree_center",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 木の中心を求める（再帰なし）。中心とは、そこから最も遠い頂点までの距離（離心数）が",
      "/// 最小になる頂点。重みなしの木の中心は 1 個か 2 個あり、直径パスの真ん中に位置する。O(N)。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対）。戻り値は中心の頂点番号（昇順、長さ 1 か 2）。",
      "/// 中心の離心数（木の半径）は `⌈直径 / 2⌉`。2 個のときは隣接していて、その間の辺の中点が真の中心。",
      "/// [`木の重心`](crate::tree_centroid::木の重心)（除去後の最大成分を最小化）とは別物。",
      "/// 中心は「最遠距離の最小化」、重心は「部分木サイズの均衡」で、長い枝と多数の葉が混ざるとずれる。",
      "fn 木の中心(n: usize, 辺: &[(usize, usize)]) -> Vec<usize> {",
      "    fn 距離と親(グラフ: &[Vec<usize>], 始点: usize) -> (Vec<usize>, Vec<usize>) {",
      "        let mut 距離 = vec![!0; グラフ.len()];",
      "        let mut prev = vec![!0; グラフ.len()];",
      "        距離[始点] = 0;",
      "        let mut 探索 = vec![始点];",
      "        while let Some(now) = 探索.pop() {",
      "            for &next in &グラフ[now] {",
      "                if 距離[next] == !0 {",
      "                    距離[next] = 距離[now] + 1;",
      "                    prev[next] = now;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        (距離, prev)",
      "    }",
      "    if n <= 1 {",
      "        return (0..n).collect();",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let (距離, _) = 距離と親(&グラフ, 0);",
      "    let u = (0..n).max_by_key(|&v| 距離[v]).unwrap();",
      "    let (距離, prev) = 距離と親(&グラフ, u);",
      "    let v = (0..n).max_by_key(|&w| 距離[w]).unwrap();",
      "    let 直径 = 距離[v];",
      "    let mut now = v;",
      "    for _ in 0..直径 / 2 {",
      "        now = prev[now];",
      "    }",
      "    let mut 中心 = vec![now];",
      "    if 直径 % 2 == 1 {",
      "        中心.push(prev[now]);",
      "    }",
      "    中心.sort();",
      "    中心",
      "}"
    ]
  },
