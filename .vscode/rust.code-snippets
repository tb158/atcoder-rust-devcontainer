  "LinearExtensionCount": {
    "scope": "rust",
    "prefix": "LinearExtensionCount",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// DAG（半順序）の**位相順序（線形拡大）の総数**を `法` で数える。頂点数 `N ≤ 20` 程度向けの",
      "/// 部分集合 DP。`O(2^N · N)`。",
      "/// `辺` は有向辺 `(u, v)`（`u → v`、`u` が `v` より前）。閉路があれば 0。",
      "/// 半順序集合の線形拡大数（ソートの仕方の数）を求めるのに使う。",
      "#[allow(clippy::needless_range_loop)]",
      "fn 位相順序数(頂点数: usize, 辺: &[(usize, usize)], 法: u64) -> u64 {",
      "    let n = 頂点数;",
      "    if n == 0 {",
      "        return 1 % 法;",
      "    }",
      "    assert!(n <= 31, \"頂点数が多すぎる（2^N が大きすぎる）: {n}\");",
      "    let mut 前提 = vec![0u32; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        前提[v] |= 1 << u;",
      "    }",
      "    let 全体 = (1u32 << n) - 1;",
      "    let mut dp = vec![0u64; 1 << n];",
      "    dp[0] = 1 % 法;",
      "    for s in 0..=全体 {",
      "        if dp[s as usize] == 0 {",
      "            continue;",
      "        }",
      "        let cur = dp[s as usize];",
      "        for v in 0..n {",
      "            let bit = 1u32 << v;",
      "            if s & bit == 0 && 前提[v] & s == 前提[v] {",
      "                let ns = (s | bit) as usize;",
      "                dp[ns] = (dp[ns] + cur) % 法;",
      "            }",
      "        }",
      "    }",
      "    dp[全体 as usize]",
      "}"
    ]
  },
  "LinkCutTree": {
    "scope": "rust",
    "prefix": "LinkCutTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Link-Cut Tree。森に対する辺の追加・削除（[`Self::辺を張る`] / [`Self::辺を切る`]）、",
      "/// 連結判定、2 頂点間パスの頂点値の総和を、すべてならし O(log N) で処理する。",
      "/// 頂点番号は 0-indexed。",
      "/// - [`Self::辺を張る`] : 別の木に属する 2 頂点を結ぶ（同一木の頂点に呼んではならない）。",
      "/// - [`Self::辺を切る`] : 既存の辺を取り除く（隣接していない 2 頂点に呼んではならない）。",
      "/// - [`Self::連結`] : 2 頂点が同じ木か。",
      "/// - [`Self::パス和`] : 2 頂点間パス上の頂点値の総和。",
      "/// - [`Self::値設定`] : 1 頂点の値を更新。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "struct リンクカット木<T> {",
      "    親: Vec<usize>,",
      "    子: Vec<[usize; 2]>,",
      "    値: Vec<T>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "}",
      "impl<T> リンクカット木<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    /// 各頂点の初期値から構築する。",
      "    fn new(初期値: &[T]) -> Self {",
      "        let n = 初期値.len();",
      "        let mut s = Self {",
      "            親: vec![0; n + 1],",
      "            子: vec![[0, 0]; n + 1],",
      "            値: vec![T::default(); n + 1],",
      "            和: vec![T::default(); n + 1],",
      "            反転: vec![false; n + 1],",
      "        };",
      "        for (i, &v) in 初期値.iter().enumerate() {",
      "            s.値[i + 1] = v;",
      "            s.和[i + 1] = v;",
      "        }",
      "        s",
      "    }",
      "    /// `x` がスプレー木の根（パス親へのリンクしか持たない）か。",
      "    fn is_root(&self, x: usize) -> bool {",
      "        let p = self.親[x];",
      "        p == 0 || (self.子[p][0] != x && self.子[p][1] != x)",
      "    }",
      "    fn 更新(&mut self, x: usize) {",
      "        if x == 0 {",
      "            return;",
      "        }",
      "        self.和[x] = self.和[self.子[x][0]] + self.値[x] + self.和[self.子[x][1]];",
      "    }",
      "    fn 伝播(&mut self, x: usize) {",
      "        if x != 0 && self.反転[x] {",
      "            let l = self.子[x][0];",
      "            let r = self.子[x][1];",
      "            self.子[x][0] = r;",
      "            self.子[x][1] = l;",
      "            if l != 0 {",
      "                self.反転[l] ^= true;",
      "            }",
      "            if r != 0 {",
      "                self.反転[r] ^= true;",
      "            }",
      "            self.反転[x] = false;",
      "        }",
      "    }",
      "    fn 回転(&mut self, x: usize) {",
      "        let p = self.親[x];",
      "        let g = self.親[p];",
      "        let pがルート = self.is_root(p);",
      "        let d = if self.子[p][1] == x { 1 } else { 0 };",
      "        let b = self.子[x][d ^ 1];",
      "        self.子[p][d] = b;",
      "        if b != 0 {",
      "            self.親[b] = p;",
      "        }",
      "        self.子[x][d ^ 1] = p;",
      "        self.親[p] = x;",
      "        self.親[x] = g;",
      "        if !pがルート {",
      "            if self.子[g][0] == p {",
      "                self.子[g][0] = x;",
      "            } else if self.子[g][1] == p {",
      "                self.子[g][1] = x;",
      "            }",
      "        }",
      "        self.更新(p);",
      "        self.更新(x);",
      "    }",
      "    fn splay(&mut self, x: usize) {",
      "        let mut スタック = vec![x];",
      "        let mut y = x;",
      "        while !self.is_root(y) {",
      "            y = self.親[y];",
      "            スタック.push(y);",
      "        }",
      "        while let Some(v) = スタック.pop() {",
      "            self.伝播(v);",
      "        }",
      "        while !self.is_root(x) {",
      "            let p = self.親[x];",
      "            if self.is_root(p) {",
      "                self.回転(x);",
      "            } else {",
      "                let g = self.親[p];",
      "                let 同方向 = (self.子[g][1] == p) == (self.子[p][1] == x);",
      "                if 同方向 {",
      "                    self.回転(p);",
      "                } else {",
      "                    self.回転(x);",
      "                }",
      "                self.回転(x);",
      "            }",
      "        }",
      "    }",
      "    fn access(&mut self, x: usize) -> usize {",
      "        let mut last = 0;",
      "        let mut cur = x;",
      "        while cur != 0 {",
      "            self.splay(cur);",
      "            self.子[cur][1] = last;",
      "            self.更新(cur);",
      "            last = cur;",
      "            cur = self.親[cur];",
      "        }",
      "        self.splay(x);",
      "        last",
      "    }",
      "    fn make_root(&mut self, x: usize) {",
      "        self.access(x);",
      "        self.反転[x] ^= true;",
      "        self.伝播(x);",
      "    }",
      "    fn find_root(&mut self, x: usize) -> usize {",
      "        self.access(x);",
      "        let mut r = x;",
      "        self.伝播(r);",
      "        while self.子[r][0] != 0 {",
      "            r = self.子[r][0];",
      "            self.伝播(r);",
      "        }",
      "        self.splay(r);",
      "        r",
      "    }",
      "    /// 別の木に属する頂点 `u`・`v` を結ぶ辺を張る。同じ木の 2 頂点に呼んではならない。",
      "    fn 辺を張る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.親[a] = b;",
      "    }",
      "    /// 既存の辺 `u - v` を取り除く。隣接していない 2 頂点に呼んではならない。",
      "    fn 辺を切る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.子[b][0] = 0;",
      "        self.親[a] = 0;",
      "        self.更新(b);",
      "    }",
      "    /// 頂点 `u`・`v` が同じ木に属するか。",
      "    fn 連結(&mut self, u: usize, v: usize) -> bool {",
      "        if u == v {",
      "            return true;",
      "        }",
      "        self.find_root(u + 1) == self.find_root(v + 1)",
      "    }",
      "    /// 任意頂点 `u` をその木の根にする。",
      "    fn 根を変更(&mut self, u: usize) {",
      "        self.make_root(u + 1);",
      "    }",
      "    /// 頂点 `u`・`v` 間のパス上にある頂点値の総和。同じ木に属することが前提。",
      "    fn パス和(&mut self, u: usize, v: usize) -> T {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.和[b]",
      "    }",
      "    /// 頂点 `u` の値を `新値` に設定する。",
      "    fn 値設定(&mut self, u: usize, 新値: T) {",
      "        let a = u + 1;",
      "        self.access(a);",
      "        self.値[a] = 新値;",
      "        self.更新(a);",
      "    }",
      "    /// 頂点 `u` の現在の値。",
      "    fn 頂点値(&self, u: usize) -> T {",
      "        self.値[u + 1]",
      "    }",
      "}"
    ]
  },
  "LowLink": {
    "scope": "rust",
    "prefix": "LowLink",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向グラフの橋（取り除くと連結成分が増える辺）と関節点（取り除くと連結成分が増える頂点）を",
      "/// lowlink で求める。構築 O(V + E)。非連結でも全成分を処理する。",
      "/// 多重辺がある場合、同じ 2 頂点を結ぶ辺が 2 本以上あればその辺は橋にならない（辺番号で区別）。",
      "/// - [`Self::橋一覧`] : 橋を `(u, v)`（u < v）の昇順で返す。",
      "/// - [`Self::関節点一覧`] : 関節点を昇順で返す。",
      "struct ローリンク {",
      "    n: usize,",
      "    グラフ: Vec<Vec<(usize, usize)>>,",
      "    辺数: usize,",
      "}",
      "/// DFS 中に使い回す作業領域。",
      "struct 作業領域 {",
      "    カウンタ: usize,",
      "    ord: Vec<i64>,",
      "    low: Vec<usize>,",
      "    橋: Vec<(usize, usize)>,",
      "    関節: Vec<bool>,",
      "}",
      "impl ローリンク {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            グラフ: vec![Vec::new(); n],",
      "            辺数: 0,",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。多重辺・自己ループも許容する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        let id = self.辺数;",
      "        self.グラフ[u].push((v, id));",
      "        self.グラフ[v].push((u, id));",
      "        self.辺数 += 1;",
      "    }",
      "    /// DFS で `ord`（行きがけ順）と `low` を計算し、橋・関節点を収集する。",
      "    fn 探索(&self, now: usize, 親辺: usize, 根か: bool, w: &mut 作業領域) {",
      "        w.ord[now] = w.カウンタ as i64;",
      "        w.low[now] = w.カウンタ;",
      "        w.カウンタ += 1;",
      "        let mut 子数 = 0usize;",
      "        let mut 関節点フラグ = false;",
      "        for &(next, 辺) in &self.グラフ[now] {",
      "            if 辺 == 親辺 {",
      "                continue;",
      "            }",
      "            if w.ord[next] == -1 {",
      "                子数 += 1;",
      "                self.探索(next, 辺, false, w);",
      "                w.low[now] = w.low[now].min(w.low[next]);",
      "                if w.low[next] > w.ord[now] as usize {",
      "                    let (a, b) = if now < next { (now, next) } else { (next, now) };",
      "                    w.橋.push((a, b));",
      "                }",
      "                if !根か && w.low[next] >= w.ord[now] as usize {",
      "                    関節点フラグ = true;",
      "                }",
      "            } else {",
      "                w.low[now] = w.low[now].min(w.ord[next] as usize);",
      "            }",
      "        }",
      "        if 根か {",
      "            if 子数 >= 2 {",
      "                w.関節[now] = true;",
      "            }",
      "        } else if 関節点フラグ {",
      "            w.関節[now] = true;",
      "        }",
      "    }",
      "    fn 計算(&self) -> (Vec<(usize, usize)>, Vec<bool>) {",
      "        let mut w = 作業領域 {",
      "            カウンタ: 0,",
      "            ord: vec![-1i64; self.n],",
      "            low: vec![0usize; self.n],",
      "            橋: Vec::new(),",
      "            関節: vec![false; self.n],",
      "        };",
      "        for s in 0..self.n {",
      "            if w.ord[s] == -1 {",
      "                self.探索(s, !0, true, &mut w);",
      "            }",
      "        }",
      "        (w.橋, w.関節)",
      "    }",
      "    /// 橋を `(u, v)`（u < v）の昇順で返す。",
      "    fn 橋一覧(&self) -> Vec<(usize, usize)> {",
      "        let (mut 橋, _) = self.計算();",
      "        橋.sort_unstable();",
      "        橋",
      "    }",
      "    /// 関節点を昇順で返す。",
      "    fn 関節点一覧(&self) -> Vec<usize> {",
      "        let (_, 関節) = self.計算();",
      "        (0..self.n).filter(|&v| 関節[v]).collect()",
      "    }",
      "}"
    ]
  },
  "LowerBoundFlow": {
    "scope": "rust",
    "prefix": "LowerBoundFlow",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// 各辺に流量の**下限・上限**を課したネットワークで、`s` から `t` への最大流を求める。",
      "/// 内部は [`ac_library::MfGraph`] の Dinic なので `O(V²E)`。",
      "/// 下限を満たす循環の存在判定（実行可能流）も同時に得られる。",
      "struct 下限付き最大流 {",
      "    n: usize,",
      "    辺: Vec<(usize, usize, i64, i64)>,",
      "}",
      "impl 下限付き最大流 {",
      "    /// 頂点数 `n` の空ネットワークを作る。",
      "    fn new(n: usize) -> Self {",
      "        下限付き最大流 { n, 辺: Vec::new() }",
      "    }",
      "    /// 辺 `from → to` を下限 `下限`・上限 `上限`（`0 ≤ 下限 ≤ 上限`）で追加し、その辺番号を返す。",
      "    fn 辺追加(",
      "        &mut self,",
      "        from: usize,",
      "        to: usize,",
      "        下限: impl TryInto<i64>,",
      "        上限: impl TryInto<i64>,",
      "    ) -> usize {",
      "        let (下限, 上限) = (to_i64(下限), to_i64(上限));",
      "        assert!(from < self.n && to < self.n);",
      "        assert!(0 <= 下限 && 下限 <= 上限);",
      "        let id = self.辺.len();",
      "        self.辺.push((from, to, 下限, 上限));",
      "        id",
      "    }",
      "    /// `s → t` の最大流を解く。実行可能なら `Some((最大流量, 各辺の流量))`、",
      "    /// 下限を満たす流が存在しなければ `None`。各辺の流量は [`辺追加`](Self::辺追加) の順。",
      "    fn 解く(&self, s: usize, t: usize) -> Option<(i64, Vec<i64>)> {",
      "        use ac_library::MfGraph;",
      "        const INF: i64 = 1 << 60;",
      "        let n = self.n;",
      "        let (超源, 超匯) = (n, n + 1);",
      "        let mut g = MfGraph::<i64>::new(n + 2);",
      "        let mut 辺id = Vec::with_capacity(self.辺.len());",
      "        let mut d = vec![0i64; n];",
      "        for &(u, v, lo, cap) in &self.辺 {",
      "            辺id.push(g.add_edge(u, v, cap - lo));",
      "            d[u] -= lo;",
      "            d[v] += lo;",
      "        }",
      "        let 戻り = g.add_edge(t, s, INF);",
      "        let mut 必要 = 0i64;",
      "        for (v, &dv) in d.iter().enumerate() {",
      "            if dv > 0 {",
      "                g.add_edge(超源, v, dv);",
      "                必要 += dv;",
      "            } else if dv < 0 {",
      "                g.add_edge(v, 超匯, -dv);",
      "            }",
      "        }",
      "        if g.flow(超源, 超匯) != 必要 {",
      "            return None;",
      "        }",
      "        let f0 = g.get_edge(戻り).flow;",
      "        g.change_edge(戻り, 0, 0);",
      "        let 追加 = g.flow(s, t);",
      "        let 値 = f0 + 追加;",
      "        let flows = self",
      "            .辺",
      "            .iter()",
      "            .zip(&辺id)",
      "            .map(|(&(_, _, lo, _), &id)| lo + g.get_edge(id).flow)",
      "            .collect();",
      "        Some((値, flows))",
      "    }",
      "}"
    ]
  },
  "Lucas": {
    "scope": "rust",
    "prefix": "Lucas",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// Lucas の定理による二項係数 `C(n, k) mod p`（`p` は素数）。`n`, `k` は最大 ~10^18 まで扱える。",
      "/// `n`/`k` を p 進展開して桁ごとに掛け合わせるので、`n` が巨大でも `O(log_p n)`。",
      "/// `0..p` の階乗を前計算するので `p` が小さめの素数のとき向き",
      "/// （`p` が 10^9+7 級で `n <= max_n` に収まるなら [`crate::comb`]）。",
      "struct リュカ {",
      "    p: u64,",
      "    階乗: Vec<u64>,",
      "    逆階乗: Vec<u64>,",
      "}",
      "impl リュカ {",
      "    /// 素数 `p` を法とする計算器を作る。`0..p` の階乗・逆階乗を前計算する（O(p)）。",
      "    fn new(p: impl TryInto<u64>) -> Self {",
      "        let p: u64 = p.try_into().ok().expect(\"リュカ: p が u64 に収まりません\");",
      "        assert!(p >= 2, \"p must be a prime >= 2\");",
      "        let mut 階乗 = vec![1u64; p as usize];",
      "        for i in 1..p as usize {",
      "            階乗[i] = 階乗[i - 1] * i as u64 % p;",
      "        }",
      "        let mut 逆階乗 = vec![1u64; p as usize];",
      "        逆階乗[p as usize - 1] = 累乗_mod(階乗[p as usize - 1], p - 2, p);",
      "        for i in (1..p as usize).rev() {",
      "            逆階乗[i - 1] = 逆階乗[i] * i as u64 % p;",
      "        }",
      "        Self {",
      "            p, 階乗, 逆階乗",
      "        }",
      "    }",
      "    /// `0 <= a, b < p` での `C(a, b) mod p`。",
      "    fn 小二項係数(&self, a: u64, b: u64) -> u64 {",
      "        if b > a {",
      "            return 0;",
      "        }",
      "        let a = a as usize;",
      "        let b = b as usize;",
      "        self.階乗[a] * self.逆階乗[b] % self.p * self.逆階乗[a - b] % self.p",
      "    }",
      "    /// `C(n, k) mod p`。`n`, `k` を p 進展開し、各桁の二項係数の積を取る。",
      "    /// 引数は任意の整数型でよい（負の値は 0 を返す）。",
      "    fn 二項係数(&self, n: impl TryInto<i128>, k: impl TryInto<i128>) -> u64 {",
      "        let n: i128 = n.try_into().ok().expect(\"リュカ: n が i128 に収まりません\");",
      "        let k: i128 = k.try_into().ok().expect(\"リュカ: k が i128 に収まりません\");",
      "        if n < 0 || k < 0 {",
      "            return 0;",
      "        }",
      "        let mut n = u64::try_from(n).expect(\"リュカ: n が u64 を超えています\");",
      "        let mut k = u64::try_from(k).expect(\"リュカ: k が u64 を超えています\");",
      "        let mut 結果 = 1u64;",
      "        while n > 0 || k > 0 {",
      "            let ni = n % self.p;",
      "            let ki = k % self.p;",
      "            if ki > ni {",
      "                return 0;",
      "            }",
      "            結果 = 結果 * self.小二項係数(ni, ki) % self.p;",
      "            n /= self.p;",
      "            k /= self.p;",
      "        }",
      "        結果",
      "    }",
      "}"
    ]
  },
  "LucasTheorem": {
    "scope": "rust",
    "prefix": "LucasTheorem",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
