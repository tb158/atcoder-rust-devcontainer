  "多項式_補間": {
    "scope": "rust",
    "prefix": "多項式_補間",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 素数 `法` を法とする `a` の逆元（フェルマーの小定理 `a^(法-2)`）。`O(log 法)`。",
      "/// `法` が素数で `a % 法 != 0` であることが前提。合成数を法とする場合や `a` が",
      "/// `法` の倍数の場合は正しい値を返さない（拡張ユークリッドを使うこと）。",
      "fn 逆元(a: u64, 法: u64) -> u64 {",
      "    累乗_mod(a, 法 - 2, 法)",
      "}",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 相異なる点 `(xs[i], ys[i])` を通る次数 `< n` の多項式を素数 `法` 上で求め、`t` での値を返す。O(n^2)。",
      "/// `法` は素数で、`xs` は互いに異なること。点が等間隔（0,1,2,...）なら [`連続点補間`] が O(n) で速い。",
      "fn ラグランジュ補間(",
      "    xs: &[impl TryInto<u64> + Copy],",
      "    ys: &[impl TryInto<u64> + Copy],",
      "    t: impl TryInto<u64>,",
      "    法: impl TryInto<u64>,",
      ") -> usize {",
      "    let xs: Vec<u64> = xs",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"ラグランジュ補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let ys: Vec<u64> = ys",
      "        .iter()",
      "        .map(|&y| {",
      "            y.try_into()",
      "                .ok()",
      "                .expect(\"ラグランジュ補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let t: u64 = t",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ラグランジュ補間: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ラグランジュ補間: 引数が u64 に収まりません\");",
      "    let n = xs.len();",
      "    let t = t % 法;",
      "    let mut 結果 = 0u64;",
      "    for i in 0..n {",
      "        let mut 分子 = 1u64;",
      "        let mut 分母 = 1u64;",
      "        for j in 0..n {",
      "            if i != j {",
      "                分子 = 分子 * ((t + 法 - xs[j] % 法) % 法) % 法;",
      "                分母 = 分母 * ((xs[i] % 法 + 法 - xs[j] % 法) % 法) % 法;",
      "            }",
      "        }",
      "        結果 = (結果 + ys[i] % 法 * 分子 % 法 * 逆元(分母, 法)) % 法;",
      "    }",
      "    結果 as usize",
      "}",
      "/// `ys[i] = f(i)`（`i = 0..n`）から次数 `< n` の多項式 `f` を定め、`f(t)` を素数 `法` 上で O(n) で返す。",
      "/// `Σ i^k` のような多項式和の閉じた式を点から外挿する用途で頻出。",
      "/// `t` が `0..n` の範囲なら `ys[t]` をそのまま返す。",
      "fn 連続点補間(",
      "    ys: &[impl TryInto<u64> + Copy],",
      "    t: impl TryInto<u64>,",
      "    法: impl TryInto<u64>,",
      ") -> usize {",
      "    let ys: Vec<u64> = ys",
      "        .iter()",
      "        .map(|&y| {",
      "            y.try_into()",
      "                .ok()",
      "                .expect(\"連続点補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let t: u64 = t",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連続点補間: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連続点補間: 引数が u64 に収まりません\");",
      "    let n = ys.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    if t < n as u64 {",
      "        return (ys[t as usize] % 法) as usize;",
      "    }",
      "    let d = n - 1;",
      "    let tm = t % 法;",
      "    let mut 階乗 = vec![1u64; n];",
      "    for i in 1..n {",
      "        階乗[i] = 階乗[i - 1] * i as u64 % 法;",
      "    }",
      "    let mut 前 = vec![1u64; n + 1];",
      "    for i in 0..n {",
      "        前[i + 1] = 前[i] * ((tm + 法 - i as u64 % 法) % 法) % 法;",
      "    }",
      "    let mut 後 = vec![1u64; n + 1];",
      "    for i in (0..n).rev() {",
      "        後[i] = 後[i + 1] * ((tm + 法 - i as u64 % 法) % 法) % 法;",
      "    }",
      "    let mut 結果 = 0u64;",
      "    for i in 0..n {",
      "        let 分子 = 前[i] * 後[i + 1] % 法;",
      "        let 分母 = 階乗[i] * 階乗[d - i] % 法;",
      "        let mut 項 = ys[i] % 法 * 分子 % 法 * 逆元(分母, 法) % 法;",
      "        if (d - i) % 2 == 1 {",
      "            項 = (法 - 項) % 法;",
      "        }",
