  "idom": {
    "scope": "rust",
    "prefix": "idom",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから有向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺[i] = (u, v)` を `u → v` の一方向の辺として `グラフ[u]` にだけ積む。",
      "/// 逆辺が欲しい場合は `(v, u)` に読み替えてもう一度呼ぶ。",
      "fn 有向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "    }",
      "    グラフ",
      "}",
      "/// 支配木（dominator tree）を求める。`根` から各頂点への全経路が必ず通る頂点のうち",
      "/// 最も近いもの（直接支配点 idom）を返す。`辺` は AtCoder の入力そのまま",
      "/// （0-indexed の有向辺 `(u, v)` = `u → v`）。",
      "/// 返り値 `idom`：`idom[根] = 根`、到達可能な `v` は `idom[v]` がその直接支配点、到達不能な頂点は",
      "/// `!0`。制御フロー解析や「ある頂点を経由しないと到達できない頂点」の判定に使う。",
      "/// 最悪計算量は Lengauer–Tarjan の `O((V+E) log V)` に劣るが、実グラフでは十分高速。",
      "fn 支配木(n: usize, 辺: &[(usize, usize)], 根: usize) -> Vec<usize> {",
      "    let mut g = petgraph::graph::DiGraph::<(), ()>::new();",
      "    let 節: Vec<petgraph::graph::NodeIndex> = (0..n).map(|_| g.add_node(())).collect();",
      "    for &(v, u) in 辺 {",
      "        g.add_edge(節[v], 節[u], ());",
      "    }",
      "    let dom = petgraph::algo::dominators::simple_fast(&g, 節[根]);",
      "    let mut 結果 = vec![!0; n];",
      "    結果[根] = 根;",
      "    for (v, &節v) in 節.iter().enumerate() {",
      "        if v != 根",
      "            && let Some(d) = dom.immediate_dominator(節v)",
      "        {",
      "            結果[v] = d.index();",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "inout_時刻": {
    "scope": "rust",
    "prefix": "inout_時刻",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// オイラーツアー（部分木 → 区間への変換）。根 `根` から木を DFS し、各頂点 `v` の",
      "/// 入時刻 `in_[v]` と出時刻 `out[v]` を返す（再帰なし）。O(N)。`in_` は行きがけ順 0..N。",
      "/// `辺` は 0-indexed の頂点対（AtCoder の入力そのまま）。",
      "/// 部分木 `v` は半開区間 `[in_[v], out[v])` に対応する（`out[v] - in_[v]` が部分木サイズ）。",
      "/// `u` が `v` の部分木に含まれる ⇔ `in_[v] <= in_[u] < out[v]`。",
      "/// この区間を BIT / セグ木の添字に使えば「部分木への一括加算・部分木和」を扱える。",
      "fn オイラーツアー(n: usize, 辺: &[(usize, usize)], 根: usize) -> (Vec<usize>, Vec<usize>) {",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut in_ = vec![0usize; n];",
      "    let mut out = vec![0usize; n];",
      "    let mut 時刻 = 0usize;",
      "    let mut 探索 = vec![(根, !0)];",
      "    while let Some((now, prev)) = 探索.pop() {",
      "        if now >= n {",
      "            let now = !now;",
      "            out[now] = 時刻;",
      "            continue;",
      "        }",
      "        in_[now] = 時刻;",
      "        時刻 += 1;",
      "        探索.push((!now, prev));",
      "        for &next in &グラフ[now] {",
      "            if next != prev {",
      "                探索.push((next, now));",
      "            }",
      "        }",
      "    }",
      "    (in_, out)",
      "}"
    ]
  },
