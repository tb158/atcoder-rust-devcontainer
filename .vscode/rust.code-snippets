  "最小_周期": {
    "scope": "rust",
    "prefix": "最小_周期",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 接頭辞関数（KMP の failure 配列）。`pi[i]` は `s[0..=i]` の真の接頭辞かつ接尾辞となる",
      "/// 最長文字列（ボーダー）の長さ。O(n)。`s` の要素は `PartialEq` であればよい。",
      "/// ボーダー・周期性の解析や [`kmp検索`] の前処理に使う。`ac_library::z_algorithm` は Z 配列を",
      "/// 返す別アルゴリズムで、用途（周期・ボーダーの直接取得）が異なる。",
      "fn 接頭辞関数<T: PartialEq>(s: &[T]) -> Vec<usize> {",
      "    let n = s.len();",
      "    let mut pi = vec![0usize; n];",
      "    for i in 1..n {",
      "        let mut j = pi[i - 1];",
      "        while j > 0 && s[i] != s[j] {",
      "            j = pi[j - 1];",
      "        }",
      "        if s[i] == s[j] {",
      "            j += 1;",
      "        }",
      "        pi[i] = j;",
      "    }",
      "    pi",
      "}",
      "/// `テキスト` 中に `パターン` が出現する開始位置（0-indexed）を全て昇順で返す。O(n + m)。",
      "/// 重なり合う出現も全て列挙する。空パターンは「マッチなし」として空の `Vec` を返す。",
      "fn kmp検索<T: PartialEq>(テキスト: &[T], パターン: &[T]) -> Vec<usize> {",
      "    let m = パターン.len();",
      "    let mut 結果 = Vec::new();",
      "    if m == 0 {",
      "        return 結果;",
      "    }",
      "    let pi = 接頭辞関数(パターン);",
      "    let mut j = 0usize;",
      "    for (i, c) in テキスト.iter().enumerate() {",
      "        while j > 0 && *c != パターン[j] {",
      "            j = pi[j - 1];",
      "        }",
      "        if *c == パターン[j] {",
      "            j += 1;",
      "        }",
      "        if j == m {",
      "            結果.push(i + 1 - m);",
      "            j = pi[j - 1];",
      "        }",
      "    }",
      "    結果",
      "}",
      "/// `s` の最小周期長。`s` は長さ `周期` のブロックの繰り返しの接頭辞になる",
      "/// （`s[i] == s[i + 周期]` が全ての有効な `i` で成り立つ最小の `周期`）。空列なら 0。",
      "/// 例: `\"aabaab\"` → 3、`\"aabaa\"` → 3、`\"abcabc\"` → 3、`\"abcd\"` → 4。",
      "/// `s.len() % 周期 == 0` のときだけ `s` はそのブロックの「ちょうど整数回」の繰り返し。",
      "fn 最小周期<T: PartialEq>(s: &[T]) -> usize {",
      "    let n = s.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let pi = 接頭辞関数(s);",
      "    n - pi[n - 1]",
      "}"
    ]
  },
  "最小_回転": {
    "scope": "rust",
    "prefix": "最小_回転",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最小回転（Booth のアルゴリズム）。列 `s` の巡回シフトのうち辞書順最小になるものの開始位置を",
      "/// `O(n)` で返す。`s[k..] ++ s[..k]` が最小の回転。空列なら `0`。",
      "/// 文字列の「最小表現（canonical form）」を取って同型判定する用途で頻出。",
      "/// 比較できる任意の要素列に使える。",
      "fn 最小回転<T: Ord>(s: &[T]) -> usize {",
      "    let n = s.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let c = |idx: usize| &s[idx % n];",
      "    let mut f: Vec<i64> = vec![-1; 2 * n];",
      "    let mut k: usize = 0;",
      "    for j in 1..2 * n {",
      "        let sj = c(j);",
      "        let mut i = f[j - k - 1];",
      "        while i != -1 && sj != c(k + i as usize + 1) {",
      "            if sj < c(k + i as usize + 1) {",
      "                k = j - i as usize - 1;",
      "            }",
      "            i = f[i as usize];",
      "        }",
      "        if sj != c(k + (i + 1) as usize) {",
      "            if sj < c(k + (i + 1) as usize) {",
      "                k = j;",
      "            }",
      "            f[j - k] = -1;",
      "        } else {",
      "            f[j - k] = i + 1;",
      "        }",
      "    }",
      "    k",
      "}"
    ]
  },
  "最小_幅": {
    "scope": "rust",
    "prefix": "最小_幅",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 凸包（Andrew's monotone chain）。与えた点集合をすべて含む最小の凸多角形の",
      "/// 頂点を、反時計回りの順で返す。O(N log N)。",
      "/// 一直線上に並ぶ中間点（凸包の辺上の点）は頂点に含めない。",
      "/// 点が2個以下のときは重複を除いた入力をそのまま返す。",
      "fn 凸包(点群: &[(i64, i64)]) -> Vec<(i64, i64)> {",
      "    let mut 点 = 点群.to_vec();",
      "    点.sort();",
      "    点.dedup();",
      "    let n = 点.len();",
      "    if n <= 2 {",
      "        return 点;",
      "    }",
      "    let mut 下側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in &点 {",
      "        while 下側.len() >= 2 && 外積3点(下側[下側.len() - 2], 下側[下側.len() - 1], p) <= 0",
      "        {",
      "            下側.pop();",
      "        }",
      "        下側.push(p);",
      "    }",
      "    let mut 上側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in 点.iter().rev() {",
      "        while 上側.len() >= 2 && 外積3点(上側[上側.len() - 2], 上側[上側.len() - 1], p) <= 0",
      "        {",
      "            上側.pop();",
      "        }",
      "        上側.push(p);",
      "    }",
      "    下側.pop();",
      "    上側.pop();",
      "    下側.extend(上側);",
      "    下側",
      "}",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "/// 凸多角形（点群の凸包）の**最小幅**＝平行な 2 直線で挟んだときの最小の間隔を返す。回転キャリパスで",
      "/// 凸包の各辺について最遠頂点までの距離を測り、その最小を取る。凸包構築 O(N log N) ＋ 走査 O(N)。",
      "/// 点が 2 個以下（または一直線）なら幅 0。",
      "/// 同じファイルの [`最遠点対の距離2乗`] が「最遠＝直径」なのに対し、こちらは「最薄＝幅」。",
      "/// 最小幅は、棒を通せる最小の隙間や、凸形状を平行平板で挟む最小厚みの判定に使う。",
      "fn 凸多角形の最小幅(点群: &[(i64, i64)]) -> f64 {",
      "    let 包 = 凸包(点群);",
      "    let m = 包.len();",
      "    if m <= 2 {",
      "        return 0.0;",
      "    }",
      "    let mut 最小 = f64::INFINITY;",
      "    let mut j = 1usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for i in 0..m {",
      "        let ni = (i + 1) % m;",
      "        while 外積3点(包[i], 包[ni], 包[(j + 1) % m]) > 外積3点(包[i], 包[ni], 包[j]) {",
      "            j = (j + 1) % m;",
      "        }",
      "        let 高さ2倍 = 外積3点(包[i], 包[ni], 包[j]).abs() as f64;",
      "        let 辺長 =",
      "            (((包[ni].0 - 包[i].0) as f64).powi(2) + ((包[ni].1 - 包[i].1) as f64).powi(2)).sqrt();",
      "        最小 = 最小.min(高さ2倍 / 辺長);",
      "    }",
      "    最小",
      "}"
    ]
  },
  "最小_平均_サイクル": {
    "scope": "rust",
    "prefix": "最小_平均_サイクル",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 有向重み付きグラフの**最小平均閉路**（辺の重み和 ÷ 辺数を最小化する閉路の、その比）を返す。",
      "/// 閉路が存在しなければ `None`。重みは負でもよい。`O(V·E)`。",
      "/// Karp の定理を用いる。最小費用流の最適性判定や周期最適化などで使う。",
      "fn 最小平均閉路(頂点数: usize, 辺: &[(usize, usize, i64)]) -> Option<f64> {",
      "    if 頂点数 == 0 {",
      "        return None;",
      "    }",
      "    const INF: i64 = 1 << 60;",
      "    let v = 頂点数;",
      "    let n = v + 1;",
      "    let 始点 = v;",
      "    let mut 全辺 = 辺.to_vec();",
      "    for w in 0..v {",
      "        全辺.push((始点, w, 0));",
      "    }",
      "    let mut d = vec![vec![INF; n]; n + 1];",
      "    d[0][始点] = 0;",
      "    for k in 1..=n {",
      "        let (前, 当) = d.split_at_mut(k);",
      "        let 前 = &前[k - 1];",
      "        let 当 = &mut 当[0];",
      "        for &(a, b, wt) in &全辺 {",
      "            if 前[a] < INF {",
      "                let nd = 前[a] + wt;",
      "                if nd < 当[b] {",
      "                    当[b] = nd;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 最小 = f64::INFINITY;",
      "    for t in 0..n {",
      "        if d[n][t] >= INF {",
      "            continue;",
      "        }",
      "        let mut 最大 = f64::NEG_INFINITY;",
      "        for k in 0..n {",
      "            if d[k][t] >= INF {",
      "                continue;",
      "            }",
      "            let 比 = (d[n][t] - d[k][t]) as f64 / (n - k) as f64;",
      "            if 比 > 最大 {",
      "                最大 = 比;",
      "            }",
      "        }",
      "        if 最大 < 最小 {",
      "            最小 = 最大;",
      "        }",
      "    }",
      "    if 最小.is_infinite() {",
      "        None",
      "    } else {",
      "        Some(最小)",
      "    }",
      "}"
    ]
  },
  "最小_平均_閉路": {
    "scope": "rust",
    "prefix": "最小_平均_閉路",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 有向重み付きグラフの**最小平均閉路**（辺の重み和 ÷ 辺数を最小化する閉路の、その比）を返す。",
      "/// 閉路が存在しなければ `None`。重みは負でもよい。`O(V·E)`。",
      "/// Karp の定理を用いる。最小費用流の最適性判定や周期最適化などで使う。",
      "fn 最小平均閉路(頂点数: usize, 辺: &[(usize, usize, i64)]) -> Option<f64> {",
      "    if 頂点数 == 0 {",
      "        return None;",
      "    }",
      "    const INF: i64 = 1 << 60;",
      "    let v = 頂点数;",
      "    let n = v + 1;",
      "    let 始点 = v;",
      "    let mut 全辺 = 辺.to_vec();",
      "    for w in 0..v {",
      "        全辺.push((始点, w, 0));",
      "    }",
      "    let mut d = vec![vec![INF; n]; n + 1];",
      "    d[0][始点] = 0;",
      "    for k in 1..=n {",
      "        let (前, 当) = d.split_at_mut(k);",
      "        let 前 = &前[k - 1];",
      "        let 当 = &mut 当[0];",
      "        for &(a, b, wt) in &全辺 {",
      "            if 前[a] < INF {",
      "                let nd = 前[a] + wt;",
      "                if nd < 当[b] {",
      "                    当[b] = nd;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 最小 = f64::INFINITY;",
      "    for t in 0..n {",
      "        if d[n][t] >= INF {",
      "            continue;",
      "        }",
      "        let mut 最大 = f64::NEG_INFINITY;",
      "        for k in 0..n {",
      "            if d[k][t] >= INF {",
      "                continue;",
      "            }",
      "            let 比 = (d[n][t] - d[k][t]) as f64 / (n - k) as f64;",
      "            if 比 > 最大 {",
      "                最大 = 比;",
      "            }",
      "        }",
      "        if 最大 < 最小 {",
      "            最小 = 最大;",
      "        }",
      "    }",
      "    if 最小.is_infinite() {",
      "        None",
      "    } else {",
      "        Some(最小)",
      "    }",
      "}"
    ]
  },
  "最小_有向_全域木": {
    "scope": "rust",
    "prefix": "最小_有向_全域木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最小有向全域木（最小全域内向木 / arborescence）の総コストを Chu-Liu/Edmonds 法で求める。",
      "/// 根から全頂点へ到達する有向木のうちコスト最小のもの。O(V·E)。",
      "/// `辺` は `(始点, 終点, コスト)`。根から到達できない頂点があれば `None`。",
      "/// petgraph の `min_spanning_tree` は無向専用なので、有向版が要るときはこれを使う。",
      "fn 最小有向全域木(頂点数: usize, 根: usize, 辺: &[(usize, usize, i64)]) -> Option<i64> {",
      "    const 無限: i64 = i64::MAX;",
      "    let mut n = 頂点数;",
      "    let mut 根 = 根;",
      "    let mut 辺: Vec<(usize, usize, i64)> = 辺.to_vec();",
      "    let mut 合計 = 0i64;",
      "    loop {",
      "        let mut 入コスト = vec![無限; n];",
      "        let mut 入元 = vec![!0; n];",
      "        for &(u, v, w) in &辺 {",
      "            if u != v && w < 入コスト[v] {",
      "                入コスト[v] = w;",
      "                入元[v] = u;",
      "            }",
      "        }",
      "        for (v, &c) in 入コスト.iter().enumerate() {",
      "            if v != 根 && c == 無限 {",
      "                return None;",
      "            }",
      "        }",
      "        let mut id = vec![!0; n];",
      "        let mut 到達済 = vec![!0; n];",
      "        let mut 閉路数 = 0usize;",
      "        #[allow(clippy::needless_range_loop)]",
      "        for v in 0..n {",
      "            if v == 根 {",
      "                continue;",
      "            }",
      "            合計 += 入コスト[v];",
      "            let mut u = v;",
      "            while 到達済[u] != v && id[u] == !0 && u != 根 {",
      "                到達済[u] = v;",
      "                u = 入元[u];",
      "            }",
      "            if u != 根 && id[u] == !0 {",
      "                let mut x = 入元[u];",
      "                while x != u {",
      "                    id[x] = 閉路数;",
      "                    x = 入元[x];",
      "                }",
      "                id[u] = 閉路数;",
      "                閉路数 += 1;",
      "            }",
      "        }",
      "        if 閉路数 == 0 {",
      "            return Some(合計);",
      "        }",
      "        for x in id.iter_mut() {",
      "            if *x == !0 {",
      "                *x = 閉路数;",
      "                閉路数 += 1;",
      "            }",
      "        }",
      "        let mut 新辺 = Vec::new();",
      "        for &(u, v, w) in &辺 {",
      "            if id[u] != id[v] {",
      "                新辺.push((id[u], id[v], w - 入コスト[v]));",
      "            }",
      "        }",
      "        辺 = 新辺;",
      "        n = 閉路数;",
      "        根 = id[根];",
      "    }",
      "}"
    ]
  },
  "最小_点_被覆": {
    "scope": "rust",
    "prefix": "最小_点_被覆",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Kuhn 法で増加路を 1 本探す内部関数。`右相手`・`左相手` を更新する。",
      "fn 増加(",
      "    u: usize,",
      "    グラフ: &[Vec<usize>],",
      "    右相手: &mut [Option<usize>],",
      "    左相手: &mut [Option<usize>],",
      "    到達済: &mut [bool],",
      ") -> bool {",
      "    for &v in &グラフ[u] {",
      "        if 到達済[v] {",
      "            continue;",
      "        }",
      "        到達済[v] = true;",
      "        if 右相手[v].is_none() || 増加(右相手[v].unwrap(), グラフ, 右相手, 左相手, 到達済)",
      "        {",
      "            右相手[v] = Some(u);",
      "            左相手[u] = Some(v);",
      "            return true;",
      "        }",
      "    }",
      "    false",
      "}",
      "/// König の定理の核。最大マッチングを求め、未マッチ左頂点から交互路で到達できる",
      "/// 左集合 `z左` と右集合 `z右` を返す。最小点被覆・最大独立集合の両方の土台。",
      "fn ケーニッヒ核(",
      "    左数: usize, 右数: usize, 辺: &[(usize, usize)]",
      ") -> (Vec<bool>, Vec<bool>) {",
      "    let mut グラフ = vec![Vec::new(); 左数];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "    }",
      "    let mut 右相手: Vec<Option<usize>> = vec![None; 右数];",
      "    let mut 左相手: Vec<Option<usize>> = vec![None; 左数];",
      "    for u in 0..左数 {",
      "        let mut 到達済 = vec![false; 右数];",
      "        増加(u, &グラフ, &mut 右相手, &mut 左相手, &mut 到達済);",
      "    }",
      "    let mut z左 = vec![false; 左数];",
      "    let mut z右 = vec![false; 右数];",
      "    let mut 探索 = Vec::new();",
      "    for (u, &相手) in 左相手.iter().enumerate() {",
      "        if 相手.is_none() {",
      "            z左[u] = true;",
      "            探索.push(u);",
      "        }",
      "    }",
      "    while let Some(u) = 探索.pop() {",
      "        for &v in &グラフ[u] {",
      "            if 左相手[u] == Some(v) || z右[v] {",
      "                continue;",
      "            }",
      "            z右[v] = true;",
      "            if let Some(w) = 右相手[v]",
      "                && !z左[w]",
      "            {",
      "                z左[w] = true;",
      "                探索.push(w);",
      "            }",
      "        }",
      "    }",
      "    (z左, z右)",
      "}",
      "/// König の定理で二部グラフの最小点被覆を求める。`O(V·E)`（内部は Kuhn 法）。",
      "/// 左頂点 `0..左数`・右頂点 `0..右数`、`辺` は `(左, 右)` の列。返り値 `(左被覆, 右被覆)` は",
      "/// 被覆に含める左・右の頂点番号。被覆サイズ `= 最大マッチング数`（König の定理）。",
      "/// マッチングのみの [`hopcroft_karp`](crate::hopcroft_karp) と異なり点被覆を復元する。",
      "fn 二部最小点被覆(",
      "    左数: usize,",
      "    右数: usize,",
      "    辺: &[(usize, usize)],",
      ") -> (Vec<usize>, Vec<usize>) {",
      "    let (z左, z右) = ケーニッヒ核(左数, 右数, 辺);",
      "    let 左被覆: Vec<usize> = (0..左数).filter(|&u| !z左[u]).collect();",
      "    let 右被覆: Vec<usize> = (0..右数).filter(|&v| z右[v]).collect();",
      "    (左被覆, 右被覆)",
      "}"
    ]
  },
  "最小_表現": {
    "scope": "rust",
    "prefix": "最小_表現",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最小回転（Booth のアルゴリズム）。列 `s` の巡回シフトのうち辞書順最小になるものの開始位置を",
      "/// `O(n)` で返す。`s[k..] ++ s[..k]` が最小の回転。空列なら `0`。",
      "/// 文字列の「最小表現（canonical form）」を取って同型判定する用途で頻出。",
      "/// 比較できる任意の要素列に使える。",
      "fn 最小回転<T: Ord>(s: &[T]) -> usize {",
      "    let n = s.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let c = |idx: usize| &s[idx % n];",
      "    let mut f: Vec<i64> = vec![-1; 2 * n];",
      "    let mut k: usize = 0;",
      "    for j in 1..2 * n {",
      "        let sj = c(j);",
      "        let mut i = f[j - k - 1];",
      "        while i != -1 && sj != c(k + i as usize + 1) {",
      "            if sj < c(k + i as usize + 1) {",
      "                k = j - i as usize - 1;",
      "            }",
      "            i = f[i as usize];",
      "        }",
      "        if sj != c(k + (i + 1) as usize) {",
      "            if sj < c(k + (i + 1) as usize) {",
      "                k = j;",
      "            }",
      "            f[j - k] = -1;",
      "        } else {",
      "            f[j - k] = i + 1;",
      "        }",
      "    }",
      "    k",
      "}"
    ]
  },
  "最小_被覆円": {
    "scope": "rust",
    "prefix": "最小_被覆円",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗（浮動小数）。整数座標版は `geometry` の `距離2乗`。",
      "fn 距離2乗f64(a: (f64, f64), b: (f64, f64)) -> f64 {",
      "    let dx = a.0 - b.0;",
      "    let dy = a.1 - b.1;",
      "    dx * dx + dy * dy",
      "}",
      "/// 2 点の中点。",
      "fn 中点(a: (f64, f64), b: (f64, f64)) -> (f64, f64) {",
      "    ((a.0 + b.0) / 2.0, (a.1 + b.1) / 2.0)",
      "}",
      "/// 3 点を通る円の中心（外心）。3 点が一直線上だと数値的に破綻するので注意。",
      "fn 外心(a: (f64, f64), b: (f64, f64), c: (f64, f64)) -> (f64, f64) {",
      "    let (ax, ay) = a;",
      "    let (bx, by) = b;",
      "    let (cx, cy) = c;",
      "    let d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));",
      "    let a2 = ax * ax + ay * ay;",
      "    let b2 = bx * bx + by * by;",
      "    let c2 = cx * cx + cy * cy;",
      "    let ux = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / d;",
      "    let uy = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / d;",
      "    (ux, uy)",
      "}",
      "/// すべての点を含む最小の円 `(中心x, 中心y, 半径)` を求める（Welzl の漸増法）。期待 O(N)。",
      "/// 点が空なら `None`。",
      "fn 最小包含円(点群: &[(f64, f64)]) -> Option<(f64, f64, f64)> {",
      "    const イプシロン: f64 = 1e-12;",
      "    if 点群.is_empty() {",
      "        return None;",
      "    }",
      "    let mut p = 点群.to_vec();",
      "    let mut seed = 0x1234_5678u64;",
      "    let mut 乱数 = || {",
      "        seed = seed",
      "            .wrapping_mul(6364136223846793005)",
      "            .wrapping_add(1442695040888963407);",
      "        seed >> 33",
      "    };",
      "    for i in (1..p.len()).rev() {",
      "        let j = (乱数() as usize) % (i + 1);",
      "        p.swap(i, j);",
      "    }",
      "    let mut 中心 = p[0];",
      "    let mut 半径2 = 0.0f64;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for i in 1..p.len() {",
      "        if 距離2乗f64(中心, p[i]) <= 半径2 + イプシロン {",
      "            continue;",
      "        }",
      "        中心 = p[i];",
      "        半径2 = 0.0;",
      "        for j in 0..i {",
      "            if 距離2乗f64(中心, p[j]) <= 半径2 + イプシロン {",
      "                continue;",
      "            }",
      "            中心 = 中点(p[i], p[j]);",
      "            半径2 = 距離2乗f64(中心, p[i]);",
      "            for k in 0..j {",
      "                if 距離2乗f64(中心, p[k]) <= 半径2 + イプシロン {",
      "                    continue;",
      "                }",
      "                中心 = 外心(p[i], p[j], p[k]);",
      "                半径2 = 距離2乗f64(中心, p[i]);",
      "            }",
      "        }",
      "    }",
      "    Some((中心.0, 中心.1, 半径2.sqrt()))",
      "}"
    ]
  },
  "最小_費用_割当": {
    "scope": "rust",
    "prefix": "最小_費用_割当",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ハンガリアン法（Kuhn–Munkres）で割当問題（最小重み完全マッチング）を解く。`O(n²m)`。",
      "/// `コスト[i][j]` を行 `i`・列 `j` の費用とし、各行に相異なる列を割り当てて総費用を最小化する。",
      "/// 行数 `n <= 列数 m` であること（足りない列があると割り当て不能）。費用は負でもよい。",
      "/// 返り値は `(最小総費用, 割当)`。`割当[i]` は行 `i` に割り当てられた列（0 始まり）。",
      "fn 割当問題(コスト: &[Vec<i64>]) -> (i64, Vec<usize>) {",
      "    let n = コスト.len();",
      "    if n == 0 {",
      "        return (0, Vec::new());",
      "    }",
      "    assert!(",
      "        コスト[0].len() >= n,",
      "        \"ハンガリアン法: 列数は行数以上である必要があります\"",
      "    );",
      "    let 行列 = pathfinding::matrix::Matrix::from_rows(コスト.iter().cloned())",
      "        .expect(\"コストの全行は同じ列数であること\");",
      "    pathfinding::kuhn_munkres::kuhn_munkres_min(&行列)",
      "}"
    ]
  },
  "最小値_直線_追加": {
    "scope": "rust",
    "prefix": "最小値_直線_追加",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Li Chao 木（最小クエリ版）。直線 `y = 傾き·x + 切片` を **任意の順序** で追加でき、",
      "/// あらかじめ与えたクエリ座標群の各点での最小値を O(log) で求める。",
      "/// CHT（[`crate::convex_hull_trick`]）と違い傾きの単調性を要求しない。",
      "/// クエリ座標は `new` に渡したものに限る。最大値が欲しいときは傾き・切片の符号を",
      "/// 反転して入れ、結果を反転する（この実装は直線のみ、線分追加は非対応）。",
      "/// 評価は i64 素のまま行うので `傾き·x + 切片` が i64 に収まる範囲で使うこと。",
      "struct 李超木 {",
      "    xs: Vec<i64>,",
      "    直線: Vec<Option<(i64, i64)>>,",
      "}",
      "impl 李超木 {",
      "    /// クエリで使う x 座標を全て渡して構築する（重複・未ソートで可）。",
      "    /// 座標は任意の整数型の Vec / イテレータでよい（各メソッドの引数も同様）。",
      "    fn new<I>(座標群: I) -> Self",
      "    where",
      "        I: IntoIterator,",
      "        I::Item: TryInto<i64>,",
      "    {",
      "        let mut 座標群: Vec<i64> = 座標群.into_iter().map(to_i64).collect();",
      "        座標群.sort_unstable();",
      "        座標群.dedup();",
      "        if 座標群.is_empty() {",
      "            座標群.push(0);",
      "        }",
      "        let n = 座標群.len();",
      "        Self {",
      "            xs: 座標群,",
      "            直線: vec![None; 4 * n],",
      "        }",
      "    }",
      "    fn 評価(直線: (i64, i64), x: i64) -> i64 {",
      "        直線.0 * x + 直線.1",
      "    }",
      "    /// 直線 `y = 傾き·x + 切片` を追加する。",
      "    fn 直線追加(&mut self, 傾き: impl TryInto<i64>, 切片: impl TryInto<i64>) {",
      "        let n = self.xs.len();",
      "        self.追加内部(1, 0, n, (to_i64(傾き), to_i64(切片)));",
      "    }",
      "    fn 追加内部(&mut self, ノード: usize, lo: usize, hi: usize, mut 新規: (i64, i64)) {",
      "        let m = (lo + hi) / 2;",
      "        let Some(mut 現在) = self.直線[ノード] else {",
      "            self.直線[ノード] = Some(新規);",
      "            return;",
      "        };",
      "        if Self::評価(新規, self.xs[m]) < Self::評価(現在, self.xs[m]) {",
      "            std::mem::swap(&mut 新規, &mut 現在);",
      "            self.直線[ノード] = Some(現在);",
      "        }",
      "        if hi - lo == 1 {",
      "            return;",
      "        }",
      "        if Self::評価(新規, self.xs[lo]) < Self::評価(現在, self.xs[lo]) {",
      "            self.追加内部(2 * ノード, lo, m, 新規);",
      "        } else {",
      "            self.追加内部(2 * ノード + 1, m, hi, 新規);",
      "        }",
      "    }",
      "    /// クエリ座標 `x`（`new` に渡した値のいずれか）における最小値。",
      "    fn 最小値(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        let n = self.xs.len();",
      "        let idx = self.xs.partition_point(|&v| v < x);",
      "        debug_assert!(",
      "            idx < n && self.xs[idx] == x,",
      "            \"李超木: 未登録のクエリ座標 {x}\"",
      "        );",
      "        self.問い合わせ内部(1, 0, n, idx)",
      "    }",
      "    fn 問い合わせ内部(&self, ノード: usize, lo: usize, hi: usize, idx: usize) -> i64 {",
      "        let mut 最小 = self.直線[ノード]",
      "            .map(|l| Self::評価(l, self.xs[idx]))",
      "            .unwrap_or(i64::MAX);",
      "        if hi - lo > 1 {",
      "            let m = (lo + hi) / 2;",
      "            if idx < m {",
      "                最小 = 最小.min(self.問い合わせ内部(2 * ノード, lo, m, idx));",
      "            } else {",
