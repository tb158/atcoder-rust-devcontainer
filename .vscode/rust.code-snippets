  "doubling": {
    "scope": "rust",
    "prefix": "doubling",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ダブリング。「各頂点から1回で進む先」を与えると、任意の頂点から",
      "/// `k` 回進んだ先を O(log k) で求められるよう前処理する。",
      "/// 各頂点の出次数が 1 のグラフ（ファンクショナルグラフ）での「k 個先」、",
      "/// 「同じ写像を k 回適用した結果」などに使う。",
      "struct ダブリング {",
      "    /// `table[j][v]` = `v` から `2^j` 回進んだ先",
      "    table: Vec<Vec<usize>>,",
      "}",
      "impl ダブリング {",
      "    /// `次[v]` = `v` から1回で進む先（`0..次.len()`）。",
      "    /// `最大回数` までのジャンプに対応するテーブルを構築する。O(N log(最大回数))。",
      "    fn new(次: &[usize], 最大回数: usize) -> Self {",
      "        let n = 次.len();",
      "        let log = (usize::BITS - 最大回数.leading_zeros()).max(1) as usize;",
      "        let mut table = vec![vec![0usize; n]; log];",
      "        table[0].copy_from_slice(次);",
      "        for j in 1..log {",
      "            for v in 0..n {",
      "                table[j][v] = table[j - 1][table[j - 1][v]];",
      "            }",
      "        }",
      "        Self { table }",
      "    }",
      "    /// `始点` から `回数` 回進んだ先の頂点を返す。`回数 <= 最大回数` であること。O(log 回数)。",
      "    fn 進む(&self, 始点: usize, mut 回数: usize) -> usize {",
      "        let mut v = 始点;",
      "        let mut j = 0;",
      "        while 回数 > 0 {",
      "            if 回数 & 1 == 1 {",
      "                v = self.table[j][v];",
      "            }",
      "            回数 >>= 1;",
      "            j += 1;",
      "        }",
      "        v",
      "    }",
      "    /// `始点` から進み続け、到達頂点が `条件` を満たす限り進めるだけ進んだ回数を返す。O(log)。",
      "    /// `条件` は経路上で単調（一度偽になったら以降ずっと偽）であることが前提。",
      "    /// 添字が単調増加する遷移（次がより大きい添字を指す）で「上限以下に留まれる最大回数」などに使う。",
      "    /// 例: `d.進める回数(始点, |v| v <= 上限)`。返り値はそのまま [`進む`](Self::進む) に渡せる。",
      "    fn 進める回数(&self, 始点: usize, mut 条件: impl FnMut(usize) -> bool) -> usize {",
      "        let mut 現在 = 始点;",
      "        let mut 回数 = 0;",
      "        for j in (0..self.table.len()).rev() {",
      "            let 行先 = self.table[j][現在];",
      "            if 条件(行先) {",
      "                回数 += 1 << j;",
      "                現在 = 行先;",
      "            }",
      "        }",
      "        回数",
      "    }",
      "}"
    ]
  },
  "gcd_畳み込み": {
    "scope": "rust",
    "prefix": "gcd_畳み込み",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `2..n` の素数一覧を篩で求める内部関数（各ゼータ／メビウス変換で共有）。",
      "fn 素数リスト(n: usize) -> Vec<usize> {",
      "    let mut 合成 = vec![false; n];",
      "    let mut 素数 = Vec::new();",
      "    for p in 2..n {",
      "        if !合成[p] {",
      "            素数.push(p);",
      "            let mut q = p * p;",
      "            while q < n {",
      "                合成[q] = true;",
      "                q += p;",
      "            }",
      "        }",
      "    }",
      "    素数",
      "}",
      "/// 倍数方向のゼータ変換。`f[i]` を `Σ_{i | j, j < n} f[j]`（倍数についての総和）へ in-place 変換する。",
      "/// 添字は `1..n`（`f[0]` は使わない）。逆変換は [`倍数メビウス変換`]。`O(n log log n)`。",
      "/// 要素型は加算できれば何でもよい（i64 / usize / f64 / ModInt など）。",
      "fn 倍数ゼータ変換<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    for &p in &素数リスト(n) {",
      "        let mut i = (n - 1) / p;",
      "        while i >= 1 {",
      "            f[i] += f[i * p];",
      "            i -= 1;",
      "        }",
      "    }",
      "}",
      "/// [`倍数ゼータ変換`] の逆。`Σ_{i | j} f[j]` から元の `f` を復元する。`O(n log log n)`。",
      "fn 倍数メビウス変換<T: Copy + std::ops::SubAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    for &p in &素数リスト(n) {",
      "        let mut i = 1;",
      "        while i * p < n {",
      "            f[i] -= f[i * p];",
      "            i += 1;",
      "        }",
      "    }",
      "}",
      "/// GCD 畳み込み。`h[k] = Σ_{gcd(i, j) = k} f[i]·g[j]` を `O(n log log n)` で返す（添字 `1..n`、`h[0] = 0`）。",
      "/// 「gcd がちょうど `k` になる組の数え上げ」などに使う。",
      "/// 要素型は加減乗できれば何でもよい（i64 / ModInt など。MOD 付き数え上げは ModInt をそのまま渡す）。",
      "fn gcd畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::SubAssign + std::ops::MulAssign,",
      "{",
      "    assert_eq!(f.len(), g.len());",
      "    let mut a = f.to_vec();",
      "    let mut b = g.to_vec();",
      "    倍数ゼータ変換(&mut a);",
      "    倍数ゼータ変換(&mut b);",
      "    a.iter_mut().zip(&b).for_each(|(x, y)| *x *= *y);",
      "    倍数メビウス変換(&mut a);",
      "    if !a.is_empty() {",
      "        a[0] = T::default();",
      "    }",
      "    a",
      "}"
    ]
  },
