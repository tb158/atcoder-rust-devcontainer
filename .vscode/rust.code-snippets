  "オイラー_路": {
    "scope": "rust",
    "prefix": "オイラー_路",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 有向グラフのオイラー路（全ての辺をちょうど 1 回ずつ通る路）を Hierholzer 法で求める。",
      "/// 再帰なし、O(V + E)。",
      "/// `頂点数` は頂点数、`辺` は `(from, to)` の列。存在すれば通過頂点列（長さ `辺数 + 1`）を返し、",
      "/// 存在しなければ `None`。オイラー閉路の場合は始点と終点が一致する列になる。",
      "/// 存在条件: 辺を持つ頂点が連結で、各頂点の `出次数 - 入次数` が",
      "/// 「全て 0（閉路）」または「始点だけ +1・終点だけ -1・他 0（路）」であること。",
      "fn オイラー路_有向(頂点数: usize, 辺: &[(usize, usize)]) -> Option<Vec<usize>> {",
      "    let m = 辺.len();",
      "    if m == 0 {",
      "        return None;",
      "    }",
      "    let mut 出辺: Vec<Vec<usize>> = vec![vec![]; 頂点数];",
      "    let mut 出次数 = vec![0i64; 頂点数];",
      "    let mut 入次数 = vec![0i64; 頂点数];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        出辺[u].push(i);",
      "        出次数[u] += 1;",
      "        入次数[v] += 1;",
      "    }",
      "    let mut 始点 = !0;",
      "    let mut 始点候補数 = 0;",
      "    let mut 終点候補数 = 0;",
      "    for v in 0..頂点数 {",
      "        match 出次数[v] - 入次数[v] {",
      "            0 => {}",
      "            1 => {",
      "                始点候補数 += 1;",
      "                始点 = v;",
      "            }",
      "            -1 => 終点候補数 += 1,",
      "            _ => return None,",
      "        }",
      "    }",
      "    let 閉路 = 始点候補数 == 0 && 終点候補数 == 0;",
      "    if !(閉路 || (始点候補数 == 1 && 終点候補数 == 1)) {",
      "        return None;",
      "    }",
      "    if 始点 == !0 {",
      "        始点 = (0..頂点数).find(|&v| 出次数[v] > 0)?;",
      "    }",
      "    let mut 次に見る = vec![0usize; 頂点数];",
      "    let mut 探索 = vec![始点];",
      "    let mut 経路 = Vec::with_capacity(m + 1);",
      "    while let Some(&now) = 探索.last() {",
      "        if 次に見る[now] < 出辺[now].len() {",
      "            let e = 出辺[now][次に見る[now]];",
      "            次に見る[now] += 1;",
      "            探索.push(辺[e].1);",
      "        } else {",
      "            経路.push(now);",
      "            探索.pop();",
      "        }",
      "    }",
      "    経路.reverse();",
      "    if 経路.len() == m + 1 {",
      "        Some(経路)",
      "    } else {",
      "        None",
      "    }",
      "}"
    ]
  },
  "オイラー_閉路": {
    "scope": "rust",
    "prefix": "オイラー_閉路",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 有向グラフのオイラー路（全ての辺をちょうど 1 回ずつ通る路）を Hierholzer 法で求める。",
      "/// 再帰なし、O(V + E)。",
      "/// `頂点数` は頂点数、`辺` は `(from, to)` の列。存在すれば通過頂点列（長さ `辺数 + 1`）を返し、",
      "/// 存在しなければ `None`。オイラー閉路の場合は始点と終点が一致する列になる。",
      "/// 存在条件: 辺を持つ頂点が連結で、各頂点の `出次数 - 入次数` が",
      "/// 「全て 0（閉路）」または「始点だけ +1・終点だけ -1・他 0（路）」であること。",
      "fn オイラー路_有向(頂点数: usize, 辺: &[(usize, usize)]) -> Option<Vec<usize>> {",
      "    let m = 辺.len();",
      "    if m == 0 {",
      "        return None;",
      "    }",
      "    let mut 出辺: Vec<Vec<usize>> = vec![vec![]; 頂点数];",
      "    let mut 出次数 = vec![0i64; 頂点数];",
      "    let mut 入次数 = vec![0i64; 頂点数];",
      "    for (i, &(u, v)) in 辺.iter().enumerate() {",
      "        出辺[u].push(i);",
      "        出次数[u] += 1;",
      "        入次数[v] += 1;",
      "    }",
      "    let mut 始点 = !0;",
      "    let mut 始点候補数 = 0;",
      "    let mut 終点候補数 = 0;",
      "    for v in 0..頂点数 {",
      "        match 出次数[v] - 入次数[v] {",
      "            0 => {}",
      "            1 => {",
      "                始点候補数 += 1;",
      "                始点 = v;",
      "            }",
      "            -1 => 終点候補数 += 1,",
      "            _ => return None,",
      "        }",
      "    }",
      "    let 閉路 = 始点候補数 == 0 && 終点候補数 == 0;",
      "    if !(閉路 || (始点候補数 == 1 && 終点候補数 == 1)) {",
      "        return None;",
      "    }",
      "    if 始点 == !0 {",
      "        始点 = (0..頂点数).find(|&v| 出次数[v] > 0)?;",
      "    }",
      "    let mut 次に見る = vec![0usize; 頂点数];",
      "    let mut 探索 = vec![始点];",
      "    let mut 経路 = Vec::with_capacity(m + 1);",
      "    while let Some(&now) = 探索.last() {",
      "        if 次に見る[now] < 出辺[now].len() {",
      "            let e = 出辺[now][次に見る[now]];",
      "            次に見る[now] += 1;",
      "            探索.push(辺[e].1);",
      "        } else {",
      "            経路.push(now);",
      "            探索.pop();",
      "        }",
      "    }",
      "    経路.reverse();",
      "    if 経路.len() == m + 1 {",
      "        Some(経路)",
      "    } else {",
      "        None",
      "    }",
      "}"
    ]
  },
  "オイラーの_φ_関数": {
    "scope": "rust",
    "prefix": "オイラーの_φ_関数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// オイラーのφ関数 φ(n)：`1..=n` のうち `n` と互いに素な整数の個数。O(√n)。",
      "/// 多くの `n` について一括で欲しいときは [`オイラーのファイ表`] を使う。",
      "fn オイラーのファイ(mut n: u64) -> u64 {",
      "    let mut 結果 = n;",
      "    let mut p = 2u64;",
      "    while p * p <= n {",
      "        if n % p == 0 {",
      "            while n % p == 0 {",
      "                n /= p;",
      "            }",
      "            結果 -= 結果 / p;",
      "        }",
      "        p += 1;",
      "    }",
      "    if n > 1 {",
      "        結果 -= 結果 / n;",
      "    }",
      "    結果",
      "}",
      "/// `0..=n` の各 `i` について φ(i) を入れた配列を篩で前計算する。O(n log log n)。",
      "/// `表[0] = 0`、`表[1] = 1`。",
      "fn オイラーのファイ表(n: usize) -> Vec<u64> {",
      "    let mut 表: Vec<u64> = (0..=n as u64).collect();",
      "    for i in 2..=n {",
      "        if 表[i] == i as u64 {",
      "            let mut j = i;",
      "            while j <= n {",
      "                表[j] -= 表[j] / i as u64;",
      "                j += i;",
      "            }",
      "        }",
      "    }",
      "    表",
      "}"
    ]
  },
