  "点_P": {
    "scope": "rust",
    "prefix": "点_P",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "#[proconio::derive_readable]",
      "/// 2次元の格子点/ベクトル。`input! { p: P }` や `input! { ps: [P; n] }` で直接読める。",
      "/// 座標は `i64` 固定。",
      "/// 積を取るメソッド（内積・外積・ノルム2乗など）は座標の絶対値が 2×10^9 以下で安全。",
      "#[derive(Default, Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]",
      "struct P {",
      "    x: i64,",
      "    y: i64,",
      "}",
      "impl P {",
      "    /// 内積 `self・other = x1*x2 + y1*y2`。",
      "    fn 内積(self, other: P) -> i64 {",
      "        self.x * other.x + self.y * other.y",
      "    }",
      "    /// 外積 `self×other = x1*y2 - y1*x2`。",
      "    /// 符号: 正 → other は self の反時計回り側、負 → 時計回り側、0 → 平行。",
      "    fn 外積(self, other: P) -> i64 {",
      "        self.x * other.y - self.y * other.x",
      "    }",
      "    /// ノルムの2乗 `|self|^2`（整数のまま比較したいとき用）。",
      "    fn ノルム2乗(self) -> i64 {",
      "        self.内積(self)",
      "    }",
      "    /// ユークリッドノルム `|self|`（f64）。",
      "    fn ノルム(self) -> f64 {",
      "        (self.ノルム2乗() as f64).sqrt()",
      "    }",
      "    /// other との距離の2乗（整数のまま比較したいとき用）。",
      "    fn 距離2乗(self, other: P) -> i64 {",
      "        (self - other).ノルム2乗()",
      "    }",
      "    /// other とのユークリッド距離（f64）。",
      "    fn 距離(self, other: P) -> f64 {",
      "        (self - other).ノルム()",
      "    }",
      "    /// other とのマンハッタン距離 `|dx| + |dy|`。",
      "    fn マンハッタン距離(self, other: P) -> i64 {",
      "        (self.x - other.x).abs() + (self.y - other.y).abs()",
      "    }",
      "    /// other とのチェビシェフ距離 `max(|dx|, |dy|)`。",
      "    fn チェビシェフ距離(self, other: P) -> i64 {",
      "        (self.x - other.x).abs().max((self.y - other.y).abs())",
      "    }",
      "    /// 原点中心に反時計回り 90 度回転した点。",
      "    fn 回転90(self) -> P {",
      "        P {",
      "            x: -self.y,",
      "            y: self.x,",
      "        }",
      "    }",
      "    /// x 軸正方向からの偏角（ラジアン、`(-π, π]`）。",
      "    fn 偏角(self) -> f64 {",
      "        (self.y as f64).atan2(self.x as f64)",
      "    }",
      "}",
      "impl std::ops::Add for P {",
      "    type Output = P;",
      "    fn add(self, other: P) -> P {",
      "        P {",
      "            x: self.x + other.x,",
      "            y: self.y + other.y,",
      "        }",
      "    }",
      "}",
      "impl std::ops::Sub for P {",
      "    type Output = P;",
      "    fn sub(self, other: P) -> P {",
      "        P {",
      "            x: self.x - other.x,",
      "            y: self.y - other.y,",
      "        }",
      "    }",
      "}",
      "impl std::ops::Neg for P {",
      "    type Output = P;",
      "    fn neg(self) -> P {",
      "        P {",
      "            x: -self.x,",
      "            y: -self.y,",
      "        }",
      "    }",
      "}",
      "impl std::ops::Mul<i64> for P {",
      "    type Output = P;",
      "    fn mul(self, k: i64) -> P {",
      "        P {",
      "            x: self.x * k,",
      "            y: self.y * k,",
      "        }",
      "    }",
      "}"
    ]
  },
  "点と_直線の_距離": {
    "scope": "rust",
    "prefix": "点と_直線の_距離",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 点 `p` と、点 `a`・`b` を通る直線との距離。`O(1)`。`a == b` のときは点 `a` との距離。",
      "fn 点と直線の距離(p: 点, a: 点, b: 点) -> f64 {",
      "    let dx = b.0 - a.0;",
      "    let dy = b.1 - a.1;",
      "    let 長2 = dx * dx + dy * dy;",
      "    if 長2 == 0.0 {",
      "        return (p.0 - a.0).hypot(p.1 - a.1);",
      "    }",
      "    ((dx * (p.1 - a.1) - dy * (p.0 - a.0)).abs()) / 長2.sqrt()",
      "}",
      "/// 点 `p` と線分 `[a, b]` との最短距離。`O(1)`。",
      "/// `p` の射影が線分内に落ちれば垂線の長さ、外れれば近い方の端点との距離。",
      "fn 点と線分の距離(p: 点, a: 点, b: 点) -> f64 {",
      "    let dx = b.0 - a.0;",
      "    let dy = b.1 - a.1;",
      "    let 長2 = dx * dx + dy * dy;",
      "    if 長2 == 0.0 {",
      "        return (p.0 - a.0).hypot(p.1 - a.1);",
      "    }",
      "    let t = ((p.0 - a.0) * dx + (p.1 - a.1) * dy) / 長2;",
      "    let tc = t.clamp(0.0, 1.0);",
      "    let fx = a.0 + tc * dx;",
      "    let fy = a.1 + tc * dy;",
      "    (p.0 - fx).hypot(p.1 - fy)",
      "}"
    ]
  },
  "点と_線分の_距離": {
    "scope": "rust",
    "prefix": "点と_線分の_距離",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 点 `p` と、点 `a`・`b` を通る直線との距離。`O(1)`。`a == b` のときは点 `a` との距離。",
      "fn 点と直線の距離(p: 点, a: 点, b: 点) -> f64 {",
      "    let dx = b.0 - a.0;",
      "    let dy = b.1 - a.1;",
      "    let 長2 = dx * dx + dy * dy;",
      "    if 長2 == 0.0 {",
      "        return (p.0 - a.0).hypot(p.1 - a.1);",
      "    }",
      "    ((dx * (p.1 - a.1) - dy * (p.0 - a.0)).abs()) / 長2.sqrt()",
      "}",
      "/// 点 `p` と線分 `[a, b]` との最短距離。`O(1)`。",
      "/// `p` の射影が線分内に落ちれば垂線の長さ、外れれば近い方の端点との距離。",
      "fn 点と線分の距離(p: 点, a: 点, b: 点) -> f64 {",
      "    let dx = b.0 - a.0;",
      "    let dy = b.1 - a.1;",
      "    let 長2 = dx * dx + dy * dy;",
      "    if 長2 == 0.0 {",
      "        return (p.0 - a.0).hypot(p.1 - a.1);",
      "    }",
      "    let t = ((p.0 - a.0) * dx + (p.1 - a.1) * dy) / 長2;",
      "    let tc = t.clamp(0.0, 1.0);",
      "    let fx = a.0 + tc * dx;",
      "    let fy = a.1 + tc * dy;",
      "    (p.0 - fx).hypot(p.1 - fy)",
      "}",
      "/// 線分 `[a, b]` と線分 `[c, d]` の最短距離。`O(1)`。交差していれば `0`。",
      "fn 線分と線分の距離(a: 点, b: 点, c: 点, d: 点) -> f64 {",
      "    let 外積 = |o: 点, x: 点, y: 点| (x.0 - o.0) * (y.1 - o.1) - (x.1 - o.1) * (y.0 - o.0);",
      "    let d1 = 外積(c, d, a);",
      "    let d2 = 外積(c, d, b);",
      "    let d3 = 外積(a, b, c);",
      "    let d4 = 外積(a, b, d);",
      "    if d1 * d2 < 0.0 && d3 * d4 < 0.0 {",
      "        return 0.0;",
      "    }",
      "    点と線分の距離(a, c, d)",
      "        .min(点と線分の距離(b, c, d))",
      "        .min(点と線分の距離(c, a, b))",
      "        .min(点と線分の距離(d, a, b))",
      "}"
    ]
  },
  "点の_内外": {
    "scope": "rust",
    "prefix": "点の_内外",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 点が多角形の内部・境界・外部のどれにあるかを整数演算のみで判定する。O(N)。",
      "/// `2` = 内部、`1` = 境界上、`0` = 外部。凸でない単純多角形にも使える（射影法／レイキャスティング）。",
      "fn 点の内外(多角形: &[(i64, i64)], 点: (i64, i64)) -> i32 {",
      "    let n = 多角形.len();",
      "    let (px, py) = 点;",
      "    let mut 内 = false;",
      "    for i in 0..n {",
      "        let (xi, yi) = 多角形[i];",
      "        let (xj, yj) = 多角形[(i + 1) % n];",
      "        let 外積 = (xj - xi) * (py - yi) - (yj - yi) * (px - xi);",
      "        if 外積 == 0 && (px - xi) * (px - xj) <= 0 && (py - yi) * (py - yj) <= 0 {",
      "            return 1;",
      "        }",
      "        if (yi > py) != (yj > py) {",
      "            let 左 = if yj - yi > 0 { 外積 > 0 } else { 外積 < 0 };",
      "            if 左 {",
      "                内 = !内;",
      "            }",
      "        }",
      "    }",
      "    if 内 {",
      "        2",
      "    } else {",
      "        0",
      "    }",
      "}"
    ]
  },
  "無向_グラフ": {
    "scope": "rust",
    "prefix": "無向_グラフ",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}"
    ]
  },
  "無向_最小_カット": {
    "scope": "rust",
    "prefix": "無向_最小_カット",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向重み付きグラフの**全域最小カット**（global minimum cut）を Stoer–Wagner 法で求める。",
      "/// 始点・終点を指定せず「頂点集合を空でない 2 つに分ける切断のうち、またぐ辺の重み和が最小のもの」を返す。",
      "/// `n` 頂点、`辺` は `(u, v, 重み)` の無向辺（重み非負、多重辺は加算、自己ループは無視）。計算量 `O(n^3)`。",
      "/// `ac_library` の `maxflow` は s–t 間の最小カット専用で、全ペアを試さずに大域最小カットを出すのはこちら。",
      "/// `n <= 1` のときは `0` を返す。",
      "fn 全域最小カット(n: usize, 辺: &[(usize, usize, i64)]) -> i64 {",
      "    if n <= 1 {",
      "        return 0;",
      "    }",
      "    let mut グラフ = vec![vec![0i64; n]; n];",
      "    for &(u, v, w) in 辺 {",
      "        if u != v {",
      "            グラフ[u][v] += w;",
      "            グラフ[v][u] += w;",
      "        }",
      "    }",
      "    let mut 最良 = i64::MAX;",
      "    let mut 頂点: Vec<usize> = (0..n).collect();",
      "    while 頂点.len() > 1 {",
      "        let m = 頂点.len();",
      "        let mut 接続重み = vec![0i64; n];",
      "        let mut 取込済 = vec![false; n];",
      "        let mut 順序 = Vec::with_capacity(m);",
      "        for _ in 0..m {",
      "            let mut 選 = !0;",
      "            for &v in &頂点 {",
      "                if !取込済[v] && (選 == !0 || 接続重み[v] > 接続重み[選]) {",
      "                    選 = v;",
      "                }",
      "            }",
      "            取込済[選] = true;",
      "            順序.push(選);",
      "            for &v in &頂点 {",
      "                if !取込済[v] {",
      "                    接続重み[v] += グラフ[選][v];",
      "                }",
      "            }",
      "        }",
      "        let t = 順序[m - 1];",
      "        let s = 順序[m - 2];",
      "        最良 = 最良.min(接続重み[t]);",
      "        for &v in &頂点 {",
      "            グラフ[s][v] += グラフ[t][v];",
      "            グラフ[v][s] += グラフ[v][t];",
      "        }",
      "        頂点.retain(|&x| x != t);",
      "    }",
      "    最良",
      "}"
    ]
  },
  "無限_ナップサック": {
    "scope": "rust",
    "prefix": "無限_ナップサック",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 個数制限なしナップサック。各品物を何個でも選べる版。O(N·容量)。",
      "fn 個数制限なしナップサック(品物: &[(usize, i64)], 容量: usize) -> i64 {",
      "    let mut dp = vec![0i64; 容量 + 1];",
      "    for &(重さ, 価値) in 品物 {",
      "        for w in 重さ..=容量 {",
      "            dp[w] = dp[w].max(dp[w - 重さ] + 価値);",
      "        }",
      "    }",
      "    dp[容量]",
      "}"
    ]
  },
  "燃やす_埋める": {
    "scope": "rust",
    "prefix": "燃やす_埋める",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最大重み閉包問題（Project Selection／いわゆる「燃やす埋める」）。",
      "/// 各要素に整数重み `w_i`（負も可）があり、「要素 `i` を選ぶなら `j` も必ず選ぶ」という依存",
      "/// （有向辺 `i→j`）が課されている。依存を満たす部分集合 `S`（`i∈S ⇒ j∈S`）のうち重み総和",
      "/// `Σ_{i∈S} w_i` を最大にするものを求める。空集合も選択可能なので答えは常に `0` 以上。",
      "/// 内部で最小カット（[`ac_library::MfGraph`] の Dinic）へ帰着する。",
      "struct 最大重み閉包 {",
      "    重み: Vec<i64>,",
      "    依存: Vec<(usize, usize)>,",
      "}",
      "impl 最大重み閉包 {",
      "    /// 各要素の重み（負も可）を与えて初期化する。",
      "    fn new(重み: Vec<i64>) -> Self {",
      "        最大重み閉包 {",
      "            重み,",
      "            依存: Vec::new(),",
      "        }",
      "    }",
      "    /// 依存「要素 `i` を選ぶなら `j` も選ぶ」を追加する。",
      "    fn 依存追加(&mut self, i: usize, j: usize) {",
      "        assert!(i < self.重み.len() && j < self.重み.len());",
      "        self.依存.push((i, j));",
      "    }",
      "    /// 最大重みと、それを達成する選択集合 `選択[i]` を返す。`O(最大流)`。",
      "    fn 解く(&self) -> (i64, Vec<bool>) {",
      "        use ac_library::MfGraph;",
      "        const INF: i64 = 1 << 60;",
      "        let n = self.重み.len();",
      "        let (源, 匯) = (n, n + 1);",
      "        let mut g = MfGraph::<i64>::new(n + 2);",
      "        let mut 正の和 = 0i64;",
      "        for (i, &w) in self.重み.iter().enumerate() {",
      "            if w > 0 {",
      "                g.add_edge(源, i, w);",
      "                正の和 += w;",
      "            } else if w < 0 {",
      "                g.add_edge(i, 匯, -w);",
      "            }",
      "        }",
      "        for &(i, j) in &self.依存 {",
      "            g.add_edge(i, j, INF);",
      "        }",
      "        let カット = g.flow(源, 匯);",
      "        let 到達 = g.min_cut(源);",
      "        let 選択 = (0..n).map(|i| 到達[i]).collect();",
      "        (正の和 - カット, 選択)",
      "    }",
      "}"
    ]
  },
  "版管理_セグ木": {
    "scope": "rust",
    "prefix": "版管理_セグ木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 永続セグメント木（区間和・一点加算）。各更新は元の版を壊さず新しい根を返すため、",
      "/// 任意の過去の版に対してクエリできる。更新・クエリともに O(log N)、版ごとに O(log N) のノード。",
      "/// 配列を 1 要素ずつ更新した版列を作れば「区間第 k 小」等の典型に使える",
      "/// （単純な静的列の区間第 k 小なら [`crate::wavelet_matrix`] が手軽）。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "struct 永続セグ木<T> {",
      "    n: usize,",
      "    和: Vec<T>,",
      "    左: Vec<usize>,",
      "    右: Vec<usize>,",
      "}",
      "impl<T> 永続セグ木<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    /// サイズ `n` の全 0 の木を作り、`(構造体, 初期版の根)` を返す。",
      "    fn new(n: usize) -> (Self, usize) {",
      "        let mut t = Self {",
      "            n,",
      "            和: vec![T::default()],",
      "            左: vec![0],",
      "            右: vec![0],",
      "        };",
      "        let 根 = t.構築(0, n.max(1));",
      "        (t, 根)",
      "    }",
      "    fn 節点追加(&mut self, 和: T, 左: usize, 右: usize) -> usize {",
      "        let id = self.和.len();",
      "        self.和.push(和);",
      "        self.左.push(左);",
      "        self.右.push(右);",
      "        id",
      "    }",
      "    fn 構築(&mut self, lo: usize, hi: usize) -> usize {",
      "        if hi - lo <= 1 {",
      "            return self.節点追加(T::default(), 0, 0);",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        let l = self.構築(lo, m);",
      "        let r = self.構築(m, hi);",
      "        self.節点追加(T::default(), l, r)",
      "    }",
      "    /// 版 `根` の位置 `pos` に `値` を加え、新しい版の根を返す。元の版は不変。",
      "    fn 一点加算(&mut self, 根: usize, pos: usize, 値: T) -> usize {",
      "        let n = self.n.max(1);",
      "        self.更新(根, 0, n, pos, 値)",
      "    }",
      "    fn 更新(&mut self, 節: usize, lo: usize, hi: usize, pos: usize, 値: T) -> usize {",
      "        if hi - lo <= 1 {",
      "            return self.節点追加(self.和[節] + 値, 0, 0);",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        if pos < m {",
      "            let nl = self.更新(self.左[節], lo, m, pos, 値);",
      "            self.節点追加(self.和[節] + 値, nl, self.右[節])",
      "        } else {",
      "            let nr = self.更新(self.右[節], m, hi, pos, 値);",
      "            self.節点追加(self.和[節] + 値, self.左[節], nr)",
      "        }",
      "    }",
      "    /// 版 `根` における区間（`a..b` / `a..=b` / `..` など）の和。",
      "    fn 区間和(&self, 根: usize, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.n);",
      "        self.和取得(根, 0, self.n.max(1), l, r)",
      "    }",
      "    fn 和取得(&self, 節: usize, lo: usize, hi: usize, l: usize, r: usize) -> T {",
      "        if r <= lo || hi <= l {",
      "            return T::default();",
      "        }",
      "        if l <= lo && hi <= r {",
      "            return self.和[節];",
      "        }",
      "        let m = (lo + hi) / 2;",
      "        self.和取得(self.左[節], lo, m, l, r) + self.和取得(self.右[節], m, hi, l, r)",
      "    }",
      "}"
    ]
  },
  "畳み込み_FFT": {
    "scope": "rust",
    "prefix": "畳み込み_FFT",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use num::complex::Complex64;",
      "/// 複素 FFT（反復版）。`逆 = true` で逆変換。`a.len()` は 2 冪であること。内部関数。",
      "fn fft内部(a: &mut [Complex64], 逆: bool) {",
      "    let n = a.len();",
      "    if n <= 1 {",
      "        return;",
      "    }",
      "    let mut j = 0usize;",
      "    for i in 1..n {",
      "        let mut bit = n >> 1;",
      "        while j & bit != 0 {",
      "            j ^= bit;",
      "            bit >>= 1;",
      "        }",
      "        j |= bit;",
      "        if i < j {",
      "            a.swap(i, j);",
      "        }",
      "    }",
      "    let mut len = 2;",
      "    while len <= n {",
      "        let 符号 = if 逆 { -1.0 } else { 1.0 };",
      "        let 角度 = 2.0 * std::f64::consts::PI / len as f64 * 符号;",
      "        let w_len = Complex64::new(角度.cos(), 角度.sin());",
      "        let mut i = 0;",
      "        while i < n {",
      "            let mut w = Complex64::new(1.0, 0.0);",
      "            for k in 0..len / 2 {",
      "                let u = a[i + k];",
      "                let v = a[i + k + len / 2] * w;",
      "                a[i + k] = u + v;",
      "                a[i + k + len / 2] = u - v;",
      "                w *= w_len;",
      "            }",
      "            i += len;",
      "        }",
      "        len <<= 1;",
      "    }",
      "    if 逆 {",
      "        let 逆数 = 1.0 / n as f64;",
      "        for x in a.iter_mut() {",
      "            *x *= 逆数;",
      "        }",
      "    }",
      "}",
      "/// 整数列 `a`, `b` の畳み込み（多項式の積の係数）を FFT で求める。O(M log M)。",
      "/// 返り値の長さは `a.len() + b.len() - 1`。`ac_library::convolution` は素数 mod 専用なので、",
      "/// mod を取らない素直な整数畳み込みが要るときにこちらを使う。値が大きいと `f64` 精度で",
      "/// 誤差が出る点に注意（おおむね 結果の各項 < 2^52 まで安全）。",
      "fn 畳み込み(a: &[i64], b: &[i64]) -> Vec<i64> {",
      "    if a.is_empty() || b.is_empty() {",
      "        return Vec::new();",
      "    }",
      "    let 結果長 = a.len() + b.len() - 1;",
      "    let mut サイズ = 1usize;",
      "    while サイズ < 結果長 {",
      "        サイズ <<= 1;",
      "    }",
      "    let mut fa: Vec<Complex64> = (0..サイズ)",
      "        .map(|i| Complex64::new(*a.get(i).unwrap_or(&0) as f64, 0.0))",
      "        .collect();",
      "    let mut fb: Vec<Complex64> = (0..サイズ)",
      "        .map(|i| Complex64::new(*b.get(i).unwrap_or(&0) as f64, 0.0))",
      "        .collect();",
      "    fft内部(&mut fa, false);",
      "    fft内部(&mut fb, false);",
      "    for (x, y) in fa.iter_mut().zip(fb.iter()) {",
      "        *x *= *y;",
      "    }",
      "    fft内部(&mut fa, true);",
      "    fa.iter()",
      "        .take(結果長)",
      "        .map(|c| c.re.round() as i64)",
      "        .collect()",
      "}"
    ]
  },
  "畳み込み_任意_mod": {
    "scope": "rust",
    "prefix": "畳み込み_任意_mod",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, inv_mod, ButterflyCache, Modulus, StaticModInt};",
      "use std::cell::RefCell;",
      "use std::thread::LocalKey;",
      "/// NTT 素数 1: `167772161 = 5·2^25 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法1 {}",
      "impl Modulus for 法1 {",
      "    const VALUE: u32 = 167_772_161;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法1 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// NTT 素数 2: `469762049 = 7·2^26 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法2 {}",
      "impl Modulus for 法2 {",
      "    const VALUE: u32 = 469_762_049;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法2 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// NTT 素数 3: `1224736769 = 73·2^24 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法3 {}",
      "impl Modulus for 法3 {",
      "    const VALUE: u32 = 1_224_736_769;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法3 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// 1 つの NTT 素数 `M` 上で `a * b`（係数を `法` で還元したもの）を畳み込む。",
      "fn 単一畳み込み<M: Modulus>(a: &[u64], b: &[u64], 法: u64) -> Vec<u64> {",
      "    let fa: Vec<StaticModInt<M>> = a.iter().map(|&x| StaticModInt::new(x % 法)).collect();",
      "    let fb: Vec<StaticModInt<M>> = b.iter().map(|&x| StaticModInt::new(x % 法)).collect();",
      "    convolution(&fa, &fb)",
      "        .iter()",
      "        .map(|x| x.val() as u64)",
      "        .collect()",
      "}",
      "/// 任意の法 `法` での畳み込み `c[k] = Σ_i a[i]·b[k-i] mod 法`。O(n log n)。",
      "/// 3 つの NTT 素数で畳み込み、Garner（CRT）で厳密値を復元してから `法` を取る。",
      "/// `法` と係数が ~2·10^9 未満なら正しい（厳密値が 3 素数の積 ≈ 9.6·10^25 に収まる範囲）。",
      "/// mod が NTT 素数（998244353 等）なら `ac_library::convolution` の方が速い。",
      "fn 任意mod畳み込み(",
      "    a: &[impl TryInto<u64> + Copy],",
      "    b: &[impl TryInto<u64> + Copy],",
      "    法: impl TryInto<u64>,",
      ") -> Vec<usize> {",
      "    let a: Vec<u64> = a",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"任意mod畳み込み: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let b: Vec<u64> = b",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"任意mod畳み込み: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let (a, b) = (&a[..], &b[..]);",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"任意mod畳み込み: 引数が u64 に収まりません\");",
      "    if a.is_empty() || b.is_empty() {",
      "        return Vec::new();",
      "    }",
      "    let p1 = 法1::VALUE as i128;",
      "    let p2 = 法2::VALUE as i128;",
      "    let p3 = 法3::VALUE as i128;",
      "    let r1 = 単一畳み込み::<法1>(a, b, 法);",
      "    let r2 = 単一畳み込み::<法2>(a, b, 法);",
      "    let r3 = 単一畳み込み::<法3>(a, b, 法);",
      "    let inv_p1_mod_p2 = inv_mod(p1 as i64, p2 as i64) as i128;",
      "    let inv_p1p2_mod_p3 = inv_mod((p1 * p2 % p3) as i64, p3 as i64) as i128;",
      "    let 法i = 法 as i128;",
      "    (0..r1.len())",
      "        .map(|i| {",
      "            let a1 = r1[i] as i128;",
      "            let a2 = r2[i] as i128;",
      "            let a3 = r3[i] as i128;",
      "            let k1 = ((a2 - a1) * inv_p1_mod_p2).rem_euclid(p2);",
      "            let t = a1 + p1 * k1;",
      "            let k2 = ((a3 - t) * inv_p1p2_mod_p3).rem_euclid(p3);",
      "            let x = t + p1 * p2 * k2;",
      "            x.rem_euclid(法i) as usize",
      "        })",
      "        .collect()",
      "}"
    ]
  },
  "直交_木": {
    "scope": "rust",
    "prefix": "直交_木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 配列からデカルト木（Cartesian tree）を O(N) で構築する。返り値は `(親配列, 根)`。",
      "/// 親配列の根は `-1`。値が等しいときは添字の小さい方を祖先（根側）にする最小ヒープ版。",
      "/// デカルト木は「中順走査が元の配列順」かつ「親の値 <= 子の値（最小ヒープ）」を満たす二分木で、",
      "/// 区間最小値クエリ（RMQ）を LCA に帰着したり、ヒストグラム最大長方形・単調スタック系の問題に使える。",
      "/// 要素型 `T` は順序比較できる型なら何でもよい（`i64`・`f64` など `PartialOrd`）。",
      "fn デカルト木<T: PartialOrd>(a: &[T]) -> (Vec<i64>, usize) {",
      "    let n = a.len();",
      "    let mut prev = vec![-1i64; n];",
      "    let mut スタック: Vec<usize> = Vec::new();",
      "    for i in 0..n {",
      "        let mut 直前 = -1i64;",
      "        while let Some(&天) = スタック.last() {",
      "            if a[天] <= a[i] {",
      "                break;",
      "            }",
      "            直前 = 天 as i64;",
      "            スタック.pop();",
      "        }",
      "        if 直前 != -1 {",
      "            prev[直前 as usize] = i as i64;",
      "        }",
      "        if let Some(&天) = スタック.last() {",
      "            prev[i] = 天 as i64;",
      "        }",
      "        スタック.push(i);",
      "    }",
      "    let 根 = (0..n).find(|&i| prev[i] == -1).unwrap_or(0);",
      "    (prev, 根)",
      "}"
    ]
  },
  "直径": {
    "scope": "rust",
    "prefix": "直径",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 重み付き辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺[i] = (u, v, w)` に対し `グラフ[u]` へ `(v, w)`、`グラフ[v]` へ `(u, w)` を積む。",
      "/// 重みの型 `T` は `Copy` であれば何でもよい（`i64`・`u64`・`(i64, usize)` など）。",
      "fn 重み付き無向グラフ<T: Copy>(",
      "    n: usize,",
      "    辺: &[(usize, usize, T)],",
      ") -> Vec<Vec<(usize, T)>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v, w) in 辺 {",
      "        グラフ[u].push((v, w));",
      "        グラフ[v].push((u, w));",
      "    }",
      "    グラフ",
      "}",
      "/// 木の直径（最も離れた2頂点間の距離）を求める。重み付き無向木に対応。O(N)。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の `(u, v, 重み)`、重みは非負を想定）。",
      "/// 重みなしの木なら重みをすべて 1 にして渡す。戻り値は `(直径の長さ, 端点1, 端点2)`。",
      "/// 「任意の点から最も遠い点 u」「u から最も遠い点 v」を取ると u-v が直径になる、を利用。",
      "fn 木の直径(n: usize, 辺: &[(usize, usize, i64)]) -> (i64, usize, usize) {",
      "    fn 最遠(グラフ: &[Vec<(usize, i64)>], 始点: usize) -> (i64, usize) {",
      "        let mut 距離 = vec![-1i64; グラフ.len()];",
      "        距離[始点] = 0;",
      "        let mut 探索 = vec![始点];",
      "        let (mut 最大距離, mut 最遠点) = (0i64, 始点);",
      "        while let Some(now) = 探索.pop() {",
      "            if 距離[now] > 最大距離 {",
      "                最大距離 = 距離[now];",
      "                最遠点 = now;",
      "            }",
      "            for &(next, w) in &グラフ[now] {",
      "                if 距離[next] < 0 {",
      "                    距離[next] = 距離[now] + w;",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        (最大距離, 最遠点)",
      "    }",
      "    let グラフ = 重み付き無向グラフ(n, 辺);",
      "    let (_, u) = 最遠(&グラフ, 0);",
      "    let (直径, v) = 最遠(&グラフ, u);",
      "    (直径, u, v)",
      "}"
    ]
  },
  "直線_交点": {
    "scope": "rust",
    "prefix": "直線_交点",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "type 点 = (i64, i64);",
      "/// 点 `p` が線分 `[a, b]`（端点を含む）の上にあるかを整数演算で厳密に判定する。",
      "/// `a == b`（点）にも対応。",
      "fn 点は線分上(p: 点, a: 点, b: 点) -> bool {",
      "    外積3点(a, b, p) == 0",
      "        && p.0 >= a.0.min(b.0)",
      "        && p.0 <= a.0.max(b.0)",
      "        && p.1 >= a.1.min(b.1)",
      "        && p.1 <= a.1.max(b.1)",
      "}",
      "/// 2 直線（`a` と `b` を通る直線、`c` と `d` を通る直線）の交点を `f64` で返す。平行なら `None`。",
      "/// 線分ではなく直線として扱う。厳密な交差「有無」は [`線分交差`]、座標が必要なときに本関数。",
      "fn 直線交点(a: 点, b: 点, c: 点, d: 点) -> Option<(f64, f64)> {",
      "    let r = (b.0 - a.0, b.1 - a.1);",
      "    let s = (d.0 - c.0, d.1 - c.1);",
      "    let rxs = r.0 as i128 * s.1 as i128 - r.1 as i128 * s.0 as i128;",
      "    if rxs == 0 {",
      "        return None;",
      "    }",
      "    let qp = (c.0 - a.0, c.1 - a.1);",
      "    let t = (qp.0 as f64 * s.1 as f64 - qp.1 as f64 * s.0 as f64) / rxs as f64;",
      "    Some((a.0 as f64 + t * r.0 as f64, a.1 as f64 + t * r.1 as f64))",
      "}"
    ]
  },
  "直線_集合_最小_任意順": {
    "scope": "rust",
    "prefix": "直線_集合_最小_任意順",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Li Chao 木（最小クエリ版）。直線 `y = 傾き·x + 切片` を **任意の順序** で追加でき、",
      "/// あらかじめ与えたクエリ座標群の各点での最小値を O(log) で求める。",
      "/// CHT（[`crate::convex_hull_trick`]）と違い傾きの単調性を要求しない。",
      "/// クエリ座標は `new` に渡したものに限る。最大値が欲しいときは傾き・切片の符号を",
      "/// 反転して入れ、結果を反転する（この実装は直線のみ、線分追加は非対応）。",
      "/// 評価は i64 素のまま行うので `傾き·x + 切片` が i64 に収まる範囲で使うこと。",
      "struct 李超木 {",
      "    xs: Vec<i64>,",
      "    直線: Vec<Option<(i64, i64)>>,",
      "}",
      "impl 李超木 {",
      "    /// クエリで使う x 座標を全て渡して構築する（重複・未ソートで可）。",
      "    /// 座標は任意の整数型の Vec / イテレータでよい（各メソッドの引数も同様）。",
      "    fn new<I>(座標群: I) -> Self",
      "    where",
      "        I: IntoIterator,",
      "        I::Item: TryInto<i64>,",
      "    {",
      "        let mut 座標群: Vec<i64> = 座標群.into_iter().map(to_i64).collect();",
      "        座標群.sort_unstable();",
      "        座標群.dedup();",
      "        if 座標群.is_empty() {",
      "            座標群.push(0);",
      "        }",
      "        let n = 座標群.len();",
      "        Self {",
      "            xs: 座標群,",
      "            直線: vec![None; 4 * n],",
      "        }",
      "    }",
      "    fn 評価(直線: (i64, i64), x: i64) -> i64 {",
      "        直線.0 * x + 直線.1",
      "    }",
      "    /// 直線 `y = 傾き·x + 切片` を追加する。",
      "    fn 直線追加(&mut self, 傾き: impl TryInto<i64>, 切片: impl TryInto<i64>) {",
      "        let n = self.xs.len();",
      "        self.追加内部(1, 0, n, (to_i64(傾き), to_i64(切片)));",
      "    }",
      "    fn 追加内部(&mut self, ノード: usize, lo: usize, hi: usize, mut 新規: (i64, i64)) {",
      "        let m = (lo + hi) / 2;",
      "        let Some(mut 現在) = self.直線[ノード] else {",
      "            self.直線[ノード] = Some(新規);",
      "            return;",
      "        };",
      "        if Self::評価(新規, self.xs[m]) < Self::評価(現在, self.xs[m]) {",
      "            std::mem::swap(&mut 新規, &mut 現在);",
      "            self.直線[ノード] = Some(現在);",
      "        }",
      "        if hi - lo == 1 {",
      "            return;",
      "        }",
      "        if Self::評価(新規, self.xs[lo]) < Self::評価(現在, self.xs[lo]) {",
      "            self.追加内部(2 * ノード, lo, m, 新規);",
      "        } else {",
      "            self.追加内部(2 * ノード + 1, m, hi, 新規);",
      "        }",
      "    }",
      "    /// クエリ座標 `x`（`new` に渡した値のいずれか）における最小値。",
      "    fn 最小値(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        let n = self.xs.len();",
      "        let idx = self.xs.partition_point(|&v| v < x);",
      "        debug_assert!(",
      "            idx < n && self.xs[idx] == x,",
      "            \"李超木: 未登録のクエリ座標 {x}\"",
      "        );",
      "        self.問い合わせ内部(1, 0, n, idx)",
      "    }",
      "    fn 問い合わせ内部(&self, ノード: usize, lo: usize, hi: usize, idx: usize) -> i64 {",
      "        let mut 最小 = self.直線[ノード]",
      "            .map(|l| Self::評価(l, self.xs[idx]))",
      "            .unwrap_or(i64::MAX);",
      "        if hi - lo > 1 {",
      "            let m = (lo + hi) / 2;",
      "            if idx < m {",
      "                最小 = 最小.min(self.問い合わせ内部(2 * ノード, lo, m, idx));",
      "            } else {",
      "                最小 = 最小.min(self.問い合わせ内部(2 * ノード + 1, m, hi, idx));",
      "            }",
      "        }",
      "        最小",
      "    }",
      "}"
    ]
  },
  "直線_集合_最小_傾き_単調": {
    "scope": "rust",
    "prefix": "直線_集合_最小_傾き_単調",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Convex Hull Trick（CHT, 最小クエリ版）。直線 `y = 傾き·x + 切片` を複数追加し、",
      "/// 与えた `x` での最小値を高速に求める。DP の `min_j (a_j·x + b_j)` 型の高速化に使う。",
      "/// 追加する直線の傾きは **単調非増加** の順で渡すこと（追加は償却 O(1)）。",
      "/// クエリ `x` は任意で、凸性を使った二分探索で O(log 本数)。",
      "/// 最大値が欲しいときは全ての `傾き`・`切片` の符号を反転して入れ、結果を反転する。",
      "/// 評価は i64 素のまま行うので `傾き·x + 切片` が i64 に収まる範囲で使うこと",
      "/// （直線の不要判定は i128 で行うため安全）。",
      "struct ConvexHullTrick {",
      "    直線: Vec<(i64, i64)>,",
      "}",
      "impl Default for ConvexHullTrick {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "impl ConvexHullTrick {",
      "    /// 空の直線集合を作る。",
      "    fn new() -> Self {",
      "        Self { 直線: Vec::new() }",
      "    }",
      "    fn 不要(l1: (i64, i64), l2: (i64, i64), l3: (i64, i64)) -> bool {",
      "        (l3.1 as i128 - l1.1 as i128) * (l1.0 as i128 - l2.0 as i128)",
      "            <= (l2.1 as i128 - l1.1 as i128) * (l1.0 as i128 - l3.0 as i128)",
      "    }",
      "    /// 直線 `y = 傾き·x + 切片` を追加する。傾きは単調非増加の順で渡すこと。",
      "    /// 引数は任意の整数型でよい（[`Self::最小値`] も同様）。",
      "    fn 直線追加(&mut self, 傾き: impl TryInto<i64>, 切片: impl TryInto<i64>) {",
      "        let l = (to_i64(傾き), to_i64(切片));",
      "        while self.直線.len() >= 2 {",
      "            let n = self.直線.len();",
      "            if Self::不要(self.直線[n - 2], self.直線[n - 1], l) {",
      "                self.直線.pop();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        self.直線.push(l);",
      "    }",
      "    fn 評価(l: (i64, i64), x: i64) -> i64 {",
      "        l.0 * x + l.1",
      "    }",
      "    /// `x` における全直線の最小値。直線が 1 本も無いときは呼ばないこと。",
      "    fn 最小値(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        debug_assert!(!self.直線.is_empty(), \"CHT: 直線が空です\");",
      "        let (mut lo, mut hi) = (0usize, self.直線.len() - 1);",
      "        while lo < hi {",
      "            let m = (lo + hi) / 2;",
      "            if Self::評価(self.直線[m], x) > Self::評価(self.直線[m + 1], x) {",
      "                lo = m + 1;",
      "            } else {",
      "                hi = m;",
      "            }",
      "        }",
      "        Self::評価(self.直線[lo], x)",
      "    }",
      "}"
    ]
  },
  "相異なる_回文": {
    "scope": "rust",
    "prefix": "相異なる_回文",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 回文木（Eertree / Palindromic Tree）の 1 ノード。`len` は表す回文の長さ",
      "/// （根は -1 と 0）、`suff` は最長の真回文接尾辞へのリンク、`次` は文字ごとの遷移、",
      "/// `出現` はその回文が「最長回文接尾辞」として現れた回数。",
      "struct 回文ノード {",
      "    len: i64,",
      "    suff: usize,",
      "    次: HashMap<u8, usize>,",
      "    出現: usize,",
      "}",
      "/// 回文木（Eertree）。文字列の全「相異なる回文部分文字列」を O(N) 個のノードで表す。構築 O(N)",
      "/// （アルファベットは `HashMap` 管理）。`manacher` は中心ごとの最大回文半径、`suffix_automaton` は",
      "/// 全部分文字列を扱うが、回文部分文字列の列挙・計数にはこの構造が向く。",
      "/// - [`Self::相異なる回文数`] : 空でない相異なる回文部分文字列の個数。",
      "/// - [`Self::回文部分文字列の総数`] : 回文となる部分文字列 `(i, j)` の総数（重複含む）。",
      "struct 回文木 {",
      "    ノード: Vec<回文ノード>,",
      "    最後: usize,",
      "    s: Vec<u8>,",
      "}",
      "impl 回文木 {",
      "    fn new() -> Self {",
      "        let 虚根 = 回文ノード {",
      "            len: -1,",
      "            suff: 0,",
      "            次: HashMap::new(),",
      "            出現: 0,",
      "        };",
      "        let 空根 = 回文ノード {",
      "            len: 0,",
      "            suff: 0,",
      "            次: HashMap::new(),",
      "            出現: 0,",
      "        };",
      "        Self {",
      "            ノード: vec![虚根, 空根],",
      "            最後: 1,",
      "            s: Vec::new(),",
      "        }",
      "    }",
      "    /// バイト列から構築する。",
      "    fn 構築(s: &[u8]) -> Self {",
      "        let mut t = Self::new();",
      "        for &c in s {",
      "            t.追加(c);",
      "        }",
      "        t",
      "    }",
      "    /// `位置` の文字 `c` を末尾に追加したとき、`位置` で終わる最長回文接尾辞のノードを返す。",
      "    fn リンクを辿る(&self, mut v: usize, 位置: usize, c: u8) -> usize {",
      "        loop {",
      "            let len = self.ノード[v].len;",
      "            let i = 位置 as i64 - len - 1;",
      "            if i >= 0 && self.s[i as usize] == c {",
      "                return v;",
      "            }",
      "            v = self.ノード[v].suff;",
      "        }",
      "    }",
      "    /// 末尾に 1 文字追加する。新しい相異なる回文が生まれたら true。",
      "    fn 追加(&mut self, c: u8) -> bool {",
      "        let 位置 = self.s.len();",
      "        self.s.push(c);",
      "        let 親 = self.リンクを辿る(self.最後, 位置, c);",
      "        if let Some(&既存) = self.ノード[親].次.get(&c) {",
      "            self.最後 = 既存;",
      "            self.ノード[既存].出現 += 1;",
      "            return false;",
      "        }",
      "        let 新 = self.ノード.len();",
      "        let 新len = self.ノード[親].len + 2;",
      "        let 新suff = if 新len == 1 {",
      "            1",
      "        } else {",
      "            let t = self.リンクを辿る(self.ノード[親].suff, 位置, c);",
      "            self.ノード[t].次[&c]",
      "        };",
      "        self.ノード.push(回文ノード {",
      "            len: 新len,",
      "            suff: 新suff,",
      "            次: HashMap::new(),",
      "            出現: 1,",
      "        });",
      "        self.ノード[親].次.insert(c, 新);",
      "        self.最後 = 新;",
      "        true",
      "    }",
      "    /// 空でない相異なる回文部分文字列の個数（2 つの根を除いたノード数）。",
      "    fn 相異なる回文数(&self) -> usize {",
      "        self.ノード.len() - 2",
      "    }",
      "    /// 回文となる部分文字列 `(i, j)` の総数（重複を含む）。O(ノード数)。",
      "    fn 回文部分文字列の総数(&self) -> usize {",
      "        let mut 出現: Vec<usize> = self.ノード.iter().map(|n| n.出現).collect();",
      "        for v in (2..self.ノード.len()).rev() {",
      "            let s = self.ノード[v].suff;",
      "            出現[s] += 出現[v];",
      "        }",
      "        出現[2..].iter().sum()",
      "    }",
      "}",
      "impl Default for 回文木 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "相異なる_部分_文字列": {
    "scope": "rust",
    "prefix": "相異なる_部分_文字列",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 接尾辞オートマトンの 1 状態。`len` は同値類の最長文字列長、`link` は suffix link",
      "/// （根は -1）、`next` は文字ごとの遷移先。",
      "struct 状態 {",
      "    len: usize,",
      "    link: i64,",
      "    next: HashMap<u8, usize>,",
      "}",
      "/// 接尾辞オートマトン（SAM）。文字列の全部分文字列を O(N) 状態で表す。構築 O(N)。",
      "/// - [`Self::相異なる部分文字列数`] : 相異なる（空でない）部分文字列の個数。",
      "/// - [`Self::含む`] : ある文字列が部分文字列として現れるか。",
      "struct 接尾辞オートマトン {",
      "    states: Vec<状態>,",
      "    last: usize,",
      "}",
      "impl 接尾辞オートマトン {",
      "    fn new() -> Self {",
      "        Self {",
      "            states: vec![状態 {",
      "                len: 0,",
      "                link: -1,",
      "                next: HashMap::new(),",
      "            }],",
      "            last: 0,",
      "        }",
      "    }",
      "    /// バイト列から構築する。",
      "    fn 構築(s: &[u8]) -> Self {",
      "        let mut sam = Self::new();",
      "        for &c in s {",
      "            sam.追加(c);",
      "        }",
      "        sam",
      "    }",
      "    /// 末尾に 1 文字追加する（オンライン構築）。",
      "    fn 追加(&mut self, c: u8) {",
      "        let cur = self.states.len();",
      "        self.states.push(状態 {",
      "            len: self.states[self.last].len + 1,",
      "            link: -1,",
      "            next: HashMap::new(),",
      "        });",
      "        let mut p = self.last as i64;",
      "        while p != -1 && !self.states[p as usize].next.contains_key(&c) {",
      "            self.states[p as usize].next.insert(c, cur);",
      "            p = self.states[p as usize].link;",
      "        }",
      "        if p == -1 {",
      "            self.states[cur].link = 0;",
      "        } else {",
      "            let q = self.states[p as usize].next[&c];",
      "            if self.states[p as usize].len + 1 == self.states[q].len {",
      "                self.states[cur].link = q as i64;",
      "            } else {",
      "                let clone = self.states.len();",
      "                self.states.push(状態 {",
      "                    len: self.states[p as usize].len + 1,",
      "                    link: self.states[q].link,",
      "                    next: self.states[q].next.clone(),",
      "                });",
      "                while p != -1 && self.states[p as usize].next.get(&c) == Some(&q) {",
      "                    self.states[p as usize].next.insert(c, clone);",
      "                    p = self.states[p as usize].link;",
      "                }",
      "                self.states[q].link = clone as i64;",
      "                self.states[cur].link = clone as i64;",
      "            }",
      "        }",
      "        self.last = cur;",
      "    }",
      "    /// 相異なる（空でない）部分文字列の個数。O(状態数)。",
      "    fn 相異なる部分文字列数(&self) -> usize {",
      "        let mut 合計 = 0usize;",
      "        for v in 1..self.states.len() {",
      "            let link = self.states[v].link;",
      "            let 親len = if link < 0 {",
      "                0",
      "            } else {",
      "                self.states[link as usize].len",
      "            };",
      "            合計 += self.states[v].len - 親len;",
      "        }",
      "        合計",
      "    }",
      "    /// `t` が部分文字列として現れるか。O(|t|)。",
      "    fn 含む(&self, t: &[u8]) -> bool {",
      "        let mut v = 0usize;",
      "        for &c in t {",
      "            match self.states[v].next.get(&c) {",
      "                Some(&nx) => v = nx,",
      "                None => return false,",
      "            }",
      "        }",
      "        true",
      "    }",
      "}",
      "impl Default for 接尾辞オートマトン {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "矩形_和集合_面積": {
    "scope": "rust",
    "prefix": "矩形_和集合_面積",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 軸平行長方形の**和集合の面積**（重なりを 1 回だけ数えた被覆面積）を返す。各長方形は",
      "/// `(x1, y1, x2, y2)`（`x1<x2`, `y1<y2`、半開矩形 `[x1,x2)×[y1,y2)`）。`O(N log N)`。",
      "/// x 座標圧縮 + y 方向の平面走査（Klee の長方形面積アルゴリズム）。",
      "/// [`segment_intersection`](crate::segment_intersection) は線分交差、[`imos`](crate::imos) は格子の",
      "/// 一括加算で、いずれも「連続座標の和集合面積」は扱わない。",
      "fn 長方形和集合の面積(矩形: &[(i64, i64, i64, i64)]) -> i64 {",
      "    if 矩形.is_empty() {",
      "        return 0;",
      "    }",
      "    let mut xs: Vec<i64> = Vec::with_capacity(矩形.len() * 2);",
      "    for &(x1, _, x2, _) in 矩形 {",
      "        if x1 < x2 {",
      "            xs.push(x1);",
      "            xs.push(x2);",
      "        }",
      "    }",
      "    xs.sort_unstable();",
      "    xs.dedup();",
      "    let m = xs.len();",
      "    if m < 2 {",
      "        return 0;",
      "    }",
      "    let mut イベント: Vec<(i64, usize, usize, i64)> = Vec::new();",
      "    for &(x1, y1, x2, y2) in 矩形 {",
      "        if x1 >= x2 || y1 >= y2 {",
      "            continue;",
      "        }",
      "        let i1 = xs.partition_point(|&v| v < x1);",
      "        let i2 = xs.partition_point(|&v| v < x2);",
      "        イベント.push((y1, i1, i2, 1));",
      "        イベント.push((y2, i1, i2, -1));",
      "    }",
      "    if イベント.is_empty() {",
      "        return 0;",
      "    }",
      "    イベント.sort_by_key(|&(y, _, _, _)| y);",
      "    let mut seg = 面積セグ::new(xs);",
      "    let mut 面積 = 0i64;",
      "    let mut 前y = イベント[0].0;",
      "    for (y, i1, i2, d) in イベント {",
      "        面積 += seg.被覆長() * (y - 前y);",
      "        seg.更新(1, 0, m - 1, i1, i2, d);",
      "        前y = y;",
      "    }",
      "    面積",
      "}",
      "struct 面積セグ {",
      "    xs: Vec<i64>,",
      "    count: Vec<i64>,",
      "    len: Vec<i64>,",
      "}",
      "impl 面積セグ {",
      "    fn new(xs: Vec<i64>) -> Self {",
      "        let size = 4 * xs.len().max(1);",
      "        面積セグ {",
      "            xs,",
      "            count: vec![0; size],",
      "            len: vec![0; size],",
      "        }",
      "    }",
      "    fn 被覆長(&self) -> i64 {",
      "        self.len[1]",
      "    }",
      "    fn 更新(&mut self, node: usize, nl: usize, nr: usize, ql: usize, qr: usize, d: i64) {",
      "        if qr <= nl || nr <= ql {",
      "            return;",
      "        }",
      "        if ql <= nl && nr <= qr {",
      "            self.count[node] += d;",
      "        } else {",
      "            let mid = (nl + nr) / 2;",
      "            self.更新(2 * node, nl, mid, ql, qr, d);",
      "            self.更新(2 * node + 1, mid, nr, ql, qr, d);",
      "        }",
      "        self.len[node] = if self.count[node] > 0 {",
      "            self.xs[nr] - self.xs[nl]",
      "        } else if nr - nl <= 1 {",
      "            0",
      "        } else {",
      "            self.len[2 * node] + self.len[2 * node + 1]",
      "        };",
      "    }",
      "}"
    ]
  },
  "石の_合体": {
    "scope": "rust",
    "prefix": "石の_合体",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// クヌース（Knuth–Yao）最適化。区間 DP `dp[i][j] = 区間コスト(i, j) + min_{i<=k<j} (dp[i][k] + dp[k+1][j])`",
      "/// を、最適分割点の単調性 `opt[i][j-1] <= opt[i][j] <= opt[i+1][j]` を用いて `O(n^2)` で解く。",
      "/// `区間コスト(i, j)` が四角不等式（QI）と区間単調性を満たすとき正しい（石の合体・最適二分探索木など、",
      "/// 区間長に関する凸なコスト）。素朴な区間 DP は `O(n^3)`。`n` 要素を 1 つに併合する総コストを返す。",
      "/// [`crate::divide_and_conquer_dp`]（層状の遷移）とは別物。",
      "fn クヌース最適化<F: Fn(usize, usize) -> i64>(n: usize, 区間コスト: F) -> i64 {",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let mut dp = vec![vec![0i64; n]; n];",
      "    let mut opt = vec![vec![0usize; n]; n];",
      "    for (i, 行) in opt.iter_mut().enumerate() {",
      "        行[i] = i;",
      "    }",
      "    for 長 in 1..n {",
      "        for i in 0..n - 長 {",
      "            let j = i + 長;",
      "            let 下 = opt[i][j - 1];",
      "            let 上 = opt[i + 1][j].min(j - 1);",
      "            let mut 最良 = i64::MAX;",
      "            let mut 最良k = 下;",
      "            for k in 下..=上 {",
      "                let v = dp[i][k] + dp[k + 1][j];",
      "                if v < 最良 {",
      "                    最良 = v;",
      "                    最良k = k;",
      "                }",
      "            }",
      "            dp[i][j] = 最良 + 区間コスト(i, j);",
      "            opt[i][j] = 最良k;",
      "        }",
      "    }",
      "    dp[0][n - 1]",
      "}"
    ]
  },
  "窓の_最大値": {
    "scope": "rust",
    "prefix": "窓の_最大値",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// スライド最大値。長さ `窓` の連続する各区間の最大値を単調デックで O(N) に列挙する。",
      "/// 仕様は [`スライド最小値`] と同じで、デック内が単調減少になる点だけが異なる。",
      "fn スライド最大値<T: Ord + Copy>(a: &[T], 窓: usize) -> Vec<T> {",
      "    use std::collections::VecDeque;",
      "    let mut res = Vec::new();",
      "    if 窓 == 0 || 窓 > a.len() {",
      "        return res;",
      "    }",
      "    let mut dq: VecDeque<usize> = VecDeque::new();",
      "    for (i, &x) in a.iter().enumerate() {",
      "        while let Some(&後) = dq.back() {",
      "            if a[後] <= x {",
      "                dq.pop_back();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        dq.push_back(i);",
      "        if i + 1 >= 窓 {",
