  "CircleArea": {
    "scope": "rust",
    "prefix": "CircleArea",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円（中心 `c1` 半径 `r1`、中心 `c2` 半径 `r2`）が重なる部分の面積を返す。`O(1)`。",
      "/// 離れていれば `0`、一方が他方を含めば小さい円の面積。",
      "/// [`円と円の交点`](crate::circle_intersection::円と円の交点) は交点座標で、こちらは面積。",
      "fn 二円の交差面積(c1: 点, r1: f64, c2: 点, r2: f64) -> f64 {",
      "    let d = (c1.0 - c2.0).hypot(c1.1 - c2.1);",
      "    if d >= r1 + r2 {",
      "        return 0.0;",
      "    }",
      "    if d <= (r1 - r2).abs() {",
      "        let r = r1.min(r2);",
      "        return std::f64::consts::PI * r * r;",
      "    }",
      "    let a1 = ((d * d + r1 * r1 - r2 * r2) / (2.0 * d * r1))",
      "        .clamp(-1.0, 1.0)",
      "        .acos();",
      "    let a2 = ((d * d + r2 * r2 - r1 * r1) / (2.0 * d * r2))",
      "        .clamp(-1.0, 1.0)",
      "        .acos();",
      "    let 三角 = 0.5",
      "        * ((-d + r1 + r2) * (d + r1 - r2) * (d - r1 + r2) * (d + r1 + r2))",
      "            .max(0.0)",
      "            .sqrt();",
      "    r1 * r1 * a1 + r2 * r2 * a2 - 三角",
      "}"
    ]
  },
  "CircleIntersection": {
    "scope": "rust",
    "prefix": "CircleIntersection",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円（中心 `c1` 半径 `r1`、中心 `c2` 半径 `r2`）の交点を返す。`0`/`1`（接する）/`2` 個。",
      "/// 中心間距離 `d` が `r1+r2` より大きい・`|r1-r2|` より小さい・同心（`d≈0`）のときは交わらない。",
      "/// [`segment_intersection`](crate::segment_intersection) は直線・線分用で円は扱えない。",
      "fn 円と円の交点(c1: 点, r1: f64, c2: 点, r2: f64) -> Vec<点> {",
      "    const EPS: f64 = 1e-9;",
      "    let dx = c2.0 - c1.0;",
      "    let dy = c2.1 - c1.1;",
      "    let d2 = dx * dx + dy * dy;",
      "    let d = d2.sqrt();",
      "    if d < EPS {",
      "        return Vec::new();",
      "    }",
      "    if d > r1 + r2 + EPS || d < (r1 - r2).abs() - EPS {",
      "        return Vec::new();",
      "    }",
      "    let a = (r1 * r1 - r2 * r2 + d2) / (2.0 * d);",
      "    let h2 = r1 * r1 - a * a;",
      "    let h = if h2 < 0.0 { 0.0 } else { h2.sqrt() };",
      "    let px = c1.0 + a * dx / d;",
      "    let py = c1.1 + a * dy / d;",
      "    if h < EPS {",
      "        return vec![(px, py)];",
      "    }",
      "    let ox = -dy / d * h;",
      "    let oy = dx / d * h;",
      "    vec![(px + ox, py + oy), (px - ox, py - oy)]",
      "}",
      "/// 円（中心 `c` 半径 `r`）と直線（`a`, `b` を通る）の交点を返す。`0`/`1`（接する）/`2` 個。",
      "fn 円と直線の交点(c: 点, r: f64, a: 点, b: 点) -> Vec<点> {",
      "    const EPS: f64 = 1e-9;",
      "    let dx = b.0 - a.0;",
      "    let dy = b.1 - a.1;",
      "    let 長2 = dx * dx + dy * dy;",
      "    if 長2 < EPS {",
      "        return Vec::new();",
      "    }",
      "    let t = ((c.0 - a.0) * dx + (c.1 - a.1) * dy) / 長2;",
      "    let fx = a.0 + t * dx;",
      "    let fy = a.1 + t * dy;",
      "    let dist2 = (c.0 - fx) * (c.0 - fx) + (c.1 - fy) * (c.1 - fy);",
      "    if dist2 > r * r + EPS {",
      "        return Vec::new();",
      "    }",
      "    let k2 = r * r - dist2;",
      "    let k = if k2 < 0.0 { 0.0 } else { k2.sqrt() };",
      "    let 長 = 長2.sqrt();",
      "    if k < EPS {",
      "        return vec![(fx, fy)];",
      "    }",
      "    let ux = dx / 長 * k;",
      "    let uy = dy / 長 * k;",
      "    vec![(fx + ux, fy + uy), (fx - ux, fy - uy)]",
      "}"
    ]
  },
  "CirclePolygonArea": {
    "scope": "rust",
    "prefix": "CirclePolygonArea",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 円（中心 `中心`・半径 `r`）と単純多角形（頂点を順に並べた列）が重なる部分の面積を返す。O(N)。",
      "/// 頂点列の向きは問わず、凸でなくてもよい。",
      "fn 円と多角形の交差面積(中心: 点, r: f64, 多角形: &[点]) -> f64 {",
      "    let n = 多角形.len();",
      "    if n < 3 || r <= 0.0 {",
      "        return 0.0;",
      "    }",
      "    let 内積 = |p: 点, q: 点| p.0 * q.0 + p.1 * q.1;",
      "    let 外積 = |p: 点, q: 点| p.0 * q.1 - p.1 * q.0;",
      "    let 偏角 = |p: 点, q: 点| 外積(p, q).atan2(内積(p, q));",
      "    let r2 = r * r / 2.0;",
      "    let 三角 = |p: 点, q: 点| -> f64 {",
      "        let d = (q.0 - p.0, q.1 - p.1);",
      "        let d2 = 内積(d, d);",
      "        if d2 < 1e-18 {",
      "            return 0.0;",
      "        }",
      "        let a = 内積(d, p) / d2;",
      "        let b = (内積(p, p) - r * r) / d2;",
      "        let det = a * a - b;",
      "        if det <= 0.0 {",
      "            return 偏角(p, q) * r2;",
      "        }",
      "        let sq = det.sqrt();",
      "        let s = (-a - sq).max(0.0);",
      "        let t = (-a + sq).min(1.0);",
      "        if t < 0.0 || 1.0 <= s {",
      "            return 偏角(p, q) * r2;",
      "        }",
      "        let u = (p.0 + d.0 * s, p.1 + d.1 * s);",
      "        let v = (p.0 + d.0 * t, p.1 + d.1 * t);",
      "        偏角(p, u) * r2 + 外積(u, v) / 2.0 + 偏角(v, q) * r2",
      "    };",
      "    let mut 和 = 0.0f64;",
      "    for i in 0..n {",
      "        let p = (多角形[i].0 - 中心.0, 多角形[i].1 - 中心.1);",
      "        let q = (",
      "            多角形[(i + 1) % n].0 - 中心.0,",
      "            多角形[(i + 1) % n].1 - 中心.1,",
      "        );",
      "        和 += 三角(p, q);",
      "    }",
      "    和.abs()",
      "}"
    ]
  },
  "ClosestPair": {
    "scope": "rust",
    "prefix": "ClosestPair",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗を `i128` で返す。",
      "/// 平方根を取らないので誤差なしで距離を比較できる。差を取ってから `i128` に広げるため、",
      "/// 座標が `±10^18` でも桁あふれしない。実距離が要るときは `(d as f64).sqrt()`。",
      "fn 距離2乗(a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let dx = (a.0 - b.0) as i128;",
      "    let dy = (a.1 - b.1) as i128;",
      "    dx * dx + dy * dy",
      "}",
      "/// 平面上の点群から最も近い 2 点を分割統治で求める。O(N log^2 N)。",
      "/// 返り値は `(最小距離の 2 乗, (点 i の添字, 点 j の添字))`。点が 2 個未満なら `None`。",
      "/// 距離は整数の 2 乗で厳密に比較する（誤差なし）。",
      "fn 最近点対(点群: &[(i64, i64)]) -> Option<(i128, (usize, usize))> {",
      "    if 点群.len() < 2 {",
      "        return None;",
      "    }",
      "    let mut idx: Vec<usize> = (0..点群.len()).collect();",
      "    idx.sort_by_key(|&i| (点群[i].0, 点群[i].1));",
      "    let n = idx.len();",
      "    Some(再帰(点群, &idx, 0, n))",
      "}",
      "/// `idx[l..r]`（x 昇順）の範囲で最近点対を求める。",
      "fn 再帰(点群: &[(i64, i64)], idx: &[usize], l: usize, r: usize) -> (i128, (usize, usize)) {",
      "    if r - l <= 3 {",
      "        let mut 最良 = (i128::MAX, (0usize, 0usize));",
      "        for a in l..r {",
      "            for b in a + 1..r {",
      "                let d = 距離2乗(点群[idx[a]], 点群[idx[b]]);",
      "                if d < 最良.0 {",
      "                    最良 = (d, (idx[a], idx[b]));",
      "                }",
      "            }",
      "        }",
      "        return 最良;",
      "    }",
      "    let 中 = (l + r) / 2;",
      "    let 中x = 点群[idx[中]].0;",
      "    let 左 = 再帰(点群, idx, l, 中);",
      "    let 右 = 再帰(点群, idx, 中, r);",
      "    let mut 最良 = if 左.0 <= 右.0 { 左 } else { 右 };",
      "    let mut 帯: Vec<usize> = idx[l..r]",
      "        .iter()",
      "        .copied()",
      "        .filter(|&p| {",
      "            let dx = (点群[p].0 - 中x) as i128;",
      "            dx * dx < 最良.0",
      "        })",
      "        .collect();",
      "    帯.sort_by_key(|&p| 点群[p].1);",
      "    for (i, &pi) in 帯.iter().enumerate() {",
      "        for &pj in &帯[i + 1..] {",
      "            let dy = (点群[pj].1 - 点群[pi].1) as i128;",
      "            if dy * dy >= 最良.0 {",
      "                break;",
      "            }",
      "            let d = 距離2乗(点群[pi], 点群[pj]);",
      "            if d < 最良.0 {",
      "                最良 = (d, (pi, pj));",
      "            }",
      "        }",
      "    }",
      "    最良",
      "}"
    ]
  },
  "CommonTangents": {
    "scope": "rust",
    "prefix": "CommonTangents",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 2 つの円の共通接線の本数を返す。同心で半径が等しい場合のみ無数（`!0`）。`O(1)`。",
      "/// 中心間距離 `d` と半径から分類する：`d>r1+r2`→4、`=r1+r2`→3、`|r1-r2|<d<r1+r2`→2、",
      "/// `d=|r1-r2|`→1、`d<|r1-r2|`→0（一方が他方の内部）。半径 0（点）も同じ枠組みで扱える。",
      "fn 共通接線本数(c1: 点, r1: f64, c2: 点, r2: f64) -> usize {",
      "    const EPS: f64 = 1e-9;",
      "    let d = (c1.0 - c2.0).hypot(c1.1 - c2.1);",
      "    let 和 = r1 + r2;",
      "    let 差 = (r1 - r2).abs();",
      "    if d < EPS && 差 < EPS {",
      "        return !0;",
      "    }",
      "    if d > 和 + EPS {",
      "        4",
      "    } else if (d - 和).abs() <= EPS {",
      "        3",
      "    } else if d > 差 + EPS {",
      "        2",
      "    } else if (d - 差).abs() <= EPS {",
      "        1",
      "    } else {",
      "        0",
      "    }",
      "}"
    ]
  },
  "ContinuedFraction": {
    "scope": "rust",
    "prefix": "ContinuedFraction",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 非負の有理数 `分子 / 分母`（`分母 > 0`）の正則連分数展開 `[a0; a1, a2, …]` を返す。",
      "/// ユークリッドの互除法そのもの。`O(log 分母)`。",
      "fn 連分数展開(分子: impl TryInto<i64>, 分母: impl TryInto<i64>) -> Vec<i64> {",
      "    let mut 分子 = 分子",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連分数展開: 引数が i64 に収まりません\");",
      "    let mut 分母 = 分母",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連分数展開: 引数が i64 に収まりません\");",
      "    assert!(分母 > 0 && 分子 >= 0, \"分子 >= 0, 分母 > 0\");",
      "    let mut 係数 = Vec::new();",
      "    while 分母 != 0 {",
      "        係数.push(分子 / 分母);",
      "        let r = 分子 % 分母;",
      "        分子 = 分母;",
      "        分母 = r;",
      "    }",
      "    係数",
      "}",
      "/// 連分数係数列から収束分数（convergent）`(分子, 分母)` の列を返す。",
      "/// `h_i = a_i·h_{i-1} + h_{i-2}`, `k_i = a_i·k_{i-1} + k_{i-2}`。各収束分数は既約。",
      "fn 収束分数(係数: &[i64]) -> Vec<(i64, i64)> {",
      "    let mut 列 = Vec::with_capacity(係数.len());",
      "    let (mut h2, mut h1) = (0i64, 1i64);",
      "    let (mut k2, mut k1) = (1i64, 0i64);",
      "    for &a in 係数 {",
      "        let h = a * h1 + h2;",
      "        let k = a * k1 + k2;",
      "        列.push((h, k));",
      "        h2 = h1;",
      "        h1 = h;",
      "        k2 = k1;",
      "        k1 = k;",
      "    }",
      "    列",
      "}"
    ]
  },
  "ConvexContains": {
    "scope": "rust",
    "prefix": "ConvexContains",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (i64, i64);",
      "/// 反時計回りの凸多角形 `多角形` に点 `q` が含まれるかを `O(log N)` で判定する。",
      "/// `2` = 内部、`1` = 辺・頂点上、`0` = 外部。座標は整数のまま厳密判定。",
      "/// 多角形は**狭義凸**（連続 3 頂点が共線でない）かつ反時計回りであることを前提とする。",
      "/// [`点の内外`](crate::polygon::点の内外) は任意の単純多角形を `O(N)` で判定する別物。",
      "fn 凸多角形内包(多角形: &[点], q: 点) -> i32 {",
      "    let p = 多角形;",
      "    let n = p.len();",
      "    let 外積 = |o: 点, a: 点, b: 点| -> i128 {",
      "        (a.0 - o.0) as i128 * (b.1 - o.1) as i128 - (a.1 - o.1) as i128 * (b.0 - o.0) as i128",
      "    };",
      "    let 線分上 = |a: 点, b: 点| (q.0 - a.0) * (q.0 - b.0) <= 0 && (q.1 - a.1) * (q.1 - b.1) <= 0;",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    if n == 1 {",
      "        return if q == p[0] { 1 } else { 0 };",
      "    }",
      "    if n == 2 {",
      "        return if 外積(p[0], p[1], q) == 0 && 線分上(p[0], p[1]) {",
      "            1",
      "        } else {",
      "            0",
      "        };",
      "    }",
      "    let d1 = 外積(p[0], p[1], q);",
      "    let d2 = 外積(p[0], p[n - 1], q);",
      "    if d1 < 0 || d2 > 0 {",
      "        return 0;",
      "    }",
      "    let mut lo = 1usize;",
      "    let mut hi = n - 1;",
      "    while hi - lo > 1 {",
      "        let mid = (lo + hi) / 2;",
      "        if 外積(p[0], p[mid], q) >= 0 {",
      "            lo = mid;",
      "        } else {",
      "            hi = mid;",
      "        }",
      "    }",
      "    let c = 外積(p[lo], p[hi], q);",
      "    if c < 0 {",
      "        return 0;",
      "    }",
      "    if c == 0 {",
      "        return if 線分上(p[lo], p[hi]) { 1 } else { 0 };",
      "    }",
      "    if d1 == 0 {",
      "        return if 線分上(p[0], p[1]) { 1 } else { 0 };",
      "    }",
      "    if d2 == 0 {",
      "        return if 線分上(p[0], p[n - 1]) { 1 } else { 0 };",
      "    }",
      "    2",
      "}"
    ]
  },
  "ConvexCut": {
    "scope": "rust",
    "prefix": "ConvexCut",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 凸多角形 `多角形`（反時計回り）を有向直線 `a → b` で切り、その**左側**に残る部分を返す。`O(N)`。",
      "/// Sutherland–Hodgman の片側クリップ。左側が空なら空の頂点列を返す。",
      "/// [`half_plane_intersection`](crate::half_plane_intersection) は多数の半平面の共通部分を求める別物。",
      "fn 凸多角形切断(多角形: &[点], a: 点, b: 点) -> Vec<点> {",
      "    let n = 多角形.len();",
      "    let 符号 = |p: 点| (b.0 - a.0) * (p.1 - a.1) - (b.1 - a.1) * (p.0 - a.0);",
      "    let mut 結果 = Vec::with_capacity(n + 1);",
      "    for i in 0..n {",
      "        let c = 多角形[i];",
      "        let d = 多角形[(i + 1) % n];",
      "        let fc = 符号(c);",
      "        let fd = 符号(d);",
      "        if fc >= 0.0 {",
      "            結果.push(c);",
      "        }",
      "        if fc * fd < 0.0 {",
      "            let t = fc / (fc - fd);",
      "            結果.push((c.0 + t * (d.0 - c.0), c.1 + t * (d.1 - c.1)));",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "ConvexHull": {
    "scope": "rust",
    "prefix": "ConvexHull",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 3 点 `o, a, b` の外積 `(a-o) × (b-o)` を `i128` で厳密に返す。",
      "/// 符号: 正 → `o→a→b` は左折（反時計回り）、負 → 右折、0 → 一直線。絶対値は",
      "/// 3 点が張る平行四辺形の面積で、`o` から見た直線 `ab` までの距離の比較にも使える。",
      "/// 差を取ってから `i128` に広げるので、座標が `±10^18` でも桁あふれしない。",
      "/// 始点をそろえた 2 ベクトルの外積が欲しいだけなら [`外積`] を使う。",
      "fn 外積3点(o: (i64, i64), a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let ax = (a.0 - o.0) as i128;",
      "    let ay = (a.1 - o.1) as i128;",
      "    let bx = (b.0 - o.0) as i128;",
      "    let by = (b.1 - o.1) as i128;",
      "    ax * by - ay * bx",
      "}",
      "/// 凸包（Andrew's monotone chain）。与えた点集合をすべて含む最小の凸多角形の",
      "/// 頂点を、反時計回りの順で返す。O(N log N)。",
      "/// 一直線上に並ぶ中間点（凸包の辺上の点）は頂点に含めない。",
      "/// 点が2個以下のときは重複を除いた入力をそのまま返す。",
      "fn 凸包(点群: &[(i64, i64)]) -> Vec<(i64, i64)> {",
      "    let mut 点 = 点群.to_vec();",
      "    点.sort();",
      "    点.dedup();",
      "    let n = 点.len();",
      "    if n <= 2 {",
      "        return 点;",
      "    }",
      "    let mut 下側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in &点 {",
      "        while 下側.len() >= 2 && 外積3点(下側[下側.len() - 2], 下側[下側.len() - 1], p) <= 0",
      "        {",
      "            下側.pop();",
      "        }",
      "        下側.push(p);",
      "    }",
      "    let mut 上側: Vec<(i64, i64)> = Vec::new();",
      "    for &p in 点.iter().rev() {",
      "        while 上側.len() >= 2 && 外積3点(上側[上側.len() - 2], 上側[上側.len() - 1], p) <= 0",
      "        {",
      "            上側.pop();",
      "        }",
      "        上側.push(p);",
      "    }",
      "    下側.pop();",
      "    上側.pop();",
      "    下側.extend(上側);",
      "    下側",
      "}"
    ]
  },
  "ConvexHullTrick": {
    "scope": "rust",
    "prefix": "ConvexHullTrick",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Convex Hull Trick（CHT, 最小クエリ版）。直線 `y = 傾き·x + 切片` を複数追加し、",
      "/// 与えた `x` での最小値を高速に求める。DP の `min_j (a_j·x + b_j)` 型の高速化に使う。",
      "/// 追加する直線の傾きは **単調非増加** の順で渡すこと（追加は償却 O(1)）。",
      "/// クエリ `x` は任意で、凸性を使った二分探索で O(log 本数)。",
      "/// 最大値が欲しいときは全ての `傾き`・`切片` の符号を反転して入れ、結果を反転する。",
      "/// 評価は i64 素のまま行うので `傾き·x + 切片` が i64 に収まる範囲で使うこと",
      "/// （直線の不要判定は i128 で行うため安全）。",
      "struct ConvexHullTrick {",
      "    直線: Vec<(i64, i64)>,",
      "}",
      "impl Default for ConvexHullTrick {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}",
      "impl ConvexHullTrick {",
      "    /// 空の直線集合を作る。",
      "    fn new() -> Self {",
      "        Self { 直線: Vec::new() }",
      "    }",
      "    fn 不要(l1: (i64, i64), l2: (i64, i64), l3: (i64, i64)) -> bool {",
      "        (l3.1 as i128 - l1.1 as i128) * (l1.0 as i128 - l2.0 as i128)",
      "            <= (l2.1 as i128 - l1.1 as i128) * (l1.0 as i128 - l3.0 as i128)",
      "    }",
      "    /// 直線 `y = 傾き·x + 切片` を追加する。傾きは単調非増加の順で渡すこと。",
      "    /// 引数は任意の整数型でよい（[`Self::最小値`] も同様）。",
      "    fn 直線追加(&mut self, 傾き: impl TryInto<i64>, 切片: impl TryInto<i64>) {",
      "        let l = (to_i64(傾き), to_i64(切片));",
      "        while self.直線.len() >= 2 {",
      "            let n = self.直線.len();",
      "            if Self::不要(self.直線[n - 2], self.直線[n - 1], l) {",
      "                self.直線.pop();",
      "            } else {",
      "                break;",
      "            }",
      "        }",
      "        self.直線.push(l);",
      "    }",
      "    fn 評価(l: (i64, i64), x: i64) -> i64 {",
      "        l.0 * x + l.1",
      "    }",
      "    /// `x` における全直線の最小値。直線が 1 本も無いときは呼ばないこと。",
      "    fn 最小値(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        debug_assert!(!self.直線.is_empty(), \"CHT: 直線が空です\");",
      "        let (mut lo, mut hi) = (0usize, self.直線.len() - 1);",
      "        while lo < hi {",
      "            let m = (lo + hi) / 2;",
      "            if Self::評価(self.直線[m], x) > Self::評価(self.直線[m + 1], x) {",
      "                lo = m + 1;",
      "            } else {",
      "                hi = m;",
      "            }",
      "        }",
      "        Self::評価(self.直線[lo], x)",
      "    }",
      "}"
    ]
  },
  "ConvexPolygon": {
    "scope": "rust",
    "prefix": "ConvexPolygon",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 頂点列が凸多角形をなすか（同一向きに曲がり続けるか）を判定する。O(N)。",
      "/// 共線な 3 点は許容する。`n < 3` は `false`。",
      "fn 凸多角形か(多角形: &[(i64, i64)]) -> bool {",
      "    let n = 多角形.len();",
      "    if n < 3 {",
      "        return false;",
      "    }",
      "    let mut 符号 = 0i64;",
      "    for i in 0..n {",
      "        let (ax, ay) = 多角形[i];",
      "        let (bx, by) = 多角形[(i + 1) % n];",
      "        let (cx, cy) = 多角形[(i + 2) % n];",
      "        let 外積 = (bx - ax) * (cy - by) - (by - ay) * (cx - bx);",
      "        if 外積 != 0 {",
      "            let s = 外積.signum();",
      "            if 符号 == 0 {",
      "                符号 = s;",
      "            } else if 符号 != s {",
      "                return false;",
      "            }",
      "        }",
      "    }",
      "    true",
      "}"
    ]
  },
  "DAG_最小_パス_被覆": {
    "scope": "rust",
    "prefix": "DAG_最小_パス_被覆",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::VecDeque;",
      "/// Hopcroft-Karp 法による二部グラフの最大マッチング。O(E√V)。",
      "/// `ac_library::MaxFlow` でも最大二部マッチングは解けるが、こちらは二部マッチング専用で",
      "/// E√V と高速。`pathfinding::kuhn_munkres` は重み付き割当専用なので、",
      "/// 単純な最大本数マッチングにはこちらを使う。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に対応も保持）。",
      "/// - [`Self::マッチング`] : マッチした `(左, 右)` の組を返す。",
      "struct ホップクロフトカープ {",
      "    左数: usize,",
      "    グラフ: Vec<Vec<usize>>,",
      "    左相手: Vec<i64>,",
      "    右相手: Vec<i64>,",
      "    距離: Vec<i64>,",
      "}",
      "impl ホップクロフトカープ {",
      "    /// 左頂点 `左数` 個・右頂点 `右数` 個の二部グラフを作る。",
      "    fn new(左数: usize, 右数: usize) -> Self {",
      "        Self {",
      "            左数,",
      "            グラフ: vec![Vec::new(); 左数],",
      "            左相手: vec![-1; 左数],",
      "            右相手: vec![-1; 右数],",
      "            距離: vec![-1; 左数],",
      "        }",
      "    }",
      "    /// 左頂点 `u` と右頂点 `v` を結ぶ辺を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.グラフ[u].push(v);",
      "    }",
      "    /// 未マッチ左頂点から BFS して層（距離）を作る。増加道が存在すれば true。",
      "    fn bfs(&mut self) -> bool {",
      "        let mut 探索 = VecDeque::new();",
      "        for u in 0..self.左数 {",
      "            if self.左相手[u] < 0 {",
      "                self.距離[u] = 0;",
      "                探索.push_back(u);",
      "            } else {",
      "                self.距離[u] = -1;",
      "            }",
      "        }",
      "        let mut 増加道あり = false;",
      "        while let Some(u) = 探索.pop_front() {",
      "            for i in 0..self.グラフ[u].len() {",
      "                let v = self.グラフ[u][i];",
      "                let w = self.右相手[v];",
      "                if w < 0 {",
      "                    増加道あり = true;",
      "                } else {",
      "                    let w = w as usize;",
      "                    if self.距離[w] < 0 {",
      "                        self.距離[w] = self.距離[u] + 1;",
      "                        探索.push_back(w);",
      "                    }",
      "                }",
      "            }",
      "        }",
      "        増加道あり",
      "    }",
      "    /// 層に沿って `u` から増加道を探し、見つかれば反転して true。",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn dfs(&mut self, u: usize) -> bool {",
      "        for i in 0..self.グラフ[u].len() {",
      "            let v = self.グラフ[u][i];",
      "            let w = self.右相手[v];",
      "            let 進める =",
      "                w < 0 || (self.距離[w as usize] == self.距離[u] + 1 && self.dfs(w as usize));",
      "            if 進める {",
      "                self.左相手[u] = v as i64;",
      "                self.右相手[v] = u as i64;",
      "                return true;",
      "            }",
      "        }",
      "        self.距離[u] = -1;",
      "        false",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut 本数 = 0;",
      "        while self.bfs() {",
      "            for u in 0..self.左数 {",
      "                if self.左相手[u] < 0 && self.dfs(u) {",
      "                    本数 += 1;",
      "                }",
      "            }",
      "        }",
      "        本数",
      "    }",
      "    /// マッチした `(左, 右)` の組を返す。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn マッチング(&self) -> Vec<(usize, usize)> {",
      "        (0..self.左数)",
      "            .filter(|&u| self.左相手[u] >= 0)",
      "            .map(|u| (u, self.左相手[u] as usize))",
      "            .collect()",
      "    }",
      "}",
      "/// DAG（閉路のない有向グラフ）の**頂点素な最小パス被覆**を求める。すべての頂点をちょうど 1 本の",
      "/// 有向パスに含めるとき、必要なパスの最小本数と、その実際のパス列を返す。`O(E√V)`（二部マッチング）。",
      "/// 半順序の比較可能対を辺にすれば、最小パス被覆数は**最大反鎖**の大きさに等しい（Dilworth の定理）。",
      "/// [`hopcroft_karp`](crate::hopcroft_karp) は素のマッチング、本関数はその DAG パス被覆への応用。",
      "/// 入力に閉路があると正しい結果を保証しない（事前にトポロジカル性を仮定）。",
      "fn dag最小パス被覆(頂点数: usize, 辺: &[(usize, usize)]) -> (usize, Vec<Vec<usize>>) {",
      "    let mut hk = ホップクロフトカープ::new(頂点数, 頂点数);",
      "    for &(u, v) in 辺 {",
      "        hk.辺追加(u, v);",
      "    }",
      "    let m = hk.最大マッチング();",
      "    let mut next = vec![!0; 頂点数];",
      "    let mut prev = vec![!0; 頂点数];",
      "    for (u, v) in hk.マッチング() {",
      "        next[u] = v;",
      "        prev[v] = u;",
      "    }",
      "    let mut パス = Vec::new();",
      "    for (s, &prev_s) in prev.iter().enumerate() {",
      "        if prev_s == !0 {",
      "            let mut p = Vec::new();",
      "            let mut now = s;",
      "            while now != !0 {",
      "                p.push(now);",
      "                now = next[now];",
      "            }",
      "            パス.push(p);",
      "        }",
      "    }",
      "    (頂点数 - m, パス)",
      "}"
    ]
  },
  "Derangement": {
    "scope": "rust",
    "prefix": "Derangement",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::ModInt as Mint;",
      "/// モンモール数（完全順列＝撹乱順列の数）`D(0..=n)` を前計算して返す。O(n)。",
      "/// mod は `Mint`（ac_library::ModInt）のグローバル modulus。Comb は不要。",
      "/// `D(n)` は `1..=n` のどの位置も自分自身を指さない順列の数。u64 なら n ≥ 21 で溢れる。",
      "fn モンモール数(n: usize) -> Vec<Mint> {",
      "    let mut d = vec![Mint::new(0); n + 1];",
      "    d[0] = Mint::new(1);",
      "    for i in 2..=n {",
      "        d[i] = Mint::new(i - 1) * (d[i - 1] + d[i - 2]);",
      "    }",
      "    d",
      "}"
    ]
  },
  "DifferenceConstraints": {
    "scope": "rust",
    "prefix": "DifferenceConstraints",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// **差分制約系**を解く。各制約 `(a, b, c)` は `x[b] − x[a] ≤ c` を表し、これらを同時に満たす整数割当",
      "/// `x[0..変数数]` を 1 つ返す。実行不能（矛盾）なら `None`。`O(変数数 · 制約数)`。",
      "/// 解はシフト不変（全体に定数を足しても成立）で、ここでは `max x` を 0 に寄せた解を返す。",
      "/// 区間スケジューリングの順序制約や、座標差・時刻差の同時制約に使える。",
      "fn 差分制約(変数数: usize, 制約: &[(usize, usize, i64)]) -> Option<Vec<i64>> {",
      "    let n = 変数数;",
      "    let mut 距離 = vec![0i64; n];",
      "    for 回 in 0..n {",
      "        let mut 更新 = false;",
      "        for &(a, b, c) in 制約 {",
      "            if 距離[a] + c < 距離[b] {",
      "                距離[b] = 距離[a] + c;",
      "                更新 = true;",
      "                if 回 == n - 1 {",
      "                    return None;",
      "                }",
      "            }",
      "        }",
      "        if !更新 {",
      "            break;",
      "        }",
      "    }",
      "    Some(距離)",
      "}"
    ]
  },
  "DisjointSparseTable": {
    "scope": "rust",
    "prefix": "DisjointSparseTable",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn 半開(範囲: impl std::ops::RangeBounds<usize>, n: usize) -> (usize, usize) {",
      "    use std::ops::Bound::{Excluded, Included, Unbounded};",
      "    let l = match 範囲.start_bound() {",
      "        Included(&x) => x,",
      "        Excluded(&x) => x + 1,",
      "        Unbounded => 0,",
      "    };",
      "    let r = match 範囲.end_bound() {",
      "        Included(&x) => x + 1,",
      "        Excluded(&x) => x,",
      "        Unbounded => n,",
      "    };",
      "    (l, r)",
      "}",
      "/// 分割スパーステーブル（Disjoint Sparse Table）。静的（更新なし）配列に対し、",
      "/// 「結合的だが冪等とは限らない」二項演算（和・積・xor・gcd・行列積・アフィン合成など）の",
      "/// 区間クエリを前処理 `O(N log N)`・各クエリ `O(1)` で答える。",
      "/// 通常のスパーステーブル（[`crate::sparse_table`]）は冪等演算（min/max/gcd）専用。こちらは",
      "/// **非可換・非冪等**な演算でも使える。",
      "/// - `merge` は結合的であること（可換・冪等は不要）。順序は `merge(左側, 右側)` で保たれる。",
      "struct 分割スパーステーブル<T, F> {",
      "    元: Vec<T>,",
      "    テーブル: Vec<Vec<T>>,",
      "    merge: F,",
      "}",
      "impl<T: Copy, F: Fn(T, T) -> T> 分割スパーステーブル<T, F> {",
      "    /// 配列と結合的な二項演算 `merge` から分割スパーステーブルを構築する。",
      "    /// # 例",
      "    /// ```ignore",
      "    /// let st = 分割スパーステーブル::new(&a, |x, y| x + y); // 区間和",
      "    /// assert_eq!(st.区間(1..4), a[1] + a[2] + a[3]);",
      "    /// ```",
      "    #[allow(clippy::needless_range_loop)]",
      "    fn new(配列: &[T], merge: F) -> Self {",
      "        let n = 配列.len();",
      "        let mut レベル数 = 1;",
      "        while (1usize << レベル数) < n {",
      "            レベル数 += 1;",
      "        }",
      "        let mut テーブル = vec![配列.to_vec(); レベル数];",
      "        for k in 0..レベル数 {",
      "            let 半 = 1usize << k;",
      "            let 幅 = 半 * 2;",
      "            let mut s = 0;",
      "            while s < n {",
      "                let 中 = s + 半;",
      "                let 左終 = 中.min(n);",
      "                for i in (s..左終 - 1).rev() {",
      "                    テーブル[k][i] = merge(配列[i], テーブル[k][i + 1]);",
      "                }",
      "                if 中 < n {",
      "                    let 右終 = (s + 幅).min(n);",
      "                    for i in 中 + 1..右終 {",
      "                        テーブル[k][i] = merge(テーブル[k][i - 1], 配列[i]);",
      "                    }",
      "                }",
      "                s += 幅;",
      "            }",
      "        }",
      "        Self {",
      "            元: 配列.to_vec(),",
      "            テーブル,",
      "            merge,",
      "        }",
      "    }",
      "    /// 区間（`a..b` / `a..=b` / `..` など）に対する `merge` の畳み込み（左→右の順）を",
      "    /// O(1) で返す。空区間は問い合わせ不可。",
      "    fn 区間(&self, 範囲: impl std::ops::RangeBounds<usize>) -> T {",
      "        let (l, r) = 半開(範囲, self.元.len());",
      "        debug_assert!(l < r, \"分割スパーステーブル: 空区間は問い合わせ不可\");",
      "        let 右 = r - 1;",
      "        if l == 右 {",
      "            return self.元[l];",
      "        }",
      "        let k = (usize::BITS - 1 - (l ^ 右).leading_zeros()) as usize;",
      "        (self.merge)(self.テーブル[k][l], self.テーブル[k][右])",
      "    }",
      "}"
    ]
  },
  "DivideAndConquerDP": {
    "scope": "rust",
    "prefix": "DivideAndConquerDP",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 単調最小値（monotone minima）。各行 `i` の最小値をとる列 `argmin(i)` が `i` について単調非減少",
      "/// であるような暗黙の行列に対し、全行の `(最小値, argmin)` を `O((行数 + 列数) log 行数)` で求める。",
      "/// `コスト(i, j)` が行 `i`・列 `j` の値を返す。Monge（凸四角不等式）な行列で成り立つ。",
      "/// 同点のときはより小さい列を採用する。`列数 == 0` のときは全行 `(i64::MAX, 0)`。",
      "fn 単調最小値<F: Fn(usize, usize) -> i64>(",
      "    行数: usize,",
      "    列数: usize,",
      "    コスト: F,",
      ") -> Vec<(i64, usize)> {",
      "    let mut 結果 = vec![(i64::MAX, 0usize); 行数];",
      "    if 行数 == 0 || 列数 == 0 {",
      "        return 結果;",
      "    }",
      "    let mut スタック = vec![(0usize, 行数, 0usize, 列数 - 1)];",
      "    while let Some((行下, 行上, 列下, 列上)) = スタック.pop() {",
      "        if 行下 >= 行上 {",
      "            continue;",
      "        }",
      "        let 中 = (行下 + 行上) / 2;",
      "        let mut 最良値 = i64::MAX;",
      "        let mut 最良列 = 列下;",
      "        for j in 列下..=列上 {",
      "            let v = コスト(中, j);",
      "            if v < 最良値 {",
      "                最良値 = v;",
      "                最良列 = j;",
      "            }",
      "        }",
      "        結果[中] = (最良値, 最良列);",
      "        スタック.push((行下, 中, 列下, 最良列));",
      "        スタック.push((中 + 1, 行上, 最良列, 列上));",
      "    }",
      "    結果",
      "}",
      "/// 1 層の DP 遷移 `新[j] = min_{0 <= k <= j} ( 旧[k] + コスト(k, j) )` を、最適 `k` が `j` について",
      "/// 単調と仮定して `O(N log N)` で計算する（[`単調最小値`] を三角制約付きで適用）。",
      "/// `コスト(k, j)` は `k <= j` のときに呼ばれ、Monge 性（`コスト(a,c)+コスト(b,d) <= コスト(a,d)+コスト(b,c)`、",
      "/// `a<=b<=c<=d`）を満たすときに正しい。`旧[k] == i64::MAX` は到達不能として扱う（飽和加算）。",
      "/// 返り値の長さは `旧.len()`。",
      "fn 分割統治dp層<F: Fn(usize, usize) -> i64>(旧: &[i64], コスト: F) -> Vec<i64> {",
      "    let n = 旧.len();",
      "    let 行列 = |j: usize, k: usize| -> i64 {",
      "        if k <= j && 旧[k] != i64::MAX {",
      "            旧[k].saturating_add(コスト(k, j))",
      "        } else {",
      "            i64::MAX",
      "        }",
      "    };",
      "    単調最小値(n, n, 行列).into_iter().map(|(v, _)| v).collect()",
      "}"
    ]
  },
  "DominatorTree": {
    "scope": "rust",
    "prefix": "DominatorTree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから有向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺[i] = (u, v)` を `u → v` の一方向の辺として `グラフ[u]` にだけ積む。",
      "/// 逆辺が欲しい場合は `(v, u)` に読み替えてもう一度呼ぶ。",
      "fn 有向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "    }",
      "    グラフ",
      "}",
      "/// 支配木（dominator tree）を求める。`根` から各頂点への全経路が必ず通る頂点のうち",
      "/// 最も近いもの（直接支配点 idom）を返す。`辺` は AtCoder の入力そのまま",
      "/// （0-indexed の有向辺 `(u, v)` = `u → v`）。",
      "/// 返り値 `idom`：`idom[根] = 根`、到達可能な `v` は `idom[v]` がその直接支配点、到達不能な頂点は",
      "/// `!0`。制御フロー解析や「ある頂点を経由しないと到達できない頂点」の判定に使う。",
      "/// 最悪計算量は Lengauer–Tarjan の `O((V+E) log V)` に劣るが、実グラフでは十分高速。",
      "fn 支配木(n: usize, 辺: &[(usize, usize)], 根: usize) -> Vec<usize> {",
      "    let mut g = petgraph::graph::DiGraph::<(), ()>::new();",
      "    let 節: Vec<petgraph::graph::NodeIndex> = (0..n).map(|_| g.add_node(())).collect();",
      "    for &(v, u) in 辺 {",
      "        g.add_edge(節[v], 節[u], ());",
      "    }",
      "    let dom = petgraph::algo::dominators::simple_fast(&g, 節[根]);",
      "    let mut 結果 = vec![!0; n];",
      "    結果[根] = 根;",
      "    for (v, &節v) in 節.iter().enumerate() {",
      "        if v != 根",
      "            && let Some(d) = dom.immediate_dominator(節v)",
      "        {",
      "            結果[v] = d.index();",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "Duval": {
    "scope": "rust",
    "prefix": "Duval",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// リンドン分解（Duval のアルゴリズム）。列 `s` を、辞書順で非増加に並ぶリンドン語",
      "/// `w1 >= w2 >= ... >= wk` の連結に一意分解し、各因子の半開区間 `[開始, 終了)` を `O(n)` で返す。",
      "/// リンドン語とは「自身が、その全ての真の接尾辞より辞書順で真に小さい」空でない列。最小回転や",
      "/// suffix array の補助、文字列周期性の解析に使う。比較できる任意の要素列に使える。",
      "fn リンドン分解<T: Ord>(s: &[T]) -> Vec<(usize, usize)> {",
      "    let n = s.len();",
      "    let mut 結果 = Vec::new();",
      "    let mut i = 0;",
      "    while i < n {",
      "        let mut j = i + 1;",
      "        let mut k = i;",
      "        while j < n && s[k] <= s[j] {",
      "            if s[k] < s[j] {",
      "                k = i;",
      "            } else {",
      "                k += 1;",
      "            }",
      "            j += 1;",
      "        }",
      "        while i <= k {",
      "            結果.push((i, i + (j - k)));",
      "            i += j - k;",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
  "DynamicConnectivity": {
    "scope": "rust",
    "prefix": "DynamicConnectivity",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// オフライン動的連結性で使う巻き戻し（Undo）可能 Union-Find。経路圧縮せずユニオン by サイズで結合し、",
      "/// 各結合をスタックに積んで任意時点へ復元する。`連結成分数` も追跡する。",
      "struct 巻き戻しDSU {",
      "    親orサイズ: Vec<i64>,",
      "    履歴: Vec<(usize, i64)>,",
      "    成分数: usize,",
      "}",
      "impl 巻き戻しDSU {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親orサイズ: vec![-1; n],",
      "            履歴: Vec::new(),",
      "            成分数: n,",
      "        }",
      "    }",
      "    /// `x` の根（経路圧縮なし）。",
      "    fn 根(&self, mut x: usize) -> usize {",
      "        while self.親orサイズ[x] >= 0 {",
      "            x = self.親orサイズ[x] as usize;",
      "        }",
      "        x",
      "    }",
      "    /// `x` と `y` が同じ集合か。",
      "    fn 同じ(&self, x: usize, y: usize) -> bool {",
      "        self.根(x) == self.根(y)",
      "    }",
      "    /// `x` の属する集合の要素数。",
      "    fn サイズ(&self, x: usize) -> usize {",
      "        let r = self.根(x);",
      "        (-self.親orサイズ[r]) as usize",
      "    }",
      "    /// 現在の連結成分数。",
      "    fn 連結成分数(&self) -> usize {",
      "        self.成分数",
      "    }",
      "    /// `x` と `y` を結合する。既に同じ集合なら `false`。",
      "    fn 統合(&mut self, x: usize, y: usize) -> bool {",
      "        let mut a = self.根(x);",
      "        let mut b = self.根(y);",
      "        if a == b {",
      "            return false;",
      "        }",
      "        if self.親orサイズ[a] > self.親orサイズ[b] {",
      "            std::mem::swap(&mut a, &mut b);",
      "        }",
      "        self.履歴.push((a, self.親orサイズ[a]));",
      "        self.履歴.push((b, self.親orサイズ[b]));",
      "        self.親orサイズ[a] += self.親orサイズ[b];",
      "        self.親orサイズ[b] = a as i64;",
      "        self.成分数 -= 1;",
      "        true",
      "    }",
      "    /// 現在のスナップショット（履歴長）。",
      "    fn 現在時点(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    /// `時点` まで状態を巻き戻す（履歴は 1 結合につき 2 件）。成分数も復元する。",
      "    fn ロールバック(&mut self, 時点: usize) {",
      "        let 結合数 = (self.履歴.len() - 時点) / 2;",
      "        while self.履歴.len() > 時点 {",
      "            let (i, v) = self.履歴.pop().unwrap();",
      "            self.親orサイズ[i] = v;",
      "        }",
      "        self.成分数 += 結合数;",
      "    }",
      "}",
      "/// オフライン動的連結性。辺の追加・削除がある時系列（時刻 `0..T`）に対し、各時刻での連結性を一括で求める。",
      "/// 「各辺が存在する時刻区間 `[開始, 終了)`」を時間方向のセグメント木に載せて分割統治する。",
      "/// 全体 `O((辺 + T) log T α)`。クエリを先読みできる（オフライン）ことが前提。",
      "/// - [`Self::辺追加`] : 辺 `(u, v)` が存在する時刻区間を登録。",
      "/// - [`Self::解く`] : 各時刻 `t` でコールバックに DSU を渡す。",
      "struct オフライン動的連結性 {",
      "    時刻数: usize,",
      "    頂点数: usize,",
      "    辺: Vec<Vec<(usize, usize)>>,",
      "}",
      "impl オフライン動的連結性 {",
      "    /// 頂点数 `頂点数`、時刻数 `時刻数`（時刻は `0..時刻数`）で初期化する。",
      "    fn new(頂点数: usize, 時刻数: usize) -> Self {",
      "        Self {",
      "            時刻数,",
      "            頂点数,",
      "            辺: vec![Vec::new(); 4 * 時刻数.max(1)],",
      "        }",
      "    }",
      "    /// 辺 `(u, v)` が時刻区間 `[開始, 終了)` に存在することを登録する。",
      "    fn 辺追加(&mut self, u: usize, v: usize, 開始: usize, 終了: usize) {",
      "        if 開始 < 終了 {",
      "            self.区間に追加(1, 0, self.時刻数, 開始, 終了, (u, v));",
      "        }",
      "    }",
      "    fn 区間に追加(",
      "        &mut self,",
      "        節点: usize,",
      "        nl: usize,",
      "        nr: usize,",
      "        l: usize,",
      "        r: usize,",
      "        辺: (usize, usize),",
      "    ) {",
      "        if r <= nl || nr <= l {",
      "            return;",
      "        }",
      "        if l <= nl && nr <= r {",
      "            self.辺[節点].push(辺);",
      "            return;",
      "        }",
      "        let 中 = (nl + nr) / 2;",
      "        self.区間に追加(2 * 節点, nl, 中, l, r, 辺);",
      "        self.区間に追加(2 * 節点 + 1, 中, nr, l, r, 辺);",
      "    }",
      "    /// セグメント木を DFS し、各時刻 `t`（`0..時刻数`）でその時点の DSU をコールバックに渡す。",
      "    fn 解く<F: FnMut(usize, &巻き戻しDSU)>(&self, mut 処理: F) {",
      "        if self.時刻数 == 0 {",
      "            return;",
      "        }",
      "        let mut dsu = 巻き戻しDSU::new(self.頂点数);",
      "        self.探索(1, 0, self.時刻数, &mut dsu, &mut 処理);",
      "    }",
      "    fn 探索<F: FnMut(usize, &巻き戻しDSU)>(",
      "        &self,",
      "        節点: usize,",
      "        nl: usize,",
      "        nr: usize,",
      "        dsu: &mut 巻き戻しDSU,",
      "        処理: &mut F,",
      "    ) {",
      "        let スナップ = dsu.現在時点();",
      "        for &(u, v) in &self.辺[節点] {",
      "            dsu.統合(u, v);",
      "        }",
      "        if nr - nl == 1 {",
      "            処理(nl, dsu);",
      "        } else {",
      "            let 中 = (nl + nr) / 2;",
      "            self.探索(2 * 節点, nl, 中, dsu, 処理);",
      "            self.探索(2 * 節点 + 1, 中, nr, dsu, 処理);",
      "        }",
      "        dsu.ロールバック(スナップ);",
      "    }",
      "}"
    ]
  },
  "EdmondsBlossom": {
    "scope": "rust",
    "prefix": "EdmondsBlossom",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 一般グラフ（二部とは限らない、奇閉路を含んでよい）の最大マッチング。O(V·E)。",
      "/// 二部グラフに限るなら [`crate::hopcroft_karp`] の方が高速。",
      "/// - [`Self::最大マッチング`] : マッチした本数を返す（内部に相手も保持）。",
      "/// - [`Self::相手一覧`] : 各頂点の相手（未マッチは -1）。",
      "struct 一般マッチング {",
      "    n: usize,",
      "    辺: Vec<(usize, usize)>,",
      "    相手: Vec<i64>,",
      "}",
      "impl 一般マッチング {",
      "    /// 頂点数 `n` の空グラフを作る。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            n,",
      "            辺: Vec::new(),",
      "            相手: vec![-1; n],",
      "        }",
      "    }",
      "    /// 無向辺 `u - v` を追加する。",
      "    fn 辺追加(&mut self, u: usize, v: usize) {",
      "        self.辺.push((u, v));",
      "    }",
      "    /// 最大マッチングの本数を求める。",
      "    fn 最大マッチング(&mut self) -> usize {",
      "        let mut g = petgraph::graph::UnGraph::<(), ()>::new_undirected();",
      "        let 節: Vec<petgraph::graph::NodeIndex> = (0..self.n).map(|_| g.add_node(())).collect();",
      "        for &(u, v) in &self.辺 {",
      "            g.add_edge(節[u], 節[v], ());",
      "        }",
      "        let マッチング = petgraph::algo::maximum_matching(&g);",
      "        self.相手 = vec![-1; self.n];",
      "        let mut 本数 = 0;",
      "        for (a, b) in マッチング.edges() {",
      "            self.相手[a.index()] = b.index() as i64;",
      "            self.相手[b.index()] = a.index() as i64;",
      "            本数 += 1;",
      "        }",
      "        本数",
      "    }",
      "    /// 各頂点の相手（未マッチは -1）。先に [`Self::最大マッチング`] を呼ぶこと。",
      "    fn 相手一覧(&self) -> &[i64] {",
      "        &self.相手",
      "    }",
      "}"
    ]
  },
  "Eertree": {
    "scope": "rust",
    "prefix": "Eertree",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 回文木（Eertree / Palindromic Tree）の 1 ノード。`len` は表す回文の長さ",
      "/// （根は -1 と 0）、`suff` は最長の真回文接尾辞へのリンク、`次` は文字ごとの遷移、",
      "/// `出現` はその回文が「最長回文接尾辞」として現れた回数。",
      "struct 回文ノード {",
      "    len: i64,",
      "    suff: usize,",
      "    次: HashMap<u8, usize>,",
      "    出現: usize,",
      "}",
      "/// 回文木（Eertree）。文字列の全「相異なる回文部分文字列」を O(N) 個のノードで表す。構築 O(N)",
      "/// （アルファベットは `HashMap` 管理）。`manacher` は中心ごとの最大回文半径、`suffix_automaton` は",
      "/// 全部分文字列を扱うが、回文部分文字列の列挙・計数にはこの構造が向く。",
      "/// - [`Self::相異なる回文数`] : 空でない相異なる回文部分文字列の個数。",
      "/// - [`Self::回文部分文字列の総数`] : 回文となる部分文字列 `(i, j)` の総数（重複含む）。",
      "struct 回文木 {",
      "    ノード: Vec<回文ノード>,",
      "    最後: usize,",
      "    s: Vec<u8>,",
      "}",
      "impl 回文木 {",
      "    fn new() -> Self {",
      "        let 虚根 = 回文ノード {",
      "            len: -1,",
      "            suff: 0,",
      "            次: HashMap::new(),",
      "            出現: 0,",
      "        };",
      "        let 空根 = 回文ノード {",
      "            len: 0,",
      "            suff: 0,",
      "            次: HashMap::new(),",
      "            出現: 0,",
      "        };",
      "        Self {",
      "            ノード: vec![虚根, 空根],",
      "            最後: 1,",
      "            s: Vec::new(),",
      "        }",
      "    }",
      "    /// バイト列から構築する。",
      "    fn 構築(s: &[u8]) -> Self {",
      "        let mut t = Self::new();",
      "        for &c in s {",
      "            t.追加(c);",
      "        }",
      "        t",
      "    }",
      "    /// `位置` の文字 `c` を末尾に追加したとき、`位置` で終わる最長回文接尾辞のノードを返す。",
      "    fn リンクを辿る(&self, mut v: usize, 位置: usize, c: u8) -> usize {",
      "        loop {",
      "            let len = self.ノード[v].len;",
      "            let i = 位置 as i64 - len - 1;",
      "            if i >= 0 && self.s[i as usize] == c {",
      "                return v;",
      "            }",
      "            v = self.ノード[v].suff;",
      "        }",
      "    }",
      "    /// 末尾に 1 文字追加する。新しい相異なる回文が生まれたら true。",
      "    fn 追加(&mut self, c: u8) -> bool {",
      "        let 位置 = self.s.len();",
      "        self.s.push(c);",
      "        let 親 = self.リンクを辿る(self.最後, 位置, c);",
      "        if let Some(&既存) = self.ノード[親].次.get(&c) {",
      "            self.最後 = 既存;",
      "            self.ノード[既存].出現 += 1;",
      "            return false;",
      "        }",
      "        let 新 = self.ノード.len();",
      "        let 新len = self.ノード[親].len + 2;",
      "        let 新suff = if 新len == 1 {",
      "            1",
      "        } else {",
      "            let t = self.リンクを辿る(self.ノード[親].suff, 位置, c);",
      "            self.ノード[t].次[&c]",
      "        };",
      "        self.ノード.push(回文ノード {",
      "            len: 新len,",
      "            suff: 新suff,",
      "            次: HashMap::new(),",
      "            出現: 1,",
      "        });",
      "        self.ノード[親].次.insert(c, 新);",
      "        self.最後 = 新;",
      "        true",
      "    }",
      "    /// 空でない相異なる回文部分文字列の個数（2 つの根を除いたノード数）。",
      "    fn 相異なる回文数(&self) -> usize {",
      "        self.ノード.len() - 2",
      "    }",
      "    /// 回文となる部分文字列 `(i, j)` の総数（重複を含む）。O(ノード数)。",
      "    fn 回文部分文字列の総数(&self) -> usize {",
      "        let mut 出現: Vec<usize> = self.ノード.iter().map(|n| n.出現).collect();",
      "        for v in (2..self.ノード.len()).rev() {",
      "            let s = self.ノード[v].suff;",
      "            出現[s] += 出現[v];",
      "        }",
      "        出現[2..].iter().sum()",
      "    }",
      "}",
      "impl Default for 回文木 {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
  "FFT": {
    "scope": "rust",
    "prefix": "FFT",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use num::complex::Complex64;",
      "/// 複素 FFT（反復版）。`逆 = true` で逆変換。`a.len()` は 2 冪であること。内部関数。",
      "fn fft内部(a: &mut [Complex64], 逆: bool) {",
      "    let n = a.len();",
      "    if n <= 1 {",
      "        return;",
      "    }",
      "    let mut j = 0usize;",
      "    for i in 1..n {",
      "        let mut bit = n >> 1;",
      "        while j & bit != 0 {",
      "            j ^= bit;",
      "            bit >>= 1;",
      "        }",
      "        j |= bit;",
      "        if i < j {",
      "            a.swap(i, j);",
      "        }",
      "    }",
      "    let mut len = 2;",
      "    while len <= n {",
      "        let 符号 = if 逆 { -1.0 } else { 1.0 };",
      "        let 角度 = 2.0 * std::f64::consts::PI / len as f64 * 符号;",
      "        let w_len = Complex64::new(角度.cos(), 角度.sin());",
      "        let mut i = 0;",
      "        while i < n {",
      "            let mut w = Complex64::new(1.0, 0.0);",
      "            for k in 0..len / 2 {",
      "                let u = a[i + k];",
      "                let v = a[i + k + len / 2] * w;",
      "                a[i + k] = u + v;",
      "                a[i + k + len / 2] = u - v;",
      "                w *= w_len;",
      "            }",
      "            i += len;",
      "        }",
      "        len <<= 1;",
      "    }",
      "    if 逆 {",
      "        let 逆数 = 1.0 / n as f64;",
      "        for x in a.iter_mut() {",
      "            *x *= 逆数;",
      "        }",
      "    }",
      "}",
      "/// 整数列 `a`, `b` の畳み込み（多項式の積の係数）を FFT で求める。O(M log M)。",
      "/// 返り値の長さは `a.len() + b.len() - 1`。`ac_library::convolution` は素数 mod 専用なので、",
      "/// mod を取らない素直な整数畳み込みが要るときにこちらを使う。値が大きいと `f64` 精度で",
      "/// 誤差が出る点に注意（おおむね 結果の各項 < 2^52 まで安全）。",
      "fn 畳み込み(a: &[i64], b: &[i64]) -> Vec<i64> {",
      "    if a.is_empty() || b.is_empty() {",
      "        return Vec::new();",
      "    }",
      "    let 結果長 = a.len() + b.len() - 1;",
      "    let mut サイズ = 1usize;",
      "    while サイズ < 結果長 {",
      "        サイズ <<= 1;",
      "    }",
      "    let mut fa: Vec<Complex64> = (0..サイズ)",
      "        .map(|i| Complex64::new(*a.get(i).unwrap_or(&0) as f64, 0.0))",
      "        .collect();",
      "    let mut fb: Vec<Complex64> = (0..サイズ)",
      "        .map(|i| Complex64::new(*b.get(i).unwrap_or(&0) as f64, 0.0))",
      "        .collect();",
      "    fft内部(&mut fa, false);",
      "    fft内部(&mut fb, false);",
      "    for (x, y) in fa.iter_mut().zip(fb.iter()) {",
      "        *x *= *y;",
      "    }",
      "    fft内部(&mut fa, true);",
      "    fa.iter()",
      "        .take(結果長)",
      "        .map(|c| c.re.round() as i64)",
      "        .collect()",
      "}"
    ]
  },
  "FPS": {
    "scope": "rust",
    "prefix": "FPS",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, ModInt998244353};",
      "/// 形式的冪級数（FPS）で扱う係数の型。mod 998244353（NTT フレンドリ素数）。",
      "type 係数 = ModInt998244353;",
      "/// 形式的微分。`f = Σ a_i x^i` → `Σ i·a_i x^{i-1}`。",
      "fn 微分(f: &[係数]) -> Vec<係数> {",
      "    if f.len() <= 1 {",
      "        return Vec::new();",
      "    }",
      "    (1..f.len()).map(|i| f[i] * 係数::new(i as u64)).collect()",
      "}",
      "/// 形式的積分。`f = Σ a_i x^i` → `Σ a_i/(i+1) x^{i+1}`（定数項 0）。",
      "fn 積分(f: &[係数]) -> Vec<係数> {",
      "    let mut r = vec![係数::new(0); f.len() + 1];",
      "    for (i, &c) in f.iter().enumerate() {",
      "        r[i + 1] = c * 係数::new((i + 1) as u64).inv();",
      "    }",
      "    r",
      "}",
      "/// `f * g ≡ 1 (mod x^n)` なる逆元 `g`（長さ `n`）を Newton 法で求める。O(n log n)。",
      "/// 定数項が 0 のときは逆元が存在しないので panic する。乗算には `ac_library::convolution`（NTT）を使う。",
      "fn 逆元(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        !f.is_empty() && f[0].val() != 0,",
      "        \"constant term must be nonzero\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut g = vec![f[0].inv()];",
      "    let mut k = 1;",
      "    while k < n {",
      "        k <<= 1;",
      "        let 上限 = k.min(f.len());",
      "        let mut fg = convolution(&f[..上限], &g);",
      "        fg.truncate(k);",
      "        for x in fg.iter_mut() {",
      "            *x = -*x;",
      "        }",
      "        fg[0] += 係数::new(2);",
      "        let mut ng = convolution(&g, &fg);",
      "        ng.truncate(k);",
      "        g = ng;",
      "    }",
      "    g.truncate(n);",
      "    g.resize(n, 係数::new(0));",
      "    g",
      "}",
      "/// `log f` を mod x^n で求める（長さ `n`）。定数項は 1 でなければならない。`log f = ∫ f'/f`。",
      "fn log(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        !f.is_empty() && f[0].val() == 1,",
      "        \"constant term must be 1 for log\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    if n == 1 {",
      "        return vec![係数::new(0)];",
      "    }",
      "    let fd = 微分(f);",
      "    let fi = 逆元(f, n);",
      "    let mut prod = convolution(&fd, &fi);",
      "    prod.truncate(n - 1);",
      "    let mut r = 積分(&prod);",
      "    r.truncate(n);",
      "    r.resize(n, 係数::new(0));",
      "    r",
      "}",
      "/// `exp f` を mod x^n で求める（長さ `n`）。定数項は 0 でなければならない。Newton 法で O(n log n)。",
      "fn exp(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        f.is_empty() || f[0].val() == 0,",
      "        \"constant term must be 0 for exp\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < n {",
      "        k <<= 1;",
      "        let lg = log(&g, k);",
      "        let mut h = vec![係数::new(0); k];",
      "        h[0] = 係数::new(1);",
      "        for (i, hi) in h.iter_mut().enumerate() {",
      "            *hi -= lg[i];",
      "            if i < f.len() {",
      "                *hi += f[i];",
      "            }",
      "        }",
      "        let mut ng = convolution(&g, &h);",
      "        ng.truncate(k);",
      "        g = ng;",
      "    }",
      "    g.truncate(n);",
      "    g.resize(n, 係数::new(0));",
      "    g",
      "}",
      "/// `f^m` を mod x^n で求める（長さ `n`）。最低次の非零項を括り出し `exp(m·log)` で計算する。",
      "/// `f ≡ 0` でも `m == 0` でも正しく扱う（`0^0 = 1`）。",
      "fn 累乗(f: &[係数], m: impl TryInto<u64>, n: usize) -> Vec<係数> {",
      "    let m: u64 = m.try_into().ok().expect(\"累乗: 引数が u64 に収まりません\");",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    if m == 0 {",
      "        let mut r = vec![係数::new(0); n];",
      "        r[0] = 係数::new(1);",
      "        return r;",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return vec![係数::new(0); n];",
      "    }",
      "    if (d as u128) * (m as u128) >= n as u128 {",
      "        return vec![係数::new(0); n];",
      "    }",
      "    let shift = d * (m as usize);",
      "    let len = n - shift;",
      "    let c = f[d];",
      "    let cinv = c.inv();",
      "    let g: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let lg = log(&g, len);",
      "    let mm = 係数::new(m);",
      "    let scaled: Vec<係数> = lg.iter().map(|&x| x * mm).collect();",
      "    let eg = exp(&scaled, len);",
      "    let cm = c.pow(m);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in eg.iter().enumerate() {",
      "        r[shift + i] = v * cm;",
      "    }",
      "    r",
      "}",
      "/// mod 998244353 上の平方根（Tonelli–Shanks）。`a` が平方剰余なら 1 つの解（小さい方）を `Some`、",
      "/// 非平方剰余なら `None` を返す。FPS 平方根の定数項計算に使う。`p - 1 = 2^23·119` なので確実に動く。",
      "fn 平方剰余の根(a: u64) -> Option<u64> {",
      "    const P: u64 = 998244353;",
      "    let a = a % P;",
      "    if a == 0 {",
      "        return Some(0);",
      "    }",
      "    let pw = |mut b: u64, mut e: u64| -> u64 {",
      "        let mut r = 1u64;",
      "        b %= P;",
      "        while e > 0 {",
      "            if e & 1 == 1 {",
      "                r = r * b % P;",
      "            }",
      "            b = b * b % P;",
      "            e >>= 1;",
      "        }",
      "        r",
      "    };",
      "    if pw(a, (P - 1) / 2) != 1 {",
      "        return None;",
      "    }",
      "    let mut q = P - 1;",
      "    let mut s = 0u32;",
      "    while q % 2 == 0 {",
      "        q /= 2;",
      "        s += 1;",
      "    }",
      "    let mut z = 2u64;",
      "    while pw(z, (P - 1) / 2) == 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = pw(z, q);",
      "    let mut t = pw(a, q);",
      "    let mut r = pw(a, q.div_ceil(2));",
      "    loop {",
      "        if t == 1 {",
      "            return Some(r.min(P - r));",
      "        }",
      "        let mut i = 0u32;",
      "        let mut tt = t;",
      "        while tt != 1 {",
      "            tt = tt * tt % P;",
      "            i += 1;",
      "        }",
      "        let b = pw(c, 1u64 << (m - i - 1));",
      "        m = i;",
      "        c = b * b % P;",
      "        t = t * c % P;",
      "        r = r * b % P;",
      "    }",
      "}",
      "/// `g^2 ≡ f (mod x^n)` なる平方根 `g`（長さ `n`）を Newton 法で求める。`O(n log n)`。",
      "/// 最低次の非零項の次数が奇数、または定数項が平方剰余でない場合は平方根が存在せず `None` を返す。",
      "/// `f ≡ 0` なら全 0 を返す。定数項が 1 でなくても（平方剰余であれば）扱える。",
      "fn 平方根(f: &[係数], n: usize) -> Option<Vec<係数>> {",
      "    if n == 0 {",
      "        return Some(Vec::new());",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    if d % 2 != 0 {",
      "        return None;",
      "    }",
      "    let c0 = 平方剰余の根(f[d].val() as u64)?;",
      "    let shift = d / 2;",
      "    if shift >= n {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    let len = n - shift;",
      "    let cinv = f[d].inv();",
      "    let h: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let 逆2 = 係数::new(2).inv();",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < len {",
      "        k <<= 1;",
      "        let 上限 = k.min(h.len());",
      "        let ig = 逆元(&g, k);",
      "        let mut t = convolution(&h[..上限], &ig);",
      "        t.truncate(k);",
      "        g.resize(k, 係数::new(0));",
      "        for (gi, &ti) in g.iter_mut().zip(t.iter()) {",
      "            *gi = (*gi + ti) * 逆2;",
      "        }",
      "    }",
      "    g.truncate(len);",
      "    let c = 係数::new(c0);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in g.iter().enumerate() {",
      "        r[shift + i] = v * c;",
      "    }",
      "    Some(r)",
      "}"
    ]
  },
  "Faulhaber": {
    "scope": "rust",
    "prefix": "Faulhaber",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 素数 `法` を法とする `a` の逆元（フェルマーの小定理 `a^(法-2)`）。`O(log 法)`。",
      "/// `法` が素数で `a % 法 != 0` であることが前提。合成数を法とする場合や `a` が",
      "/// `法` の倍数の場合は正しい値を返さない（拡張ユークリッドを使うこと）。",
      "fn 逆元(a: u64, 法: u64) -> u64 {",
      "    累乗_mod(a, 法 - 2, 法)",
      "}",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// `0..=上限` の階乗・逆階乗を素数 `法` 上で返す内部関数（二項係数用）。",
      "fn 階乗表(上限: usize, 法: u64) -> (Vec<u64>, Vec<u64>) {",
      "    let mut 階乗 = vec![1u64; 上限 + 1];",
      "    for i in 1..=上限 {",
      "        階乗[i] = 階乗[i - 1] * i as u64 % 法;",
      "    }",
      "    let mut 逆階乗 = vec![1u64; 上限 + 1];",
      "    逆階乗[上限] = 逆元(階乗[上限], 法);",
      "    for i in (0..上限).rev() {",
      "        逆階乗[i] = 逆階乗[i + 1] * (i as u64 + 1) % 法;",
      "    }",
      "    (階乗, 逆階乗)",
      "}",
      "/// ベルヌーイ数 `B_0, B_1, …, B_k` を素数 `法` 上で返す（`B_1 = -1/2` の規約）。`O(k^2)`。",
      "/// 累乗和（Faulhaber 公式）の係数として使う。",
      "fn ベルヌーイ数(k: usize, 法: impl TryInto<u64>) -> Vec<usize> {",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ベルヌーイ数: 引数が u64 に収まりません\");",
      "    let (階乗, 逆階乗) = 階乗表(k + 1, 法);",
      "    let 二項 = |n: usize, r: usize| -> u64 {",
      "        if r > n {",
      "            0",
      "        } else {",
      "            階乗[n] * 逆階乗[r] % 法 * 逆階乗[n - r] % 法",
      "        }",
      "    };",
      "    let mut b = vec![0u64; k + 1];",
      "    b[0] = 1 % 法;",
      "    for m in 1..=k {",
      "        let mut s = 0u64;",
      "        for (j, &bj) in b.iter().enumerate().take(m) {",
      "            s = (s + 二項(m + 1, j) * bj) % 法;",
      "        }",
      "        let 逆 = 逆元((m as u64 + 1) % 法, 法);",
      "        b[m] = (法 - s) % 法 * 逆 % 法;",
      "    }",
      "    b.into_iter().map(|x| x as usize).collect()",
      "}",
      "/// 累乗和 `Σ_{i=1}^{n} i^k mod 法`（`法` は素数）を Faulhaber の公式で `O(k^2)` で返す。`n` は最大 `u64`。",
      "/// 1 個の巨大な `n` と固定の `k` に対し、`n` をいくら大きくしても次数 `k` だけに依存して計算できる。",
      "/// ラグランジュ補間（[`lagrange_interpolation`](crate::lagrange_interpolation)）とは別手法。",
      "fn 累乗和(n: impl TryInto<u64>, k: usize, 法: impl TryInto<u64>) -> usize {",
      "    let n: u64 = n",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"累乗和: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"累乗和: 引数が u64 に収まりません\");",
      "    if k == 0 {",
      "        return (n % 法) as usize;",
      "    }",
      "    let b = ベルヌーイ数(k, 法);",
      "    let (階乗, 逆階乗) = 階乗表(k + 1, 法);",
      "    let 二項 = |n: usize, r: usize| -> u64 {",
      "        if r > n {",
      "            0",
      "        } else {",
      "            階乗[n] * 逆階乗[r] % 法 * 逆階乗[n - r] % 法",
      "        }",
      "    };",
      "    let m = (n % 法 + 1) % 法;",
      "    let mut s = 0u64;",
      "    for (j, &bj) in b.iter().enumerate() {",
      "        let 項 = 二項(k + 1, j) * bj as u64 % 法 * 累乗_mod(m, (k + 1 - j) as u64, 法) % 法;",
      "        s = (s + 項) % 法;",
      "    }",
      "    (s * 逆元((k as u64 + 1) % 法, 法) % 法) as usize",
      "}"
    ]
  },
  "FormalPowerSeries": {
    "scope": "rust",
    "prefix": "FormalPowerSeries",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, ModInt998244353};",
      "/// 形式的冪級数（FPS）で扱う係数の型。mod 998244353（NTT フレンドリ素数）。",
      "type 係数 = ModInt998244353;",
      "/// 形式的微分。`f = Σ a_i x^i` → `Σ i·a_i x^{i-1}`。",
      "fn 微分(f: &[係数]) -> Vec<係数> {",
      "    if f.len() <= 1 {",
      "        return Vec::new();",
      "    }",
      "    (1..f.len()).map(|i| f[i] * 係数::new(i as u64)).collect()",
      "}",
      "/// 形式的積分。`f = Σ a_i x^i` → `Σ a_i/(i+1) x^{i+1}`（定数項 0）。",
      "fn 積分(f: &[係数]) -> Vec<係数> {",
      "    let mut r = vec![係数::new(0); f.len() + 1];",
      "    for (i, &c) in f.iter().enumerate() {",
      "        r[i + 1] = c * 係数::new((i + 1) as u64).inv();",
      "    }",
      "    r",
      "}",
      "/// `f * g ≡ 1 (mod x^n)` なる逆元 `g`（長さ `n`）を Newton 法で求める。O(n log n)。",
      "/// 定数項が 0 のときは逆元が存在しないので panic する。乗算には `ac_library::convolution`（NTT）を使う。",
      "fn 逆元(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        !f.is_empty() && f[0].val() != 0,",
      "        \"constant term must be nonzero\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut g = vec![f[0].inv()];",
      "    let mut k = 1;",
      "    while k < n {",
      "        k <<= 1;",
      "        let 上限 = k.min(f.len());",
      "        let mut fg = convolution(&f[..上限], &g);",
      "        fg.truncate(k);",
      "        for x in fg.iter_mut() {",
      "            *x = -*x;",
      "        }",
      "        fg[0] += 係数::new(2);",
      "        let mut ng = convolution(&g, &fg);",
      "        ng.truncate(k);",
      "        g = ng;",
      "    }",
      "    g.truncate(n);",
      "    g.resize(n, 係数::new(0));",
      "    g",
      "}",
      "/// `log f` を mod x^n で求める（長さ `n`）。定数項は 1 でなければならない。`log f = ∫ f'/f`。",
      "fn log(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        !f.is_empty() && f[0].val() == 1,",
      "        \"constant term must be 1 for log\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    if n == 1 {",
      "        return vec![係数::new(0)];",
      "    }",
      "    let fd = 微分(f);",
      "    let fi = 逆元(f, n);",
      "    let mut prod = convolution(&fd, &fi);",
      "    prod.truncate(n - 1);",
      "    let mut r = 積分(&prod);",
      "    r.truncate(n);",
      "    r.resize(n, 係数::new(0));",
      "    r",
      "}",
      "/// `exp f` を mod x^n で求める（長さ `n`）。定数項は 0 でなければならない。Newton 法で O(n log n)。",
      "fn exp(f: &[係数], n: usize) -> Vec<係数> {",
      "    assert!(",
      "        f.is_empty() || f[0].val() == 0,",
      "        \"constant term must be 0 for exp\"",
      "    );",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < n {",
      "        k <<= 1;",
      "        let lg = log(&g, k);",
      "        let mut h = vec![係数::new(0); k];",
      "        h[0] = 係数::new(1);",
      "        for (i, hi) in h.iter_mut().enumerate() {",
      "            *hi -= lg[i];",
      "            if i < f.len() {",
      "                *hi += f[i];",
      "            }",
      "        }",
      "        let mut ng = convolution(&g, &h);",
      "        ng.truncate(k);",
      "        g = ng;",
      "    }",
      "    g.truncate(n);",
      "    g.resize(n, 係数::new(0));",
      "    g",
      "}",
      "/// `f^m` を mod x^n で求める（長さ `n`）。最低次の非零項を括り出し `exp(m·log)` で計算する。",
      "/// `f ≡ 0` でも `m == 0` でも正しく扱う（`0^0 = 1`）。",
      "fn 累乗(f: &[係数], m: impl TryInto<u64>, n: usize) -> Vec<係数> {",
      "    let m: u64 = m.try_into().ok().expect(\"累乗: 引数が u64 に収まりません\");",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    if m == 0 {",
      "        let mut r = vec![係数::new(0); n];",
      "        r[0] = 係数::new(1);",
      "        return r;",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return vec![係数::new(0); n];",
      "    }",
      "    if (d as u128) * (m as u128) >= n as u128 {",
      "        return vec![係数::new(0); n];",
      "    }",
      "    let shift = d * (m as usize);",
      "    let len = n - shift;",
      "    let c = f[d];",
      "    let cinv = c.inv();",
      "    let g: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let lg = log(&g, len);",
      "    let mm = 係数::new(m);",
      "    let scaled: Vec<係数> = lg.iter().map(|&x| x * mm).collect();",
      "    let eg = exp(&scaled, len);",
      "    let cm = c.pow(m);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in eg.iter().enumerate() {",
      "        r[shift + i] = v * cm;",
      "    }",
      "    r",
      "}",
      "/// mod 998244353 上の平方根（Tonelli–Shanks）。`a` が平方剰余なら 1 つの解（小さい方）を `Some`、",
      "/// 非平方剰余なら `None` を返す。FPS 平方根の定数項計算に使う。`p - 1 = 2^23·119` なので確実に動く。",
      "fn 平方剰余の根(a: u64) -> Option<u64> {",
      "    const P: u64 = 998244353;",
      "    let a = a % P;",
      "    if a == 0 {",
      "        return Some(0);",
      "    }",
      "    let pw = |mut b: u64, mut e: u64| -> u64 {",
      "        let mut r = 1u64;",
      "        b %= P;",
      "        while e > 0 {",
      "            if e & 1 == 1 {",
      "                r = r * b % P;",
      "            }",
      "            b = b * b % P;",
      "            e >>= 1;",
      "        }",
      "        r",
      "    };",
      "    if pw(a, (P - 1) / 2) != 1 {",
      "        return None;",
      "    }",
      "    let mut q = P - 1;",
      "    let mut s = 0u32;",
      "    while q % 2 == 0 {",
      "        q /= 2;",
      "        s += 1;",
      "    }",
      "    let mut z = 2u64;",
      "    while pw(z, (P - 1) / 2) == 1 {",
      "        z += 1;",
      "    }",
      "    let mut m = s;",
      "    let mut c = pw(z, q);",
      "    let mut t = pw(a, q);",
      "    let mut r = pw(a, q.div_ceil(2));",
      "    loop {",
      "        if t == 1 {",
      "            return Some(r.min(P - r));",
      "        }",
      "        let mut i = 0u32;",
      "        let mut tt = t;",
      "        while tt != 1 {",
      "            tt = tt * tt % P;",
      "            i += 1;",
      "        }",
      "        let b = pw(c, 1u64 << (m - i - 1));",
      "        m = i;",
      "        c = b * b % P;",
      "        t = t * c % P;",
      "        r = r * b % P;",
      "    }",
      "}",
      "/// `g^2 ≡ f (mod x^n)` なる平方根 `g`（長さ `n`）を Newton 法で求める。`O(n log n)`。",
      "/// 最低次の非零項の次数が奇数、または定数項が平方剰余でない場合は平方根が存在せず `None` を返す。",
      "/// `f ≡ 0` なら全 0 を返す。定数項が 1 でなくても（平方剰余であれば）扱える。",
      "fn 平方根(f: &[係数], n: usize) -> Option<Vec<係数>> {",
      "    if n == 0 {",
      "        return Some(Vec::new());",
      "    }",
      "    let mut d = 0usize;",
      "    while d < f.len() && f[d].val() == 0 {",
      "        d += 1;",
      "    }",
      "    if d == f.len() {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    if d % 2 != 0 {",
      "        return None;",
      "    }",
      "    let c0 = 平方剰余の根(f[d].val() as u64)?;",
      "    let shift = d / 2;",
      "    if shift >= n {",
      "        return Some(vec![係数::new(0); n]);",
      "    }",
      "    let len = n - shift;",
      "    let cinv = f[d].inv();",
      "    let h: Vec<係数> = (0..len)",
      "        .map(|i| {",
      "            let idx = d + i;",
      "            if idx < f.len() {",
      "                f[idx] * cinv",
      "            } else {",
      "                係数::new(0)",
      "            }",
      "        })",
      "        .collect();",
      "    let 逆2 = 係数::new(2).inv();",
      "    let mut g = vec![係数::new(1)];",
      "    let mut k = 1;",
      "    while k < len {",
      "        k <<= 1;",
      "        let 上限 = k.min(h.len());",
      "        let ig = 逆元(&g, k);",
      "        let mut t = convolution(&h[..上限], &ig);",
      "        t.truncate(k);",
      "        g.resize(k, 係数::new(0));",
      "        for (gi, &ti) in g.iter_mut().zip(t.iter()) {",
      "            *gi = (*gi + ti) * 逆2;",
      "        }",
      "    }",
      "    g.truncate(len);",
      "    let c = 係数::new(c0);",
      "    let mut r = vec![係数::new(0); n];",
      "    for (i, &v) in g.iter().enumerate() {",
      "        r[shift + i] = v * c;",
      "    }",
      "    Some(r)",
      "}"
    ]
  },
  "GF2_掃き出し": {
    "scope": "rust",
    "prefix": "GF2_掃き出し",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// GF(2) 上の連立一次方程式 `A x = b` を掃き出し（ガウス消去）で解く。O(式数 · 変数数)。",
      "/// 変数は `0..変数数`（`変数数 <= 63`）。各式は `(係数ビット集合, 右辺)` で表し、",
      "/// 係数ビット集合の `k` ビット目が立っていれば変数 `x_k` を含む。右辺は 0/1。",
      "/// 解が無ければ `None`。`Some(解)` は解の一つ（自由変数は 0 とおく）。",
      "/// 実数の連立方程式は `nalgebra` を使うこと。これは XOR（mod 2）専用。",
      "fn xor連立方程式(変数数: usize, 式: &[(u64, u8)]) -> Option<Vec<u8>> {",
      "    let 右辺ビット = 1u64 << 変数数;",
      "    let mut 行: Vec<u64> = 式",
      "        .iter()",
      "        .map(|&(係数, b)| 係数 | ((b as u64 & 1) << 変数数))",
      "        .collect();",
      "    let mut ピボット行 = vec![!0; 変数数];",
      "    let mut 行位置 = 0usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for 列 in 0..変数数 {",
      "        let Some(選択) = (行位置..行.len()).find(|&r| 行[r] >> 列 & 1 == 1) else {",
      "            continue;",
      "        };",
      "        行.swap(行位置, 選択);",
      "        let 基準 = 行[行位置];",
      "        for (r, row) in 行.iter_mut().enumerate() {",
      "            if r != 行位置 && *row >> 列 & 1 == 1 {",
      "                *row ^= 基準;",
      "            }",
      "        }",
      "        ピボット行[列] = 行位置;",
      "        行位置 += 1;",
      "    }",
      "    if 行[行位置..].contains(&右辺ビット) {",
      "        return None;",
      "    }",
      "    let mut 解 = vec![0u8; 変数数];",
      "    for (列, &pr) in ピボット行.iter().enumerate() {",
      "        if pr != !0 {",
      "            解[列] = ((行[pr] >> 変数数) & 1) as u8;",
      "        }",
      "    }",
      "    Some(解)",
      "}"
    ]
  },
  "GaleShapley": {
    "scope": "rust",
    "prefix": "GaleShapley",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::VecDeque;",
      "/// Gale–Shapley 法で安定マッチング（安定結婚問題の男性最適解）を求める。`O(n^2)`。",
      "/// `男性選好[m]` は男性 `m` の女性の選好順（先頭が最も好む）、`女性選好[w]` は女性 `w` の",
      "/// 男性の選好順。どちらも `0..n` の順列で、人数 `n` は両者で等しいこと。",
      "/// 返り値 `妻[m]` は男性 `m` の相手の女性。得られる結果はブロッキングペアの無い安定マッチングで、",
      "/// かつ全男性にとって最良（男性最適）。",
      "fn 安定マッチング(男性選好: &[Vec<usize>], 女性選好: &[Vec<usize>]) -> Vec<usize> {",
      "    let n = 男性選好.len();",
      "    assert_eq!(n, 女性選好.len());",
      "    if n == 0 {",
      "        return Vec::new();",
      "    }",
      "    let mut 女性順位 = vec![vec![0usize; n]; n];",
      "    for w in 0..n {",
      "        for (r, &m) in 女性選好[w].iter().enumerate() {",
      "            女性順位[w][m] = r;",
      "        }",
      "    }",
      "    let mut 次提案 = vec![0usize; n];",
      "    let mut 夫: Vec<Option<usize>> = vec![None; n];",
      "    let mut 自由: VecDeque<usize> = (0..n).collect();",
      "    while let Some(m) = 自由.pop_front() {",
      "        let w = 男性選好[m][次提案[m]];",
      "        次提案[m] += 1;",
      "        match 夫[w] {",
      "            None => 夫[w] = Some(m),",
      "            Some(m2) => {",
      "                if 女性順位[w][m] < 女性順位[w][m2] {",
      "                    夫[w] = Some(m);",
      "                    自由.push_back(m2);",
      "                } else {",
      "                    自由.push_back(m);",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 妻 = vec![0usize; n];",
      "    for w in 0..n {",
      "        妻[夫[w].unwrap()] = w;",
      "    }",
      "    妻",
      "}"
    ]
  },
  "Garner_畳み込み": {
    "scope": "rust",
    "prefix": "Garner_畳み込み",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::{convolution, inv_mod, ButterflyCache, Modulus, StaticModInt};",
      "use std::cell::RefCell;",
      "use std::thread::LocalKey;",
      "/// NTT 素数 1: `167772161 = 5·2^25 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法1 {}",
      "impl Modulus for 法1 {",
      "    const VALUE: u32 = 167_772_161;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法1 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// NTT 素数 2: `469762049 = 7·2^26 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法2 {}",
      "impl Modulus for 法2 {",
      "    const VALUE: u32 = 469_762_049;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法2 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// NTT 素数 3: `1224736769 = 73·2^24 + 1`。",
      "#[derive(Copy, Clone, PartialEq, Eq)]",
      "enum 法3 {}",
      "impl Modulus for 法3 {",
      "    const VALUE: u32 = 1_224_736_769;",
      "    const HINT_VALUE_IS_PRIME: bool = true;",
      "    fn butterfly_cache() -> &'static LocalKey<RefCell<Option<ButterflyCache<Self>>>> {",
      "        thread_local! {static C : RefCell < Option < ButterflyCache < 法3 >>> = RefCell :: default () ; }",
      "        &C",
      "    }",
      "}",
      "/// 1 つの NTT 素数 `M` 上で `a * b`（係数を `法` で還元したもの）を畳み込む。",
      "fn 単一畳み込み<M: Modulus>(a: &[u64], b: &[u64], 法: u64) -> Vec<u64> {",
      "    let fa: Vec<StaticModInt<M>> = a.iter().map(|&x| StaticModInt::new(x % 法)).collect();",
      "    let fb: Vec<StaticModInt<M>> = b.iter().map(|&x| StaticModInt::new(x % 法)).collect();",
      "    convolution(&fa, &fb)",
      "        .iter()",
      "        .map(|x| x.val() as u64)",
      "        .collect()",
      "}",
      "/// 任意の法 `法` での畳み込み `c[k] = Σ_i a[i]·b[k-i] mod 法`。O(n log n)。",
      "/// 3 つの NTT 素数で畳み込み、Garner（CRT）で厳密値を復元してから `法` を取る。",
      "/// `法` と係数が ~2·10^9 未満なら正しい（厳密値が 3 素数の積 ≈ 9.6·10^25 に収まる範囲）。",
      "/// mod が NTT 素数（998244353 等）なら `ac_library::convolution` の方が速い。",
      "fn 任意mod畳み込み(",
      "    a: &[impl TryInto<u64> + Copy],",
      "    b: &[impl TryInto<u64> + Copy],",
      "    法: impl TryInto<u64>,",
      ") -> Vec<usize> {",
      "    let a: Vec<u64> = a",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"任意mod畳み込み: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let b: Vec<u64> = b",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"任意mod畳み込み: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let (a, b) = (&a[..], &b[..]);",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"任意mod畳み込み: 引数が u64 に収まりません\");",
      "    if a.is_empty() || b.is_empty() {",
      "        return Vec::new();",
      "    }",
      "    let p1 = 法1::VALUE as i128;",
      "    let p2 = 法2::VALUE as i128;",
      "    let p3 = 法3::VALUE as i128;",
      "    let r1 = 単一畳み込み::<法1>(a, b, 法);",
      "    let r2 = 単一畳み込み::<法2>(a, b, 法);",
      "    let r3 = 単一畳み込み::<法3>(a, b, 法);",
      "    let inv_p1_mod_p2 = inv_mod(p1 as i64, p2 as i64) as i128;",
      "    let inv_p1p2_mod_p3 = inv_mod((p1 * p2 % p3) as i64, p3 as i64) as i128;",
      "    let 法i = 法 as i128;",
      "    (0..r1.len())",
      "        .map(|i| {",
      "            let a1 = r1[i] as i128;",
      "            let a2 = r2[i] as i128;",
      "            let a3 = r3[i] as i128;",
      "            let k1 = ((a2 - a1) * inv_p1_mod_p2).rem_euclid(p2);",
      "            let t = a1 + p1 * k1;",
      "            let k2 = ((a3 - t) * inv_p1p2_mod_p3).rem_euclid(p3);",
      "            let x = t + p1 * p2 * k2;",
      "            x.rem_euclid(法i) as usize",
      "        })",
      "        .collect()",
      "}"
    ]
  },
  "GcdConvolution": {
    "scope": "rust",
    "prefix": "GcdConvolution",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `2..n` の素数一覧を篩で求める内部関数（各ゼータ／メビウス変換で共有）。",
      "fn 素数リスト(n: usize) -> Vec<usize> {",
      "    let mut 合成 = vec![false; n];",
      "    let mut 素数 = Vec::new();",
      "    for p in 2..n {",
      "        if !合成[p] {",
      "            素数.push(p);",
      "            let mut q = p * p;",
      "            while q < n {",
      "                合成[q] = true;",
      "                q += p;",
      "            }",
      "        }",
      "    }",
      "    素数",
      "}",
      "/// 倍数方向のゼータ変換。`f[i]` を `Σ_{i | j, j < n} f[j]`（倍数についての総和）へ in-place 変換する。",
      "/// 添字は `1..n`（`f[0]` は使わない）。逆変換は [`倍数メビウス変換`]。`O(n log log n)`。",
      "/// 要素型は加算できれば何でもよい（i64 / usize / f64 / ModInt など）。",
      "fn 倍数ゼータ変換<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    for &p in &素数リスト(n) {",
      "        let mut i = (n - 1) / p;",
      "        while i >= 1 {",
      "            f[i] += f[i * p];",
      "            i -= 1;",
      "        }",
      "    }",
      "}",
      "/// [`倍数ゼータ変換`] の逆。`Σ_{i | j} f[j]` から元の `f` を復元する。`O(n log log n)`。",
      "fn 倍数メビウス変換<T: Copy + std::ops::SubAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    for &p in &素数リスト(n) {",
      "        let mut i = 1;",
      "        while i * p < n {",
      "            f[i] -= f[i * p];",
      "            i += 1;",
      "        }",
      "    }",
      "}",
      "/// GCD 畳み込み。`h[k] = Σ_{gcd(i, j) = k} f[i]·g[j]` を `O(n log log n)` で返す（添字 `1..n`、`h[0] = 0`）。",
      "/// 「gcd がちょうど `k` になる組の数え上げ」などに使う。",
      "/// 要素型は加減乗できれば何でもよい（i64 / ModInt など。MOD 付き数え上げは ModInt をそのまま渡す）。",
      "fn gcd畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::SubAssign + std::ops::MulAssign,",
      "{",
      "    assert_eq!(f.len(), g.len());",
      "    let mut a = f.to_vec();",
      "    let mut b = g.to_vec();",
      "    倍数ゼータ変換(&mut a);",
      "    倍数ゼータ変換(&mut b);",
      "    a.iter_mut().zip(&b).for_each(|(x, y)| *x *= *y);",
      "    倍数メビウス変換(&mut a);",
      "    if !a.is_empty() {",
      "        a[0] = T::default();",
      "    }",
      "    a",
      "}"
    ]
  },
  "GeometryDistance": {
    "scope": "rust",
    "prefix": "GeometryDistance",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "type 点 = (f64, f64);",
      "/// 点 `p` と、点 `a`・`b` を通る直線との距離。`O(1)`。`a == b` のときは点 `a` との距離。",
      "fn 点と直線の距離(p: 点, a: 点, b: 点) -> f64 {",
      "    let dx = b.0 - a.0;",
      "    let dy = b.1 - a.1;",
      "    let 長2 = dx * dx + dy * dy;",
      "    if 長2 == 0.0 {",
      "        return (p.0 - a.0).hypot(p.1 - a.1);",
      "    }",
      "    ((dx * (p.1 - a.1) - dy * (p.0 - a.0)).abs()) / 長2.sqrt()",
      "}",
      "/// 点 `p` と線分 `[a, b]` との最短距離。`O(1)`。",
      "/// `p` の射影が線分内に落ちれば垂線の長さ、外れれば近い方の端点との距離。",
      "fn 点と線分の距離(p: 点, a: 点, b: 点) -> f64 {",
      "    let dx = b.0 - a.0;",
      "    let dy = b.1 - a.1;",
      "    let 長2 = dx * dx + dy * dy;",
      "    if 長2 == 0.0 {",
      "        return (p.0 - a.0).hypot(p.1 - a.1);",
      "    }",
      "    let t = ((p.0 - a.0) * dx + (p.1 - a.1) * dy) / 長2;",
      "    let tc = t.clamp(0.0, 1.0);",
      "    let fx = a.0 + tc * dx;",
      "    let fy = a.1 + tc * dy;",
      "    (p.0 - fx).hypot(p.1 - fy)",
      "}",
      "/// 線分 `[a, b]` と線分 `[c, d]` の最短距離。`O(1)`。交差していれば `0`。",
      "fn 線分と線分の距離(a: 点, b: 点, c: 点, d: 点) -> f64 {",
      "    let 外積 = |o: 点, x: 点, y: 点| (x.0 - o.0) * (y.1 - o.1) - (x.1 - o.1) * (y.0 - o.0);",
      "    let d1 = 外積(c, d, a);",
      "    let d2 = 外積(c, d, b);",
      "    let d3 = 外積(a, b, c);",
      "    let d4 = 外積(a, b, d);",
      "    if d1 * d2 < 0.0 && d3 * d4 < 0.0 {",
      "        return 0.0;",
      "    }",
      "    点と線分の距離(a, c, d)",
      "        .min(点と線分の距離(b, c, d))",
      "        .min(点と線分の距離(c, a, b))",
      "        .min(点と線分の距離(d, a, b))",
      "}"
    ]
  },
  "GlobalMinCut": {
    "scope": "rust",
    "prefix": "GlobalMinCut",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 無向重み付きグラフの**全域最小カット**（global minimum cut）を Stoer–Wagner 法で求める。",
      "/// 始点・終点を指定せず「頂点集合を空でない 2 つに分ける切断のうち、またぐ辺の重み和が最小のもの」を返す。",
      "/// `n` 頂点、`辺` は `(u, v, 重み)` の無向辺（重み非負、多重辺は加算、自己ループは無視）。計算量 `O(n^3)`。",
      "/// `ac_library` の `maxflow` は s–t 間の最小カット専用で、全ペアを試さずに大域最小カットを出すのはこちら。",
      "/// `n <= 1` のときは `0` を返す。",
      "fn 全域最小カット(n: usize, 辺: &[(usize, usize, i64)]) -> i64 {",
      "    if n <= 1 {",
      "        return 0;",
      "    }",
      "    let mut グラフ = vec![vec![0i64; n]; n];",
      "    for &(u, v, w) in 辺 {",
      "        if u != v {",
      "            グラフ[u][v] += w;",
      "            グラフ[v][u] += w;",
      "        }",
      "    }",
      "    let mut 最良 = i64::MAX;",
      "    let mut 頂点: Vec<usize> = (0..n).collect();",
      "    while 頂点.len() > 1 {",
      "        let m = 頂点.len();",
      "        let mut 接続重み = vec![0i64; n];",
      "        let mut 取込済 = vec![false; n];",
      "        let mut 順序 = Vec::with_capacity(m);",
      "        for _ in 0..m {",
      "            let mut 選 = !0;",
      "            for &v in &頂点 {",
      "                if !取込済[v] && (選 == !0 || 接続重み[v] > 接続重み[選]) {",
      "                    選 = v;",
      "                }",
      "            }",
      "            取込済[選] = true;",
      "            順序.push(選);",
      "            for &v in &頂点 {",
      "                if !取込済[v] {",
      "                    接続重み[v] += グラフ[選][v];",
      "                }",
      "            }",
      "        }",
      "        let t = 順序[m - 1];",
      "        let s = 順序[m - 2];",
      "        最良 = 最良.min(接続重み[t]);",
      "        for &v in &頂点 {",
      "            グラフ[s][v] += グラフ[t][v];",
      "            グラフ[v][s] += グラフ[v][t];",
      "        }",
      "        頂点.retain(|&x| x != t);",
      "    }",
      "    最良",
      "}"
    ]
  },
  "GomoryHu": {
    "scope": "rust",
    "prefix": "GomoryHu",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::MfGraph;",
      "/// 全点対最小カット木（Gomory–Hu 木）。無向重み付きグラフの「任意の 2 頂点間の最小カット」を、",
      "/// `n-1` 本の辺からなる 1 本の木で表す。木上の `u`–`v` パスの最小辺重みが `u`–`v` の最小カットに等しい。",
      "/// `prev[i]`（`i >= 1`）はその親、`重み[i]` は辺 `(i, prev[i])` の容量（＝そのカット値）。",
      "struct 全点対最小カット木 {",
      "    /// `prev[i]` は木における頂点 `i` の親（`prev[0] = 0`）。",
      "    prev: Vec<usize>,",
      "    /// `重み[i]` は辺 `(i, prev[i])` の最小カット値（`重み[0] = 0`）。",
      "    重み: Vec<i64>,",
      "    グラフ: Vec<Vec<(usize, i64)>>,",
      "}",
      "impl 全点対最小カット木 {",
      "    /// 木上のパスの最小辺重み = 頂点 `u`, `v` 間の最小カット値を `O(n)` で返す。",
      "    fn 最小カット(&self, u: usize, v: usize) -> i64 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        let n = self.グラフ.len();",
      "        let mut 最小 = vec![i64::MAX; n];",
      "        let mut 到達済 = vec![false; n];",
      "        到達済[u] = true;",
      "        let mut 探索 = vec![u];",
      "        while let Some(now) = 探索.pop() {",
      "            for &(next, w) in &self.グラフ[now] {",
      "                if !到達済[next] {",
      "                    到達済[next] = true;",
      "                    最小[next] = 最小[now].min(w);",
      "                    探索.push(next);",
      "                }",
      "            }",
      "        }",
      "        最小[v]",
      "    }",
      "}",
      "/// Gusfield の簡易アルゴリズムで Gomory–Hu 木（等価フロー木）を構築する。`ac_library::MfGraph` を",
      "/// `n-1` 回呼ぶ。`辺` は `(u, v, 容量)` の無向辺（容量非負、多重辺は別々に追加、自己ループは無視）。",
      "/// 計算量は最大流 `n-1` 回ぶん。非連結なグラフでは成分間のカットは `0` になる。",
      "fn 全点対最小カット木構築(",
      "    n: usize,",
      "    辺: &[(usize, usize, i64)],",
      ") -> 全点対最小カット木 {",
      "    let mut prev = vec![0usize; n];",
      "    let mut 重み = vec![0i64; n];",
      "    for i in 1..n {",
      "        let t = prev[i];",
      "        let mut g = MfGraph::<i64>::new(n);",
      "        for &(u, v, w) in 辺 {",
      "            if u != v {",
      "                g.add_edge(u, v, w);",
      "                g.add_edge(v, u, w);",
      "            }",
      "        }",
      "        let f = g.flow(i, t);",
      "        重み[i] = f;",
      "        let 側 = g.min_cut(i);",
      "        for j in (i + 1)..n {",
      "            if 側[j] && prev[j] == t {",
      "                prev[j] = i;",
      "            }",
      "        }",
      "    }",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for i in 1..n {",
      "        グラフ[i].push((prev[i], 重み[i]));",
      "        グラフ[prev[i]].push((i, 重み[i]));",
      "    }",
      "    全点対最小カット木 {",
      "        prev, 重み, グラフ",
      "    }",
      "}"
    ]
  },
  "Grundy": {
    "scope": "rust",
    "prefix": "Grundy",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 非負整数の集合に含まれない最小の非負整数 **mex**（minimum excludant）を返す。`O(N)`。",
      "/// 重複があってもよい（ソート不要）。",
      "fn mex(集合: &[usize]) -> usize {",
      "    let mut 出現 = vec![false; 集合.len() + 1];",
      "    for &x in 集合 {",
      "        if x < 出現.len() {",
      "            出現[x] = true;",
      "        }",
      "    }",
      "    出現.iter().position(|&出| !出).unwrap()",
      "}",
      "/// 状態 `0..=上限` それぞれの**グランディ数**（Sprague–Grundy 値）を表で返す。",
      "/// `遷移(i)` は状態 `i` から 1 手で到達できる状態の集合で、要素はすべて `i` 未満であること",
      "/// （有限・非循環な不偏ゲーム）。`grundy[i] = mex{ grundy[j] : j ∈ 遷移(i) }`。",
      "/// `grundy[i] == 0` が後手必勝（手番側の負け）状態。独立した複数のゲームの合成局面は",
      "/// 各ゲームのグランディ数の XOR（[`ニム和`]）で判定でき、XOR が 0 なら手番側の負け",
      "/// （Sprague–Grundy の定理）。計算量は `O(Σ|遷移(i)|)`。",
      "/// 状態を整数に符号化できる山取り・減算ゲームなどに使う。",
      "fn グランディ数列<F: Fn(usize) -> Vec<usize>>(上限: usize, 遷移: F) -> Vec<usize> {",
      "    let mut g = vec![0usize; 上限 + 1];",
      "    for i in 0..=上限 {",
      "        let 次: Vec<usize> = 遷移(i).iter().map(|&j| g[j]).collect();",
      "        g[i] = mex(&次);",
      "    }",
      "    g",
      "}"
    ]
  },
  "Gusfield": {
    "scope": "rust",
    "prefix": "Gusfield",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use ac_library::MfGraph;",
      "/// 全点対最小カット木（Gomory–Hu 木）。無向重み付きグラフの「任意の 2 頂点間の最小カット」を、",
      "/// `n-1` 本の辺からなる 1 本の木で表す。木上の `u`–`v` パスの最小辺重みが `u`–`v` の最小カットに等しい。",
      "/// `prev[i]`（`i >= 1`）はその親、`重み[i]` は辺 `(i, prev[i])` の容量（＝そのカット値）。",
      "struct 全点対最小カット木 {",
      "    /// `prev[i]` は木における頂点 `i` の親（`prev[0] = 0`）。",
      "    prev: Vec<usize>,",
      "    /// `重み[i]` は辺 `(i, prev[i])` の最小カット値（`重み[0] = 0`）。",
      "    重み: Vec<i64>,",
      "    グラフ: Vec<Vec<(usize, i64)>>,",
      "}",
      "impl 全点対最小カット木 {",
      "    /// 木上のパスの最小辺重み = 頂点 `u`, `v` 間の最小カット値を `O(n)` で返す。",
      "    fn 最小カット(&self, u: usize, v: usize) -> i64 {",
      "        if u == v {",
      "            return 0;",
      "        }",
      "        let n = self.グラフ.len();",
      "        let mut 最小 = vec![i64::MAX; n];",
      "        let mut 到達済 = vec![false; n];",
      "        到達済[u] = true;",
      "        let mut 探索 = vec![u];",
