  "Karp": {
    "scope": "rust",
    "prefix": "Karp",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 有向重み付きグラフの**最小平均閉路**（辺の重み和 ÷ 辺数を最小化する閉路の、その比）を返す。",
      "/// 閉路が存在しなければ `None`。重みは負でもよい。`O(V·E)`。",
      "/// Karp の定理を用いる。最小費用流の最適性判定や周期最適化などで使う。",
      "fn 最小平均閉路(頂点数: usize, 辺: &[(usize, usize, i64)]) -> Option<f64> {",
      "    if 頂点数 == 0 {",
      "        return None;",
      "    }",
      "    const INF: i64 = 1 << 60;",
      "    let v = 頂点数;",
      "    let n = v + 1;",
      "    let 始点 = v;",
      "    let mut 全辺 = 辺.to_vec();",
      "    for w in 0..v {",
      "        全辺.push((始点, w, 0));",
      "    }",
      "    let mut d = vec![vec![INF; n]; n + 1];",
      "    d[0][始点] = 0;",
      "    for k in 1..=n {",
      "        let (前, 当) = d.split_at_mut(k);",
      "        let 前 = &前[k - 1];",
      "        let 当 = &mut 当[0];",
      "        for &(a, b, wt) in &全辺 {",
      "            if 前[a] < INF {",
      "                let nd = 前[a] + wt;",
      "                if nd < 当[b] {",
      "                    当[b] = nd;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    let mut 最小 = f64::INFINITY;",
      "    for t in 0..n {",
      "        if d[n][t] >= INF {",
      "            continue;",
      "        }",
      "        let mut 最大 = f64::NEG_INFINITY;",
      "        for k in 0..n {",
      "            if d[k][t] >= INF {",
      "                continue;",
      "            }",
      "            let 比 = (d[n][t] - d[k][t]) as f64 / (n - k) as f64;",
      "            if 比 > 最大 {",
      "                最大 = 比;",
      "            }",
      "        }",
      "        if 最大 < 最小 {",
      "            最小 = 最大;",
      "        }",
      "    }",
      "    if 最小.is_infinite() {",
      "        None",
      "    } else {",
      "        Some(最小)",
      "    }",
      "}"
    ]
  },
  "Kitamasa": {
    "scope": "rust",
    "prefix": "Kitamasa",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// Berlekamp-Massey 法。数列 `数列`（素数 `法` 上）を生成する最短の線形漸化式の係数を返す。",
      "/// O(N·L)（L は漸化式の次数）。",
      "/// 返り値 `c`（長さ L）は `S[i] = Σ_{j=0}^{L-1} c[j]·S[i-1-j]`（`i ≥ L`）を満たす。",
      "/// 数列は少なくとも `2L` 項あると安全。第 N 項を求めるには [`線形漸化式の第n項`] に渡す。",
      "fn ベルレカンプマッシー(数列: &[u64], 法: u64) -> Vec<u64> {",
      "    let p = 法 as i128;",
      "    let n = 数列.len();",
      "    let s: Vec<i128> = 数列.iter().map(|&x| (x as i128) % p).collect();",
      "    let mut c = vec![0i128; n + 1];",
      "    let mut b = vec![0i128; n + 1];",
      "    c[0] = 1 % p;",
      "    b[0] = 1 % p;",
      "    let mut l = 0usize;",
      "    let mut m = 0usize;",
      "    let mut bb = 1i128 % p;",
      "    for i in 0..n {",
      "        m += 1;",
      "        let mut d = s[i] % p;",
      "        for j in 1..=l {",
      "            d = (d + c[j] * s[i - j]) % p;",
      "        }",
      "        if d == 0 {",
      "            continue;",
      "        }",
      "        let t = c.clone();",
      "        let coef = d * 累乗_mod((bb % p) as u64, 法 - 2, 法) as i128 % p;",
      "        for j in m..=n {",
      "            c[j] = ((c[j] - coef * b[j - m]) % p + p) % p;",
      "        }",
      "        if 2 * l > i {",
      "            continue;",
      "        }",
      "        l = i + 1 - l;",
      "        b = t;",
      "        bb = d;",
      "        m = 0;",
      "    }",
      "    c.truncate(l + 1);",
      "    c.drain(0..1);",
      "    c.iter().map(|&x| (((p - x) % p + p) % p) as u64).collect()",
      "}",
      "/// 多項式の積を `x^k = Σ 係数[j]·x^{k-1-j}` で次数 `k` 未満に縮約する内部関数。",
      "fn 多項式乗算縮約(a: &[u64], b: &[u64], 係数: &[u64], 法: u64) -> Vec<u64> {",
      "    let k = 係数.len();",
      "    let m = 法 as u128;",
      "    let mut res = vec![0u128; (a.len() + b.len()).saturating_sub(1).max(k)];",
      "    for (i, &ai) in a.iter().enumerate() {",
      "        if ai == 0 {",
      "            continue;",
      "        }",
      "        for (j, &bj) in b.iter().enumerate() {",
      "            res[i + j] = (res[i + j] + ai as u128 * bj as u128) % m;",
      "        }",
      "    }",
      "    for d in (k..res.len()).rev() {",
      "        let v = res[d];",
      "        if v != 0 {",
      "            res[d] = 0;",
      "            for (j, &係) in 係数.iter().enumerate() {",
      "                let deg = d - 1 - j;",
      "                res[deg] = (res[deg] + v * 係 as u128) % m;",
      "            }",
      "        }",
      "    }",
      "    res.truncate(k);",
      "    res.resize(k, 0);",
      "    res.iter().map(|&x| x as u64).collect()",
      "}",
      "/// きたまさ法。線形漸化式 `S[i] = Σ_{j} 係数[j]·S[i-1-j]` と初項 `初項`（長さ ≥ 次数）から、",
      "/// 第 `n` 項を素数 `法` で O(k^2 log n) で求める（k は次数）。",
      "fn 線形漸化式の第n項(初項: &[u64], 係数: &[u64], n: usize, 法: u64) -> u64 {",
      "    let k = 係数.len();",
      "    if k == 0 {",
      "        return 0;",
      "    }",
      "    if n < k {",
      "        return 初項[n] % 法;",
      "    }",
      "    let mut 結果 = vec![0u64; k];",
      "    結果[0] = 1 % 法;",
      "    let mut 底 = if k >= 2 {",
      "        let mut v = vec![0u64; k];",
      "        v[1] = 1 % 法;",
      "        v",
      "    } else {",
      "        vec![係数[0] % 法]",
      "    };",
      "    let mut e = n;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            結果 = 多項式乗算縮約(&結果, &底, 係数, 法);",
      "        }",
      "        底 = 多項式乗算縮約(&底, &底, 係数, 法);",
      "        e >>= 1;",
      "    }",
      "    let m = 法 as u128;",
      "    let mut ans = 0u128;",
      "    for (i, &係) in 結果.iter().enumerate() {",
      "        ans = (ans + 係 as u128 * (初項[i] % 法) as u128) % m;",
      "    }",
      "    ans as u64",
      "}",
      "/// 数列の先頭を渡すと、Berlekamp-Massey で漸化式を推定し、きたまさ法で第 `n` 項を返す。",
      "/// 数列は最短漸化式の次数の 2 倍以上の項を含むこと（足りないと誤った外挿になる）。",
      "fn 数列の第n項(数列: &[u64], n: usize, 法: u64) -> u64 {",
      "    let 係数 = ベルレカンプマッシー(数列, 法);",
      "    線形漸化式の第n項(数列, &係数, n, 法)",
      "}"
    ]
  },
  "KnuthOptimization": {
    "scope": "rust",
    "prefix": "KnuthOptimization",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// クヌース（Knuth–Yao）最適化。区間 DP `dp[i][j] = 区間コスト(i, j) + min_{i<=k<j} (dp[i][k] + dp[k+1][j])`",
      "/// を、最適分割点の単調性 `opt[i][j-1] <= opt[i][j] <= opt[i+1][j]` を用いて `O(n^2)` で解く。",
      "/// `区間コスト(i, j)` が四角不等式（QI）と区間単調性を満たすとき正しい（石の合体・最適二分探索木など、",
      "/// 区間長に関する凸なコスト）。素朴な区間 DP は `O(n^3)`。`n` 要素を 1 つに併合する総コストを返す。",
      "/// [`crate::divide_and_conquer_dp`]（層状の遷移）とは別物。",
      "fn クヌース最適化<F: Fn(usize, usize) -> i64>(n: usize, 区間コスト: F) -> i64 {",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    let mut dp = vec![vec![0i64; n]; n];",
      "    let mut opt = vec![vec![0usize; n]; n];",
      "    for (i, 行) in opt.iter_mut().enumerate() {",
      "        行[i] = i;",
      "    }",
      "    for 長 in 1..n {",
      "        for i in 0..n - 長 {",
      "            let j = i + 長;",
      "            let 下 = opt[i][j - 1];",
      "            let 上 = opt[i + 1][j].min(j - 1);",
      "            let mut 最良 = i64::MAX;",
      "            let mut 最良k = 下;",
      "            for k in 下..=上 {",
      "                let v = dp[i][k] + dp[k + 1][j];",
      "                if v < 最良 {",
      "                    最良 = v;",
      "                    最良k = k;",
      "                }",
      "            }",
      "            dp[i][j] = 最良 + 区間コスト(i, j);",
      "            opt[i][j] = 最良k;",
      "        }",
      "    }",
      "    dp[0][n - 1]",
      "}"
    ]
  },
  "Konig": {
    "scope": "rust",
    "prefix": "Konig",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Kuhn 法で増加路を 1 本探す内部関数。`右相手`・`左相手` を更新する。",
      "fn 増加(",
      "    u: usize,",
      "    グラフ: &[Vec<usize>],",
      "    右相手: &mut [Option<usize>],",
      "    左相手: &mut [Option<usize>],",
      "    到達済: &mut [bool],",
      ") -> bool {",
      "    for &v in &グラフ[u] {",
      "        if 到達済[v] {",
      "            continue;",
      "        }",
      "        到達済[v] = true;",
      "        if 右相手[v].is_none() || 増加(右相手[v].unwrap(), グラフ, 右相手, 左相手, 到達済)",
      "        {",
      "            右相手[v] = Some(u);",
      "            左相手[u] = Some(v);",
      "            return true;",
      "        }",
      "    }",
      "    false",
      "}",
      "/// König の定理の核。最大マッチングを求め、未マッチ左頂点から交互路で到達できる",
      "/// 左集合 `z左` と右集合 `z右` を返す。最小点被覆・最大独立集合の両方の土台。",
      "fn ケーニッヒ核(",
      "    左数: usize, 右数: usize, 辺: &[(usize, usize)]",
      ") -> (Vec<bool>, Vec<bool>) {",
      "    let mut グラフ = vec![Vec::new(); 左数];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "    }",
      "    let mut 右相手: Vec<Option<usize>> = vec![None; 右数];",
      "    let mut 左相手: Vec<Option<usize>> = vec![None; 左数];",
      "    for u in 0..左数 {",
      "        let mut 到達済 = vec![false; 右数];",
      "        増加(u, &グラフ, &mut 右相手, &mut 左相手, &mut 到達済);",
      "    }",
      "    let mut z左 = vec![false; 左数];",
      "    let mut z右 = vec![false; 右数];",
      "    let mut 探索 = Vec::new();",
      "    for (u, &相手) in 左相手.iter().enumerate() {",
      "        if 相手.is_none() {",
      "            z左[u] = true;",
      "            探索.push(u);",
      "        }",
      "    }",
      "    while let Some(u) = 探索.pop() {",
      "        for &v in &グラフ[u] {",
      "            if 左相手[u] == Some(v) || z右[v] {",
      "                continue;",
      "            }",
      "            z右[v] = true;",
      "            if let Some(w) = 右相手[v]",
      "                && !z左[w]",
      "            {",
      "                z左[w] = true;",
      "                探索.push(w);",
      "            }",
      "        }",
      "    }",
      "    (z左, z右)",
      "}",
      "/// König の定理で二部グラフの最小点被覆を求める。`O(V·E)`（内部は Kuhn 法）。",
      "/// 左頂点 `0..左数`・右頂点 `0..右数`、`辺` は `(左, 右)` の列。返り値 `(左被覆, 右被覆)` は",
      "/// 被覆に含める左・右の頂点番号。被覆サイズ `= 最大マッチング数`（König の定理）。",
      "/// マッチングのみの [`hopcroft_karp`](crate::hopcroft_karp) と異なり点被覆を復元する。",
      "fn 二部最小点被覆(",
      "    左数: usize,",
      "    右数: usize,",
      "    辺: &[(usize, usize)],",
      ") -> (Vec<usize>, Vec<usize>) {",
      "    let (z左, z右) = ケーニッヒ核(左数, 右数, 辺);",
      "    let 左被覆: Vec<usize> = (0..左数).filter(|&u| !z左[u]).collect();",
      "    let 右被覆: Vec<usize> = (0..右数).filter(|&v| z右[v]).collect();",
      "    (左被覆, 右被覆)",
      "}",
      "/// König の定理で二部グラフの最大独立集合を求める（最小点被覆の補集合）。`O(V·E)`。",
      "/// 返り値 `(左独立, 右独立)`。サイズ `= 全頂点数 - 最大マッチング数`。",
      "fn 二部最大独立集合(",
      "    左数: usize,",
      "    右数: usize,",
      "    辺: &[(usize, usize)],",
      ") -> (Vec<usize>, Vec<usize>) {",
      "    let (z左, z右) = ケーニッヒ核(左数, 右数, 辺);",
      "    let 左独立: Vec<usize> = (0..左数).filter(|&u| z左[u]).collect();",
      "    let 右独立: Vec<usize> = (0..右数).filter(|&v| !z右[v]).collect();",
      "    (左独立, 右独立)",
      "}"
    ]
  },
  "KuhnMunkres": {
    "scope": "rust",
    "prefix": "KuhnMunkres",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// ハンガリアン法（Kuhn–Munkres）で割当問題（最小重み完全マッチング）を解く。`O(n²m)`。",
      "/// `コスト[i][j]` を行 `i`・列 `j` の費用とし、各行に相異なる列を割り当てて総費用を最小化する。",
      "/// 行数 `n <= 列数 m` であること（足りない列があると割り当て不能）。費用は負でもよい。",
      "/// 返り値は `(最小総費用, 割当)`。`割当[i]` は行 `i` に割り当てられた列（0 始まり）。",
      "fn 割当問題(コスト: &[Vec<i64>]) -> (i64, Vec<usize>) {",
      "    let n = コスト.len();",
      "    if n == 0 {",
      "        return (0, Vec::new());",
      "    }",
      "    assert!(",
      "        コスト[0].len() >= n,",
      "        \"ハンガリアン法: 列数は行数以上である必要があります\"",
      "    );",
      "    let 行列 = pathfinding::matrix::Matrix::from_rows(コスト.iter().cloned())",
      "        .expect(\"コストの全行は同じ列数であること\");",
      "    pathfinding::kuhn_munkres::kuhn_munkres_min(&行列)",
      "}"
    ]
  },
  "L1_距離の_最小_全域木": {
    "scope": "rust",
    "prefix": "L1_距離の_最小_全域木",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::BTreeMap;",
      "/// マンハッタン距離 `|dx| + |dy|` を辺重みとする完全グラフの最小全域木（の総重み）を O(N log N) で求める。",
      "/// 完全グラフは辺が O(N^2) 本あるが、各点について「8 方向（octant）ごとの最近点」だけが MST 候補になる",
      "/// という性質を使い、候補辺を O(N) 本に絞ってから Kruskal する。点が 1 個以下なら 0。",
      "fn マンハッタン最小全域木(点群: &[(i64, i64)]) -> i64 {",
      "    let n = 点群.len();",
      "    if n <= 1 {",
      "        return 0;",
      "    }",
      "    let mut 点 = 点群.to_vec();",
      "    let mut 辺: Vec<(i64, usize, usize)> = Vec::new();",
      "    let mut id: Vec<usize> = (0..n).collect();",
      "    for k in 0..4 {",
      "        id.sort_by_key(|&i| 点[i].0 + 点[i].1);",
      "        let mut スイープ: BTreeMap<i64, usize> = BTreeMap::new();",
      "        for &i in &id {",
      "            let mut 削除 = Vec::new();",
      "            for (&キー, &j) in スイープ.range(-点[i].1..) {",
      "                let dx = 点[i].0 - 点[j].0;",
      "                let dy = 点[i].1 - 点[j].1;",
      "                if dy > dx {",
      "                    break;",
      "                }",
      "                辺.push((dx + dy, i, j));",
      "                削除.push(キー);",
      "            }",
      "            for キー in 削除 {",
      "                スイープ.remove(&キー);",
      "            }",
      "            スイープ.insert(-点[i].1, i);",
      "        }",
      "        for p in 点.iter_mut() {",
      "            if k % 2 == 1 {",
      "                p.0 = -p.0;",
      "            } else {",
      "                std::mem::swap(&mut p.0, &mut p.1);",
      "            }",
      "        }",
      "    }",
      "    辺.sort_by_key(|e| e.0);",
      "    let mut 親: Vec<usize> = (0..n).collect();",
      "    fn 根(親: &mut [usize], x: usize) -> usize {",
      "        let mut x = x;",
      "        while 親[x] != x {",
      "            親[x] = 親[親[x]];",
      "            x = 親[x];",
      "        }",
      "        x",
      "    }",
      "    let mut 合計 = 0;",
      "    let mut 本数 = 0;",
      "    for &(w, u, v) in &辺 {",
      "        let a = 根(&mut 親, u);",
      "        let b = 根(&mut 親, v);",
      "        if a != b {",
      "            親[a] = b;",
      "            合計 += w;",
      "            本数 += 1;",
      "            if 本数 == n - 1 {",
      "                break;",
      "            }",
      "        }",
      "    }",
      "    合計",
      "}"
    ]
  },
  "LCS": {
    "scope": "rust",
    "prefix": "LCS",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2つの列の最長共通部分列(LCS)の長さを返す。O(N*M)。",
      "/// 文字列なら `s.chars().collect::<Vec<_>>()` や `s.as_bytes()` を渡す。",
      "/// 連続している必要はなく、順序を保って共通に取れる最長の部分列の長さ。",
      "fn 最長共通部分列<T: PartialEq>(a: &[T], b: &[T]) -> usize {",
      "    let n = a.len();",
      "    let m = b.len();",
      "    let mut dp = vec![vec![0usize; m + 1]; n + 1];",
      "    for i in 0..n {",
      "        for (j, b要素) in b.iter().enumerate() {",
      "            dp[i + 1][j + 1] = if a[i] == *b要素 {",
      "                dp[i][j] + 1",
      "            } else {",
      "                dp[i][j + 1].max(dp[i + 1][j])",
      "            };",
      "        }",
      "    }",
      "    dp[n][m]",
      "}"
    ]
  },
  "LCT": {
    "scope": "rust",
    "prefix": "LCT",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// Link-Cut Tree。森に対する辺の追加・削除（[`Self::辺を張る`] / [`Self::辺を切る`]）、",
      "/// 連結判定、2 頂点間パスの頂点値の総和を、すべてならし O(log N) で処理する。",
      "/// 頂点番号は 0-indexed。",
      "/// - [`Self::辺を張る`] : 別の木に属する 2 頂点を結ぶ（同一木の頂点に呼んではならない）。",
      "/// - [`Self::辺を切る`] : 既存の辺を取り除く（隣接していない 2 頂点に呼んではならない）。",
      "/// - [`Self::連結`] : 2 頂点が同じ木か。",
      "/// - [`Self::パス和`] : 2 頂点間パス上の頂点値の総和。",
      "/// - [`Self::値設定`] : 1 頂点の値を更新。",
      "/// 要素型 `T` は加算できる型なら何でもよく（`i64`・`usize`・`ModInt` など）、",
      "/// `T::default()` が加法単位元（0）であることを前提とする。",
      "struct リンクカット木<T> {",
      "    親: Vec<usize>,",
      "    子: Vec<[usize; 2]>,",
      "    値: Vec<T>,",
      "    和: Vec<T>,",
      "    反転: Vec<bool>,",
      "}",
      "impl<T> リンクカット木<T>",
      "where",
      "    T: Copy + Default + std::ops::Add<Output = T>,",
      "{",
      "    /// 各頂点の初期値から構築する。",
      "    fn new(初期値: &[T]) -> Self {",
      "        let n = 初期値.len();",
      "        let mut s = Self {",
      "            親: vec![0; n + 1],",
      "            子: vec![[0, 0]; n + 1],",
      "            値: vec![T::default(); n + 1],",
      "            和: vec![T::default(); n + 1],",
      "            反転: vec![false; n + 1],",
      "        };",
      "        for (i, &v) in 初期値.iter().enumerate() {",
      "            s.値[i + 1] = v;",
      "            s.和[i + 1] = v;",
      "        }",
      "        s",
      "    }",
      "    /// `x` がスプレー木の根（パス親へのリンクしか持たない）か。",
      "    fn is_root(&self, x: usize) -> bool {",
      "        let p = self.親[x];",
      "        p == 0 || (self.子[p][0] != x && self.子[p][1] != x)",
      "    }",
      "    fn 更新(&mut self, x: usize) {",
      "        if x == 0 {",
      "            return;",
      "        }",
      "        self.和[x] = self.和[self.子[x][0]] + self.値[x] + self.和[self.子[x][1]];",
      "    }",
      "    fn 伝播(&mut self, x: usize) {",
      "        if x != 0 && self.反転[x] {",
      "            let l = self.子[x][0];",
      "            let r = self.子[x][1];",
      "            self.子[x][0] = r;",
      "            self.子[x][1] = l;",
      "            if l != 0 {",
      "                self.反転[l] ^= true;",
      "            }",
      "            if r != 0 {",
      "                self.反転[r] ^= true;",
      "            }",
      "            self.反転[x] = false;",
      "        }",
      "    }",
      "    fn 回転(&mut self, x: usize) {",
      "        let p = self.親[x];",
      "        let g = self.親[p];",
      "        let pがルート = self.is_root(p);",
      "        let d = if self.子[p][1] == x { 1 } else { 0 };",
      "        let b = self.子[x][d ^ 1];",
      "        self.子[p][d] = b;",
      "        if b != 0 {",
      "            self.親[b] = p;",
      "        }",
      "        self.子[x][d ^ 1] = p;",
      "        self.親[p] = x;",
      "        self.親[x] = g;",
      "        if !pがルート {",
      "            if self.子[g][0] == p {",
      "                self.子[g][0] = x;",
      "            } else if self.子[g][1] == p {",
      "                self.子[g][1] = x;",
      "            }",
      "        }",
      "        self.更新(p);",
      "        self.更新(x);",
      "    }",
      "    fn splay(&mut self, x: usize) {",
      "        let mut スタック = vec![x];",
      "        let mut y = x;",
      "        while !self.is_root(y) {",
      "            y = self.親[y];",
      "            スタック.push(y);",
      "        }",
      "        while let Some(v) = スタック.pop() {",
      "            self.伝播(v);",
      "        }",
      "        while !self.is_root(x) {",
      "            let p = self.親[x];",
      "            if self.is_root(p) {",
      "                self.回転(x);",
      "            } else {",
      "                let g = self.親[p];",
      "                let 同方向 = (self.子[g][1] == p) == (self.子[p][1] == x);",
      "                if 同方向 {",
      "                    self.回転(p);",
      "                } else {",
      "                    self.回転(x);",
      "                }",
      "                self.回転(x);",
      "            }",
      "        }",
      "    }",
      "    fn access(&mut self, x: usize) -> usize {",
      "        let mut last = 0;",
      "        let mut cur = x;",
      "        while cur != 0 {",
      "            self.splay(cur);",
      "            self.子[cur][1] = last;",
      "            self.更新(cur);",
      "            last = cur;",
      "            cur = self.親[cur];",
      "        }",
      "        self.splay(x);",
      "        last",
      "    }",
      "    fn make_root(&mut self, x: usize) {",
      "        self.access(x);",
      "        self.反転[x] ^= true;",
      "        self.伝播(x);",
      "    }",
      "    fn find_root(&mut self, x: usize) -> usize {",
      "        self.access(x);",
      "        let mut r = x;",
      "        self.伝播(r);",
      "        while self.子[r][0] != 0 {",
      "            r = self.子[r][0];",
      "            self.伝播(r);",
      "        }",
      "        self.splay(r);",
      "        r",
      "    }",
      "    /// 別の木に属する頂点 `u`・`v` を結ぶ辺を張る。同じ木の 2 頂点に呼んではならない。",
      "    fn 辺を張る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.親[a] = b;",
      "    }",
      "    /// 既存の辺 `u - v` を取り除く。隣接していない 2 頂点に呼んではならない。",
      "    fn 辺を切る(&mut self, u: usize, v: usize) {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.子[b][0] = 0;",
      "        self.親[a] = 0;",
      "        self.更新(b);",
      "    }",
      "    /// 頂点 `u`・`v` が同じ木に属するか。",
      "    fn 連結(&mut self, u: usize, v: usize) -> bool {",
      "        if u == v {",
      "            return true;",
      "        }",
      "        self.find_root(u + 1) == self.find_root(v + 1)",
      "    }",
      "    /// 任意頂点 `u` をその木の根にする。",
      "    fn 根を変更(&mut self, u: usize) {",
      "        self.make_root(u + 1);",
      "    }",
      "    /// 頂点 `u`・`v` 間のパス上にある頂点値の総和。同じ木に属することが前提。",
      "    fn パス和(&mut self, u: usize, v: usize) -> T {",
      "        let (a, b) = (u + 1, v + 1);",
      "        self.make_root(a);",
      "        self.access(b);",
      "        self.和[b]",
      "    }",
      "    /// 頂点 `u` の値を `新値` に設定する。",
      "    fn 値設定(&mut self, u: usize, 新値: T) {",
      "        let a = u + 1;",
      "        self.access(a);",
      "        self.値[a] = 新値;",
      "        self.更新(a);",
      "    }",
      "    /// 頂点 `u` の現在の値。",
      "    fn 頂点値(&self, u: usize) -> T {",
      "        self.値[u + 1]",
      "    }",
      "}"
    ]
  },
  "LIS": {
    "scope": "rust",
    "prefix": "LIS",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 最長増加部分列(LIS)の長さを返す。O(N log N)。",
      "/// 要素型 `T` は順序比較できる型なら何でもよい（`i64`・`f64`・`&str` など `PartialOrd`）。",
      "/// `狭義` で増加の意味を切り替える:",
      "/// - `true`  … 狭義単調増加（同じ値は連続して採用できない。例 `[1,2,2,3]` の LIS は 3）",
      "/// - `false` … 広義単調増加（同じ値も採用できる。例 `[1,2,2,3]` の LIS は 4）",
      "/// 長さだけを返す（部分列そのものは復元しない）。",
      "fn 最長増加部分列<T: PartialOrd + Copy>(配列: &[T], 狭義: bool) -> usize {",
      "    let mut dp: Vec<T> = Vec::new();",
      "    for &x in 配列 {",
      "        let 位置 = if 狭義 {",
      "            dp.partition_point(|&v| v < x)",
      "        } else {",
      "            dp.partition_point(|&v| v <= x)",
      "        };",
      "        if 位置 == dp.len() {",
      "            dp.push(x);",
      "        } else {",
      "            dp[位置] = x;",
      "        }",
      "    }",
      "    dp.len()",
      "}"
    ]
  },
  "LagrangeInterpolation": {
    "scope": "rust",
    "prefix": "LagrangeInterpolation",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 素数 `法` を法とする `a` の逆元（フェルマーの小定理 `a^(法-2)`）。`O(log 法)`。",
      "/// `法` が素数で `a % 法 != 0` であることが前提。合成数を法とする場合や `a` が",
      "/// `法` の倍数の場合は正しい値を返さない（拡張ユークリッドを使うこと）。",
      "fn 逆元(a: u64, 法: u64) -> u64 {",
      "    累乗_mod(a, 法 - 2, 法)",
      "}",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 相異なる点 `(xs[i], ys[i])` を通る次数 `< n` の多項式を素数 `法` 上で求め、`t` での値を返す。O(n^2)。",
      "/// `法` は素数で、`xs` は互いに異なること。点が等間隔（0,1,2,...）なら [`連続点補間`] が O(n) で速い。",
      "fn ラグランジュ補間(",
      "    xs: &[impl TryInto<u64> + Copy],",
      "    ys: &[impl TryInto<u64> + Copy],",
      "    t: impl TryInto<u64>,",
      "    法: impl TryInto<u64>,",
      ") -> usize {",
      "    let xs: Vec<u64> = xs",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"ラグランジュ補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let ys: Vec<u64> = ys",
      "        .iter()",
      "        .map(|&y| {",
      "            y.try_into()",
      "                .ok()",
      "                .expect(\"ラグランジュ補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let t: u64 = t",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ラグランジュ補間: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ラグランジュ補間: 引数が u64 に収まりません\");",
      "    let n = xs.len();",
      "    let t = t % 法;",
      "    let mut 結果 = 0u64;",
      "    for i in 0..n {",
      "        let mut 分子 = 1u64;",
      "        let mut 分母 = 1u64;",
      "        for j in 0..n {",
      "            if i != j {",
      "                分子 = 分子 * ((t + 法 - xs[j] % 法) % 法) % 法;",
      "                分母 = 分母 * ((xs[i] % 法 + 法 - xs[j] % 法) % 法) % 法;",
      "            }",
      "        }",
      "        結果 = (結果 + ys[i] % 法 * 分子 % 法 * 逆元(分母, 法)) % 法;",
      "    }",
      "    結果 as usize",
      "}",
      "/// `ys[i] = f(i)`（`i = 0..n`）から次数 `< n` の多項式 `f` を定め、`f(t)` を素数 `法` 上で O(n) で返す。",
      "/// `Σ i^k` のような多項式和の閉じた式を点から外挿する用途で頻出。",
      "/// `t` が `0..n` の範囲なら `ys[t]` をそのまま返す。",
      "fn 連続点補間(",
      "    ys: &[impl TryInto<u64> + Copy],",
      "    t: impl TryInto<u64>,",
      "    法: impl TryInto<u64>,",
      ") -> usize {",
      "    let ys: Vec<u64> = ys",
      "        .iter()",
      "        .map(|&y| {",
      "            y.try_into()",
      "                .ok()",
      "                .expect(\"連続点補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let t: u64 = t",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連続点補間: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連続点補間: 引数が u64 に収まりません\");",
      "    let n = ys.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    if t < n as u64 {",
      "        return (ys[t as usize] % 法) as usize;",
      "    }",
      "    let d = n - 1;",
      "    let tm = t % 法;",
      "    let mut 階乗 = vec![1u64; n];",
      "    for i in 1..n {",
      "        階乗[i] = 階乗[i - 1] * i as u64 % 法;",
      "    }",
      "    let mut 前 = vec![1u64; n + 1];",
      "    for i in 0..n {",
      "        前[i + 1] = 前[i] * ((tm + 法 - i as u64 % 法) % 法) % 法;",
      "    }",
      "    let mut 後 = vec![1u64; n + 1];",
      "    for i in (0..n).rev() {",
      "        後[i] = 後[i + 1] * ((tm + 法 - i as u64 % 法) % 法) % 法;",
      "    }",
      "    let mut 結果 = 0u64;",
      "    for i in 0..n {",
      "        let 分子 = 前[i] * 後[i + 1] % 法;",
      "        let 分母 = 階乗[i] * 階乗[d - i] % 法;",
      "        let mut 項 = ys[i] % 法 * 分子 % 法 * 逆元(分母, 法) % 法;",
      "        if (d - i) % 2 == 1 {",
      "            項 = (法 - 項) % 法;",
      "        }",
      "        結果 = (結果 + 項) % 法;",
      "    }",
      "    結果 as usize",
      "}"
    ]
  },
  "LcmConvolution": {
    "scope": "rust",
    "prefix": "LcmConvolution",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `2..n` の素数一覧を篩で求める内部関数（各ゼータ／メビウス変換で共有）。",
      "fn 素数リスト(n: usize) -> Vec<usize> {",
      "    let mut 合成 = vec![false; n];",
      "    let mut 素数 = Vec::new();",
      "    for p in 2..n {",
      "        if !合成[p] {",
      "            素数.push(p);",
      "            let mut q = p * p;",
      "            while q < n {",
      "                合成[q] = true;",
      "                q += p;",
      "            }",
      "        }",
      "    }",
      "    素数",
      "}",
      "/// 約数方向のゼータ変換。`f[i]` を `Σ_{j | i} f[j]`（約数についての総和）へ in-place 変換する。",
      "/// 添字は `1..n`。逆変換は [`約数メビウス変換`]。`O(n log log n)`。",
      "/// 要素型は加算できれば何でもよい（i64 / usize / f64 / ModInt など）。",
      "fn 約数ゼータ変換<T: Copy + std::ops::AddAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    for &p in &素数リスト(n) {",
      "        let mut i = 1;",
      "        while i * p < n {",
      "            f[i * p] += f[i];",
      "            i += 1;",
      "        }",
      "    }",
      "}",
      "/// [`約数ゼータ変換`] の逆。`Σ_{j | i} f[j]` から元の `f` を復元する。`O(n log log n)`。",
      "fn 約数メビウス変換<T: Copy + std::ops::SubAssign>(f: &mut [T]) {",
      "    let n = f.len();",
      "    for &p in &素数リスト(n) {",
      "        let mut i = (n - 1) / p;",
      "        while i >= 1 {",
      "            f[i * p] -= f[i];",
      "            i -= 1;",
      "        }",
      "    }",
      "}",
      "/// LCM 畳み込み。`h[k] = Σ_{lcm(i, j) = k} f[i]·g[j]` を `O(n log log n)` で返す（添字 `1..n`、`h[0] = 0`）。",
      "/// 要素型は加減乗できれば何でもよい（i64 / ModInt など）。",
      "fn lcm畳み込み<T>(f: &[T], g: &[T]) -> Vec<T>",
      "where",
      "    T: Copy + Default + std::ops::AddAssign + std::ops::SubAssign + std::ops::MulAssign,",
      "{",
      "    assert_eq!(f.len(), g.len());",
      "    let mut a = f.to_vec();",
      "    let mut b = g.to_vec();",
      "    約数ゼータ変換(&mut a);",
      "    約数ゼータ変換(&mut b);",
      "    a.iter_mut().zip(&b).for_each(|(x, y)| *x *= *y);",
      "    約数メビウス変換(&mut a);",
      "    if !a.is_empty() {",
      "        a[0] = T::default();",
      "    }",
      "    a",
      "}"
    ]
  },
  "LiChao": {
    "scope": "rust",
    "prefix": "LiChao",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "fn to_i64(x: impl TryInto<i64>) -> i64 {",
      "    x.try_into().ok().expect(\"i64 に収まりません\")",
      "}",
      "/// Li Chao 木（最小クエリ版）。直線 `y = 傾き·x + 切片` を **任意の順序** で追加でき、",
      "/// あらかじめ与えたクエリ座標群の各点での最小値を O(log) で求める。",
      "/// CHT（[`crate::convex_hull_trick`]）と違い傾きの単調性を要求しない。",
      "/// クエリ座標は `new` に渡したものに限る。最大値が欲しいときは傾き・切片の符号を",
      "/// 反転して入れ、結果を反転する（この実装は直線のみ、線分追加は非対応）。",
      "/// 評価は i64 素のまま行うので `傾き·x + 切片` が i64 に収まる範囲で使うこと。",
      "struct 李超木 {",
      "    xs: Vec<i64>,",
      "    直線: Vec<Option<(i64, i64)>>,",
      "}",
      "impl 李超木 {",
      "    /// クエリで使う x 座標を全て渡して構築する（重複・未ソートで可）。",
      "    /// 座標は任意の整数型の Vec / イテレータでよい（各メソッドの引数も同様）。",
      "    fn new<I>(座標群: I) -> Self",
      "    where",
      "        I: IntoIterator,",
      "        I::Item: TryInto<i64>,",
      "    {",
      "        let mut 座標群: Vec<i64> = 座標群.into_iter().map(to_i64).collect();",
      "        座標群.sort_unstable();",
      "        座標群.dedup();",
      "        if 座標群.is_empty() {",
      "            座標群.push(0);",
      "        }",
      "        let n = 座標群.len();",
      "        Self {",
      "            xs: 座標群,",
      "            直線: vec![None; 4 * n],",
      "        }",
      "    }",
      "    fn 評価(直線: (i64, i64), x: i64) -> i64 {",
      "        直線.0 * x + 直線.1",
      "    }",
      "    /// 直線 `y = 傾き·x + 切片` を追加する。",
      "    fn 直線追加(&mut self, 傾き: impl TryInto<i64>, 切片: impl TryInto<i64>) {",
      "        let n = self.xs.len();",
      "        self.追加内部(1, 0, n, (to_i64(傾き), to_i64(切片)));",
      "    }",
      "    fn 追加内部(&mut self, ノード: usize, lo: usize, hi: usize, mut 新規: (i64, i64)) {",
      "        let m = (lo + hi) / 2;",
      "        let Some(mut 現在) = self.直線[ノード] else {",
      "            self.直線[ノード] = Some(新規);",
      "            return;",
      "        };",
      "        if Self::評価(新規, self.xs[m]) < Self::評価(現在, self.xs[m]) {",
      "            std::mem::swap(&mut 新規, &mut 現在);",
      "            self.直線[ノード] = Some(現在);",
      "        }",
      "        if hi - lo == 1 {",
      "            return;",
      "        }",
      "        if Self::評価(新規, self.xs[lo]) < Self::評価(現在, self.xs[lo]) {",
      "            self.追加内部(2 * ノード, lo, m, 新規);",
      "        } else {",
      "            self.追加内部(2 * ノード + 1, m, hi, 新規);",
      "        }",
      "    }",
      "    /// クエリ座標 `x`（`new` に渡した値のいずれか）における最小値。",
      "    fn 最小値(&self, x: impl TryInto<i64>) -> i64 {",
      "        let x = to_i64(x);",
      "        let n = self.xs.len();",
      "        let idx = self.xs.partition_point(|&v| v < x);",
      "        debug_assert!(",
      "            idx < n && self.xs[idx] == x,",
      "            \"李超木: 未登録のクエリ座標 {x}\"",
      "        );",
      "        self.問い合わせ内部(1, 0, n, idx)",
      "    }",
      "    fn 問い合わせ内部(&self, ノード: usize, lo: usize, hi: usize, idx: usize) -> i64 {",
      "        let mut 最小 = self.直線[ノード]",
      "            .map(|l| Self::評価(l, self.xs[idx]))",
      "            .unwrap_or(i64::MAX);",
      "        if hi - lo > 1 {",
      "            let m = (lo + hi) / 2;",
      "            if idx < m {",
      "                最小 = 最小.min(self.問い合わせ内部(2 * ノード, lo, m, idx));",
      "            } else {",
      "                最小 = 最小.min(self.問い合わせ内部(2 * ノード + 1, m, hi, idx));",
      "            }",
      "        }",
      "        最小",
      "    }",
      "}"
    ]
  },
