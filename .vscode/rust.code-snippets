  "有向_全域木_数": {
    "scope": "rust",
    "prefix": "有向_全域木_数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `法` 上での正方行列の行列式を掃き出し（前進消去）で求める。O(n^3)。",
      "/// `法` は**素数**であること（フェルマーの小定理で逆元を取るため）。",
      "/// 行列はムーブで受け取り破壊的に消去する。`法 < 2^31` 程度を想定。",
      "fn 行列式_mod(mut 行列: Vec<Vec<u64>>, 法: u64) -> u64 {",
      "    let n = 行列.len();",
      "    for row in &mut 行列 {",
      "        for x in row.iter_mut() {",
      "            *x %= 法;",
      "        }",
      "    }",
      "    let mut 結果 = 1u64 % 法;",
      "    for 列 in 0..n {",
      "        let ピボット = (列..n).find(|&r| 行列[r][列] != 0);",
      "        let Some(p) = ピボット else {",
      "            return 0;",
      "        };",
      "        if p != 列 {",
      "            行列.swap(p, 列);",
      "            結果 = (法 - 結果) % 法;",
      "        }",
      "        let 逆 = 累乗_mod(行列[列][列], 法 - 2, 法);",
      "        結果 = 結果 * 行列[列][列] % 法;",
      "        for r in 列 + 1..n {",
      "            let 係数 = 行列[r][列] * 逆 % 法;",
      "            if 係数 != 0 {",
      "                for c in 列..n {",
      "                    行列[r][c] = (行列[r][c] + 法 - 係数 * 行列[列][c] % 法) % 法;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    結果",
      "}",
      "/// 有向版の行列木定理（Tutte の定理）。有向グラフで、根 `根` から**葉に向かって**辺が伸びる",
      "/// 全域有向木（arborescence。根以外の各頂点の入次数がちょうど 1）の個数を `法`（素数）で数える。",
      "/// O(V^3)。",
      "/// `辺` は有向辺 `(u, v)`（`u → v`、`0..頂点数`、多重辺可・自己ループは無視）。",
      "/// 無向版 [`全域木数_mod`] と違って辺の向きを区別する。",
      "/// 「根に向かう（in-arborescence）」全域木を数えたいときは全辺を逆向きにして渡す。",
      "fn 有向全域木数_mod(頂点数: usize, 辺: &[(usize, usize)], 根: usize, 法: u64) -> u64 {",
      "    if 頂点数 == 0 {",
      "        return 0;",
      "    }",
      "    if 頂点数 == 1 {",
      "        return 1 % 法;",
      "    }",
      "    let n = 頂点数;",
      "    let mut l = vec![vec![0u64; n]; n];",
      "    for &(u, v) in 辺 {",
      "        if u == v {",
      "            continue;",
      "        }",
      "        l[v][v] = (l[v][v] + 1) % 法;",
      "        l[u][v] = (l[u][v] + 法 - 1) % 法;",
      "    }",
      "    let 残: Vec<usize> = (0..n).filter(|&i| i != 根).collect();",
      "    let 小行列: Vec<Vec<u64>> = 残",
      "        .iter()",
      "        .map(|&i| 残.iter().map(|&j| l[i][j]).collect())",
      "        .collect();",
      "    行列式_mod(小行列, 法)",
      "}"
    ]
  },
