      "    /// 頂点数 `n`・辺リスト `辺`（AtCoder の入力そのまま）と根から前計算する。",
      "    fn new(n: usize, 辺: &[(usize, usize)], 根: usize) -> Self {",
      "        let グラフ = 無向グラフ(n, 辺);",
      "        let mut log = 1;",
      "        while (1usize << log) < n.max(2) {",
      "            log += 1;",
      "        }",
      "        let mut 上 = vec![vec![-1i64; n]; log];",
      "        let 深さ = vec![0usize; n];",
      "        let 入時刻 = vec![0usize; n];",
      "        let 出時刻 = vec![0usize; n];",
      "        let mut d = 構築データ {",
      "            prev: std::mem::take(&mut 上[0]),",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            時刻: 0,",
      "        };",
      "        探索(根, -1, &グラフ, &mut d);",
      "        上[0] = d.prev;",
      "        let 深さ = d.深さ;",
      "        let 入時刻 = d.入時刻;",
      "        let 出時刻 = d.出時刻;",
      "        for k in 1..log {",
      "            for v in 0..n {",
      "                let 中 = 上[k - 1][v];",
      "                上[k][v] = if 中 < 0 {",
      "                    -1",
      "                } else {",
      "                    上[k - 1][中 as usize]",
      "                };",
      "            }",
      "        }",
      "        Self {",
      "            上,",
      "            深さ,",
      "            入時刻,",
      "            出時刻,",
      "            log,",
      "        }",
      "    }",
      "    /// `a` が `b` の祖先か（自身も祖先とみなす）。",
      "    fn 祖先か(&self, a: usize, b: usize) -> bool {",
      "        self.入時刻[a] <= self.入時刻[b] && self.出時刻[b] <= self.出時刻[a]",
      "    }",
      "    /// 最近共通祖先。",
      "    fn lca(&self, mut u: usize, mut v: usize) -> usize {",
      "        if self.深さ[u] < self.深さ[v] {",
      "            std::mem::swap(&mut u, &mut v);",
      "        }",
      "        let 差 = self.深さ[u] - self.深さ[v];",
      "        for k in 0..self.log {",
      "            if (差 >> k) & 1 == 1 {",
      "                u = self.上[k][u] as usize;",
      "            }",
      "        }",
      "        if u == v {",
      "            return u;",
      "        }",
      "        for k in (0..self.log).rev() {",
      "            if self.上[k][u] != self.上[k][v] {",
      "                u = self.上[k][u] as usize;",
      "                v = self.上[k][v] as usize;",
      "            }",
      "        }",
      "        self.上[0][u] as usize",
      "    }",
      "    /// 頂点集合から仮想木を構築し、`(頂点リスト, 辺(親, 子))` を返す。",
      "    /// 頂点リストは入時刻順。辺は親が子の祖先になる向き。",
      "    fn 構築(&self, 頂点集合: &[usize]) -> (Vec<usize>, Vec<(usize, usize)>) {",
      "        if 頂点集合.is_empty() {",
      "            return (Vec::new(), Vec::new());",
      "        }",
      "        let mut s = 頂点集合.to_vec();",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 追加 = Vec::new();",
      "        for w in s.windows(2) {",
      "            追加.push(self.lca(w[0], w[1]));",
      "        }",
      "        s.extend(追加);",
      "        s.sort_by_key(|&v| self.入時刻[v]);",
      "        s.dedup();",
      "        let mut 辺 = Vec::new();",
      "        let mut スタック: Vec<usize> = Vec::new();",
      "        for &v in &s {",
      "            while let Some(&天辺) = スタック.last() {",
      "                if self.祖先か(天辺, v) {",
      "                    break;",
      "                }",
      "                スタック.pop();",
      "            }",
      "            if let Some(&天辺) = スタック.last() {",
      "                辺.push((天辺, v));",
      "            }",
      "            スタック.push(v);",
      "        }",
      "        (s, 辺)",
      "    }",
      "}",
      "/// DFS 中に埋める配列をまとめた作業領域（引数を 1 つに減らすため）。",
      "struct 構築データ {",
      "    prev: Vec<i64>,",
      "    深さ: Vec<usize>,",
      "    入時刻: Vec<usize>,",
      "    出時刻: Vec<usize>,",
      "    時刻: usize,",
      "}",
      "/// 入時刻・出時刻・深さ・直接の親を埋める DFS。",
      "fn 探索(now: usize, prev: i64, グラフ: &[Vec<usize>], d: &mut 構築データ) {",
      "    d.prev[now] = prev;",
      "    d.入時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "    for &next in &グラフ[now] {",
      "        if next as i64 != prev {",
      "            d.深さ[next] = d.深さ[now] + 1;",
      "            探索(next, now as i64, グラフ, d);",
      "        }",
      "    }",
      "    d.出時刻[now] = d.時刻;",
      "    d.時刻 += 1;",
      "}"
    ]
  },
  "複数_パターン_照合": {
    "scope": "rust",
    "prefix": "複数_パターン_照合",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::{HashMap, VecDeque};",
      "/// Aho-Corasick 法による複数パターン同時照合。バイト列（`&[u8]`）を対象とする。",
      "/// トライ + fail リンクを構築し、テキストを 1 度走査して各パターンの**出現回数**を",
      "/// まとめて数える。重なる出現も全て数える。",
      "struct エイホコラシック {",
      "    遷移: Vec<HashMap<u8, usize>>,",
      "    fail: Vec<usize>,",
      "    bfs順: Vec<usize>,",
      "    パターン終端: Vec<usize>,",
      "}",
      "impl エイホコラシック {",
      "    /// パターン群から構築する。O(Σパターン長)。空パターンは終端＝根として扱う。",
      "    fn new(パターン群: &[&[u8]]) -> Self {",
      "        let mut 遷移: Vec<HashMap<u8, usize>> = vec![HashMap::new()];",
      "        let mut パターン終端 = vec![0usize; パターン群.len()];",
      "        for (pi, pat) in パターン群.iter().enumerate() {",
      "            let mut cur = 0usize;",
      "            for &c in *pat {",
      "                if let Some(&nx) = 遷移[cur].get(&c) {",
      "                    cur = nx;",
      "                } else {",
      "                    let 新 = 遷移.len();",
      "                    遷移.push(HashMap::new());",
      "                    遷移[cur].insert(c, 新);",
      "                    cur = 新;",
      "                }",
      "            }",
      "            パターン終端[pi] = cur;",
      "        }",
      "        let mut fail = vec![0usize; 遷移.len()];",
      "        let mut bfs順 = Vec::new();",
      "        let mut 探索 = VecDeque::new();",
      "        let 直下: Vec<usize> = 遷移[0].values().copied().collect();",
      "        for next in 直下 {",
      "            fail[next] = 0;",
      "            bfs順.push(next);",
      "            探索.push_back(next);",
      "        }",
      "        while let Some(now) = 探索.pop_front() {",
      "            let 子: Vec<(u8, usize)> = 遷移[now].iter().map(|(&c, &next)| (c, next)).collect();",
      "            for (c, next) in 子 {",
      "                let mut f = fail[now];",
      "                let nf = loop {",
      "                    if let Some(&nx) = 遷移[f].get(&c) {",
      "                        break nx;",
      "                    }",
      "                    if f == 0 {",
      "                        break 0;",
      "                    }",
      "                    f = fail[f];",
      "                };",
      "                fail[next] = nf;",
      "                bfs順.push(next);",
      "                探索.push_back(next);",
      "            }",
      "        }",
      "        Self {",
      "            遷移,",
      "            fail,",
      "            bfs順,",
      "            パターン終端,",
      "        }",
      "    }",
      "    /// 文字 `c` での遷移（fail リンクを辿るオートマトン遷移）。",
      "    fn 進む(&self, mut v: usize, c: u8) -> usize {",
      "        loop {",
      "            if let Some(&nx) = self.遷移[v].get(&c) {",
      "                return nx;",
      "            }",
      "            if v == 0 {",
      "                return 0;",
      "            }",
      "            v = self.fail[v];",
      "        }",
      "    }",
      "    /// `テキスト` 中での各パターンの出現回数を、`new` に渡した順で返す。",
      "    /// O(テキスト長 + マッチ数)。",
      "    fn 出現回数(&self, テキスト: &[u8]) -> Vec<usize> {",
      "        let mut 訪問 = vec![0usize; self.遷移.len()];",
      "        let mut v = 0usize;",
      "        for &c in テキスト {",
      "            v = self.進む(v, c);",
      "            訪問[v] += 1;",
      "        }",
      "        for &node in self.bfs順.iter().rev() {",
      "            訪問[self.fail[node]] += 訪問[node];",
      "        }",
      "        self.パターン終端.iter().map(|&node| 訪問[node]).collect()",
      "    }",
      "}"
    ]
  },
  "複数_始点_BFS": {
    "scope": "rust",
    "prefix": "複数_始点_BFS",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 多点（複数始点）BFS。複数の始点から同時に幅優先探索し、各頂点について",
      "/// 「最も近い始点からの距離（辺数）」を求める。O(V+E)。",
      "/// `グラフ[u]` は隣接頂点の列。`始点群` の各頂点は距離 0 として一斉にキューへ入れる。",
      "/// どの始点からも到達不能な頂点は `None`。",
      "fn 多点bfs(グラフ: &[Vec<usize>], 始点群: &[usize]) -> Vec<Option<usize>> {",
      "    use std::collections::VecDeque;",
      "    let n = グラフ.len();",
      "    let mut 距離: Vec<Option<usize>> = vec![None; n];",
      "    let mut 探索: VecDeque<usize> = VecDeque::new();",
      "    for &s in 始点群 {",
      "        if 距離[s].is_none() {",
      "            距離[s] = Some(0);",
      "            探索.push_back(s);",
      "        }",
      "    }",
      "    while let Some(now) = 探索.pop_front() {",
      "        let d = 距離[now].unwrap();",
      "        for &next in &グラフ[now] {",
      "            if 距離[next].is_none() {",
      "                距離[next] = Some(d + 1);",
      "                探索.push_back(next);",
      "            }",
      "        }",
      "    }",
      "    距離",
      "}"
    ]
  },
  "複素数_畳み込み": {
    "scope": "rust",
    "prefix": "複素数_畳み込み",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use num::complex::Complex64;",
      "/// 複素 FFT（反復版）。`逆 = true` で逆変換。`a.len()` は 2 冪であること。内部関数。",
      "fn fft内部(a: &mut [Complex64], 逆: bool) {",
      "    let n = a.len();",
      "    if n <= 1 {",
      "        return;",
      "    }",
      "    let mut j = 0usize;",
      "    for i in 1..n {",
      "        let mut bit = n >> 1;",
      "        while j & bit != 0 {",
      "            j ^= bit;",
      "            bit >>= 1;",
      "        }",
      "        j |= bit;",
      "        if i < j {",
      "            a.swap(i, j);",
      "        }",
      "    }",
      "    let mut len = 2;",
      "    while len <= n {",
      "        let 符号 = if 逆 { -1.0 } else { 1.0 };",
      "        let 角度 = 2.0 * std::f64::consts::PI / len as f64 * 符号;",
      "        let w_len = Complex64::new(角度.cos(), 角度.sin());",
      "        let mut i = 0;",
      "        while i < n {",
      "            let mut w = Complex64::new(1.0, 0.0);",
      "            for k in 0..len / 2 {",
      "                let u = a[i + k];",
      "                let v = a[i + k + len / 2] * w;",
      "                a[i + k] = u + v;",
      "                a[i + k + len / 2] = u - v;",
      "                w *= w_len;",
      "            }",
      "            i += len;",
      "        }",
      "        len <<= 1;",
      "    }",
      "    if 逆 {",
      "        let 逆数 = 1.0 / n as f64;",
      "        for x in a.iter_mut() {",
      "            *x *= 逆数;",
      "        }",
      "    }",
      "}",
      "/// 整数列 `a`, `b` の畳み込み（多項式の積の係数）を FFT で求める。O(M log M)。",
      "/// 返り値の長さは `a.len() + b.len() - 1`。`ac_library::convolution` は素数 mod 専用なので、",
      "/// mod を取らない素直な整数畳み込みが要るときにこちらを使う。値が大きいと `f64` 精度で",
      "/// 誤差が出る点に注意（おおむね 結果の各項 < 2^52 まで安全）。",
      "fn 畳み込み(a: &[i64], b: &[i64]) -> Vec<i64> {",
      "    if a.is_empty() || b.is_empty() {",
      "        return Vec::new();",
      "    }",
      "    let 結果長 = a.len() + b.len() - 1;",
      "    let mut サイズ = 1usize;",
      "    while サイズ < 結果長 {",
      "        サイズ <<= 1;",
      "    }",
      "    let mut fa: Vec<Complex64> = (0..サイズ)",
      "        .map(|i| Complex64::new(*a.get(i).unwrap_or(&0) as f64, 0.0))",
      "        .collect();",
      "    let mut fb: Vec<Complex64> = (0..サイズ)",
      "        .map(|i| Complex64::new(*b.get(i).unwrap_or(&0) as f64, 0.0))",
      "        .collect();",
      "    fft内部(&mut fa, false);",
      "    fft内部(&mut fb, false);",
      "    for (x, y) in fa.iter_mut().zip(fb.iter()) {",
      "        *x *= *y;",
      "    }",
      "    fft内部(&mut fa, true);",
      "    fa.iter()",
      "        .take(結果長)",
      "        .map(|c| c.re.round() as i64)",
      "        .collect()",
      "}"
    ]
  },
  "解の_個数_mod": {
    "scope": "rust",
    "prefix": "解の_個数_mod",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 素数 `法` 上での行列の**階数（ランク）**を掃き出しで求める。O(行数·列数·min(行,列))。",
      "/// 行は長さがそろっていること。係数行列のランクは、線形独立な行（＝式）の本数や、",
      "/// ベクトル集合の張る空間の次元を表す。`法` は**素数**。GF(2) 専用の速い版は",
      "/// [`crate::gf2_elimination`]、解そのものは [`連立一次方程式_mod`]。",
      "fn 行列の階数_mod(行列: &[Vec<u64>], 法: u64) -> usize {",
      "    let 行数 = 行列.len();",
      "    if 行数 == 0 {",
      "        return 0;",
      "    }",
      "    let 列数 = 行列[0].len();",
      "    let mut a: Vec<Vec<u64>> = 行列",
      "        .iter()",
      "        .map(|row| row.iter().map(|&x| x % 法).collect())",
      "        .collect();",
      "    let mut rank = 0usize;",
      "    #[allow(clippy::needless_range_loop)]",
      "    for c in 0..列数 {",
      "        if rank == 行数 {",
      "            break;",
      "        }",
      "        let Some(sel) = (rank..行数).find(|&i| a[i][c] != 0) else {",
      "            continue;",
      "        };",
      "        a.swap(rank, sel);",
      "        let inv = 累乗_mod(a[rank][c], 法 - 2, 法);",
      "        for j in c..列数 {",
      "            a[rank][j] = a[rank][j] * inv % 法;",
      "        }",
      "        for i in 0..行数 {",
      "            if i != rank && a[i][c] != 0 {",
      "                let f = a[i][c];",
      "                for j in c..列数 {",
      "                    a[i][j] = (a[i][j] + 法 - f * a[rank][j] % 法) % 法;",
      "                }",
      "            }",
      "        }",
      "        rank += 1;",
      "    }",
      "    rank",
      "}",
      "/// 素数 `法` 上の連立一次方程式 `A x = b` の解の**自由度**（自由変数の個数）を返す。",
      "/// 矛盾（解なし）なら `None`。解の総数は `法^自由度`。O(行数·列数·min)。",
      "/// 解を 1 つだけ欲しいときは [`連立一次方程式_mod`]、解の個数を数えたいときにこちらを使う。",
      "fn 連立方程式の自由度_mod(係数: &[Vec<u64>], 右辺: &[u64], 法: u64) -> Option<usize> {",
      "    let 変数数 = if 係数.is_empty() {",
      "        0",
      "    } else {",
      "        係数[0].len()",
      "    };",
      "    let r = 行列の階数_mod(係数, 法);",
      "    let 拡大: Vec<Vec<u64>> = 係数",
      "        .iter()",
      "        .zip(右辺)",
      "        .map(|(row, &b)| {",
      "            let mut row = row.clone();",
      "            row.push(b);",
      "            row",
      "        })",
      "        .collect();",
      "    let ra = 行列の階数_mod(&拡大, 法);",
      "    if ra > r {",
      "        return None;",
      "    }",
      "    Some(変数数 - r)",
      "}"
    ]
  },
  "調和_級数の_列挙": {
    "scope": "rust",
    "prefix": "調和_級数の_列挙",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `⌊n/i⌋`（`i = 1..=n`）の値が一定になる `i` の区間をまとめて列挙する。O(√n)。",
      "/// 各要素は `(商, 左, 右)`：`i ∈ [左, 右]` の範囲で `⌊n/i⌋ == 商`。区間は `i` の昇順、",
      "/// `商` は降順に並ぶ。`Σ_{i=1}^{n} ⌊n/i⌋` や約数関数の和などを O(√n) で計算するのに使う。",
      "fn 商の列挙(n: u64) -> Vec<(u64, u64, u64)> {",
      "    let mut res = Vec::new();",
      "    let mut i = 1;",
      "    while i <= n {",
      "        let 商 = n / i;",
      "        let 右 = n / 商;",
      "        res.push((商, i, 右));",
      "        i = 右 + 1;",
      "    }",
      "    res",
      "}"
    ]
  },
  "距離_2乗": {
    "scope": "rust",
    "prefix": "距離_2乗",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 2 点間の距離の 2 乗を `i128` で返す。",
      "/// 平方根を取らないので誤差なしで距離を比較できる。差を取ってから `i128` に広げるため、",
      "/// 座標が `±10^18` でも桁あふれしない。実距離が要るときは `(d as f64).sqrt()`。",
      "fn 距離2乗(a: (i64, i64), b: (i64, i64)) -> i128 {",
      "    let dx = (a.0 - b.0) as i128;",
      "    let dy = (a.1 - b.1) as i128;",
      "    dx * dx + dy * dy",
      "}"
    ]
  },
  "距離_総和": {
    "scope": "rust",
    "prefix": "距離_総和",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 辺リストから無向グラフの隣接リストを作る。`O(n + 辺数)`。",
      "/// `辺` は AtCoder の入力をそのまま 0-indexed にしたもの（`辺[i] = (u, v)`）。",
      "/// `グラフ[u]` に `v`、`グラフ[v]` に `u` を積むだけなので、多重辺はそのまま重複して入り、",
      "/// 自己ループ `(u, u)` は `グラフ[u]` に 2 回入る。孤立頂点があってもよいので `n` は必須。",
      "fn 無向グラフ(n: usize, 辺: &[(usize, usize)]) -> Vec<Vec<usize>> {",
      "    let mut グラフ = vec![Vec::new(); n];",
      "    for &(u, v) in 辺 {",
      "        グラフ[u].push(v);",
      "        グラフ[v].push(u);",
      "    }",
      "    グラフ",
      "}",
      "/// 全方位木DP（再帰なし版）の代表例。各頂点 `v` について",
      "/// 「`v` から木の全頂点への距離（辺数）の総和」を一括で O(N) 計算する。",
      "/// `辺` は AtCoder の入力そのまま（0-indexed の頂点対、重みなし無向木）。",
      "/// 戻り値 `ans[v]` が頂点 `v` の距離総和。",
      "fn 全頂点への距離総和(n: usize, 辺: &[(usize, usize)]) -> Vec<i64> {",
      "    if n == 0 {",
      "        return vec![];",
      "    }",
      "    let グラフ = 無向グラフ(n, 辺);",
      "    let mut prev = vec![!0; n];",
      "    let mut 順 = Vec::with_capacity(n);",
      "    let mut 到達済 = vec![false; n];",
      "    let mut 探索 = vec![0usize];",
      "    到達済[0] = true;",
      "    while let Some(now) = 探索.pop() {",
      "        順.push(now);",
      "        for &next in &グラフ[now] {",
      "            if !到達済[next] {",
      "                到達済[next] = true;",
      "                prev[next] = now;",
      "                探索.push(next);",
      "            }",
      "        }",
      "    }",
      "    let mut sz = vec![1i64; n];",
      "    let mut 部分木距離和 = vec![0i64; n];",
      "    for &now in 順.iter().rev() {",
      "        let p = prev[now];",
      "        if p != !0 {",
      "            sz[p] += sz[now];",
      "            部分木距離和[p] += 部分木距離和[now] + sz[now];",
      "        }",
      "    }",
      "    let mut ans = vec![0i64; n];",
      "    ans[0] = 部分木距離和[0];",
      "    for &now in &順 {",
      "        for &next in &グラフ[now] {",
      "            if prev[next] == now {",
      "                ans[next] = ans[now] + (n as i64 - sz[next]) - sz[next];",
      "            }",
      "        }",
      "    }",
      "    ans",
      "}"
    ]
  },
  "転倒数": {
    "scope": "rust",
    "prefix": "転倒数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// `b` を基準順序としたときの `a` の転倒数（= `a` を `b` に並べ替えるのに必要な隣接交換の最小回数）。",
      "/// `a`・`b` は同じ要素からなる順列。BIT で O(N log N)。",
      "fn 転倒数(a: &[usize], b: &[usize]) -> usize {",
      "    use ac_library::FenwickTree;",
      "    let mut bの逆置換 = vec![0; a.len()];",
      "    for (i, &値) in b.iter().enumerate() {",
      "        bの逆置換[値] = i;",
      "    }",
      "    let mut bit = FenwickTree::new(a.len(), 0_usize);",
      "    a.iter().fold(0, |acc, &値| {",
      "        let pos = bの逆置換[値];",
      "        bit.add(pos, 1);",
      "        acc + bit.sum(pos + 1..)",
      "    })",
      "}"
    ]
  },
  "追加のみ_Mo": {
    "scope": "rust",
    "prefix": "追加のみ_Mo",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 「追加は容易だが削除が難しい」区間クエリを扱うロールバック Mo の状態インタフェース。",
      "/// 削除の代わりに、チェックポイント [`保存`](ロールバックMo::保存) と",
      "/// [`巻き戻し`](ロールバックMo::巻き戻し) で状態を巻き戻す。区間の左側の一時追加を",
      "/// 巻き戻すことで、各左ブロック内で右ポインタを単調増加に保ったまま処理できる。",
      "/// 素の [`Mo`](crate::mo)・[更新あり Mo](crate::mo_with_updates) とは別アルゴリズム。",
      "/// 連結性（rollback 可能 union-find）や max・mode 系で使う。",
      "trait ロールバックMo {",
      "    /// 各クエリに対する答えの型。",
      "    type 出力;",
      "    /// 位置 `位置` の要素を現在の集合に加える（削除は無い）。",
      "    fn 追加(&mut self, 位置: usize);",
      "    /// 現在の状態をチェックポイントとして積む。",
      "    fn 保存(&mut self);",
      "    /// 直近のチェックポイントまで状態を巻き戻す（その時点以降の追加を取り消す）。",
      "    fn 巻き戻し(&mut self);",
      "    /// 状態を空に戻す（各左ブロックの処理開始時に呼ばれる）。",
      "    fn 全消去(&mut self);",
      "    /// 現在の集合に対する答えを返す。",
      "    fn 答え(&mut self) -> Self::出力;",
      "}",
      "/// ロールバック Mo 本体。`n` は要素数、`クエリ` は半開区間 `[l, r)`（`l < r`）の列。",
      "/// 全体 `O((N + Q)√N · 追加コスト)`。`状態` は空の初期状態で渡すこと。",
      "fn ロールバックmo実行<S: ロールバックMo>(",
      "    状態: &mut S,",
      "    n: usize,",
      "    クエリ: &[(usize, usize)],",
      ") -> Vec<S::出力> {",
      "    let q = クエリ.len();",
      "    if q == 0 {",
      "        return Vec::new();",
      "    }",
      "    let b = ((n as f64).sqrt() as usize).max(1);",
      "    let mut 順: Vec<usize> = (0..q).collect();",
      "    順.sort_by(|&x, &y| {",
      "        let (lx, rx) = クエリ[x];",
      "        let (ly, ry) = クエリ[y];",
      "        let (bx, by) = (lx / b, ly / b);",
      "        if bx != by {",
      "            bx.cmp(&by)",
      "        } else {",
      "            rx.cmp(&ry)",
      "        }",
      "    });",
      "    let mut 答え: Vec<Option<S::出力>> = (0..q).map(|_| None).collect();",
      "    let mut idx = 0;",
      "    while idx < 順.len() {",
      "        let ブロック = クエリ[順[idx]].0 / b;",
      "        let r0 = ((ブロック + 1) * b).min(n);",
      "        状態.全消去();",
      "        let mut 右 = r0;",
      "        while idx < 順.len() && クエリ[順[idx]].0 / b == ブロック {",
      "            let i = 順[idx];",
      "            let (l, r) = クエリ[i];",
      "            if r <= r0 {",
      "                状態.保存();",
      "                for p in l..r {",
      "                    状態.追加(p);",
      "                }",
      "                答え[i] = Some(状態.答え());",
      "                状態.巻き戻し();",
      "                idx += 1;",
      "                continue;",
      "            }",
      "            while 右 < r {",
      "                状態.追加(右);",
      "                右 += 1;",
      "            }",
      "            状態.保存();",
      "            for p in (l..r0).rev() {",
      "                状態.追加(p);",
      "            }",
      "            答え[i] = Some(状態.答え());",
      "            状態.巻き戻し();",
      "            idx += 1;",
      "        }",
      "    }",
      "    答え.into_iter().map(|o| o.unwrap()).collect()",
      "}"
    ]
  },
  "連分数": {
    "scope": "rust",
    "prefix": "連分数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::cmp::Ordering;",
      "/// 非負の有理数 `分子 / 分母`（`分母 > 0`）の正則連分数展開 `[a0; a1, a2, …]` を返す。",
      "/// ユークリッドの互除法そのもの。`O(log 分母)`。",
      "fn 連分数展開(分子: impl TryInto<i64>, 分母: impl TryInto<i64>) -> Vec<i64> {",
      "    let mut 分子 = 分子",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連分数展開: 引数が i64 に収まりません\");",
      "    let mut 分母 = 分母",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連分数展開: 引数が i64 に収まりません\");",
      "    assert!(分母 > 0 && 分子 >= 0, \"分子 >= 0, 分母 > 0\");",
      "    let mut 係数 = Vec::new();",
      "    while 分母 != 0 {",
      "        係数.push(分子 / 分母);",
      "        let r = 分子 % 分母;",
      "        分子 = 分母;",
      "        分母 = r;",
      "    }",
      "    係数",
      "}",
      "/// 連分数係数列から収束分数（convergent）`(分子, 分母)` の列を返す。",
      "/// `h_i = a_i·h_{i-1} + h_{i-2}`, `k_i = a_i·k_{i-1} + k_{i-2}`。各収束分数は既約。",
      "fn 収束分数(係数: &[i64]) -> Vec<(i64, i64)> {",
      "    let mut 列 = Vec::with_capacity(係数.len());",
      "    let (mut h2, mut h1) = (0i64, 1i64);",
      "    let (mut k2, mut k1) = (1i64, 0i64);",
      "    for &a in 係数 {",
      "        let h = a * h1 + h2;",
      "        let k = a * k1 + k2;",
      "        列.push((h, k));",
      "        h2 = h1;",
      "        h1 = h;",
      "        k2 = k1;",
      "        k1 = k;",
      "    }",
      "    列",
      "}",
      "/// `分子/分母` への近さ `|分子/分母 - a/b|` を厳密に比較する内部関数（小さいほど近い）。",
      "fn 距離cmp(分子: i64, 分母: i64, x: (i64, i64), y: (i64, i64)) -> Ordering {",
      "    let (p, q) = (分子 as i128, 分母 as i128);",
      "    let dx = (p * x.1 as i128 - x.0 as i128 * q).abs() * y.1 as i128;",
      "    let dy = (p * y.1 as i128 - y.0 as i128 * q).abs() * x.1 as i128;",
      "    dx.cmp(&dy)",
      "}",
      "/// `x = 分子/分母` に最も近い有理数 `a/b`（`1 <= b <= 分母上限`）を `O(log 分母)` で求める。",
      "/// 連分数の収束分数と半収束分数（semiconvergent）のうち、分母が上限以下で最も近いものを返す。",
      "/// 距離が等しいときは分母が小さい方。`x` が `分母上限` 以下の分母で厳密表現できればそれを返す。",
      "/// Stern–Brocot 木上の最良近似。",
      "fn 最良有理近似(",
      "    分子: impl TryInto<i64>,",
      "    分母: impl TryInto<i64>,",
      "    分母上限: impl TryInto<i64>,",
      ") -> (i64, i64) {",
      "    let 分子 = 分子",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    let 分母 = 分母",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    let 分母上限 = 分母上限",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"最良有理近似: 引数が i64 に収まりません\");",
      "    assert!(分母 > 0 && 分子 >= 0 && 分母上限 >= 1);",
      "    let (mut a, mut b) = (分子, 分母);",
      "    let (mut h2, mut h1) = (0i64, 1i64);",
      "    let (mut k2, mut k1) = (1i64, 0i64);",
      "    loop {",
      "        if b == 0 {",
      "            return (h1, k1);",
      "        }",
      "        let ai = a / b;",
      "        let r = a % b;",
      "        let k = ai * k1 + k2;",
      "        if k > 分母上限 {",
      "            let ap = (分母上限 - k2) / k1;",
      "            let 半 = (ap * h1 + h2, ap * k1 + k2);",
      "            let 前 = (h1, k1);",
      "            return match 距離cmp(分子, 分母, 半, 前) {",
      "                Ordering::Less => 半,",
      "                Ordering::Greater => 前,",
      "                Ordering::Equal => {",
      "                    if 半.1 <= 前.1 {",
      "                        半",
      "                    } else {",
      "                        前",
      "                    }",
      "                }",
      "            };",
      "        }",
      "        let h = ai * h1 + h2;",
      "        h2 = h1;",
      "        h1 = h;",
      "        k2 = k1;",
      "        k1 = k;",
      "        a = b;",
      "        b = r;",
      "    }",
      "}"
    ]
  },
  "連続点_補間": {
    "scope": "rust",
    "prefix": "連続点_補間",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 素数 `法` を法とする `a` の逆元（フェルマーの小定理 `a^(法-2)`）。`O(log 法)`。",
      "/// `法` が素数で `a % 法 != 0` であることが前提。合成数を法とする場合や `a` が",
      "/// `法` の倍数の場合は正しい値を返さない（拡張ユークリッドを使うこと）。",
      "fn 逆元(a: u64, 法: u64) -> u64 {",
      "    累乗_mod(a, 法 - 2, 法)",
      "}",
      "/// `a^e mod 法` を繰り返し二乗法で計算する。`O(log e)`。",
      "/// 途中の積を `u128` で取るので `法 < 2^63` まで桁あふれしない。`法 == 1` のときは",
      "/// `1 % 法 == 0` なので `e == 0` でも 0 を返す（数学的に正しい）。",
      "/// `ac_library::modint` を使える場面ではそちらの `pow` で足りる。これは法が実行時に",
      "/// 決まる（入力で与えられる・素因数ごとに変わる）ときのための素の実装。",
      "fn 累乗_mod(mut a: u64, mut e: u64, 法: u64) -> u64 {",
      "    let mut r = 1u64 % 法;",
      "    a %= 法;",
      "    while e > 0 {",
      "        if e & 1 == 1 {",
      "            r = ((r as u128 * a as u128) % 法 as u128) as u64;",
      "        }",
      "        a = ((a as u128 * a as u128) % 法 as u128) as u64;",
      "        e >>= 1;",
      "    }",
      "    r",
      "}",
      "/// 相異なる点 `(xs[i], ys[i])` を通る次数 `< n` の多項式を素数 `法` 上で求め、`t` での値を返す。O(n^2)。",
      "/// `法` は素数で、`xs` は互いに異なること。点が等間隔（0,1,2,...）なら [`連続点補間`] が O(n) で速い。",
      "fn ラグランジュ補間(",
      "    xs: &[impl TryInto<u64> + Copy],",
      "    ys: &[impl TryInto<u64> + Copy],",
      "    t: impl TryInto<u64>,",
      "    法: impl TryInto<u64>,",
      ") -> usize {",
      "    let xs: Vec<u64> = xs",
      "        .iter()",
      "        .map(|&x| {",
      "            x.try_into()",
      "                .ok()",
      "                .expect(\"ラグランジュ補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let ys: Vec<u64> = ys",
      "        .iter()",
      "        .map(|&y| {",
      "            y.try_into()",
      "                .ok()",
      "                .expect(\"ラグランジュ補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let t: u64 = t",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ラグランジュ補間: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"ラグランジュ補間: 引数が u64 に収まりません\");",
      "    let n = xs.len();",
      "    let t = t % 法;",
      "    let mut 結果 = 0u64;",
      "    for i in 0..n {",
      "        let mut 分子 = 1u64;",
      "        let mut 分母 = 1u64;",
      "        for j in 0..n {",
      "            if i != j {",
      "                分子 = 分子 * ((t + 法 - xs[j] % 法) % 法) % 法;",
      "                分母 = 分母 * ((xs[i] % 法 + 法 - xs[j] % 法) % 法) % 法;",
      "            }",
      "        }",
      "        結果 = (結果 + ys[i] % 法 * 分子 % 法 * 逆元(分母, 法)) % 法;",
      "    }",
      "    結果 as usize",
      "}",
      "/// `ys[i] = f(i)`（`i = 0..n`）から次数 `< n` の多項式 `f` を定め、`f(t)` を素数 `法` 上で O(n) で返す。",
      "/// `Σ i^k` のような多項式和の閉じた式を点から外挿する用途で頻出。",
      "/// `t` が `0..n` の範囲なら `ys[t]` をそのまま返す。",
      "fn 連続点補間(",
      "    ys: &[impl TryInto<u64> + Copy],",
      "    t: impl TryInto<u64>,",
      "    法: impl TryInto<u64>,",
      ") -> usize {",
      "    let ys: Vec<u64> = ys",
      "        .iter()",
      "        .map(|&y| {",
      "            y.try_into()",
      "                .ok()",
      "                .expect(\"連続点補間: 引数が u64 に収まりません\")",
      "        })",
      "        .collect();",
      "    let t: u64 = t",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連続点補間: 引数が u64 に収まりません\");",
      "    let 法: u64 = 法",
      "        .try_into()",
      "        .ok()",
      "        .expect(\"連続点補間: 引数が u64 に収まりません\");",
      "    let n = ys.len();",
      "    if n == 0 {",
      "        return 0;",
      "    }",
      "    if t < n as u64 {",
      "        return (ys[t as usize] % 法) as usize;",
      "    }",
      "    let d = n - 1;",
      "    let tm = t % 法;",
      "    let mut 階乗 = vec![1u64; n];",
      "    for i in 1..n {",
      "        階乗[i] = 階乗[i - 1] * i as u64 % 法;",
      "    }",
      "    let mut 前 = vec![1u64; n + 1];",
      "    for i in 0..n {",
      "        前[i + 1] = 前[i] * ((tm + 法 - i as u64 % 法) % 法) % 法;",
      "    }",
      "    let mut 後 = vec![1u64; n + 1];",
      "    for i in (0..n).rev() {",
      "        後[i] = 後[i + 1] * ((tm + 法 - i as u64 % 法) % 法) % 法;",
      "    }",
      "    let mut 結果 = 0u64;",
      "    for i in 0..n {",
      "        let 分子 = 前[i] * 後[i + 1] % 法;",
      "        let 分母 = 階乗[i] * 階乗[d - i] % 法;",
      "        let mut 項 = ys[i] % 法 * 分子 % 法 * 逆元(分母, 法) % 法;",
      "        if (d - i) % 2 == 1 {",
      "            項 = (法 - 項) % 法;",
      "        }",
      "        結果 = (結果 + 項) % 法;",
      "    }",
      "    結果 as usize",
      "}"
    ]
  },
  "適応_シンプソン_積分": {
    "scope": "rust",
    "prefix": "適応_シンプソン_積分",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "/// 関数 `f` の区間 `[a, b]` 上の定積分を**適応的シンプソン法**で近似する。許容誤差 `許容誤差`。",
      "/// 収束していない所だけ再帰的に細かく刻む。再帰深さは最大 50。",
      "/// [`黄金分割探索`](crate::ternary_search) は凸関数の最小化で別目的。",
      "/// 幾何の面積・確率分布・物理量の累積など、閉形式が無い積分に使う。",
      "fn 数値積分<F: Fn(f64) -> f64>(f: &F, a: f64, b: f64, 許容誤差: f64) -> f64 {",
      "    fn 単純<F: Fn(f64) -> f64>(f: &F, a: f64, b: f64) -> f64 {",
      "        let c = (a + b) * 0.5;",
      "        (b - a) / 6.0 * (f(a) + 4.0 * f(c) + f(b))",
      "    }",
      "    #[allow(clippy::too_many_arguments)]",
      "    fn 再帰<F: Fn(f64) -> f64>(",
      "        f: &F, a: f64, b: f64, eps: f64, 全体: f64, 深さ: usize",
      "    ) -> f64 {",
      "        let c = (a + b) * 0.5;",
      "        let 左 = 単純(f, a, c);",
      "        let 右 = 単純(f, c, b);",
      "        let 差 = 左 + 右 - 全体;",
      "        if 深さ == 0 || 差.abs() <= 15.0 * eps {",
      "            return 左 + 右 + 差 / 15.0;",
      "        }",
      "        再帰(f, a, c, eps * 0.5, 左, 深さ - 1) + 再帰(f, c, b, eps * 0.5, 右, 深さ - 1)",
      "    }",
      "    再帰(f, a, b, 許容誤差, 単純(f, a, b), 50)",
      "}"
    ]
  },
  "部分_文字列の_数": {
    "scope": "rust",
    "prefix": "部分_文字列の_数",
    "body": [
      "// https://github.com/tb158/atcoder-rust-devcontainer",
      "use std::collections::HashMap;",
      "/// 接尾辞オートマトンの 1 状態。`len` は同値類の最長文字列長、`link` は suffix link",
      "/// （根は -1）、`next` は文字ごとの遷移先。",
      "struct 状態 {",
      "    len: usize,",
      "    link: i64,",
      "    next: HashMap<u8, usize>,",
      "}",
      "/// 接尾辞オートマトン（SAM）。文字列の全部分文字列を O(N) 状態で表す。構築 O(N)。",
      "/// - [`Self::相異なる部分文字列数`] : 相異なる（空でない）部分文字列の個数。",
      "/// - [`Self::含む`] : ある文字列が部分文字列として現れるか。",
      "struct 接尾辞オートマトン {",
      "    states: Vec<状態>,",
      "    last: usize,",
      "}",
      "impl 接尾辞オートマトン {",
      "    fn new() -> Self {",
      "        Self {",
      "            states: vec![状態 {",
      "                len: 0,",
      "                link: -1,",
      "                next: HashMap::new(),",
      "            }],",
      "            last: 0,",
      "        }",
      "    }",
      "    /// バイト列から構築する。",
      "    fn 構築(s: &[u8]) -> Self {",
      "        let mut sam = Self::new();",
      "        for &c in s {",
      "            sam.追加(c);",
      "        }",
      "        sam",
      "    }",
      "    /// 末尾に 1 文字追加する（オンライン構築）。",
      "    fn 追加(&mut self, c: u8) {",
      "        let cur = self.states.len();",
      "        self.states.push(状態 {",
      "            len: self.states[self.last].len + 1,",
      "            link: -1,",
      "            next: HashMap::new(),",
      "        });",
      "        let mut p = self.last as i64;",
      "        while p != -1 && !self.states[p as usize].next.contains_key(&c) {",
      "            self.states[p as usize].next.insert(c, cur);",
      "            p = self.states[p as usize].link;",
      "        }",
      "        if p == -1 {",
      "            self.states[cur].link = 0;",
      "        } else {",
      "            let q = self.states[p as usize].next[&c];",
      "            if self.states[p as usize].len + 1 == self.states[q].len {",
      "                self.states[cur].link = q as i64;",
      "            } else {",
      "                let clone = self.states.len();",
      "                self.states.push(状態 {",
      "                    len: self.states[p as usize].len + 1,",
      "                    link: self.states[q].link,",
      "                    next: self.states[q].next.clone(),",
      "                });",
      "                while p != -1 && self.states[p as usize].next.get(&c) == Some(&q) {",
      "                    self.states[p as usize].next.insert(c, clone);",
      "                    p = self.states[p as usize].link;",
      "                }",
      "                self.states[q].link = clone as i64;",
      "                self.states[cur].link = clone as i64;",
      "            }",
      "        }",
      "        self.last = cur;",
      "    }",
      "    /// 相異なる（空でない）部分文字列の個数。O(状態数)。",
      "    fn 相異なる部分文字列数(&self) -> usize {",
      "        let mut 合計 = 0usize;",
      "        for v in 1..self.states.len() {",
      "            let link = self.states[v].link;",
      "            let 親len = if link < 0 {",
      "                0",
      "            } else {",
      "                self.states[link as usize].len",
      "            };",
      "            合計 += self.states[v].len - 親len;",
      "        }",
      "        合計",
      "    }",
      "    /// `t` が部分文字列として現れるか。O(|t|)。",
      "    fn 含む(&self, t: &[u8]) -> bool {",
      "        let mut v = 0usize;",
      "        for &c in t {",
      "            match self.states[v].next.get(&c) {",
      "                Some(&nx) => v = nx,",
      "                None => return false,",
      "            }",
      "        }",
      "        true",
      "    }",
      "}",
      "impl Default for 接尾辞オートマトン {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
