      "fn スライド最大値<T: Ord + Copy>(a: &[T], 窓: usize) -> Vec<T> {",
      "    use std::collections::VecDeque;",
      "    let mut res = Vec::new();",
      "    if 窓 == 0 || 窓 > a.len() {",
      "        return res;",
      "    }",
      "    let mut dq: VecDeque<usize> = VecDeque::new();",
      "    for (i, &x) in a.iter().enumerate() {",
      "        while let Some(&後) = dq.back() {",
