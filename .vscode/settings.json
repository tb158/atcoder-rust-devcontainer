            "body": [
                "// https://github.com/tb158/atcoder-rust-devcontainer",
                "// 各制約を辺集合のビットマスク (u64 等) で持つ",
                "let mut ${1:解答} = 0i64;",
                "for ${2:bit} in 0..(1 << ${3:m}) {",
                "    let mut ${4:eset} = 0u64;",
                "    for i in 0..${3:m} {",
                "        if (${2:bit} >> i) & 1 == 1 {",
                "            ${4:eset} |= ${5:cons}[i];",
                "        }",
                "    }",
                "    let ${6:white} = ${4:eset}.count_ones() as usize;",
                "    let ${7:num} = 1i64 << (${8:n} - 1 - ${6:white});",
                "    if ${2:bit}.count_ones() % 2 == 0 {",
                "        ${1:解答} += ${7:num};",
                "    } else {",
                "        ${1:解答} -= ${7:num};",
                "    }",
                "}",
                "$0"
            ],
