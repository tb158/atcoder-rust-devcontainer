            "prefix": "ベルマン_フォード_負辺_最短路",
            "requires": ["petgraph::Graph", "petgraph::Directed", "petgraph::Undirected", "petgraph::algo::bellman_ford"],
            "body": [
                "// https://github.com/tb158/atcoder-rust-devcontainer",
                "let mut ${1:グラフ} = Graph::<(), f64, ${2:Directed}>::with_capacity(${3:n}, 0);",
                "let ${4:点} = (0..${3:n}).map(|_| ${1:グラフ}.add_node(())).collect::<Vec<_>>();",
                "for (${5:from}, ${6:to}, ${7:cost}) in ${8:辺} {",
                "    ${1:グラフ}.add_edge(${4:点}[${5:from}], ${4:点}[${6:to}], ${7:cost});",
                "}",
                "let ${9:最短} = bellman_ford(&${1:グラフ}, ${4:点}[${10:始点}]).unwrap();",
                ""
