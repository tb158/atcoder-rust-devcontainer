        "ndarray DP (indexed_iter)": {
            "prefix": "dp_ndarray",
            "body": [
                "let mut ${1:dp} = Array${2:2}::from_elem(${3:(, )}, ${4:None::<usize>});",
                "let mut ${1:dp}_next = ${1:dp}.clone();",
                "${1:dp}[[${5:0, 0}]] = ${6:Some(0)};",
                "",
                "for ${7:item} in ${8:items} {",
                "    ${1:dp}_next.fill(${4:None});",
                "    for (${9:(i, j)}, &${10:dp値}) in ${1:dp}.indexed_iter() {",
                "        let Some(${10:dp値}) = ${10:dp値} else { continue };",
                "        ${11:dp_next[[i, j]] = dp_next[[i, j]].max(Some(dp値 + 1));}",
                "        $0",
                "        }}",
                "    }",
                "    std::mem::swap(&mut ${1:dp}, &mut ${1:dp}_next);",
                "}"
            ],
            "description": "ndarray の ArrayN で dp/dp_next を回す DP の骨格 ※最小化問題でOptionはNG"
        },
        "双方向連結リスト (next/prev 配列)": {
            "prefix": "双方向_連結_リスト_LinkedList",
            "requires": "itertools::Itertools",
            "body": [
                "// https://github.com/tb158/atcoder-rust-devcontainer",
                "let (mut next, mut prev) = (vec![None; ${1:p.len()}], vec![None; ${1:p.len()}]);",
                "for (&a, &b) in ${2:p}.iter().tuple_windows() {",
                "    next[a] = Some(b);",
                "    prev[b] = Some(a);",
                "}",
                "$0"
            ],
            "description": "std::collections::LinkedListは添字で要素を指せずO(1)削除にCursorMut(unstable)が要るので、Option<usize>のnext/prev配列2本で持つ。末尾のnextと先頭のprevはNone。削除は if let Some(p) = prev[i] { next[p] = next[i]; } if let Some(q) = next[i] { prev[q] = prev[i]; } 戻すのは if let Some(p) = prev[i] { next[p] = Some(i); } if let Some(q) = next[i] { prev[q] = Some(i); }"
        },
