        "尺取り_count条件_wrapping": {
            "prefix": "尺取り_法で_count",
            "body": [
                "let count_${1:条件名} = |${3:引数}| {",
                "    let mut count = 0;",
                "    let mut r = 0;",
                "    // 目的関数はl..rに対応させ、常に連動させる",
                "    // rはr<lも許容して、そのせいで負になるならwrapping_add,subを利用する",
                "    let mut ${4:目的関数} = ${5:0};",
                "",
                "    for l in 0..${6:a}.len() {",
                "        // rを目的関数に反映→空区間はデフォルト値の責任、有区間は1要素目だろうが全要素だろうが評価がrに反映される",
                "        // r<lはcount計算前に無条件でrをインクリメントする",
                "        while r < ${6:a}.len() && (r < l || ${7:目的関数.wrapping_add(a[r])}${2:条件}) {",
                "            // rの変化に連動",
                "            ${4:目的関数} = ${7:目的関数.wrapping_add(a[r])};",
                "            r += 1;",
                "        }",
                "        count += r - l;",
                "        // lの変化に連動",
                "        ${2:目的関数} = ${8:目的関数.wrapping_sub(a[l])};",
                "    }",
                "    count",
                "};",
                ""
            ],
            "description": "尺取りで条件を満たす区間数を数える"
        },
